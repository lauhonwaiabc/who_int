  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 138055,
        "bookId": 65,
        "chapterId": 105,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> darkly pigmented deposits in the retina, which may be associated with retinal blood vessels and/or nodular; proliferation of the RPE, often with intervening basement membrane material.</p>\r\n",
        "timestamp": "2026-03-31T15:01:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 981,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 746,
    "contributions": [
      {
        "pkcontributionId": 138056,
        "bookId": 65,
        "chapterId": 105,
        "headingId": 746,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2026-03-31T15:01:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 138057,
        "bookId": 65,
        "chapterId": 105,
        "headingId": 747,
        "headingText": "\r\n<p>These lesions are benign; the survival prognosis is excellent. The visual prognosis depends on the underlying process. Longstanding RPE hyperplasia in disorganized, blind eyes may rarely give rise to RPE adenocarcinoma {9565054;18303161;8871153;17613862}.</p>",
        "timestamp": "2026-03-31T15:01:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
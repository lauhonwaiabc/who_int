    "contributions": [
      {
        "pkcontributionId": 138053,
        "bookId": 65,
        "chapterId": 105,
        "headingId": 744,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2026-03-31T15:01:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

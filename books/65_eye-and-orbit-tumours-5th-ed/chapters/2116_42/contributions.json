[
  {
    "pkheadingid": 968,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 733,
    "contributions": [
      {
        "pkcontributionId": 137274,
        "bookId": 65,
        "chapterId": 42,
        "headingId": 733,
        "headingText": "\r\n<p>Molluscum contagiosum is a benign and self-limited viral skin infection that presents as multiple epidermal nodular, umbilicated lesions on the skin.</p>\r\n",
        "timestamp": "2026-03-31T14:58:42"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 969,

        "headingId": 734,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2026-03-31T14:58:42"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 970,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 735,
    "contributions": [
      {
        "pkcontributionId": 137276,
        "bookId": 65,
        "chapterId": 42,
        "headingId": 735,
        "headingText": "\r\n<p>1E76 Molluscum contagiosum</p>\r\n",
        "timestamp": "2026-03-31T14:58:42"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 971,

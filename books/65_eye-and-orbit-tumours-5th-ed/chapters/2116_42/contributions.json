    "numberofBooknote": 0
  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 137288,
        "bookId": 65,
        "chapterId": 42,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> crateriform, acanthotic epidermis; molluscum bodies.</p>\r\n",
        "timestamp": "2026-03-31T14:58:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

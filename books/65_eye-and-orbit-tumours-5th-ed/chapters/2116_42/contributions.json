        "timestamp": "2026-03-31T14:58:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 137290,
        "bookId": 65,
        "chapterId": 42,
        "headingId": 747,
        "headingText": "\r\n<p>Spontaneous regression typically occurs within 12&ndash;18&nbsp;months. A variety of treatment modalities, such as cryotherapy, curettage, topical chemical agents, immunomodulators, or pulsed dye laser, can be used for extensive disease, secondary complications such as superinfection, or aesthetic purposes {31239742;28884917}. Immunocompromised individuals need more vigorous treatment to eradicate the disease {27136625}.</p>",
        "timestamp": "2026-03-31T14:58:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
        "headingId": 745,
        "headingText": "\r\n<p>Not reported</p>\r\n",
        "timestamp": "2026-03-31T15:01:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 138123,
        "bookId": 65,
        "chapterId": 117,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> histologically mature neuroglial tissue unassociated with neoplastic neuroepithelium; an adjacent coloboma, when present, is a helpful sign.</p>\r\n",
        "timestamp": "2026-03-31T15:01:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 981,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 746,
    "contributions": [
      {
        "pkcontributionId": 138124,
        "bookId": 65,
        "chapterId": 117,
        "headingId": 746,
        "headingText": "\r\n<p>Not available</p>\r\n",
        "timestamp": "2026-03-31T15:01:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 138125,
        "bookId": 65,
        "chapterId": 117,
        "headingId": 747,
        "headingText": "\r\n<p>Lesions are curable early on by surgical excision, with negligible risk of recurrence.</p>",
        "timestamp": "2026-03-31T15:01:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
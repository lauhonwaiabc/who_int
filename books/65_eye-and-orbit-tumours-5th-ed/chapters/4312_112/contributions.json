        "timestamp": "2026-03-31T15:01:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 138106,
        "bookId": 65,
        "chapterId": 112,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> a nodule of interlacing cords of uniform non-pigmented ciliary epithelial cells surrounded by PAS-positive amorphous extracellular hyaline material.</p>\r\n",
        "timestamp": "2026-03-31T15:01:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 981,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 746,
    "contributions": [
      {
        "pkcontributionId": 138107,
        "bookId": 65,
        "chapterId": 112,
        "headingId": 746,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2026-03-31T15:01:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 138108,
        "bookId": 65,
        "chapterId": 112,
        "headingId": 747,
        "headingText": "\r\n<p>Hyperplasia of the ciliary epithelium is a benign reactive proliferation and usually an incidental finding in an enucleated eye. The prognosis for vision is excellent. Occasionally, it can cause sectoral cataract or grow to sufficient size to involve the iris root and simulate a malignant neoplasm of the ciliary body, necessitating removal {32434227}.</p>",
        "timestamp": "2026-03-31T15:01:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
        "headingId": 746,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2026-03-31T14:57:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 136983,
        "bookId": 65,
        "chapterId": 11,
        "headingId": 747,
        "headingText": "\r\n<p>Epibulbar osseous choristomas are benign, and malignant transformation has not been described. In some exceptional cases, slight enlargement has been reported {22496017;12358295}.</p>",
        "timestamp": "2026-03-31T14:57:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
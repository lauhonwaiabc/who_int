    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 250.719px; background: #daeef3; border-collapse: collapse;\" border=\"0\" width=\"31%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 236.344px; padding: 0cm 5.4pt;\" width=\"100%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Lower risk</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 236.344px; padding: 0cm 5.4pt;\" width=\"100%\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm; text-indent: 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Nodular BCC</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm; text-indent: 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Superficial BCC</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm; text-indent: 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Pigmented BCC</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm; text-indent: 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Infundibulocystic BCC</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm; text-indent: 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Fibroepithelial BCC</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 236.344px; padding: 0cm 5.4pt;\" width=\"100%\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm; text-indent: 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Higher risk</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 236.344px; padding: 0cm 5.4pt;\" width=\"100%\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm; text
  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 137799,
        "bookId": 65,
        "chapterId": 357,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> a cyst lined by bland cuboidal or columnar posterior iris pigmented epithelium.</p>\r\n",
        "timestamp": "2026-03-31T15:00:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

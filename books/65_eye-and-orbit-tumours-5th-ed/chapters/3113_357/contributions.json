    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 137801,
        "bookId": 65,
        "chapterId": 357,
        "headingId": 747,
        "headingText": "\r\n<p>An enlarging cyst might cause visual deterioration and precipitate angle-closure glaucoma. Complete excision is curative.</p>",
        "timestamp": "2026-03-31T15:00:46"
      }
    ],

        "bookId": 65,
        "chapterId": 256,
        "headingId": 734,
        "headingText": "\r\n<p>8890/3 Leiomyosarcoma</p>\r\n",
        "timestamp": "2026-03-31T15:07:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 970,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 735,
    "contributions": [
      {
        "pkcontributionId": 139307,
        "bookId": 65,
        "chapterId": 256,
        "headingId": 735,
        "headingText": "\r\n<p>2B58.Y &amp; XH7ED4 Leiomyosarcoma, other specified primary site &amp; Leiomyosarcoma, NOS</p>\r\n",
        "timestamp": "2026-03-31T15:07:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 971,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 736,
    "contributions": [
      {

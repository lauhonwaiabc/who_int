[
  {
    "pkheadingid": 968,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 733,
    "contributions": [
      {
        "pkcontributionId": 137342,
        "bookId": 65,
        "chapterId": 50,
        "headingId": 733,
        "headingText": "\r\n<p>Inverted follicular keratosis (IFK) is characterized by a benign epithelial expansion by proliferation of squamous and basaloid cells of the follicular infundibulum.</p>\r\n",
        "timestamp": "2026-03-31T14:58:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

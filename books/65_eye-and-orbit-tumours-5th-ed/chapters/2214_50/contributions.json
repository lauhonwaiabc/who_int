        "bookId": 65,
        "chapterId": 50,
        "headingId": 735,
        "headingText": "\r\n<p>2F21.0 Seborrhoeic keratosis</p>\r\n",
        "timestamp": "2026-03-31T14:58:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

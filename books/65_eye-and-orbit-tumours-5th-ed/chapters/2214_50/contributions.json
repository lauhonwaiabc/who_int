    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 137358,
        "bookId": 65,
        "chapterId": 50,
        "headingId": 747,
        "headingText": "\r\n<p>With incomplete excision IFK may recur within several weeks.</p>",
        "timestamp": "2026-03-31T14:58:49"
      }
    ],

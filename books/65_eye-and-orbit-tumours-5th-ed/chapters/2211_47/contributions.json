      {
        "pkcontributionId": 137294,
        "bookId": 65,
        "chapterId": 47,
        "headingId": 736,
        "headingText": "\r\n<p><em>Acceptable:</em> common viral wart.</p>\r\n",
        "timestamp": "2026-03-31T14:58:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 972,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 737,
    "contributions": [
      {

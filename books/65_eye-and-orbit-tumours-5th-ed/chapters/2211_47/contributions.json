  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 137305,
        "bookId": 65,
        "chapterId": 47,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> papillomatosis; hypergranulosis; hyperkeratosis; parakeratosis.</p>\r\n<p><em>Desirable:</em> koilocytosis.</p>\r\n",
        "timestamp": "2026-03-31T14:58:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 981,
    "bookid": 65,

    "contributions": [
      {
        "pkcontributionId": 137291,
        "bookId": 65,
        "chapterId": 47,
        "headingId": 733,
        "headingText": "\r\n<p>Verruca vulgaris is a common benign HPV-driven epidermal squamoproliferative lesion.</p>\r\n",
        "timestamp": "2026-03-31T14:58:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "bookId": 65,
        "chapterId": 47,
        "headingId": 735,
        "headingText": "\r\n<p>1E80 Common warts</p>\r\n",
        "timestamp": "2026-03-31T14:58:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 971,
    "bookid": 65,

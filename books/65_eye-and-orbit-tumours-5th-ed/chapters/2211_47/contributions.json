        "headingId": 746,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2026-03-31T14:58:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 137307,
        "bookId": 65,
        "chapterId": 47,
        "headingId": 747,
        "headingText": "\r\n<p>Verrucae typically resolve spontaneously with time: in children, about 80% of lesions regress in 2&nbsp;years {23932731;11167676}. In immunosuppressed individuals, verrucae may be more persistent {22131115}. Different treatment modalities in recalcitrant cases or in immune deficiency include curettage, cryotherapy, chemical agents, and laser {31241843}.</p>",
        "timestamp": "2026-03-31T14:58:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
[
  {
    "pkheadingid": 968,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 733,
    "contributions": [
      {
        "pkcontributionId": 137768,
        "bookId": 65,
        "chapterId": 79,
        "headingId": 733,
        "headingText": "\r\n<p>An implantation cyst is a squamous epithelial&ndash;lined cyst of the iris that either arises developmentally or is secondary to penetrating ocular injury.</p>\r\n",
        "timestamp": "2026-03-31T15:00:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 969,

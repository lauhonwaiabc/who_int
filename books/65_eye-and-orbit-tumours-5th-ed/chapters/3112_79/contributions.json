    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 745,
    "contributions": [
      {
        "pkcontributionId": 137781,
        "bookId": 65,
        "chapterId": 79,
        "headingId": 745,
        "headingText": "\r\n<p>Not relevant</p>\r\n",

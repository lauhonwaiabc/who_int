    "numberofBooknote": 0
  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 137782,
        "bookId": 65,
        "chapterId": 79,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> a cyst lined by surface epithelium consisting of non-atypical non-keratinizing or keratinizing squamous epithelium of varying thickness, with or without goblet cells.</p>\r\n",
        "timestamp": "2026-03-31T15:00:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 981,

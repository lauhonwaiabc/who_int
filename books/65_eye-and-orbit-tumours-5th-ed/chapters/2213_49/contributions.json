  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 137339,
        "bookId": 65,
        "chapterId": 49,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> a well-circumscribed intraepidermal squamous proliferation with a flat base, lacking squamous dysplasia.</p>\r\n",
        "timestamp": "2026-03-31T14:58:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

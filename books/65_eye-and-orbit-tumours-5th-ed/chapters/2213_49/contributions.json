      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 137341,
        "bookId": 65,
        "chapterId": 49,
        "headingId": 747,
        "headingText": "\r\n<p>Complete excision is curative.</p>",
        "timestamp": "2026-03-31T14:58:47"
      }

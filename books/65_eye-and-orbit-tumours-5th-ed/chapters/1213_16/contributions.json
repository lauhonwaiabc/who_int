        "timestamp": "2026-03-31T14:57:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 137015,
        "bookId": 65,
        "chapterId": 16,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> a circumscribed solid/cystic tumour consisting of columnar oncocytic cells.</p>\r\n",
        "timestamp": "2026-03-31T14:57:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 981,

        "timestamp": "2026-03-31T14:57:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 137017,
        "bookId": 65,
        "chapterId": 16,
        "headingId": 747,
        "headingText": "\r\n<p>Oncocytoma rarely recurs despite positive tumour margins {19843013}. There are no well-documented cases of malignant transformation {19843013;21956543}.</p>",
        "timestamp": "2026-03-31T14:57:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 139080,
        "bookId": 65,
        "chapterId": 224,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> yellowish plaque or flat lesion around the eyelids; presence of lipid-laden histiocytes, giant cells, and chronic inflammatory cells.</p>\r\n",
        "timestamp": "2026-03-31T15:04:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 981,

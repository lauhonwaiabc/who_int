[
  {
    "pkheadingid": 968,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 733,
    "contributions": [
      {
        "pkcontributionId": 139066,
        "bookId": 65,
        "chapterId": 224,
        "headingId": 733,
        "headingText": "\r\n<p>Xanthelasma are benign, subcutaneous, localized lesions composed of foamy histiocytes and Touton giant cells with a variable degree of lipid deposition in the absence of a metabolic disorder.</p>\r\n",
        "timestamp": "2026-03-31T15:04:13"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 969,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

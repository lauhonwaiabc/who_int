        "headingId": 746,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2026-03-31T15:04:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 139082,
        "bookId": 65,
        "chapterId": 224,
        "headingId": 747,
        "headingText": "\r\n<p>The lesions are benign and are commonly observed. Surgical excision for larger lesions or cosmetic reasons may be considered.</p>",
        "timestamp": "2026-03-31T15:04:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
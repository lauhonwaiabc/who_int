[
  {
    "pkheadingid": 968,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 733,
    "contributions": [
      {
        "pkcontributionId": 139458,
        "bookId": 65,
        "chapterId": 265,
        "headingId": 733,
        "headingText": "\r\n<p>Lymphangiectasia is a bulbar conjunctival dilation of developmentally normal lymphatic channels, produced as a result of degenerative, inflammatory, iatrogenic, or neoplastic etiologies, leading to either focal or diffuse lymphatic channel dilation.</p>\r\n",
        "timestamp": "2026-03-31T15:07:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

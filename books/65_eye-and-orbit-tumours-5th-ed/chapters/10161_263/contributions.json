    "headingid": 745,
    "contributions": [
      {
        "pkcontributionId": 139420,
        "bookId": 65,
        "chapterId": 263,
        "headingId": 745,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2026-03-31T15:07:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 139421,
        "bookId": 65,
        "chapterId": 263,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> circumscribed papillary lesion lined by benign endothelial cells with hyalinized cores in a background of an organizing haematoma/thrombus.</p>\r\n<p><em>Desirable:</em> intravascular location.</p>\r\n",
        "timestamp": "2026-03-31T15:07:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 981,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 746,
    "contributions": [
      {
        "pkcontributionId": 139422,
        "bookId": 65,
        "chapterId": 263,
        "headingId": 746,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2026-03-31T15:07:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 139423,
        "bookId": 65,
        "chapterId": 263,
        "headingId": 747,
        "headingText": "\r\n<p>The lesion is benign with no documented malignant transformation. Complete excision is curative {34615394}. Orbital lesions can be rarely associated with visual loss from optic nerve compression {22974134}.</p>",
        "timestamp": "2026-03-31T15:07:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
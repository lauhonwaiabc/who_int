[
  {
    "pkheadingid": 968,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 733,
    "contributions": [
      {
        "pkcontributionId": 136882,
        "bookId": 65,
        "chapterId": 5,
        "headingId": 733,
        "headingText": "\r\n<p>Epithelial conjunctival inclusion cysts, lined by conjunctival or caruncle-type epithelium, occur within the substantia propria of the conjunctiva and caruncle.</p>\r\n",
        "timestamp": "2026-03-31T14:57:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 969,

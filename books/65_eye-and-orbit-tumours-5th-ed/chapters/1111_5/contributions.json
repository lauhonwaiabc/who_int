  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 136896,
        "bookId": 65,
        "chapterId": 5,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> a cyst in the substantia propria, lined by benign conjunctival-type epithelium or benign caruncle-type epithelium.</p>\r\n",
        "timestamp": "2026-03-31T14:57:34"
      }
    ],

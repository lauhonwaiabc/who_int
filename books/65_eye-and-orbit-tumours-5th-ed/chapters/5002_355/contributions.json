  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 138177,
        "bookId": 65,
        "chapterId": 355,
        "headingId": 747,
        "headingText": "\r\n<p>There is slow growth, with benign, progressive visual loss.</p>",

        "bookId": 65,
        "chapterId": 355,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> variable amounts of adipose tissue and smooth muscle.</p>\r\n",
        "timestamp": "2026-03-31T15:01:15"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

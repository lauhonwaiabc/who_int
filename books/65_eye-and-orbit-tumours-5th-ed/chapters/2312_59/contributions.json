    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 137477,
        "bookId": 65,
        "chapterId": 59,
        "headingId": 747,
        "headingText": "\r\n<p>Syringomas are benign lesions. Low-energy radio frequency ablation and carbon dioxide laser have been used with good outcomes and are less invasive and associated with better aesthetic outcomes {22777235}.</p>",
        "timestamp": "2026-03-31T14:58:58"
      }
    ],

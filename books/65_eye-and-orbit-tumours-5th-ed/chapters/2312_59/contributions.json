  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 137475,
        "bookId": 65,
        "chapterId": 59,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential: </em>skin-coloured or slightly yellow smooth papules; tubular and cystic structures with circumscribed architecture and benign cytology, embedded in a sclerotic stroma.</p>\r\n",
        "timestamp": "2026-03-31T14:58:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

[
  {
    "pkheadingid": 968,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 733,
    "contributions": [
      {
        "pkcontributionId": 137461,
        "bookId": 65,
        "chapterId": 59,
        "headingId": 733,
        "headingText": "\r\n<p>Syringoma is a benign adnexal tumour of eccrine sweat gland origin.</p>\r\n",
        "timestamp": "2026-03-31T14:58:57"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

  {
    "pkattachmentId": 72328,
    "bookid": 65,
    "chapterId": 91,
    "fileId": 56487,
    "type": "Figure",
    "diagnosis": "Progression of choroidal naevus to melanoma",
    "title": "",
    "legend": "A <em>GNAQ</em> or <em>GNA11</em> mutation appears to occur early in the progression, present also in many uveal naevi. Once the tumour is a melanoma, it may acquire further mutations: mutations in <em>EIF1AX</em> or <em>SF3B1</em> (typically also 6p&nbsp;gain) result in class&nbsp;1 melanoma with a low or intermediate risk, respectively, of metastasis, whereas mutations in <em>BAP1</em> (typically also 3p&nbsp;loss, 8q&nbsp;gain) result in class&nbsp;2 melanomas with a high risk of metastasis. PRAME positivity corresponds to worse clinical outcomes for both gene expression profile class&nbsp;1 and class&nbsp;2 uveal melanomas {969, 970}.",
    "source": "",
    "copyright": "Grossniklaus&nbsp;HE",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/65/91/56487.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/65/91/thumb_56487.jpg"
  }

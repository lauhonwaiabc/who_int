    "type": "Table",
    "diagnosis": "",
    "title": "<p class=\"TableTitle\"><strong><span lang=\"EN-GB\">Table&nbsp;10.01</span></strong><span lang=\"EN-GB\"> Reactive follicular hyperplasia and differential diagnosis</span></p>",
    "legend": "",
    "source": "Sarah E. Coupland",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 765.297px; border-collapse: collapse;\" border=\"0\" width=\"99%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Reactive follicular hyperplasia</span></strong></p>\r\n</td>\r\n<td style=\"width: 240.766px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Follicular lymphoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 240.641px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Extranodal marginal zone B-cell lymphoma</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><em><span lang=\"EN-GB\">Morphology</span></em></strong></p>\r\n</td>\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 240.641px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">&nbsp;</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Low density of follicles</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">High density of follicles</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Low density of follicles</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Follicles of uneven size and shape</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Follicles usually of similar size and shape</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Moth-eaten follicles of uneven size and shape</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Mixture of cell types in GC</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Monomorphic or polymorphic GC population</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Mixture of cell types in GC</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Tingible-body macrophages present</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Tingible-body macrophages usually rare</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Tingible-body macrophages present</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Usually moderate to high mitotic rate</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Usually low to moderate mitotic rate</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Usually moderate to high mitotic rate</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Cell polarization in GC often seen</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Cell polarization in GC usually absent</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Cell polarization in GC often seen</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Mantle zone usually distinct</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Mantle zone usually indistinct</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Mantle zone compressed by enlarged marginal zone</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Large interfollicular areas with admixed cells</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Compressed interfollicular areas</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Interfollicular areas filled by expanded marginal zones with centrocyte-like cells, monocytoid cells, and/or plasmacellular differentiated cells and extrafollicular blasts</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Lymphoepithelial lesions</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><em><span lang=\"EN-GB\">Immunoprofile</span></em></strong></p>\r\n</td>\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Normal distribution of B&nbsp;cells and T&nbsp;cells within and outside the GCs</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Dominance of B&nbsp;cells on CD20, CD79a, or PAX5 staining, particularly in GC, with loss of follicular T&nbsp;cells and macrophages</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Dominance of B&nbsp;cells on CD20, CD79a, or PAX5 staining in marginal zone</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">GC cells negative for BCL2; regular follicular dendritic cell network on CD23 immunohistochemistry</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">GC cells positive for BCL2, CD10, and BCL6; expanded follicular dendritic cell network on CD23 immunohistochemistry</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">GC cells negative for BCL2; residual follicular dendritic cell network on CD23 immunohistochemistry</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Cell polarization in GC highlighted by Ki-67</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Irregular scattered staining for Ki-67 without polarization</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Cell polarization in GC highlighted by Ki-67</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Mantle zone usually present in IgD stain</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Mantle zone thinned or lost in IgD stain</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Mantle zone thinned in IgD stain</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Dominant T-cell population within interfollicular zone</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Compressed T-cell interfollicular zone</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Interfollicular zone replaced by neoplastic marginal zone B&nbsp;cells (CD20, CD79a, and/or PAX5)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><em><span lang=\"EN-GB\">Molecular pathology</span></em></strong></p>\r\n</td>\r\n<td style=\"width: 240.766px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Polyclonal IgH PCR and TR PCR</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Usually monoclonal on IgH PCR but can be polyclonal owing to a large number of somatic mutations</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Usually monoclonal on IgH PCR</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 240.766px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">No demonstrable translocations, deletions, or mutations</span></p>\r\n</td>\r\n<td style=\"width: 240.766px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Most common: t(14;18)(q32;q21) translocation associated with IGH::<em>BCL2</em> fusion</span></p>\r\n</td>\r\n<td style=\"width: 240.641px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" valign=\"top\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Trisomy of chromosomes&nbsp;3 and&nbsp;18 common; gain of&nbsp;6p and loss of&nbsp;6q as well as <em>TNFAIP3</em> mutation/deletion seen often in ocular adnexa</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">GC, germinal centre.</span></p>",

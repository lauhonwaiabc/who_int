        "chapterId": 60,
        "headingId": 734,
        "headingText": "\r\n<p>8406/0 Syringocystadenoma papilliferum</p>\r\n",
        "timestamp": "2026-03-31T14:59:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 970,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 735,
    "contributions": [
      {
        "pkcontributionId": 137514,
        "bookId": 65,
        "chapterId": 60,
        "headingId": 735,
        "headingText": "\r\n<p>2F22 &amp; XH1PY0 Benign neoplasms of epidermal appendages &amp; Syringocystadenoma papilliferum</p>\r\n",
        "timestamp": "2026-03-31T14:59:01"
      }
    ],

        "headingId": 744,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2026-03-31T14:59:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 980,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 745,
    "contributions": [
      {
        "pkcontributionId": 137525,
        "bookId": 65,
        "chapterId": 60,
        "headingId": 745,
        "headingText": "\r\n<p><em>BRAF</em> p.V600E mutations are present in 50&ndash;64% of SCAPs {35158743}.</p>\r\n",
        "timestamp": "2026-03-31T14:59:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 137526,
        "bookId": 65,
        "chapterId": 60,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> tubular structures with papillary projections and plasma cells in the stroma.</p>\r\n",
        "timestamp": "2026-03-31T14:59:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "timestamp": "2026-03-31T14:59:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 982,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 747,
    "contributions": [
      {
        "pkcontributionId": 137528,
        "bookId": 65,
        "chapterId": 60,
        "headingId": 747,
        "headingText": "\r\n<p>SCAP is a benign neoplasm. Excision with clear margins is curative. Incompletely excised lesions can recur {31686976;29053036;26265653}. There is 1&nbsp;reported case of malignant transformation of SCAP, harbouring invasive squamous cell carcinoma {29217053}.</p>",
        "timestamp": "2026-03-31T14:59:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
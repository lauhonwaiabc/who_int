[
  {
    "pkheadingid": 968,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 733,
    "contributions": [
      {
        "pkcontributionId": 137512,
        "bookId": 65,
        "chapterId": 60,
        "headingId": 733,
        "headingText": "\r\n<p>Syringocystadenoma papilliferum (SCAP) is a benign apocrine neoplasm, composed of two layers of cells (inner epithelial and outer myoepithelial layer) forming dilated papillary and cystic structures with the stroma containing abundant plasma cells.</p>\r\n",
        "timestamp": "2026-03-31T14:59:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 969,

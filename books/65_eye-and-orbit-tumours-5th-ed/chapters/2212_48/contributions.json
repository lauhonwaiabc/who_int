  },
  {
    "pkheadingid": 983,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 748,
    "contributions": [
      {
        "pkcontributionId": 137322,
        "bookId": 65,
        "chapterId": 48,
        "headingId": 748,
        "headingText": "\r\n<p><em>Essential:</em> finger-like projections of vascularized connective tissue covered by hyperplastic epithelium; absence of dysplasia.</p>\r\n",
        "timestamp": "2026-03-31T14:58:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

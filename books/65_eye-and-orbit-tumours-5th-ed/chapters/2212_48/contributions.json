[
  {
    "pkheadingid": 968,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 733,
    "contributions": [
      {
        "pkcontributionId": 137308,
        "bookId": 65,
        "chapterId": 48,
        "headingId": 733,
        "headingText": "\r\n<p>Squamous papilloma is a benign exophytic verrucous or broad-based skin tumour, with or without signs of HPV infection.</p>\r\n",
        "timestamp": "2026-03-31T14:58:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 969,
    "bookid": 65,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

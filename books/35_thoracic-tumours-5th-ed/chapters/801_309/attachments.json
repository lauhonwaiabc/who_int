pt;\" width=\"446\">\r\n<p class=\"TableText\">Atrial myxoma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 4.0pt;\">\r\n<td style=\"width: 318.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"425\">\r\n<p class=\"TableText\"><strong><em>DICER1</em> syndrome</strong></p>\r\n</td>\r\n<td style=\"width: 334.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"446\">\r\n<p class=\"TableText\">Pleuropulmonary blastoma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 4.0pt;\">\r\n<td style=\"width: 318.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"425\">\r\n<p class=\"TableText\"><strong>Tuberous sclerosis</strong></p>\r\n</td>\r\n<td style=\"width: 334.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"446\">\r\n<p class=\"TableText\">Lymphangioleiomyomatosis, perivascular epithelioid cell tumours (PEComas), cardiac rhabdomyomas</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 4.0pt;\">\r\n<td style=\"width: 318.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"425\">\r\n<p class=\"TableText\"><strong>Gorlin syndrome</strong></p>\r\n</td>\r\n<td style=\"width: 334.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"446\">\r\n<p class=\"TableText\">Cardiac fibromas</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 4.0pt;\">\r\n<td style=\"width: 318.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"425\">\r\n<p class=\"TableText\"><strong>Gardner syndrome</strong></p>\r\n</td>\r\n<td style=\"width: 334.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"446\">\r\n<p class=\"TableText\">Desmoid fibromatosis</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 4.0pt;\">\r\n<td style=\"width: 318.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"425\">\r\n<p class=\"TableText\
    "contributions": [
      {
        "pkcontributionId": 67017,
        "bookId": 35,
        "chapterId": 98,
        "headingId": 433,
        "headingText": "\r\n<p>9170/3 Diffuse lymphangiomatosis</p>\r\n",
        "timestamp": "2020-11-11T11:19:59"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 477,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 434,
    "contributions": [
      {
        "pkcontributionId": 67018,
        "bookId": 35,
        "chapterId": 98,
        "headingId": 434,
        "headingText": "\r\n<p>LA75.Y &amp; XH9MR8 Other specified structural developmental anomalies of lungs &amp; Lymphangioma, NOS</p>\r\n",
        "timestamp": "2020-11-11T11:19:59"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 478,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 435,

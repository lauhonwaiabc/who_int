        "headingId": 443,
        "headingText": "\r\n<p>Insufficient data available</p>\r\n",
        "timestamp": "2020-12-03T12:23:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 487,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 444,
    "contributions": [
      {

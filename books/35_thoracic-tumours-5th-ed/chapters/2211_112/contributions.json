    "contributions": [
      {
        "pkcontributionId": 67255,
        "bookId": 35,
        "chapterId": 112,
        "headingId": 446,
        "headingText": "\r\n<p>Tumours follow a benign clinical course {8827028; 11015658; 19627540}.</p>",
        "timestamp": "2020-12-03T12:23:58"
      }
    ],

      {
        "pkcontributionId": 68249,
        "bookId": 35,
        "chapterId": 239,
        "headingId": 432,
        "headingText": "\r\n<p>Thymic carcinoma with adenoid cystic carcinoma&ndash;like features is a primary thymic carcinoma resembling salivary gland adenoid cystic carcinoma.</p>\r\n",
        "timestamp": "2020-10-27T09:52:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

      {
        "pkcontributionId": 68218,
        "bookId": 35,
        "chapterId": 238,
        "headingId": 435,
        "headingText": "\r\n<p><em>Not recommended:</em> papillary adenocarcinoma.</p>\r\n",
        "timestamp": "2020-10-27T10:05:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 479,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 436,

    "contributions": [
      {
        "pkcontributionId": 68216,
        "bookId": 35,
        "chapterId": 238,
        "headingId": 433,
        "headingText": "<p>8260/3 Low-grade papillary adenocarcinoma</p>",
        "timestamp": "2021-01-18T14:05:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 477,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 434,
    "contributions": [
      {
        "pkcontributionId": 68217,
        "bookId": 35,
        "chapterId": 238,
        "headingId": 434,
        "headingText": "\r\n<p>2C27.0 &amp; XH6LV9 Carcinoma of thymus &amp; Papillary adenocarcinoma, NOS</p>\r\n",
        "timestamp": "2020-10-27T10:05:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 478,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 435,

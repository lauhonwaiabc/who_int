[
  {
    "pkheadingid": 475,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 432,
    "contributions": [
      {
        "pkcontributionId": 68215,
        "bookId": 35,
        "chapterId": 238,
        "headingId": 432,
        "headingText": "\r\n<p>Low-grade papillary adenocarcinoma is a primary thymic carcinoma composed of well-formed tubulopapillary structures, often associated with type&nbsp;A thymoma.</p>\r\n",
        "timestamp": "2020-10-27T10:05:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 476,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,

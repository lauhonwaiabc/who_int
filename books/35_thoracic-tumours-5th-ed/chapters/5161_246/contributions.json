        "pkcontributionId": 68300,
        "bookId": 35,
        "chapterId": 246,
        "headingId": 432,
        "headingText": "\r\n<p>Adenosquamous carcinoma is a primary thymic carcinoma showing both squamous and glandular differentiation, analogous to its pulmonary counterpart&nbsp;&ndash; i.e. each component constitutes &ge;&nbsp;10% of the tumour.</p>\r\n",
        "timestamp": "2020-10-27T10:08:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

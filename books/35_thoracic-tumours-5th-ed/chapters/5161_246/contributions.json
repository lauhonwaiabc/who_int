  {
    "pkheadingid": 480,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 437,
    "contributions": [
      {
        "pkcontributionId": 68305,
        "bookId": 35,
        "chapterId": 246,
        "headingId": 437,
        "headingText": "<p>Adenosquamous carcinoma of the thymus is localized in the anterior (prevascular) mediastinum.</p>",
        "timestamp": "2021-01-04T11:40:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 481,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 438,
    "contributions": [
      {
        "pkcontributionId": 68306,
        "bookId": 35,
        "chapterId": 246,
        "headingId": 438,
        "headingText": "<p>Symptoms are related to an anterior (prevascular) mediastinal mass, such as chest pain {1689123}.</p>",
        "timestamp": "2021-01-14T11:07:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 482,

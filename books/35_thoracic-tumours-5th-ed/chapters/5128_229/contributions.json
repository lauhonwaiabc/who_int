      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 489,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 446,
    "contributions": [
      {
        "pkcontributionId": 68128,
        "bookId": 35,
        "chapterId": 229,
        "headingId": 446,
        "headingText": "\r\n<p>All patients were disease-free after complete resection, by video-assisted thoracoscopy in one case {26234840}.</p>",
        "timestamp": "2020-10-27T09:59:49"
      }

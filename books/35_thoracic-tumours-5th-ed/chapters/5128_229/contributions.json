        "timestamp": "2020-10-27T09:59:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 490,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 447,
    "contributions": [
      {
        "pkcontributionId": 68126,
        "bookId": 35,
        "chapterId": 229,
        "headingId": 447,
        "headingText": "<p><em>Essential:</em></p>\r\n<ul>\r\n<li>A benign thymic tumour resembling fibroadenoma of the breast with a predominance of fibrous tissue over adipocytes and delicate strands of epithelial cells</li>\r\n</ul>",
        "timestamp": "2020-12-01T15:50:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

  },
  {
    "pkheadingid": 490,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 447,
    "contributions": [
      {
        "pkcontributionId": 67013,
        "bookId": 35,
        "chapterId": 91,
        "headingId": 447,
        "headingText": "<p><em>Essential:</em></p>\r\n<ul>\r\n<li>Bland cartilaginous stroma</li>\r\n<li>Absence of invaginated epithelium</li>\r\n<li>Absence of other mesenchymal components</li>\r\n</ul>\r\n<p><em>Desirable:</em></p>\r\n<ul>\r\n<li>Carney triad</li>\r\n</ul>",
        "timestamp": "2021-01-04T10:28:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

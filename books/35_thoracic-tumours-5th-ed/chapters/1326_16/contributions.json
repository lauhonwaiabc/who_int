  },
  {
    "pkheadingid": 489,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 446,
    "contributions": [
      {
        "pkcontributionId": 66486,
        "bookId": 35,
        "chapterId": 16,
        "headingId": 446,
        "headingText": "\r\n<p>Mucous gland adenomas are benign and cured by resection.</p>",

  },
  {
    "pkheadingid": 490,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 447,
    "contributions": [
      {
        "pkcontributionId": 66484,
        "bookId": 35,
        "chapterId": 16,
        "headingId": 447,
        "headingText": "<p><em>Essential:</em></p>\r\n<ul>\r\n<li>Well-circumscribed endobronchial tumour</li>\r\n<li>Acini&nbsp;/ tubules&nbsp;/ papillary growth of mucous cells with no atypia</li>\r\n<li>At least focal resemblance to normal seromucinous glands</li>\r\n</ul>",
        "timestamp": "2021-02-18T16:14:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

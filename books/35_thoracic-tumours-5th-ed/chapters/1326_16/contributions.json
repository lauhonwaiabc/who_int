        "pkcontributionId": 66470,
        "bookId": 35,
        "chapterId": 16,
        "headingId": 432,
        "headingText": "\r\n<p>Mucous gland adenoma is a benign, predominantly exophytic tumour of the bronchus, resembling seromucinous bronchial glands.</p>\r\n",
        "timestamp": "2020-11-11T10:52:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

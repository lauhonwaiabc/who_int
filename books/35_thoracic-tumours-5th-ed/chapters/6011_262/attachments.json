    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 581.2pt; border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 496.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" colspan=\"2\" width=\"662\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong>Symptoms/serology</strong></p>\r\n</td>\r\n<td style=\"width: 3.0cm; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center; page-break-after: avoid;\" align=\"center\"><strong>Frequency</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 496.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"662\">\r\n<p class=\"TableText\"><strong>Symptoms due to compression of adjacent structures (trachea, mainstem bronchi, phrenic nerve, superior vena cava)</strong></p>\r\n</td>\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 17.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">Dyspnoea</p>\r\n</td>\r\n<td style=\"width: 3.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">29&ndash;46%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 17.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">Chest pain</p>\r\n</td>\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">39%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 17.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">Superior vena cava syndrome</p>\r\n</td>\r\n<td style=\"width: 3.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">10&ndash;31%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 17.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">Cough/haemoptysis</p>\r\n</td>\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">15&ndash;22%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 17.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">Hoarseness</p>\r\n</td>\r\n<td style=\"width: 3.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">8%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 496.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"662\">\r\n<p class=\"TableText\"><strong>Systemic symptoms</strong></p>\r\n</td>\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 17.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">Weight loss</p>\r\n</td>\r\n<td style=\"width: 3.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">19%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 17.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">Fever</p>\r\n</td>\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">6%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 17.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">Nausea</p>\r\n</td>\r\n<td style=\"width: 3.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">6%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 17.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">Gynaecomastia</p>\r\n</td>\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Case report</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 496.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"662\">\r\n<p class=\"TableText\"><strong>Serology</strong></p>\r\n</td>\r\n<td style=\"width: 3.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 17.0cm; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">&beta;-hCG, mildly elevated (median: 8.5 IU/L; &le;&nbsp;100&nbsp;IU/L in adults, &le;&nbsp;25&nbsp;IU/L in children)<sup>a</sup></p>\r\n</td>\r\n<td style=\"width: 3.0cm; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">~1&nbsp;in&nbsp;3&nbsp;patients</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\"><sup>a</sup>&beta;-hCG &gt;&nbsp;1000&nbsp;IU/L is usually indicative of non-seminomatous tumour elements; AFP is usually not elevated.</p>",

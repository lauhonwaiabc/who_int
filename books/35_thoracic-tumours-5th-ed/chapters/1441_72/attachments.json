[
  {
    "pkattachmentId": 37223,
    "bookid": 35,
    "chapterId": 72,
    "fileId": 14699,
    "type": "Figure",
    "diagnosis": "Small cell carcinoma",
    "title": "",
    "legend": "The tumour is characterized by small to intermediate-sized cells with finely granular chromatin and scant cytoplasm. Cells are often oval to spindle in shape. Nucleoli are inconspicuous or absent. Mitotic figures are numerous.",
    "source": "Mary Beth Beasley",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/35/72/14699.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/35/72/thumb_14699.jpg"
  },
  {
    "pkattachmentId": 37224,
    "bookid": 35,
    "chapterId": 72,
    "fileId": 14702,
    "type": "Figure",
    "diagnosis": "Small cell carcinoma",
    "title": "",
    "legend": "The tumour is typically positive for cytokeratin and may sometimes show a rim-and-dot&ndash;type staining pattern (CAM5.2).",
    "source": "Mary Beth Beasley",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/35/72/14702.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/35/72/thumb_14702.jpg"
  },
  {
    "pkattachmentId": 37225,
    "bookid": 35,
    "chapterId": 72,
    "fileId": 14703,
    "type": "Figure",
    "diagnosis": "Small cell carcinoma",
    "title": "",
    "legend": "Small cell carcinoma is a high-grade neuroendocrine carcinoma and is usually positive for one of more neuroendocrine markers, such as CD56 in this example.",
    "source": "Mary Beth Beasley",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/35/72/14703.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/35/72/thumb_14703.jpg"
  },
  {
    "pkattachmentId": 37226,
    "bookid": 35,
    "chapterId": 72,
    "fileId": 14704,
    "type": "Figure",
    "diagnosis": "Small cell carcinoma",
    "title": "",
    "legend": "Small cell carcinoma typically has a high proliferation rate, as reflected by extensive nuclear staining with Ki-67 (MIB1 clone).",
    "source": "Mary Beth Beasley",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/35/72/14704.jpg",

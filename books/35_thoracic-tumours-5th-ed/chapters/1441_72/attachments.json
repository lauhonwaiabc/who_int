    "bookid": 35,
    "chapterId": 72,
    "fileId": 22151,
    "type": "Figure",
    "diagnosis": "Small cell lung carcinoma",
    "title": "",
    "legend": "This tumour consists of sheets of spindle and oval-shaped tumour cells with scant cytoplasm, finely granular nuclear chromatin, lack of nucleoli, and frequent mitoses.",
    "source": "William D. Travis",

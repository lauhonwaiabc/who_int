    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 51.25pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" rowspan=\"3\" width=\"100\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Current classification</strong></p>\r\n</td>\r\n<td style=\"width: 3.0cm; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" valign=\"top\" width=\"110\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 140.6pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"173\">\r\n<p class=\"TableText\"><strong>Low-grade</strong></p>\r\n</td>\r\n<td style=\"width: 142.9pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"185\">\r\n<p class=\"TableText\"><strong>Intermediate-grade</strong></p>\r\n</td>\r\n<td style=\"width: 10.0cm; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" colspan=\"2\" width=\"370\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>High-grade</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"110\">\r\n<p class=\"TableText\"><em>Classification of tumours with neuroendocrine morphology</em></p>\r\n</td>\r\n<td style=\"width: 140.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"173\">\r\n<p class=\"TableText\"><em>Typical carcinoid</em></p>\r\n</td>\r\n<td style=\"width: 142.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"185\">\r\n<p class=\"TableText\"><em>Atypical carcinoid</em></p>\r\n</td>\r\n<td style=\"width: 138.3pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"181\">\r\n<p class=\"TableText\"><em>Large cell neuroendocrine carcinoma</em></p>\r\n</td>\r\n<td style=\"width: 145.2pt; border: none; border-top: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><em>Small cell carcinoma</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 3.0cm; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"110\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 140.6pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"173\">\r\n<p class=\"TableText\">No necrosis</p>\r\n<p class=\"TableText\">&lt;&nbsp;2&nbsp;mitoses/2&nbsp;mm<sup>2</sup> (mean:&nbsp;1&nbsp;mitosis/2&nbsp;mm<sup>2</sup>)</p>\r\n</td>\r\n<td style=\"width: 142.9pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"185\">\r\n<p class=\"TableText\">Necrosis present (any) and/or</p>\r\n<p class=\"TableText\">2&ndash;10&nbsp;mitoses/2&nbsp;mm<sup>2</sup> (mean:&nbsp;6.5&nbsp;mitoses/2&nbsp;mm<sup>2</sup>)</p>\r\n</td>\r\n<td style=\"width: 138.3pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"181\">\r\n<p class=\"TableText\">Non-small cell cytology</p>\r\n<p class=\"TableText\">Neuroendocrine markers</p>\r\n<p class=\"TableText\">&gt;&nbsp;10&nbsp;mitoses/2&nbsp;mm<sup>2</sup> (mean:&nbsp;45&nbsp;mitoses/2&nbsp;mm<sup>2</sup>)</p>\r\n<p class=\"TableText\">Frequent necrosis</p>\r\n</td>\r\n<td style=\"width: 145.2pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\">Small cell cytology</p>\r\n<p class=\"TableText\">&gt;&nbsp;10&nbsp;mitoses/2&nbsp;mm<sup>2</sup> (mean:&nbsp;110&nbsp;mitoses/2&nbsp;mm<sup>2</sup>)</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

  {
    "pkattachmentId": 37881,
    "bookid": 35,
    "chapterId": 23,
    "fileId": 15249,
    "type": "WSI",
    "diagnosis": "Acinar adenocarcinoma with extensive high-grade cribriform architecture",
    "title": "",

      {
        "pkcontributionId": 66419,
        "bookId": 35,
        "chapterId": 13,
        "headingId": 432,
        "headingText": "\r\n<p>Papillary adenoma is a circumscribed papillary neoplasm composed of cytologically bland, cuboidal to columnar cells lining fibrovascular cores.</p>\r\n",
        "timestamp": "2020-11-11T10:48:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

[
  {
    "pkheadingid": 475,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 432,
    "contributions": [
      {
        "pkcontributionId": 67652,
        "bookId": 35,
        "chapterId": 174,
        "headingId": 432,
        "headingText": "\r\n<p>Lipoma is a benign neoplasm of mature adipose tissue.</p>\r\n",
        "timestamp": "2020-12-03T16:16:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 476,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,

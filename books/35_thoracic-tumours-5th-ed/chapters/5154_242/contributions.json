[
  {
    "pkheadingid": 475,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 432,
    "contributions": [
      {
        "pkcontributionId": 68283,
        "bookId": 35,
        "chapterId": 242,
        "headingId": 432,
        "headingText": "\r\n<p>Adenocarcinoma NOS of the thymus is a heterogeneous group of primary thymic carcinomas showing glandular differentiation and/or mucin production, and not conforming to low-grade papillary adenocarcinoma or enteric-type adenocarcinoma.</p>\r\n",
        "timestamp": "2020-10-27T09:53:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 476,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 433,
    "contributions": [
      {

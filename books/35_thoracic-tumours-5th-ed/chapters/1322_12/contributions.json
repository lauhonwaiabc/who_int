    "contributions": [
      {
        "pkcontributionId": 66403,
        "bookId": 35,
        "chapterId": 12,
        "headingId": 433,
        "headingText": "\r\n<p>8251/0 Alveolar adenoma</p>\r\n",
        "timestamp": "2020-11-11T10:50:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 477,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 434,
    "contributions": [
      {
        "pkcontributionId": 66404,
        "bookId": 35,
        "chapterId": 12,
        "headingId": 434,
        "headingText": "\r\n<p>2F00.Y &amp; XH9356 Other specified benign neoplasm of middle ear or respiratory system &amp; Alveolar adenoma</p>\r\n",
        "timestamp": "2020-11-11T10:50:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 478,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,

[
  {
    "pkheadingid": 475,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 432,
    "contributions": [
      {
        "pkcontributionId": 66402,
        "bookId": 35,
        "chapterId": 12,
        "headingId": 432,
        "headingText": "\r\n<p>Alveolar adenoma is a well-circumscribed tumour consisting of cystic spaces lined by a single layer of type&nbsp;II pneumocytes overlying a spindle-rich stroma.</p>\r\n",
        "timestamp": "2020-11-11T10:50:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 476,
    "bookid": 35,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

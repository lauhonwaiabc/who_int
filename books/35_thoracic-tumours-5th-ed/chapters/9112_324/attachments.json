    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 703.3pt; border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 219.75pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" colspan=\"2\" width=\"293\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong>Entity</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"645\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong>Differential diagnostic features</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 219.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"293\">\r\n<p class=\"TableText\"><strong>Neoplastic</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Mesothelioma</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">Positive mesothelial markers; malignant features (see the sections on<span class=\"ID-Section\">&lt;&lt;2.2&gt;&gt;</span>mesothelial tumours)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Primary pleural lymphoma</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">Positive lymphoid markers (see the sections on&nbsp;<span class=\"ID-Section\">&lt;&lt;2.3&gt;&gt;</span>haematolymphoid tumours)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Primary pleural mesenchymal tumours</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">Positive mesenchymal markers (see the chapter<span class=\"ID-Section\">&lt;&lt; 4.0&gt;&gt;</span><em>Mesenchymal tumours of the thorax</em>)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 219.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"293\">\r\n<p class=\"TableText\"><strong>Reactive/benign entities</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Pleural fibrosis +/&minus; talc pleurodesis</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">Fibrosis +/&minus; polarizable talc crystals; no cytological malignant features</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Reactive mesothelial hyperplasia</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">Positive mesothelial markers; no cytological malignant features (although sometimes cells are entrapped in superficial fibrosis)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Rounded atelectasis</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">Localized pleural scar with adjacent collapsed lung</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Endometriosis</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">Presence of endometrial stroma +/&minus; glands; no cytological malignant features; history of endometriosis</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>IgG4-related disease</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">Increased IgG4-positive cells and IgG4:IgG&nbsp;ratio; no clonality</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Amyloidosis</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">Congo red&ndash;positive material</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Granulomatous/tuberculous pleuritis</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">Granulomas (+/&minus; necrosis); fibrosis; no cytological malignant features (organisms detected on culture or acid-fast bacilli stains for tuberculosis)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Apical cap</strong></p>\r\n</td>\r\n<td style=\"width: 483.55pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"645\">\r\n<p class=\"TableText\">Hypocellular, intrapulmonary fibroelastotic scar with entrapped benign reactive pneumocytes; often bilateral</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

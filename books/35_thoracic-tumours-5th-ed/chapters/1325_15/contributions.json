    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 432,
    "contributions": [
      {
        "pkcontributionId": 66453,
        "bookId": 35,
        "chapterId": 15,
        "headingId": 432,
        "headingText": "\r\n<p>Mucinous cystadenoma is a localized cystic mass filled with mucin and surrounded by columnar mucinous epithelium without significant atypia or invasive growth.</p>\r\n",
        "timestamp": "2020-11-11T10:51:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

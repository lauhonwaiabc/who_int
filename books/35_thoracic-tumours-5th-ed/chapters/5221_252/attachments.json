  {
    "pkattachmentId": 36825,
    "bookid": 35,
    "chapterId": 252,
    "fileId": 13924,
    "type": "Figure",
    "diagnosis": "Atypical carcinoid of the thymus",
    "title": "",
    "legend": "A macroscopic image&nbsp;(<strong>A</strong>) and a low-power H&amp;E section&nbsp;(<strong>B</strong>) of a thymic atypical carcinoid. The H&amp;E section shows vague circumscription and infiltrative growth of the tumour. The inset figure highlights multiple microscopic foci of necrosis.",
    "source": "",
    "copyright": "Stroebel P",

    "contributions": [
      {
        "pkcontributionId": 66845,
        "bookId": 35,
        "chapterId": 61,
        "headingId": 432,
        "headingText": "\r\n<p>Hyalinizing clear cell carcinoma is a low-grade malignant epithelial tumour with cords, trabeculae, and nests of clear and eosinophilic cells infiltrating within a background of myxohyaline and cellular fibrous stroma.</p>\r\n",
        "timestamp": "2020-11-11T12:03:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

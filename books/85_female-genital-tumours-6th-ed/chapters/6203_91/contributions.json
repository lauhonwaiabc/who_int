[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152045,
        "bookId": 85,
        "chapterId": 91,
        "headingId": 1086,
        "headingText": "\r\n<p>Papillary cystadenoma is a benign papillary cystic tumour of probable mesonephric origin.</p>\r\n",
        "timestamp": "2026-08-25T18:54:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

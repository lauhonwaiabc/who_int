[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 151270,
        "bookId": 85,
        "chapterId": 17,
        "headingId": 1086,
        "headingText": "\r\n<p>Fibroadenoma of anogenital mammary-like glands is a benign, circumscribed biphasic epithelial-stromal neoplasm resembling the corresponding tumour in the breast.</p>\r\n",
        "timestamp": "2026-08-25T18:06:39"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

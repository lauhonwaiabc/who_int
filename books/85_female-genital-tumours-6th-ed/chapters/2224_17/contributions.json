    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1084,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1100,
    "contributions": [
      {
        "pkcontributionId": 151286,
        "bookId": 85,
        "chapterId": 17,
        "headingId": 1100,
        "headingText": "\r\n<p>These are benign lesions, usually with uneventful follow-up, but they can rarely recur, especially if incompletely excised {20035149; 30732503}.</p>",
        "timestamp": "2026-08-25T18:06:39"
      }
    ],

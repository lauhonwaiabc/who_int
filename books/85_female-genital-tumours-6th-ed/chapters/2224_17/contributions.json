        "bookId": 85,
        "chapterId": 17,
        "headingId": 1101,
        "headingText": "\r\n<p><em>Essential</em>: well-circumscribed biphasic histology with epithelial and stromal elements.</p>\r\n",
        "timestamp": "2026-08-25T18:06:39"
      }

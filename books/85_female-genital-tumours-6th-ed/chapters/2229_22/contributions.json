      {
        "pkcontributionId": 151321,
        "bookId": 85,
        "chapterId": 22,
        "headingId": 1086,
        "headingText": "\r\n<p>Bartholin gland carcinomas are primary vulvar carcinomas arising within the Bartholin gland.</p>\r\n",
        "timestamp": "2026-08-25T18:08:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

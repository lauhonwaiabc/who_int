[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 153426,
        "bookId": 85,
        "chapterId": 223,
        "headingId": 1086,
        "headingText": "\r\n<p>Kaposi sarcoma (KS) is a locally aggressive KSHV/HHV8 induced endothelial proliferation.</p>\r\n",
        "timestamp": "2026-08-26T14:42:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,

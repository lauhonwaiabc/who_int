[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 153137,
        "bookId": 85,
        "chapterId": 200,
        "headingId": 1086,
        "headingText": "\r\n<p>Leiomyomatosis peritonealis disseminata is a condition characterized by the presence of multiple benign smooth muscle nodules on peritoneal surfaces of the pelvic and abdominal cavities.</p>\r\n",
        "timestamp": "2026-08-26T10:47:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,

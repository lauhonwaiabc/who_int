[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152558,
        "bookId": 85,
        "chapterId": 155,
        "headingId": 1086,
        "headingText": "\r\n<p>Luteinized thecoma associated with sclerosing peritonitis is a bilateral ovarian spindle cell proliferation with variable luteinization associated with sclerosing peritonitis.</p>\r\n",
        "timestamp": "2026-08-26T10:14:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

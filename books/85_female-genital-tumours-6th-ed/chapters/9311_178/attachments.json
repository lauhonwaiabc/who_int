    "source": "W. Glenn McCluggage",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 439.45pt; background: #DAEEF3; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"586\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 230.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"307\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">If morphology and immunophenotype resemble a low-grade appendiceal mucinous neoplasm</span></p>\r\n</td>\r\n<td style=\"width: 208.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"278\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Low-grade mucinous neoplasm (appendiceal type) arising in teratoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 230.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"307\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">If morphology and immunophenotype resemble a high-grade appendiceal mucinous neoplasm</span></p>\r\n</td>\r\n<td style=\"width: 208.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"278\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">High-grade mucinous neoplasm (appendiceal type) arising in teratoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 230.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"307\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">If morphology and immunophenotype resemble a lower gastrointestinal-type adenocarcinoma</span></p>\r\n</td>\r\n<td style=\"width: 208.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"278\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Adenocarcinoma (large intestinal type) arising in teratoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 230.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"307\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">If morphology and immunophenotype resemble a typical ovarian mucinous borderline tumour</span></p>\r\n</td>\r\n<td style=\"width: 208.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"278\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Mucinous borderline tumour arising in or associated with teratoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 230.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"307\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">If morphology and immunophenotype resemble a typical ovarian mucinous adenocarcinoma</span></p>\r\n</td>\r\n<td style=\"width: 208.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"278\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Mucinous carcinoma arising in or associated with teratoma</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">References: <span class=\"Ref-PMID\">{33963606; 24300528}</span></p>",

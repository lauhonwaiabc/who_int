    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 151494,
        "bookId": 85,
        "chapterId": 38,
        "headingId": 1086,
        "headingText": "\r\n<p>Mixed tumour of the vagina is a benign neoplasm composed of an admixture of spindled and epithelial (glandular and/or squamous) elements.</p>\r\n",
        "timestamp": "2026-08-25T18:19:56"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

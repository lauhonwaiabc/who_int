    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1085,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1101,
    "contributions": [
      {
        "pkcontributionId": 154041,
        "bookId": 85,
        "chapterId": 276,
        "headingId": 1101,
        "headingText": "\r\n<p><em>Essential:</em> poorly circumscribed aggregates of pigmented dendritic melanocytes with fibroplasia.</p>\r\n",
        "timestamp": "2026-08-26T12:37:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1083,

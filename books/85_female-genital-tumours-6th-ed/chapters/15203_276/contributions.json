[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 154027,
        "bookId": 85,
        "chapterId": 276,
        "headingId": 1086,
        "headingText": "\r\n<p>Blue naevus is a benign subepithelial melanocytic neoplasm with a component of characteristic dendritic cells.</p>\r\n",
        "timestamp": "2026-08-26T12:37:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

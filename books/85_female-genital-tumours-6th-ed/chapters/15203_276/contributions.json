        "headingId": 1099,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2026-08-26T12:37:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1084,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1100,
    "contributions": [
      {
        "pkcontributionId": 154043,
        "bookId": 85,
        "chapterId": 276,
        "headingId": 1100,
        "headingText": "\r\n<p>The prognosis for blue naevus is excellent. As in other locations, transformation of a genital cellular blue naevus to melanoma can exceptionally occur {9700383}.</p>",
        "timestamp": "2026-08-26T12:37:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
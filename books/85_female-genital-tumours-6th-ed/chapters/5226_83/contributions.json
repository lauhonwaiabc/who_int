[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 151976,
        "bookId": 85,
        "chapterId": 83,
        "headingId": 1086,
        "headingText": "\r\n<p>Mixed carcinoma of the endometrium is a carcinoma composed of two or more discrete histological types of endometrial carcinoma, where at least one component is serous, clear cell, or mesonephric-like.</p>\r\n",
        "timestamp": "2026-08-25T18:48:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0

[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 151373,
        "bookId": 85,
        "chapterId": 31,
        "headingId": 1086,
        "headingText": "\r\n<p>Squamous intraepithelial lesions (SILs) of the vagina are proliferations of squamous cells caused by HPV infection. These cells show abnormal nuclear features and maturation abnormalities but do not extend below the basement membrane.</p>\r\n",
        "timestamp": "2026-08-25T18:11:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 151460,
        "bookId": 85,
        "chapterId": 39,
        "headingId": 1086,
        "headingText": "\r\n<p>Adenocarcinoma of Skene gland origin is an adenocarcinoma arising from the Skene (periurethral) glands, morphologically and immunohistochemically similar to prostatic adenocarcinoma.</p>\r\n",
        "timestamp": "2026-08-25T18:18:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,

  {
    "pkattachmentId": 78236,
    "bookid": 85,
    "chapterId": 78,
    "fileId": 56336,
    "type": "WSI",
    "diagnosis": "Extensive lymphovascular space invasion (LVSI) in endometrial carcinoma",
    "title": "",
    "legend": "Diffuse LVSI is observed within the myometrium (&gt;/- 4 in the slide)",
    "source": "Congrong R. Liu",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/56336.dzi",
    "thumbnail": null
  },
  {
    "pkattachmentId": 78237,
    "bookid": 85,
    "chapterId": 78,
    "fileId": 56337,
    "type": "WSI",
    "diagnosis": "Mismatch repair-deficient (MMRd) endometrioid carcinoma",
    "title": "",
    "legend": "Note solid sheets of tumor cells with a well‑demarcated, pushing border. On&nbsp;high‑power view the invasive front demonstrates a prominent tumor‑associated lymphocytic infiltrate (tumor‑infiltrating lymphocytes, TILs). This morphological pattern is a common histological feature of MMRd endometrial carcinomas",
    "source": "Congrong R. Liu",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/56337.dzi",
    "thumbnail": null
  },
  {
    "pkattachmentId": 78238,
    "bookid": 85,
    "chapterId": 78,
    "fileId": 56338,
    "type": "WSI",
    "diagnosis": "POLE-mutated&nbsp;endometrioid carcinoma, Grade 3",
    "title": "",
    "legend": "The tumor displays poorly differentiated glandular and papillary structures that merge into confluent solid areas. Tumor cells show marked nuclear pleomorphism and focally clear cytoplasm, accompanied by geographic necrosis",
    "source": "Congrong R. Liu",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/56338.dzi",
    "thumbnail": null
  },
  {
    "pkattachmentId": 78239,
    "bookid": 85,
    "chapterId": 78,
    "fileId": 56339,
    "type": "WSI",
    "diagnosis": "Microcystic, elongated, and fragmented pattern (MELF) in low-grade&nbsp;endometrioid carcinoma",
    "title": "",
    "legend": "The glands exhibiting the MELF pattern are characterized by microcystic dilation, elongated shapes, and a fragmented appearance, lined by flattened tumor cells. These glands are typically surrounded by a fibromyxoid and densely inflamed stroma",
    "source": "Congrong R. Liu",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/56339.dzi",
    "thumbnail": null
  },
  {
    "pkattachmentId": 78240,
    "bookid": 85,
    "chapterId": 78,
    "fileId": 56340,
    "type": "WSI",
    "diagnosis": "Endometrioid&nbsp;carcinoma, high-grade (grade 3)",
    "title": "",
    "legend": "The glandular architecture is largely effaced, replaced predominantly by a solid/nested pattern (&gt;50%) with only focal abortive gland formation. Tumor cells display high nuclear grade, conspicuous single large nucleoli, relatively uniform oval nuclei, good cohesion, and occasional glandular arrangement. Necrosis is present",
    "source": "Congrong R. Liu",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/56340.dzi",
    "thumbnail": null
  },
  {
    "pkattachmentId": 78241,
    "bookid": 85,
    "chapterId": 78,
    "fileId": 56344,
    "type": "WSI",
    "diagnosis": "FIGO Grade 1 endometrioid carcinoma with mucinous differentiation",
    "title": "",
    "legend": "Confluent glands infiltrate into the myometrium, with some glandular lumina filled with pale blue‑stained mucin.&nbsp; At higher power the tumor is composed of two distinct cell types: classic endometrioid glandular epithelium with cigar‑shaped nuclei, and mucinous glandular epithelium characterized by small, bland nuclei located at the basal aspect of the cells and cytoplasm distended by pale blue mucin",
    "source": "Congrong R. Liu",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/56344.dzi",
    "thumbnail": null
  },

        "chapterId": 291,
        "headingId": 1104,
        "headingText": "\r\n<p>606241 DICER 1, ribonuclease III; DICER1</p>\r\n",
        "timestamp": "2026-08-26T11:34:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1089,
    "bookid": 85,

[
  {
    "pkheadingid": 1087,
    "bookid": 85,
    "headingType": 3,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1103,
    "contributions": [
      {
        "pkcontributionId": 154199,
        "bookId": 85,
        "chapterId": 291,
        "headingId": 1103,
        "headingText": "\r\n<p><em>DICER1</em>-related tumour predisposition (<em>DICER1</em>) syndrome is an autosomal dominant disorder that increases the susceptibility of affected individuals to develop benign and malignant neoplasms across multiple organ systems, including the gynaecological tract. The condition is caused by heterozygous inactivating germline variants in <em>DICER1</em>, which plays an important role in microRNA biogenesis.</p>\r\n",
        "timestamp": "2026-08-26T11:34:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1088,

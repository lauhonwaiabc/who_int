  },
  {
    "pkattachmentId": 77405,
    "bookid": 85,
    "chapterId": 6,
    "fileId": 52883,
    "type": "Figure",
    "diagnosis": "HPV-associated high-grade squamous intraepithelial lesion",
    "title": "",
    "legend": "Some lesions have partially retained maturation with extension of the atypical basaloid population and mitoses up to the middle epithelial third (left aspect of the image). In addition, lichen simplex chronicus changes can be present, with abrupt hyperkeratosis and parakeratosis (right aspect of the image). Notice the presence of basal atypia throughout.",
    "source": "Carlos Parra-Herran",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/85/6/52883.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/85/6/thumb_52883.jpg"
  },
  {

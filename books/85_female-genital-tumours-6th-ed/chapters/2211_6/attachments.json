  },
  {
    "pkattachmentId": 77404,
    "bookid": 85,
    "chapterId": 6,
    "fileId": 52882,
    "type": "Figure",
    "diagnosis": "HPV-associated high-grade squamous intraepithelial lesion",
    "title": "",
    "legend": "Loss of squamous maturation is associated with cell overlapping and loss of polarity; increased N:C ratios with large, irregular, and hyperchromatic nuclei; and visible mitoses beyond the basal cell layer.",
    "source": "Carlos Parra-Herran",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/85/6/52882.jpg",

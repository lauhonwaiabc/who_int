[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152813,
        "bookId": 85,
        "chapterId": 173,
        "headingId": 1086,
        "headingText": "\r\n<p>Embryonal carcinoma is a malignant germ cell tumour composed of primitive large and pleomorphic epithelioid cells recapitulating the early stages of embryonic development.</p>\r\n",
        "timestamp": "2026-08-26T10:28:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,
    "bookid": 85,
    "headingType": 2,

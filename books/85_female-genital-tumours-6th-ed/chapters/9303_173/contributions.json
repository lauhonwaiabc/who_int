        "bookId": 85,
        "chapterId": 173,
        "headingId": 1087,
        "headingText": "<font color=\"red\">Classification in progress, Data not available in this Beta</font>",
        "timestamp": "2026-08-26T10:28:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1072,

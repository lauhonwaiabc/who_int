[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152148,
        "bookId": 85,
        "chapterId": 100,
        "headingId": 1086,
        "headingText": "\r\n<p>Endometrioid carcinoma of the fallopian tube is a malignant epithelial neoplasm showing endometrioid differentiation.</p>\r\n",
        "timestamp": "2026-08-25T19:05:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

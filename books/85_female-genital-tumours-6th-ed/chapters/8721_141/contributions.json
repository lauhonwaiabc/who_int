[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152421,
        "bookId": 85,
        "chapterId": 141,
        "headingId": 1086,
        "headingText": "\r\n<p>Borderline Brenner tumour is a neoplasm of urothelial-type epithelium displaying complex architecture and lacking stromal invasion.</p>\r\n",
        "timestamp": "2026-08-25T19:23:21"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 1087,

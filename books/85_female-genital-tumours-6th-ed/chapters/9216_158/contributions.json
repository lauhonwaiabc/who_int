        "chapterId": 158,
        "headingId": 1098,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2026-08-26T10:18:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1085,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1101,
    "contributions": [
      {
        "pkcontributionId": 152623,
        "bookId": 85,
        "chapterId": 158,
        "headingId": 1101,
        "headingText": "\r\n<p><em>Essential:</em> signet-ring cells in a fibromatous stroma EMA negative.</p>\r\n<p><em>Desirable: </em>positivity with sex cord markers; negative staining with cyclin&nbsp;D1 and no nuclear staining with &beta;-catenin; EMA negative; absent intracytoplasmic mucin.</p>\r\n",
        "timestamp": "2026-08-26T10:18:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1083,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 1099,
    "contributions": [
      {
        "pkcontributionId": 152624,
        "bookId": 85,
        "chapterId": 158,
        "headingId": 1099,
        "headingText": "\r\n<p>These are benign neoplasms and are not staged.</p>\r\n",
        "timestamp": "2026-08-26T10:18:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1084,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1100,
    "contributions": [
      {
        "pkcontributionId": 152625,
        "bookId": 85,
        "chapterId": 158,
        "headingId": 1100,
        "headingText": "\r\n<p>Signet ring stromal tumours are benign {36040033}.</p>",

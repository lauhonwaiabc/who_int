    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152609,
        "bookId": 85,
        "chapterId": 158,
        "headingId": 1086,
        "headingText": "\r\n<p>Signet ring stromal tumour is a benign pure stromal tumour composed of cells with signet-ring morphology in a fibromatous stroma.</p>\r\n",
        "timestamp": "2026-08-26T10:18:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

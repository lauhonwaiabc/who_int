[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 153409,
        "bookId": 85,
        "chapterId": 221,
        "headingId": 1086,
        "headingText": "\r\n<p><em>NTRK</em>-rearranged spindle cell sarcoma is a spindle cell tumour harbouring <em>NTRK1&ndash;3</em> gene rearrangements.</p>\r\n",
        "timestamp": "2026-08-26T14:41:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

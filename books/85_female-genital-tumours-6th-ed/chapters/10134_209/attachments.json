    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 467.75pt; background: #DAEEF3; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"624\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 85.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"114\">\r\n<p class=\"TableText\"><strong>Mutations</strong></p>\r\n</td>\r\n<td style=\"width: 382.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"510\">\r\n<p class=\"TableText\"><em>DICER1</em>, <em>TP53</em>, <em>ATRX</em>, <em>ARID1A</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 85.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"114\">\r\n<p class=\"TableText\"><strong>Fusions</strong></p>\r\n</td>\r\n<td style=\"width: 382.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"510\">\r\n<p class=\"TableText\"><em>ESR1</em>::<em>NCOA2</em>, <em>ESR1</em>::<em>NCOA3</em>; <em>JAZF1</em>::<em>BCORL1</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 85.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"114\">\r\n<p class=\"TableText\"><strong>Copy-number alterations</strong></p>\r\n</td>\r\n<td style=\"width: 382.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"510\">\r\n<p class=\"TableText\">Amplification of 8q13 and high-level copy-number gains of <em>MYBL1</em>, <em>MDM2/CDK4/HMGA2</em>, <em>CCNE1</em>; <em>BAP1</em> deletion, <em>TERT</em> promoter deletions; <em>RB1</em> loss; high copy-number alterations broadly in high-grade tumours</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

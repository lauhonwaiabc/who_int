[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152097,
        "bookId": 85,
        "chapterId": 96,
        "headingId": 1086,
        "headingText": "\r\n<p>Serous adenofibroma is a benign biphasic tumour composed of fibromatous stroma with papillae or cysts lined by tubal-type epithelium. Serous papilloma is a benign papillary tumour lined by the same epithelium.</p>\r\n",
        "timestamp": "2026-08-25T19:03:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

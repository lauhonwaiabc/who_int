        "bookId": 85,
        "chapterId": 12,
        "headingId": 1087,
        "headingText": "<font color=\"red\">Classification in progress, Data not available in this Beta</font>",
        "timestamp": "2026-08-25T18:09:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1072,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 1088,
    "contributions": [
      {
        "pkcontributionId": 151340,

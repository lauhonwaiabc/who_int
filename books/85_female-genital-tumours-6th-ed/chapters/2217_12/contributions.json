[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 151338,
        "bookId": 85,
        "chapterId": 12,
        "headingId": 1086,
        "headingText": "\r\n<p>Basal cell carcinoma (BCC) is a carcinoma that arises from epithelial cells of either the epidermis or hair follicle stem cells.</p>\r\n",
        "timestamp": "2026-08-25T18:09:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,
    "bookid": 85,
    "headingType": 2,

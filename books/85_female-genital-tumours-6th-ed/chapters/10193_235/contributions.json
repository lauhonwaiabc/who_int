[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 153596,
        "bookId": 85,
        "chapterId": 235,
        "headingId": 1086,
        "headingText": "\r\n<p>SMARC-deficient uterine sarcomas are undifferentiated neoplasms of uncertain histogenesis, typically demonstrating epithelioid cytomorphology and harbouring SWI/SNF complex alterations that inactivate <em>SMARCA4 </em>or rarely<em> SMARCB1.</em></p>\r\n",
        "timestamp": "2026-08-26T15:11:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 1087,

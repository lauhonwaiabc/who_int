        "chapterId": 159,
        "headingId": 1098,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2026-08-26T10:19:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1085,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1101,
    "contributions": [
      {
        "pkcontributionId": 152640,
        "bookId": 85,
        "chapterId": 159,
        "headingId": 1101,
        "headingText": "\r\n<p><em>Essential:</em> well-circumscribed tumour centred in the ovarian hilum, consisting of bland steroid cells.</p>\r\n<p><em>Desirable:</em> cytoplasmic Reinke crystals.</p>\r\n",
        "timestamp": "2026-08-26T10:19:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1083,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 1099,
    "contributions": [
      {
        "pkcontributionId": 152641,
        "bookId": 85,
        "chapterId": 159,
        "headingId": 1099,
        "headingText": "\r\n<p>These are benign neoplasms and are not staged.</p>\r\n",
        "timestamp": "2026-08-26T10:19:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1084,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1100,
    "contributions": [
      {
        "pkcontributionId": 152642,
        "bookId": 85,
        "chapterId": 159,
        "headingId": 1100,
        "headingText": "\r\n<p>If strict diagnostic criteria are used, Leydig cell tumours are almost always benign.</p>",
        "timestamp": "2026-08-26T10:19:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152626,
        "bookId": 85,
        "chapterId": 159,
        "headingId": 1086,
        "headingText": "\r\n<p>Leydig cell tumour is a benign steroid cell tumour confined to or predominantly located in the ovarian hilum.</p>\r\n",
        "timestamp": "2026-08-26T10:19:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

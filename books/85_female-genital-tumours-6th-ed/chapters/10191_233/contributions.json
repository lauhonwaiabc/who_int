[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 153562,
        "bookId": 85,
        "chapterId": 233,
        "headingId": 1086,
        "headingText": "\r\n<p>Cutaneous myxoma (superficial angiomyxoma) is a superficial tumour composed of well-delineated lobules of bland spindle-shaped to stellate cells and thin-walled arborizing vessels with prominent myxoid stroma. The term &ldquo;cutaneous myxoma&rdquo; is preferred because not all tumours display prominent blood vessels.</p>\r\n",
        "timestamp": "2026-08-26T15:09:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

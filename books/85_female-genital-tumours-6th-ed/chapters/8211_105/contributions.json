[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152166,
        "bookId": 85,
        "chapterId": 105,
        "headingId": 1086,
        "headingText": "\r\n<p>Serous cystadenoma, serous adenofibroma, and serous cystadenofibroma are benign ovarian serous tumours composed of lining epithelial cells resembling fallopian tube epithelium.</p>\r\n",
        "timestamp": "2026-08-25T19:09:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

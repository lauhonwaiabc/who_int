[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 151287,
        "bookId": 85,
        "chapterId": 18,
        "headingId": 1086,
        "headingText": "\r\n<p>Phyllodes tumour is a biphasic neoplasm that displays prominent intracanalicular architectural pattern with leaf-like stromal fronds, stromal hypercellularity, and is lined by mammary-type epithelium.</p>\r\n",
        "timestamp": "2026-08-25T18:07:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 151236,
        "bookId": 85,
        "chapterId": 15,
        "headingId": 1086,
        "headingText": "\r\n<p>Papillary hidradenoma is a benign glandular tumour associated with anogenital mammary-like glands.</p>\r\n",
        "timestamp": "2026-08-25T18:05:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

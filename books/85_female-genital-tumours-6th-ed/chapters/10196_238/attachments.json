    "source": "Nicholas R. Ladwig",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 318.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"424\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Modified Gynaecologic-Specific Criteria </span></strong></p>\r\n<p class=\"TableText\"><span class=\"Ref-PMID\"><span style=\"color: black; mso-color-alt: windowtext; mso-no-proof: no;\">{24418852; 30001237}</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 135.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"5\" width=\"180\">\r\n<p class=\"TableText\"><strong>Features associated with malignancy</strong></p>\r\n</td>\r\n<td style=\"width: 183.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"244\">\r\n<p class=\"TableText\">Size &ge;&nbsp;5&nbsp;cm</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 183.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"244\">\r\n<p class=\"TableText\">High-grade nuclear atypia</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 183.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"244\">\r\n<p class=\"TableText\">&gt;&nbsp;1&nbsp;mitotic figure/12&nbsp;mm<sup>2</sup></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 183.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"244\">\r\n<p class=\"TableText\">Lymphovascular invasion</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 183.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"244\">\r\n<p class=\"TableText\">Necrosis</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 135.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"180\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Criteria for malignancy</span></strong></p>\r\n</td>\r\n<td style=\"width: 183.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"244\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">&ge;&nbsp;3&nbsp;features* </span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">*Tumours not meeting malignancy criteria should be considered to be of uncertain malignant potential.</p>",

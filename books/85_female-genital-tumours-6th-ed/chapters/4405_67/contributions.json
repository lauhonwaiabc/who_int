[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 151805,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1086,
        "headingText": "\r\n<p>Carcinoma of the uterine cervix, unclassifiable, is an invasive malignant epithelial tumour of the cervix that cannot be further subclassified.</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 1087,
    "contributions": [
      {
        "pkcontributionId": 151806,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1087,
        "headingText": "<font color=\"red\">Classification in progress, Data not available in this Beta</font>",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1072,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 1088,
    "contributions": [
      {
        "pkcontributionId": 151807,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1088,
        "headingText": "<font color=\"red\">Classification in progress, Data not available in this Beta</font>",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1073,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 1089,
    "contributions": [
      {
        "pkcontributionId": 151808,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1089,
        "headingText": "\r\n<p><em>Acceptable:</em> poorly differentiated carcinoma.</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1074,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 1090,
    "contributions": [
      {
        "pkcontributionId": 151809,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1090,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1075,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 1091,
    "contributions": [
      {
        "pkcontributionId": 151810,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1091,
        "headingText": "\r\n<p>These tumours are localized to the cervix.</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1076,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 1092,
    "contributions": [
      {
        "pkcontributionId": 151811,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1092,
        "headingText": "\r\n<p>The clinical features are similar to those of cervical carcinoma in general.</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1077,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 1093,
    "contributions": [
      {
        "pkcontributionId": 151812,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1093,
        "headingText": "\r\n<p>Unclassifiable carcinomas of the cervix are exceedingly rare, accounting for a very small percentage of cervical carcinomas, and should only be diagnosed after extensive histopathological evaluation excludes other tumour types. Little reliable epidemiological data are available.</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1078,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 1094,
    "contributions": [
      {
        "pkcontributionId": 151813,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1094,
        "headingText": "\r\n<p>Data are limited, but most cases are HPV associated and/or block-type p16-positive {25884453}.</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1079,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 1095,
    "contributions": [
      {
        "pkcontributionId": 151814,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1095,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1086,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 1102,
    "contributions": [
      {
        "pkcontributionId": 151815,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1102,
        "headingText": "\r\n<p>The macroscopic appearance is similar to that of cervical carcinoma generally.</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1080,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 1096,
    "contributions": [
      {
        "pkcontributionId": 151816,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1096,
        "headingText": "\r\n<p>The tumours demonstrate an epithelial phenotype but lack histological or immunohistochemical features of other specific types of cervical carcinoma (e.g. squamous cell carcinoma, adenocarcinoma, and neuroendocrine carcinoma). Gynaecological and non-gynaecological malignancies that secondarily involve the cervix should be excluded {23748795; 32910021; 22353422}, including sarcomas and other non-epithelial malignancies with cytokeratin and other epithelial marker positivity. Diffuse expression of p63, p40, and/or CK5/6 should elicit consideration of a squamous cell carcinoma {32843061; 25884453}. Sometimes when this diagnosis is made on a biopsy specimen, areas diagnostic of other neoplasms may be present in a subsequent resection specimen.</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1081,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 1097,
    "contributions": [
      {
        "pkcontributionId": 151817,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1097,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1082,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 1098,
    "contributions": [
      {
        "pkcontributionId": 151818,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1098,
        "headingText": "\r\n<p>HPV testing may be useful in determining an HPV association.</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1085,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1101,
    "contributions": [
      {
        "pkcontributionId": 151819,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1101,
        "headingText": "\r\n<p><em>Essential:</em> a primary invasive malignant epithelial neoplasm lacking specific features of differentiation; molecular analysis and/or p16 immunohistochemistry may help in determining HPV-associated etiology.</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1083,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 1099,
    "contributions": [
      {
        "pkcontributionId": 151820,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1099,
        "headingText": "\r\n<p>These neoplasms are staged using the FIGO and TNM staging systems.</p>\r\n",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1084,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1100,
    "contributions": [
      {
        "pkcontributionId": 151821,
        "bookId": 85,
        "chapterId": 67,
        "headingId": 1100,
        "headingText": "\r\n<p>In a SEER analysis, the 10-year cause-specific survival rate was 84.9%, not statistically different from that of cervical squamous cell carcinoma, and 70% of cases were American Joint Committee on Cancer (AJCC) stage&nbsp;I {17718897}.</p>",
        "timestamp": "2026-08-25T18:40:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 153000,
        "bookId": 85,
        "chapterId": 188,
        "headingId": 1086,
        "headingText": "\r\n<p>Solid pseudopapillary neoplasm is a low-grade malignant tumour identical to its pancreatic counterpart morphologically and immunohistochemically.</p>\r\n",
        "timestamp": "2026-08-26T10:39:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

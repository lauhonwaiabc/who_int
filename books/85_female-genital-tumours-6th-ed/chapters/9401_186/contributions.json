[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 153545,
        "bookId": 85,
        "chapterId": 186,
        "headingId": 1086,
        "headingText": "\r\n<p>Ovarian myxoma is a benign tumour with an abundant myxoid matrix that histologically resembles intramuscular myxoma of soft tissue.</p>\r\n",
        "timestamp": "2026-08-26T15:08:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "chapterId": 186,
        "headingId": 1098,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2026-08-26T15:08:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1085,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1101,
    "contributions": [
      {
        "pkcontributionId": 153559,
        "bookId": 85,
        "chapterId": 186,
        "headingId": 1101,
        "headingText": "\r\n<p><em>Essential:</em> paucicellular tumour with extensive myxoid matrix; oval to spindle cells with bland cytological features; abundant capillaries with or without plexiform arrangement.</p>\r\n",
        "timestamp": "2026-08-26T15:08:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1083,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 1099,
    "contributions": [
      {
        "pkcontributionId": 153560,
        "bookId": 85,
        "chapterId": 186,
        "headingId": 1099,
        "headingText": "\r\n<p>These are benign tumours and are not staged.</p>\r\n",
        "timestamp": "2026-08-26T15:08:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1084,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1100,
    "contributions": [
      {
        "pkcontributionId": 153561,
        "bookId": 85,
        "chapterId": 186,
        "headingId": 1100,
        "headingText": "\r\n<p>These tumours are benign {2032767}.</p>",
        "timestamp": "2026-08-26T15:08:46"
      }

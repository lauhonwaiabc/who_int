    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 523.55pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"698\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 81.9pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"109\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Stage</span></strong></p>\r\n</td>\r\n<td style=\"width: 441.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"589\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Criteria</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 81.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"109\">\r\n<p class=\"TableText\"><strong>pM1a</strong></p>\r\n</td>\r\n<td style=\"width: 441.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"589\">\r\n<p class=\"TableText\">Acellular mucin on peritoneal surfaces other than the appendix/mesoappendix</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 81.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"109\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">pM1b</span></strong></p>\r\n</td>\r\n<td style=\"width: 441.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"589\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Cellular mucinous tumour deposits on peritoneal surfaces other than the appendix/mesoappendix</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 81.9pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"109\">\r\n<p class=\"TableText\"><strong>pM1c</strong></p>\r\n</td>\r\n<td style=\"width: 441.65pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"589\">\r\n<p class=\"TableText\">Mucinous tumour deposits on sites other than the peritoneum</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 153358,
        "bookId": 85,
        "chapterId": 218,
        "headingId": 1086,
        "headingText": "\r\n<p>Angiomyofibroblastoma is a benign, well-circumscribed, and superficially located stromal fibroblastic tumour, usually arising in the vulva and vagina and less frequently in the perineum and inguinal area.</p>\r\n",
        "timestamp": "2026-08-26T14:37:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

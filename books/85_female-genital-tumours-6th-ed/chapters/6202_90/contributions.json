[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152079,
        "bookId": 85,
        "chapterId": 90,
        "headingId": 1086,
        "headingText": "\r\n<p><em>STK11</em> adnexal tumour is a neoplasm of uncertain histogenesis usually arising in the paratubal soft tissue, with multiple growth patterns and <em>STK11</em> genomic alterations.</p>\r\n",
        "timestamp": "2026-08-25T18:55:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,

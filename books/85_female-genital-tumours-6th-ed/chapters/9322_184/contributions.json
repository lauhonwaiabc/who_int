[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152966,
        "bookId": 85,
        "chapterId": 184,
        "headingId": 1086,
        "headingText": "\r\n<p>Mixed germ cell&ndash;sex cord stromal tumour, unclassified, is a neoplasm composed of germ cells and sex cord cells that do not have the appearance of a gonadoblastoma and that occur in phenotypically and genetically female patients.</p>\r\n",
        "timestamp": "2026-08-26T10:31:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

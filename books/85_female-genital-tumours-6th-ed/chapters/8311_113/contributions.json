[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152234,
        "bookId": 85,
        "chapterId": 113,
        "headingId": 1086,
        "headingText": "\r\n<p>Mucinous cystadenoma and mucinous adenofibroma of ovary are benign tumours with gastrointestinal or M&uuml;llerian-type mucinous epithelium.</p>\r\n",
        "timestamp": "2026-08-25T19:13:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

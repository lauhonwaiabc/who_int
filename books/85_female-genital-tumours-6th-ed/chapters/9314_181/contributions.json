  },
  {
    "pkheadingid": 1085,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1101,
    "contributions": [
      {
        "pkcontributionId": 152946,
        "bookId": 85,
        "chapterId": 181,
        "headingId": 1101,
        "headingText": "\r\n<p><em>Essential:</em> lesion composed entirely of single mature tissue originating from one germ cell layer.</p>\r\n",
        "timestamp": "2026-08-26T10:37:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1083,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 1099,
    "contributions": [
      {
        "pkcontributionId": 152947,
        "bookId": 85,
        "chapterId": 181,
        "headingId": 1099,
        "headingText": "\r\n<p>These are benign tumours and are not staged.</p>\r\n",
        "timestamp": "2026-08-26T10:37:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1084,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1100,
    "contributions": [
      {
        "pkcontributionId": 152948,
        "bookId": 85,
        "chapterId": 181,
        "headingId": 1100,
        "headingText": "\r\n<p>Monodermal teratomas are benign.</p>",
        "timestamp": "2026-08-26T10:37:24"
      }
    ],

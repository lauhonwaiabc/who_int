[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152932,
        "bookId": 85,
        "chapterId": 181,
        "headingId": 1086,
        "headingText": "\r\n<p>Monodermal teratoma is a benign tumour composed of mature tissue derived from one germ layer (ectoderm, endoderm, or mesoderm).</p>\r\n",
        "timestamp": "2026-08-26T10:37:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

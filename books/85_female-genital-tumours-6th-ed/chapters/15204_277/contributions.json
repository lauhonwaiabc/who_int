[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 154044,
        "bookId": 85,
        "chapterId": 277,
        "headingId": 1086,
        "headingText": "\r\n<p>Atypical melanocytic naevus of genital type (AMNGT) is a melanocytic neoplasm occurring in the genital area, with histological atypical features and a benign clinical course.</p>\r\n",
        "timestamp": "2026-08-26T12:36:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 1087,
    "contributions": [

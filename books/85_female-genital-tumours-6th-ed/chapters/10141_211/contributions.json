        "headingId": 1099,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2026-08-26T14:29:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1084,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1100,
    "contributions": [
      {
        "pkcontributionId": 153272,
        "bookId": 85,
        "chapterId": 211,
        "headingId": 1100,
        "headingText": "\r\n<p>These are benign tumours.</p>",
        "timestamp": "2026-08-26T14:29:44"
      }
    ],

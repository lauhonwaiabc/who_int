  },
  {
    "pkheadingid": 1072,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 1088,
    "contributions": [
      {
        "pkcontributionId": 152064,
        "bookId": 85,

[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 152062,
        "bookId": 85,
        "chapterId": 89,
        "headingId": 1086,
        "headingText": "\r\n<p>Wolffian tumour is a tumour of presumed mesonephric (Wolffian) origin.</p>\r\n",
        "timestamp": "2026-08-25T18:54:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,

    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 151601,
        "bookId": 85,
        "chapterId": 53,
        "headingId": 1086,
        "headingText": "\r\n<p>Endocervical polyp is a benign exophytic lesion with a stromal core lined by bland mucinous endocervical epithelium and/or metaplastic squamous epithelium.</p>\r\n",
        "timestamp": "2026-08-25T18:29:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

[
  {
    "pkheadingid": 1070,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1086,
    "contributions": [
      {
        "pkcontributionId": 151407,
        "bookId": 85,
        "chapterId": 33,
        "headingId": 1086,
        "headingText": "\r\n<p>Squamous cell carcinoma (SCC), HPV-independent, is an invasive and/or exophytic malignant, epithelial tumour exhibiting pure squamous differentiation and arising through mechanisms not associated with HPV infection.</p>\r\n",
        "timestamp": "2026-08-25T18:13:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1071,
    "bookid": 85,

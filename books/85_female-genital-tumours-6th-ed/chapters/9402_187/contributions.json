  },
  {
    "pkheadingid": 1085,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1101,
    "contributions": [
      {
        "pkcontributionId": 152997,
        "bookId": 85,
        "chapterId": 187,
        "headingId": 1101,
        "headingText": "\r\n<p><em>Essential:</em> rete cystadenoma: hilar location, cyst lined by non-ciliated epithelium; rete adenoma: hilar location, well-circumscribed; small compact tubules; no cytological atypia.</p>\r\n",
        "timestamp": "2026-08-26T10:38:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1083,
    "bookid": 85,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 1099,
    "contributions": [
      {
        "pkcontributionId": 152998,
        "bookId": 85,
        "chapterId": 187,
        "headingId": 1099,
        "headingText": "\r\n<p>These are benign neoplasms and are not staged.</p>\r\n",
        "timestamp": "2026-08-26T10:38:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1084,

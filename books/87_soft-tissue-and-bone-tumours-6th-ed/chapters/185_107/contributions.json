        "chapterId": 107,
        "headingId": 1159,
        "headingText": "\r\n<p>8901/3 Pleomorphic rhabdomyosarcoma NOS</p>\r\n",
        "timestamp": "2026-08-31T16:12:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1121,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 1160,
    "contributions": [
      {
        "pkcontributionId": 155458,
        "bookId": 87,
        "chapterId": 107,
        "headingId": 1160,
        "headingText": "\r\n<p>2B55.Z &amp; XH5SX9 Rhabdomyosarcoma, primary site &amp; Pleomorphic rhabdomyosarcoma NOS</p>\r\n",
        "timestamp": "2026-08-31T16:12:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1122,
    "bookid": 87,
    "headingType": 2,

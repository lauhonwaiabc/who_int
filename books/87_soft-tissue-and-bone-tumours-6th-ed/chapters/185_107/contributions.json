        "bookId": 87,
        "chapterId": 107,
        "headingId": 1161,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2026-08-31T16:12:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1123,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 1162,

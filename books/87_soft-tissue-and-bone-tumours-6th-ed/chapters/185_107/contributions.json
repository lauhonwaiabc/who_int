[
  {
    "pkheadingid": 1119,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1158,
    "contributions": [
      {
        "pkcontributionId": 155456,
        "bookId": 87,
        "chapterId": 107,
        "headingId": 1158,
        "headingText": "\r\n<p>Pleomorphic rhabdomyosarcoma is a high-grade pleomorphic sarcoma of adults with a variable component of bizarre, brightly eosinophilic polygonal, round, and spindle cells displaying skeletal muscle differentiation.</p>\r\n",
        "timestamp": "2026-08-31T16:12:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1120,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

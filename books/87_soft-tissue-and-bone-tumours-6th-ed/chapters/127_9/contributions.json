        "headingId": 1170,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2026-08-31T14:34:32"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1134,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1173,
    "contributions": [
      {
        "pkcontributionId": 154382,
        "bookId": 87,
        "chapterId": 9,
        "headingId": 1173,
        "headingText": "\r\n<p><em>Essential:</em> extrauterine location; admixture of well-differentiated, cytologically bland smooth muscle and mature fat.</p>\r\n",
        "timestamp": "2026-08-31T14:34:32"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

[
  {
    "pkheadingid": 1119,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1158,
    "contributions": [
      {
        "pkcontributionId": 156340,
        "bookId": 87,
        "chapterId": 252,
        "headingId": 1158,
        "headingText": "\r\n<p>Anastomosing haemangioma is a benign vascular neoplasm that is poorly marginated and composed of thin-walled anastomosing vessels lined by a monolayer of endothelial cells with protuberant nuclei.</p>\r\n",
        "timestamp": "2026-09-01T10:10:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1120,
    "bookid": 87,

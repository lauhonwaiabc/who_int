        "headingId": 1171,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2026-09-01T10:10:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1133,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1172,
    "contributions": [
      {
        "pkcontributionId": 156356,
        "bookId": 87,
        "chapterId": 252,
        "headingId": 1172,
        "headingText": "\r\n<p>Anastomosing haemangiomas, even when multicentric or infiltrative, are benign.</p>",
        "timestamp": "2026-09-01T10:10:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

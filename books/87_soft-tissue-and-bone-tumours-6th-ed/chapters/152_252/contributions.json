        "chapterId": 252,
        "headingId": 1159,
        "headingText": "\r\n<p>9120/0 Haemangioma NOS</p>\r\n",
        "timestamp": "2026-09-01T10:10:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1121,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",

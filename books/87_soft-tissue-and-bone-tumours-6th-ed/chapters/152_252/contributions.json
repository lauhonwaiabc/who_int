      {
        "pkcontributionId": 156353,
        "bookId": 87,
        "chapterId": 252,
        "headingId": 1170,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2026-09-01T10:10:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1134,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1173,
    "contributions": [
      {
        "pkcontributionId": 156354,
        "bookId": 87,
        "chapterId": 252,
        "headingId": 1173,
        "headingText": "\r\n<p><em>Essential:</em> anastomosing vessels lined by hobnail endothelial cells, often in association with fibrin thrombi, hyaline globules, and extramedullary haematopoiesis.</p>\r\n",
        "timestamp": "2026-09-01T10:10:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1132,

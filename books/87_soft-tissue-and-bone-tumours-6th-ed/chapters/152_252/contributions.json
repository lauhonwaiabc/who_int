        "bookId": 87,
        "chapterId": 252,
        "headingId": 1160,
        "headingText": "\r\n<p>2E81.0Z Neoplastic haemangioma, unspecified</p>\r\n",
        "timestamp": "2026-09-01T10:10:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

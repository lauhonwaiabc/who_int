[
  {
    "pkheadingid": 1119,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1158,
    "contributions": [
      {
        "pkcontributionId": 154708,
        "bookId": 87,
        "chapterId": 27,
        "headingId": 1158,
        "headingText": "\r\n<p>Fibroma of tendon sheath (FTS) is a benign fibroblastic/myofibroblastic spindle cell neoplasm, usually attached to a tendon sheath.</p>\r\n",
        "timestamp": "2026-08-31T14:47:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1120,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,

    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 188.5pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"251\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 278.5pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"371\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Syndrome characteristics</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 188.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"251\">\r\n<p class=\"TableText\"><strong>Syndrome MIM number(s)</strong></p>\r\n</td>\r\n<td style=\"width: 278.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"371\">\r\n<p class=\"TableText\">166000, 614569, 156250</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 188.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"251\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 278.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"371\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Chondrosarcoma, angiosarcoma, astrocytoma, pituitary adenomas, juvenile granulosa cell tumour, pancreatic adenocarcinoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 188.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"251\">\r\n<p class=\"TableText\"><strong>Associated benign tumours</strong></p>\r\n</td>\r\n<td style=\"width: 278.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"371\">\r\n<p class=\"TableText\">Enchondroma, haemangioma, cavernous haemangioma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 188.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"251\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cancer-related inheritance</span></strong></p>\r\n</td>\r\n<td style=\"width: 278.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"371\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Sporadic, somatic mosaic</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 188.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"251\">\r\n<p class=\"TableText\"><strong>Chromosome location</strong></p>\r\n</td>\r\n<td style=\"width: 278.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"371\">\r\n<p class=\"TableText\"><em style=\"mso-bidi-font-style: normal;\">IDH1</em><span style=\"mso-bidi-font-style: italic;\"> (2q34)</span></p>\r\n<p class=\"TableText\"><em style=\"mso-bidi-font-style: normal;\">IDH2</em><span style=\"mso-bidi-font-style: italic;\"> (15q26.1)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 188.5pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"251\">\r\n<p 
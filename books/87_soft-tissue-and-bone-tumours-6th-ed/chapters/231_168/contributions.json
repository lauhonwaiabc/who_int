[
  {
    "pkheadingid": 1119,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1158,
    "contributions": [
      {
        "pkcontributionId": 157276,
        "bookId": 87,
        "chapterId": 168,
        "headingId": 1158,
        "headingText": "\r\n<p>Desmoplastic fibroma of bone is an extremely rare and locally aggressive bone tumour composed of bland spindle cells set in abundant collagenous stroma. It is a diagnosis of exclusion.</p>\r\n",
        "timestamp": "2026-09-01T14:35:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1120,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

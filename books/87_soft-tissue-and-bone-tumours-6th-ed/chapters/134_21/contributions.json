        "bookId": 87,
        "chapterId": 21,
        "headingId": 1170,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2026-08-31T14:43:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1134,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1173,
    "contributions": [
      {
        "pkcontributionId": 154603,
        "bookId": 87,
        "chapterId": 21,
        "headingId": 1173,
        "headingText": "\r\n<p><em>Essential:</em> zonal appearance with central fibrinoid degeneration and cystic changes; periphery with granulation tissue&ndash;like vascular component; admixed plump ganglion-like myofibroblasts.</p>\r\n",
        "timestamp": "2026-08-31T14:43:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1132,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 1171,
    "contributions": [
      {
        "pkcontributionId": 154604,
        "bookId": 87,
        "chapterId": 21,
        "headingId": 1171,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2026-08-31T14:43:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1133,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1172,
    "contributions": [
      {
        "pkcontributionId": 154605,
        "bookId": 87,
        "chapterId": 21,
        "headingId": 1172,
        "headingText": "\r\n<p>Patients are usually cured by local excision even if incomplete. Recurrences may rarely develop in immobilized patients because of persistence of the underlying cause.</p>",
        "timestamp": "2026-08-31T14:43:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
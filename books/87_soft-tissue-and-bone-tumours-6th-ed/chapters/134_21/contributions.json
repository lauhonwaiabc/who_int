[
  {
    "pkheadingid": 1119,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1158,
    "contributions": [
      {
        "pkcontributionId": 154589,
        "bookId": 87,
        "chapterId": 21,
        "headingId": 1158,
        "headingText": "\r\n<p>Ischaemic fasciitis is a reactive pseudosarcomatous fibroblastic/myofibroblastic proliferation, often associated with prolonged compression of soft tissue overlying bony prominences.</p>\r\n",
        "timestamp": "2026-08-31T14:43:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1120,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

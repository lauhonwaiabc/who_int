[
  {
    "pkheadingid": 1119,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1158,
    "contributions": [
      {
        "pkcontributionId": 154861,
        "bookId": 87,
        "chapterId": 35,
        "headingId": 1158,
        "headingText": "\r\n<p>Nuchal-type fibroma is a benign fibroblastic proliferation that commonly arises in the posterior neck in middle-aged adults.</p>\r\n",
        "timestamp": "2026-08-31T14:56:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1120,

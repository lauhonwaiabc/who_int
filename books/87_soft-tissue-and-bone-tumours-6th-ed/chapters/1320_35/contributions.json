        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2026-08-31T14:56:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1134,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1173,
    "contributions": [
      {
        "pkcontributionId": 154875,
        "bookId": 87,
        "chapterId": 35,
        "headingId": 1173,
        "headingText": "\r\n<p><em>Essential:</em> a hypocellular collagenous lesion with bland fibroblasts; entrapped adipose tissue and small nerve bundles; typically arising at the posterior aspect of neck in adults.</p>\r\n",
        "timestamp": "2026-08-31T14:56:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1132,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 1171,
    "contributions": [
      {
        "pkcontributionId": 154876,
        "bookId": 87,
        "chapterId": 35,
        "headingId": 1171,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2026-08-31T14:56:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1133,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1172,
    "contributions": [
      {
        "pkcontributionId": 154877,
        "bookId": 87,
        "chapterId": 35,
        "headingId": 1172,
        "headingText": "\r\n<p>Nuchal-type fibroma is benign. Surgical excision is the treatment of choice. With incomplete excision, local recurrence may occur in as many as 20% of patients {9921988; 32871744}, but metastasis does not occur.</p>",
        "timestamp": "2026-08-31T14:56:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
[
  {
    "pkheadingid": 1119,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1158,
    "contributions": [
      {
        "pkcontributionId": 155847,
        "bookId": 87,
        "chapterId": 283,
        "headingId": 1158,
        "headingText": "\r\n<p>Acral fibrochondromyxoid tumour (AFCMT) is a benign mesenchymal neoplasm of uncertain differentiation arising in acral sites and composed of bland spindle or round cells arranged in a chondromyxoid stroma lobulated by fibrovascular septa.</p>\r\n",
        "timestamp": "2026-08-31T16:35:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

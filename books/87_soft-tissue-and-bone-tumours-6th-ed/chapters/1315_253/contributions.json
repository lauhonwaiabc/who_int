[
  {
    "pkheadingid": 1119,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1158,
    "contributions": [
      {
        "pkcontributionId": 154776,
        "bookId": 87,
        "chapterId": 253,
        "headingId": 1158,
        "headingText": "\r\n<p><em>SMAD3</em>-rearranged fibroblastic tumour is a benign spindle cell neoplasm with <em>EWSR1</em>::<em>SMAD3</em> fusion and a predilection for superficial acral sites, characterized by alternating cellular fascicles and hyalinized areas.</p>\r\n",
        "timestamp": "2026-08-31T14:52:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1120,

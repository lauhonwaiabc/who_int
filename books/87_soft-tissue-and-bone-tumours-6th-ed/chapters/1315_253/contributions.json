        "chapterId": 253,
        "headingId": 1159,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2026-08-31T14:52:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1121,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,

[
  {
    "pkheadingid": 1119,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1158,
    "contributions": [
      {
        "pkcontributionId": 154793,
        "bookId": 87,
        "chapterId": 276,
        "headingId": 1158,
        "headingText": "\r\n<p><em>PRRX1</em>-rearranged fibroblastic tumour is a benign spindle cell neoplasm characterized by <em>PRRX1</em> rearrangements, most often with <em>NCOA1</em>.</p>\r\n",
        "timestamp": "2026-08-31T14:52:32"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

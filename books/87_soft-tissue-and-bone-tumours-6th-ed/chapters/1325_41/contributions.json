      {
        "pkcontributionId": 154959,
        "bookId": 87,
        "chapterId": 41,
        "headingId": 1170,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2026-08-31T15:00:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1134,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1173,
    "contributions": [
      {
        "pkcontributionId": 154960,
        "bookId": 87,
        "chapterId": 41,
        "headingId": 1173,
        "headingText": "\r\n<p><em>Essential:</em> an admixture of mature fat, short fascicles of bland spindle cells and lipoblast-like cells; infiltrative margins; most often in the hands and feet of young children.</p>\r\n",
        "timestamp": "2026-08-31T15:00:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1132,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 1171,
    "contributions": [
      {
        "pkcontributionId": 154961,
        "bookId": 87,
        "chapterId": 41,
        "headingId": 1171,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2026-08-31T15:00:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1133,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1172,
    "contributions": [
      {
        "pkcontributionId": 154962,
        "bookId": 87,
        "chapterId": 41,
        "headingId": 1172,
        "headingText": "\r\n<p>LPF has a high rate of local recurrence but no metastatic potential. Congenital onset, male sex, acral location, mitotic activity in the fibroblastic component, and incomplete excision may be risk factors for recurrence {11075850}.</p>",
        "timestamp": "2026-08-31T15:00:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2026-08-31T14:48:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1133,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 1172,
    "contributions": [
      {
        "pkcontributionId": 154741,
        "bookId": 87,
        "chapterId": 28,
        "headingId": 1172,
        "headingText": "\r\n<p>Desmoplastic fibroblastoma is benign and rarely recurs {9670823; 36426824}.</p>",
        "timestamp": "2026-08-31T14:48:46"
      }
    ],

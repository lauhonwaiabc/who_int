    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1134,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 1173,
    "contributions": [
      {
        "pkcontributionId": 154739,
        "bookId": 87,
        "chapterId": 28,
        "headingId": 1173,
        "headingText": "\r\n<p><em>Essential:</em> hypocellular and hypovascular tumour with abundant collagenous stroma; bland spindled and stellate cells.</p>\r\n",
        "timestamp": "2026-08-31T14:48:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

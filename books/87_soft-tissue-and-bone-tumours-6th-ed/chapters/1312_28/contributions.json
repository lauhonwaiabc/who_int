[
  {
    "pkheadingid": 1119,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1158,
    "contributions": [
      {
        "pkcontributionId": 154725,
        "bookId": 87,
        "chapterId": 28,
        "headingId": 1158,
        "headingText": "\r\n<p>Desmoplastic fibroblastoma is a benign, paucicellular, hypovascular neoplasm composed of bland spindle or stellate fibroblasts within abundant collagenous stroma.</p>\r\n",
        "timestamp": "2026-08-31T14:48:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1120,
    "bookid": 87,
    "headingType": 2,

[
  {
    "pkheadingid": 1119,
    "bookid": 87,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 1158,
    "contributions": [
      {
        "pkcontributionId": 156238,
        "bookId": 87,
        "chapterId": 269,
        "headingId": 1158,
        "headingText": "\r\n<p>Synovial vascular anomalies (SVAs), formerly referred to as synovial haemangiomas, comprise a heterogeneous group of vascular lesions primarily involving synovium-lined surfaces, including the intra-articular region and bursal spaces.</p>\r\n",
        "timestamp": "2026-09-01T09:40:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

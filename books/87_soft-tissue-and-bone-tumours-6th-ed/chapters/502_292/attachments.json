    "chapterId": 292,
    "fileId": 55299,
    "type": "Figure",
    "diagnosis": "<em>NFATC2</em>-rearranged sarcoma",
    "title": "",
    "legend": "The tumour is composed of a cellular proliferation with destruction of the bone (shown here). The morphology is highly heterogeneous. The tumour cells can be small to medium-sized and round and/or spindled (Fig. &lt;&lt;#55310&gt;&gt;), diffusely organized in trabeculae (Fig. &lt;&lt;#55312&gt;&gt;), or organized in nests (Fig. &lt;&lt;#55313&gt;&gt;).",
    "source": "Karoly Szuhai",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/87/292/55299.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/87/292/thumb_55299.jpg"
  },

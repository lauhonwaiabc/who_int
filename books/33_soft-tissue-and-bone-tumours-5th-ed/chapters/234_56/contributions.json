    "headingid": 240,
    "contributions": [
      {
        "pkcontributionId": 58758,
        "bookId": 33,
        "chapterId": 56,
        "headingId": 240,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:47:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 410,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 243,
    "contributions": [
      {
        "pkcontributionId": 58759,
        "bookId": 33,
        "chapterId": 56,
        "headingId": 243,
        "headingText": "\r\n<p><em>Essential:</em> multinodular superficial soft tissue neoplasm; histiocytoid mononuclear cell population with osteoclastic giant cells; haemosiderin deposition and metaplastic bone formation are commonly observed.</p>\r\n",
        "timestamp": "2019-12-11T11:47:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 408,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 241,
    "contributions": [
      {
        "pkcontributionId": 58760,
        "bookId": 33,
        "chapterId": 56,
        "headingId": 241,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:47:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 409,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 242,
    "contributions": [
      {
        "pkcontributionId": 58761,
        "bookId": 33,
        "chapterId": 56,
        "headingId": 242,
        "headingText": "\r\n<p>Giant cell tumour of soft tissue is associated with a local recurrence rate of 12%, with very rare metastasis {10496598; 10716152; 10680893}.</p>",
        "timestamp": "2019-12-11T11:47:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

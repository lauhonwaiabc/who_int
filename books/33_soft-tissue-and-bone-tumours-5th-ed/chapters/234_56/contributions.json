    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 228,
    "contributions": [
      {
        "pkcontributionId": 58745,
        "bookId": 33,
        "chapterId": 56,
        "headingId": 228,
        "headingText": "\r\n<p>Giant cell tumour of soft tissue is morphologically similar to but genetically unrelated to giant cell tumour of bone.</p>\r\n",
        "timestamp": "2019-12-11T11:47:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 396,

  },
  {
    "pkheadingid": 410,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 243,
    "contributions": [
      {
        "pkcontributionId": 58572,
        "bookId": 33,
        "chapterId": 50,
        "headingId": 243,
        "headingText": "\r\n<p><em>Essential:</em> diffusely infiltrative growth, often between skeletal muscle fibres; cellular fascicles of spindle cells with pale eosinophilic cytoplasm; at least focally moderate nuclear atypia; variable expression of SMA and/or desmin.</p>\r\n",
        "timestamp": "2019-12-11T11:24:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

      {
        "pkcontributionId": 58573,
        "bookId": 33,
        "chapterId": 50,
        "headingId": 241,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:24:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 409,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 242,
    "contributions": [
      {
        "pkcontributionId": 58574,
        "bookId": 33,
        "chapterId": 50,
        "headingId": 242,
        "headingText": "\r\n<p>Low-grade myofibroblastic sarcoma often recurs locally, but metastases are rare, most often occurring after a prolonged time interval {9777985}.</p>",
        "timestamp": "2019-12-11T11:24:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

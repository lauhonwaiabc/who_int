  },
  {
    "pkattachmentId": 34265,
    "bookid": 33,
    "chapterId": 161,
    "fileId": 6152,
    "type": "Figure",
    "diagnosis": "<p>Giant cell tumour of bone</p>",
    "title": "",
    "legend": "<p>An area of foamy macrophages in a giant cell tumour of bone, which would have previously been called a benign fibrous histiocytoma. Elsewhere in the tumour there is diffuse H3.3 p.Gly34Trp immunoreactivity (not shown).</p>",
    "source": "Akihiko Yoshida",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/161/6152.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/33/161/thumb_6152.jpg"
  },
  {
    "pkattachmentId": 34266,
    "bookid": 33,
    "chapterId": 161,
    "fileId": 6156,
    "type": "Figure",
    "diagnosis": "Giant cell tumour of bone",
    "title": "",
    "legend": "<p>Vascular invasion of a giant cell tumour of bone outside the main bulk of the tumour. This is of no prognostic significance.</p>",
    "source": "Akihiko Yoshida",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/161/6156.jpg",

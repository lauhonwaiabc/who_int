    "fileId": 6391,
    "type": "Figure",
    "diagnosis": "<p>Giant cell tumour of bone</p>",
    "title": "",
    "legend": "<p>Sagittal T2 MRI. The lesion shows marked hypointensity due to haemosiderin.</p>",
    "source": "Paul G. O'Donnell",
    "copyright": "",
    "tablehtml": "",

    "bookid": 33,
    "chapterId": 161,
    "fileId": 6160,
    "type": "Figure",
    "diagnosis": "<p>Giant cell tumour of bone</p>",
    "title": "",
    "legend": "<p>The spindle cells in this area of stromal overgrowth show diffuse H3.3 p.Gly34Trp immunoreactivity.</p>",
    "source": "Akihiko Yoshida",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/161/6160.jpg",

    "bookid": 33,
    "chapterId": 161,
    "fileId": 6393,
    "type": "Figure",
    "diagnosis": "<p>Giant cell tumour of bone</p>",
    "title": "",
    "legend": "<p>A 14-year-old&nbsp;girl with a lytic lesion in the distal radial metaphysis; note that the growth plate is open. A pathological fracture is present in the lateral cortex.</p>",
    "source": "Paul G. O'Donnell",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/161/6393.jpg",

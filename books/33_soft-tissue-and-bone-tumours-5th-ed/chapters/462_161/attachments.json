    "chapterId": 161,
    "fileId": 6159,
    "type": "Figure",
    "diagnosis": "Giant cell tumour of bone",
    "title": "",
    "legend": "<p>Stromal overgrowth in a giant cell tumour. There is a striking lack of osteoclast-like giant cells.</p>",
    "source": "Akihiko Yoshida",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/161/6159.jpg",

    "chapterId": 161,
    "fileId": 6161,
    "type": "Figure",
    "diagnosis": "Giant cell tumour of bone",
    "title": "",
    "legend": "<p>Necrosis. This is usually seen in the setting of pathological fracture.</p>",
    "source": "Akihiko Yoshida",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/161/6161.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/33/161/thumb_6161.jpg"
  },
  {
    "pkattachmentId": 34272,
    "bookid": 33,
    "chapterId": 161,
    "fileId": 6163,
    "type": "Figure",
    "diagnosis": "Giant cell tumour of bone",
    "title": "",
    "legend": "<p>The periphery of the tumour is sharply defined. The cortex is focally completely destroyed and partly surrounded by an eggshell-like rim of reactive bone.</p>",
    "source": "Akihiko Yoshida",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/161/6163.jpg",

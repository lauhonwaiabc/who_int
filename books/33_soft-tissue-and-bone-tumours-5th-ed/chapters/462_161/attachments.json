    "bookid": 33,
    "chapterId": 161,
    "fileId": 6383,
    "type": "Figure",
    "diagnosis": "<p>Giant cell tumour of bone</p>",
    "title": "",
    "legend": "<p>A non-mineralized, lytic lesion is seen in the left proximal tibia. No sclerosis is seen in the margin, and it extends to the articular surface. The cortex is markedly thinned inferomedially.</p>",
    "source": "Paul G. O'Donnell",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/161/6383.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/33/161/thumb_6383.jpg"
  },

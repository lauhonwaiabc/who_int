  },
  {
    "pkattachmentId": 34282,
    "bookid": 33,
    "chapterId": 161,
    "fileId": 6178,
    "type": "Figure",
    "diagnosis": "<p>Malignant giant cell tumour in proximal femur</p>",
    "title": "",
    "legend": "<p>A destructive tumour focally destroying the articular cartilage and the cortical bone and extending into soft tissue. The tumour is nodular, has a firm rubbery texture, and shows haemorrhage and necrosis.</p>",
    "source": "Frédérique Larousserie",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/161/6178.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/33/161/thumb_6178.jpg"
  },
  {
    "pkattachmentId": 34283,
    "bookid": 33,
    "chapterId": 161,
    "fileId": 6179,
    "type": "Figure",
    "diagnosis": "Pelvic giant cell tumour of bone treated with denosumab",
    "title": "",
    "legend": "<p>The tumour is composed of white nodules surrounded by pale-yellow fibrous-type tissue.</p>",
    "source": "Frédérique Larousserie",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/161/6179.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/33/161/thumb_6179.jpg"
  },
  {

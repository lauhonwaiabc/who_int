  {
    "pkattachmentId": 34651,
    "bookid": 33,
    "chapterId": 37,
    "fileId": 6792,
    "type": "Figure",
    "diagnosis": "<p>Schematic <em>NAB2</em>-<em>STAT6</em> gene fusion in solitary fibrous tumour</p>",
    "title": "",
    "legend": "<p>The <em>NAB2</em> and <em>STAT6</em> genes are adjacent genes on chromosome 12q13 that are transcribed in opposite directions. This intrachromosomal fusion results from a genomic inversion at the 12q13 locus, fusing <em>NAB2</em> and <em>STAT6</em> in a common direction of transcription. The fusion transcript illustrated includes <em>NAB2</em> exon&nbsp;6 fused to <em>STAT6</em> exon&nbsp;16.</p>",
    "source": "<p>Antonescu, Cristina</p>",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/37/6792.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/33/37/thumb_6792.jpg"

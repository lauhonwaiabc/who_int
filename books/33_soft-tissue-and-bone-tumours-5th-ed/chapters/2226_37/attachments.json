    "type": "Figure",
    "diagnosis": "<p>Giant cell&ndash;rich solitary fibrous tumour</p>",
    "title": "",
    "legend": "<p>This lesion shows scattered multinucleated giant cells lining cystic spaces.</p>",
    "source": "Elizabeth G. Demicco",
    "copyright": "",

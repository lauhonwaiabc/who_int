        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:46:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 410,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 243,
    "contributions": [
      {
        "pkcontributionId": 58742,
        "bookId": 33,
        "chapterId": 55,
        "headingId": 243,
        "headingText": "\r\n<p><em>Essential:</em> plexiform architecture; involvement of dermis and/or subcutaneous adipose tissue; nodules composed of histiocytoid epithelioid cells and osteoclast-like giant cells; fascicles of myofibroblastic spindle cells.</p>\r\n",
        "timestamp": "2019-12-11T11:46:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 408,
    "bookid": 33,

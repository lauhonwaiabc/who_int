    "contributions": [
      {
        "pkcontributionId": 58743,
        "bookId": 33,
        "chapterId": 55,
        "headingId": 241,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:46:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 409,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 242,
    "contributions": [
      {
        "pkcontributionId": 58744,
        "bookId": 33,
        "chapterId": 55,
        "headingId": 242,
        "headingText": "\r\n<p>Plexiform fibrohistiocytic tumour is associated with a risk for local recurrence ranging from 12.5% to 37.5% and rare lymph node metastasis {17870015; 2847569; 1723956; 10366148}. Distant metastasis to the lung is exceptional {9130995; 10366148}.</p>",
        "timestamp": "2019-12-11T11:46:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

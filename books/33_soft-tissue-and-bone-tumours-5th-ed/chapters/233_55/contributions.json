    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 228,
    "contributions": [
      {
        "pkcontributionId": 58728,
        "bookId": 33,
        "chapterId": 55,
        "headingId": 228,
        "headingText": "\r\n<p>Plexiform fibrohistiocytic tumour is a rare dermal and subcutaneous neoplasm showing plexiform architecture and biphasic morphology, composed of nodules of histiocytoid cells and bundles of myofibroblastic spindle cells.</p>\r\n",
        "timestamp": "2019-12-11T11:46:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

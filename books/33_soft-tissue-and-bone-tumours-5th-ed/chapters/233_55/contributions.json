        "chapterId": 55,
        "headingId": 232,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2019-12-11T11:46:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 400,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 233,
    "contributions": [
      {
        "pkcontributionId": 58733,
        "bookId": 33,
        "chapterId": 55,
        "headingId": 233,
        "headingText": "\r\n<p>There is a strong predilection for the upper limbs followed by the lower limbs. The trunk and the head and neck area are less often affected {17870015; 2847569; 1723956}.</p>\r\n",
        "timestamp": "2019-12-11T11:46:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 401,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 234,
    "contributions": [
      {
        "pkcontributionId": 58734,
        "bookId": 33,
        "chapterId": 55,
        "headingId": 234,
        "headingText": "\r\n<p>The tumours present as slow-growing, ill-defined plaques and nodules, typically measuring 1&ndash;3&nbsp;cm in diameter {2847569}.</p>\r\n",
        "timestamp": "2019-12-11T11:46:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 402,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 235,
    "contributions": [
      {
        "pkcontributionId": 58735,
        "bookId": 33,
        "chapterId": 55,
        "headingId": 235,
        "headingText": "\r\n<p>The age range is wide, but children and young adults are typically affected, with a median age of 14.5&ndash;20&nbsp;years and an equal sex distribution {17870015; 2847569; 1723956; 10366148}.</p>\r\n",
        "timestamp": "2019-12-11T11:46:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 403,
    "bookid": 33,

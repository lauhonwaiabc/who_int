        "chapterId": 33,
        "headingId": 229,
        "headingText": "<p>8826/0 Angiomyofibroblastoma</p>",
        "timestamp": "2020-01-31T09:24:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 397,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 230,
    "contributions": [
      {
        "pkcontributionId": 58339,
        "bookId": 33,
        "chapterId": 33,
        "headingId": 230,
        "headingText": "<p>EE6Y &amp; XH8A47 Other specified fibromatous disorders of skin and soft tissue &amp; Angiomyofibroblastoma</p>",
        "timestamp": "2020-01-23T16:17:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

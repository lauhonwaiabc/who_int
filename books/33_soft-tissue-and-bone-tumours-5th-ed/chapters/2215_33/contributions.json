        "headingId": 240,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:20:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 410,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 243,
    "contributions": [
      {
        "pkcontributionId": 58351,
        "bookId": 33,
        "chapterId": 33,
        "headingId": 243,
        "headingText": "\r\n<p><em>Essential:</em> well-circumscribed, prominent stromal vessels; round to spindle-shaped cells (often multinucleated) in a perivascular distribution.</p>\r\n<p><em>Desirable:</em> usually desmin-positive.</p>\r\n",
        "timestamp": "2019-12-11T11:20:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 408,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 241,
    "contributions": [
      {
        "pkcontributionId": 58352,
        "bookId": 33,
        "chapterId": 33,
        "headingId": 241,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:20:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 409,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 242,
    "contributions": [
      {
        "pkcontributionId": 58353,
        "bookId": 33,
        "chapterId": 33,
        "headingId": 242,
        "headingText": "\r\n<p>Angiomyofibroblastoma is benign and recurrence appears to be rare, even after marginal local excision.</p>",
        "timestamp": "2019-12-11T11:20:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

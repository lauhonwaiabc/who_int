      {
        "pkcontributionId": 58916,
        "bookId": 33,
        "chapterId": 210,
        "headingId": 229,
        "headingText": "\r\n<p>9135/1 Papillary intralymphatic angioendothelioma</p>\r\n",
        "timestamp": "2019-12-11T11:51:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 397,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 230,
    "contributions": [
      {
        "pkcontributionId": 58917,
        "bookId": 33,
        "chapterId": 210,
        "headingId": 230,
        "headingText": "<p>2F72.Y &amp; XH4SY7 Other specified neoplasms of uncertain behaviour of skin &amp; Endovascular papillary angioendothelioma</p>",
        "timestamp": "2020-01-23T17:03:54"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 398,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 231,
    "contributions": [
      {
        "pkcontributionId": 58918,
        "bookId": 33,
        "chapterId": 210,
        "headingId": 231,
        "headingText": "\r\n<p><em>Not recommended:</em> Dabska tumour; endovascular papillary angioendothelioma; hobnail haemangioendothelioma.</p>\r\n",
        "timestamp": "2019-12-11T11:51:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 399,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,

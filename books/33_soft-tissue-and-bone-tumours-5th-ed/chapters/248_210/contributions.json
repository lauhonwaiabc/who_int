        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:51:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 410,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 243,
    "contributions": [
      {
        "pkcontributionId": 58929,
        "bookId": 33,
        "chapterId": 210,
        "headingId": 243,
        "headingText": "\r\n<p><em>Essential:</em> extensive infiltration of lymphatic vessels with stromal and intraluminal lymphocytes and proteinaceous fluid; intralymphatic, intraluminal hobnail proliferation of polarized matchstick-like columnar endothelial cells; expression of pan-endothelial and lymphatic markers.</p>\r\n",
        "timestamp": "2019-12-11T11:51:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 408,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 241,
    "contributions": [
      {
        "pkcontributionId": 58930,
        "bookId": 33,
        "chapterId": 210,
        "headingId": 241,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:51:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 409,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 242,
    "contributions": [
      {
        "pkcontributionId": 58931,
        "bookId": 33,
        "chapterId": 210,
        "headingId": 242,
        "headingText": "\r\n<p>Most patients have excellent prognosis after complete excision {10478659}. Very rarely, lymph node metastases and death from disease occur {5343389}.</p>",
        "timestamp": "2019-12-11T11:51:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

[
  {
    "pkheadingid": 395,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 228,
    "contributions": [
      {
        "pkcontributionId": 58490,
        "bookId": 33,
        "chapterId": 42,
        "headingId": 228,
        "headingText": "\r\n<p>Giant cell fibroblastoma is a locally aggressive fibroblastic neoplasm, closely related to dermatofibrosarcoma protuberans (DFSP), arising primarily in children and characterized by the presence of multinucleated giant cells, pseudovascular spaces, and a <em>COL1A1</em>-<em>PDGFB</em> fusion.</p>\r\n",
        "timestamp": "2019-12-11T11:23:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 396,

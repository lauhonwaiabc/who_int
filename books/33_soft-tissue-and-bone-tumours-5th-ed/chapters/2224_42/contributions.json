        "chapterId": 42,
        "headingId": 229,
        "headingText": "<p>8834/1 Giant cell fibroblastoma</p>",
        "timestamp": "2020-01-31T09:26:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 397,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 230,
    "contributions": [
      {
        "pkcontributionId": 58492,
        "bookId": 33,
        "chapterId": 42,
        "headingId": 230,
        "headingText": "<p>FB51.Y &amp; XH9AV8 Other specified fibroblastic disorders &amp; Giant cell fibroblastoma</p>",
        "timestamp": "2020-01-23T16:22:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 398,

[
  {
    "pkheadingid": 395,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 228,
    "contributions": [
      {
        "pkcontributionId": 58269,
        "bookId": 33,
        "chapterId": 28,
        "headingId": 228,
        "headingText": "\r\n<p>Desmoplastic fibroblastoma is a benign, paucicellular, soft tissue tumour with abundant collagenous or myxocollagenous matrix; low vascularity; and scattered, bland, stellate-shaped and spindled fibroblastic cells.</p>\r\n",
        "timestamp": "2019-12-11T11:17:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 396,
    "bookid": 33,

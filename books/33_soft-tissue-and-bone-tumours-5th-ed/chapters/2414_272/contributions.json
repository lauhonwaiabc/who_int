[
  {
    "pkheadingid": 395,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 228,
    "contributions": [
      {
        "pkcontributionId": 58813,
        "bookId": 33,
        "chapterId": 272,
        "headingId": 228,
        "headingText": "\r\n<p>Venous haemangioma is composed of veins of variable size, often having thick muscular walls. Intramuscular angiomas and angiomatosis, which are described separately, can be composed almost exclusively of veins but are usually intermixed with other vessel types.</p>\r\n",
        "timestamp": "2019-12-11T11:48:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 396,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,

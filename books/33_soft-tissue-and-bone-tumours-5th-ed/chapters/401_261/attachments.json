    "legend": "",
    "source": "authors of chapter",
    "copyright": "",
    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 597.85pt; border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 168.1pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"224\">\r\n<p class=\"TableText\"><strong>Grade</strong></p>\r\n</td>\r\n<td style=\"width: 429.75pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"573\">\r\n<p class=\"TableText\"><strong>Sarcoma type</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 168.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"224\">\r\n<p class=\"TableText\"><strong>Grade&nbsp;1 (low-grade)</strong></p>\r\n</td>\r\n<td style=\"width: 429.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"573\">\r\n<p class=\"TableText\">Low-grade central osteosarcoma</p>\r\n<p class=\"TableText\">Parosteal osteosarcoma</p>\r\n<p class=\"TableText\">Clear cell chondrosarcoma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 168.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"224\">\r\n<p class=\"TableText\"><strong>Grade&nbsp;2 (intermediate-grade)</strong></p>\r\n</td>\r\n<td style=\"width: 429.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"573\">\r\n<p class=\"TableText\">Periosteal osteosarcoma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 168.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"224\">\r\n<p class=\"TableText\"><strong>Grade&nbsp;3 (high-grade)</strong></p>\r\n</td>\r\n<td style=\"width: 429.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"573\">\r\n<p class=\"TableText\">Osteosarcoma (conventional, telangiectatic, small cell, secondary, high-grade surface)</p>\r\n<p class=\"TableText\">Undifferentiated high-grade pleomorphic sarcoma</p>\r\n<p class=\"TableText\">Ewing sarcoma</p>\r\n<p class=\"TableText\">Dedifferentiated chondrosarcoma</p>\r\n<p class=\"TableText\">Mesenchymal chondrosarcoma</p>\r\n<p class=\"TableText\">Dedifferentiated chordoma</p>\r\n<p class=\"TableText\">Poorly differentiated chordoma</p>\r\n<p class=\"TableText\">Angiosarcoma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 168.1pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"224\">\r\n<p class=\"TableText\"><strong>Variable grading</strong></p>\r\n</td>\r\n<td style=\"width: 429.75pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"573\">\r\n<p class=\"TableText\">Conventional chondrosarcoma (grade&nbsp;1&ndash;3 according to Evans et al. <span class=\"Ref-PMID\">{890662}</span>)</p>\r\n<p class=\"TableText\">Leiomyosarcoma of bone (grade&nbsp;1&ndash;3, no established grading system)</p>\r\n<p class=\"TableText\">Low- and high-grade malignancy may occur in giant cell tumour of bone</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

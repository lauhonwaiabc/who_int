    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 703.3pt; border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 100.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"134\">\r\n<p class=\"TableText\"><strong>Diagnosis</strong></p>\r\n</td>\r\n<td style=\"width: 86.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Knee<sup>a</sup></strong></p>\r\n</td>\r\n<td style=\"width: 86.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Hip and pelvis<sup>b</sup></strong></p>\r\n</td>\r\n<td style=\"width: 86.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Shoulder girdle<sup>c</sup></strong></p>\r\n</td>\r\n<td style=\"width: 86.2pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Lower leg</strong></p>\r\n</td>\r\n<td style=\"width: 86.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Upper limb</strong></p>\r\n</td>\r\n<td style=\"width: 86.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Trunk<sup>d</sup></strong></p>\r\n</td>\r\n<td style=\"width: 86.2pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Risk of pathological fracture</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 100.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"134\">\r\n<p class=\"TableText\"><strong>Osteosarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 86.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">66%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">15%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">10%</p>\r\n</td>\r\n<td style=\"width: 86.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">5%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">3%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">1%</p>\r\n</td>\r\n<td style=\"width: 86.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">9%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 100.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"134\">\r\n<p class=\"TableText\"><strong>Chondrosarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 86.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">17%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">48%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">15%</p>\r\n</td>\r\n<td style=\"width: 86.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">4%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">9%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">7%</p>\r\n</td>\r\n<td style=\"width: 86.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">12%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 100.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"134\">\r\n<p class=\"TableText\"><strong>Ewing sarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 86.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">22%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">44%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">11%</p>\r\n</td>\r\n<td style=\"width: 86.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">13%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">7%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">3%</p>\r\n</td>\r\n<td style=\"width: 86.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">6%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 100.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"134\">\r\n<p class=\"TableText\"><strong>UPS</strong></p>\r\n</td>\r\n<td style=\"width: 86.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">41%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">29%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">9%</p>\r\n</td>\r\n<td style=\"width: 86.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">5%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">14%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">2%</p>\r\n</td>\r\n<td style=\"width: 86.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">16%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 100.15pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"134\">\r\n<p class=\"TableText\"><strong>All diagnoses</strong></p>\r\n</td>\r\n<td style=\"width: 86.15pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">43%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">31%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">11%</p>\r\n</td>\r\n<td style=\"width: 86.2pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">7%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">5%</p>\r\n</td>\r\n<td style=\"width: 86.15pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">3%</p>\r\n</td>\r\n<td style=\"width: 86.2pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">10%</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</tabl
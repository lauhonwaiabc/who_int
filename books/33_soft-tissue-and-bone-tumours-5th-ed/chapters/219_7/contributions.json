        "bookId": 33,
        "chapterId": 7,
        "headingId": 230,
        "headingText": "\r\n<p>2E80.0Z &amp; XH1054 Lipoma, unspecified &amp; Hibernoma</p>\r\n",
        "timestamp": "2019-12-11T11:08:09"
      }
    ],
    "booknotes": [],

        "pkcontributionId": 57980,
        "bookId": 33,
        "chapterId": 7,
        "headingId": 228,
        "headingText": "\r\n<p>Hibernoma is a rare, benign adipocytic tumour showing brown fat differentiation.</p>\r\n",
        "timestamp": "2019-12-11T11:08:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

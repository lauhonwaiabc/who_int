  {
    "pkattachmentId": 34066,
    "bookid": 33,
    "chapterId": 125,
    "fileId": 5820,
    "type": "Figure",
    "diagnosis": "Extraskeletal myxoid chondrosarcoma",
    "title": "",
    "legend": "The cellular subtype of extraskeletal myxoid chondrosarcoma is characterized by sheets and cords of cells with little intervening myxoid matrix. The cells frequently have an epithelioid morphology and large vesicular nuclei, prominent nucleoli, and brisk mitotic activity.",
    "source": "Andrew E. Horvai",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/125/5820.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/33/125/thumb_5820.jpg"
  },
  {

    "fileId": 5817,
    "type": "Figure",
    "diagnosis": "Extraskeletal myxoid chondrosarcoma",
    "title": "",
    "legend": "The tumour is characterized by abundant myxoid matrix and interconnecting cords of uniform cells, often with long, delicate processes.",
    "source": "Andrew E. Horvai",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/125/5817.jpg",

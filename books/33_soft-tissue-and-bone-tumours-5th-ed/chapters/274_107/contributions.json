        "chapterId": 107,
        "headingId": 231,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2019-12-11T11:56:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 399,
    "bookid": 33,

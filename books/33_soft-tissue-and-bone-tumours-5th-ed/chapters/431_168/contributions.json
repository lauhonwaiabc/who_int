[
  {
    "pkheadingid": 395,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 228,
    "contributions": [
      {
        "pkcontributionId": 60344,
        "bookId": 33,
        "chapterId": 168,
        "headingId": 228,
        "headingText": "\r\n<p>Desmoplastic fibroma of bone is an extremely rare locally aggressive bone tumour composed of bland spindle cells set in abundant collagen, with histology reminiscent of desmoid-type fibromatosis.</p>\r\n",
        "timestamp": "2019-11-26T16:12:36"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 396,
    "bookid": 33,
    "headingType": 2,

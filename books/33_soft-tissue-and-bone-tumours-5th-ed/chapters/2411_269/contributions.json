        "bookId": 33,
        "chapterId": 269,
        "headingId": 241,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:47:57"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 409,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 242,
    "contributions": [
      {
        "pkcontributionId": 58778,
        "bookId": 33,
        "chapterId": 269,
        "headingId": 242,
        "headingText": "\r\n<p>Small lesions are usually easy to remove completely by synovectomy with no risk of local recurrence {30980138}. When more-diffuse involvement of the joint is present, complete excision can be difficult to achieve and may predispose to recurrence.</p>",
        "timestamp": "2019-12-11T11:47:57"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
        "bookId": 33,
        "chapterId": 269,
        "headingId": 240,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:47:57"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 410,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 243,
    "contributions": [
      {
        "pkcontributionId": 58776,
        "bookId": 33,
        "chapterId": 269,
        "headingId": 243,
        "headingText": "\r\n<p><em>Essential:</em> a tumour composed of numerous congested, variably dilated vessels of different calibre; origin from a synovium-lined space.</p>\r\n",
        "timestamp": "2019-12-11T11:47:57"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 408,

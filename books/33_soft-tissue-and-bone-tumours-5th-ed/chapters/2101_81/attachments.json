  {
    "pkattachmentId": 33952,
    "bookid": 33,
    "chapterId": 81,
    "fileId": 5644,
    "type": "Figure",
    "diagnosis": "Ancient schwannoma",
    "title": "",
    "legend": "Despite the nuclear atypia, the Ki-67 proliferation index is low, with the majority of bizarre nuclei being negative.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/81/5644.jpg",

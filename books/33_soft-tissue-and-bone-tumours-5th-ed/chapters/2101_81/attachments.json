    "fileId": 5642,
    "type": "Figure",
    "diagnosis": "Ancient schwannoma",
    "title": "",
    "legend": "The presence of scattered bizarre or atypical nuclei is often considered a degenerative phenomenon, which does not impact the prognosis.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/81/5642.jpg",

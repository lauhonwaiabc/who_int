    "chapterId": 81,
    "fileId": 5648,
    "type": "Figure",
    "diagnosis": "<p>Cellular schwannoma</p>",
    "title": "",
    "legend": "<p>Mitotic figures are common, but the mitotic count is &lt;&nbsp;5&nbsp;mitoses/mm<sup>2</sup> in most examples.</p>",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/81/5648.jpg",

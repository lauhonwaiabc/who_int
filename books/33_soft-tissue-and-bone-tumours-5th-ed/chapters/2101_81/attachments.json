    "chapterId": 81,
    "fileId": 5645,
    "type": "Figure",
    "diagnosis": "Cellular schwannoma",
    "title": "",
    "legend": "The marked hypercellularity and compact arrangement may be alarming, warranting consideration of a sarcoma in the differential diagnosis.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/81/5645.jpg",

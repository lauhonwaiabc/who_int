    "chapterId": 81,
    "fileId": 5649,
    "type": "Figure",
    "diagnosis": "Cellular schwannoma",
    "title": "",
    "legend": "Diffuse S100 positivity is typical and helps distinguish this schwannoma subtype from malignant peripheral nerve sheath tumour.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/33/81/5649.jpg",

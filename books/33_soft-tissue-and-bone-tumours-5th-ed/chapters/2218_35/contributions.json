  },
  {
    "pkheadingid": 410,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 243,
    "contributions": [
      {
        "pkcontributionId": 58402,
        "bookId": 33,
        "chapterId": 35,
        "headingId": 243,
        "headingText": "\r\n<p><em>Essential:</em> paucicellular collagenous lesion usually with small nerve bundles; typically arising in the neck; bland CD34-positive spindle cells.</p>\r\n",
        "timestamp": "2019-12-11T11:21:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 408,

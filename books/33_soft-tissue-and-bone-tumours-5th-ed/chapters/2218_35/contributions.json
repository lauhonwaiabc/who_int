    "headingid": 241,
    "contributions": [
      {
        "pkcontributionId": 58403,
        "bookId": 33,
        "chapterId": 35,
        "headingId": 241,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:21:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 409,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 242,
    "contributions": [
      {
        "pkcontributionId": 58404,
        "bookId": 33,
        "chapterId": 35,
        "headingId": 242,
        "headingText": "\r\n<p>Nuchal-type fibroma is benign. It often locally recurs but it does not metastasize.</p>",
        "timestamp": "2019-12-11T11:21:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

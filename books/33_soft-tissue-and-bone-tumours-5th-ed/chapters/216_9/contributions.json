        "chapterId": 9,
        "headingId": 241,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:06:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 409,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 242,
    "contributions": [
      {
        "pkcontributionId": 57945,
        "bookId": 33,
        "chapterId": 9,
        "headingId": 242,
        "headingText": "\r\n<p>Complete resection is curative.</p>",
        "timestamp": "2019-12-11T11:06:31"

        "headingId": 240,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:06:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 410,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 243,
    "contributions": [
      {
        "pkcontributionId": 57943,
        "bookId": 33,
        "chapterId": 9,
        "headingId": 243,
        "headingText": "\r\n<p><em>Essential:</em> extrauterine location; admixture of well-differentiated, cytologically bland smooth muscle and mature fat.</p>\r\n",
        "timestamp": "2019-12-11T11:06:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 408,
    "bookid": 33,
    "headingType": 2,

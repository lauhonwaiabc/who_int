[
  {
    "pkheadingid": 395,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 228,
    "contributions": [
      {
        "pkcontributionId": 57946,
        "bookId": 33,
        "chapterId": 6,
        "headingId": 228,
        "headingText": "\r\n<p>Chondroid lipoma is a benign adipose tissue tumour composed of lipoblasts that intermingle with mature adipocytes in a myxohyaline chondroid matrix.</p>\r\n",
        "timestamp": "2019-12-11T11:06:51"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 396,
    "bookid": 33,
    "headingType": 2,

        "bookId": 33,
        "chapterId": 6,
        "headingId": 229,
        "headingText": "\r\n<p>8862/0 Chondroid lipoma</p>\r\n",
        "timestamp": "2019-12-11T11:06:51"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 397,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 230,
    "contributions": [
      {
        "pkcontributionId": 57948,
        "bookId": 33,
        "chapterId": 6,
        "headingId": 230,
        "headingText": "\r\n<p>2E80.0Z &amp; XH7WX8 Lipoma, unspecified &amp; Chondroid lipoma</p>\r\n",
        "timestamp": "2019-12-11T11:06:51"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 398,
    "bookid": 33,
    "headingType": 2,

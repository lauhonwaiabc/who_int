    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 230,
    "contributions": [
      {
        "pkcontributionId": 60533,
        "bookId": 33,
        "chapterId": 257,
        "headingId": 230,
        "headingText": "<p>2B5Z &amp; XH7303 Malignant mesenchymal neoplasm of unspecified type &amp; Dedifferentiated chordoma</p>",
        "timestamp": "2020-01-23T17:28:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 398,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 231,

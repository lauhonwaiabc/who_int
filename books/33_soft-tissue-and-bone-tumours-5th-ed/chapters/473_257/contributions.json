[
  {
    "pkheadingid": 395,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 228,
    "contributions": [
      {
        "pkcontributionId": 60531,
        "bookId": 33,
        "chapterId": 257,
        "headingId": 228,
        "headingText": "\r\n<p>Dedifferentiated chordoma is a chordoma with a biphasic appearance, characterized by conventional chordoma and high-grade sarcoma.</p>\r\n",
        "timestamp": "2019-11-26T16:19:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 396,
    "bookid": 33,
    "headingType": 2,

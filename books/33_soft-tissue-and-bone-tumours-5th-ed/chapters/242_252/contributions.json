        "pkcontributionId": 58843,
        "bookId": 33,
        "chapterId": 252,
        "headingId": 240,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:49:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 410,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 243,
    "contributions": [
      {
        "pkcontributionId": 58844,
        "bookId": 33,
        "chapterId": 252,
        "headingId": 243,
        "headingText": "\r\n<p><em>Essential:</em> anastomosing vessels lined by hobnail endothelial cells.</p>\r\n<p><em>Desirable:</em> hyaline globules and extramedullary haematopoiesis are common.</p>\r\n",
        "timestamp": "2019-12-11T11:49:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 408,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 241,
    "contributions": [
      {
        "pkcontributionId": 58845,
        "bookId": 33,
        "chapterId": 252,
        "headingId": 241,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-12-11T11:49:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 409,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 242,
    "contributions": [
      {
        "pkcontributionId": 58846,
        "bookId": 33,
        "chapterId": 252,
        "headingId": 242,
        "headingText": "\r\n<p>Anastomosing haemangiomas, even when multicentric or infiltrative, are benign.</p>",
        "timestamp": "2019-12-11T11:49:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

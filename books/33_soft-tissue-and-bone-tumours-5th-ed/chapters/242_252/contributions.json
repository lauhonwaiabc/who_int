[
  {
    "pkheadingid": 395,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 228,
    "contributions": [
      {
        "pkcontributionId": 58830,
        "bookId": 33,
        "chapterId": 252,
        "headingId": 228,
        "headingText": "\r\n<p>Anastomosing haemangioma is a benign vascular neoplasm that is poorly marginated and consists of thin-walled anastomosing vessels lined by a monolayer of endothelial cells with somewhat protuberant nuclei.</p>\r\n",
        "timestamp": "2019-12-11T11:49:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

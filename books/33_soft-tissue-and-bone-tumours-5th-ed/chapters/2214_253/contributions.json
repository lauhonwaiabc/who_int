[
  {
    "pkheadingid": 395,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 228,
    "contributions": [
      {
        "pkcontributionId": 58320,
        "bookId": 33,
        "chapterId": 253,
        "headingId": 228,
        "headingText": "\r\n<p><em>EWSR1</em>-<em>SMAD3</em>&ndash;positive fibroblastic tumour is a benign neoplasm with a strong predilection for the hands and feet. Tumour nomenclature is provisional.</p>\r\n",
        "timestamp": "2019-12-11T11:19:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 396,
    "bookid": 33,
    "headingType": 2,

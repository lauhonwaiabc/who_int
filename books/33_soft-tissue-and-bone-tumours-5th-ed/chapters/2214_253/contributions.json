        "bookId": 33,
        "chapterId": 253,
        "headingId": 229,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2019-12-11T11:19:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 397,
    "bookid": 33,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 230,
    "contributions": [
      {
        "pkcontributionId": 58322,
        "bookId": 33,
        "chapterId": 253,
        "headingId": 230,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2019-12-11T11:19:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 398,

[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 113244,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 576,
        "headingText": "\r\n<p>Nodular oncocytic hyperplasia (NOH) is a non-neoplastic salivary gland lesion characterized by unencapsulated nodular proliferations of epithelial oncocytes and/or clear cells.</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 577,
    "contributions": [
      {
        "pkcontributionId": 113245,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 577,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {
        "pkcontributionId": 113246,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 578,
        "headingText": "\r\n<p>DA04.1 Hypertrophy of salivary gland</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 579,
    "contributions": [
      {
        "pkcontributionId": 113247,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 579,
        "headingText": "\r\n<p><em>Acceptable:</em> multifocal nodular oncocytic hyperplasia; nodular oncocytosis; clear cell oncocytosis.</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 750,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 580,
    "contributions": [
      {
        "pkcontributionId": 113248,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 580,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 751,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 581,
    "contributions": [
      {
        "pkcontributionId": 113249,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 581,
        "headingText": "\r\n<p>NOH is almost exclusively found in the parotid gland; it is rarely seen in the submandibular gland {2361662; 28411376; 28247227}.</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 752,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 582,
    "contributions": [
      {
        "pkcontributionId": 113250,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 582,
        "headingText": "\r\n<p>Patients with NOH present with a palpable painless mass, often present for years {2361662; 28411376}.</p>\r\n<h5>Imaging</h5>\r\n<p>Imaging studies show a loss of normal architecture, usually with multiple nodules of various sizes, but this is not diagnostic {18272563}.</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 753,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 583,
    "contributions": [
      {
        "pkcontributionId": 113251,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 583,
        "headingText": "\r\n<p>NOH constitutes &lt;&nbsp;1% of salivary tumours but accounts for approximately 7% of bilateral salivary lesions {17718138; 21689893}. The peak incidence is in the fifth and sixth decades of life, and there is a slight female predilection {28247227}.</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 754,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 584,
    "contributions": [
      {
        "pkcontributionId": 113252,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 584,
        "headingText": "\r\n<p>Although the inciting factor is unknown, the oncocytic phenotype is associated with an accumulation of aberrant mitochondria and mitochondrial DNA mutations {20732299; 24614700}.</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 755,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 585,
    "contributions": [
      {
        "pkcontributionId": 113253,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 585,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 762,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 592,
    "contributions": [
      {
        "pkcontributionId": 113254,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 592,
        "headingText": "\r\n<p>NOH displays multiple brown well-circumscribed but unencapsulated nodules. A partly encapsulated larger mass may indicate an oncocytoma arising in NOH {18357950}.</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 756,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 586,
    "contributions": [
      {
        "pkcontributionId": 113255,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 586,
        "headingText": "\r\n<p>NOH consists of irregularly shaped unencapsulated nodules of oncocytes in solid to tubulotrabecular patterns distributed throughout the salivary parenchyma {2361662; 17718138; 21689893}. Lobular architecture is preserved. Clear cell change is frequent and can form small satellite foci that mimic invasive clear cell tumours. Unifocality and encapsulation can separate NOH from oncocytoma. Entrapped normal acini, ducts, and adipocytes within nodules and non-perivascular p63-positive basal cells distinguish NOH from acinic cell carcinoma or metastatic renal cell carcinoma {19646823; 20614263}.</p>\r\n<h5>Differential diagnosis</h5>\r\n<p>Absence of <em>MAML2</em> rearrangement can rule out oncocytic mucoepidermoid carcinoma {33002921}. Negativity for SOX10, S100, and <em>PLAG1</em> rearrangement helps distinguish NOH from pleomorphic adenoma and myoepithelioma with oncocytic metaplasia {32673681}.</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 757,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 587,
    "contributions": [
      {
        "pkcontributionId": 113256,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 587,
        "headingText": "\r\n<p>Smears are hypocellular, with small to medium-sized tissue fragments of oncocytic cells with well-defined cytoplasmic margins and coarsely granular dense cytoplasm, present in a clean background. These features overlap with those of oncocytoma (which cannot be distinguished from NOH) and those of the oncocytic cells seen in Warthin tumour, although that has lymphoid cells in a dense, proteinaceous, granular background {28411376}.</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 758,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 588,
    "contributions": [
      {
        "pkcontributionId": 113257,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 588,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 113258,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 591,
        "headingText": "<p><em>Essential:</em> circumscribed but unencapsulated nodules of oncocytic and/or clear cells.</p>\r\n<p><em>Desirable:</em> multifocality.</p>",
        "timestamp": "2023-10-18T12:16:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 759,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 589,
    "contributions": [
      {
        "pkcontributionId": 113259,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 589,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 113260,
        "bookId": 52,
        "chapterId": 56,
        "headingId": 590,
        "headingText": "\r\n<p>NOH is a non-neoplastic lesion and recurrence is rare, although it is frequently multifocal and bilateral. Clear cell change may indicate an increased risk of recurrence {2031528}. Malignant transformation has not been reported.</p>",
        "timestamp": "2023-09-26T09:53:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
        "headingId": 589,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-09-28T10:18:54"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 114351,
        "bookId": 52,
        "chapterId": 131,
        "headingId": 590,
        "headingText": "\r\n<p>Recurrence is rare (&lt;&nbsp;5%) after enucleation {21062939}.</p>",
        "timestamp": "2023-09-28T10:18:54"
      }
    ],

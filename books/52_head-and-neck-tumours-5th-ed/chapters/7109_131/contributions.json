        "timestamp": "2023-09-28T10:18:54"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 114349,
        "bookId": 52,
        "chapterId": 131,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> site in a tooth-bearing area of the jaw; thin, regular epithelial lining with orthokeratinization.</p>\r\n<p><em>Desirable:</em> prominent granular cell layer; flat basal cells.</p>\r\n",
        "timestamp": "2023-09-28T10:18:54"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

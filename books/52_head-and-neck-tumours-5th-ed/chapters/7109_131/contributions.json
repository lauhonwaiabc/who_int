[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 114335,
        "bookId": 52,
        "chapterId": 131,
        "headingId": 576,
        "headingText": "\r\n<p>Orthokeratinized odontogenic cyst (OOC) is a developmental cyst lined by orthokeratinized stratified squamous epithelium.</p>\r\n",
        "timestamp": "2023-09-28T10:18:54"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,

[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 115066,
        "bookId": 52,
        "chapterId": 171,
        "headingId": 576,
        "headingText": "<p>Chondromyxoid fibroma (CMF) is a benign lobulated cartilaginous neoplasm with a zonal architecture composed of chondroid, myxoid, and myofibroblastic areas.</p>",
        "timestamp": "2023-11-13T09:13:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

        "bookId": 52,
        "chapterId": 171,
        "headingId": 577,
        "headingText": "\r\n<p>9241/0 Chondromyxoid fibroma</p>\r\n",
        "timestamp": "2023-09-28T12:36:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {
        "pkcontributionId": 115068,
        "bookId": 52,
        "chapterId": 171,
        "headingId": 578,
        "headingText": "\r\n<p>2E82.Z &amp; XH89S0 Benign osteogenic tumour of unspecified site &amp; Chondromyxoid fibroma</p>\r\n",
        "timestamp": "2023-09-28T12:36:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,

    "fileId": 27702,
    "type": "Figure",
    "diagnosis": "Oral epithelial dysplasia, severe",
    "title": "",
    "legend": "Loss of basal cell polarity, epithelial differentiation, increased mitotic figures, and abnormal variation in nuclear and cellular features extending throughout the full epithelial thickness.",
    "source": "Susan Muller",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/52/106/27702.jpg",

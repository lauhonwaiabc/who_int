  {
    "pkattachmentId": 58340,
    "bookid": 52,
    "chapterId": 83,
    "fileId": 25640,
    "type": "WSI",
    "diagnosis": "Intraductal carcinoma, mixed intercalated duct type",
    "title": "",
    "legend": "This tumour is partially cystic, with solid and cribriform lobules in the cyst wall. There are degenerative changes in the form of fibrosis and haemorrhage. The ductal cells resemble intercalated ducts, with modest amounts of amphophilic cytoplasm and small, round oval nuclei with indistinct nucleoli. Atypia and mitotic activity are minimal. Each nest and cyst is surrounded by an intact layer of flattened myoepithelial cells with clear cytoplasm. These cells are subtle on H&amp;E, and easier to visualize with immunohistochemistry (e.g. p40 or SMA). This case harboured <em>NCOA4</em>::<em>RET</em>, which is the most common molecular alteration in this intraductal carcinoma type.",
    "source": "Justin A. Bishop",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/25640.dzi",
    "thumbnail": null
  }
]
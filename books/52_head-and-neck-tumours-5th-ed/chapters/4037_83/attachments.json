    "title": "<p>Subtypes of intraductal carcinoma</p>",
    "legend": "",
    "source": "Justin A. Bishop",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 697.4pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"930\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 100.05pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\"><strong>Subtype</strong></p>\r\n</td>\r\n<td style=\"width: 100.05pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Grade</strong></p>\r\n</td>\r\n<td style=\"width: 100.05pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>S100 and SOX10</strong></p>\r\n</td>\r\n<td style=\"width: 100.1pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>AR</strong></p>\r\n</td>\r\n<td style=\"width: 194.15pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"259\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Genetics</strong></p>\r\n</td>\r\n<td style=\"width: 103.0pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"137\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Associated invasion</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 100.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\"><strong>Intercalated duct</strong></p>\r\n</td>\r\n<td style=\"width: 100.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Low</p>\r\n</td>\r\n<td style=\"width: 100.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">++</p>\r\n</td>\r\n<td style=\"width: 100.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&ndash;</p>\r\n</td>\r\n<td style=\"width: 194.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"259\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Usually <em>NCOA4</em>::<em>RET</em></p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Rarely <em>STRN</em>::<em>ALK</em>, <em>TUT1</em>::<em>ETV5</em>, <em>KIAA1217</em>::<em>RET</em></p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Occasionally fusion-negative</p>\r\n</td>\r\n<td style=\"width: 103.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"137\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Rare</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 100.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\"><strong>Apocrine</strong></p>\r\n</td>\r\n<td style=\"width: 100.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Low or high</p>\r\n</td>\r\n<td style=\"width: 100.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&ndash;</p>\r\n</td>\r\n<td style=\"width: 100.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">++</p>\r\n</td>\r\n<td style=\"width: 194.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"259\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Complex, with multiple mutations (<em>HRAS</em>, <em>PIK3CA</em>, others)</p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">No fusions</p>\r\n</td>\r\n<td style=\"width: 103.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"137\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Common</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 100.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\"><strong>Oncocytic</strong></p>\r\n</td>\r\n<td style=\"width: 100.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Low</p>\r\n</td>\r\n<td style=\"width: 100.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">++</p>\r\n</td>\r\n<td style=\"width: 100.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&ndash;</p>\r\n</td>\r\n<td style=\"width: 194.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"259\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><em>TRIM33</em>::<em>RET</em></p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><em>BRAF</em> p.V600E mutation</p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Occasionally <em>NCOA4</em>::<em>RET</em> or fusion/mutation-negative</p>\r\n</td>\r\n<td style=\"width: 103.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"137\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Unknown</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 100.05pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\"><strong>Mixed</strong></p>\r\n</td>\r\n<td style=\"width: 100.05pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Low or high</p>\r\n</td>\r\n<td style=\"width: 100.05pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">++ in intercalated duct and oncocytic areas</p>\r\n</td>\r\n<td style=\"width: 100.1pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"133\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">++ in apocrine areas</p>\r\n</td>\r\n<td style=\"width: 194.15pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"259\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Usually <em>TRIM27</em>::<em>RET</em></p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Occasionally <em>NCOA4</em>::<em>RET</em></p>\r\n</td>\r\n<td style=\"width: 103.0pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"137\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Rare</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

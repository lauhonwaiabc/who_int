  },
  {
    "pkattachmentId": 56628,
    "bookid": 52,
    "chapterId": 24,
    "fileId": 23040,
    "type": "Figure",
    "diagnosis": "Meningioma of the ear",
    "title": "",
    "legend": "It is common to see meningioma within the interstices of bone. The tumour frequently grows through the bone from an intracranial primary to present either in the ear or in the sinonasal tract.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/52/24/23040.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/52/24/thumb_23040.jpg"
  },
  {
    "pkattachmentId": 56629,
    "bookid": 52,
    "chapterId": 24,
    "fileId": 23041,
    "type": "Figure",
    "diagnosis": "Meningioma of the sinonasal tract",
    "title": "",
    "legend": "The meningothelial pattern, composed of slightly spindled cells, is seen in this meningothelial meningioma.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/52/24/23041.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/52/24/thumb_23041.jpg"
  },
  {
    "pkattachmentId": 56630,
    "bookid": 52,
    "chapterId": 24,
    "fileId": 23042,
    "type": "Figure",
    "diagnosis": "Meningioma of the sinonasal tract",
    "title": "",
    "legend": "An intact respiratory epithelium is noted above a stromal proliferation of meningothelial cells. Note the small psammoma bodies and well-developed intranuclear cytoplasmic inclusions.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/52/24/23042.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/52/24/thumb_23042.jpg"
  },
  {
    "pkattachmentId": 56631,
    "bookid": 52,
    "chapterId": 24,
    "fileId": 23043,
    "type": "Figure",
    "diagnosis": "Meningioma of the sinonasal tract",
    "title": "",
    "legend": "The meningothelial proliferation is intimately associated with the surface squamous epithelium and the adjacent minor mucoserous glands. This finding sometimes mimics squamous cell carcinoma. However, the numerous intranuclear cytoplasmic inclusions help with interpretation.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/52/24/23043.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/52/24/thumb_23043.jpg"
  },
  {
    "pkattachmentId": 56632,
    "bookid": 52,
    "chapterId": 24,
    "fileId": 23045,
    "type": "Figure",
    "diagnosis": "Meningioma",
    "title": "",
    "legend": "Meningioma of the sinonasal tract. Slight nuclear atypia may be seen in meningothelial meningioma. Intranuclear cytoplasmic inclusions are prominent in this field.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/52/24/23045.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/52/24/thumb_23045.jpg"
  },
  {

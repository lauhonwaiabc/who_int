[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 113601,
        "bookId": 52,
        "chapterId": 91,
        "headingId": 576,
        "headingText": "\r\n<p>Microsecretory adenocarcinoma (MSA) is a low-grade malignancy with an intercalated duct-like phenotype and <em>MEF2C</em>::<em>SS18</em> fusion.</p>\r\n",
        "timestamp": "2023-09-26T13:28:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-09-28T12:37:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 115099,
        "bookId": 52,
        "chapterId": 174,
        "headingId": 590,
        "headingText": "<p >DFB frequently recurs after curettage (31%) or enucleation (25%) {16360612; 25113037; 27816276; 32215029; 33204607}. The recurrence rate after resection is approximately 10%.</p>",
        "timestamp": "2024-01-10T12:48:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
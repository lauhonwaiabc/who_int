  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 115097,
        "bookId": 52,
        "chapterId": 174,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> intraosseous site; benign spindle cell lesion; no cytological atypia or pleomorphism; dense collagenous background; exclusion of alternative fibrous tumours.</p>\r\n",
        "timestamp": "2023-09-28T12:37:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 759,

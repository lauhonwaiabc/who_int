    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 390.25pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"520\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 192.85pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"257\">\r\n<p class=\"TableText\"><strong>Geographical area</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\"><strong>Prevalence % (95%&nbsp;CI)</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 192.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"257\">\r\n<p class=\"TableText\"><strong>Asia</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\">10.5 (4.6&ndash;18.6)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 192.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"257\">\r\n<p class=\"TableText\"><strong>Europe</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\">3.1 (1.6&ndash;4.9)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 192.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"257\">\r\n<p class=\"TableText\"><strong>Middle East</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\">3.7 (2.9&ndash;4.7)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 192.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"257\">\r\n<p class=\"TableText\"><strong>South America and the Caribbean</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\">3.9 (2.4&ndash;5.8)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 192.85pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"257\">\r\n<p class=\"TableText\"><strong>North America</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\">0.1 (0.004&ndash;0.4)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 192.85pt; border: none; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"257\">\r\n<p class=\"TableText\"><strong>Clinical presentation</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; border: none; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\"><strong>Overall prevalence % (95%&nbsp;CI)</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 192.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"257\">\r\n<p class=\"TableText\"><strong>Leukoplakia</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\">4.1 (2&ndash;7)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 1.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 164.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"219\">\r\n<p class=\"TableText\"><strong>Homogeneous</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\">2.0 (0.4&ndash;4.6)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 164.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"219\">\r\n<p class=\"TableText\"><strong>Non-homogeneous</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\">0.2 (0.1&ndash;0.3)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 192.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"257\">\r\n<p class=\"TableText\"><strong>Erythroplakia</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\">0.2 (0.1&ndash;0.3)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 192.85pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"257\">\r\n<p class=\"TableText\"><strong>Oral submucous fibrosis</strong></p>\r\n</td>\r\n<td style=\"width: 197.4pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"263\">\r\n<p class=\"TableText\">4.9 (2.3&ndash;8.6)</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

        "bookId": 52,
        "chapterId": 170,
        "headingId": 577,
        "headingText": "\r\n<p>9230/0 Chondroblastoma, NOS</p>\r\n",
        "timestamp": "2023-09-28T12:35:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {
        "pkcontributionId": 115051,
        "bookId": 52,
        "chapterId": 170,
        "headingId": 578,
        "headingText": "\r\n<p>2E82.Z &amp; XH4NK2 Benign osteogenic tumour of unspecified site &amp; Chondroblastoma, NOS</p>\r\n",
        "timestamp": "2023-09-28T12:35:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,

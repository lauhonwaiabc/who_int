[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 115049,
        "bookId": 52,
        "chapterId": 170,
        "headingId": 576,
        "headingText": "<p>Chondroblastoma is a benign tumour of bone composed of chondroblasts forming sheets and islands of eosinophilic chondroid matrix.</p>",
        "timestamp": "2023-11-10T17:56:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 577,
    "contributions": [
      {

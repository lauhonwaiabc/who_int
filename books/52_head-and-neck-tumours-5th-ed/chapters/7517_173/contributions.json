        "bookId": 52,
        "chapterId": 173,
        "headingId": 577,
        "headingText": "\r\n<p>9200/1 Osteoblastoma, NOS</p>\r\n",
        "timestamp": "2023-09-28T12:34:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {
        "pkcontributionId": 115034,
        "bookId": 52,
        "chapterId": 173,
        "headingId": 578,
        "headingText": "\r\n<p>2E83.Z &amp; XH4316 Benign osteogenic tumour of unspecified site &amp; Osteoblastoma, NOS</p>\r\n",
        "timestamp": "2023-09-28T12:34:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Related terminology",

[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 115032,
        "bookId": 52,
        "chapterId": 173,
        "headingId": 576,
        "headingText": "<p>Osteoblastoma is a benign but locally aggressive bone-forming tumour &ge;&nbsp;20&nbsp;mm in diameter, morphologically similar to osteoid osteoma, with sheets of large osteoblasts and woven bone with prominent osteoblastic rimming.</p>",
        "timestamp": "2023-11-10T17:55:15"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

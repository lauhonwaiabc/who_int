[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 114692,
        "bookId": 52,
        "chapterId": 145,
        "headingId": 576,
        "headingText": "\r\n<p>Sclerosing odontogenic carcinoma (SOC) is a primary intraosseous carcinoma of the jaws with bland cytology, markedly sclerotic stroma, and local aggressive infiltration, but no metastatic potential.</p>\r\n",
        "timestamp": "2023-09-28T11:41:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 577,
    "contributions": [
      {
        "pkcontributionId": 114693,
        "bookId": 52,
        "chapterId": 145,
        "headingId": 577,
        "headingText": "\r\n<p>9270/3 Sclerosing odontogenic carcinoma</p>\r\n",
        "timestamp": "2023-09-28T11:41:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {
        "pkcontributionId": 114694,
        "bookId": 52,
        "chapterId": 145,
        "headingId": 578,
        "headingText": "\r\n<p>2B5J &amp; XH4M89 Malignant miscellaneous tumours of bone or articular cartilage of other or unspecified sites &amp; Odontogenic tumour, malignant</p>\r\n",
        "timestamp": "2023-09-28T11:41:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,

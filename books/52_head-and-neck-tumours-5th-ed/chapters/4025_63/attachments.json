    "fileId": 26939,
    "type": "WSI",
    "diagnosis": "Pleomorphic adenoma",
    "title": "",
    "legend": "Core needle biopsy samples are commonly obtained for salivary gland neoplasms. In this case, the diagnosis of a pleomorphic adenoma can be rendered, because the histological features are quite classic.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",

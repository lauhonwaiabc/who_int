  {
    "pkattachmentId": 58430,
    "bookid": 52,
    "chapterId": 63,
    "fileId": 27128,
    "type": "WSI",
    "diagnosis": "Pleomorphic adenoma",
    "title": "",
    "legend": "In clinically recurrent tumours, there are usually multiple separate nodules of benign-appearing pleomorphic adenoma set within fibroadipose connective tissue. There is no pleomorphism, destructive invasion, or increased mitotic rate.",
    "source": "Lester D.R. Thompson",
    "copyright": "",

[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 113414,
        "bookId": 52,
        "chapterId": 70,
        "headingId": 576,
        "headingText": "<p >Sialadenoma papilliferum (SP) is a polypoid neoplasm with both exophytic and inward papillary proliferation of mucosal and salivary ductal epithelium.</p>",
        "timestamp": "2023-11-22T14:15:59"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

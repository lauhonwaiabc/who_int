[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 113448,
        "bookId": 52,
        "chapterId": 355,
        "headingId": 576,
        "headingText": "\r\n<p>Sebaceous adenoma is a benign, well-circumscribed tumour composed of irregularly sized and shaped nests of sebaceous cells without cytological atypia, frequently with areas of cystic change and squamous differentiation.</p>\r\n",
        "timestamp": "2023-09-26T10:18:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 577,
    "contributions": [
      {
        "pkcontributionId": 113449,
        "bookId": 52,
        "chapterId": 355,
        "headingId": 577,
        "headingText": "\r\n<p>8410/0 Sebaceous adenoma</p>\r\n",
        "timestamp": "2023-09-26T10:18:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {
        "pkcontributionId": 113450,
        "bookId": 52,
        "chapterId": 355,
        "headingId": 578,
        "headingText": "\r\n<p>2E91.Z &amp; XH1NC5 Benign neoplasm of major salivary glands, unspecified &amp; Sebaceous adenoma</p>\r\n",
        "timestamp": "2023-09-26T10:18:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,

        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-09-26T10:18:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 113464,
        "bookId": 52,
        "chapterId": 355,
        "headingId": 590,
        "headingText": "\r\n<p>The tumours do not recur after complete excision.</p>",
        "timestamp": "2023-09-26T10:18:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
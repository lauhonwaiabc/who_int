      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 115236,
        "bookId": 52,
        "chapterId": 293,
        "headingId": 590,
        "headingText": "\r\n<p>Recurrences develop after incomplete excision {6243462; 6300574; 15104293; 32443830}.</p>",
        "timestamp": "2023-09-28T13:19:41"
      }
    ],

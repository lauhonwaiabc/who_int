        "chapterId": 293,
        "headingId": 587,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-09-28T13:19:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

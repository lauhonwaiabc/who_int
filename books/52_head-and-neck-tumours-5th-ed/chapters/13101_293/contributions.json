        "timestamp": "2023-09-28T13:19:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 115234,
        "bookId": 52,
        "chapterId": 293,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> a lateral EAC location; low/moderately cellular tumour; bland, glandular proliferation of a biphasic population of cells; luminal apocrine morphology with decapitation.</p>\r\n<p><em>Desirable:</em> cytoplasmic golden-yellow/brown pigment granules.</p>\r\n",
        "timestamp": "2023-09-28T13:19:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

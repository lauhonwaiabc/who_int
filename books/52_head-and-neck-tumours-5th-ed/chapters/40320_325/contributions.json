[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 113737,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 576,
        "headingText": "\r\n<p>Mucinous adenocarcinoma (MA) is a primary salivary carcinoma that displays prominent intracellular and/or extracellular mucin, lacks diagnostic features of other tumour types, and is usually associated with <em>AKT1</em> alterations.</p>\r\n",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 577,
    "contributions": [
      {
        "pkcontributionId": 113738,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 577,
        "headingText": "\r\n<p>8480/3 Mucinous adenocarcinoma</p>\r\n",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {
        "pkcontributionId": 113739,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 578,
        "headingText": "\r\n<p>2B66.Y &amp; XH1S75 Other specified malignant neoplasms of other or unspecified parts of mouth &amp; Mucinous adenocarcinoma</p>\r\n",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 579,
    "contributions": [
      {
        "pkcontributionId": 113740,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 579,
        "headingText": "\r\n<p><em>Not recommended:</em> papillary cystadenocarcinoma; mucinous cystadenocarcinoma; mucin-producing adenopapillary carcinoma; colloid carcinoma; signet ring carcinoma.</p>\r\n",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 750,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 580,
    "contributions": [
      {
        "pkcontributionId": 113741,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 580,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 751,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 581,
    "contributions": [
      {
        "pkcontributionId": 113742,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 581,
        "headingText": "\r\n<p>MA is most common in intraoral minor salivary glands {8944036; 20738418; 33739781}.</p>\r\n",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 752,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 582,
    "contributions": [
      {
        "pkcontributionId": 113743,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 582,
        "headingText": "\r\n<p>Most patients have painless masses or swellings. Nodal metastases are occasionally seen at presentation {19037659; 26908552}.</p>\r\n",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 753,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 583,
    "contributions": [
      {
        "pkcontributionId": 113744,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 583,
        "headingText": "\r\n<p>MA has a peak incidence in the eighth decade of life and a relatively equal sex distribution {20738418; 33739781; 8944036}.</p>\r\n",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 754,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 584,
    "contributions": [
      {
        "pkcontributionId": 113745,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 584,
        "headingText": "<p >Unknown</p>",
        "timestamp": "2023-10-18T15:44:42"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 755,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 585,
    "contributions": [
      {
        "pkcontributionId": 113746,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 585,
        "headingText": "\r\n<p>MA has a recurrent <em>AKT1</em> p.E17K mutation, usually accompanied by <em>TP53</em> mutations {33739781}.</p>\r\n",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 762,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 592,
    "contributions": [
      {
        "pkcontributionId": 113747,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 592,
        "headingText": "\r\n<p>Tumours are solid or cystic, with a gelatinous cut surface.</p>\r\n",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 756,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 586,
    "contributions": [
      {
        "pkcontributionId": 113748,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 586,
        "headingText": "<p>MA is defined by abundant intracellular and/or extracellular mucin production in multiple forms, including goblet cell&ndash;like vacuoles, apical caps, foveolar-type cytoplasmic droplets, or stromal pools. Tumours show variable papillary, colloid, or signet-ring architecture, with 40% displaying mixed patterns {3178562; 12425848; 20738418; 33739781}. Most tumours display complex or simple papillary fronds projecting into cystic spaces. The colloid pattern is the second most common, with tumour nests suspended in mucin pools. Discohesive signet-ring cells are rarely seen. Cytological atypia varies widely.</p>\r\n<h5>Immunohistochemistry</h5>\r\n<p>MA is positive for CK7 and negative for CK20, CDX2, p63, p40, thyroid transcription factor&nbsp;1 (TTF1), S100, calponin, SMA, and AR {12425848; 33739781}.</p>\r\n<h5>Differential diagnosis</h5>\r\n<p>To diagnose MA, other mucin-producing salivary gland carcinomas must be excluded, including mucin-rich mucoepidermoid carcinoma (epidermoid/intermediate cells; p63/p40+), mucinous and rhabdoid variants of salivary duct carcinoma (apocrine cytology; AR+), and the mucinous/secretory pattern of myoepithelial carcinoma (nested/corded pattern; S100, calponin, or SMA+). Metastasis from gastrointestinal, pancreaticobiliary, or lung adenocarcinomas should be ruled out clinically.</p>",
        "timestamp": "2023-10-18T15:45:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 757,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 587,
    "contributions": [
      {
        "pkcontributionId": 113749,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 587,
        "headingText": "<p>Not reported</p>",
        "timestamp": "2023-10-18T15:45:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 758,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 588,
    "contributions": [
      {
        "pkcontributionId": 113750,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 588,
        "headingText": "\r\n<p>The identification of <em>AKT1</em> p.E17K mutation can support the diagnosis.</p>\r\n",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 113751,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 591,
        "headingText": "<p><em>Essential:</em> a salivary gland malignancy with abundant intracellular or extracellular mucin; CK7+, CK20&minus;; no features of other mucin-producing salivary gland neoplasms.</p>\r\n<p><em>Desirable:</em> <em>AKT1</em> p.E17K mutation (in selected cases).</p>",
        "timestamp": "2023-10-18T15:45:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 759,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 589,
    "contributions": [
      {
        "pkcontributionId": 113752,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 589,
        "headingText": "<p>Staging follows the eighth edition of the Union for International Cancer Control (UICC)&nbsp;/ American Joint Committee on Cancer (AJCC) TNM staging system.</p>",
        "timestamp": "2023-10-09T17:06:54"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 113753,
        "bookId": 52,
        "chapterId": 325,
        "headingId": 590,
        "headingText": "\r\n<p>Although papillary-predominant tumours are generally indolent, dominant colloid or signet-ring patterns are associated with recurrence and metastases {8944036; 19037659; 26908552}.</p>",
        "timestamp": "2023-09-26T13:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
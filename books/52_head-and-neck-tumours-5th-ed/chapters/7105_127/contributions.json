[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 114352,
        "bookId": 52,
        "chapterId": 127,
        "headingId": 576,
        "headingText": "\r\n<p>Lateral periodontal cyst (LPC) is a developmental odontogenic cyst lined by non-keratinized epithelium with characteristic thickenings.</p>\r\n<p>Botryoid odontogenic cyst (BOC) is a less common multilocular subtype of LPC.</p>\r\n",
        "timestamp": "2023-09-28T10:19:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 114366,
        "bookId": 52,
        "chapterId": 127,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> site on the lateral aspect or between the roots of vital erupted teeth; characteristic whorled epithelial plaques; multilocular (BOC only).</p>\r\n",
        "timestamp": "2023-09-28T10:19:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 759,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 589,

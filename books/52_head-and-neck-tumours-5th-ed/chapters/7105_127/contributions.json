      {
        "pkcontributionId": 114367,
        "bookId": 52,
        "chapterId": 127,
        "headingId": 589,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-09-28T10:19:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 114368,
        "bookId": 52,
        "chapterId": 127,
        "headingId": 590,
        "headingText": "<p >Recurrence of LPC is exceedingly rare after enucleation. BOC recurs after enucleation in about 22% of cases and additional treatment may be indicated for recurrent BOC {29156092}.</p>",
        "timestamp": "2023-11-10T16:51:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
    "contributions": [
      {
        "pkcontributionId": 114353,
        "bookId": 52,
        "chapterId": 127,
        "headingId": 577,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-09-28T10:19:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {
        "pkcontributionId": 114354,
        "bookId": 52,
        "chapterId": 127,
        "headingId": 578,
        "headingText": "\r\n<p>DA05.0 Developmental odontogenic cysts</p>\r\n",
        "timestamp": "2023-09-28T10:19:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,

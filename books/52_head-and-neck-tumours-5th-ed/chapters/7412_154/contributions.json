[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 114573,
        "bookId": 52,
        "chapterId": 154,
        "headingId": 576,
        "headingText": "\r\n<p>Primordial odontogenic tumour (POT) is composed of variably cellular fibrous tissue with areas similar to dental papilla, surrounded by epithelium resembling the internal epithelium of the enamel organ.</p>\r\n",
        "timestamp": "2023-09-28T10:31:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 577,
    "contributions": [
      {
        "pkcontributionId": 114574,
        "bookId": 52,
        "chapterId": 154,
        "headingId": 577,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-09-28T10:31:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {
        "pkcontributionId": 114575,
        "bookId": 52,
        "chapterId": 154,
        "headingId": 578,
        "headingText": "\r\n<p>2E83.1 &amp; XH43L1 Benign osteogenic tumours of bone or articular cartilage of lower jaw &amp; Odontogenic tumour, benign</p>\r\n",
        "timestamp": "2023-09-28T10:31:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 579,

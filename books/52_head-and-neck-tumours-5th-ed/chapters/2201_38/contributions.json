    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 588,
    "contributions": [
      {
        "pkcontributionId": 113051,
        "bookId": 52,
        "chapterId": 38,
        "headingId": 588,
        "headingText": "<p >Not relevant</p>",
        "timestamp": "2023-10-11T16:31:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 113052,
        "bookId": 52,
        "chapterId": 38,
        "headingId": 591,
        "headingText": "<p><em>Essential:</em> complex papillary and glandular growth with infiltration of the submucosa; low-grade cytology.</p>\r\n<p><em>Desirable:</em> transition from surface epithelium to tumour; TTF1 positivity, and absence of thyroglobulin and PAX8 (in selected cases).</p>",
        "timestamp": "2023-10-11T16:31:25"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 759,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 589,
    "contributions": [
      {
        "pkcontributionId": 113053,
        "bookId": 52,
        "chapterId": 38,
        "headingId": 589,
        "headingText": "<p>Staging follows the eighth edition of the Union for International Cancer Control (UICC)&nbsp;/ American Joint Committee on Cancer (AJCC) TNM staging system.</p>",
        "timestamp": "2023-10-09T16:27:32"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 113054,
        "bookId": 52,
        "chapterId": 38,
        "headingId": 590,
        "headingText": "\r\n<p>Surgical excision is the treatment of choice and is curative {2462370}. This slow-growing tumour has the potential to recur if incompletely excised. Metastatic disease has not been reported.</p>",
        "timestamp": "2023-09-25T13:49:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
        "timestamp": "2023-09-28T10:23:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 114451,
        "bookId": 52,
        "chapterId": 139,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> location in tooth-bearing areas of jaw; closely packed islands of cytologically bland epithelium; uniform squamous differentiation without significant keratinization; no peripheral palisading or stellate reticulum.</p>\r\n",
        "timestamp": "2023-09-28T10:23:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 759,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 589,
    "contributions": [
      {
        "pkcontributionId": 114452,
        "bookId": 52,
        "chapterId": 139,
        "headingId": 589,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-09-28T10:23:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 114453,
        "bookId": 52,
        "chapterId": 139,
        "headingId": 590,
        "headingText": "\r\n<p>Unifocal SOT rarely recurs after conservative surgery. Multifocal or recurring SOT, especially of the maxilla, may require a more radical approach.</p>",
        "timestamp": "2023-09-28T10:23:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
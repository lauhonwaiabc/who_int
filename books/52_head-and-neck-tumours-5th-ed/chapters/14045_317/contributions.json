    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 116840,
        "bookId": 52,
        "chapterId": 317,
        "headingId": 590,
        "headingText": "\r\n<p>Cancer and related complications are the leading cause of death, on average occurring in the third decade of life {20301572}. Sun exposure to the face and other exposed areas should be avoided, particularly in infancy and early childhood, and exposure to ionizing radiation should be minimized. Cancer screening and surveillance are recommended {18359209}.</p>",
        "timestamp": "2023-10-02T15:42:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
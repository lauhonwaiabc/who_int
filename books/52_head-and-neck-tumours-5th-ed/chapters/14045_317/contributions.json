        "bookId": 52,
        "chapterId": 317,
        "headingId": 592,
        "headingText": "\r\n<p>Nonspecific</p>\r\n",
        "timestamp": "2023-10-02T15:42:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

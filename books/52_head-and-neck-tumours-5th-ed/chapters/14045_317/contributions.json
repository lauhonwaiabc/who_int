    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 116824,
        "bookId": 52,
        "chapterId": 317,
        "headingId": 576,
        "headingText": "<p >Bloom syndrome is an autosomal recessive chromosomal breakage syndrome due to loss-of-function variants in the <em>BLM</em> gene, with distinct clinical features and the development of tumours including oropharyngeal carcinoma.</p>",
        "timestamp": "2023-11-21T21:37:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

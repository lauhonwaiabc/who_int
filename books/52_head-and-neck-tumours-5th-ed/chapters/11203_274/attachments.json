  {
    "pkattachmentId": 58197,
    "bookid": 52,
    "chapterId": 274,
    "fileId": 26364,
    "type": "Table",
    "diagnosis": "",
    "title": "<p class=\"TableTitle\">Expected pattern of first-echelon lymph node metastasis in the head and neck for carcinoma of unknown primary</p>",
    "legend": "",
    "source": "Juan C. Hernandez-Prera",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Metastatic site </strong></p>\r\n</td>\r\n<td style=\"border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Possible primary location </strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Level&nbsp;IA (submental)</strong></p>\r\n</td>\r\n<td style=\"padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\">Lower lip, anterior oral cavity (floor of mouth), skin (midface)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Level&nbsp;IB (submandibular)</strong></p>\r\n</td>\r\n<td style=\"background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\">Oral cavity, paranasal sinuses, skin (midface)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Level&nbsp;II (upper jugular)</strong></p>\r\n</td>\r\n<td style=\"padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\">Oropharynx, oral cavity, nasopharynx, paranasal sinuses, larynx, hypopharynx, parotid</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Level&nbsp;III (middle jugular)</strong></p>\r\n</td>\r\n<td style=\"background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\">Oropharynx, oral cavity, larynx, hypopharynx, parotid</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Level&nbsp;IV (lower jugular)</strong></p>\r\n</td>\r\n<td style=\"padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\">Oropharynx, larynx, hypopharynx, upper oesophagus, thyroid</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Level&nbsp;V (posterior triangle)</strong></p>\r\n</td>\r\n<td style=\"background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\">Nasopharynx, skin (posterior scalp), thyroid</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Level&nbsp;VI (anterior compartment)</strong></p>\r\n</td>\r\n<td style=\"padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\">Thyroid, larynx, hypopharynx, cervical oesophagus</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Supraclavicular</strong></p>\r\n</td>\r\n<td style=\"background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\">Infraclavicular sites (including lung, oesophagus, breast, gastrointestinal and gynaecological tracts)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Parotid</strong></p>\r\n</td>\r\n<td style=\"padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\">Skin (lateral/upper face and scalp), oropharynx</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\"><strong>Retropharyngeal</strong></p>\r\n</td>\r\n<td style=\"border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\">\r\n<p class=\"TableText\">Nasopharynx, oropharynx</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },
  {
    "pkattachmentId": 58198,
    "bookid": 52,
    "chapterId": 274,
    "fileId": 26365,
    "type": "Table",
    "diagnosis": "",
    "title": "<p class=\"TableTitle\">Morphological diagnostic approach to carcinoma of unknown primary in the head and neck</p>",
    "legend": "",
    "source": "Juan C. Hernandez-Prera",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Morphology </span></strong></p>\r\n</td>\r\n<td style=\"width: 219.7pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Possible primary head and neck location</span></strong></p>\r\n</td>\r\n<td style=\"width: 289.15pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"386\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Pathology workup</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\"><strong>Non-keratinizing SCC</strong></p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\">Oropharynx, nasal cavity, nasopharynx</p>\r\n</td>\r\n<td style=\"width: 289.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"386\">\r\n<p class=\"TableText\">p16 and/or HR-HPV testing</p>\r\n<p class=\"TableText\">EBER if p16/HPV-negative</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Keratinizing SCC</span></strong></p>\r\n</td>\r\n<td style=\"width: 219.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Extra-oropharyngeal mucosal site, skin, oropharynx</span></p>\r\n</td>\r\n<td style=\"width: 289.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"386\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">p16 and/or HR-HPV testing</span></p>\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">UV radiation signature mutations</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\"><strong>Undifferentiated carcinoma (lymphoepithelial-like)</strong></p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\">Nasopharynx, oropharynx</p>\r\n</td>\r\n<td style=\"width: 289.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"386\">\r\n<p class=\"TableText\">EBER</p>\r\n<p class=\"TableText\">p16 and/or HR-HPV testing if EBER-negative</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Neuroendocrine carcinoma (NEC)</span></strong></p>\r\n</td>\r\n<td style=\"width: 219.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Oropharynx, skin</span></p>\r\n</td>\r\n<td style=\"width: 289.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"386\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">p16 and/or HR-HPV testing</span></p>\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">CK20, INSM1, chromogranin, Merkel cell polyomavirus</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\"><strong>Neuroendocrine tumour (NET)</strong></p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\">Supraglottic larynx</p>\r\n</td>\r\n<td style=\"width: 289.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"386\">\r\n<p class=\"TableText\">Neuroendocrine markers</p>\r\n<p class=\"TableText\">Calcitonin (immunohistochemistry and serology)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cribriform subtype of polymorphous adenocarcinoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 219.7pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Oral cavity (base of tongue)</span></p>\r\n</td>\r\n<td style=\"width: 289.15pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"386\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">S100, p63, p40</span></p>\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">PRKD1/2/3</span></em><span style=\"color: black; mso-color-alt: windowtext;\"> gene rearrangement</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">EBER, EBV-encoded small RNA; HR, high-risk; SCC, squamous cell carcinoma; UV, ultraviolet.</p>",

        "bookId": 52,
        "chapterId": 105,
        "headingId": 578,
        "headingText": "\r\n<p>DB35.3 Hamartomatous polyp</p>\r\n",
        "timestamp": "2023-09-26T16:28:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 579,
    "contributions": [
      {
        "pkcontributionId": 114184,
        "bookId": 52,
        "chapterId": 105,
        "headingId": 579,
        "headingText": "\r\n<p><em>Acceptable:</em> lymphangiectatic fibrous polyp; fibrovascular polyp; polypoid lymphangioma; papillary lymphoid polyp; benign hamartomatous polyp; lymphangiectatic fibrolipomatous polyp.</p>\r\n<p><em>Not recommended:</em> tonsillar lipoma.</p>\r\n",
        "timestamp": "2023-09-26T16:28:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 750,
    "bookid": 52,

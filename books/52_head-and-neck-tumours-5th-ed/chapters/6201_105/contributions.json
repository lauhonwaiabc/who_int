  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 114195,
        "bookId": 52,
        "chapterId": 105,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> a polypoid tumour of the palatine tonsils; a submucosal proliferation of lymphovascular channels containing proteinaceous fluid with lymphocytes, in a background of lymphoid or connective tissue.</p>\r\n",
        "timestamp": "2023-09-26T16:28:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 114197,
        "bookId": 52,
        "chapterId": 105,
        "headingId": 590,
        "headingText": "\r\n<p>Recurrence is rare after surgical treatment. However, without treatment, the airway may become critically obstructed {11048808}.</p>",
        "timestamp": "2023-09-26T16:28:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

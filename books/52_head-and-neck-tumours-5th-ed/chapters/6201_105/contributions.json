[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 114181,
        "bookId": 52,
        "chapterId": 105,
        "headingId": 576,
        "headingText": "\r\n<p>Hamartomatous polyps are lesions associated with the palatine tonsils composed of a haphazard proliferation of elements that are normally found in the oropharynx.</p>\r\n",
        "timestamp": "2023-09-26T16:28:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

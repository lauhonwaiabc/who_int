    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 116379,
        "bookId": 52,
        "chapterId": 342,
        "headingId": 590,
        "headingText": "\r\n<p>Surgical management is curative for isolated lesions, whereas cysts in the setting of AIDS resolve with highly active antiretroviral therapy (HAART) or radiotherapy {21237435; 23532713; 31456841}.</p>",
        "timestamp": "2023-10-02T13:31:31"
      }
    ],

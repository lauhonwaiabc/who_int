    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 116377,
        "bookId": 52,
        "chapterId": 342,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> dilated cystic structure; benign epithelial lining; dense lymphoid stroma in cyst wall.</p>\r\n",
        "timestamp": "2023-10-02T13:31:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0

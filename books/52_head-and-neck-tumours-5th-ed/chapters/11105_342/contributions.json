        "bookId": 52,
        "chapterId": 342,
        "headingId": 576,
        "headingText": "<p>Lymphoepithelial cyst is a benign acquired epithelial-lined cystic lesion associated with dense lymphoid stroma.</p>",
        "timestamp": "2024-01-18T15:34:58"
      }
    ],

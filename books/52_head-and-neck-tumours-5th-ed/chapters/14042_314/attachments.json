    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 6.0cm; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\"><strong>Characteristic</strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\"><strong>FA-associated HNSCC</strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\"><strong>Sporadic HNSCC</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 6.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\"><strong>Patient age</strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">15&ndash;49&nbsp;years</p>\r\n</td>\r\n<td style=\"width: 8.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">50&ndash;70&nbsp;years</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 6.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\"><strong>Site</strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Tongue and gingiva</p>\r\n</td>\r\n<td style=\"width: 8.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Tongue and oropharynx</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 6.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\"><strong>Etiology&nbsp;/ risk factors</strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Genomic instability&nbsp;/ oxidative stress</p>\r\n<p class=\"TableText\">Conditioning regimens used for aHSCT</p>\r\n<p class=\"TableText\">Chronic GVHD</p>\r\n</td>\r\n<td style=\"width: 8.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Tobacco/alcohol/HPV</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 6.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\"><strong>Histopathology</strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Moderately to poorly differentiated with epithelial&ndash;mesenchymal transition</p>\r\n</td>\r\n<td style=\"width: 8.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Well to poorly differentiated</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 6.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\"><strong>Stage at diagnosis </strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Advanced</p>\r\n</td>\r\n<td style=\"width: 8.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Varies depending on the demographics and sites</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 6.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\"><strong>Cancer stem/progenitor cells</strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">More abundant</p>\r\n</td>\r\n<td style=\"width: 8.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Less abundant</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 6.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\"><strong>Molecular profile</strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\"><em>TP53</em> mutations: +</p>\r\n<p class=\"TableText\">LOH on&nbsp;3p, 9p, 17p, 13q, 18q, and&nbsp;8p</p>\r\n</td>\r\n<td style=\"width: 8.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\"><em>TP53</em> mutations: +/&minus;</p>\r\n<p class=\"TableText\">LOH on&nbsp;3p, 9p, 17p, 13q, 18q, and&nbsp;8p</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 6.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\"><strong>Therapeutic modalities </strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Surgery</p>\r\n</td>\r\n<td style=\"width: 8.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Surgery, chemoradiotherapy, and immunotherapy</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 6.0cm; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\"><strong>Prognosis</strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Poor</p>\r\n</td>\r\n<td style=\"width: 8.0cm; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"302\">\r\n<p class=\"TableText\">Variable</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">aHSCT, allogeneic haematopoietic stem cell transplantation; GVHD, graft-versus-host disease; LOH, loss of heterozygosity; +,&nbsp;present; &minus;,&nbsp;absent.</p>",

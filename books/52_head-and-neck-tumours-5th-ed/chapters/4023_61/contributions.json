    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 113516,
        "bookId": 52,
        "chapterId": 61,
        "headingId": 576,
        "headingText": "\r\n<p>Keratocystoma is a benign salivary gland tumour characterized by multicystic spaces, lined by stratified squamous epithelium, containing keratotic lamellae and focal solid epithelial nests.</p>\r\n",
        "timestamp": "2023-09-26T10:21:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 113532,
        "bookId": 52,
        "chapterId": 61,
        "headingId": 590,
        "headingText": "\r\n<p>The tumours behave in a benign manner, with no recurrence after excision or subtotal parotidectomy.</p>",
        "timestamp": "2023-09-26T10:21:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

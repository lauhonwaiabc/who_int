      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 113530,
        "bookId": 52,
        "chapterId": 61,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> multicystic structures containing keratinized lamellae; bland stratified squamous epithelial lining without a granular layer.</p>\r\n<p><em>Desirable:</em> the presence of sharply defined solid squamous cell islands.</p>\r\n",
        "timestamp": "2023-09-26T10:21:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

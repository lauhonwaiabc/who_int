        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-09-28T11:54:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 114895,
        "bookId": 52,
        "chapterId": 189,
        "headingId": 590,
        "headingText": "\r\n<p>Healing is induced by bleeding after surgical exploration and curettage {26850870}. Occasional spontaneous healing is reported {26850870; 12058266}. Occasional cases recur.</p>",
        "timestamp": "2023-09-28T11:54:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 114893,
        "bookId": 52,
        "chapterId": 189,
        "headingId": 591,
        "headingText": "<p><em>Essential:</em> typical radiological features; empty cavity at operation.</p>",
        "timestamp": "2023-11-10T17:41:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "timestamp": "2023-10-02T13:32:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {
        "pkcontributionId": 116382,
        "bookId": 52,
        "chapterId": 268,
        "headingId": 578,
        "headingText": "\r\n<p>DA05.Y Other specified cysts of oral or facial-neck region &amp; Branchial cleft cyst</p>\r\n",
        "timestamp": "2023-10-02T13:32:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

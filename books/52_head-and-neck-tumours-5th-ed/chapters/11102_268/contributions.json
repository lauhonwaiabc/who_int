        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-10-02T13:32:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 116394,
        "bookId": 52,
        "chapterId": 268,
        "headingId": 591,
        "headingText": "<p><em>Essential:</em> lateral neck location; bland cytomorphology.</p>\r\n<p><em>Desirable:</em> negative HPV status (in selected cases).</p>",
        "timestamp": "2024-01-18T15:36:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

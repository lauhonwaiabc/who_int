    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 116396,
        "bookId": 52,
        "chapterId": 268,
        "headingId": 590,
        "headingText": "\r\n<p>Surgical excision is curative. Incomplete resection may lead to recurrence, and unresected cysts have a risk of infection {17346566}. There is essentially no risk of carcinomatous transformation {23328541}.</p>",
        "timestamp": "2023-10-02T13:32:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 116380,
        "bookId": 52,
        "chapterId": 268,
        "headingId": 576,
        "headingText": "<p>Branchial cleft cyst is a developmental anomaly that arises from the first, second, third, or fourth pharyngeal/branchial clefts and manifests clinically as a lateral neck mass.</p>",
        "timestamp": "2023-11-21T12:55:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,

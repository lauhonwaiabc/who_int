        "headingId": 589,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-09-25T13:46:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 113020,
        "bookId": 52,
        "chapterId": 31,
        "headingId": 590,
        "headingText": "\r\n<p>Surgical excision is curative in the majority of cases {26829696}.</p>",
        "timestamp": "2023-09-25T13:46:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 113482,
        "bookId": 52,
        "chapterId": 60,
        "headingId": 576,
        "headingText": "\r\n<p>Striated duct adenoma (SDA) is a benign salivary gland tumour composed of ducts resembling normal striated ducts lined by a single layer of luminal cells with minimal intervening stroma.</p>\r\n",
        "timestamp": "2023-09-26T10:20:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 577,
    "contributions": [
      {
        "pkcontributionId": 113483,
        "bookId": 52,
        "chapterId": 60,
        "headingId": 577,
        "headingText": "\r\n<p>8503/0 Striated duct adenoma</p>\r\n",
        "timestamp": "2023-09-26T10:20:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,

  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 115217,
        "bookId": 52,
        "chapterId": 353,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> normal/mature-appearing lamellar bony cortex in the appropriate radiological context.</p>\r\n",
        "timestamp": "2023-09-28T13:18:31"
      }
    ],

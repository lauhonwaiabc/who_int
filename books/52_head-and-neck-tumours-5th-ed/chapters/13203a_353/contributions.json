    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 115203,
        "bookId": 52,
        "chapterId": 353,
        "headingId": 576,
        "headingText": "\r\n<p>Exostosis (osteoma) of the ear is a slowly progressive benign growth of bony cortex secondary to chronic irritation {13904891}.</p>\r\n",
        "timestamp": "2023-09-28T13:18:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "chapterId": 353,
        "headingId": 578,
        "headingText": "\r\n<p>AA40.Y Other specified acquired deformity of external auditory canal &amp; Osteoma</p>\r\n",
        "timestamp": "2023-09-28T13:18:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,

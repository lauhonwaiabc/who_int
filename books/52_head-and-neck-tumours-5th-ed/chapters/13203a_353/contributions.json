    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 115219,
        "bookId": 52,
        "chapterId": 353,
        "headingId": 590,
        "headingText": "\r\n<p>Exostoses of the EAC and the middle ear are benign lesions, usually managed conservatively with a good outcome.</p>",
        "timestamp": "2023-09-28T13:18:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

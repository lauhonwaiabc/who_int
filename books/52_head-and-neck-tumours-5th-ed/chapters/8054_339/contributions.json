[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 115680,
        "bookId": 52,
        "chapterId": 339,
        "headingId": 576,
        "headingText": "\r\n<p>Smooth muscle tumours of uncertain malignant potential (STUMPs) show morphological features that exceed the criteria for leiomyoma or its subtypes, yet are insufficient for a diagnosis of leiomyosarcoma, and behave in a malignant fashion in only a minority of cases.</p>\r\n",
        "timestamp": "2023-10-02T11:07:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 577,
    "contributions": [
      {
        "pkcontributionId": 115681,
        "bookId": 52,
        "chapterId": 339,
        "headingId": 577,
        "headingText": "\r\n<p>8897/1 Smooth muscle tumour of uncertain malignant potential</p>\r\n",
        "timestamp": "2023-10-02T11:07:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {

        "timestamp": "2023-09-28T10:17:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 762,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 592,
    "contributions": [
      {
        "pkcontributionId": 114311,
        "bookId": 52,
        "chapterId": 128,
        "headingId": 592,
        "headingText": "\r\n<p>Nodular mucosa with a smooth surface; whitish or translucent</p>\r\n",
        "timestamp": "2023-09-28T10:17:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 756,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 586,
    "contributions": [
      {
        "pkcontributionId": 114312,
        "bookId": 52,
        "chapterId": 128,
        "headingId": 586,
        "headingText": "\r\n<p>GCA is lined by a thin, flat or cuboidal squamous epithelium, 1&ndash;3&nbsp;cells thick, without rete ridges. Plaque-like thickenings that protrude into the lumen or the connective tissue wall and clear cells are usually present. The connective tissue wall may contain islands of epithelium resembling the epithelial plaques. GCIs are rarely biopsied, but they are lined by thin keratinized epithelium that may have a connection to the surface epithelium.</p>\r\n",
        "timestamp": "2023-09-28T10:17:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 757,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 587,
    "contributions": [
      {
        "pkcontributionId": 114313,
        "bookId": 52,
        "chapterId": 128,
        "headingId": 587,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-09-28T10:17:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 758,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 588,
    "contributions": [
      {
        "pkcontributionId": 114314,

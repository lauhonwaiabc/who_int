  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 114315,
        "bookId": 52,
        "chapterId": 128,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> for GCA: site in attached gingiva; thin epithelial lining; for GCI: site in alveolar ridge; patient aged &lt;&nbsp;3&nbsp;months.</p>\r\n",
        "timestamp": "2023-09-28T10:17:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 759,

[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 114301,
        "bookId": 52,
        "chapterId": 128,
        "headingId": 576,
        "headingText": "<p>Gingival cysts are developmental odontogenic cysts arising in the attached gingiva or alveolar ridge mucoperiosteum.</p>",
        "timestamp": "2023-11-10T16:49:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,

        "timestamp": "2023-09-28T10:17:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 114317,
        "bookId": 52,
        "chapterId": 128,
        "headingId": 590,
        "headingText": "\r\n<p>GCAs do not recur after conservative excision {29156092}. GCIs rupture or involute and resolve spontaneously.</p>",
        "timestamp": "2023-09-28T10:17:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
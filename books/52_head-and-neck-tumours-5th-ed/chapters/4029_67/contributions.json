        "headingId": 588,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-09-26T10:09:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 113343,
        "bookId": 52,
        "chapterId": 67,
        "headingId": 591,
        "headingText": "<p><em>Essential:</em> a circumscribed mass composed of large oncocytic epithelial cells; lack of entrapped normal parenchyma.</p>\r\n<p><em>Desirable:</em> basal cells positive for p63; absence of SOX10 and S100&nbsp;(in selected cases).</p>",
        "timestamp": "2023-10-18T12:25:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 759,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 589,
    "contributions": [
      {
        "pkcontributionId": 113344,
        "bookId": 52,
        "chapterId": 67,
        "headingId": 589,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-09-26T10:09:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 113345,
        "bookId": 52,
        "chapterId": 67,
        "headingId": 590,
        "headingText": "\r\n<p>Oncocytomas do not recur if completely resected. Malignant transformation is exceedingly rare {31209701}.</p>",
        "timestamp": "2023-09-26T10:09:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
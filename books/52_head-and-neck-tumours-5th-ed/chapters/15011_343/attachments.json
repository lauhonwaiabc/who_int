  },
  {
    "pkattachmentId": 56712,
    "bookid": 52,
    "chapterId": 343,
    "fileId": 23515,
    "type": "Figure",
    "diagnosis": "Metastatic renal cell carcinoma to the gingiva",
    "title": "",
    "legend": "There is neoplastic replacement of the stroma by a pleomorphic population of epithelial cells with prominent nucleoli. This tumour was identical to a known renal cell carcinoma.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/52/343/23515.jpg",

    "bookid": 52,
    "chapterId": 343,
    "fileId": 23516,
    "type": "Figure",
    "diagnosis": "Metastatic renal cell carcinoma to the gingiva",
    "title": "",
    "legend": "This metastatic renal cell carcinoma was strongly immunoreactive for PAX8 (shown), along with CAIX and RCCm, findings that helped to support a metastatic neoplasm.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",

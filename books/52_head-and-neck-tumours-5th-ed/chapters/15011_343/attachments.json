\" width=\"330\">\r\n<p class=\"TableText\">Breast and M&uuml;llerian tract carcinoma (female)</p>\r\n</td>\r\n<td style=\"width: 370.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\">GATA3, ER, PR, TRPS1, mammaglobin, PAX8, WT1, p16</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 28; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\">Lung and prostate carcinoma (male)</p>\r\n</td>\r\n<td style=\"width: 370.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\">Pankeratin, p40/p63, CK5/6, TTF1, claudin-4, synaptophysin, chromogranin, INSM1; NKX3-1 and PSA (prostate)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 29; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\">Renal cell carcinoma</p>\r\n</td>\r\n<td style=\"width: 370.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\">Pankeratin, PAX8, CAIX, CK7</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 30; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\">Melanoma</p>\r\n</td>\r\n<td style=\"width: 370.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\">S100, SOX10, HMB45, MITF, melan-A</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 31; page-break-inside: avoid;\">\r\n<td style=\"width: 92.85pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"4\" valign=\"top\" width=\"124\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Larynx, trachea, parapharyngeal space</span></strong></p>\r\n</td>\r\n<
  {
    "pkattachmentId": 58207,
    "bookid": 52,
    "chapterId": 343,
    "fileId": 27219,
    "type": "Table",
    "diagnosis": "",
    "title": "<p class=\"TableTitle\">Metastases to the head and neck</p>",
    "legend": "",
    "source": "Paul E. Jr Wakely",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 711.15pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"948\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 92.85pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"124\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Anatomical location</span></strong></p>\r\n</td>\r\n<td style=\"width: 247.35pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"330\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Most common metastatic malignancies</span></strong></p>\r\n</td>\r\n<td style=\"width: 370.95pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"495\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Relevant immunohistochemical markers</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 92.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"3\" valign=\"top\" width=\"124\">\r\n<p class=\"TableText\"><strong>Neck and lymph nodes</strong></p>\r\n</td>\r\n<td style=\"width: 247.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\">Squamous cell carcinoma (upper aerodigestive tract and skin of head and neck)</p>\r\n</td>\r\n<td style=\"width: 370.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\">Pankeratin, p40/p63, CK5/6, p16</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\">Papillary thyroid carcinoma</p>\r\n</td>\r\n<td style=\"width: 370.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\">PAX8, TTF1, thyroglobulin</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\">Salivary gland carcinoma</p>\r\n</td>\r\n<td style=\"width: 370.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\">Pankeratin, DOG1, AR, KIT (CD117), mammaglobin, p40, p63, SOX10, calponin, SMA, &beta;-catenin, GATA3, NR4A3, GFAP</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 92.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"6\" valign=\"top\" width=\"124\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Oral cavity</span></strong></p>\r\n</td>\r\n<td style=\"width: 247.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Lung carcinoma</span></p>\r\n</td>\r\n<td style=\"width: 370.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Pankeratin, p40/p63, CK5/6, TTF1, claudin-4, synaptophysin, chromogranin, INSM1</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Breast carcinoma</span></p>\r\n</td>\r\n<td style=\"width: 370.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">GATA3, ER, PR, TRPS1, mammaglobin</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Renal cell carcinoma</span></p>\r\n</td>\r\n<td style=\"width: 370.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Pankeratin, PAX8, CAIX, CK7</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Cutaneous squamous cell carcinoma</span></p>\r\n</td>\r\n<td style=\"width: 370.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Pankeratin, p40/p63, CK5/6</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Melanoma</span></p>\r\n</td>\r\n<td style=\"width: 370.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">S100, SOX10, HMB45, MITF, melan-A</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Sarcoma (angiosarcoma, liposarcoma)</span></p>\r\n</td>\r\n<td style=\"width: 370.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Pankeratin, CD34, SS18, DDIT3, MDM2, MUC4, CD31, ERG, SMARCB1, desmin, SMA, myogenin, MYOD1, S100, NKX2-2, CD99</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid;\">\r\n<td style=\"width: 92.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"3\" valign=\"top\" width=\"124\">\r\n<p class=\"TableText\"><strong>Maxillofacial bones</strong></p>\r\n</td>\r\n<td style=\"width: 247.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\">Breast carcinoma (most common)</p>\r\n</td>\r\n<td style=\"width: 370.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\">GATA3, ER, PR, TRPS1, mammaglobin</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 11; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\">Renal cell carcinoma</p>\r\n</td>\r\n<td style=\"width: 370.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\">PAX8, CAIX, CK7</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 12; page-break-inside: avoid;\">\r\n<td style=\"width: 247.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"330\">\r\n<p class=\"TableText\">Prostate carcinoma</p>\r\n</td>\r\n<td style=\"width: 370.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"495\">\r\n<p class=\"TableText\">NKX3-1, PSA, PAP</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 13; page-break-insid
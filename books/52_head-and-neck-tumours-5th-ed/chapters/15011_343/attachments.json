    "bookid": 52,
    "chapterId": 343,
    "fileId": 23514,
    "type": "Figure",
    "diagnosis": "Metastatic small cell carcinoma to the parotid salivary gland",
    "title": "",
    "legend": "Separating primary neuroendocrine carcinomas (NECs) from metastatic NECs can be challenging, especially when they are of the Merkel cell type. However, this tumour expressed strong immunoreactivity for thyroid transcription factor&nbsp;1 (TTF1) in a patient with a known pulmonary small cell carcinoma.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",

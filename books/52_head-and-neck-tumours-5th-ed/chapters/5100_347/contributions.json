        "headingId": 577,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-09-26T14:50:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 748,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 578,
    "contributions": [
      {
        "pkcontributionId": 113910,
        "bookId": 52,
        "chapterId": 347,
        "headingId": 578,
        "headingText": "\r\n<p>DA04 Diseases of salivary glands</p>\r\n",
        "timestamp": "2023-09-26T14:50:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 749,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 579,
    "contributions": [
      {
        "pkcontributionId": 113911,
        "bookId": 52,
        "chapterId": 347,
        "headingId": 579,
        "headingText": "\r\n<p><em>Not recommended:</em> adenometaplasia.</p>\r\n",
        "timestamp": "2023-09-26T14:50:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 750,

[
  {
    "pkheadingid": 746,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 576,
    "contributions": [
      {
        "pkcontributionId": 113908,
        "bookId": 52,
        "chapterId": 347,
        "headingId": 576,
        "headingText": "\r\n<p>Necrotizing sialometaplasia is a reactive, self-limiting, inflammatory condition of the salivary glands, usually resulting in necrosis or degeneration of salivary acini, and ductal squamous metaplasia.</p>\r\n",
        "timestamp": "2023-09-26T14:50:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 747,

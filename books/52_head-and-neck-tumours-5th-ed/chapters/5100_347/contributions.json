  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 113922,
        "bookId": 52,
        "chapterId": 347,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> preservation of a lobular architecture with squamous metaplasia of ducts and acini.</p>\r\n<p><em>Desirable:</em> infarction/necrosis of acini; pseudoepitheliomatous hyperplasia.</p>\r\n",
        "timestamp": "2023-09-26T14:50:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 759,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 589,
    "contributions": [
      {
        "pkcontributionId": 113923,
        "bookId": 52,
        "chapterId": 347,
        "headingId": 589,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-09-26T14:50:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 113924,
        "bookId": 52,
        "chapterId": 347,
        "headingId": 590,
        "headingText": "\r\n<p>Necrotizing sialometaplasia heals spontaneously in 6&ndash;10&nbsp;weeks, but healing may take as long as 6&nbsp;months. Close follow-up is needed to ensure proper healing. If healing does not occur, or if the lesion recurs, repeat biopsy is indicated to rule out neoplasia or vasculopathy {4716764; 22921832}.</p>",
        "timestamp": "2023-09-26T14:50:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
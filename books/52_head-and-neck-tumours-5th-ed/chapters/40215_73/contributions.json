      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 113377,
        "bookId": 52,
        "chapterId": 73,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> minor salivary gland location; monotonous, isomorphic syncytium of cuboidal to columnar cells anastomosing in a lattice of cords and canaliculi; no basal/myoepithelial layer.</p>\r\n",
        "timestamp": "2023-09-26T10:11:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 759,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 589,
    "contributions": [
      {
        "pkcontributionId": 113378,
        "bookId": 52,
        "chapterId": 73,
        "headingId": 589,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2023-09-26T10:11:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 113379,
        "bookId": 52,
        "chapterId": 73,
        "headingId": 590,
        "headingText": "\r\n<p>Complete conservative removal is best, although multifocality may suggest recurrence {25141970}.</p>",
        "timestamp": "2023-09-26T10:11:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

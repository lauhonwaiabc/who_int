        "pkcontributionId": 113375,
        "bookId": 52,
        "chapterId": 73,
        "headingId": 587,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-09-26T10:11:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

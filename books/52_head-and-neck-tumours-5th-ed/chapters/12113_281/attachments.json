    "title": "<p>Classification of pituitary neuroendocrine tumours (PitNETs)<sup>a</sup></p>",
    "legend": "",
    "source": "Sylvia L. Asa",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-table-layout-alt: fixed; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"945\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 155.95pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"208\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Tumour type</span></strong></p>\r\n</td>\r\n<td style=\"width: 99.2pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"132\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Transcription factor(s)</span></strong></p>\r\n</td>\r\n<td style=\"width: 4.0cm; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Hormone(s)</span></strong></p>\r\n</td>\r\n<td style=\"width: 109.75pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Keratin (CAM5.2 or CK18)</span></strong></p>\r\n</td>\r\n<td style=\"width: 109.8pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Tumour variants</span></strong></p>\r\n</td>\r\n<td style=\"width: 120.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Hormone excess <span style=\"mso-no-proof: yes;\">syndrome<sup>c</sup></span></span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 25.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"7\" width=\"945\">\r\n<p class=\"TableText\"><strong>PIT1-lineage tumours</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"38\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 127.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"170\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Somatotroph</span></strong></p>\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 99.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"132\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">PIT1</span></p>\r\n</td>\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">GH, &alpha;&nbsp;subunit</span></p>\r\n</td>\r\n<td style=\"width: 109.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Perinuclear</span></p>\r\n</td>\r\n<td style=\"width: 109.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Densely granulated somatotroph tumour</span></p>\r\n</td>\r\n<td style=\"width: 120.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Florid acromegaly</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">GH</span></p>\r\n</td>\r\n<td style=\"width: 109.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Fibrous bodies (&gt;&nbsp;70%)</span></p>\r\n</td>\r\n<td style=\"width: 109.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Sparsely granulated somatotroph tumour</span></p>\r\n</td>\r\n<td style=\"width: 120.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Subtle acromegaly</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"38\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 127.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"170\">\r\n<p class=\"TableText\"><strong>Lactotroph</strong></p>\r\n<p class=\"TableText\"><strong>tumours</strong></p>\r\n</td>\r\n<td style=\"width: 99.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"132\">\r\n<p class=\"TableText\">PIT1, ER&alpha;</p>\r\n</td>\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\">PRL (paranuclear)</p>\r\n</td>\r\n<td style=\"width: 109.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\">Weak or negative</p>\r\n</td>\r\n<td style=\"width: 109.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\">Sparsely granulated lactotroph tumour</p>\r\n</td>\r\n<td style=\"width: 120.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\"><span style=\"mso-no-proof: yes;\">Hyperprolactinaemia<sup>d</sup></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\">PRL (diffuse cytoplasmic)</p>\r\n</td>\r\n<td style=\"width: 109.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\">Weak or negative</p>\r\n</td>\r\n<td style=\"width: 109.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\">Densely granulated lactotroph tumour</p>\r\n</td>\r\n<td style=\"width: 120.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\"><span style=\"mso-no-proof: yes;\">Hyperprolactinaemia<sup>d</sup></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 127.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Mammosomatotroph</span></strong></p>\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">tumour</span></strong></p>\r\n</td>\r\n<td style=\"width: 99.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"132\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">PIT1, ER&alpha;</span></p>\r\n</td>\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">GH (often predominant), PRL, &alpha;&nbsp;subunit</span></p>\r\n</td>\r\n<td style=\"width: 109.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Perinuclear</span></p>\r\n</td>\r\n<td style=\"width: 109.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: 'Times New Roman'; color: black; mso-color-alt: windowtext;\"><span style=\"mso-spacerun: yes;\">&nbsp;n/a</span></span></p>\r\n</td>\r\n<td style=\"width: 120.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Acromegaly and <span style=\"mso-no-proof: yes;\">hyperprolactinaemia<sup>d</sup></span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 127.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\"><strong>Thyrotroph</strong></p>\r\n<p class=\"TableText\"><strong>tumour</strong></p>\r\n</td>\r\n<td style=\"width: 99.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"132\">\r\n<p class=\"TableText\">PIT1, GATA2/<span style=\"mso-no-proof: yes;\">3<sup>b</sup></span></p>\r\n</td>\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\">&alpha;&nbsp;subunit, TSH-&beta;</p>\r\n</td>\r\n<td style=\"width: 109.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\">Weak or negative</p>\r\n</td>\r\n<td style=\"width: 109.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: 'Times New Roman';\"><span style=\"mso-spacerun: yes;\">&nbsp;n/a</span></span></p>\r\n</td>\r\n<td style=\"width: 120.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\">Hyperthyroidism</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 127.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Mature&nbsp;</span>plurihormonal&nbsp;<span>PIT1-lineage tumour</span></strong></p>\r\n</td>\r\n<td style=\"width: 99.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"132\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">PIT1, ER&alpha;, GATA2/<span style=\"mso-no-proof: yes;\">3<sup>b</sup></span></span></p>\r\n</td>\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">GH (often predominant), PRL, &alpha;&nbsp;subunit, TSH-&beta; </span></p>\r\n</td>\r\n<td style=\"width: 109.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Perinuclear</span></p>\r\n</td>\r\n<td style=\"width: 109.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"146\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: 'Times New Roman'; color: black; mso-color-alt: windowtext;\"><span style=\"mso-spacerun: yes;\">&nbsp;n/a</span></span></p>\r\n</td>\r\n<td style=\"width: 120.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p clas
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 113906,
        "bookId": 52,
        "chapterId": 72,
        "headingId": 590,
        "headingText": "\r\n<p>There are no reported recurrences. All types are cured by excision.</p>",
        "timestamp": "2023-09-26T14:09:45"
      }
    ],

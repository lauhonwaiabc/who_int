    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 113904,
        "bookId": 52,
        "chapterId": 72,
        "headingId": 591,
        "headingText": "\r\n<p><em>Essential:</em> a lipoma with benign salivary epithelial components.</p>\r\n",
        "timestamp": "2023-09-26T14:09:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

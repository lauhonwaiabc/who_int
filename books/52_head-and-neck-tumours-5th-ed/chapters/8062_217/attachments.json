    "fileId": 23550,
    "type": "Figure",
    "diagnosis": "Sinonasal alveolar rhabdomyosarcoma",
    "title": "",
    "legend": "The neoplastic cells are small with slightly cleared cytoplasm. They surround and entomb the native minor mucoserous glands.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/52/217/23550.jpg",

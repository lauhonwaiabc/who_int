    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 588,
    "contributions": [
      {
        "pkcontributionId": 115659,
        "bookId": 52,
        "chapterId": 213,
        "headingId": 588,
        "headingText": "<p >Not clinically relevant</p>",
        "timestamp": "2023-11-17T14:15:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 761,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 591,
    "contributions": [
      {
        "pkcontributionId": 115660,
        "bookId": 52,
        "chapterId": 213,
        "headingId": 591,
        "headingText": "<p><em>Essential:</em> a tumour with smooth muscle differentiation with very rare or absent mitoses and lacking nuclear atypia and necrosis; angioleiomyoma has a prominent vascular component.</p>",
        "timestamp": "2024-01-10T14:06:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 759,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 589,
    "contributions": [
      {
        "pkcontributionId": 115661,
        "bookId": 52,
        "chapterId": 213,
        "headingId": 589,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-10-02T11:05:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 115662,
        "bookId": 52,
        "chapterId": 213,
        "headingId": 590,
        "headingText": "<p>Leiomyomas and angioleiomyomas have an excellent prognosis.</p>",
        "timestamp": "2024-01-10T14:07:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

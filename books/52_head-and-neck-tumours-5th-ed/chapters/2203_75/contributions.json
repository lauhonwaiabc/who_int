        "timestamp": "2023-09-25T13:48:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 760,
    "bookid": 52,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 590,
    "contributions": [
      {
        "pkcontributionId": 113037,
        "bookId": 52,
        "chapterId": 75,
        "headingId": 590,
        "headingText": "<p >There have been no reports of recurrence after excision.</p>",
        "timestamp": "2023-10-02T12:43:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

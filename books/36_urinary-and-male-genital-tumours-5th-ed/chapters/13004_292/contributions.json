        "bookId": 36,
        "chapterId": 292,
        "headingId": 541,
        "headingText": "\r\n<p>2E06 Malignant neoplasm metastasis in male genital organs</p>\r\n",
        "timestamp": "2022-02-25T17:20:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 503,

[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 71502,
        "bookId": 36,
        "chapterId": 292,
        "headingId": 539,
        "headingText": "\r\n<p>Metastases to the testis and paratestis are tumours that involve the testis or paratestis via a haematogenous or lymphatic pathway but that do not originate from these structures.</p>\r\n",
        "timestamp": "2022-02-25T17:20:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,
    "headingType": 2,

  },
  {
    "pkheadingid": 506,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 545,
    "contributions": [
      {
        "pkcontributionId": 70499,
        "bookId": 36,
        "chapterId": 154,
        "headingId": 545,
        "headingText": "\r\n<p>Painless testicular enlargement is the most common presenting symptom. Gynaecomastia has been reported in 10% of the cases.</p>\r\n",
        "timestamp": "2022-02-22T11:55:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 507,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 546,
    "contributions": [
      {
        "pkcontributionId": 70500,
        "bookId": 36,
        "chapterId": 154,
        "headingId": 546,
        "headingText": "\r\n<p>The tumours can occur in patients of any age, but they typically arise in middle-aged or elderly men. One&nbsp;third of cases occur in children {9025845}.</p>\r\n",
        "timestamp": "2022-02-22T11:55:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

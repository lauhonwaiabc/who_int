        "pkcontributionId": 70493,
        "bookId": 36,
        "chapterId": 154,
        "headingId": 539,
        "headingText": "\r\n<p>Mixed sex cord stromal tumours consist of various combinations of sex cord elements with differentiation towards Leydig, Sertoli, or granulosa cells admixed with stromal spindle cells.</p>\r\n",
        "timestamp": "2022-02-22T11:55:49"
      }

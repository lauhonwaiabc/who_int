  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70507,
        "bookId": 36,
        "chapterId": 154,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> combinations of sex cord elements admixed with spindle stromal cells.</p>\r\n<p><em>Desirable:</em> positive immunohistochemistry for SMA and S100 in selected cases.</p>\r\n",
        "timestamp": "2022-02-22T11:55:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,

  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70731,
        "bookId": 36,
        "chapterId": 172,
        "headingId": 553,
        "headingText": "\r\n<p>All reported cases have behaved in a benign fashion.</p>",

  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70729,
        "bookId": 36,
        "chapterId": 172,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> rete epicentre; multicystic and/or solid lesion with dilated glands, papillae, and/or tubules; fibrous stroma; bland nuclei.</p>\r\n",
        "timestamp": "2022-02-22T15:37:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

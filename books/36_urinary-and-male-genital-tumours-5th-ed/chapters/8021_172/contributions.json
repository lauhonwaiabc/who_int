        "bookId": 36,
        "chapterId": 172,
        "headingId": 540,
        "headingText": "\r\n<p>8140/0 Adenoma</p>\r\n",
        "timestamp": "2022-02-22T15:37:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 541,
    "contributions": [
      {
        "pkcontributionId": 70717,
        "bookId": 36,
        "chapterId": 172,
        "headingId": 541,
        "headingText": "\r\n<p>2F34 &amp; XH3DV3 Benign neoplasm of male genital organs &amp; Adenoma, NOS</p>\r\n",
        "timestamp": "2022-02-22T15:37:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 503,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 542,
    "contributions": [
      {
        "pkcontributionId": 70718,
        "bookId": 36,
        "chapterId": 172,
        "headingId": 542,
        "headingText": "\r\n<p><em>Acceptable:</em> cystadenoma; papillary cystadenoma; adenofibroma.</p>\r\n",
        "timestamp": "2022-02-22T15:37:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70715,
        "bookId": 36,
        "chapterId": 172,
        "headingId": 539,
        "headingText": "\r\n<p>Adenoma of the collecting ducts and rete testis is a benign, often cystic neoplasm of the rete epithelium characterized by tubular, papillary, and/or fibrous elements.</p>\r\n",
        "timestamp": "2022-02-22T15:37:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,
    "headingType": 2,

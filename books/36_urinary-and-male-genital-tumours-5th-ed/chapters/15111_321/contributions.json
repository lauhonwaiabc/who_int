    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 69999,
        "bookId": 36,
        "chapterId": 321,
        "headingId": 539,
        "headingText": "\r\n<p>Cystadenoma of the seminal vesicle is a rare benign epithelial tumour composed of variably sized cysts lined by bland cuboidal cells.</p>\r\n",
        "timestamp": "2022-02-11T10:12:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

      {
        "pkcontributionId": 70052,
        "bookId": 36,
        "chapterId": 327,
        "headingId": 541,
        "headingText": "\r\n<p>2F34 &amp; XH0533 Benign neoplasm of male genital organs &amp; Mixed epithelial and stromal tumour</p>\r\n",
        "timestamp": "2022-02-11T10:17:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 503,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 542,
    "contributions": [
      {
        "pkcontributionId": 70053,
        "bookId": 36,
        "chapterId": 327,
        "headingId": 542,
        "headingText": "\r\n<p><em>Not recommended:</em> cystic epithelial-stromal tumour; fibroadenoma; adenomyoma; mesonephric hamartoma; M&uuml;llerian adenosarcoma&ndash;like tumour; phyllodes tumour; cystosarcoma phyllodes.</p>\r\n",
        "timestamp": "2022-02-11T10:17:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

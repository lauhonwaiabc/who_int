    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70050,
        "bookId": 36,
        "chapterId": 327,
        "headingId": 539,
        "headingText": "\r\n<p>Mixed epithelial and stromal tumours (MESTs) of the seminal vesicles are biphasic tumours with stromal and benign epithelial components.</p>\r\n",
        "timestamp": "2022-02-11T10:17:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,

  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70066,
        "bookId": 36,
        "chapterId": 327,
        "headingId": 553,
        "headingText": "<p >Occasional patients with MEST have been reported to develop local recurrence or metastasis {12445241; 8382998; 3030148}.</p>",
        "timestamp": "2022-04-14T15:52:42"
      }

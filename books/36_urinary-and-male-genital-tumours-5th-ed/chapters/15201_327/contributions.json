  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70064,
        "bookId": 36,
        "chapterId": 327,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> origin in the seminal vesicle; biphasic tumour with both epithelial cells and spindled stromal cells; exclusion of stromal tumours and sarcomas of the prostate incorporating epithelial elements.</p>\r\n<p><em>Desirable:</em> stromal cells positive for ER and PR.</p>\r\n",
        "timestamp": "2022-02-11T10:17:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

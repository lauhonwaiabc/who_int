        "chapterId": 6,
        "headingId": 551,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2022-02-09T17:52:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 68871,
        "bookId": 36,
        "chapterId": 6,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> size &le;&nbsp;15&nbsp;mm; papillary, tubular, or tubulopapillary architecture; absence of a fibrous capsule; low histological grade (grade&nbsp;1&ndash;2).</p>\r\n",
        "timestamp": "2022-02-09T17:52:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 552,
    "contributions": [
      {
        "pkcontributionId": 68872,
        "bookId": 36,
        "chapterId": 6,
        "headingId": 552,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2022-02-09T17:52:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 68873,
        "bookId": 36,
        "chapterId": 6,
        "headingId": 553,
        "headingText": "\r\n<p>Until 2015, renal adenomas were defined as tumours measuring &le;&nbsp;5&nbsp;mm. The decision to increase the size cut-off point of papillary adenomas to 15&nbsp;mm was based on evidence that unencapsulated low-grade (grade&nbsp;1&ndash;2) tumours of this size have virtually no capacity to metastasize {21783319}. The presence of papillary adenoma in a donor kidney is not a contraindication for renal transplantation {25055966}.</p>",
        "timestamp": "2022-02-09T17:52:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
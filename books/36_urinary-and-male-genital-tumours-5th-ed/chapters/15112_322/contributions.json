  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70030,
        "bookId": 36,
        "chapterId": 322,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> seminal vesicle location (or for large tumours, seminal vesicle epicentre); adenocarcinoma, often with papillary-glandular and trabecular growth patterns; exclusion of metastasis and local spread clinically and pathologically; supportive immunohistochemistry (see above).</p>\r\n",
        "timestamp": "2022-02-11T10:13:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 552,

    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70016,
        "bookId": 36,
        "chapterId": 322,
        "headingId": 539,
        "headingText": "\r\n<p>Adenocarcinomas of the seminal vesicle are malignant gland-forming tumours originating from seminal vesicle epithelium. Diagnosis requires clinicopathological exclusion of secondary carcinomas.</p>\r\n",
        "timestamp": "2022-02-11T10:13:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

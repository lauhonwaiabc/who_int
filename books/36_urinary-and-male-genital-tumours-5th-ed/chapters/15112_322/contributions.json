        "timestamp": "2022-02-11T10:13:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70032,
        "bookId": 36,
        "chapterId": 322,
        "headingId": 553,
        "headingText": "\r\n<p>The prognosis is poor, with survival usually &lt;&nbsp;3&nbsp;years from diagnosis {29550197}. Complete surgical resection together with chemotherapy can occasionally offer a cure {31852695; 22723505; 29021144; 24113594; 30313047}. Penile and lung metastases have been reported {17445672}. Some tumours may be responsive to adjuvant hormone treatments {6471181; 12394673; 24113594; 3188318}. Serum CA125 level may be a useful biomarker for disease recurrence.</p>",
        "timestamp": "2022-02-11T10:13:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
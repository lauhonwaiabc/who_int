      {
        "pkcontributionId": 70834,
        "bookId": 36,
        "chapterId": 184,
        "headingId": 539,
        "headingText": "\r\n<p>Adenocarcinoma of the epididymis is a primary malignant epithelial neoplasm with glandular differentiation.</p>\r\n",
        "timestamp": "2022-02-22T15:42:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

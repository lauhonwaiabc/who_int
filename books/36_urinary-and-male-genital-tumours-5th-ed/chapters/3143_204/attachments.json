  {
    "pkattachmentId": 38943,
    "bookid": 36,
    "chapterId": 204,
    "fileId": 24565,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Summary features of eosinophilic vacuolated tumour and low-grade oncocytic tumour</p>",
    "legend": "",
    "source": "Anthony J. Gill",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 20.0%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><strong>Name</strong></p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><strong>Clinical features</strong></p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><strong>Morphology</strong></p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><strong>Immunohistochemistry</strong></p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><strong>Molecular pathology</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 20.0%; border: none; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><strong>Eosinophilic vacuolated tumour (also termed &ldquo;high-grade oncocytic tumour&rdquo; or &ldquo;sporadic RCC with eosinophilic and vacuolated cytoplasm&rdquo;)</strong></p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">M:F&nbsp;ratio: 1:2.5</p>\r\n<p class=\"TableText\">Wide age range (median: 54&nbsp;years)</p>\r\n<p class=\"TableText\">Rare in patients with tuberous sclerosis</p>\r\n<p class=\"TableText\">Typically small, tan to mahogany brown</p>\r\n<p class=\"TableText\">Indolent behaviour</p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">Solid growth</p>\r\n<p class=\"TableText\">Entrapped renal tubules</p>\r\n<p class=\"TableText\">Large vessels at periphery</p>\r\n<p class=\"TableText\">Eosinophilic (oncocytic) cells with frequent large cytoplasmic vacuoles and prominent nucleoli</p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">Positive: cathepsin&nbsp;K, KIT (CD117), CD10</p>\r\n<p class=\"TableText\">Negative: CK20, CK7 (except rare cells), HMB45, melan-A, TFE3</p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><em>TSC1</em>, <em>TSC2</em>, or <em>MTOR</em> mutations (limited data)</p>\r\n<p class=\"TableText\">Loss of chromosomes&nbsp;19 and&nbsp;1 (limited data)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 20.0%; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><strong>Low-grade oncocytic tumour</strong></p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">Older patients</p>\r\n<p class=\"TableText\">Solitary</p>\r\n<p class=\"TableText\">Mostly non-syndromic</p>\r\n<p class=\"TableText\">Rare in patients with tuberous sclerosis</p>\r\n<p class=\"TableText\">Small, tan to brown</p>\r\n<p class=\"TableText\">Indolent behaviour</p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">Solid growth, eosinophilic (oncocytic) cells, bland (low-grade) nuclei lacking prominent nucleoli or nuclear irregularity. Sharply delineated loose stromal areas with scattered cells</p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">Positive: CK7 (diffuse and strong)</p>\r\n<p class=\"TableText\">Negative: KIT (CD117), CK20, vimentin</p>\r\n</td>\r\n<td style=\"width: 20.0%; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: .75pt 5.4pt .75pt 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">Sometimes <em>TSC1</em>, <em>TSC2</em>, or <em>MTOR</em> mutations (limited data)</p>\r\n<p class=\"TableText\">Generally diploid, sometimes deletions of chromosomes&nbsp;19p, 19q, and&nbsp;1p (limited data)</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p>&nbsp;</p>\r\n<p class=\"TableText\">RCC, renal cell carcinoma.</p>",
    "imageUrl": null,
    "thumbnail": null
  }
]
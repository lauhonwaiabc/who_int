[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 71485,
        "bookId": 36,
        "chapterId": 290,
        "headingId": 539,
        "headingText": "\r\n<p>Metastatic tumours of the kidney are epithelial or mesenchymal malignancies that have arisen from another site and spread to the kidney.</p>\r\n",
        "timestamp": "2022-02-25T17:19:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,

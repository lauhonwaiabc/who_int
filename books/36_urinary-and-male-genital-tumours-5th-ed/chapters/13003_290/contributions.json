        "chapterId": 290,
        "headingId": 540,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2022-02-25T17:19:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 541,
    "contributions": [
      {
        "pkcontributionId": 71487,
        "bookId": 36,
        "chapterId": 290,
        "headingId": 541,
        "headingText": "\r\n<p>2E00 Malignant neoplasm metastasis in kidney or renal pelvis</p>\r\n",
        "timestamp": "2022-02-25T17:19:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 503,

        "headingId": 540,
        "headingText": "\r\n<p>8140/3 Adenocarcinoma</p>\r\n",
        "timestamp": "2022-02-22T15:38:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",

        "headingId": 551,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2022-02-22T15:38:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70746,
        "bookId": 36,
        "chapterId": 173,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> a tumour centred in the testicular hilum; exclusion of other testicular or paratesticular tumours; exclusion of metastases.</p>\r\n<p><em>Desirable:</em> evidence of transition from normal to neoplastic rete epithelium.</p>\r\n",
        "timestamp": "2022-02-22T15:38:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 552,
    "contributions": [
      {
        "pkcontributionId": 70747,
        "bookId": 36,
        "chapterId": 173,
        "headingId": 552,
        "headingText": "\r\n<p>There is no American Joint Committee on Cancer (AJCC) staging system for these tumours.</p>\r\n",
        "timestamp": "2022-02-22T15:38:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70748,
        "bookId": 36,
        "chapterId": 173,
        "headingId": 553,
        "headingText": "\r\n<p>These tumours have a poor prognosis, with a 5-year survival rate of approximately 15% {30676333; 3287961; 24409217}. Tumour diameter &gt;&nbsp;50&nbsp;mm at presentation is a poor prognostic factor {7571213}.</p>",
        "timestamp": "2022-02-22T15:38:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70732,
        "bookId": 36,
        "chapterId": 173,
        "headingId": 539,
        "headingText": "\r\n<p>Adenocarcinoma of the collecting ducts and rete testis is a malignant gland-forming tumour originating in the rete epithelium.</p>\r\n",
        "timestamp": "2022-02-22T15:38:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

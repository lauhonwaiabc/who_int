    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70510,
        "bookId": 36,
        "chapterId": 133,
        "headingId": 539,
        "headingText": "\r\n<p>Signet ring stromal tumours of the testis are solid tumours containing signet-ring cells and showing morphological similarities to their ovarian counterparts and to solid pseudopapillary neoplasia of the pancreas. Some authors consider this tumour to be a morphological pattern of Sertoli cell tumour.</p>\r\n",
        "timestamp": "2022-02-22T11:56:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

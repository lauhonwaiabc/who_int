        "headingId": 552,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2022-02-22T11:56:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70526,
        "bookId": 36,
        "chapterId": 133,
        "headingId": 553,
        "headingText": "\r\n<p>So far, all reported cases have behaved in a benign fashion {18835626; 30549139}.</p>",
        "timestamp": "2022-02-22T11:56:28"
      }
    ],

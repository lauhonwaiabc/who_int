[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70630,
        "bookId": 36,
        "chapterId": 164,
        "headingId": 539,
        "headingText": "\r\n<p>Mucinous borderline tumour is a non-invasive neoplasm with gastrointestinal-type or endocervical-type epithelium, characterized by complex architecture and cytological atypia.</p>\r\n",
        "timestamp": "2022-02-22T15:34:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,

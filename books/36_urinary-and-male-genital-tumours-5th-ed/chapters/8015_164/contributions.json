        "bookId": 36,
        "chapterId": 164,
        "headingId": 540,
        "headingText": "\r\n<p>8472/1 Mucinous borderline tumour</p>\r\n",
        "timestamp": "2022-02-22T15:34:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 541,
    "contributions": [
      {
        "pkcontributionId": 70632,
        "bookId": 36,
        "chapterId": 164,
        "headingId": 541,
        "headingText": "\r\n<p>2F77 &amp; XH2FF0 Neoplasm of uncertain behaviour of male genital organs &amp; Mucinous cystic tumour of borderline malignancy</p>\r\n",
        "timestamp": "2022-02-22T15:34:23"
      }
    ],

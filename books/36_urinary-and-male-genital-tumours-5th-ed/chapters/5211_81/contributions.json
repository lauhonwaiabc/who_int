[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 69623,
        "bookId": 36,
        "chapterId": 81,
        "headingId": 539,
        "headingText": "\r\n<p>Verrucous carcinoma is a subtype of exophytic squamous cell carcinoma with multiple filiform projections covered by well-differentiated squamous epithelium, with an invasive front with a pushing margin.</p>\r\n",
        "timestamp": "2022-02-10T18:54:51"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

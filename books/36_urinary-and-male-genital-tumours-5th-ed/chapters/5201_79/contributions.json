        "headingId": 540,
        "headingText": "\r\n<p>8052/0 Squamous papilloma</p>\r\n",
        "timestamp": "2022-02-10T18:51:57"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

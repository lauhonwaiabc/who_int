    "tablehtml": "<table class=\"MsoNormalTable\" style=\"background: #DAEEF3; border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 3.0pt;\">\r\n<td style=\"width: 32.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.0pt;\" valign=\"top\" width=\"43\">\r\n<p class=\"TableText\">I</p>\r\n</td>\r\n<td style=\"width: 223.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.0pt;\" colspan=\"2\" valign=\"top\" width=\"297\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Carcinoma confined to the urachal mucosa</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.6pt;\">\r\n<td style=\"width: 32.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.6pt;\" valign=\"top\" width=\"43\">\r\n<p class=\"TableText\"><span style=\"color: black; \">II</span></p>\r\n</td>\r\n<td style=\"width: 223.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.6pt;\" colspan=\"2\" valign=\"top\" width=\"297\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Carcinoma confined to the urachus</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 13.05pt;\">\r\n<td style=\"width: 32.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.05pt;\" valign=\"top\" width=\"43\">\r\n<p class=\"TableText\"><span style=\"color: black; \">III</span></p>\r\n</td>\r\n<td style=\"width: 223.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.05pt;\" colspan=\"2\" valign=\"top\" width=\"297\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Local carcinoma extension</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 13.05pt;\">\r\n<td style=\"width: 32.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.05pt;\" valign=\"top\" width=\"43\">\r\n<p class=\"TableText\"><span style=\"color: black; \">IIIA</span></p>\r\n</td>\r\n<td style=\"width: 24.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.05pt;\" valign=\"top\" width=\"33\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 7.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.05pt;\" valign=\"top\" width=\"265\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Into the bladder</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.6pt;\">\r\n<td style=\"width: 32.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.6pt;\" valign=\"top\" width=\"43\">\r\n<p class=\"TableText\"><span style=\"color: black; \">IIIB</span></p>\r\n</td>\r\n<td style=\"width: 24.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.6pt;\" valign=\"top\" width=\"33\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 7.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.6pt;\" valign=\"top\" width=\"265\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Into the abdominal wall</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 13.05pt;\">\r\n<td style=\"width: 32.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.05pt;\" valign=\"top\" width=\"43\">\r\n<p class=\"TableText\"><span style=\"color: black; \">IIIC</span></p>\r\n</td>\r\n<td style=\"width: 24.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.05pt;\" valign=\"top\" width=\"33\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 7.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.05pt;\" valign=\"top\" width=\"265\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Into the peritoneum</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 13.05pt;\">\r\n<td style=\"width: 32.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.05pt;\" valign=\"top\" width=\"43\">\r\n<p class=\"TableText\"><span style=\"color: black; \">IIID</span></p>\r\n</td>\r\n<td style=\"width: 24.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.05pt;\" valign=\"top\" width=\
        "pkcontributionId": 70551,
        "bookId": 36,
        "chapterId": 155,
        "headingId": 546,
        "headingText": "\r\n<p>About 50% of sex cord stromal tumours NOS occur in children; the remainder occur in men of any age.</p>\r\n",
        "timestamp": "2022-02-22T11:59:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

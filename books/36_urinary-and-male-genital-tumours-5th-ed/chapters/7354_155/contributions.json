  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70558,
        "bookId": 36,
        "chapterId": 155,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> a tumour with incomplete or undifferentiated sex cord stromal elements; specific sex cord stromal tumours should be excluded.</p>\r\n<p><em>Desirable:</em> immunoreactivity for the markers described above, in selected cases.</p>\r\n",
        "timestamp": "2022-02-22T11:59:41"
      }
    ],

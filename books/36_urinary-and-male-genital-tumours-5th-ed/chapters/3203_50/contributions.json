        "chapterId": 50,
        "headingId": 552,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2022-02-10T16:44:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 69230,
        "bookId": 36,
        "chapterId": 50,
        "headingId": 553,
        "headingText": "<p >Metanephric stromal tumours are benign. Rare patients have experienced haemorrhage from extrarenal angiodysplasia apparently induced by metanephric stromal tumour {10895814}.</p>",
        "timestamp": "2022-04-26T15:33:10"
      }
    ],

[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 69197,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 539,
        "headingText": "\r\n<p>Metanephric adenofibroma is a rare biphasic neoplasm that combines a spindle cell component that is morphologically identical to metanephric stromal tumour with an epithelial component that is morphologically identical to metanephric adenoma.</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 540,
    "contributions": [
      {
        "pkcontributionId": 69198,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 540,
        "headingText": "\r\n<p>9013/0 Metanephric adenofibroma</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 541,
    "contributions": [
      {
        "pkcontributionId": 69199,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 541,
        "headingText": "\r\n<p>2F35 &amp; XH7ZU2 Benign neoplasm of urinary organs &amp; Metanephric adenofibroma</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 503,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 542,
    "contributions": [
      {
        "pkcontributionId": 69200,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 542,
        "headingText": "\r\n<p><em>Not recommended:</em> nephrogenic adenofibroma.</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 504,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 543,
    "contributions": [
      {
        "pkcontributionId": 69201,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 543,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 505,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 544,
    "contributions": [
      {
        "pkcontributionId": 69202,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 544,
        "headingText": "\r\n<p>Metanephric adenofibromas arise in the kidney.</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 506,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 545,
    "contributions": [
      {
        "pkcontributionId": 69203,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 545,
        "headingText": "\r\n<p>Patients with metanephric adenofibroma have presented with polycythaemia (in 4&nbsp;of 14&nbsp;cases) or haematuria (in 3&nbsp;of 14&nbsp;cases) {11257617; 1373578; 23587517; 20735912}.</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 507,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 546,
    "contributions": [
      {
        "pkcontributionId": 69204,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 546,
        "headingText": "\r\n<p>Fewer than 30&nbsp;cases have been reported. Patient age ranges from 13&nbsp;months to 36&nbsp;years (median: 6.8&nbsp;years) {11257617; 1373578}.</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 508,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 547,
    "contributions": [
      {
        "pkcontributionId": 69205,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 547,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 509,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 548,
    "contributions": [
      {
        "pkcontributionId": 69206,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 548,
        "headingText": "\r\n<p><em>BRAF</em> p.V600E mutations have been present in all cases tested to date.</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 516,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 555,
    "contributions": [
      {
        "pkcontributionId": 69207,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 555,
        "headingText": "\r\n<p>Metanephric adenofibromas are typically solitary, tan, partially cystic masses with indistinct borders. The mean diameter is 40&nbsp;mm. Many of these lesions have been centred in the renal pelvis, accounting for the presentation with haematuria.</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 510,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 549,
    "contributions": [
      {
        "pkcontributionId": 69208,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 549,
        "headingText": "\r\n<p>The relative amounts of the spindle cell and epithelial components vary. The border of the tumour with the kidney is typically irregular and the spindle cell component entraps tubules and glomeruli. The stroma of metanephric adenofibroma frequently labels for CD34, like that of metanephric stromal tumour. The epithelial elements label similarly to those in metanephric adenoma.</p>\r\n<p>Composite cases have been reported in which epithelial mitotic activity, nephroblastoma, or papillary renal cell carcinoma are associated with metanephric adenofibroma {11257617; 21711207}.</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 511,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 550,
    "contributions": [
      {
        "pkcontributionId": 69209,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 550,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 512,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 551,
    "contributions": [
      {
        "pkcontributionId": 69210,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 551,
        "headingText": "\r\n<p>All metanephric adenofibromas tested to date have harboured <em>BRAF</em> p.V600E mutations that are characteristic of the other metanephric neoplasms, metanephric stromal tumour, and metanephric adenoma {26796506; 26274032}. One composite metanephric adenofibroma&ndash;papillary renal cell carcinoma had the same <em>BRAF</em> p.V600E mutation in both the adenoma and carcinoma components {26014474}.</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 69211,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> a biphasic neoplasm with features of both metanephric stromal tumour and metanephric adenoma.</p>\r\n<p><em>Desirable:</em> <em>BRAF</em> p.V600E mutations.</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 552,
    "contributions": [
      {
        "pkcontributionId": 69212,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 552,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 69213,
        "bookId": 36,
        "chapterId": 49,
        "headingId": 553,
        "headingText": "\r\n<p>Uncomplicated metanephric adenofibroma is benign. The vast majority of patients with composite tumours having an aggressive component (nephroblastoma or papillary renal cell carcinoma) have presented with low-stage disease and have been cured by surgery alone {11257617}.</p>",
        "timestamp": "2022-02-10T16:42:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
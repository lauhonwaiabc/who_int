    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; border: none; \" border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 92.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"123\">\r\n<p class=\"TableText\"><strong>Site</strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; \">Cancer risk</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 92.15pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"123\">\r\n<p class=\"TableText\"><strong>Colorectum</strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">39%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 92.15pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"123\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Small intestine</span></strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">13%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 92.15pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"123\">\r\n<p class=\"TableText\"><strong>Stomach</strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">29%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 92.15pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"123\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Pancreas</span></strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">11&ndash;36%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 92.15pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"123\">\r\n<p class=\"TableText\"><strong>Breast</strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">32&ndash;54%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 92.15pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"123\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Uterus</span></strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">9%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 92.15pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"123\">\r\n<p class=\"TableText\"><strong>Ovary</strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">21%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 92.15pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"123\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Cervix</span></strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">10%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 92.15pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"123\">\r\n<p class=\"TableText\"><strong>Testis</strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">9%</p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 92.15pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"123\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Lung</span></strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">7&ndash;17%</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

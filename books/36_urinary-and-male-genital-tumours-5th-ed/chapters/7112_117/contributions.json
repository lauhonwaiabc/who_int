      {
        "pkcontributionId": 70085,
        "bookId": 36,
        "chapterId": 117,
        "headingId": 539,
        "headingText": "\r\n<p>These are intratubular forms of germ cell neoplasia other than germ cell neoplasia in&nbsp;situ (GCNIS).</p>\r\n",
        "timestamp": "2022-02-22T11:26:13"
      }
    ],
    "booknotes": [],

        "chapterId": 277,
        "headingId": 540,
        "headingText": "\r\n<p>9680/3 Diffuse large B-cell lymphoma, NOS</p>\r\n",
        "timestamp": "2022-02-25T16:59:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 541,
    "contributions": [
      {
        "pkcontributionId": 71401,
        "bookId": 36,
        "chapterId": 277,
        "headingId": 541,
        "headingText": "\r\n<p>2A81.Z Diffuse large B-cell lymphoma, NOS</p>\r\n",
        "timestamp": "2022-02-25T16:59:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 503,
    "bookid": 36,

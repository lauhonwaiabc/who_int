[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 71228,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 539,
        "headingText": "\r\n<p>Myointimoma is a distinctive intravascular myoepithelial proliferation occurring within the corpus spongiosum of the glans penis.</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 540,
    "contributions": [
      {
        "pkcontributionId": 71229,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 540,
        "headingText": "\r\n<p>9137/0 Myointimoma</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 541,
    "contributions": [
      {
        "pkcontributionId": 71230,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 541,
        "headingText": "\r\n<p>2F34 &amp; XH37N4 Benign neoplasm of male genital organs &amp; Myointimoma</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 503,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 542,
    "contributions": [
      {
        "pkcontributionId": 71231,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 542,
        "headingText": "\r\n<p><em>Not recommended:</em> penile myointimoma; penile intravascular leiomyoma; intravascular leiomyomatosis; leiomyoma of the glans penis; intravascular fasciitis solitary cutaneous myofibroma; benign perivascular myoid cell tumour; myofibroma of the glans penis.</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 504,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 543,
    "contributions": [
      {
        "pkcontributionId": 71232,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 543,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 505,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 544,
    "contributions": [
      {
        "pkcontributionId": 71233,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 544,
        "headingText": "\r\n<p>Myointimoma occurs within the corpus spongiosum of the glans penis {11075854; 17895766}. Occasionally it may be detected in the corona sulcus or in close proximity to the urethral meatus {11075854}.</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 506,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 545,
    "contributions": [
      {
        "pkcontributionId": 71234,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 545,
        "headingText": "\r\n<p>Patients with myointimoma usually present with a painless and otherwise asymptomatic nodule within the glans penis {11075854; 17895766}.</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 507,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 546,
    "contributions": [
      {
        "pkcontributionId": 71235,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 546,
        "headingText": "\r\n<p>Myointimoma has been documented mainly in boys and less frequently in men {11075854; 17895766; 16310076; 17295649}.</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 508,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 547,
    "contributions": [
      {
        "pkcontributionId": 71236,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 547,
        "headingText": "\r\n<p>The etiology of myointimoma is unknown. All cases have been sporadic, and no familial predisposition has been confirmed.</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 509,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 548,
    "contributions": [
      {
        "pkcontributionId": 71237,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 548,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 516,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 555,
    "contributions": [
      {
        "pkcontributionId": 71238,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 555,
        "headingText": "\r\n<p>The size of myointimomas ranges from 4&nbsp;to 18&nbsp;mm. The usual appearance is a firm mass with a beige or white colour {11075854; 17895766; 16310076; 17295649}.</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 510,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 549,
    "contributions": [
      {
        "pkcontributionId": 71239,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 549,
        "headingText": "\r\n<p>Myointimoma is arranged in a plexiform pattern, which is due to its extension within the pre-existing vascular spaces of the spongiosum of the glans penis {11075854; 17895766}. Neoplastic cells are spindled or stellate with long cytoplasmic processes, and they are surrounded by abundant fibromyxoid matrix. The cytoplasm is eosinophilic and may rarely contain intracytoplasmic vacuoles. The nuclei are small and lack any mitotic activity. Neoplastic cells are positive for SMA and calponin; desmin is positive only focally {11075854; 17895766}.</p>\r\n<p>The differential diagnosis includes myofibroma, leiomyoma, myopericytoma, late-fibrous-stage intravascular fasciitis, plexiform fibrohistiocytic tumour, epithelioid haemangioendothelioma, nerve sheath myxoma, and plexiform schwannoma.</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 511,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 550,
    "contributions": [
      {
        "pkcontributionId": 71240,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 550,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 512,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 551,
    "contributions": [
      {
        "pkcontributionId": 71241,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 551,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 71242,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> homogeneous plexiform myofibroblastic proliferation within the vascular spaces of the corpus spongiosum.</p>\r\n<p><em>Desirable:</em> SMA positivity.</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 552,
    "contributions": [
      {
        "pkcontributionId": 71243,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 552,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 71244,
        "bookId": 36,
        "chapterId": 248,
        "headingId": 553,
        "headingText": "\r\n<p>Myointimomas are benign lesions, and complete surgical resection is curative. They do not recur or metastasize {11075854; 17895766}.</p>",
        "timestamp": "2022-02-25T14:51:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
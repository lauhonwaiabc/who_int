[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70476,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 539,
        "headingText": "\r\n<p>Tumours of the fibroma thecoma group are composed of fibroblastic cells and of cells resembling theca cells.</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 540,
    "contributions": [
      {
        "pkcontributionId": 70477,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 540,
        "headingText": "\r\n<p>8600/0 Thecoma</p>\r\n<p>8810/0 Fibroma</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 541,
    "contributions": [
      {
        "pkcontributionId": 70478,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 541,
        "headingText": "\r\n<p>2F34 &amp; XH34A0 Benign neoplasm of male genital organs &amp; Thecoma, NOS</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 503,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 542,
    "contributions": [
      {
        "pkcontributionId": 70479,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 542,
        "headingText": "\r\n<p><em>Acceptable:</em> fibrothecoma; thecofibroma.</p>\r\n<p><em>Not recommended:</em> fibroma of gonadal stromal origin; sex cord stromal tumour of the testis with a predominance of spindle cells; fibroma; thecoma; theca cell tumour.</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 504,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 543,
    "contributions": [
      {
        "pkcontributionId": 70480,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 543,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 505,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 544,
    "contributions": [
      {
        "pkcontributionId": 70481,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 544,
        "headingText": "\r\n<p>Testis or paratesticular</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 506,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 545,
    "contributions": [
      {
        "pkcontributionId": 70482,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 545,
        "headingText": "\r\n<p>Patients present with a testicular mass, or the tumour is identified incidentally on ultrasound.</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 507,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 546,
    "contributions": [
      {
        "pkcontributionId": 70483,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 546,
        "headingText": "\r\n<p>Tumours of the fibroma thecoma group are rare. Patients are aged between 16 and 69&nbsp;years {23715159; 12031091; 33102067}.</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 508,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 547,
    "contributions": [
      {
        "pkcontributionId": 70484,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 547,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 509,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 548,
    "contributions": [
      {
        "pkcontributionId": 70485,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 548,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 516,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 555,
    "contributions": [
      {
        "pkcontributionId": 70486,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 555,
        "headingText": "\r\n<p>Tumour size ranges from 5&nbsp;to 76&nbsp;mm. Tumours appear as well-circumscribed tan-white or red lesions. Rare cases with haemorrhage and cystic changes have been reported {23715159; 12031091}.</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 510,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 549,
    "contributions": [
      {
        "pkcontributionId": 70487,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 549,
        "headingText": "\r\n<p>Tumours are relatively well circumscribed and can surround seminiferous tubules, particularly those in the periphery of the tumour. Various growth patterns (storiform, short fascicles, or both) have been described. The cellular content is also variable. Some reported cases were hypercellular, but cases with epithelioid areas or a looser background have also been described. The nuclei can be plump ovoid, or spindled. Mitotic activity is generally low {23715159}. Reticulin staining is seen around each of the tumour cells.</p>\r\n<p>Immunohistochemistry is not helpful in distinguishing fibrothecoma from other sex cord stromal tumours. Most fibrothecomas are positive for inhibin; some may show positivity for calretinin, melan-A, actin, or keratin {23715159; 12031091}.</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 511,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 550,
    "contributions": [
      {
        "pkcontributionId": 70488,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 550,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 512,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 551,
    "contributions": [
      {
        "pkcontributionId": 70489,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 551,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70490,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> a morphology resembling that of the more frequent ovarian counterparts of these tumours; Sertoli cell tumour and sex cord stromal tumour NOS must be excluded.</p>\r\n<p><em>Desirable:</em> inhibin positivity.</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 552,
    "contributions": [
      {
        "pkcontributionId": 70491,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 552,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70492,
        "bookId": 36,
        "chapterId": 152,
        "headingId": 553,
        "headingText": "\r\n<p>Tumours in the fibroma thecoma group are benign neoplasms {23715159}.</p>",
        "timestamp": "2022-02-22T11:54:24"
      }
    ],

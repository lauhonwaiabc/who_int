        "chapterId": 160,
        "headingId": 551,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2022-02-22T15:29:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70576,
        "bookId": 36,
        "chapterId": 160,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> cystic tumours lined by a single layer of ciliated columnar or cuboidal epithelium without atypia or mitotic figures.</p>\r\n<p><em>Desirable:</em> positive immunohistochemistry for ER, PR, WT1, and PAX8; negative immunohistochemistry for calretinin.</p>\r\n",
        "timestamp": "2022-02-22T15:29:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 552,
    "contributions": [
      {
        "pkcontributionId": 70577,
        "bookId": 36,
        "chapterId": 160,
        "headingId": 552,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2022-02-22T15:29:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70578,
        "bookId": 36,
        "chapterId": 160,
        "headingId": 553,
        "headingText": "\r\n<p>Serous cystadenomas are benign. Tumour resection is curative.</p>",
        "timestamp": "2022-02-22T15:29:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
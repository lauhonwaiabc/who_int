[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 69350,
        "bookId": 36,
        "chapterId": 38,
        "headingId": 539,
        "headingText": "\r\n<p>Ossifying renal tumour of infancy (ORTI) is an intracalyceal tumour composed of a combination of osteoid, osteoblastic, and spindle cells.</p>\r\n",
        "timestamp": "2022-02-10T17:08:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70800,
        "bookId": 36,
        "chapterId": 182,
        "headingId": 539,
        "headingText": "\r\n<p>Cystadenoma of the epididymis is a benign epithelial tumour that arises from epididymal ducts.</p>\r\n",
        "timestamp": "2022-02-22T15:42:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

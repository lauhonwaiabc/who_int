        "timestamp": "2022-02-22T15:42:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70816,
        "bookId": 36,
        "chapterId": 182,
        "headingId": 553,
        "headingText": "\r\n<p>Cystadenoma is a benign tumour, and surgical excision is curative {1225459}.</p>",
        "timestamp": "2022-02-22T15:42:09"
      }
    ],

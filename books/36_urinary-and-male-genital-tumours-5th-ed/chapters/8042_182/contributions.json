  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70814,
        "bookId": 36,
        "chapterId": 182,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> presence of tubules, papillae, and a cyst arising from the epididymis, lined by bland tall columnar epithelium; eosinophilic cytoplasm; absence of mitotic figures and features of malignancy.</p>\r\n<p><em>Desirable:</em> absence of cuboidal, clear cell morphology.</p>\r\n",
        "timestamp": "2022-02-22T15:42:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

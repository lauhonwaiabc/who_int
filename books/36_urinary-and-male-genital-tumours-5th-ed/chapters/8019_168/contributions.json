    "contributions": [
      {
        "pkcontributionId": 70699,
        "bookId": 36,
        "chapterId": 168,
        "headingId": 540,
        "headingText": "\r\n<p>9000/0 Brenner tumour</p>\r\n",
        "timestamp": "2022-02-22T15:36:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",

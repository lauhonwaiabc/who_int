[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70698,
        "bookId": 36,
        "chapterId": 168,
        "headingId": 539,
        "headingText": "\r\n<p>Brenner tumours are composed of urothelial-type cells within a dense fibromatous stroma. They show a range of features, from benign to borderline to malignant.</p>\r\n",
        "timestamp": "2022-02-22T15:36:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

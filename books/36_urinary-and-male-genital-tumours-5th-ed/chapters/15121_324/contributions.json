        "headingId": 540,
        "headingText": "\r\n<p>8070/3 Squamous cell carcinoma</p>\r\n",
        "timestamp": "2022-02-11T10:15:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

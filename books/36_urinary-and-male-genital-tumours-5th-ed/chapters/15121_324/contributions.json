    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70049,
        "bookId": 36,
        "chapterId": 324,
        "headingId": 553,
        "headingText": "\r\n<p>The prognosis is generally poor {30896622; 25812665; 26998295; 11972870; 23292510; 11880096}. In one patient, rectal metastasis occurred 7&nbsp;months after resection despite chemotherapy, leading to death {23292510}. Another patient developed pelvic metastasis 28&nbsp;months after surgery and died 6&nbsp;months later {26998295}.</p>",
        "timestamp": "2022-02-11T10:15:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
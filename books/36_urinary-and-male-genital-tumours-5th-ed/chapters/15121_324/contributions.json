[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70033,
        "bookId": 36,
        "chapterId": 324,
        "headingId": 539,
        "headingText": "\r\n<p>Primary squamous cell carcinoma of the seminal vesicle is a rare epithelial malignancy showing squamous differentiation in the absence of gland formation and mucin secretion.</p>\r\n",
        "timestamp": "2022-02-11T10:15:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

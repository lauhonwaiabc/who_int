[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70817,
        "bookId": 36,
        "chapterId": 183,
        "headingId": 539,
        "headingText": "\r\n<p>Papillary cystadenoma of the epididymis is a benign epithelial tumour with a papillary configuration and bland clear cells arising from the efferent epididymal ductules.</p>\r\n",
        "timestamp": "2022-02-22T15:42:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70442,
        "bookId": 36,
        "chapterId": 149,
        "headingId": 539,
        "headingText": "\r\n<p>Adult granulosa cell tumour is a neoplasm composed of sex cord cells that resemble the granulosa cells of the Graafian follicles of the ovary. These tumours have a histological spectrum similar to that of the much more common granulosa cell tumours of the ovary.</p>\r\n",
        "timestamp": "2022-02-22T11:52:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 540,
    "contributions": [
      {
        "pkcontributionId": 70443,
        "bookId": 36,
        "chapterId": 149,
        "headingId": 540,
        "headingText": "\r\n<p>8620/1 Adult granulosa cell tumour</p>\r\n",
        "timestamp": "2022-02-22T11:52:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 541,
    "contributions": [
      {
        "pkcontributionId": 70444,
        "bookId": 36,
        "chapterId": 149,
        "headingId": 541,
        "headingText": "\r\n<p>2F77 &amp; XH5BN5 Neoplasms of uncertain behaviour of male genital organs &amp; Adult granulosa cell tumour of testis</p>\r\n",
        "timestamp": "2022-02-22T11:52:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 503,

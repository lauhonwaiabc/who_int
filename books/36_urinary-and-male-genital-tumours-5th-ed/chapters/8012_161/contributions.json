[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70579,
        "bookId": 36,
        "chapterId": 161,
        "headingId": 539,
        "headingText": "<p>Serous tumour of borderline malignancy is a paratesticular or intratesticular non-invasive proliferative serous epithelial neoplasm with mild or moderate cytological atypia.</p>",
        "timestamp": "2022-04-15T17:41:36"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

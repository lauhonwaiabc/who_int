        "timestamp": "2022-02-10T16:33:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 512,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 551,
    "contributions": [
      {
        "pkcontributionId": 69159,
        "bookId": 36,
        "chapterId": 311,
        "headingId": 551,
        "headingText": "<p>Demonstration of <em>ALK</em> rearrangement is required in cases with positive ALK immunohistochemistry {32467651; 33729862}.</p>",
        "timestamp": "2022-04-26T14:43:51"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 69160,
        "bookId": 36,
        "chapterId": 311,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> documentation of <em>ALK</em> rearrangement by break-apart FISH, or demonstration of an <em>ALK</em> gene fusion by sequencing.</p>\r\n<p><em>Desirable:</em> sickle cell trait.</p>\r\n",
        "timestamp": "2022-02-10T16:33:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 552,
    "contributions": [
      {
        "pkcontributionId": 69161,
        "bookId": 36,
        "chapterId": 311,
        "headingId": 552,
        "headingText": "\r\n<p>Staging follows the same Union for International Cancer Control (UICC) or American Joint Committee on Cancer (AJCC) systems as used for other subtypes of RCC.</p>\r\n",
        "timestamp": "2022-02-10T16:33:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 69162,
        "bookId": 36,
        "chapterId": 311,
        "headingId": 553,
        "headingText": "\r\n<p>Follow-up of patients with <em>ALK</em>-rearranged RCC is limited. Twenty-two patients have had no evidence of disease in limited follow-up. Three patients have died of disease, and 10&nbsp;are alive with disease. Three patients with metastatic disease have had dramatic responses to a targeted ALK inhibitor, a non-toxic and potentially highly effective treatment for such patients {29685646}.</p>",
        "timestamp": "2022-02-10T16:33:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
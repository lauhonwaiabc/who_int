  },
  {
    "pkheadingid": 506,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 545,
    "contributions": [
      {
        "pkcontributionId": 69152,
        "bookId": 36,
        "chapterId": 311,
        "headingId": 545,
        "headingText": "<p>There have been approximately 50&nbsp;reported cases, with nearly equal sex distribution. The patients have been both children and adults (age range: 3&ndash;85&nbsp;years).</p>",
        "timestamp": "2022-04-26T14:40:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 507,

  {
    "pkattachmentId": 38929,
    "bookid": 36,
    "chapterId": 13,
    "fileId": 21185,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>WHO/International Society of Urological Pathology (ISUP) grading system for clear cell renal cell carcinoma</p>",
    "legend": "",
    "source": "",
    "copyright": "Reprinted with permission from Dagher J, Delahunt B, Rioux-Leclercq N, et al. Clear cell renal cell carcinoma: validation of World Health Organization/International Society of Urological Pathology grading. Histopathology. 2017;71(6):918-925. PMID: 28718911 ",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 701.7pt; border-collapse: collapse; border: none; \" border=\"1\" width=\"936\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 52.5pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"70\">\r\n<p class=\"TableText\"><strong>Grade</strong></p>\r\n</td>\r\n<td style=\"width: 649.2pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"866\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Description</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 52.5pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"70\">\r\n<p class=\"TableText\"><strong>Grade&nbsp;1</strong></p>\r\n</td>\r\n<td style=\"width: 649.2pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"866\">\r\n<p class=\"TableText\">Nucleoli absent or inconspicuous and basophilic at &times;400&nbsp;magnification</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 52.5pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"70\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Grade&nbsp;2</span></strong></p>\r\n</td>\r\n<td style=\"width: 649.2pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"866\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Eosinophilic nucleoli observed at &times;400 but not prominent at &times;100&nbsp;magnification</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 52.5pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"70\">\r\n<p class=\"TableText\"><strong>Grade&nbsp;3</strong></p>\r\n</td>\r\n<td style=\"width: 649.2pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"866\">\r\n<p class=\"TableText\">Nucleoli prominent and eosinophilic at &times;100&nbsp;magnification</p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 52.5pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"70\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Grade&nbsp;4</span></strong></p>\r\n</td>\r\n<td style=\"width: 649.2pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"866\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Carcinoma cells display extreme nuclear pleomorphism, tumour giant cells, and/or any amount of sarcomatoid or rhabdoid differentiation</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },
  {
    "pkattachmentId": 38930,
    "bookid": 36,
    "chapterId": 13,
    "fileId": 21188,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Differential diagnosis of clear cell renal cell carcinoma</p>",
    "legend": "",
    "source": "Sean R. Williamson",
    "copyright": "",
    "tablehtml": "<p>&nbsp;</p>\r\n<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; border: none; \" border=\"1\" width=\"104%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 30.0pt;\">\r\n<td style=\"width: 11.64%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 30.0pt;\" nowrap=\"nowrap\" width=\"11%\">\r\n<p class=\"TableText\"><strong>RCC type</strong></p>\r\n</td>\r\n<td style=\"width: 11.64%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 30.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; \">Morphology</span></strong></p>\r\n</td>\r\n<td style=\"width: 9.72%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 30.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; \">CAIX (CA9)</span></strong></p>\r\n</td>\r\n<td style=\"width: 9.96%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 30.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; \">CK7</span></strong></p>\r\n</td>\r\n<td style=\"width: 8.48%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 30.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; \">AMACR</span></strong></p>\r\n</td>\r\n<td style=\"width: 8.74%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 30.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; \">Vimentin</span></strong></p>\r\n</td>\r\n<td style=\"width: 7.76%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 30.0pt;\" width=\"7%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; \">KIT</span></strong></p>\r\n</td>\r\n<td style=\"width: 9.7%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 30.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; \">HMWCK/GATA3</span></strong></p>\r\n</td>\r\n<td style=\"width: 11.66%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 30.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; \">Melanocytic&nbsp;/ cathepsin&nbsp;K</span></strong></p>\r\n</td>\r\n<td style=\"width: 10.68%; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 30.0pt;\" width=\"10%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; \">Key genetics</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 90.0pt;\">\r\n<td style=\"width: 11.64%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" nowrap=\"nowrap\" width=\"11%\">\r\n<p class=\"TableText\"><strong>Clear cell</strong></p>\r\n</td>\r\n<td style=\"width: 11.64%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Nests/glands composed of cells with clear cytoplasm; variable cysts, scar, eosinophilic cells; prominent vascular network</p>\r\n</td>\r\n<td style=\"width: 9.72%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Diffuse positive</p>\r\n</td>\r\n<td style=\"width: 9.96%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Negative or focal, rarely diffuse</p>\r\n</td>\r\n<td style=\"width: 8.48%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Variable (weak to strong)</p>\r\n</td>\r\n<td style=\"width: 8.74%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Often positive, especially with high grade</p>\r\n</td>\r\n<td style=\"width: 7.76%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"7%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Negative</p>\r\n</td>\r\n<td style=\"width: 9.7%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Negative or rare</p>\r\n</td>\r\n<td style=\"width: 11.66%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Negative</p>\r\n</td>\r\n<td style=\"width: 10.68%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"10%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><em>VHL</em> mutation, chromosome 3p25 loss</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 75.0pt;\">\r\n<td style=\"width: 11.64%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 75.0pt;\" nowrap=\"nowrap\" width=\"11%\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Chromophobe</span></strong></p>\r\n</td>\r\n<td style=\"width: 11.64%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 75.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Nests and trabecular pattern, cells of variable size with prominent borders, wrinkled nuclei</span></p>\r\n</td>\r\n<td style=\"width: 9.72%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 75.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Negative or rare</span></p>\r\n</td>\r\n<td style=\"width: 9.96%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 75.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Diffuse in classic type, focal in eosinophilic subtype</span></p>\r\n</td>\r\n<td style=\"width: 8.48%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 75.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Weak to moderate</span></p>\r\n</td>\r\n<td style=\"width: 8.74%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 75.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Negative</span></p>\r\n</td>\r\n<td style=\"width: 7.76%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 75.0pt;\" width=\"7%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Positive</span></p>\r\n</td>\r\n<td style=\"width: 9.7%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 75.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">HMWCK negative, GATA3 sometimes positive</span></p>\r\n</td>\r\n<td style=\"width: 11.66%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 75.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Negative</span></p>\r\n</td>\r\n<td style=\"width: 10.68%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 75.0pt;\" width=\"10%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Multiple chromosome loss</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 60.0pt;\">\r\n<td style=\"width: 11.64%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" nowrap=\"nowrap\" width=\"11%\">\r\n<p class=\"TableText\"><strong>Clear cell papillary</strong></p>\r\n</td>\r\n<td style=\"width: 11.64%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Cysts, branched glands, solid growth, papillary formation, all with clear cytoplasm</p>\r\n</td>\r\n<td style=\"width: 9.72%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Diffuse positive, sometimes cup-shaped</p>\r\n</td>\r\n<td style=\"width: 9.96%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Diffuse</p>\r\n</td>\r\n<td style=\"width: 8.48%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Negative or minimal</p>\r\n</td>\r\n<td style=\"width: 8.74%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Positive</p>\r\n</td>\r\n<td style=\"width: 7.76%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" width=\"7%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Negative</p>\r\n</td>\r\n<td style=\"width: 9.7%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Often positive</p>\r\n</td>\r\n<td style=\"width: 11.66%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Negative</p>\r\n</td>\r\n<td style=\"width: 10.68%; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" width=\"10%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">None</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 90.0pt;\">\r\n<td style=\"width: 11.64%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" nowrap=\"nowrap\" width=\"11%\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">MITF family translocation</span></strong></p>\r\n</td>\r\n<td style=\"width: 11.64%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Variable clear and eosinophilic cells; solid and papillary formation; sometimes psammoma bodies, hyalinized stroma, pigment</span></p>\r\n</td>\r\n<td style=\"width: 9.72%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Negative or rare</span></p>\r\n</td>\r\n<td style=\"width: 9.96%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Negative</span></p>\r\n</td>\r\n<td style=\"width: 8.48%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Variable</span></p>\r\n</td>\r\n<td style=\"width: 8.74%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Often negative</span></p>\r\n</td>\r\n<td style=\"width: 7.76%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"7%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Negative</span></p>\r\n</td>\r\n<td style=\"width: 9.7%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">Negative</span></p>\r\n</td>\r\n<td style=\"width: 11.66%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">May be positive</span></p>\r\n</td>\r\n<td style=\"width: 10.68%; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" width=\"10%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><em><span style=\"color: black; \">TFE3</span></em><span style=\"color: black; \">, <em>TFEB</em>, or <em>MITF</em> rearrangement</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 105.0pt;\">\r\n<td style=\"width: 11.64%; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 105.0pt;\" nowrap=\"nowrap\" width=\"11%\">\r\n<p class=\"TableText\"><strong>Papillary</strong></p>\r\n</td>\r\n<td style=\"width: 11.64%; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 105.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Papillary and tubular structures; variable basophilic, clear, or eosinophilic cytoplasm; psammoma bodies; foamy macrophages</p>\r\n</td>\r\n<td style=\"width: 9.72%; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 105.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Negative or rare</p>\r\n</td>\r\n<td style=\"width: 9.96%; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 105.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Usually positive in basophilic or clear cells, limited in eosinophilic cells</p>\r\n</td>\r\n<td style=\"width: 8.48%; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 105.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Diffuse strong</p>\r\n</td>\r\n<td style=\"width: 8.74%; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 105.0pt;\" width=\"8%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Often positive</p>\r\n</td>\r\n<td style=\"width: 7.76%; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 105.0pt;\" width=\"7%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Negative</p>\r\n</td>\r\n<td style=\"width: 9.7%; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 105.0pt;\" width=\"9%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">May be positive for HMWCK, GATA3 positive in rare subset</p>\r\n</td>\r\n<td style=\"width: 11.66%; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 105.0pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Negative</p>\r\n</td>\r\n<td style=\"width: 10.68%; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 105.0pt;\" width=\"10%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><em>MET</em> mutation, trisomy&nbsp;7 or&nbsp;17, loss of Y chromosome</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\"><span style=\"color: white; \">HMWCK, high-molecular-weight cytokeratin; RCC, renal cell carcinoma.</span></p>\r\n<p class=\"TableText\">HMWCK, high-molecular-weight cytokeratin; RCC, renal cell carcinoma.</p>\r\n<p>&nbsp;</p>\r\n<p>&nbsp;</p>",

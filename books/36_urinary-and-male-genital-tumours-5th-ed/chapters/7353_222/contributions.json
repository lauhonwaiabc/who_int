        "pkcontributionId": 70527,
        "bookId": 36,
        "chapterId": 222,
        "headingId": 539,
        "headingText": "\r\n<p>Myoid gonadal stromal tumour of the testis is a spindle cell tumour showing myoid differentiation towards intertubular primitive mesenchymal cells.</p>\r\n",
        "timestamp": "2022-02-22T11:57:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

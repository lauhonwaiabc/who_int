        "headingId": 547,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2022-02-22T11:57:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 509,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 548,
    "contributions": [
      {

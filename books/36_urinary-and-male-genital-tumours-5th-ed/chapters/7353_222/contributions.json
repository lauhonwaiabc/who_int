  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70541,
        "bookId": 36,
        "chapterId": 222,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> a pure spindle cell tumour lacking sex cord differentiation; positivity for both actin and S100.</p>\r\n",
        "timestamp": "2022-02-22T11:57:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

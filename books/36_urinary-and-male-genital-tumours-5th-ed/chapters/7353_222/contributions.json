    "headingPosition": 7,
    "headingid": 545,
    "contributions": [
      {
        "pkcontributionId": 70533,
        "bookId": 36,
        "chapterId": 222,
        "headingId": 545,
        "headingText": "\r\n<p>The tumours arise as intratesticular masses.</p>\r\n",
        "timestamp": "2022-02-22T11:57:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 507,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 546,
    "contributions": [
      {
        "pkcontributionId": 70534,
        "bookId": 36,
        "chapterId": 222,
        "headingId": 546,
        "headingText": "\r\n<p>This neoplasm is mainly found in adults (mean age: ~40&nbsp;years), but 1&nbsp;case has been reported in a 4-year-old boy {577131}.</p>\r\n",
        "timestamp": "2022-02-22T11:57:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 508,

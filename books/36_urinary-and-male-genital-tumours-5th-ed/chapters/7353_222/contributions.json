        "pkcontributionId": 70539,
        "bookId": 36,
        "chapterId": 222,
        "headingId": 550,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2022-02-22T11:57:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 69811,
        "bookId": 36,
        "chapterId": 331,
        "headingId": 539,
        "headingText": "\r\n<p>Cystadenoma of the prostate is a benign epithelial neoplasm composed of multiple macroscopic cysts lined by bland prostatic secretory and basal cells and separated by fibrous or fibromuscular stroma.</p>\r\n",
        "timestamp": "2022-02-10T19:21:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,

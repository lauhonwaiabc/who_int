        "bookId": 36,
        "chapterId": 105,
        "headingId": 540,
        "headingText": "\r\n<p>8560/3 Adenosquamous carcinoma</p>\r\n",
        "timestamp": "2022-02-10T19:39:36"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 541,
    "contributions": [
      {
        "pkcontributionId": 69915,
        "bookId": 36,
        "chapterId": 105,
        "headingId": 541,
        "headingText": "\r\n<p>2C82.Y &amp; XH7873 Other specified malignant neoplasms of prostate &amp; Adenosquamous carcinoma</p>\r\n",
        "timestamp": "2022-02-10T19:39:36"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 503,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 542,
    "contributions": [
      {
        "pkcontributionId": 69916,
        "bookId": 36,
        "chapterId": 105,
        "headingId": 542,
        "headingText": "\r\n<p><em>Acceptable: </em>prostatic carcinoma with adenosquamous differentiation.</p>\r\n",
        "timestamp": "2022-02-10T19:39:36"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 504,

[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 69913,
        "bookId": 36,
        "chapterId": 105,
        "headingId": 539,
        "headingText": "\r\n<p>Adenosquamous carcinoma of the prostate is defined by the presence of both glandular and squamous components.</p>\r\n",
        "timestamp": "2022-02-10T19:39:36"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,
    "headingType": 2,

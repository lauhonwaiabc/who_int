        "chapterId": 150,
        "headingId": 552,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2022-02-22T11:53:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70475,
        "bookId": 36,
        "chapterId": 150,
        "headingId": 553,
        "headingText": "\r\n<p>JGCTs show benign behaviour, even after testis-sparing surgery {32719989}.</p>",
        "timestamp": "2022-02-22T11:53:11"
      }
    ],

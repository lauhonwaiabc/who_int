[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 70459,
        "bookId": 36,
        "chapterId": 150,
        "headingId": 539,
        "headingText": "\r\n<p>Juvenile granulosa cell tumour (JGCT) is a sex cord tumour composed of primitive-appearing granulosa cells growing in solid and follicular patterns.</p>\r\n",
        "timestamp": "2022-02-22T11:53:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

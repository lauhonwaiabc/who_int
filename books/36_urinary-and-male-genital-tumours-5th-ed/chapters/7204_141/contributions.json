        "chapterId": 141,
        "headingId": 542,
        "headingText": "<p><em>Not recommended:</em> germ cell tumour type 1.</p>",
        "timestamp": "2022-04-15T15:52:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 504,

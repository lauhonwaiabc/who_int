        "bookId": 36,
        "chapterId": 141,
        "headingId": 541,
        "headingText": "\r\n<p>2C80.Y &amp; XH2PS1 Other specified malignant neoplasms of testis &amp; Mixed germ cell tumour</p>\r\n",
        "timestamp": "2022-03-21T11:57:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "bookId": 36,
        "chapterId": 141,
        "headingId": 540,
        "headingText": "\r\n<p>9085/3 Mixed teratoma and yolk sac tumour, prepubertal-type</p>\r\n",
        "timestamp": "2022-03-21T11:57:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",

      {
        "pkcontributionId": 70187,
        "bookId": 36,
        "chapterId": 125,
        "headingId": 539,
        "headingText": "\r\n<p>Placental site trophoblastic tumour (PSTT) of the testis is a malignant trophoblastic neoplasm with morphological features similar to those of its predominantly uterine counterpart, which is considered to be derived from implantation site intermediate trophoblasts.</p>\r\n",
        "timestamp": "2022-02-22T11:33:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

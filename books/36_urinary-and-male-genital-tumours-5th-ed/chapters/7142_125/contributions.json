  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70201,
        "bookId": 36,
        "chapterId": 125,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> mononucleated trophoblastic cells in diffuse sheets; infiltrative pattern with prominent vascular invasion; tumour cells are positive for hPL and negative for p63.</p>\r\n",
        "timestamp": "2022-02-22T11:33:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

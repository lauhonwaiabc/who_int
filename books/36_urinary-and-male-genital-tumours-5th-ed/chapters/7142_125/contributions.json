  },
  {
    "pkheadingid": 506,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 545,
    "contributions": [
      {
        "pkcontributionId": 70193,
        "bookId": 36,
        "chapterId": 125,
        "headingId": 545,
        "headingText": "\r\n<p>Only 7&nbsp;cases of testicular PSTT have been described, in patients aged 16 months to 61 years (median age: 33 years) {26457351; 20381116; 26277672; 29395947; 15166678; 9060597; 25908040}. Five arose in the testis and the remaining two reported were at metastatic sites. Four of the testicular PSTTs arose as a component of mixed germ cell tumours, and the remaining case was a pure PSTT. Two tumours reported in metastatic sites were in patients who had previously received chemotherapy {15166678; 9060597}. Serum hCG may be elevated in patients with PSTT. The corresponding primary testicular tumour may demonstrate trophoblastic differentiation (choriocarcinoma) in metastatic PSTT. One PSTT has also been reported in a mediastinal germ cell tumour {15948127}.</p>\r\n",
        "timestamp": "2022-02-22T11:33:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 507,

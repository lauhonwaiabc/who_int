    "contributions": [
      {
        "pkcontributionId": 70628,
        "bookId": 36,
        "chapterId": 163,
        "headingId": 552,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2022-02-22T15:34:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70629,
        "bookId": 36,
        "chapterId": 163,
        "headingId": 553,
        "headingText": "\r\n<p>The few reported cases showed benign behaviour {28189139}.</p>",
        "timestamp": "2022-02-22T15:34:01"
      }

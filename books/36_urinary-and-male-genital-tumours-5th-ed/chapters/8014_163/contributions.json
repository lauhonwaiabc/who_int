    "numberofBooknote": 0
  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70627,
        "bookId": 36,
        "chapterId": 163,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> a cystic tumour lined by a mucinous columnar epithelium with no atypia or architectural complexity; no invasive or intratubular germ cell neoplasia identified in the background testis; extensive sampling is required.</p>\r\n",
        "timestamp": "2022-02-22T15:34:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,

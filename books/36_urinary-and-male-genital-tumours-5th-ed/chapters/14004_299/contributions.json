[
  {
    "pkheadingid": 500,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 539,
    "contributions": [
      {
        "pkcontributionId": 71554,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 539,
        "headingText": "\r\n<p>Hereditary papillary renal carcinoma (HPRC) is a specific form of inherited kidney cancer.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 501,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 540,
    "contributions": [
      {
        "pkcontributionId": 71555,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 540,
        "headingText": "<h5>MIM numbering</h5>\r\n<p>605074 Renal cell carcinoma, papillary</p>",
        "timestamp": "2022-05-10T11:34:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 502,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 541,
    "contributions": [
      {
        "pkcontributionId": 71556,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 541,
        "headingText": "\r\n<p>2C90.Y &amp; XH1D07 Other specified malignant neoplasms of kidney, except renal pelvis &amp; Papillary renal cell carcinoma</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 503,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 542,
    "contributions": [
      {
        "pkcontributionId": 71557,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 542,
        "headingText": "\r\n<p><em>Acceptable:</em> familial papillary renal cell carcinoma syndrome.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 504,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 543,
    "contributions": [
      {
        "pkcontributionId": 71558,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 543,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 505,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 544,
    "contributions": [
      {
        "pkcontributionId": 71559,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 544,
        "headingText": "\r\n<p>The tumours occur in the renal cortex and are multifocal.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 506,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 545,
    "contributions": [
      {
        "pkcontributionId": 71560,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 545,
        "headingText": "\r\n<p>Multiple and bilateral renal tumours are seen on CT, ultrasound, or MRI. There is always a family history of renal cancer, although some family members may be asymptomatic. No other types of cancer or non-cancerous health problems are known to be related to HPRC.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 507,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 546,
    "contributions": [
      {
        "pkcontributionId": 71561,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 546,
        "headingText": "\r\n<p>HPRC is considered to be rare. The number of people and families who have HPRC is unknown.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 508,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 547,
    "contributions": [
      {
        "pkcontributionId": 71562,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 547,
        "headingText": "\r\n<p>HPRC is caused by missense germline mutations in the <em>MET</em> proto-oncogene on chromosome 7q31, which leads to constitutive activation of the c-Met protein {9140397; 33527590}.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 509,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 548,
    "contributions": [
      {
        "pkcontributionId": 71563,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 548,
        "headingText": "\r\n<p><em>MET</em> is a gene that encodes a receptor tyrosine kinase that binds to HGF, an important growth factor.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 516,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 555,
    "contributions": [
      {
        "pkcontributionId": 71564,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 555,
        "headingText": "\r\n<p>HPRC manifests as bilateral and multiple solid renal tumours, ranging from nodules of a few millimetres to larger masses. The tumours may be encapsulated or unencapsulated {24025519; 33664427}.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 510,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 549,
    "contributions": [
      {
        "pkcontributionId": 71565,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 549,
        "headingText": "\r\n<p>Almost all HPRCs are typical papillary carcinomas (formerly known as type&nbsp;1 papillary carcinomas). Papillary renal cell carcinomas of this type have papillae covered by cells with nuclei arranged in a single layer on the papillary cores, mostly with scant pale cytoplasm. Psammoma bodies and haemosiderin deposition are frequent. In addition to low-grade papillary renal cell carcinomas, tubulopapillary adenomas are also seen {24025519; 33664427}.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 511,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 550,
    "contributions": [
      {
        "pkcontributionId": 71566,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 550,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 512,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 551,
    "contributions": [
      {
        "pkcontributionId": 71567,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 551,
        "headingText": "\r\n<p>HPRC is caused by germline mutations of the <em>MET</em> proto-oncogene.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 71568,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> HPRC is suspected when multiple family members have low-grade papillary renal cell carcinoma or an individual has bilateral, multifocal, low-grade papillary renal cell carcinoma.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 552,
    "contributions": [
      {
        "pkcontributionId": 71569,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 552,
        "headingText": "\r\n<p>Staging follows the eighth-edition Union for International Cancer Control (UICC) and American Joint Committee on Cancer (AJCC) TNM classification.</p>\r\n",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 71570,
        "bookId": 36,
        "chapterId": 299,
        "headingId": 553,
        "headingText": "\r\n<p>The specific risk for low-grade papillary renal cell carcinoma in families with HPRC is extremely high, with some estimates showing the lifetime risk is nearly 100%.</p>",
        "timestamp": "2022-02-25T11:54:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
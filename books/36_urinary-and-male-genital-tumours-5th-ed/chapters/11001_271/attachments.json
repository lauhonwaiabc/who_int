  {
    "pkattachmentId": 38938,
    "bookid": 36,
    "chapterId": 271,
    "fileId": 22529,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Haematolymphoid neoplasms that may occur in the male genitourinary system</p>",
    "legend": "",
    "source": "Santosh Menon",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" width=\"931\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 15.0pt;\">\r\n<td style=\"width: 4.0cm; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.0pt;\" nowrap=\"nowrap\" width=\"151\">\r\n<p class=\"TableText\"><strong>Type of lymphoma</strong></p>\r\n</td>\r\n<td style=\"width: 106.35pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.0pt;\" nowrap=\"nowrap\" width=\"142\">\r\n<p class=\"TableText\"><strong>Frequency and common GU anatomical subsite</strong></p>\r\n</td>\r\n<td style=\"width: 119.5pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.0pt;\" nowrap=\"nowrap\" width=\"159\">\r\n<p class=\"TableText\"><strong>Usual cellular composition</strong></p>\r\n</td>\r\n<td style=\"width: 119.55pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.0pt;\" nowrap=\"nowrap\" width=\"159\">\r\n<p class=\"TableText\"><strong>Usual immunophenotype</strong></p>\r\n</td>\r\n<td style=\"width: 119.55pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.0pt;\" nowrap=\"nowrap\" width=\"159\">\r\n<p class=\"TableText\"><strong>Molecular features</strong></p>\r\n</td>\r\n<td style=\"width: 119.55pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.0pt;\" nowrap=\"nowrap\" width=\"159\">\r\n<p class=\"TableText\"><strong>Differential diagnosis</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 9.3pt;\">\r\n<td style=\"width: 697.9pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 9.3pt;\" colspan=\"6\" valign=\"top\" nowrap=\"nowrap\" width=\"931\">\r\n<p class=\"TableText\"><strong>B-cell lymphomas</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 52.8pt;\">\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.8pt;\" valign=\"top\" width=\"151\">\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><strong>Diffuse large B-cell lymphoma</strong></p>\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><span class=\"Ref-PMID\">{25837971; 29187485; 31825109}</span></p>\r\n</td>\r\n<td style=\"width: 106.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.8pt;\" valign=\"top\" width=\"142\">\r\n<p class=\"TableText\">Most common type of high-grade lymphoma of the GU tract</p>\r\n<p class=\"TableText\">Kidney is the most common subsite</p>\r\n</td>\r\n<td style=\"width: 119.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.8pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Centroblasts, immunoblasts, anaplastic large B&nbsp;cells</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.8pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Positive for one or more B-cell antigens (CD19, CD20, CD79a, PAX5) along with frequent positivity for CD45, BCL2, CD10, BCL6, and/or IRF4 (MUM1)</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.8pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Clonal IGH</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.8pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Poorly differentiated carcinoma including metastasis; in testis, spermatocytic tumour and germ cell tumours</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 58.0pt;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"151\">\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><strong>MALT lymphoma</strong></p>\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><span class=\"Ref-PMID\">{17709321; 32664075}</span></p>\r\n</td>\r\n<td style=\"width: 106.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"142\">\r\n<p class=\"TableText\">Most common low-grade lymphoma of the GU tract</p>\r\n<p class=\"TableText\">Urinary bladder is the most common subsite</p>\r\n</td>\r\n<td style=\"width: 119.5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Marginal zone B&nbsp;cells admixed with small lymphocytes and plasma cells; reactive lymphoid follicles and lymphoepithelial lesions are rare</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Positive for one or more B-cell antigens (CD19, CD20, CD79a, PAX5); negative for CD5, CD10, BCL6, LEF1, cyclin&nbsp;D1, and SOX11</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">t(11;18) (urinary bladder); t(14;18) (kidney); trisomy&nbsp;3 (urinary bladder)</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Chronic inflammatory infiltrate</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 58.0pt;\">\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"151\">\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><strong>Plasmacytoma</strong></p>\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><span class=\"Ref-PMID\">{9158685; 20923037}</span></p>\r\n</td>\r\n<td style=\"width: 106.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"142\">\r\n<p class=\"TableText\">Rare</p>\r\n<p class=\"TableText\">Testis, epididymis, and urinary bladder</p>\r\n</td>\r\n<td style=\"width: 119.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Sheets of mature or atypical plasma cells</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Positive for CD38, CD138, IRF4 (MUM1), and monotypic kappa or lambda light chain</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Clonal IGH rearrangement</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 58.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Plasmacytoid urothelial carcinoma; MALT lymphoma; lymphoplasmacytic lymphoma; IgG4 disease; neuroendocrine tumour (NET)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 60.0pt;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" valign=\"top\" nowrap=\"nowrap\" width=\"151\">\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><strong>Follicular lymphoma</strong></p>\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><span class=\"Ref-PMID\">{31516835; 31641184}</span></p>\r\n</td>\r\n<td style=\"width: 106.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" valign=\"top\" width=\"142\">\r\n<p class=\"TableText\">Rare in GU tract</p>\r\n</td>\r\n<td style=\"width: 119.5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Mixture of centrocytes, centroblasts, and follicular dendritic cells</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Positive for CD20, CD10, BCL6; negative for CD5, cyclin&nbsp;D1, CD43; positive or negative for BCL2</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Clonal IGH</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 60.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Chronic inflammatory process</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 120.0pt;\">\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" nowrap=\"nowrap\" width=\"151\">\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><strong>Burkitt lymphoma</strong></p>\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><span class=\"Ref-PMID\">{19377442; 24665028}</span></p>\r\n</td>\r\n<td style=\"width: 106.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" width=\"142\">\r\n<p class=\"TableText\">Rare in GU tract</p>\r\n<p class=\"TableText\">Kidney and testis</p>\r\n</td>\r\n<td style=\"width: 119.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Medium-sized atypical lymphoid cells with round nuclei, coarse chromatin, numerous mitoses, and tingible-body macrophages</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Positive for CD20, CD10, BCL6, MYC; negative for BCL2; Ki-67 index is typically ~99&ndash;100%</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Clonal IGH; t(8:14), t(2,8), or t(8;22) (<em>MYC</em>); endemic cases EBV+, minority EBV&minus;</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Other high-grade lymphomas</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 45.0pt;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 45.0pt;\" valign=\"top\" width=\"151\">\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><strong>B-lymphoblastic leukaemia/lymphoma</strong></p>\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><span class=\"Ref-PMID\">{24665028; 23042023; 30775881}</span></p>\r\n</td>\r\n<td style=\"width: 106.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 45.0pt;\" valign=\"top\" width=\"142\">\r\n<p class=\"TableText\">Testis and kidney</p>\r\n</td>\r\n<td style=\"width: 119.5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 45.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Small to medium-sized blasts with high N:C&nbsp;ratio and scant cytoplasm</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 45.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Positive for CD19, TdT; negative for CD10, CD3, and myeloperoxidase</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 45.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Clonal IGH; other changes variable</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 45.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Small round cell tumours</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 4.0pt;\">\r\n<td style=\"width: 697.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" colspan=\"6\" valign=\"top\" width=\"931\">\r\n<p class=\"TableText\"><strong>T-cell and NK/T-cell lymphomas</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 97.4pt;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 97.4pt;\" valign=\"top\" width=\"151\">\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><strong>Extranodal NK/T-cell lymphoma, nasal-type</strong></p>\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><span class=\"Ref-PMID\">{28410601; 30589649}</span></p>\r\n</td>\r\n<td style=\"width: 106.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 97.4pt;\" valign=\"top\" nowrap=\"nowrap\" width=\"142\">\r\n<p class=\"TableText\">Very rare</p>\r\n<p class=\"TableText\">Testis</p>\r\n</td>\r\n<td style=\"width: 119.5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 97.4pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Small, medium-sized, and/or large atypical lymphoid cells; necrosis; vascular damage may be prominent</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 97.4pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Positive for cytoplasmic CD3, CD2, CD56, granzyme&nbsp;B, perforin; negative for CD5</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 97.4pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">NK-lineage cases: germline TR, EBV+</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 97.4pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">High-grade lymphomas; inflammatory process may be confused with NK/T-cell lymphomas with extensive necrosis</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 90.0pt;\">\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"151\">\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><strong>Peripheral T-cell lymphoma</strong></p>\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><span class=\"Ref-PMID\">{30822482}</span></p>\r\n</td>\r\n<td style=\"width: 106.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" nowrap=\"nowrap\" width=\"142\">\r\n<p class=\"TableText\">Very rare</p>\r\n<p class=\"TableText\">Testis</p>\r\n</td>\r\n<td style=\"width: 119.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Variable; small, medium-sized, and/or large cells</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Variable expression of pan&ndash;T-cell antigens; positive for CD4 and CD8</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Clonal TR</p>\r\n</td>\r\n<td style=\"width: 119.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">For low-grade cases, chronic inflammatory process; for high-grade cases, other poorly differentiated neoplasms</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 120.0pt;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" width=\"151\">\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><strong>T-lymphoblastic leukaemia/lymphoma</strong></p>\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><span class=\"Ref-PMID\">{31885952}</span></p>\r\n</td>\r\n<td style=\"width: 106.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" width=\"142\">\r\n<p class=\"TableText\">Very rare</p>\r\n<p class=\"TableText\">Testis</p>\r\n</td>\r\n<td style=\"width: 119.5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Small to medium-sized blasts with round, irregular, or convoluted nuclei; finely dispersed to dark chromatin; variably prominent nucleoli; scant cytoplasm; frequent mitoses</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Positive for CD3, CD7, TdT, CD1a, CD10; often double-positive for CD4 and CD8</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Clonal TR; clonal IGH in a minority</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 120.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Other high-grade lymphomas; small round cell tumours</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 15.0pt;\">\r\n<td style=\"width: 697.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.0pt;\" colspan=\"6\" valign=\"top\" nowrap=\"nowrap\" width=\"931\">\r\n<p class=\"TableText\"><strong>Hodgkin lymphoma</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 90.0pt;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"151\">\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><strong>Classic Hodgkin lymphoma</strong></p>\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><span class=\"Ref-PMID\">{17478785; 22714614}</span></p>\r\n</td>\r\n<td style=\"width: 106.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" nowrap=\"nowrap\" width=\"142\">\r\n<p class=\"TableText\">Extremely rare as a primary GU tract tumour</p>\r\n</td>\r\n<td style=\"width: 119.5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">RS cells and subtypes in a reactive lymphoid background</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Positive for CD15, CD30, CD20 (variable), PAX5; negative for CD3</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">EBV+ in subset of cases</p>\r\n</td>\r\n<td style=\"width: 119.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">If RS cells are a minor component it may be confused with reactive conditions; if RS cells are abundant it may mimic any other high-grade malignancy</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 15.0pt;\">\r\n<td style=\"width: 697.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.0pt;\" colspan=\"6\" valign=\"top\" nowrap=\"nowrap\" width=\"931\">\r\n<p class=\"TableText\"><strong>Myeloid neoplasms</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 90.0pt;\">\r\n<td style=\"width: 4.0cm; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" nowrap=\"nowrap\" width=\"151\">\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><strong>Acute myeloid leukaemia, myeloid sarcoma</strong></p>\r\n<p class=\"TableText\" style=\"margin-left: 16.1pt;\"><span class=\"Ref-PMID\">{30840960; 31371220}</span></p>\r\n</td>\r\n<td style=\"width: 106.35pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" nowrap=\"nowrap\" width=\"142\">\r\n<p class=\"TableText\">Rare in GU tract</p>\r\n<p class=\"TableText\">Testis is the most common subsite</p>\r\n</td>\r\n<td style=\"width: 119.5pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Variably sized (usually medium-sized) blasts with prominent nucleoli; admixed maturing myeloid elements maybe seen; single-file pattern may be seen</p>\r\n</td>\r\n<td style=\"width: 119.55pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">Positive for lysozyme, CD33, CD43, CD68 (variable), myeloperoxidase, CD34, KIT (CD117); negative for CD20 and CD3</p>\r\n</td>\r\n<td style=\"width: 119.55pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" nowrap=\"nowrap\" width=\"159\">\r\n<p class=\"TableText\">Varied</p>\r\n</td>\r\n<td style=\"width: 119.55pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 90.0pt;\" valign=\"top\" width=\"159\">\r\n<p class=\"TableText\">All large cell lymphomas; metastatic poorly differentiated carcinomas</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p>&nbsp;</p>\r\n<p class=\"TableText\">GU, genitourinary; MALT lymphoma, extranodal marginal zone lymphoma of mucosa-associated lymphoid tissue; RS, Reed&ndash;Sternberg.</p>",

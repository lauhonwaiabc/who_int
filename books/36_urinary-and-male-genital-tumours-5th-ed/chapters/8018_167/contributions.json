      {
        "pkcontributionId": 70681,
        "bookId": 36,
        "chapterId": 167,
        "headingId": 539,
        "headingText": "\r\n<p>Clear cell adenocarcinoma is a malignant epithelial tumour consisting of M&uuml;llerian-type epithelium with clear cell morphology.</p>\r\n",
        "timestamp": "2022-02-22T15:36:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

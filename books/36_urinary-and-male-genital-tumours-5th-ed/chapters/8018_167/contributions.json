  },
  {
    "pkheadingid": 515,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 554,
    "contributions": [
      {
        "pkcontributionId": 70695,
        "bookId": 36,
        "chapterId": 167,
        "headingId": 554,
        "headingText": "\r\n<p><em>Essential:</em> a tumour with clear and hobnail cells in a solid, tubulocystic, confluent, or complex papillary pattern; exclusion of metastasis.</p>\r\n<p><em>Desirable:</em> immunoreactivity for CK7 and PAX8; negativity for mesothelial markers and RCCm.</p>\r\n",
        "timestamp": "2022-02-22T15:36:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 513,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 552,
    "contributions": [
      {
        "pkcontributionId": 70696,
        "bookId": 36,
        "chapterId": 167,
        "headingId": 552,
        "headingText": "\r\n<p>There is no American Joint Committee on Cancer (AJCC) staging system for these tumours.</p>\r\n",
        "timestamp": "2022-02-22T15:36:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 514,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 553,
    "contributions": [
      {
        "pkcontributionId": 70697,
        "bookId": 36,
        "chapterId": 167,
        "headingId": 553,
        "headingText": "\r\n<p>Both an aggressive and an indolent course have been reported, as well as response to radiotherapy {30921621}.</p>",
        "timestamp": "2022-02-22T15:36:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

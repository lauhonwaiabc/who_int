  },
  {
    "pkheadingid": 505,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 544,
    "contributions": [
      {
        "pkcontributionId": 70686,
        "bookId": 36,
        "chapterId": 167,
        "headingId": 544,
        "headingText": "\r\n<p>Intratesticular or paratesticular</p>\r\n",
        "timestamp": "2022-02-22T15:36:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 506,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 545,
    "contributions": [
      {
        "pkcontributionId": 70687,
        "bookId": 36,
        "chapterId": 167,
        "headingId": 545,
        "headingText": "\r\n<p>The patient age range is 43&ndash;71&nbsp;years (mean: 52&nbsp;years). Patients present with an intratesticular or paratesticular mass, with or without local or abdominal pain.</p>\r\n",
        "timestamp": "2022-02-22T15:36:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 507,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 546,
    "contributions": [
      {
        "pkcontributionId": 70688,
        "bookId": 36,
        "chapterId": 167,
        "headingId": 546,
        "headingText": "\r\n<p>Clear cell adenocarcinoma is a very rare tumour, with only 3&nbsp;cases reported {15260857; 30921621}.</p>\r\n",
        "timestamp": "2022-02-22T15:36:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 508,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 547,
    "contributions": [
      {
        "pkcontributionId": 70689,
        "bookId": 36,
        "chapterId": 167,
        "headingId": 547,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2022-02-22T15:36:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 509,
    "bookid": 36,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 548,
    "contributions": [
      {
        "pkcontributionId": 70690,

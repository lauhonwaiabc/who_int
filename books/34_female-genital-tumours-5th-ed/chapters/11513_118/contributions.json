      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 62597,
        "bookId": 34,
        "chapterId": 118,
        "headingId": 384,
        "headingText": "\r\n<p>All reported cases had a benign clinical course after surgical removal.</p>",

        "pkcontributionId": 62581,
        "bookId": 34,
        "chapterId": 118,
        "headingId": 370,
        "headingText": "\r\n<p>Large solitary luteinized follicle cyst is a large, unilateral, solitary cyst lined by luteinized cells, occurring during pregnancy or puerperium.</p>\r\n",
        "timestamp": "2020-05-14T11:37:29"
      }
    ],

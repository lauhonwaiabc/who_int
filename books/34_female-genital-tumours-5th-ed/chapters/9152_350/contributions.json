      {
        "pkcontributionId": 65014,
        "bookId": 34,
        "chapterId": 350,
        "headingId": 375,
        "headingText": "\r\n<p>Posterior and distal vaginal wall close to the hymen</p>\r\n",
        "timestamp": "2020-06-08T17:12:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 65015,
        "bookId": 34,
        "chapterId": 350,
        "headingId": 376,
        "headingText": "\r\n<p>Patient age has a wide range (mean: 40&nbsp;years). Patients are asymptomatic or report nonspecific symptoms related to a mass.</p>\r\n",
        "timestamp": "2020-06-08T17:12:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",

        "pkcontributionId": 63013,
        "bookId": 34,
        "chapterId": 159,
        "headingId": 376,
        "headingText": "\r\n<p>Histiocytic nodules are usually an incidental finding {27340746; 22271884; 15185256}.</p>\r\n",
        "timestamp": "2020-05-19T15:21:27"
      }
    ],
    "booknotes": [],

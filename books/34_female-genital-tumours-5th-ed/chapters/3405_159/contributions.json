  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 63014,
        "bookId": 34,
        "chapterId": 159,
        "headingId": 377,
        "headingText": "\r\n<p>This lesion is seen in patients ranging in age from 6 to 70&nbsp;years {27340746; 22271884}.</p>\r\n",
        "timestamp": "2020-05-19T15:21:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 63015,
        "bookId": 34,
        "chapterId": 159,
        "headingId": 378,
        "headingText": "\r\n<p>Histiocytic nodules result from a nonspecific reaction to injury (including trauma), inflammation, or the presence of a tumour {27340746}.</p>\r\n",
        "timestamp": "2020-05-19T15:21:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

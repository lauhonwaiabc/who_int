  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63434,
        "bookId": 34,
        "chapterId": 209,
        "headingId": 384,
        "headingText": "\r\n<p>These are aggressive tumours; about half of patients die within 12&nbsp;months of diagnosis. The presence of osteoclastic-like giant cells and rhabdoid cells is an adverse finding {20736768}.</p>",

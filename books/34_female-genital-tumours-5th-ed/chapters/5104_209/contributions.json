      {
        "pkcontributionId": 63424,
        "bookId": 34,
        "chapterId": 209,
        "headingId": 376,
        "headingText": "\r\n<p>Most patients are perimenopausal and present with pelvic pain.</p>\r\n",
        "timestamp": "2020-05-25T15:42:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 63425,
        "bookId": 34,
        "chapterId": 209,
        "headingId": 377,
        "headingText": "\r\n<p>Although rare overall, leiomyosarcoma is the most common sarcoma of the broad ligament {27330834; 6837836; 14605822; 16343220}.</p>\r\n",
        "timestamp": "2020-05-25T15:42:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0

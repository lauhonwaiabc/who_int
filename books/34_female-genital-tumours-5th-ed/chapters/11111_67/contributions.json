  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 61966,
        "bookId": 34,
        "chapterId": 67,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> fascicles of bland fibromatous spindle cells in a variably collagenous stroma.</p>\r\n",
        "timestamp": "2020-05-13T17:03:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

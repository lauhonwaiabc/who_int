        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T17:03:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 61968,
        "bookId": 34,
        "chapterId": 67,
        "headingId": 384,
        "headingText": "\r\n<p>These are benign tumours, but a small proportion of cases (most commonly cellular fibromas) are associated with ovarian surface rupture and extraovarian adhesions. Such tumours are at risk of local recurrence, often after a long interval {7260859; 16861962}.</p>",
        "timestamp": "2020-05-13T17:03:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
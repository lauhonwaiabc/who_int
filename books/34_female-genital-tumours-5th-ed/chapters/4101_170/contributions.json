      {
        "pkcontributionId": 63215,
        "bookId": 34,
        "chapterId": 170,
        "headingId": 373,
        "headingText": "\r\n<p><em>Acceptable:</em> hydatid cysts</p>\r\n<p><em>Not recommended:</em> hydatid of Morgagni</p>\r\n",
        "timestamp": "2020-05-25T15:34:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

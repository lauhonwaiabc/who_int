    "contributions": [
      {
        "pkcontributionId": 63212,
        "bookId": 34,
        "chapterId": 170,
        "headingId": 370,
        "headingText": "\r\n<p>Paratubal cysts are cystic structures found between the ovary and fallopian tube, often lined by ciliated epithelium.</p>\r\n",
        "timestamp": "2020-05-25T15:34:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

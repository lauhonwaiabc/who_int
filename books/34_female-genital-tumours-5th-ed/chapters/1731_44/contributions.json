[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 61798,
        "bookId": 34,
        "chapterId": 44,
        "headingId": 370,
        "headingText": "\r\n<p>Malignant Brenner tumour is an ovarian carcinoma resembling an invasive urothelial carcinoma, associated with benign or borderline Brenner tumour.</p>\r\n",
        "timestamp": "2020-05-13T16:55:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 371,
    "contributions": [
      {
        "pkcontributionId": 61799,
        "bookId": 34,
        "chapterId": 44,
        "headingId": 371,
        "headingText": "\r\n<p>9000/3 Brenner tumour, malignant</p>\r\n",
        "timestamp": "2020-05-13T16:55:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 61800,
        "bookId": 34,
        "chapterId": 44,
        "headingId": 372,
        "headingText": "\r\n<p>2C73.Y &amp; XH6NJ7 Other specified malignant neoplasms of the ovary &amp; Brenner tumour, malignant</p>\r\n",
        "timestamp": "2020-05-13T16:55:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,

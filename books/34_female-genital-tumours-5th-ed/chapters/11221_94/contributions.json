  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 62357,
        "bookId": 34,
        "chapterId": 94,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> benign thyroid tissue alone or constituting &gt;&nbsp;50% of a dermoid cyst.</p>\r\n",
        "timestamp": "2020-05-13T17:54:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,

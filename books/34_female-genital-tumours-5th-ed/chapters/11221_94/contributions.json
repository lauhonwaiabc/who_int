        "pkcontributionId": 62343,
        "bookId": 34,
        "chapterId": 94,
        "headingId": 370,
        "headingText": "\r\n<p>Struma ovarii is a mature teratoma in which thyroid tissue is the predominant or sole component.</p>\r\n",

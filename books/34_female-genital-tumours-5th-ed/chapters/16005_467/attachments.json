    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 163.05pt; border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 3.0cm; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\"><strong>Site</strong></p>\r\n</td>\r\n<td style=\"width: 78.0pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"104\">\r\n<p class=\"TableText\"><strong>Cancer risk</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\">Colorectum</p>\r\n</td>\r\n<td style=\"width: 78.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"104\">\r\n<p class=\"TableText\">39%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 3.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\">Small intestine</p>\r\n</td>\r\n<td style=\"width: 78.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"104\">\r\n<p class=\"TableText\">13%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\">Stomach</p>\r\n</td>\r\n<td style=\"width: 78.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"104\">\r\n<p class=\"TableText\">29%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 3.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\">Pancreas</p>\r\n</td>\r\n<td style=\"width: 78.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"104\">\r\n<p class=\"TableText\">11&ndash;36%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;
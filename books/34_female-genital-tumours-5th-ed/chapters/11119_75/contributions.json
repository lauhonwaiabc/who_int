        "pkcontributionId": 62071,
        "bookId": 34,
        "chapterId": 75,
        "headingId": 370,
        "headingText": "\r\n<p>Steroid cell tumour is an ovarian parenchymal tumour composed of steroid cells.</p>\r\n",
        "timestamp": "2020-05-13T17:09:21"
      }
    ],

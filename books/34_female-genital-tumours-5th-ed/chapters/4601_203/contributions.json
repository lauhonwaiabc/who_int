  },
  {
    "pkheadingid": 473,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 386,
    "contributions": [
      {
        "pkcontributionId": 63359,
        "bookId": 34,
        "chapterId": 203,
        "headingId": 386,
        "headingText": "\r\n<p>Teratoma of the fallopian tube is usually a small and solid intratubal mass, but it may be cystic and as large as 20&nbsp;cm in diameter {23445130}.</p>\r\n",
        "timestamp": "2020-05-25T15:39:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 467,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 380,
    "contributions": [
      {
        "pkcontributionId": 63360,
        "bookId": 34,
        "chapterId": 203,
        "headingId": 380,
        "headingText": "<p>The histopathology of teratomas of the fallopian tube is similar to that of their ovarian counterparts {23445130; 30936334}. See <a style=\"cursor:pointer\" href=\"/chaptercontent/34/90\" target=\"_blank\">section </a><em>Mature teratoma of the ovary</em>&nbsp;and <a style=\"cursor:pointer\" href=\"/chaptercontent/34/91\" target=\"_blank\">section </a><em>Immature teratoma of the ovary</em>.</p>",
        "timestamp": "2020-07-10T08:10:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "bookId": 34,
        "chapterId": 203,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> benign mature ectodermal, mesodermal, and/or endodermal components; immature teratomas include immature neuroectodermal tissue.</p>\r\n",
        "timestamp": "2020-05-25T15:39:26"
      }

    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 65851,
        "bookId": 34,
        "chapterId": 432,
        "headingId": 372,
        "headingText": "\r\n<p>2E86.1 &amp; XH4CY6 Leiomyoma of other or unspecified sites &amp; Leiomyoma NOS</p>\r\n",
        "timestamp": "2020-06-12T17:26:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,

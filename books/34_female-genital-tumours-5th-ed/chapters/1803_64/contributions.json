    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 61849,
        "bookId": 34,
        "chapterId": 64,
        "headingId": 370,
        "headingText": "\r\n<p>Carcinosarcoma is a biphasic malignant neoplasm composed of high-grade carcinomatous and sarcomatous elements.</p>\r\n",
        "timestamp": "2020-05-13T16:59:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

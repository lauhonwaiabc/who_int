    "title": "<p>Differential diagnosis of hydatidiform moles</p>",
    "legend": "",
    "source": "Natalia Buza",
    "copyright": "",
    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 703.3pt; border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 128.8pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"172\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong>Complete hydatidiform mole</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong>Very early complete hydatidiform mole</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong>Partial hydatidiform mole</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong>Hydropic abortion (with normal karyotype)</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong>Chromosomal trisomies</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong>Digynic triploidy</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 128.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"172\">\r\n<p class=\"TableText\"><strong>Gross features</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Voluminous specimen, diffuse hydropic change</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">No gross abnormality</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">No gross abnormality or focal hydropic change</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">No gross abnormality</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">No gross villous abnormality; fetal anomalies may be seen</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">No gross abnormality</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 128.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"172\">\r\n<p class=\"TableText\"><strong>Fetus&nbsp;/ fetal parts</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Absent</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Absent</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">May be present; mild to moderate symmetrical IUGR; syndactyly</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">May be present</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">May be present</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">May be present; severe symmetrical IUGR</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 128.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"172\">\r\n<p class=\"TableText\"><strong>Chorionic villi</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Enlarged with marked, generalized hydrops</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Normal size; polypoid shape with cellular, myxoid stroma and prominent karyorrhexis</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Two populations:</p>\r\n<p class=\"TableText\">(1) enlarged villi with irregular, scalloped contours and mild to moderate hydrops and</p>\r\n<p class=\"TableText\">(2) small fibrotic villi</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Round, smooth contour with mild, focal hydrops</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Irregularly shaped with mild enlargement and hydrops</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">May have irregular contours and fibrosis</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 128.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"172\">\r\n<p class=\"TableText\"><strong>Cistern formation</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Often present</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Absent</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Often present</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Typically absent</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Typically absent</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Absent</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 128.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"172\">\r\n<p class=\"TableText\"><strong>Trophoblast hyperplasia</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Circumferential, marked</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Mild, may be limited to villous tips</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Circumferential, mild to moderate</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Polar, limited to anchoring villi</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">May be present; mild to moderate</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Typically absent</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 128.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"172\">\r\n<p class=\"TableText\"><strong>Trophoblast atypia</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Often marked at the implantation site</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Mild to moderate</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Rare, minimal</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Absent</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Absent</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Absent</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 128.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"172\">\r\n<p class=\"TableText\"><strong>Trophoblastic pseudoinclusions</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Present, irregularly shaped or oval</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Uncommon</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Present, round to oval</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Absent</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Often present</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">May be present</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 128.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"172\">\r\n<p class=\"TableText\"><strong>Fetal (villus) vessels and RBCs</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Absent</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Typically absent</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Often present</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">May be present</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Often present</p>\r\n</td>\r\n<td style=\"width: 95.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Often present</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 128.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"172\">\r\n<p class=\"TableText\"><strong>p57 immunohistochemistry</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Negative in villous stromal cells and cytotrophoblast</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Negative in villous stromal cells and cytotrophoblast</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Positive</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Positive</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Positive</p>\r\n</td>\r\n<td style=\"width: 95.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Positive</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 128.8pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"172\">\r\n<p class=\"TableText\"><strong>Genotyping diagnosis</strong></p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Androgenetic diploid</p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Androgenetic diploid</p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Diandric monogynic triploid</p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Biparental diploid</p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Isolated allelic gain at involved chromosome</p>\r\n</td>\r\n<td style=\"width: 95.75pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Digynic monoandric triploid</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">IUGR, intrauterine growth restriction; RBC, red blood cell.</p>",

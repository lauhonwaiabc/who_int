    "copyright": "",
    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 68.5pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" rowspan=\"2\" width=\"91\">\r\n<p class=\"TableText\"><strong>Histotype</strong></p>\r\n</td>\r\n<td style=\"width: 382.95pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" colspan=\"5\" width=\"511\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Proportion of cases showing immunohistochemical expression</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 68.5pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>PAX8</strong></p>\r\n</td>\r\n<td style=\"width: 68.55pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>WT1</strong></p>\r\n</td>\r\n<td style=\"width: 108.85pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"145\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>p53, abnormal<sup>a</sup></strong></p>\r\n</td>\r\n<td style=\"width: 68.5pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Napsin&nbsp;A</strong></p>\r\n</td>\r\n<td style=\"width: 68.55pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>PR</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 68.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\"><strong>HGSC</strong></p>\r\n</td>\r\n<td style=\"width: 68.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">95%</p>\r\n</td>\r\n<td style=\"width: 68.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">97%</p>\r\n</td>\r\n<td style=\"width: 108.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"145\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">94&ndash;98%</p>\r\n</td>\r\n<td style=\"width: 68.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">1%</p>\r\n</td>\r\n<td style=\"width: 68.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">37&ndash;42%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 68.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\"><strong>LGSC</strong></p>\r\n</td>\r\n<td style=\"width: 68.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">87&ndash;100%</p>\r\n</td>\r\n<td style=\"width: 68.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">98&ndash;100%</p>\r\n</td>\r\n<td style=\"width: 108.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"145\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0%</p>\r\n</td>\r\n<td style=\"width: 68.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0%</p>\r\n</td>\r\n<td style=\"width: 68.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">59&ndash;60%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 68.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\"><strong>EC</strong></p>\r\n</td>\r\n<td style=\"width: 68.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">82%</p>\r\n</td>\r\n<td style=\"width: 68.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">10&ndash;14%</p>\r\n</td>\r\n<td style=\"width: 108.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"145\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">14&ndash;15%</p>\r\n</td>\r\n<td style=\"width: 68.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">3&ndash;8%</p>\r\n</td>\r\n<td style=\"width: 68.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">81&ndash;85%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 68.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\"><strong>CCC</strong></p>\r\n</td>\r\n<td style=\"width: 68.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">95%</p>\r\n</td>\r\n<td style=\"width: 68.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">1%</p>\r\n</td>\r\n<td style=\"width: 108.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"145\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">11&ndash;12%</p>\r\n</td>\r\n<td style=\"width: 68.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">92%</p>\r\n</td>\r\n<td style=\"width: 68.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">5&ndash;7%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 68.5pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\"><strong>MC</strong></p>\r\n</td>\r\n<td style=\"width: 68.5pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">39&ndash;47%<sup>b</sup></p>\r\n</td>\r\n<td style=\"width: 68.55pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0&ndash;1%</p>\r\n</td>\r\n<td style=\"width: 108.85pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"145\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">61&ndash;66%</p>\r\n</td>\r\n<td style=\"width: 68.5pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0&ndash;3%</p>\r\n</td>\r\n<td style=\"width: 68.55pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"91\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0&ndash;4%</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">CCC, clear cell carcinoma; EC, endometrioid carcinoma; HGSC, high-grade serous carcinoma; LGSC, low-grade serous carcinoma; MC, mucinous carcinoma.</p>\r\n<p class=\"TableText\"><sup>a</sup>Abnormal p53 expression (associated with <em>TP53</em> mutation) refers to overexpression (strong nuclear expression involving &gt;&nbsp;80% of tumour cell nuclei), complete absence of expression in tumour cell nuclei with retained internal control, or unequivocal cytoplasmic expression; this is different from wildtype p53 expression (not associated with <em>TP53</em> mutation).</p>\r\n<p class=\"TableText\"><sup>b</sup>PAX8 expression in mucinous carcinoma is often focal and weak.</p>",

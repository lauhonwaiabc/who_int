    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 131.8pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" rowspan=\"2\" width=\"175\">\r\n<p class=\"TableText\"><strong>Tumour type</strong></p>\r\n</td>\r\n<td style=\"width: 466.2pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" colspan=\"10\" width=\"623\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Immunohistochemistry</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 48.15pt; border: none; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"65\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>SALL4</strong></p>\r\n</td>\r\n<td style=\"width: 44.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"59\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>LIN28</strong></p>\r\n</td>\r\n<td style=\"width: 42.85pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"57\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>OCT4</strong></p>\r\n</td>\r\n<td style=\"width: 54.65pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"73\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>KIT (CD117)</strong></p>\r\n</td>\r\n<td style=\"width: 42.5
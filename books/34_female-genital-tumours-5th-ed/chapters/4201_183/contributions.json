    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63245,
        "bookId": 34,
        "chapterId": 183,
        "headingId": 384,
        "headingText": "\r\n<p>Tubal hyperplasia is benign. Clinical attention should be given to the possibility of associated inflammation and ovarian serous borderline tumours.</p>",
        "timestamp": "2020-05-25T15:34:58"
      }

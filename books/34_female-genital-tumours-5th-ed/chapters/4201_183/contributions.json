        "headingId": 379,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2020-05-25T15:34:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 473,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 386,
    "contributions": [
      {
        "pkcontributionId": 63239,
        "bookId": 34,
        "chapterId": 183,
        "headingId": 386,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-25T15:34:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 467,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 380,
    "contributions": [
      {
        "pkcontributionId": 63240,
        "bookId": 34,
        "chapterId": 183,
        "headingId": 380,
        "headingText": "\r\n<p>The most common pattern is the presence of discrete foci of pseudostratification and loss of polarity without nuclear atypia or mitotic activity. When florid and generalized, tubal hyperplasia mimics neoplasia and is associated with acute or chronic salpingitis {7943533}. Tubal hyperplasia is termed papillary tubal hyperplasia when there are papillae lined by hyperplastic tubal cells and small rounded cell clusters within the lumen, with or without psammoma bodies.</p>\r\n",
        "timestamp": "2020-05-25T15:34:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 468,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 381,
    "contributions": [
      {
        "pkcontributionId": 63241,
        "bookId": 34,
        "chapterId": 183,
        "headingId": 381,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-25T15:34:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 469,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 382,
    "contributions": [
      {
        "pkcontributionId": 63242,
        "bookId": 34,

    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 63243,
        "bookId": 34,
        "chapterId": 183,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> foci of pseudostratification; loss of polarity; no evidence of nuclear atypia or mitotic activity.</p>\r\n",
        "timestamp": "2020-05-25T15:34:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

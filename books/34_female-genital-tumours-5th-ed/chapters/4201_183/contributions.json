    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 63235,
        "bookId": 34,
        "chapterId": 183,
        "headingId": 376,
        "headingText": "\r\n<p>Tubal hyperplasia is an incidental finding.</p>\r\n",
        "timestamp": "2020-05-25T15:34:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 63236,
        "bookId": 34,
        "chapterId": 183,
        "headingId": 377,
        "headingText": "\r\n<p>Florid hyperplasia can be seen in association with inflammation, often with mesothelial proliferation {7943533}. This is a common non-neoplastic phenomenon.</p>\r\n",
        "timestamp": "2020-05-25T15:34:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 63237,
        "bookId": 34,
        "chapterId": 183,
        "headingId": 378,
        "headingText": "\r\n<p>There is no association with BRCA mutations.</p>\r\n",
        "timestamp": "2020-05-25T15:34:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,

    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 64892,
        "bookId": 34,
        "chapterId": 317,
        "headingId": 372,
        "headingText": "\r\n<p>2C71.0 &amp; XH0EJ7 Adenocarcinoma of vagina &amp; Squamous cell carcinoma, HPV-positive</p>\r\n",
        "timestamp": "2020-06-08T17:07:56"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,

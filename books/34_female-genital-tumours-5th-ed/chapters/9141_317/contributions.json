[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 64890,
        "bookId": 34,
        "chapterId": 317,
        "headingId": 370,
        "headingText": "\r\n<p>Adenocarcinoma, HPV-associated, is an HPV-associated glandular tumour with stromal invasion and/or exophytic expansile-type invasion. Cervical adenocarcinoma (previous or concurrent) must be excluded.</p>\r\n",
        "timestamp": "2020-06-08T17:07:56"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

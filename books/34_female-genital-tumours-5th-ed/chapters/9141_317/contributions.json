    "headingid": 371,
    "contributions": [
      {
        "pkcontributionId": 64891,
        "bookId": 34,
        "chapterId": 317,
        "headingId": 371,
        "headingText": "\r\n<p>8140/3 Adenocarcinoma NOS</p>\r\n<p>8483/3 Adenocarcinoma, HPV-associated</p>\r\n",
        "timestamp": "2020-06-08T17:07:56"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,

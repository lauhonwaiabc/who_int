      {
        "pkcontributionId": 63502,
        "bookId": 34,
        "chapterId": 216,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-25T15:46:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63503,
        "bookId": 34,
        "chapterId": 216,
        "headingId": 384,
        "headingText": "\r\n<p>These are benign, although rare cases may undergo hyperplasia in response to an ACTH-secreting pituitary tumour (Nelson syndrome) {224075; 7124773; 3374920} or develop into a non-functional tumour {9234389; 24750189; 23603421}.</p>",
        "timestamp": "2020-05-25T15:46:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

      {
        "pkcontributionId": 63501,
        "bookId": 34,
        "chapterId": 216,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> round nests or cords of pale lipid-rich cells resembling the cortex of the adrenal gland.</p>\r\n",
        "timestamp": "2020-05-25T15:46:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

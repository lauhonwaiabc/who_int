        "timestamp": "2020-05-13T17:06:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 62017,
        "bookId": 34,
        "chapterId": 71,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> pseudolobules with epithelioid and spindled cells; hypocellular oedematous, collagenous, or myxoid stroma; thin-walled dilated vessels, often with a haemangiopericytoma-like appearance.</p>\r\n",
        "timestamp": "2020-05-13T17:06:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,

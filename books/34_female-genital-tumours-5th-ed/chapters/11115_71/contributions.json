      {
        "pkcontributionId": 62003,
        "bookId": 34,
        "chapterId": 71,
        "headingId": 370,
        "headingText": "<p>Sclerosing stromal tumour is a benign stromal neoplasm composed of cellular nodules with an admixture of epithelioid and spindled cells, separated by oedematous to collagenous stroma.</p>",
        "timestamp": "2020-07-02T17:56:07"
      }
    ],

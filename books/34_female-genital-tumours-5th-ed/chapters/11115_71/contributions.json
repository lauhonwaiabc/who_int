    "headingPosition": 16,
    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 62018,
        "bookId": 34,
        "chapterId": 71,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T17:06:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 62019,
        "bookId": 34,
        "chapterId": 71,
        "headingId": 384,
        "headingText": "\r\n<p>Only one sclerosing stromal tumour recurrence has been reported, which had capsular disruption, necrosis, and significant mitotic activity {27149006}.</p>",
        "timestamp": "2020-05-13T17:06:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

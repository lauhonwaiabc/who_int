        "pkcontributionId": 62258,
        "bookId": 34,
        "chapterId": 86,
        "headingId": 370,
        "headingText": "\r\n<p>Dysgerminoma is a primitive germ cell tumour composed of cells showing no specific differentiation.</p>\r\n",
        "timestamp": "2020-05-13T17:51:50"
      }
    ],

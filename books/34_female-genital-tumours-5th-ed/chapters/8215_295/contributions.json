        "pkcontributionId": 64326,
        "bookId": 34,
        "chapterId": 295,
        "headingId": 370,
        "headingText": "\r\n<p>Microglandular hyperplasia is a non-neoplastic hyperplastic endocervical lesion comprising closely packed, small glands lined by mucinous epithelium.</p>\r\n",
        "timestamp": "2020-04-28T15:01:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

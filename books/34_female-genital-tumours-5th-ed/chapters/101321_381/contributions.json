[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 65285,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 370,
        "headingText": "\r\n<p>Bartholin gland cyst is a cyst involving the Bartholin gland/duct.</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 371,
    "contributions": [
      {
        "pkcontributionId": 65286,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 371,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 65287,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 372,
        "headingText": "\r\n<p>GA03.1 Cyst of Bartholin gland</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 65288,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 373,
        "headingText": "\r\n<p><em>Acceptable:</em> Bartholin duct cyst</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 374,
    "contributions": [
      {
        "pkcontributionId": 65289,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 374,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 462,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 375,
    "contributions": [
      {
        "pkcontributionId": 65290,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 375,
        "headingText": "\r\n<p>Bartholin gland cyst arises in the region of the Bartholin glands (bilateral symmetrically located glands in the posterolateral introitus).</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 65291,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 376,
        "headingText": "\r\n<p>Cysts may be asymptomatic; however, as they enlarge they may become noticeable as a painless mass. If they become infected or large they may become painful {26195958}.</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 65292,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 377,
        "headingText": "\r\n<p>These are relatively common lesions.</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 65293,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 378,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 379,
    "contributions": [
      {
        "pkcontributionId": 65294,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 379,
        "headingText": "\r\n<p>Cysts form when the Bartholin duct becomes obstructed.</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 473,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 386,
    "contributions": [
      {
        "pkcontributionId": 65295,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 386,
        "headingText": "\r\n<p>Grossly, these are cystic lesions with variably thick walls; their size can vary.</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 467,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 380,
    "contributions": [
      {
        "pkcontributionId": 65296,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 380,
        "headingText": "\r\n<p>Bartholin gland/duct cysts are lined by transitional or squamous epithelium, typically with normal Bartholin gland tissue in the wall. Inflammation of the lining is common, as is ulceration and abscess formation.</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 468,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 381,
    "contributions": [
      {
        "pkcontributionId": 65297,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 381,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 469,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 382,
    "contributions": [
      {
        "pkcontributionId": 65298,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 382,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 65299,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> a cyst lined by squamous or transitional epithelium and located in the region of the Bartholin gland.</p>\r\n<p><em>Desirable:</em> normal Bartholin gland tissue in the wall.</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 65300,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 65301,
        "bookId": 34,
        "chapterId": 381,
        "headingId": 384,
        "headingText": "\r\n<p>These are benign lesions but may recur after marsupialization or excision.</p>",
        "timestamp": "2020-06-09T16:28:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
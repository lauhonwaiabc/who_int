        "timestamp": "2020-06-12T17:40:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 66103,
        "bookId": 34,
        "chapterId": 453,
        "headingId": 384,
        "headingText": "\r\n<p>The prognosis of blue naevus is excellent. As in other locations, transformation of a genital cellular blue naevus to melanoma can exceptionally occur {9700383}.</p>",
        "timestamp": "2020-06-12T17:40:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
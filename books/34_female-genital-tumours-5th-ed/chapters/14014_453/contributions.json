[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 66087,
        "bookId": 34,
        "chapterId": 453,
        "headingId": 370,
        "headingText": "\r\n<p>Blue naevus is a benign subepithelial melanocytic neoplasm with a component of characteristic dendritic cells.</p>\r\n",
        "timestamp": "2020-06-12T17:40:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,

        "headingText": "\r\n<p><em>Essential:</em> germline mutation of <em>DICER1</em>.</p>\r\n",
        "timestamp": "2020-06-23T16:43:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,

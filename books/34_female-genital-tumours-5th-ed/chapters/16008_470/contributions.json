    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 66291,
        "bookId": 34,
        "chapterId": 470,
        "headingId": 370,
        "headingText": "\r\n<p><em>DICER1</em> syndrome is an autosomal dominant disorder characterized by the occurrence of diverse rare neoplasms, including pleuropulmonary blastoma, thyroid cancers, paediatric cystic nephroma, embryonal rhabdomyosarcoma of the uterine cervix, and ovarian Sertoli&ndash;Leydig cell tumour.</p>\r\n",
        "timestamp": "2020-06-23T16:43:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

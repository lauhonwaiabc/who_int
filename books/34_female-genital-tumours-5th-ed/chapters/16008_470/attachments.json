/td>\r\n<td style=\"width: 228.4pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"305\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Yes, &lt;&nbsp;5% of cases</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 233.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"3\" width=\"312\">\r\n<p class=\"TableText\"><strong>Moderate-frequency phenotypes</strong></p>\r\n</td>\r\n<td style=\"width: 154.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"206\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 86.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 228.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"305\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 14.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"19\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"293\">\r\n<p class=\"TableText\">Cervix embryonal rhabdomyosarcoma</p>\r\n</td>\r\n<td style=\"width: 154.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"206\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">4&ndash;45&nbsp;years (10&ndash;20&nbsp;years)</p>\r\n</td>\r\n<td style=\"width: 86.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">M</p>\r\n</td>\r\n<td style=\"width: 228.4pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"305\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">None observed</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 233.9pt;
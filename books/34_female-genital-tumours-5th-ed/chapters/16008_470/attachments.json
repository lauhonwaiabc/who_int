    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 703.3pt; border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 233.9pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" colspan=\"3\" width=\"312\">\r\n<p class=\"TableText\"><strong>Phenotype and relative frequency</strong></p>\r\n</td>\r\n<td style=\"width: 154.5pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"206\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Approximate ages of susceptibility range (peak)</strong></p>\r\n</td>\r\n<td style=\"width: 86.5pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Malignant&nbsp;(M) or benign&nbsp;(B)</strong></p>\r\n</td>\r\n<td style=\"width: 228.4pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"305\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Deaths associated in </strong><em><strong>DICER1</strong></em><strong>-mutated cases?</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 233.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"3\" width=\"312\">\r\n<p class=\"TableText\"><strong>Most frequent phenotypes</strong></p>\r\n</td>\r\n<td style=\"width: 154.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"206\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 86.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"115\">\r\n<p class=\"TableText\" style=\"t
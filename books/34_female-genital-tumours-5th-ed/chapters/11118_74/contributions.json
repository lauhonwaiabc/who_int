  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 62068,
        "bookId": 34,
        "chapterId": 74,
        "headingId": 385,
        "headingText": "<p><em>Essential:</em>&nbsp;well-circumscribed tumour centred in the ovarian hilus, consisting of bland steroid cells.</p>\r\n<p><em>Desirable:</em> cytoplasmic Reinke crystals.</p>",
        "timestamp": "2020-07-23T15:51:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

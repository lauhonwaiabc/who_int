        "bookId": 34,
        "chapterId": 74,
        "headingId": 374,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-05-13T17:09:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 462,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 375,
    "contributions": [
      {
        "pkcontributionId": 62059,
        "bookId": 34,
        "chapterId": 74,
        "headingId": 375,
        "headingText": "<p>They are centred in and predominantly confined to the ovarian hilus, sometimes with extension into the ovarian stroma {2553628}.</p>",
        "timestamp": "2020-07-23T15:51:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 62060,
        "bookId": 34,
        "chapterId": 74,
        "headingId": 376,
        "headingText": "\r\n<p>The usual presentation is with endocrine manifestations, most commonly androgenic and rarely estrogenic {2553628}.</p>\r\n",
        "timestamp": "2020-05-13T17:09:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 62061,
        "bookId": 34,
        "chapterId": 74,
        "headingId": 377,
        "headingText": "\r\n<p>The average patient age is 58&nbsp;years (range: 32&ndash;82&nbsp;years) {2553628}.</p>\r\n",
        "timestamp": "2020-05-13T17:09:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 62062,
        "bookId": 34,
        "chapterId": 74,
        "headingId": 378,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2020-05-13T17:09:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 379,
    "contributions": [
      {
        "pkcontributionId": 62063,

    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 62070,
        "bookId": 34,
        "chapterId": 74,
        "headingId": 384,
        "headingText": "\r\n<p>If strict diagnostic criteria are used, Leydig cell tumours are almost always benign.</p>",
        "timestamp": "2020-05-13T17:09:01"
      }

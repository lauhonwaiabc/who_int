[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 62054,
        "bookId": 34,
        "chapterId": 74,
        "headingId": 370,
        "headingText": "\r\n<p>Leydig cell tumour is a benign steroid cell tumour confined to or predominantly located in the ovarian hilus, which often contains cytoplasmic Reinke crystals.</p>\r\n",
        "timestamp": "2020-05-13T17:09:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,

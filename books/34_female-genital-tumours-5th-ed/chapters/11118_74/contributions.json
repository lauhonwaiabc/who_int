    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 62057,
        "bookId": 34,
        "chapterId": 74,
        "headingId": 373,
        "headingText": "\r\n<p><em>Not recommended:</em> hilus cell tumour</p>\r\n",
        "timestamp": "2020-05-13T17:09:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 61941,
        "bookId": 34,
        "chapterId": 63,
        "headingId": 376,
        "headingText": "<p>Patients are typically early postmenopausal, with the usual signs and symptoms of an adnexal mass, but some patients may present with vaginal bleeding or incidentally {12360039; 20179434}.</p>",
        "timestamp": "2020-07-02T17:55:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",

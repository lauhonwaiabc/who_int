        "pkcontributionId": 61969,
        "bookId": 34,
        "chapterId": 69,
        "headingId": 370,
        "headingText": "\r\n<p>Thecoma is an ovarian stromal tumour composed predominantly of cells resembling theca cells.</p>\r\n",

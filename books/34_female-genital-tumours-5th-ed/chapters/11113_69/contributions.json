      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 61983,
        "bookId": 34,
        "chapterId": 69,
        "headingId": 385,
        "headingText": "<p><em>Essential:</em>&nbsp;predominant population of stromal cells with bland ovoid to round nuclei with appreciable pale-grey cytoplasm.</p>\r\n<p><em>Desirable:</em> reticulin surrounding individual cells; positivity for inhibin, calretinin, and other sex cord markers.</p>",
        "timestamp": "2020-07-23T15:46:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 61984,
        "bookId": 34,
        "chapterId": 69,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T17:03:36"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 61985,
        "bookId": 34,
        "chapterId": 69,
        "headingId": 384,
        "headingText": "\r\n<p>Thecomas are almost always benign. Rare malignant thecomas have been reported, but these may be misdiagnosed cases of other neoplasms {228839}.</p>",
        "timestamp": "2020-05-13T17:03:36"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

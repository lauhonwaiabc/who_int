    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 63507,
        "bookId": 34,
        "chapterId": 220,
        "headingId": 372,
        "headingText": "\r\n<p>GA16.0 Endometrial glandular hyperplasia</p>\r\n",
        "timestamp": "2020-06-05T16:46:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 63508,
        "bookId": 34,
        "chapterId": 220,
        "headingId": 373,
        "headingText": "\r\n<p><em>Acceptable:</em> benign endometrial hyperplasia; simple endometrial hyperplasia without atypia; complex endometrial hyperplasia without atypia</p>\r\n",
        "timestamp": "2020-06-05T16:46:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 374,
    "contributions": [
      {

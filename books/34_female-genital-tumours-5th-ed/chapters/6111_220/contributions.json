[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63505,
        "bookId": 34,
        "chapterId": 220,
        "headingId": 370,
        "headingText": "<p>Endometrial hyperplasia without atypia is a proliferation of endometrial glands of irregular size and shape without significant cytological atypia.</p>",
        "timestamp": "2020-07-24T16:12:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

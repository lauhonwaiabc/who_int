        "pkcontributionId": 64188,
        "bookId": 34,
        "chapterId": 286,
        "headingId": 370,
        "headingText": "\r\n<p>Atrophy of the uterine cervix is loss or lack of squamous epithelial maturation associated with states of estrogen deficiency.</p>\r\n",
        "timestamp": "2020-04-28T14:42:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

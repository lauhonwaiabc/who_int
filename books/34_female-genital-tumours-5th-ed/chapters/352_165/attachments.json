    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 523.55pt; border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 41.5pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"55\">\r\n<p class=\"TableText\"><strong>Stage</strong></p>\r\n</td>\r\n<td style=\"width: 482.05pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"643\">\r\n<p class=\"TableText\"><strong>Criteria</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 41.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"55\">\r\n<p class=\"TableText\"><strong>pM1a</strong></p>\r\n</td>\r\n<td style=\"width: 482.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"643\">\r\n<p class=\"TableText\">Acellular mucin on peritoneal surfaces other than the appendix/mesoappendix</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 41.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"55\">\r\n<p class=\"TableText\"><strong>pM1b</strong></p>\r\n</td>\r\n<td style=\"width: 482.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"643\">\r\n<p class=\"TableText\">Cellular mucinous tumour deposits on peritoneal surfaces other than the appendix/mesoappendix</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 41.5pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"55\">\r\n<p class=\"TableText\"><strong>pM1c</strong></p>\r\n</td>\r\n<td style=\"width: 482.05pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"643\">\r\n<p class=\"TableText\">Mucinous tumour deposits to sites other than the peritoneum</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

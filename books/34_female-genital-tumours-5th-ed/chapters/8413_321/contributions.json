[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 64666,
        "bookId": 34,
        "chapterId": 321,
        "headingId": 370,
        "headingText": "\r\n<p>Adenosarcoma is a biphasic neoplasm composed of a benign epithelial component and a sarcomatous, usually low-grade, stromal component.</p>\r\n",
        "timestamp": "2020-04-28T15:15:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 371,
    "contributions": [
      {
        "pkcontributionId": 64667,
        "bookId": 34,
        "chapterId": 321,
        "headingId": 371,
        "headingText": "\r\n<p>8933/3 Adenosarcoma</p>\r\n",
        "timestamp": "2020-04-28T15:15:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 64668,
        "bookId": 34,
        "chapterId": 321,
        "headingId": 372,
        "headingText": "\r\n<p>2C77.Y &amp; XH5544 Other specified malignant neoplasms of cervix uteri &amp; Adenosarcoma</p>\r\n",
        "timestamp": "2020-04-28T15:15:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,

  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 63681,
        "bookId": 34,
        "chapterId": 232,
        "headingId": 376,
        "headingText": "\r\n<p>Most women with endometrial metaplasia are postmenopausal. Some have received oral estrogen therapy within 3&nbsp;months of curettage or endometrial biopsy {7212146}.</p>\r\n",
        "timestamp": "2020-06-05T16:56:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",

  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 63689,
        "bookId": 34,
        "chapterId": 232,
        "headingId": 385,
        "headingText": "<p><em>Essential:</em> A non-neoplastic endometrial lesion or a non-neoplastic component in a neoplastic endometrial lesion; identification of individual features of each histological pattern of endometrial metaplasia as described under <em>Histopathology</em> above.</p>\r\n<p><em>Desirable:</em> Immunoprofiling in selected cases.</p>",
        "timestamp": "2020-07-15T14:24:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 66274,
        "bookId": 34,
        "chapterId": 469,
        "headingId": 370,
        "headingText": "<p>Carney complex (CNC) is a multiple neoplasia syndrome characterized by pigmented lesions of the skin and mucosa, myxomatous tumours of the heart and skin, and multiple endocrine and non-endocrine neoplasms.</p>",
        "timestamp": "2020-07-16T12:43:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,

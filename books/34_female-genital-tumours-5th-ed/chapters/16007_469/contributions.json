      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 66290,
        "bookId": 34,
        "chapterId": 469,
        "headingId": 384,
        "headingText": "<p>Most of the gynaecological lesions associated with CNC are benign.</p>",
        "timestamp": "2020-07-16T12:45:28"
      }

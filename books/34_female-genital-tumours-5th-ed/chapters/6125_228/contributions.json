    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63607,
        "bookId": 34,
        "chapterId": 228,
        "headingId": 370,
        "headingText": "\r\n<p>Mixed carcinoma is a carcinoma composed of two or more discrete histological types of endometrial carcinoma, where at least one component is either serous or clear cell.</p>\r\n",
        "timestamp": "2020-06-05T16:53:21"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

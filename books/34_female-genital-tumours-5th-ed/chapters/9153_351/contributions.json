[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 65043,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 370,
        "headingText": "\r\n<p>Adenosquamous carcinoma is a malignant epithelial tumour exhibiting both squamous and glandular differentiation.</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 371,
    "contributions": [
      {
        "pkcontributionId": 65044,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 371,
        "headingText": "\r\n<p>8560/3 Adenosquamous carcinoma</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 65045,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 372,
        "headingText": "\r\n<p>2C71.Y &amp; XH7873 Other specified malignant neoplasms of vagina &amp; Adenosquamous carcinoma</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 65046,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 373,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 374,
    "contributions": [
      {
        "pkcontributionId": 65047,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 374,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 462,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 375,
    "contributions": [
      {
        "pkcontributionId": 65048,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 375,
        "headingText": "\r\n<p>The most common location is the upper third of the vagina, especially the anterior wall {25594143; 11812092}.</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 65049,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 376,
        "headingText": "\r\n<p>The mean patient age at presentation is 55&nbsp;years, but these neoplasms may also occur in younger patients {25594143; 4720400; 14155003; 3345952}. Patients typically present with painless vaginal bleeding and discharge.</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 65050,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 377,
        "headingText": "\r\n<p>This tumour is extremely rare, representing a very small percentage of primary vaginal carcinomas {25594143}.</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 65051,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 378,
        "headingText": "\r\n<p>Some of these tumours are associated with infection with high-risk HPV.</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 379,
    "contributions": [
      {
        "pkcontributionId": 65052,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 379,
        "headingText": "\r\n<p>In&nbsp;situ hybridization or PCR can be used to detect high-risk HPV types.</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 473,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 386,
    "contributions": [
      {
        "pkcontributionId": 65053,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 386,
        "headingText": "\r\n<p>The gross appearance is that of a tumorous mass.</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 467,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 380,
    "contributions": [
      {
        "pkcontributionId": 65054,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 380,
        "headingText": "<p>The histopathological features are similar to those of cervical adenosquamous carcinoma (see <a style=\"cursor:pointer\" href=\"/chaptercontent/34/309\" target=\"_blank\">section </a><em>Adenosquamous and mucoepidermoid carcinomas of the uterine cervix</em>). Microscopically, both malignant squamous and glandular elements should be identifiable. In HPV-associated tumours, both components usually exhibit diffuse immunoreactivity for p16. The squamous component is usually positive for p63 and p40, and the glandular component for CK7, PAX8, and CEA.</p>",
        "timestamp": "2020-08-12T12:15:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 468,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 381,
    "contributions": [
      {
        "pkcontributionId": 65055,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 381,
        "headingText": "<p>See <a style=\"cursor:pointer\" href=\"/chaptercontent/34/309\" target=\"_blank\">section </a><em>Adenosquamous and mucoepidermoid carcinomas of the uterine cervix</em>&nbsp;for the cervical equivalent.</p>",
        "timestamp": "2020-07-10T13:57:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 469,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 382,
    "contributions": [
      {
        "pkcontributionId": 65056,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 382,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 65057,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> malignant glandular and squamous elements.</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 65058,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 383,
        "headingText": "\r\n<p>The staging is the same as for other vaginal neoplasms.</p>\r\n",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 65059,
        "bookId": 34,
        "chapterId": 351,
        "headingId": 384,
        "headingText": "\r\n<p>This tumour is clinically aggressive and may develop distant metastases (especially to the lungs); the overall prognosis is poor {25594143; 4720400; 3345952}.</p>",
        "timestamp": "2020-06-08T17:13:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
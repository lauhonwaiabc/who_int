        "pkcontributionId": 64292,
        "bookId": 34,
        "chapterId": 293,
        "headingId": 370,
        "headingText": "<p>A nabothian cyst is a mucus-filled cystic structure in the cervical wall, lined by endocervical epithelium.</p>",

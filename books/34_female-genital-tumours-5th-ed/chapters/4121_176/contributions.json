    "headingid": 371,
    "contributions": [
      {
        "pkcontributionId": 63145,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 371,
        "headingText": "\r\n<p>8442/1 Serous borderline tumour NOS</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 63146,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 372,
        "headingText": "\r\n<p>2C74.Y &amp; XH3ZK9 Other specified malignant neoplasms of fallopian tube &amp; Serous cystadenoma, borderline malignancy</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 63147,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 373,
        "headingText": "\r\n<p><em>Not recommended:</em> atypical proliferative serous tumour</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 374,
    "contributions": [
      {
        "pkcontributionId": 63148,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 374,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 462,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 375,
    "contributions": [
      {
        "pkcontributionId": 63149,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 375,
        "headingText": "\r\n<p>Fallopian tube</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 63150,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 376,
        "headingText": "\r\n<p>Patients usually present with abdominal pain and range in age from 22 to 83&nbsp;years (mean: 42&nbsp;years) {16212662}.</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 63151,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 377,
        "headingText": "\r\n<p>SBT is a rare entity, with &lt;&nbsp;20&nbsp;cases reported in the literature {20232206}.</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 63152,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 378,
        "headingText": "\r\n<p>SBT may arise from papillary hyperplasia of the fallopian tube mucosa {23240669}.</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 379,
    "contributions": [
      {
        "pkcontributionId": 63153,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 379,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 473,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 386,
    "contributions": [
      {
        "pkcontributionId": 63154,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 386,
        "headingText": "\r\n<p>Tumours can range in size from 2 to 23&nbsp;cm (mean: 4.5&nbsp;cm), generally located at the fimbrial end {11109174; 25105110}.</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 467,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 380,
    "contributions": [
      {
        "pkcontributionId": 63155,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 380,
        "headingText": "\r\n<p>SBTs of the fallopian tube closely resemble their ovarian counterparts. No unequivocal cases of low-grade serous carcinoma of the fallopian tube have been described to date {21997682; 28700429}.</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 468,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 381,
    "contributions": [
      {
        "pkcontributionId": 63156,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 381,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 469,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 382,
    "contributions": [
      {
        "pkcontributionId": 63157,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 382,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 63158,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> papillae occupying a variable extent of a cyst lined by stratified epithelium.</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 63159,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 383,
        "headingText": "\r\n<p>Most tumours are treated conservatively, with or without staging biopsies.</p>\r\n",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63160,
        "bookId": 34,
        "chapterId": 176,
        "headingId": 384,
        "headingText": "\r\n<p>The outcome is excellent with surgical removal alone.</p>",
        "timestamp": "2020-05-25T15:30:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

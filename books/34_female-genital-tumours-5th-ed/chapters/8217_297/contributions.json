    "headingid": 381,
    "contributions": [
      {
        "pkcontributionId": 64372,
        "bookId": 34,
        "chapterId": 297,
        "headingId": 381,
        "headingText": "\r\n<p>The findings on cervicovaginal smear are nonspecific {7550997}.</p>\r\n",
        "timestamp": "2020-04-28T15:02:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "pkcontributionId": 64365,
        "bookId": 34,
        "chapterId": 297,
        "headingId": 375,
        "headingText": "\r\n<p>Diffuse laminar endocervical hyperplasia typically involves the inner third of the cervical wall {1746679}.</p>\r\n",
        "timestamp": "2020-04-28T15:02:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

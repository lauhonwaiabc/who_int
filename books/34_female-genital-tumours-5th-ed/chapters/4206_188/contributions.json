        "bookId": 34,
        "chapterId": 188,
        "headingId": 375,
        "headingText": "\r\n<p>Fallopian tube</p>\r\n",
        "timestamp": "2020-05-25T15:37:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 63320,
        "bookId": 34,
        "chapterId": 188,
        "headingId": 376,
        "headingText": "\r\n<p>This is an underreported entity. It is mostly an incidental finding. It can be seen in association with gynaecological neoplasia. This may be a result of extensive sampling of the fallopian tube {25025442; 21131836}. Mucinous metaplasia is usually unilateral and unifocal {21131836}.</p>\r\n",
        "timestamp": "2020-05-25T15:37:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 63321,
        "bookId": 34,
        "chapterId": 188,
        "headingId": 377,
        "headingText": "\r\n<p>The epidemiology is unknown.</p>\r\n",
        "timestamp": "2020-05-25T15:37:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 63322,
        "bookId": 34,
        "chapterId": 188,
        "headingId": 378,
        "headingText": "\r\n<p>Mucinous metaplasia may occur in association with Peutz&ndash;Jeghers syndrome {21615613}.</p>\r\n",
        "timestamp": "2020-05-25T15:37:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,
    "bookid": 34,

    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 62035,
        "bookId": 34,
        "chapterId": 72,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T17:07:13"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 62036,
        "bookId": 34,
        "chapterId": 72,
        "headingId": 384,
        "headingText": "\r\n<p>Of approximately 40&nbsp;reported tumours, outcome has been uneventful in all cases except one, in which pelvic recurrence was detected 9&nbsp;years after initial diagnosis {29458068}.</p>",
        "timestamp": "2020-05-13T17:07:13"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

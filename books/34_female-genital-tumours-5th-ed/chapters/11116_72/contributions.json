    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 62034,
        "bookId": 34,
        "chapterId": 72,
        "headingId": 385,
        "headingText": "<p><em>Essential:</em>&nbsp;stromal neoplasm with variable microcystic morphology.</p>\r\n<p><em>Desirable:</em> diffuse nuclear &beta;-catenin and cyclin&nbsp;D1 immunoreactivity; lack of expression of inhibin and calretinin.</p>",
        "timestamp": "2020-07-23T15:49:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,

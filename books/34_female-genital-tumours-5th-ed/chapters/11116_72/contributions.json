        "pkcontributionId": 62020,
        "bookId": 34,
        "chapterId": 72,
        "headingId": 370,
        "headingText": "\r\n<p>Microcystic stromal tumour is an ovarian stromal tumour characterized by a distinctive microcystic appearance.</p>\r\n",
        "timestamp": "2020-05-13T17:07:13"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

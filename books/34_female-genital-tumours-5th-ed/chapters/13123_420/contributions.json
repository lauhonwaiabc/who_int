[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 65696,
        "bookId": 34,
        "chapterId": 420,
        "headingId": 370,
        "headingText": "\r\n<p>Superficial myofibroblastoma is a benign, well-circumscribed, unencapsulated spindle cell lesion of the lower genital tract, with a patternless architecture, a grenz zone, and finely collagenous stroma.</p>\r\n",
        "timestamp": "2020-06-12T17:22:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63057,
        "bookId": 34,
        "chapterId": 161,
        "headingId": 384,
        "headingText": "\r\n<p>This lesion is benign and usually does not require treatment unless symptomatic {21867352}.</p>",
        "timestamp": "2020-05-19T17:08:27"
      }
    ],

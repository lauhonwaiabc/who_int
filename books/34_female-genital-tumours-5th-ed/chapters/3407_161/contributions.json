        "chapterId": 161,
        "headingId": 371,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-05-19T17:08:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {

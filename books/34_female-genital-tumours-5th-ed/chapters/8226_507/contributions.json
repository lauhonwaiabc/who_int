        "bookId": 34,
        "chapterId": 507,
        "headingId": 371,
        "headingText": "<p>8310/3 Adenocarcinoma, HPV-independent, clear cell type</p>",
        "timestamp": "2020-06-15T12:14:32"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 64532,
        "bookId": 34,
        "chapterId": 507,
        "headingId": 372,
        "headingText": "\r\n<p>2C77.1 &amp; XH6L02 Adenocarcinoma of cervix uteri &amp; Clear cell adenocarcinoma NOS</p>\r\n",
        "timestamp": "2020-04-28T15:08:51"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,

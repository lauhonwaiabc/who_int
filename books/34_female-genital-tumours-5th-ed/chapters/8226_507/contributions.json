[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 64530,
        "bookId": 34,
        "chapterId": 507,
        "headingId": 370,
        "headingText": "<p>Clear cell carcinoma is a malignant glandular neoplasm composed of uniform, clear or eosinophilic, flat or cuboidal cells arranged in one or more patterns: tubulocystic, papillary, solid.</p>",
        "timestamp": "2020-06-01T15:14:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,

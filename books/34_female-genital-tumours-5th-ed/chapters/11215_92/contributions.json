      {
        "pkcontributionId": 62326,
        "bookId": 34,
        "chapterId": 92,
        "headingId": 370,
        "headingText": "\r\n<p>Mixed germ cell tumour is a tumour composed of two or more malignant germ cell components.</p>\r\n",
        "timestamp": "2020-05-13T17:53:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

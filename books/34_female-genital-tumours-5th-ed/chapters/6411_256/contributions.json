      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63930,
        "bookId": 34,
        "chapterId": 256,
        "headingId": 384,
        "headingText": "\r\n<p>These are benign, and patients have uneventful outcomes after hysterectomy, myomectomy, or polypectomy {10907166}.</p>",
        "timestamp": "2020-06-05T17:10:19"
      }
    ],

[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63914,
        "bookId": 34,
        "chapterId": 256,
        "headingId": 370,
        "headingText": "<p>Adenomyoma is a tumour composed of an admixture of morphologically benign endometrioid-type glands, endometrioid-type stroma, and smooth muscle.</p>",
        "timestamp": "2020-07-24T16:24:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "pkcontributionId": 63928,
        "bookId": 34,
        "chapterId": 256,
        "headingId": 385,
        "headingText": "<p><em>Essential:</em>&nbsp;nodule or polyp composed of endometrioid-type glands, endometrioid-type stroma, and smooth muscle.</p>",
        "timestamp": "2020-07-24T16:26:08"
      }

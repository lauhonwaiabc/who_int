    "contributions": [
      {
        "pkcontributionId": 65645,
        "bookId": 34,
        "chapterId": 316,
        "headingId": 370,
        "headingText": "\r\n<p>Postoperative spindle cell nodule is a benign, presumably non-neoplastic, spindle cell proliferation that may be mistaken for sarcoma.</p>\r\n",
        "timestamp": "2020-06-12T17:20:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 65648,
        "bookId": 34,
        "chapterId": 316,
        "headingId": 373,
        "headingText": "\r\n<p><em>Not recommended:</em> postoperative pseudosarcoma; inflammatory pseudotumour</p>\r\n",
        "timestamp": "2020-06-12T17:20:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

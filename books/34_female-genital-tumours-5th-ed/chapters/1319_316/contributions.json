        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-06-12T17:20:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 65659,
        "bookId": 34,
        "chapterId": 316,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> a prior surgical procedure; loose intersecting fascicles of spindle cells; a chronic inflammatory infiltrate.</p>\r\n",
        "timestamp": "2020-06-12T17:20:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

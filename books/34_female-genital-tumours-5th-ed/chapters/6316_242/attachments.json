    "chapterId": 242,
    "fileId": 13033,
    "type": "WSI",
    "diagnosis": "Uterine epithelioid leiomyosarcoma",
    "title": "",
    "legend": "Uterine mass with irregular interface with the myometrium, composed of round to polygonal cells with granular eosinophilic cytoplasm. Notice the presence of significant nuclear atypia and easily found mitoses. Cells were positive for desmin and h-caldesmon by immunohistochemistry.",
    "source": "Carlos Parra-Herran",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/13033.dzi",

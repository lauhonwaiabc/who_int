        "pkcontributionId": 61542,
        "bookId": 34,
        "chapterId": 12,
        "headingId": 370,
        "headingText": "\r\n<p>Low-grade serous carcinoma (LGSC) is an invasive serous neoplasm with low-grade malignant features.</p>\r\n",
        "timestamp": "2020-05-13T14:44:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

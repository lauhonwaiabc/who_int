    "contributions": [
      {
        "pkcontributionId": 63024,
        "bookId": 34,
        "chapterId": 160,
        "headingId": 370,
        "headingText": "<p>Ectopic decidua is the extrauterine location of decidual tissue.</p>",
        "timestamp": "2020-06-19T16:07:52"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,

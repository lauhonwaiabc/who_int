      {
        "pkcontributionId": 63039,
        "bookId": 34,
        "chapterId": 160,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-19T15:22:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63040,
        "bookId": 34,
        "chapterId": 160,
        "headingId": 384,
        "headingText": "\r\n<p>It is benign and usually regresses postpartum {26926901}.</p>",
        "timestamp": "2020-05-19T15:22:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

        "pkcontributionId": 62496,
        "bookId": 34,
        "chapterId": 516,
        "headingId": 370,
        "headingText": "\r\n<p>Solid pseudopapillary tumour is a tumour with varied histological features, resembling its pancreatic counterpart.</p>\r\n",

  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 62512,
        "bookId": 34,
        "chapterId": 516,
        "headingId": 384,
        "headingText": "\r\n<p>With rare exceptions {21778097}, the tumours are confined to the ovary and benign {20871224; 21979589; 28463908}.</p>",

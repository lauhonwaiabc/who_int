    "contributions": [
      {
        "pkcontributionId": 62617,
        "bookId": 34,
        "chapterId": 120,
        "headingId": 372,
        "headingText": "\r\n<p>2F32.Y &amp; XH40J2 Other specified benign neoplasm of ovary &amp; Luteoma NOS</p>\r\n",
        "timestamp": "2020-05-14T11:38:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 62618,
        "bookId": 34,
        "chapterId": 120,
        "headingId": 373,
        "headingText": "\r\n<p><em>Acceptable:</em> luteoma of pregnancy</p>\r\n",
        "timestamp": "2020-05-14T11:38:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,
    "bookid": 34,
    "headingType": 2,

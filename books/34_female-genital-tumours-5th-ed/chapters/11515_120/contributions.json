[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 62615,
        "bookId": 34,
        "chapterId": 120,
        "headingId": 370,
        "headingText": "\r\n<p>Pregnancy luteoma is a hyperplastic proliferation of large luteinized ovarian cells during pregnancy.</p>\r\n",
        "timestamp": "2020-05-14T11:38:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

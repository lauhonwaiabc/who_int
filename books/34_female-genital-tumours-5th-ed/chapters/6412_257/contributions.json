[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63931,
        "bookId": 34,
        "chapterId": 257,
        "headingId": 370,
        "headingText": "\r\n<p>Atypical polypoid adenomyoma is a polypoid lesion composed of atypical, architecturally complex endometrial glands set within benign myomatous or fibromyomatous stroma.</p>\r\n",
        "timestamp": "2020-06-05T17:10:54"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,

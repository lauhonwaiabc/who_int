      {
        "pkcontributionId": 64736,
        "bookId": 34,
        "chapterId": 332,
        "headingId": 370,
        "headingText": "\r\n<p>Tubulosquamous polyp is a benign polyp composed of squamous and tubular elements within a variably collagenous stroma.</p>\r\n",
        "timestamp": "2020-06-08T16:56:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

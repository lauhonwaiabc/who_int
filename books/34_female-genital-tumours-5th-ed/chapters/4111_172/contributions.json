        "bookId": 34,
        "chapterId": 172,
        "headingId": 382,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-25T15:29:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 63141,
        "bookId": 34,
        "chapterId": 172,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> adenofibroma: benign, biphasic tumour (epithelial-stromal); papilloma: papillary proliferation attached to the tubal mucosa.</p>\r\n",
        "timestamp": "2020-05-25T15:29:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "timestamp": "2020-05-25T15:29:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63143,
        "bookId": 34,
        "chapterId": 172,
        "headingId": 384,
        "headingText": "\r\n<p>Both adenofibroma and papilloma have a benign clinical course.</p>",
        "timestamp": "2020-05-25T15:29:55"
      }
    ],

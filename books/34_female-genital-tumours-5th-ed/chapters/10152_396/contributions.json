        "chapterId": 396,
        "headingId": 372,
        "headingText": "\r\n<p>2C70 &amp; XH5LY3 Malignant neoplasms of vulva &amp; Sweat gland adenocarcinoma</p>\r\n",
        "timestamp": "2020-06-09T16:32:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

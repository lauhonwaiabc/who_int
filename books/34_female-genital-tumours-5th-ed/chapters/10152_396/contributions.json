        "bookId": 34,
        "chapterId": 396,
        "headingId": 373,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-06-09T16:32:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 374,
    "contributions": [
      {
        "pkcontributionId": 65374,
        "bookId": 34,
        "chapterId": 396,
        "headingId": 374,
        "headingText": "\r\n<p>Apocrine adenocarcinoma; eccrine adenocarcinoma; porocarcinoma NOS; adenoid cystic carcinoma</p>\r\n",
        "timestamp": "2020-06-09T16:32:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 462,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 375,
    "contributions": [
      {
        "pkcontributionId": 65375,
        "bookId": 34,
        "chapterId": 396,
        "headingId": 375,
        "headingText": "\r\n<p>Carcinomas of sweat gland origin most commonly arise in the labia majora {20606537}. Porocarcinomas arise from pre-existing poromas, derived from the intradermal portion of the sweat apparatus.</p>\r\n",
        "timestamp": "2020-06-09T16:32:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 65376,
        "bookId": 34,
        "chapterId": 396,
        "headingId": 376,
        "headingText": "\r\n<p>Most patients are perimenopausal or postmenopausal {20606537; 22407069}. Typical presentation is with a vulvar mass {20606537}.</p>\r\n",
        "timestamp": "2020-06-09T16:32:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 65377,
        "bookId": 34,
        "chapterId": 396,
        "headingId": 377,
        "headingText": "\r\n<p>No epidemiological data are available.</p>\r\n",
        "timestamp": "2020-06-09T16:32:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,

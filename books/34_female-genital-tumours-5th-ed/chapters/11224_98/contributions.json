      {
        "pkcontributionId": 62394,
        "bookId": 34,
        "chapterId": 98,
        "headingId": 370,
        "headingText": "\r\n<p>Monodermal cystic teratoma is a benign, usually cystic tumour composed of tissues derived from one germ layer, either ectoderm or endoderm, excluding struma ovarii, carcinoid, and neuroectodermal-type tumours.</p>\r\n",
        "timestamp": "2020-05-13T17:56:01"
      }
    ],

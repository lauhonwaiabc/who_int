  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 65617,
        "bookId": 34,
        "chapterId": 527,
        "headingId": 376,
        "headingText": "\r\n<p>Lipoblastoma-like tumour of the vulva is an enlarging, sometimes painful mass {12047760; 25929353; 29976943}.</p>\r\n",
        "timestamp": "2020-06-12T17:19:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 65618,
        "bookId": 34,
        "chapterId": 527,
        "headingId": 377,
        "headingText": "\r\n<p>Lipoblastoma-like tumour of the vulva typically occurs in women of reproductive age {12047760; 25929353; 29976943}.</p>\r\n",
        "timestamp": "2020-06-12T17:19:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 65619,
        "bookId": 34,
        "chapterId": 527,
        "headingId": 378,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2020-06-12T17:19:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 379,
    "contributions": [
      {
        "pkcontributionId": 65620,

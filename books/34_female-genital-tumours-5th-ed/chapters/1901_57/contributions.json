[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 61883,
        "bookId": 34,
        "chapterId": 57,
        "headingId": 370,
        "headingText": "\r\n<p>Endometrioid stromal sarcoma is a low-grade mesenchymal neoplasm with a morphology resembling that of proliferative-type endometrial stroma.</p>\r\n",
        "timestamp": "2020-05-13T17:00:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

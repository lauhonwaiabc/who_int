        "chapterId": 418,
        "headingId": 371,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-06-12T17:21:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,

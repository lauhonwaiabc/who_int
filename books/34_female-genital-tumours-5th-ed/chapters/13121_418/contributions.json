    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 65662,
        "bookId": 34,
        "chapterId": 418,
        "headingId": 370,
        "headingText": "\r\n<p>Fibroepithelial stromal polyp is a benign polypoid mesenchymal neoplasm of the lower female genital tract.</p>\r\n",
        "timestamp": "2020-06-12T17:21:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,

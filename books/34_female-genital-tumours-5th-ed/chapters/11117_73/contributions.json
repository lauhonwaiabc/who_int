        "pkcontributionId": 62037,
        "bookId": 34,
        "chapterId": 73,
        "headingId": 370,
        "headingText": "\r\n<p>Signet-ring stromal tumour is a benign stromal tumour containing cells with signet-ring morphology in a background of fibromatous stroma.</p>\r\n",
        "timestamp": "2020-05-13T17:08:39"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

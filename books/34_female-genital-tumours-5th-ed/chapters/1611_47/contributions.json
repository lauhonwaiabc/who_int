[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 61729,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 370,
        "headingText": "<p>Seromucinous cystadenoma is a benign cystic neoplasm composed of glands and cysts lined by an admixture of bland M&uuml;llerian-type epithelia. Seromucinous adenofibroma differs from cystadenoma in that it has a prominent fibromatous stromal component.</p>",
        "timestamp": "2020-07-02T17:51:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 371,
    "contributions": [
      {
        "pkcontributionId": 61730,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 371,
        "headingText": "\r\n<p>8474/0 Seromucinous cystadenoma</p>\r\n<p>9014/0 Seromucinous adenofibroma</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 61731,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 372,
        "headingText": "\r\n<p>2F32.Y &amp; XH9BE7 Other specified benign neoplasm of ovary &amp; Seromucinous cystadenoma</p>\r\n<p>2F32.Y &amp; XH1VJ0 Other specified benign neoplasm of ovary &amp; Seromucinous adenofibroma</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 61732,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 373,
        "headingText": "\r\n<p><em>Not recommended:</em> mixed M&uuml;llerian cystadenoma/cystadenofibroma</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 374,
    "contributions": [
      {
        "pkcontributionId": 61733,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 374,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 462,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 375,
    "contributions": [
      {
        "pkcontributionId": 61734,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 375,
        "headingText": "\r\n<p>Ovary</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 61735,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 376,
        "headingText": "\r\n<p>Patients typically present with symptoms related to a pelvic mass, or the mass may be an incidental finding on imaging.</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 61736,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 377,
        "headingText": "\r\n<p>Seromucinous adenofibromas and cystadenomas are rare.</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 61737,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 378,
        "headingText": "\r\n<p>Seromucinous adenofibromas are sometimes associated with endometriosis or an endometriotic cyst and may arise from these.</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 379,
    "contributions": [
      {
        "pkcontributionId": 61738,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 379,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 473,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 386,
    "contributions": [
      {
        "pkcontributionId": 61739,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 386,
        "headingText": "<p>Adenofibromas are predominantly solid, with a dense fibrous cut surface. They may form a nodule in the wall of an endometriotic cyst. Cystadenomas are usually unilocular, but sometimes multilocular, cystic lesions.</p>",
        "timestamp": "2020-07-02T17:51:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 467,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 380,
    "contributions": [
      {
        "pkcontributionId": 61740,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 380,
        "headingText": "\r\n<p>Adenofibromas are characterized by a prominent fibromatous hypocellular stroma containing widely spaced glands lined by an admixture of cytologically bland M&uuml;llerian-type epithelia in varying proportions, including ciliated, endocervical-type mucinous, and endometrioid (which may have squamous and/or mucinous differentiation). Cystadenomas are composed of cysts lined by a mixture of benign M&uuml;llerian-type epithelia, as described above.</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 468,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 381,
    "contributions": [
      {
        "pkcontributionId": 61741,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 381,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 469,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 382,
    "contributions": [
      {
        "pkcontributionId": 61742,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 382,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 61743,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> glands within a fibromatous stroma or cysts lined by an admixture of M&uuml;llerian-type epithelia with bland cytological features.</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 61744,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T16:50:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 61745,
        "bookId": 34,
        "chapterId": 47,
        "headingId": 384,
        "headingText": "\r\n<p>These tumours are benign.</p>",
        "timestamp": "2020-05-13T16:50:16"
      }

    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 62122,
        "bookId": 34,
        "chapterId": 78,
        "headingId": 370,
        "headingText": "\r\n<p>Juvenile granulosa cell tumour is a sex cord tumour composed of primitive-appearing granulosa cells growing in solid and follicular patterns.</p>\r\n",
        "timestamp": "2020-05-13T17:12:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

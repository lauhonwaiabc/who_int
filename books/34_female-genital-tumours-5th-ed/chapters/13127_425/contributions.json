      {
        "pkcontributionId": 65798,
        "bookId": 34,
        "chapterId": 425,
        "headingId": 370,
        "headingText": "\r\n<p>NTRK-rearranged spindle cell neoplasm is a low-grade spindle cell sarcoma harbouring NTRK gene rearrangements.</p>\r\n",
        "timestamp": "2020-06-12T17:25:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

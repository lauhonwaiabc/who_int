        "pkcontributionId": 63367,
        "bookId": 34,
        "chapterId": 206,
        "headingId": 370,
        "headingText": "\r\n<p>Leiomyomas at these sites are benign smooth muscle tumours arising from the uterine ligaments.</p>\r\n",
        "timestamp": "2020-05-25T15:41:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "chapterId": 206,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-25T15:41:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63383,
        "bookId": 34,
        "chapterId": 206,
        "headingId": 384,
        "headingText": "\r\n<p>Most are benign. The uterine criteria for malignancy have been proposed for the classification of smooth muscle tumours at this site {30702465}.</p>",
        "timestamp": "2020-05-25T15:41:30"
      }
    ],

        "headingId": 372,
        "headingText": "\r\n<p>2E86.1 Leiomyoma of other or unspecified sites</p>\r\n",
        "timestamp": "2020-05-25T15:41:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

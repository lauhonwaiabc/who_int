        "pkcontributionId": 64445,
        "bookId": 34,
        "chapterId": 302,
        "headingId": 370,
        "headingText": "\r\n<p>Ectopic prostate tissue includes epithelial elements resembling prostatic epithelium in the cervix.</p>\r\n",
        "timestamp": "2020-04-28T15:05:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

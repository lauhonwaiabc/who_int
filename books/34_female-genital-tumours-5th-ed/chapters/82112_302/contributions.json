    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 64459,
        "bookId": 34,
        "chapterId": 302,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> presence of prostatic glandular elements.</p>\r\n<p><em>Desirable:</em> positivity for prostatic antigens; positivity for p63 in the basal cell layer.</p>\r\n",
        "timestamp": "2020-04-28T15:05:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

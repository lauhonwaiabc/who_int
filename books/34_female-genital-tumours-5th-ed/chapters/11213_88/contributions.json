        "bookId": 34,
        "chapterId": 88,
        "headingId": 370,
        "headingText": "\r\n<p>Embryonal carcinoma is a primitive malignant germ cell tumour that may exhibit somatic or extraembryonal differentiation.</p>\r\n",
        "timestamp": "2020-05-13T17:52:45"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

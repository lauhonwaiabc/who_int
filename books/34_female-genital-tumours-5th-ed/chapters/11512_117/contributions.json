    "contributions": [
      {
        "pkcontributionId": 62579,
        "bookId": 34,
        "chapterId": 117,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-14T11:37:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 62580,
        "bookId": 34,
        "chapterId": 117,
        "headingId": 384,
        "headingText": "\r\n<p>They usually resolve spontaneously.</p>",

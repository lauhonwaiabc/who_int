        "pkcontributionId": 62564,
        "bookId": 34,
        "chapterId": 117,
        "headingId": 370,
        "headingText": "\r\n<p>Corpus luteum cyst is a large cystic corpus luteum measuring &gt;&nbsp;3&nbsp;cm.</p>\r\n",
        "timestamp": "2020-05-14T11:37:00"
      }
    ],
    "booknotes": [],

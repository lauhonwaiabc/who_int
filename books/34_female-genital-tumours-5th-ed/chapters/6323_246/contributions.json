    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63828,
        "bookId": 34,
        "chapterId": 246,
        "headingId": 370,
        "headingText": "\r\n<p>High-grade endometrial stromal sarcoma is a malignant endometrial stromal tumour with uniform high-grade round and/or spindle morphology, sometimes with a low-grade component.</p>\r\n",
        "timestamp": "2020-06-05T17:04:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

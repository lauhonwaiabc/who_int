        "bookId": 34,
        "chapterId": 477,
        "headingId": 372,
        "headingText": "\r\n<p>2C75.0 Malignant trophoblastic neoplasms of placenta</p>\r\n",
        "timestamp": "2020-06-03T17:56:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,

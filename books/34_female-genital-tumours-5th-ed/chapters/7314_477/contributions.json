        "bookId": 34,
        "chapterId": 477,
        "headingId": 371,
        "headingText": "\r\n<p>9101/3 Choriocarcinoma combined with other germ cell elements</p>\r\n",
        "timestamp": "2020-06-03T17:56:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,

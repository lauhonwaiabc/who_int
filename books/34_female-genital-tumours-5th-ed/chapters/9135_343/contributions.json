        "bookId": 34,
        "chapterId": 343,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> benign cysts lined by a variety of epithelial types.</p>\r\n",
        "timestamp": "2020-06-08T17:07:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

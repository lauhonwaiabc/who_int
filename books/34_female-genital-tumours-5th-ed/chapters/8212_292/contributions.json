        "chapterId": 292,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-04-28T14:59:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 64291,
        "bookId": 34,
        "chapterId": 292,
        "headingId": 384,
        "headingText": "\r\n<p>M&uuml;llerian papilloma is benign.</p>",

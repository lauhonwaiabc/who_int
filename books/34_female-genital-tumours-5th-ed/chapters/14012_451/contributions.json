        "bookId": 34,
        "chapterId": 451,
        "headingId": 372,
        "headingText": "\r\n<p>2F20.2 Congenital melanocytic naevus</p>\r\n",
        "timestamp": "2020-06-12T17:39:42"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

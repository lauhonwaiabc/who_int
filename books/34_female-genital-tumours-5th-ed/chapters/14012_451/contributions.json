        "pkcontributionId": 66084,
        "bookId": 34,
        "chapterId": 451,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> a pigmented lesion present at birth or appearing within the first year of life.</p>\r\n",
        "timestamp": "2020-06-12T17:39:42"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

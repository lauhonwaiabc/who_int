[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 66070,
        "bookId": 34,
        "chapterId": 451,
        "headingId": 370,
        "headingText": "\r\n<p>Congenital melanocytic naevus is a benign melanocytic neoplasm present at birth or appearing in the first year of life.</p>\r\n",
        "timestamp": "2020-06-12T17:39:42"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

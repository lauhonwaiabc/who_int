[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 61746,
        "bookId": 34,
        "chapterId": 50,
        "headingId": 370,
        "headingText": "\r\n<p>Seromucinous borderline tumour is an architecturally complex papillary neoplasm composed of an admixture of M&uuml;llerian-type epithelia, lacking confluent or destructive invasion.</p>\r\n",
        "timestamp": "2020-05-13T16:52:15"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 62156,
        "bookId": 34,
        "chapterId": 80,
        "headingId": 370,
        "headingText": "\r\n<p>Sex cord tumour with annular tubules is a sex cord tumour with sharply circumscribed nests composed of ring-like tubules that encircle basement membrane&ndash;like material.</p>\r\n",
        "timestamp": "2020-05-13T17:27:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 61779,
        "bookId": 34,
        "chapterId": 40,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T16:54:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 61780,
        "bookId": 34,
        "chapterId": 40,
        "headingId": 384,
        "headingText": "\r\n<p>These are benign tumours with no risk of recurrence or progression.</p>",
        "timestamp": "2020-05-13T16:54:12"
      }
    ],

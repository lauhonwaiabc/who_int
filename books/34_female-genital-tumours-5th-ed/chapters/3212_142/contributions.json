    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 62786,
        "bookId": 34,
        "chapterId": 142,
        "headingId": 370,
        "headingText": "<p>Low-grade serous carcinoma (LGSC) of the peritoneum is an invasive serous neoplasm with low-grade malignant features and no gross or microscopic disease in the ovaries.</p>",
        "timestamp": "2020-07-21T18:37:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,

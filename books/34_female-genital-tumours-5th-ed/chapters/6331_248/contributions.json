        "bookId": 34,
        "chapterId": 248,
        "headingId": 371,
        "headingText": "\r\n<p>8590/1 Uterine tumour resembling ovarian sex cord tumour</p>\r\n",
        "timestamp": "2020-06-05T17:07:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 63864,
        "bookId": 34,
        "chapterId": 248,
        "headingId": 372,
        "headingText": "\r\n<p>2F76 &amp; XH8CW8 Neoplasms of uncertain behaviour of female genital organs &amp; Uterine tumour resembling ovarian sex cord tumour</p>\r\n",
        "timestamp": "2020-06-05T17:07:18"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,

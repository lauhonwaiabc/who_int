      {
        "pkcontributionId": 63261,
        "bookId": 34,
        "chapterId": 184,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-25T15:35:21"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63262,
        "bookId": 34,
        "chapterId": 184,
        "headingId": 384,
        "headingText": "\r\n<p>Tubo-ovarian abscess is benign. There is an association with endometriosis and diabetes.</p>",
        "timestamp": "2020-05-25T15:35:21"
      }
    ],

        "headingId": 372,
        "headingText": "\r\n<p>GA05.3 Tubo-ovarian abscess</p>\r\n",
        "timestamp": "2020-05-25T15:35:21"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,

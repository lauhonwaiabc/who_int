[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63246,
        "bookId": 34,
        "chapterId": 184,
        "headingId": 370,
        "headingText": "\r\n<p>Tubo-ovarian abscess is a fibroinflammatory mass, involving distal fallopian tube, ovary, and occasionally other pelvic organs.</p>\r\n",
        "timestamp": "2020-05-25T15:35:21"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 65781,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 370,
        "headingText": "\r\n<p>Dermatofibrosarcoma protuberans (DFSP) is a superficial, locally aggressive fibroblastic neoplasm, having a cellular storiform appearance and carrying a <em>COL1A1</em>-<em>PDGFB</em> or related fusion.</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 371,
    "contributions": [
      {
        "pkcontributionId": 65782,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 371,
        "headingText": "\r\n<p>8832/1 Dermatofibrosarcoma protuberans NOS</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 65783,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 372,
        "headingText": "\r\n<p>2B53.Y &amp; XH4QZ8 Other specified fibroblastic or myofibroblastic tumour, primary site &amp; Dermatofibrosarcoma NOS</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 65784,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 373,
        "headingText": "\r\n<p><em>Not recommended:</em> Bednar tumour</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 374,
    "contributions": [
      {
        "pkcontributionId": 65785,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 374,
        "headingText": "\r\n<p>Pigmented dermatofibrosarcoma protuberans; dermatofibrosarcoma protuberans, fibrosarcomatous</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 462,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 375,
    "contributions": [
      {
        "pkcontributionId": 65786,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 375,
        "headingText": "\r\n<p>In descending order: the labia majora, mons pubis, and clitoral/paraclitoral area {28323651}</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 65787,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 376,
        "headingText": "\r\n<p>DFSP typically presents as a slow-growing mass, ranging in size from 0.5 to 15&nbsp;cm (median: 4&nbsp;cm) {20139758}.</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 65788,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 377,
        "headingText": "\r\n<p>Patients range in age from 1 to 83&nbsp;years (mean: 45.4&nbsp;years) {10542946; 20139758; 28323651}.</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 65789,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 378,
        "headingText": "\r\n<p>Most of these tumours occur sporadically.</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 379,
    "contributions": [
      {
        "pkcontributionId": 65790,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 379,
        "headingText": "\r\n<p>Most DFSP lesions contain <em>COL1A1</em>-<em>PDGFB</em> fusions resulting from a t(17;22)(q21.3;q13.1) {29140881}.</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 473,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 386,
    "contributions": [
      {
        "pkcontributionId": 65791,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 386,
        "headingText": "\r\n<p>DFSP usually has a fibrous appearance on cut section.</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 467,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 380,
    "contributions": [
      {
        "pkcontributionId": 65792,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 380,
        "headingText": "\r\n<p>Conventional DFSP is a dermal-based infiltrative tumour of uniform, hyperchromatic spindled cells with a storiform growth pattern that infiltrates into the subcutis in a lace-like or honeycomb pattern. The mitotic count is low. Myxoid DFSP is composed of spindle to stellate cells uniformly distributed in myxoid stroma with a more apparent capillary vasculature {17890911; 17721193; 26355764}. Pigmented DFSP has scattered dendritic pigmented S100-positive cells. Myoid DFSP has myoid cells concentrically arranged around vessels {25943241}. Giant cell fibroblastoma has multinucleated cells, myxoid stroma, and pseudovascular spaces {21319518; 17415117}. Vulvar giant cell fibroblastoma often has a conventional DFSP component. Fibrosarcomatous DFSP shows an abrupt transition to a herringbone pattern of atypical spindled cells with increased mitotic activity {20139758}. CD34 is positive, but expression may be reduced or absent in fibrosarcomatous or myxoid DFSP {29140881; 26355764; 20139758}.</p>\r\n<p>Lesions similar to DFSP with fibrosarcomatous change arising in the cervix have been described {30877273}. These show prominent storiform and herringbone architecture and no distinct vascular pattern. The spindle cells express CD34 and cyclin&nbsp;D1. There is little or no expression of S100, CD10, SMA, desmin, BCOR, ER, PR, or TRK {30877273; 21317712}.</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 468,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 381,
    "contributions": [
      {
        "pkcontributionId": 65793,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 381,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 469,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 382,
    "contributions": [
      {
        "pkcontributionId": 65794,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 382,
        "headingText": "\r\n<p><em>COL1A1</em>-<em>PDGFB</em> fusions can be detected in selected cases.</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 65795,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 385,
        "headingText": "<p><em>Essential:</em> conventional DFSP: storiform pattern, spindled cells, and uniform CD34 positivity.</p>",
        "timestamp": "2020-08-03T13:19:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 65796,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 383,
        "headingText": "\r\n<p>Union for International Cancer Control (UICC) staging is applicable for fibrosarcomatous DFSP.</p>\r\n",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 65797,
        "bookId": 34,
        "chapterId": 424,
        "headingId": 384,
        "headingText": "\r\n<p>There is a high rate of local recurrence. Fibrosarcomatous DFSP has metastatic potential.</p>",
        "timestamp": "2020-06-12T17:24:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
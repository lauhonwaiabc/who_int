        "bookId": 34,
        "chapterId": 87,
        "headingId": 371,
        "headingText": "\r\n<p>9071/3 Yolk sac tumour NOS</p>\r\n",
        "timestamp": "2020-05-13T17:52:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 62277,
        "bookId": 34,
        "chapterId": 87,
        "headingId": 372,
        "headingText": "\r\n<p>2C73.Y &amp; XH09W7 Other specified malignant neoplasms of the ovary &amp; Yolk sac tumour</p>\r\n",
        "timestamp": "2020-05-13T17:52:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 62278,
        "bookId": 34,
        "chapterId": 87,
        "headingId": 373,
        "headingText": "\r\n<p><em>Not recommended:</em> endodermal sinus tumour; primitive endodermal tumour</p>\r\n",
        "timestamp": "2020-05-13T17:52:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,

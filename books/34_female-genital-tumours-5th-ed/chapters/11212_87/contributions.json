[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 62275,
        "bookId": 34,
        "chapterId": 87,
        "headingId": 370,
        "headingText": "<p>Yolk sac tumour (YST) is a primitive germ cell tumour displaying multiple patterns reflecting endodermal extraembryonal differentiation (secondary yolk sac and allantois) or, less commonly, endodermal somatic tissues (intestine, liver, and mesenchyme).</p>",
        "timestamp": "2020-05-29T16:18:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

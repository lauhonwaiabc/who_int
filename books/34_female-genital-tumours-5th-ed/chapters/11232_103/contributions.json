      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 62451,
        "bookId": 34,
        "chapterId": 103,
        "headingId": 376,
        "headingText": "\r\n<p>Most tumours occur in infants or children aged &lt;&nbsp;10&nbsp;years. Occasionally, tumours are associated with isosexual pseudoprecocity {196747; 17581418}.</p>\r\n",
        "timestamp": "2020-05-13T17:59:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 62452,
        "bookId": 34,
        "chapterId": 103,
        "headingId": 377,
        "headingText": "\r\n<p>These are rare tumours.</p>\r\n",
        "timestamp": "2020-05-13T17:59:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,

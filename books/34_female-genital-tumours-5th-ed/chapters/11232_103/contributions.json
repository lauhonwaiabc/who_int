    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 62445,
        "bookId": 34,
        "chapterId": 103,
        "headingId": 370,
        "headingText": "\r\n<p>Mixed germ cell&ndash;sex cord&ndash;stromal tumour, unclassified, is a neoplasm composed of germ cells and sex cord cells occurring in phenotypically and genetically female patients that does not have the distinctive appearance of a gonadoblastoma.</p>\r\n",
        "timestamp": "2020-05-13T17:59:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

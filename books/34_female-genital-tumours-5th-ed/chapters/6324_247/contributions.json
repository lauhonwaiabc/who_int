[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63845,
        "bookId": 34,
        "chapterId": 247,
        "headingId": 370,
        "headingText": "\r\n<p>Undifferentiated uterine sarcoma is a malignant mesenchymal tumour lacking evidence of specific lines of differentiation; therefore, this is a diagnosis of exclusion.</p>\r\n",
        "timestamp": "2020-06-05T17:05:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,

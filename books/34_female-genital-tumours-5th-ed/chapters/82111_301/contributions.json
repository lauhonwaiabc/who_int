    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 64428,
        "bookId": 34,
        "chapterId": 301,
        "headingId": 370,
        "headingText": "\r\n<p>In tuboendometrioid metaplasia, there is a change from endocervical epithelium to tubal (ciliated) and/or endometrioid-type epithelium.</p>\r\n",
        "timestamp": "2020-04-28T15:04:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,

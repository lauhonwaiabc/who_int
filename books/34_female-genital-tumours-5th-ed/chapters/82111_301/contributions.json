    "contributions": [
      {
        "pkcontributionId": 64431,
        "bookId": 34,
        "chapterId": 301,
        "headingId": 373,
        "headingText": "\r\n<p><em>Acceptable:</em> tubal metaplasia</p>\r\n",
        "timestamp": "2020-04-28T15:04:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,

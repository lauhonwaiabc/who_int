      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 64699,
        "bookId": 34,
        "chapterId": 324,
        "headingId": 384,
        "headingText": "<p>Mature teratomas of the cervix follow a benign course. YST in infant girls responds well to therapy, with a good long-term prognosis {3888365}. Non-gestational choriocarcinoma may follow an aggressive course {28830246}.</p>",
        "timestamp": "2020-05-29T16:21:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

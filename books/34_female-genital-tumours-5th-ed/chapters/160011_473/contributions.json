        "bookId": 34,
        "chapterId": 473,
        "headingId": 371,
        "headingText": "<h5><strong>MIM numbering</strong></h5>\r\n<p>150800 Hereditary leiomyomatosis and renal cell cancer; HLRCC</p>",
        "timestamp": "2020-06-23T16:50:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,

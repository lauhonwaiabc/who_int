[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 66342,
        "bookId": 34,
        "chapterId": 473,
        "headingId": 370,
        "headingText": "\r\n<p>Hereditary leiomyomatosis and renal cell carcinoma (HLRCC) is an autosomal dominant tumour predisposition syndrome with early-onset development of cutaneous and uterine leiomyomas, as well as renal cell carcinoma (RCC; most frequently type&nbsp;2 papillary RCC), associated with germline <em>FH</em> (fumarase) gene mutations.</p>\r\n",
        "timestamp": "2020-06-23T16:49:56"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 371,
    "contributions": [
      {

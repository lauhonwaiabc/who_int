        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-06-23T16:49:56"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,

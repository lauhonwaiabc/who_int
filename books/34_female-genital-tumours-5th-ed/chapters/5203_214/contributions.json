        "chapterId": 214,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-25T15:45:39"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63486,
        "bookId": 34,
        "chapterId": 214,
        "headingId": 384,
        "headingText": "\r\n<p>Multifocal involvement or recurrences several decades after diagnosis may occur {26107559}.</p>",
        "timestamp": "2020-05-25T15:45:39"
      }
    ],

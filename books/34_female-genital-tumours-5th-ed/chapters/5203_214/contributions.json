        "headingId": 382,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-25T15:45:39"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 63484,
        "bookId": 34,
        "chapterId": 214,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> columnar/cuboidal tumour cells with eosinophilic cytoplasm; varying architectural pattern; ependymal pseudorosettes are seen.</p>\r\n<p><em>Desirable:</em> GFAP positivity.</p>\r\n",
        "timestamp": "2020-05-25T15:45:39"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

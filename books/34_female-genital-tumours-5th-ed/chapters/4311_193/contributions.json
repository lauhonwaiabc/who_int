        "pkcontributionId": 63332,
        "bookId": 34,
        "chapterId": 193,
        "headingId": 370,
        "headingText": "\r\n<p>Adenosarcoma is a biphasic tumour with benign glandular epithelium and malignant, usually low-grade, mesenchymal elements.</p>\r\n",
        "timestamp": "2020-05-25T15:38:51"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 63338,
        "bookId": 34,
        "chapterId": 193,
        "headingId": 376,
        "headingText": "<p>No clinical features are specific; the tumour may present as a pelvic or uterine mass (compare with <a style=\"cursor:pointer\" href=\"/chaptercontent/34/63\" target=\"_blank\">section </a><em>Adenosarcoma of the ovary</em>&nbsp;and <a style=\"cursor:pointer\" href=\"/chaptercontent/34/259\" target=\"_blank\">section </a><em>Adenosarcoma of the uterine corpus</em>).</p>",
        "timestamp": "2020-07-10T08:09:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 63339,
        "bookId": 34,
        "chapterId": 193,
        "headingId": 377,
        "headingText": "\r\n<p>Adenosarcoma is extremely uncommon in the fallopian tube.</p>\r\n",
        "timestamp": "2020-05-25T15:38:51"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

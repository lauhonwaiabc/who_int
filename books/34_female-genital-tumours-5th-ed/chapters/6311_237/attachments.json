  {
    "pkattachmentId": 36112,
    "bookid": 34,
    "chapterId": 237,
    "fileId": 13002,
    "type": "Figure",
    "diagnosis": "Typical uterine leiomyomas",
    "title": "",
    "legend": "Tumours are well circumscribed, with a firm, whorled, and white cut surface. They are often intramyometrial but can be subserosal and pedunculated and may secondarily torse, becoming a so-called parasitic leiomyoma.",
    "source": "Philip Pun Ching Ip",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/34/237/13002.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/34/237/thumb_13002.jpg"
  },
  {
    "pkattachmentId": 36113,
    "bookid": 34,
    "chapterId": 237,
    "fileId": 13003,
    "type": "Figure",
    "diagnosis": "Leiomyoma with bizarre nuclei",
    "title": "",
    "legend": "The cells with bizarre nuclei have a diffuse distribution within the tumour; they display smudged nuclear chromatin and some nuclear pseudoinclusions. Karyorrhectic nuclei (often mistaken for atypical mitoses) are seen.",
    "source": "Jennifer A. Bennett",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/34/237/13003.jpg",

    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 64615,
        "bookId": 34,
        "chapterId": 311,
        "headingId": 370,
        "headingText": "\r\n<p>Adenoid basal carcinoma is an epithelial tumour composed of morphologically bland small rounded nests of basaloid cells.</p>\r\n",
        "timestamp": "2020-04-28T15:13:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,

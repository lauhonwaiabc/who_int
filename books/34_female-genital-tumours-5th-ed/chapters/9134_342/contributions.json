  },
  {
    "pkheadingid": 467,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 380,
    "contributions": [
      {
        "pkcontributionId": 64867,
        "bookId": 34,
        "chapterId": 342,
        "headingId": 380,
        "headingText": "\r\n<p>Endocervicosis is composed of variably sized and shaped glands lined by bland mucinous endocervical-type epithelium and located deep within the vaginal stroma. Superficially located benign mucinous glands are designated as adenosis.</p>\r\n",
        "timestamp": "2020-06-08T17:06:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 64862,
        "bookId": 34,
        "chapterId": 342,
        "headingId": 376,
        "headingText": "\r\n<p>In one case, presentation was with a painful vaginal mass {12090597}.</p>\r\n",
        "timestamp": "2020-06-08T17:06:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 64863,
        "bookId": 34,
        "chapterId": 342,
        "headingId": 377,
        "headingText": "\r\n<p>This is an extremely rare lesion, with only two reports in the literature {12090597; 11603227}.</p>\r\n",
        "timestamp": "2020-06-08T17:06:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 64864,
        "bookId": 34,
        "chapterId": 342,
        "headingId": 378,
        "headingText": "\r\n<p>In one reported case, it was speculated that the endocervicosis was due to vaginal implantation of endocervical tissue at hysterectomy {12090597}.</p>\r\n",
        "timestamp": "2020-06-08T17:06:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

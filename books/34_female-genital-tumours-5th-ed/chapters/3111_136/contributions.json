  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 62732,
        "bookId": 34,
        "chapterId": 136,
        "headingId": 385,
        "headingText": "<p><em>Essential:</em> variably sized slit-like, tubular, and cystic spaces that may have papillae, lined by mesothelial cells; tumours arising in the peritoneum have no invasion into the adjacent tissue.</p>\r\n<p><em>Desirable:</em> immunohistochemistry of mesothelial markers, if needed; L1CAM, a marker of the <em>TRAF7</em> mutation, may be useful {29148537}.</p>",
        "timestamp": "2020-06-17T14:48:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 64663,
        "bookId": 34,
        "chapterId": 320,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> a well-circumscribed lesion; benign glands displaying endocervical, tubal, or mesonephric differentiation in lobular arrangement or cystically dilated; a stromal component rich in bland-appearing smooth muscle.</p>\r\n",
        "timestamp": "2020-04-28T15:14:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 64649,
        "bookId": 34,
        "chapterId": 320,
        "headingId": 370,
        "headingText": "\r\n<p>Adenomyoma is a benign mixed epithelial and mesenchymal tumour composed of endocervical-type glands and smooth muscle&ndash;rich stroma.</p>\r\n",
        "timestamp": "2020-04-28T15:14:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

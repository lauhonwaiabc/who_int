    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 374,
    "contributions": [
      {
        "pkcontributionId": 64653,
        "bookId": 34,
        "chapterId": 320,
        "headingId": 374,
        "headingText": "\r\n<p>Mesonephric-type adenomyoma; endocervical-type adenomyoma</p>\r\n",
        "timestamp": "2020-04-28T15:14:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 462,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 375,
    "contributions": [
      {
        "pkcontributionId": 64654,
        "bookId": 34,
        "chapterId": 320,
        "headingId": 375,
        "headingText": "\r\n<p>Adenomyoma of the uterine cervix occurs as an intramural or polypoid mass protruding into the endocervical canal.</p>\r\n",
        "timestamp": "2020-04-28T15:14:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 64655,
        "bookId": 34,
        "chapterId": 320,
        "headingId": 376,
        "headingText": "\r\n<p>Patients are asymptomatic or have symptoms related to a mass, vaginal discharge, or bleeding. Patient age at presentation ranges from 21 to 55&nbsp;years (mean: 40&nbsp;years) {8685218; 11552953; 25219586}.</p>\r\n",
        "timestamp": "2020-04-28T15:14:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 64656,
        "bookId": 34,
        "chapterId": 320,
        "headingId": 377,
        "headingText": "\r\n<p>There are insufficient epidemiological data.</p>\r\n",
        "timestamp": "2020-04-28T15:14:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 64657,
        "bookId": 34,
        "chapterId": 320,
        "headingId": 378,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2020-04-28T15:14:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 379,
    "contributions": [
      {
        "pkcontributionId": 64658,
        "bookId": 34,
        "chapterId": 320,
        "headingId": 379,
        "headingText": "\r\n<p>Unknown</p>\r\n",

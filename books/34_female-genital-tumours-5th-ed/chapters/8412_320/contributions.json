        "chapterId": 320,
        "headingId": 381,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-04-28T15:14:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

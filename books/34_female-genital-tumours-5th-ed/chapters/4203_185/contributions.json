    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63263,
        "bookId": 34,
        "chapterId": 185,
        "headingId": 370,
        "headingText": "\r\n<p>Salpingitis isthmica nodosa is diverticulosis of the epithelium of the fallopian tube, with associated smooth muscle hypertrophy and/or hyperplasia.</p>\r\n",
        "timestamp": "2020-05-25T15:35:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 63279,
        "bookId": 34,
        "chapterId": 185,
        "headingId": 384,
        "headingText": "\r\n<p>Salpingitis isthmica nodosa is benign; its association with infertility is of note.</p>",
        "timestamp": "2020-05-25T15:35:44"
      }

[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63058,
        "bookId": 34,
        "chapterId": 162,
        "headingId": 370,
        "headingText": "\r\n<p>Squamous or cartilaginous metaplasia is a mesothelial transformation into squamous epithelium or mature hyaline cartilage. Endocervicosis is an uneven arrangement of endocervical-type glands and cysts in ectopic sites. Keratin granulomas represent a reactive process to laminated keratin.</p>\r\n",
        "timestamp": "2020-05-19T17:09:25"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "chapterId": 162,
        "headingId": 381,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-19T17:09:25"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "chapterId": 79,
        "headingId": 381,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T17:26:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

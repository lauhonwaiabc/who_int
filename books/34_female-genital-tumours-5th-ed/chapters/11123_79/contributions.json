    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 62139,
        "bookId": 34,
        "chapterId": 79,
        "headingId": 370,
        "headingText": "\r\n<p>Sertoli cell tumour is a sex cord neoplasm composed of Sertoli cells arranged in a variety of patterns but most commonly as hollow or solid tubules.</p>\r\n",
        "timestamp": "2020-05-13T17:26:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "pkcontributionId": 63313,
        "bookId": 34,
        "chapterId": 187,
        "headingId": 384,
        "headingText": "\r\n<p>Placental site nodule/plaque can be transformed into epithelioid trophoblastic tumour, which has malignant potential.</p>",
        "timestamp": "2020-05-25T15:36:53"

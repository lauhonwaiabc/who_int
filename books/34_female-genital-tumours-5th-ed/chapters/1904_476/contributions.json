    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 61931,
        "bookId": 34,
        "chapterId": 476,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> paucicellular tumour with striking and extensive myxoid matrix; oval to spindle cells with bland cytological features; abundant capillaries with or without plexiform arrangement.</p>\r\n",
        "timestamp": "2020-05-13T17:01:39"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

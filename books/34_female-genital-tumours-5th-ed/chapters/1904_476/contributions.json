        "chapterId": 476,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T17:01:39"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,

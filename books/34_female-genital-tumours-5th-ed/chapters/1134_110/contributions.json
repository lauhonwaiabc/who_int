    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 62530,
        "bookId": 34,
        "chapterId": 110,
        "headingId": 370,
        "headingText": "\r\n<p>Wilms tumour is a tumour composed of a variable mixture of blastemal, epithelial, and mesenchymal elements mimicking its renal counterpart.</p>\r\n",
        "timestamp": "2020-05-14T11:34:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

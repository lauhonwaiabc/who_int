        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T17:49:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 62238,
        "bookId": 34,
        "chapterId": 90,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> mature tissue representing at least two germ layers.</p>\r\n",
        "timestamp": "2020-05-13T17:49:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 62239,
        "bookId": 34,
        "chapterId": 90,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-05-13T17:49:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 62240,
        "bookId": 34,
        "chapterId": 90,
        "headingId": 384,
        "headingText": "<p>These are benign except in rare instances of concurrent malignant transformation (see <a style=\"cursor:pointer\" href=\"/chaptercontent/34/99\" target=\"_blank\">section </a><em>Somatic neoplasms arising from teratomas</em>) and rare cases of development of immature teratoma in residual ovary after partial excision of a mature cystic teratoma (associated with cyst rupture) {3429105}. The presence of rare microscopic foci of immature neural tissue in a mature teratoma is associated with an excellent outcome and does not merit overall classification of the tumour as immature teratoma {3429105}. Gliomatosis peritonei can occur in women with mature solid teratoma but does not adversely affect prognosis {5521737}.</p>",
        "timestamp": "2020-07-09T15:16:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
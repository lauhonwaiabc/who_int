[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63692,
        "bookId": 34,
        "chapterId": 233,
        "headingId": 370,
        "headingText": "\r\n<p>Arias-Stella reaction is a benign endometrial change composed of enlarged, hobnail cells with a maintained N:C&nbsp;ratio, associated with pregnancy, gestational trophoblastic disease, or high doses of progestins.</p>\r\n",
        "timestamp": "2020-06-05T16:56:41"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

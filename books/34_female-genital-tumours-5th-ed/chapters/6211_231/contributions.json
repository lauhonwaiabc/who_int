    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63658,
        "bookId": 34,
        "chapterId": 231,
        "headingId": 370,
        "headingText": "<p>Endometrial polyp is polypoid, localized, and benign, with disorganized proliferation of endometrial glands and altered stroma, often with prominent blood vessels.</p>",
        "timestamp": "2020-08-12T14:49:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "chapterId": 157,
        "headingId": 374,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-05-19T15:20:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 462,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 375,
    "contributions": [
      {
        "pkcontributionId": 62978,
        "bookId": 34,
        "chapterId": 157,
        "headingId": 375,
        "headingText": "\r\n<p>TCM usually occurs at the tuboperitoneal junction, serosa of the tube, tubal fimbriae, mesosalpinx, and rete ovarii, and rarely on the ovarian surface {21131840; 18830124; 8852450; 31274702; 25281026}. Nests or cysts formed by TCM are termed Walthard nests.</p>\r\n",
        "timestamp": "2020-05-19T15:20:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 62979,
        "bookId": 34,
        "chapterId": 157,
        "headingId": 376,
        "headingText": "\r\n<p>TCM is an incidental microscopic finding {21131840; 18830124; 8852450}.</p>\r\n",
        "timestamp": "2020-05-19T15:20:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 62980,
        "bookId": 34,
        "chapterId": 157,
        "headingId": 377,
        "headingText": "\r\n<p>Patients are in their fourth to seventh decade of life {21131840; 18830124}.</p>\r\n",
        "timestamp": "2020-05-19T15:20:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

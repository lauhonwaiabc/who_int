  },
  {
    "pkheadingid": 467,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 380,
    "contributions": [
      {
        "pkcontributionId": 62984,
        "bookId": 34,
        "chapterId": 157,
        "headingId": 380,
        "headingText": "\r\n<p>TCM consists of bland transitional epithelium. Distinct small nucleoli can be seen, but no nuclear atypia, hyperchromasia, macronucleoli, mitoses, or apoptotic bodies are observed. Microlumina or small cysts with amphophilic material or umbrella-like cells are present only occasionally {18830124}.</p>\r\n",
        "timestamp": "2020-05-19T15:20:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

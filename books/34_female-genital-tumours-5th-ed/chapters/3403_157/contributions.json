      {
        "pkcontributionId": 62973,
        "bookId": 34,
        "chapterId": 157,
        "headingId": 370,
        "headingText": "\r\n<p>Transitional cell metaplasia (TCM) is a change of mesothelium to transitional epithelium resembling that of the urinary tract.</p>\r\n",
        "timestamp": "2020-05-19T15:20:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "pkcontributionId": 62190,
        "bookId": 34,
        "chapterId": 83,
        "headingId": 370,
        "headingText": "\r\n<p>Sex cord&ndash;stromal tumour NOS is a tumour that lacks definitive characteristics of a specific tumour type.</p>\r\n",
        "timestamp": "2020-05-13T17:41:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

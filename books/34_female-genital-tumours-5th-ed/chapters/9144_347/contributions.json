[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 64941,
        "bookId": 34,
        "chapterId": 347,
        "headingId": 370,
        "headingText": "\r\n<p>Mucinous carcinoma, gastric type, of the vagina is a primary vaginal mucinous adenocarcinoma exhibiting gastric differentiation, analogous to its counterpart in the cervix.</p>\r\n",
        "timestamp": "2020-06-08T17:09:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

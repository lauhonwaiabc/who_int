        "headingId": 371,
        "headingText": "\r\n<p>8482/3 Mucinous carcinoma, gastric type</p>\r\n",
        "timestamp": "2020-06-08T17:09:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 64943,
        "bookId": 34,
        "chapterId": 347,
        "headingId": 372,
        "headingText": "\r\n<p>2C71.0 &amp; XH1S75 Adenocarcinoma of vagina &amp; Mucinous adenocarcinoma</p>\r\n",
        "timestamp": "2020-06-08T17:09:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,

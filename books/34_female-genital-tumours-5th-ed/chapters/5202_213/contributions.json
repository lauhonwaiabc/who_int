[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63453,
        "bookId": 34,
        "chapterId": 213,
        "headingId": 370,
        "headingText": "\r\n<p>Papillary cystadenoma is a benign papillary cystic tumour of probable mesonephric origin, usually in patients with von Hippel&ndash;Lindau syndrome (VHL).</p>\r\n",
        "timestamp": "2020-05-25T15:45:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

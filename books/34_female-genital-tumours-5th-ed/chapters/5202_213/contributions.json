        "bookId": 34,
        "chapterId": 213,
        "headingId": 371,
        "headingText": "\r\n<p>8450/0 Papillary cystadenoma NOS</p>\r\n",
        "timestamp": "2020-05-25T15:45:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 63455,
        "bookId": 34,
        "chapterId": 213,
        "headingId": 372,
        "headingText": "\r\n<p>2F33.Y &amp; XH0FM6 Benign neoplasm of other specified female genital organs &amp; Papillary cystadenoma NOS</p>\r\n",
        "timestamp": "2020-05-25T15:45:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,

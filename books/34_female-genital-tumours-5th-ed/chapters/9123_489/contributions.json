        "chapterId": 489,
        "headingId": 374,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-06-08T17:00:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 462,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 375,
    "contributions": [
      {
        "pkcontributionId": 64792,
        "bookId": 34,
        "chapterId": 489,
        "headingId": 375,
        "headingText": "\r\n<p>These tumours occur predominantly in the upper third of the vagina and are more common in the posterior wall {18980291; 11812092}.</p>\r\n",
        "timestamp": "2020-06-08T17:00:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 64793,
        "bookId": 34,
        "chapterId": 489,
        "headingId": 376,
        "headingText": "\r\n<p>The clinical features are similar to those of HPV-associated SCC.</p>\r\n",
        "timestamp": "2020-06-08T17:00:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 64794,
        "bookId": 34,
        "chapterId": 489,
        "headingId": 377,
        "headingText": "\r\n<p>Vaginal SCC constitutes 1&ndash;2% of all female genital tract malignancies. The proportion of HPV-independent SCC varies widely in different reports, ranging from 0% to 79%. This wide variation has been related to differences in HPV detection protocols and geographical variation in HPV prevalence {19115209; 28369882}. In the largest study, there was no HPV DNA identified in 26% of vaginal SCCs {25155250}. The majority of patients with HPV-independent SCC are postmenopausal, with a median patient age at diagnosis of 73&nbsp;years {21166704; 18500261; 2166263}.</p>\r\n",
        "timestamp": "2020-06-08T17:00:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 64795,
        "bookId": 34,
        "chapterId": 489,
        "headingId": 378,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2020-06-08T17:00:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,
    "bookid": 34,
    "headingType": 2,

[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 64787,
        "bookId": 34,
        "chapterId": 489,
        "headingId": 370,
        "headingText": "\r\n<p>Squamous cell carcinoma (SCC), HPV-independent, is an HPV-independent squamous tumour with stromal invasion and/or exophytic expansile-type invasion. Coincident cervical or vulvar carcinoma, or a prior history of these tumours within 5&nbsp;years, must be excluded.</p>\r\n",
        "timestamp": "2020-06-08T17:00:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,

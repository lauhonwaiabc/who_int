[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 66104,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 370,
        "headingText": "\r\n<p>Atypical melanocytic naevus of genital type (AMNGT) is clinically and histologically an atypical melanocytic neoplasm occurring in the genital area, with a benign clinical course.</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 371,
    "contributions": [
      {
        "pkcontributionId": 66105,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 371,
        "headingText": "<p>8720/0 Atypical melanocytic naevus of genital type</p>",
        "timestamp": "2020-06-15T12:34:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 66106,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 372,
        "headingText": "\r\n<p>2F20.1 Atypical melanocytic naevus</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 66107,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 373,
        "headingText": "\r\n<p><em>Acceptable:</em> atypical genital naevus; atypical melanocytic naevus of special site</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 374,
    "contributions": [
      {
        "pkcontributionId": 66108,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 374,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 462,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 375,
    "contributions": [
      {
        "pkcontributionId": 66109,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 375,
        "headingText": "\r\n<p>AMNGT is most commonly located on the labia majora or mons pubis. Mucosal AMNGT affecting the labia minora is less frequent.</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 66110,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 376,
        "headingText": "\r\n<p>AMNGT presents as a slow-growing, irregularly pigmented (tan, brown) papule, often &gt;&nbsp;6&nbsp;mm. It is usually an incidental finding. Patients with AMNGT often have a personal or family history of dysplastic naevus {18162770}.</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 66111,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 377,
        "headingText": "\r\n<p>AMNGT is mainly found in young women in the third decade of life.</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 66112,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 378,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 466,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 379,
    "contributions": [
      {
        "pkcontributionId": 66113,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 379,
        "headingText": "\r\n<p>AMNGTs of genital type frequently harbour <em>BRAF</em> p.Val600Glu mutations {24842760} but do not display the anomalies found in mucosal melanomas {27220476}.</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 473,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 386,
    "contributions": [
      {
        "pkcontributionId": 66114,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 386,
        "headingText": "\r\n<p>There is a papular lesion, usually pigmented.</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 467,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 380,
    "contributions": [
      {
        "pkcontributionId": 66115,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 380,
        "headingText": "\r\n<p>AMNGT is typically a compound, rather symmetrical melanocytic proliferation with prominent architectural atypia of the junctional and (to a lesser degree) dermal components. The junctional nests are usually large, irregularly shaped, and confluent and often show a loss of cohesion between the melanocytes. The melanocytes tend to be larger than in a common naevus and may show mild cytological atypia such as visible small nucleoli and abundant heavily pigmented or foamy cytoplasm. Pagetoid growth is usually absent. The periphery of the lesion sometimes displays a single-cell lentiginous growth pattern. The dermal/subepithelial component usually consists of dispersed nests, horizontal rows, or sheets of smaller melanocytes. Prominent stromal fibroplasia is present in some cases. Cytological atypia is less prominent in the subepithelial/dermal component than in the junctional component. Mitotic activity is low but can be found in some cases.</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 468,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 381,
    "contributions": [
      {
        "pkcontributionId": 66116,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 381,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 469,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 382,
    "contributions": [
      {
        "pkcontributionId": 66117,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 382,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 66118,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> prominent architectural atypia in the junctional component; a symmetrical lesion with maturation to the depth.</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 66119,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 66120,
        "bookId": 34,
        "chapterId": 454,
        "headingId": 384,
        "headingText": "\r\n<p>AMNGT behaves in a benign fashion without recurrence when completely removed.</p>",
        "timestamp": "2020-06-12T17:41:09"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

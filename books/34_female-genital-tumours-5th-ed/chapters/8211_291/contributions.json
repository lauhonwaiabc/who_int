        "bookId": 34,
        "chapterId": 291,
        "headingId": 375,
        "headingText": "\r\n<p>Endocervix</p>\r\n",
        "timestamp": "2020-04-28T14:58:42"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 463,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 376,
    "contributions": [
      {
        "pkcontributionId": 64264,
        "bookId": 34,
        "chapterId": 291,
        "headingId": 376,
        "headingText": "\r\n<p>Endocervical polyp is usually asymptomatic but may be associated with vaginal bleeding (especially postcoital) and/or discharge.</p>\r\n",
        "timestamp": "2020-04-28T14:58:42"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 464,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 377,
    "contributions": [
      {
        "pkcontributionId": 64265,
        "bookId": 34,
        "chapterId": 291,
        "headingId": 377,
        "headingText": "\r\n<p>These are common lesions that may occur at any age, but they are more common among women aged &gt;&nbsp;40&nbsp;years {14010498}.</p>\r\n",
        "timestamp": "2020-04-28T14:58:42"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 465,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 378,
    "contributions": [
      {
        "pkcontributionId": 64266,

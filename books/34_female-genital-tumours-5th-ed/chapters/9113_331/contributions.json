      {
        "pkcontributionId": 64719,
        "bookId": 34,
        "chapterId": 331,
        "headingId": 370,
        "headingText": "\r\n<p>Atrophy is loss or lack of squamous epithelial maturation associated with states of estrogen deficiency.</p>\r\n",
        "timestamp": "2020-06-08T16:55:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "headingId": 372,
        "headingText": "\r\n<p>GA30.2 Postmenopausal atrophic vaginitis</p>\r\n",
        "timestamp": "2020-06-08T16:55:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,

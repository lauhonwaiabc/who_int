        "timestamp": "2020-06-12T17:41:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 66135,
        "bookId": 34,
        "chapterId": 455,
        "headingId": 385,
        "headingText": "<p><em>Essential:</em> a benign melanocytic neoplasm with a significant lentiginous component; a well-developed shoulder; randomly distributed melanocytic atypia; a marked inflammatory reaction.</p>",
        "timestamp": "2020-07-02T15:35:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 470,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 383,
    "contributions": [
      {
        "pkcontributionId": 66136,
        "bookId": 34,
        "chapterId": 455,
        "headingId": 383,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2020-06-12T17:41:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 471,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 384,
    "contributions": [
      {
        "pkcontributionId": 66137,
        "bookId": 34,
        "chapterId": 455,
        "headingId": 384,
        "headingText": "\r\n<p>Dysplastic melanocytic naevus is a benign lesion that may regress with time. Dysplastic melanocytic naevus with severe atypia may be a precursor of melanoma, and some authors recommend excision of dysplastic melanocytic naevus with narrow but histologically clear margins {28778635}.</p>",
        "timestamp": "2020-06-12T17:41:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
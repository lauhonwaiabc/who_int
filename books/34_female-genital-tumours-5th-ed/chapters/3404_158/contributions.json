      {
        "pkcontributionId": 63006,
        "bookId": 34,
        "chapterId": 158,
        "headingId": 384,
        "headingText": "\r\n<p>Endosalpingiosis is benign. Rarely, serous neoplasms have been observed in association with endosalpingiosis {22613998; 31157685}.</p>",

        "bookId": 34,
        "chapterId": 427,
        "headingId": 371,
        "headingText": "\r\n<p>8841/0 Superficial angiomyxoma</p>\r\n",
        "timestamp": "2020-06-12T17:34:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 372,
    "contributions": [
      {
        "pkcontributionId": 65970,
        "bookId": 34,
        "chapterId": 427,
        "headingId": 372,
        "headingText": "\r\n<p>2F7C &amp; XH58A9 Neoplasms of uncertain behaviour of connective or other soft tissue &amp; Superficial angiomyxoma</p>\r\n",
        "timestamp": "2020-06-12T17:34:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 460,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 373,
    "contributions": [
      {
        "pkcontributionId": 65971,
        "bookId": 34,
        "chapterId": 427,
        "headingId": 373,
        "headingText": "\r\n<p><em>Acceptable:</em> cutaneous myxoma</p>\r\n",
        "timestamp": "2020-06-12T17:34:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 461,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 374,

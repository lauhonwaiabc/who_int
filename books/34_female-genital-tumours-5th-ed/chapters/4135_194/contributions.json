        "pkcontributionId": 63195,
        "bookId": 34,
        "chapterId": 194,
        "headingId": 370,
        "headingText": "\r\n<p>Carcinosarcoma is a biphasic tumour composed of high-grade carcinomatous and sarcomatous components.</p>\r\n",
        "timestamp": "2020-05-25T15:33:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

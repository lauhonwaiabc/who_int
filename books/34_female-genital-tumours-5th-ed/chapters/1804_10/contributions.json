        "pkcontributionId": 61866,
        "bookId": 34,
        "chapterId": 10,
        "headingId": 370,
        "headingText": "\r\n<p>Mixed carcinoma of the ovary is an ovarian carcinoma composed of two or more different histological types.</p>\r\n",

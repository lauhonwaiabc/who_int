        "pkcontributionId": 62666,
        "bookId": 34,
        "chapterId": 125,
        "headingId": 370,
        "headingText": "\r\n<p>Leydig cell hyperplasia is an increased number of Leydig cells in the hilar region of the ovary.</p>\r\n",
        "timestamp": "2020-05-14T11:42:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 64000,
        "bookId": 34,
        "chapterId": 274,
        "headingId": 370,
        "headingText": "\r\n<p>Exaggerated placental site (EPS) reaction is a non-neoplastic condition representing an exuberant proliferation of implantation site intermediate (extravillous) trophoblast after a recent gestation.</p>\r\n",
        "timestamp": "2020-06-03T17:50:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

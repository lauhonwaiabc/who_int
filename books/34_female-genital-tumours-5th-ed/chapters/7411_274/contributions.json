  {
    "pkheadingid": 472,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 385,
    "contributions": [
      {
        "pkcontributionId": 64014,
        "bookId": 34,
        "chapterId": 274,
        "headingId": 385,
        "headingText": "\r\n<p><em>Essential:</em> infiltrative trophoblastic cells with no formation of a mass.</p>\r\n<p><em>Desirable:</em> low Ki-67 proliferation index.</p>\r\n",
        "timestamp": "2020-06-03T17:50:29"
      }
    ],

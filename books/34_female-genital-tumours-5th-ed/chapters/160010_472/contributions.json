        "chapterId": 472,
        "headingId": 371,
        "headingText": "<h5><strong>MIM numbering</strong></h5>\r\n<p>193300 Von Hippel&ndash;Lindau syndrome; VHLS</p>",
        "timestamp": "2020-06-23T16:49:12"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 459,
    "bookid": 34,
    "headingType": 2,

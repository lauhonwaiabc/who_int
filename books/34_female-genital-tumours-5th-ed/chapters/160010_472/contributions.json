[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 66325,
        "bookId": 34,
        "chapterId": 472,
        "headingId": 370,
        "headingText": "\r\n<p>Von Hippel&ndash;Lindau syndrome (VHL) is a hereditary autosomal dominant disease affecting several organ systems, caused by germline mutations of the <em>VHL</em> gene.</p>\r\n",
        "timestamp": "2020-06-23T16:48:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,

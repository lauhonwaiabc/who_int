[
  {
    "pkheadingid": 457,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 370,
    "contributions": [
      {
        "pkcontributionId": 63178,
        "bookId": 34,
        "chapterId": 178,
        "headingId": 370,
        "headingText": "\r\n<p>Endometrioid carcinoma is a malignant epithelial neoplasm displaying varying proportions of glandular, papillary, and solid architecture, with cells showing endometrioid differentiation.</p>\r\n",
        "timestamp": "2020-05-25T15:32:57"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 458,
    "bookid": 34,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 371,
    "contributions": [
      {

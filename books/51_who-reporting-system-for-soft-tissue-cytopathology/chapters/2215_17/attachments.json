    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 624.25pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"832\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 330.15pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"440\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Soft tissue entity</span></strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"392\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Most common aberration(s)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 330.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"440\">\r\n<p class=\"TableText\"><strong>Angiosarcoma (radiotherapy-associated)</strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"392\">\r\n<p class=\"TableText\">Amplification of <em>MYC</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 330.15pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"440\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Atypical lipomatous tumour&nbsp;/ well-differentiated liposarcoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"392\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Amplification of 12q13-p15, including <em>MDM2</em> and <em>CDK4</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 330.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"440\">\r\n<p class=\"TableText\"><strong>Dedifferentiated liposarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"392\">\r\n<p class=\"TableText\">Amplification of 12q13-p15, including <em>MDM2</em> and <em>CDK4</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 330.15pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"440\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Desmoid fibromatosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"392\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Mutation of <em>CTNNB1</em> (encoding &beta;-catenin)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 330.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"440\">\r\n<p class=\"TableText\"><strong>Epithelioid schwannoma</strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"392\">\r\n<p class=\"TableText\">Loss of <em>SMARCB1</em> (<em>INI1</em>)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 330.15pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"440\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Epithelioid sarcoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"392\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Loss of <em>SMARCB1</em> (<em>INI1</em>)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 330.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"440\">\r\n<p class=\"TableText\"><strong>Gastrointestinal stromal tumour</strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"392\">\r\n<p class=\"TableText\">Mutation of <em>KIT</em>, mutation of <em>PDGFRA</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 330.15pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"440\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Intramuscular myxoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"392\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Mutation of <em>GNAS</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"width: 330.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"440\">\r\n<p class=\"TableText\"><strong>Intimal sarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"392\">\r\n<p class=\"TableText\">Amplification of 12q13-p15, including <em>MDM2</em> and <em>CDK4</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid;\">\r\n<td style=\"width: 330.15pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"440\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Spindle cell&nbsp;/ pleomorphic lipoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"392\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Loss of <em>RB1</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 11; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 330.15pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"440\">\r\n<p class=\"TableText\"><strong>Spindle cell rhabdomyosarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 294.1pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"392\">\r\n<p class=\"TableText\">Mutation of <em>MYOD1</em></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

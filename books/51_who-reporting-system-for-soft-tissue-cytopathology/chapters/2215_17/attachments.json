    "source": "Beata Bode-Lesniewska",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-table-layout-alt: fixed; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"945\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 218.05pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"291\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Soft tissue entity</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"654\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Gene fusion(s)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong>Angiomatous fibrous histiocytoma</strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em>EWSR1</em>::<em>CREB1</em> or <em>EWSR1</em>::<em>ATF1</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Alveolar rhabdomyosarcoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">PAX3</span></em><span style=\"color: black; mso-color-alt: windowtext;\">::<em>FOXO1</em> or <em>PAX7</em>::<em>FOXO1</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong>Alveolar soft part sarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em>ASPSCR1</em>::<em>TFE3</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong><em><span style=\"color: black; mso-color-alt: windowtext;\">BCOR</span></em><span style=\"color: black; mso-color-alt: windowtext;\">-associated sarcomas</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">BCOR</span></em><span style=\"color: black; mso-color-alt: windowtext;\">::<em>CCNB3</em>, <em>BCOR</em> internal tandem duplication (ITD)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong><em>CIC</em>-rearranged sarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em>CIC</em>::<em>DUX4</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Clear cell sarcoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">EWSR1</span></em><span style=\"color: black; mso-color-alt: windowtext;\">::<em>ATF1</em> or <em>EWSR1</em>::<em>CREB1</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong>Dermatofibrosarcoma protuberans</strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em>COL1A1</em>::<em>PDGFB</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Desmoplastic small round cell tumour</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">EWSR1</span></em><span style=\"color: black; mso-color-alt: windowtext;\">::<em>WT1</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong>Epithelioid haemangioma</strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em>FOS</em> (<em>c-FOS</em>) and <em>FOSB</em> fusions</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Epithelioid haemangioendothelioma</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">WWTR1</span></em><span style=\"color: black; mso-color-alt: windowtext;\">::<em>CAMTA1</em> or <em>YAP1</em>::<em>TFE3</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 11; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong>Ewing sarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\">Fusions of <em>EWSR1</em> and a member of the ETS family of transcription factors (most commonly <em>FLI1</em>, rarely <em>ERG</em>)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 12; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Extraskeletal myxoid chondrosarcoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">NR4A3</span></em><span style=\"color: black; mso-color-alt: windowtext;\">::<em>EWSR1</em> or <em>NR4A3</em>::<em>TAF15</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 13; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong>Infantile fibrosarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em>ETV6</em>::<em>NTRK3</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 14; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Inflammatory myofibroblastic tumour</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">ALK</span></em><span style=\"color: black; mso-color-alt: windowtext;\"> fusion with various partners (<em>TPM3</em>, <em>TPM4</em>, <em>CLTC</em>, <em>CARS1</em>, <em>ATIC</em>, <em>SEC31A</em> (<em>SEC31L1</em>), <em>PPFIBP1</em>, <em>DCTN1</em>, <em>EML4</em>, <em>PRKAR1A</em>, <em>LMNA</em>, <em>TFG</em>, <em>FN1</em>, <em>HNRNPA1</em>)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 15; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong>Low-grade fibromyxoid sarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em>FUS</em>::<em>CREB3L2</em> or <em>FUS</em>::<em>CREB3L1</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 16; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Mesenchymal chondrosarcoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">HEY1</span></em><span style=\"color: black; mso-color-alt: windowtext;\">::<em>NCOA2</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 17; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong>Myxoid liposarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em>FUS</em>::<em>DDIT3</em> or rarely <em>EWSR1</em>::<em>DDIT3</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 18; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Nodular fasciitis</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">USP6</span></em><span style=\"color: black; mso-color-alt: windowtext;\">::<em>MYH9</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 19; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong>PEComa</strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em>TFE3</em> fusions</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 20; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Solitary fibrous tumour</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">NAB2</span></em><span style=\"color: black; mso-color-alt: windowtext;\">::<em>STAT6</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 21; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong>Synovial sarcoma</strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em>SS18</em>::<em>SSX1/SSX2/SSX4</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 22; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 218.05pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"291\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Tenosynovial giant cell tumour</span></strong></p>\r\n</td>\r\n<td style=\"width: 490.65pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"654\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">CSF1</span></em><span style=\"color: black; mso-color-alt: windowtext;\"> fusions</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

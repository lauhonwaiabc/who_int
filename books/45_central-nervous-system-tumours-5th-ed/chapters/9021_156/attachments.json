  {
    "pkattachmentId": 40299,
    "bookid": 45,
    "chapterId": 156,
    "fileId": 20487,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diagnostic criteria for circumscribed meningeal melanocytic neoplasms</p>",
    "legend": "",
    "source": "Pieter Wesseling",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 15.0cm; border-collapse: collapse;\" border=\"0\" width=\"567\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Circumscribed/localized primary melanocytic neoplasm in the meninges</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt;\"><span style=\"font-family: Symbol;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><em><span style=\"color: black;\">For melanocytoma:</span></em><span style=\"color: black;\"> limited cytological atypia, (almost) no mitoses, no necrosis, and (in cases of evaluable CNS parenchyma) no CNS invasion</span></p>\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt;\"><span style=\"font-family: Symbol;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><em><span style=\"color: black;\">For intermediate-grade melanocytoma:</span></em><span style=\"color: black;\">&nbsp;mitotic count<sup>a</sup>&nbsp;of 0.5&ndash;1.5&nbsp;mitoses/mm<sup>2</sup>&nbsp;and/or CNS invasion, but limited cytological atypia and no necrosis</span></p>\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt;\"><span style=\"font-family: Symbol;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><em><span style=\"color: black;\">For melanoma:</span></em><span style=\"color: black;\">&nbsp;mitotic count<sup>a</sup> &gt;&nbsp;1.5&nbsp;mitoses/mm<sup>2</sup>&nbsp;and/or necrosis, often accompanied by marked cytological atypia</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong><em><span style=\"color: black;\">Desirable:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Demonstration of </span><em><span style=\"color: black;\">GNAQ</span></em><span style=\"color: black;\">, </span><em><span style=\"color: black;\">GNA11</span></em><span style=\"color: black;\">, </span><em><span style=\"color: black;\">PLCB4</span></em><span style=\"color: black;\">, or </span><em><span style=\"color: black;\">CYSLTR2</span></em><span style=\"color: black;\"> mutation corroborates the CNS origin of the neoplasm, especially after exclusion of uveal or blue naevus&ndash;like melanoma</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Additional molecular markers (<em>SF3B1</em>, <em>EIF1AX</em>, and <em>BAP1</em> mutations; chromosome&nbsp;3 monosomy; complex c</span><span style=\"color: black;\">opy-number variations) indicating aggressive behaviour</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\"><sup>a</sup>1&nbsp;mm<sup>2</sup> equates approximately to 5&nbsp;HPF of 0.5&nbsp;mm in diameter and 0.2&nbsp;mm<sup>2</sup> in area.</p>",
    "imageUrl": null,
    "thumbnail": null
  },

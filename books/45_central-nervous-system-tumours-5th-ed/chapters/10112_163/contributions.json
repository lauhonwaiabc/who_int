        "headingId": 510,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2021-09-30T16:11:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 532,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 511,
    "contributions": [
      {
        "pkcontributionId": 73150,
        "bookId": 45,
        "chapterId": 163,
        "headingId": 511,
        "headingText": "\r\n<p>Overall, outcome for immunodeficiency-associated CNS lymphoma is poor {17492932}.</p>",
        "timestamp": "2021-09-30T16:11:06"
      }
    ],

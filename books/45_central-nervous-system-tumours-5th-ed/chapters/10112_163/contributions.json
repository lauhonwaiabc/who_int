[
  {
    "pkheadingid": 518,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 497,
    "contributions": [
      {
        "pkcontributionId": 73134,
        "bookId": 45,
        "chapterId": 163,
        "headingId": 497,
        "headingText": "\r\n<p>Immunodeficiency-associated CNS lymphomas comprise a family of CNS lymphomas arising in patients with inherited or acquired immunodeficiency, including that related to AIDS and iatrogenic disease.</p>\r\n",
        "timestamp": "2021-09-30T16:11:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 519,

    "title": "<p>Diagnostic criteria for diffuse low-grade glioma, MAPK pathway&ndash;altered</p>",
    "legend": "",
    "source": "David W. Ellison",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><span style=\" \">Diffuse glioma with absent or minimal mitotic activity and neither microvascular proliferation nor necrosis</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><span style=\" \">Genetic alteration in the MAPK pathway</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><span style=\" \">IDH-wildtype and H3-wildtype</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><span style=\" \">Absence of homozygous deletion of </span><em style=\"\"><span style=\"\">CDKN2A</span></em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><span style=\" \">Onset in childhood, adolescence, or early adulthood</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 432.35pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><span style=\" \">Absence of morphological features or DNA methylation profile suggestive of an alternative tumour type in which </span><em style=\"\"><span style=\"\">FGFR</span></em><span style=\" \"> or </span><em style=\"\"><span style=\"\">BRAF</span></em><span style=\" \"> abnormalities occur</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  }

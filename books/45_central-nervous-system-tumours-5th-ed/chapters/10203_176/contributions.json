        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2021-09-30T16:19:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 532,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 511,
    "contributions": [
      {
        "pkcontributionId": 73303,
        "bookId": 45,
        "chapterId": 176,
        "headingId": 511,
        "headingText": "\r\n<p>Therapy relies on maximally safe surgery when feasible. Cytotoxic chemotherapies, radiotherapy, and molecular targeted therapies including MAPK signalling pathway inhibitors are therapeutic alternatives based on molecular characterization {31685033}. Drawing prognostic conclusions about juvenile xanthogranuloma of the CNS is difficult because of its rarity.</p>",
        "timestamp": "2021-09-30T16:19:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
        "chapterId": 176,
        "headingId": 498,
        "headingText": "\r\n<p>9749/1 Juvenile xanthogranuloma</p>\r\n",
        "timestamp": "2021-09-30T16:19:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 520,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 499,

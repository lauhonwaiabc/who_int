        "bookId": 45,
        "chapterId": 176,
        "headingId": 499,
        "headingText": "\r\n<p>2B31.0 Juvenile xanthogranuloma</p>\r\n",
        "timestamp": "2021-09-30T16:19:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 521,

[
  {
    "pkheadingid": 518,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 497,
    "contributions": [
      {
        "pkcontributionId": 73287,
        "bookId": 45,
        "chapterId": 176,
        "headingId": 497,
        "headingText": "\r\n<p>Juvenile xanthogranuloma of the CNS or the meninges, with or without systemic lesions, pathologically corresponds to its cutaneous counterpart. It is a mostly paediatric, non&ndash;Langerhans cell histiocytosis characterized by foamy histiocytes, occasional Touton giant cells, and inflammation.</p>\r\n",
        "timestamp": "2021-09-30T16:19:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 519,
    "bookid": 45,
    "headingType": 2,

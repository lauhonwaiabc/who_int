    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 16.0cm; background: #DAEEF3; border-collapse: collapse; \" border=\"0\" width=\"605\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black; \">A histiocytic tumour composed of foamy cells and a mixed inflammatory infiltrate</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><em><span style=\"color: black; \">Desirable:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Exclusion of other lines of differentiation (glial, epithelial, melanocytic, lymphocytic, Langerhans cell, meningothelial, etc.)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><em style=\"\"><span style=\"color: black; \">BRAF</span></em><span style=\"color: black; \">, </span><em style=\"\"><span style=\"color: black; \">ARAF</span></em><span style=\"color: black; \">, </span><em style=\"\"><span style=\"color: black; \">KRAS</span></em><span style=\"color: black; \">, and </span><em style=\"\"><span style=\"color: black; \">NRAS</span></em><span style=\"color: black; \"> mutation status</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Evidence of cutaneous manifestations</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

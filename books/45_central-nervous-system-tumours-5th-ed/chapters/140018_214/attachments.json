gn=\"center\">40&ndash;45%</p>\r\n</td>\r\n<td style=\"width: 148.6pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">36.2%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 147.1pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"196\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Mesothelioma</span></strong></p>\r\n</td>\r\n<td style=\"width: 116.5pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"155\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">1&ndash;2%</span></p>\r\n</td>\r\n<td style=\"width: 114.3pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"152\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">23&ndash;64%</span></p>\r\n</td>\r\n<td style=\"width: 148.6pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; \">24.8%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 147.1pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"196\">\r\n<p class=\"TableText\"><strong>Cutaneous melanoma</strong></p>\r\n</td>\r\n<td style=\"width: 116.5pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"155\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&lt;&nbsp;1%</p>\r\n</td>\r\n<td style=\"width: 114.3pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"152\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">2&ndash;3%</p>\r\n</td>\r\n<td style=\"width: 148.6pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">23.4%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\
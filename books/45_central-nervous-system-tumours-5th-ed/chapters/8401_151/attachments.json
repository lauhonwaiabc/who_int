    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 16.0cm; background: #DAEEF3; border-collapse: collapse; \" border=\"0\" width=\"605\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Midline axial bone tumour</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Lobules of cohesive and physaliphorous cells in a myxoid or chondroid matrix</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Brachyury immunopositivity</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">AND</span></strong> <strong style=\"\"><em style=\"\"><span style=\"color: black; \">(in the case of epithelioid/solid forms)</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 36.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\"color: black; \"><span style=\"\">&nbsp;</span></span></p>\r\n</td>\r\n<td style=\"width: 416.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"556\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Loss of SMARCB1 (INI1) expression to confirm the diagnosis of poorly differentiated chordoma</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

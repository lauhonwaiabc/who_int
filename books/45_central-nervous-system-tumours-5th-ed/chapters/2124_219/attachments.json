    "title": "<p>Diagnostic criteria for infant-type hemispheric glioma</p>",
    "legend": "",
    "source": "Cynthia E. Hawkins",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"background: #DAEEF3; border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 15.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Cellular astrocytoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Presentation in early childhood</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Cerebral hemispheric location</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 36.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \"><span style=\"\">&nbsp;</span></span></p>\r\n</td>\r\n<td style=\"width: 388.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"518\">\r\n<p class=\"TableText\"><span style=\" \">Presence of a typical receptor tyrosine kinase abnormality (e.g. fusion in an NTRK family gene or in </span><em style=\"\"><span style=\"\">ROS1</span></em><span style=\" \">, </span><em style=\"\"><span style=\"\">MET1</span></em><span style=\" \">, or </span><em style=\"\"><span style=\"\">ALK</span></em><span style=\" \">)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 36.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \"><span style=\"\">&nbsp;</span></span></p>\r\n</td>\r\n<td style=\"width: 388.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"518\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">OR</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 36.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \"><span style=\"\">&nbsp;</span></span></p>\r\n</td>\r\n<td style=\"width: 388.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"518\">\r\n<p class=\"TableText\"><span style=\" \">Methylation profile aligned with infant-type hemispheric glioma</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

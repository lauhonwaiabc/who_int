        "timestamp": "2021-06-03T17:14:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 532,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 511,
    "contributions": [
      {
        "pkcontributionId": 72601,
        "bookId": 45,
        "chapterId": 235,
        "headingId": 511,
        "headingText": "\r\n<p>Many patients with CRINET respond well to therapy and experience long-term survival. In a retrospective series, the overall survival of 10&nbsp;patients with CRINET was found to be significantly longer than that of 27&nbsp;patients with AT/RT-TYR {27380723}.</p>",
        "timestamp": "2021-06-03T17:14:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
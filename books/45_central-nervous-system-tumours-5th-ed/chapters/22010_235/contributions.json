        "bookId": 45,
        "chapterId": 235,
        "headingId": 499,
        "headingText": "\r\n<p>2A00.2Y Other specified tumours of neuroepithelial tissue of brain</p>\r\n",
        "timestamp": "2021-06-03T17:14:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

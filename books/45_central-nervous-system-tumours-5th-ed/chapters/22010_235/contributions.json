        "bookId": 45,
        "chapterId": 235,
        "headingId": 498,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2021-06-03T17:14:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 520,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,

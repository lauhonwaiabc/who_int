[
  {
    "pkheadingid": 518,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 497,
    "contributions": [
      {
        "pkcontributionId": 72585,
        "bookId": 45,
        "chapterId": 235,
        "headingId": 497,
        "headingText": "\r\n<p>Cribriform neuroepithelial tumour (CRINET) is provisionally defined as a non-rhabdoid neuroectodermal tumour characterized by cribriform strands and ribbons, and showing loss of nuclear SMARCB1 expression.</p>\r\n",
        "timestamp": "2021-06-03T17:14:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

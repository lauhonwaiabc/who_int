    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"background: #BFBFBF; border-collapse: collapse;\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"height: 13.55pt;\">\r\n<td style=\"width: 16.0cm; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.55pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin-left: 15.9pt; text-indent: -15.9pt;\">1.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span>Bilateral vestibular schwannomas</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.5pt;\">\r\n<td style=\"width: 16.0cm; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">OR</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.5pt;\">\r\n<td style=\"width: 16.0cm; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin-left: 15.9pt; text-indent: -15.9pt;\">2.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span><span style=\"color: black;\">Family history of neurofibromatosis type&nbsp;2 <strong>AND</strong></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.5pt;\">\r\n<td style=\"width: 36.85pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 416.75pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" valign=\"top\" width=\"556\">\r\n<p class=\"TableText\" style=\"margin-left: 14.45pt; text-indent: -14.15pt;\">a.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp; </span><span style=\"color: black;\">Unilateral vestibular schwannoma <strong>OR</strong></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.5pt;\">\r\n<td style=\"width: 36.85pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 416.75pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" valign=\"top\" width=\"556\">\r\n<p class=\"TableText\" style=\"margin-left: 14.45pt; text-indent: -14.15pt;\">b.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp; </span><span style=\"color: black;\">Any two of: meningioma, ependymoma, schwannoma, posterior subcapsular opacities</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.5pt;\">\r\n<td style=\"width: 16.0cm; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">OR</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.5pt;\">\r\n<td style=\"width: 16.0cm; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin-left: 15.9pt; text-indent: -15.9pt;\">3.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span><span style=\"color: black;\">Unilateral vestibular schwannoma <strong>AND</strong></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.5pt;\">\r\n<td style=\"width: 36.85pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\" style=\"tab-stops: 29.5pt;\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 416.75pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" valign=\"top\" width=\"556\">\r\n<p class=\"TableText\" style=\"margin-left: 14.45pt; text-indent: -14.15pt;\"><span style=\"font-family: Symbol;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span><span style=\"color: black;\">Any two of: meningioma, ependymoma, schwannoma, posterior subcapsular opacities</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.5pt;\">\r\n<td style=\"width: 16.0cm; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">OR</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.5pt;\">\r\n<td style=\"width: 16.0cm; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin-left: 15.9pt; text-indent: -15.9pt;\">4.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span><span style=\"color: black;\">Multiple meningiomas <strong>AND</strong></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.5pt;\">\r\n<td style=\"width: 36.85pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 416.75pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" valign=\"top\" width=\"556\">\r\n<p class=\"TableText\" style=\"margin-left: 14.45pt; text-indent: -14.15pt;\">a.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp; </span><span style=\"color: black;\">Unilateral vestibular schwannoma <strong>OR</strong></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.5pt;\">\r\n<td style=\"width: 36.85pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 416.75pt; border: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.5pt;\" valign=\"top\" width=\"556\">\r\n<p class=\"TableText\" style=\"margin-left: 14.45pt; text-indent: -14.15pt;\">b.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp; </span><span style=\"color: black;\">Any two of: ependymoma, schwannoma, posterior subcapsular opacities</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

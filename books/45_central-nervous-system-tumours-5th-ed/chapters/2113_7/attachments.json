    "copyright": "",
    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"background: #DAEEF3; border-collapse: collapse; border: none; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 4.0pt;\">\r\n<td style=\"width: 522.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\"><strong><em style=\"\"><span style=\"\">Essential:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 4.0pt;\">\r\n<td style=\"width: 522.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\"><span style=\"\">An IDH-wildtype, H3-wildtype,&nbsp;diffuse astrocytic glioma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 4.0pt;\">\r\n<td style=\"width: 522.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 4.0pt;\">\r\n<td style=\"width: 522.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\"><span style=\"\">One or more of the following:</span></p>\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt; \"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"\">Microvascular proliferation</span></p>\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt; \"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"\">Necrosis</span></p>\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt; \"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><em style=\"\"><span style=\"\">TERT</span></em><span style=\"\">&nbsp;promoter mutation</span></p>\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt; \"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><em style=\"\"><span style=\"\">EGFR</span></em><span style=\"\">&nbsp;gene amplification</span></p>\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt; \"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"\">+7/&minus;10 chromosome copy-number alterations</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 4.0pt;\">\r\n<td style=\"width: 522.8pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\"><strong><em style=\"\"><span style=\"\">Desirable:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 4.0pt;\">\r\n<td style=\"width: 522.8pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\"><span style=\"\">DNA&nbsp;methylation&nbsp;profile of glioblastoma, IDH-wildtype</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

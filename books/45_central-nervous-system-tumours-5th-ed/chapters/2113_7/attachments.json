  {
    "pkattachmentId": 40208,
    "bookid": 45,
    "chapterId": 7,
    "fileId": 16516,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Gene fusions with estimated frequencies of &gt;&nbsp;1% in IDH-wildtype glioblastoma</p>",
    "legend": "",
    "source": "David Capper",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 63.55pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><strong>Gene</strong></p>\r\n</td>\r\n<td style=\"width: 62.9pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"87\">\r\n<p class=\"TableText\"><strong>Frequent fusion partner(s)</strong></p>\r\n</td>\r\n<td style=\"width: 64.05pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><strong>Estimated frequency</strong></p>\r\n</td>\r\n<td style=\"width: 158.3pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"211\">\r\n<p class=\"TableText\"><strong>Comment</strong></p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\"><strong>References</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 63.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><strong><em>EGFR</em></strong></p>\r\n</td>\r\n<td style=\"width: 62.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"87\">\r\n<p class=\"TableText\"><em>SEPTIN14</em>, various others</p>\r\n</td>\r\n<td style=\"width: 64.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\">~6&ndash;13%</p>\r\n</td>\r\n<td style=\"width: 158.3pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"211\">\r\n<p class=\"TableText\">Co-occurs with <em>EGFR</em> amplification and often results in EGFR C-terminal truncation</p>\r\n</td>\r\n<td style=\"width: 99.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{23917401; 24120142; 29617662; 32466770}</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 63.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><strong><em>FGFR3</em></strong></p>\r\n</td>\r\n<td style=\"width: 62.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"87\">\r\n<p class=\"TableText\"><em>TACC3</em></p>\r\n</td>\r\n<td style=\"width: 64.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\">~3%</p>\r\n</td>\r\n<td style=\"width: 158.3pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"211\">\r\n<p class=\"TableText\">Recurrently caused by chromosome 4p16.3 tandem duplication, associated with amplification of <em>CDK4</em> (22&ndash;44%) and <em>MDM2</em> (20&ndash;25%)</p>\r\n</td>\r\n<td style=\"width: 99.25pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{22837387; 23298836; 24120142; 25135958; 25609060; 29718398; 32413119}</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 63.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><strong><em>MET</em></strong></p>\r\n</td>\r\n<td style=\"width: 62.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"87\">\r\n<p class=\"TableText\"><em>PTPRZ1</em>, various others</p>\r\n</td>\r\n<td style=\"width: 64.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\">~1&ndash;4%</p>\r\n</td>\r\n<td style=\"width: 158.3pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"211\">\r\n<p class=\"TableText\">More typical for IDH-mutant high-grade astrocytoma and diffuse, paediatric-type high-grade glioma, H3-wildtype and IDH-wildtype</p>\r\n</td>\r\n<td style=\"width: 99.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{25135958; 29718398; 30343896}</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 63.55pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><strong><em>NTRK1</em>, <em>NTRK2</em>, <em>NTRK3</em></strong></p>\r\n</td>\r\n<td style=\"width: 62.9pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"87\">\r\n<p class=\"TableText\">Various</p>\r\n</td>\r\n<td style=\"width: 64.05pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\">~1&ndash;2%</p>\r\n</td>\r\n<td style=\"width: 158.3pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"211\">\r\n<p class=\"TableText\">Fusions also observed in CNS WHO grade 1&ndash;3 gliomas; <em>NTRK3</em> fusion very rare</p>\r\n</td>\r\n<td style=\"width: 99.25pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"132\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{23917401; 25384085; 29718398; 32466770}</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },

    "fileId": 20524,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diagnostic criteria for high-grade astrocytoma with piloid features</p>",
    "legend": "",
    "source": "Laura Peferoen - Copied text from Word file",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 14.25pt;\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.25pt;\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">An astrocytic glioma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.25pt;\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.25pt;\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">A DNA methylation profile of high-grade astrocytoma with piloid features</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 16.1pt;\">\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 16.1pt;\">\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">MAPK pathway gene alteration </span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 16.1pt;\">\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Homozygous deletion or mutation of </span><a name=\"_Hlk74829533\"></a><em style=\"\"><span style=\"\">CDKN2A</span></em><span style=\" \"> and/or </span><em style=\"\"><span style=\"\">CDKN2B</span></em><span style=\" \">, or amplification of </span><em style=\"\"><span style=\"\">CDK4</span></em></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 16.1pt;\">\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Mutation of </span><em style=\"\"><span style=\"\">ATRX</span></em><span style=\" \"> or loss of nuclear ATRX expression</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 16.1pt;\">\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Anaplastic histological features</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

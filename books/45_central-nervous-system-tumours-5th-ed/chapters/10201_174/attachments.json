  {
    "pkattachmentId": 40023,
    "bookid": 45,
    "chapterId": 174,
    "fileId": 20030,
    "type": "Figure",
    "diagnosis": "Erdheim&ndash;Chester disease",
    "title": "",
    "legend": "This 39-year-old man presented with headaches and severe proptosis. T1-weighted postcontrast sagittal MRI shows a mass infiltrating the pituitary gland and hypothalamus, extending inferiorly along the clivus. Multiple lobulated masses are present along the falx and tentorium. This is an important image because it shows patchy enhancing lesions in the pons, indicating parenchymal involvement.",

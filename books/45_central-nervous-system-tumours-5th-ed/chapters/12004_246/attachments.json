    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 442.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"590\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 442.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"590\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Rathke pouch epithelial glands, primitive blastomatous cells, and secretory and folliculostellate anterior pituitary cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 442.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"590\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 442.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"590\">\r\n<p class=\"TableText\"><em><span style=\"color: black; \">DICER1</span></em><span style=\"color: black; \"> alterations</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.15pt;\">\r\n<td style=\"width: 442.45pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.15pt;\" valign=\"top\" width=\"590\">\r\n<p class=\"TableText\"><strong><em><span style=\"color: black; \">Desirable:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 13.45pt;\">\r\n<td style=\"width: 442.45pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.45pt;\" valign=\"top\" width=\"590\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Diagnosed in children aged &lt;&nbsp;2&nbsp;years</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.8pt;\">\r\n<td style=\"width: 442.45pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.8pt;\" valign=\"top\" width=\"590\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Cushing syndrome</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.8pt;\">\r\n<td style=\"width: 442.45pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.8pt;\" valign=\"top\" width=\"590\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Personal or family history of <em>DICER1</em> syndrome</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

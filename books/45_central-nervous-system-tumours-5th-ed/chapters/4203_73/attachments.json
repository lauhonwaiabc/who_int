    "source": "David W. Ellison",
    "copyright": "",
    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 16.0cm; background: #DAEEF3; border-collapse: collapse; border: none; \" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><em style=\"\"><span style=\"\">Essential:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><span style=\"\">A CNS embryonal tumour with the morphological and immunohistochemical features of one of the three ETMR morphological patterns: </span></p>\r\n<p class=\"TableText\" style=\"text-indent: -13.5pt; margin: 2.25pt 0cm 2.25pt 27.0pt;\"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"\">Embryonal tumour with abundant neuropil and true rosettes</span></p>\r\n<p class=\"TableText\" style=\"text-indent: -13.5pt; margin: 2.25pt 0cm 2.25pt 27.0pt;\"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"\">Ependymoblastoma</span></p>\r\n<p class=\"TableText\" style=\"text-indent: -13.5pt; margin: 2.25pt 0cm 2.25pt 27.0pt;\"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"\">Medulloepithelioma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\">Genetic alteration defining one of the two ETMR molecular subtypes:</p>\r\n<p class=\"TableText\" style=\"text-indent: -13.5pt; margin: 2.25pt 0cm 2.25pt 27.0pt;\"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span>C19MC alteration</p>\r\n<p class=\"TableText\" style=\"text-indent: -13.5pt; margin: 2.25pt 0cm 2.25pt 27.0pt;\"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><em>DICER1 </em>mutation</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><span style=\"\">AND (for unresolved lesions)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 36.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><span style=\"\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 416.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"556\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><span style=\"\">A DNA methylation profile aligned with ETMR</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

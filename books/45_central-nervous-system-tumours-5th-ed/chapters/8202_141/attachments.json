  },
  {
    "pkattachmentId": 39798,
    "bookid": 45,
    "chapterId": 141,
    "fileId": 18091,
    "type": "Figure",
    "diagnosis": "Primary intracranial sarcoma, <em>DICER1</em>-mutant",
    "title": "",
    "legend": "In addition to the defining <em>DICER1</em> mutation, these tumours often have genetic inactivation of the <em>ATRX</em> gene resulting in loss of ATRX protein expression as visualized by immunohistochemistry.",
    "source": "David A. Solomon",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/141/18091.jpg",

    "chapterId": 141,
    "fileId": 18094,
    "type": "Figure",
    "diagnosis": "Primary intracranial sarcoma, <em>DICER1</em>-mutant",
    "title": "",
    "legend": "These tumours are typically composed of pleomorphic spindle cells arranged in fascicles or disorganized sheets. Brisk mitotic activity and eosinophilic cytoplasmic globules are common features.",
    "source": "David A. Solomon",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/141/18094.jpg",

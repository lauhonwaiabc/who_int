  },
  {
    "pkattachmentId": 39801,
    "bookid": 45,
    "chapterId": 141,
    "fileId": 18096,
    "type": "Figure",
    "diagnosis": "Primary intracranial sarcoma, <em>DICER1</em>-mutant",
    "title": "",
    "legend": "These tumours demonstrate immunophenotypic evidence of myogenic differentiation, but this finding can often be focal rather than diffuse. This example had desmin immunostaining in only a few small clusters of tumour cells.",
    "source": "David A. Solomon",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/141/18096.jpg",

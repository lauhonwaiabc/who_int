  },
  {
    "pkattachmentId": 39802,
    "bookid": 45,
    "chapterId": 141,
    "fileId": 18098,
    "type": "Figure",
    "diagnosis": "Primary intracranial sarcoma, <em>DICER1</em>-mutant",
    "title": "",
    "legend": "While these tumours demonstrate immunophenotypic evidence of myogenic differentiation with expression of desmin and SMA, they typically have limited or absent expression of myogenin, distinguishing them from rhabdomyosarcoma. This example has complete absence of nuclear staining for myogenin (a skeletal muscle&ndash;specific transcription factor), with only nonspecific background staining in the cytoplasmic globules.",
    "source": "David A. Solomon",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/141/18098.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/141/thumb_18098.jpg"
  },

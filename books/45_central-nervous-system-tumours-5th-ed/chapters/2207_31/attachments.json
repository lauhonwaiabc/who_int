    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 446.05pt; background: #EFF6FC; border-collapse: collapse;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 446.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 446.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\">Cerebellar localization</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 446.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 446.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\">Oligodendroglioma-like monomorphic cells associated with focal lipoma-like changes</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 446.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 446.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\">Synaptophysin expression</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 446.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\"><strong>AND (for unresolved lesions)</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 36.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 409.25pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"546\">\r\n<p class=\"TableText\">Methylation profile of cerebellar liponeurocytoma</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 446.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\"><strong><em>Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 446.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\">Adult patient</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 446.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\">Focal GFAP immunoreactivity</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 446.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\">Absence of histological features of malignancy</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

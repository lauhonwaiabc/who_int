    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 439.7pt; border-collapse: collapse;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 439.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"586\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 439.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"586\">\r\n<p class=\"TableText\">Extraventricular neurocytic neoplasm without IDH alteration</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 439.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"586\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 439.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"586\">\r\n<p class=\"TableText\">Synaptophysin expression</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 439.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"586\">\r\n<p class=\"TableText\"><strong>AND (for unresolved lesions)</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 36.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 402.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"537\">\r\n<p class=\"TableText\">Methylation profile of extraventricular neurocytoma</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 439.7pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"586\">\r\n<p class=\"TableText\"><strong><em>Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 439.7pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"586\">\r\n<p class=\"TableText\"><em>FGFR1</em> alteration (mostly <em>FGFR1</em>::<em>TACC1</em> fusion)</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\"><strong>Caveat:</strong> Diagnosis should be heavily weighted towards molecular findings because morphological analyses frequently result in mistyping <span class=\"Ref-PMID\">{29978331}</span>.</p>",

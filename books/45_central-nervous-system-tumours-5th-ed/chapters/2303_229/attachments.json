    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 444.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 444.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Supratentorial tumour with morphological and immunohistochemical features of ependymoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 444.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 444.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Gene fusion involving </span><em style=\"\"><span style=\"color: black; \">ZFTA</span></em><span style=\"color: black; \"> (</span><em style=\"\"><span style=\"color: black; \">C11orf95</span></em><span style=\"color: black; \">)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 444.85pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\"><span style=\"color: black; \">Desirable:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 444.85pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><span style=\"color: black; \">DNA methylation profile aligned with supratentorial ependymoma, </span><em style=\"\"><span style=\"color: black; \">ZFTA</span></em><span style=\"color: black; \"> fusion&ndash;positive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 444.85pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Immunoreactivity for p65 (RELA) or L1CAM</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

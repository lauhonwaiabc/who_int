ign=\"top\" width=\"546\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Molecular group evaluation was indeterminate, generated no result, or was not feasible</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

[
  {
    "pkheadingid": 518,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 497,
    "contributions": [
      {
        "pkcontributionId": 73151,
        "bookId": 45,
        "chapterId": 166,
        "headingId": 497,
        "headingText": "\r\n<p>Lymphomatoid granulomatosis is an angiocentric and angiodestructive lymphoproliferative disorder characterized by polymorphous lymphoid infiltrates composed of EBV-positive atypical B&nbsp;cells in a T&nbsp;cell&ndash;rich inflammatory background.</p>\r\n",
        "timestamp": "2021-09-30T16:11:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 519,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 498,
    "contributions": [
      {
        "pkcontributionId": 73152,
        "bookId": 45,
        "chapterId": 166,
        "headingId": 498,
        "headingText": "<p>9766/1 Lymphomatoid granulomatosis</p>\r\n<p>9766/1 Lymphomatoid granulomatosis, grade&nbsp;1</p>\r\n<p>9766/1 Lymphomatoid granulomatosis, grade&nbsp;2</p>\r\n<p>9766/3 Lymphomatoid granulomatosis, grade&nbsp;3</p>",
        "timestamp": "2021-11-09T09:24:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 520,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 499,
    "contributions": [
      {
        "pkcontributionId": 73153,
        "bookId": 45,
        "chapterId": 166,
        "headingId": 499,
        "headingText": "\r\n<p>2A81.3 Lymphomatoid granulomatosis</p>\r\n",
        "timestamp": "2021-09-30T16:11:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 521,

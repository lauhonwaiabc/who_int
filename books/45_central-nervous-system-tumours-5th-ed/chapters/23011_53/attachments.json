    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 446.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"596\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n<td style=\" border: none; padding: 0cm 0cm 0cm 0cm;\" width=\"1\">\r\n<p class=\"MsoNormal\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 446.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"596\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Circumscribed glioma with clustering of tumour cell nuclei within expansive, focally microcystic fibrillary matrix</span></p>\r\n</td>\r\n<td style=\" border: none; padding: 0cm 0cm 0cm 0cm;\" width=\"1\">\r\n<p class=\"MsoNormal\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 446.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"596\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">AND</span></strong></p>\r\n</td>\r\n<td style=\" border: none; padding: 0cm 0cm 0cm 0cm;\" width=\"1\">\r\n<p class=\"MsoNormal\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 446.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"596\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Lack of conspicuous nuclear atypia</span></p>\r\n</td>\r\n<td style=\" border: none; padding: 0cm 0cm 0cm 0cm;\" width=\"1\">\r\n<p class=\"MsoNormal\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 446.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"596\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">AND</span></strong></p>\r\n</td>\r\n<td style=\" border: none; padding: 0cm 0cm 0cm 0cm;\" width=\"1\">\r\n<p class=\"MsoNormal\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 446.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"596\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Absent or minimal mitotic activity</span></p>\r\n</td>\r\n<td style=\" border: none; padding: 0cm 0cm 0cm 0cm;\" width=\"1\">\r\n<p class=\"MsoNormal\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 447.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"3\" valign=\"top\" width=\"597\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">AND (for unresolved lesions)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 36.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\"color: black; \"><span style=\"\">&nbsp;</span></span></p>\r\n</td>\r\n<td style=\"width: 410.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; \">DNA methylation profile aligned with subependymoma</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

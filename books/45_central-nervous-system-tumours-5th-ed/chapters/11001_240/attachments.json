r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 127.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Embryonal carcinoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">+</span></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">+</span></p>\r\n</td>\r\n<td style=\"width: 63.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"85\">\r\n<p class=\"TableText\"><span style=\"color: black; \">+</span></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">&minus;</span></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">+</span></p>\r\n</td>\r\n<td style=\"width: 63.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"85\">\r\n<p class=\"TableText\"><span style=\"color: black; \">+</span></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">&minus;</span></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">&minus;</span></p>\r\n</td>\r\n<td style=\"width: 63.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"85\">\r\n<p class=\"TableText\"><span style=\"color: black; \">+</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 127.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"170\">\r\n<p class=\"TableText\"><strong>Yolk sac tumour</strong></p>\r\n</td>\r\n<td style=\"width: 63.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\">&minus;</p>\r\n</td>\r\n<td style=\"width: 63.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\">+</p>\r\n</td>\r\n<td style=\"width: 63.4pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\">+/&minus;</p>\r\n</td>\r\n<td style=\"width: 63.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\">&minus;</p>\r\n</td>\r\n<td style=\"width: 63.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\">+</p>\r\n</td>\r\n<td style=\"width: 63.4pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\">&minus;</p>\r\n</td>\r\n<td style=\"width: 63.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\">+</p>\r\n</td>\r\n<td style=\"width: 63.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\">&minus;</p>\r\n</td>\r\n<td style=\"width: 63.4pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\">+</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 127.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"170\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Choriocarcinoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">&minus;</span></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">+</span></p>\r\n</td>\r\n<td style=\"width: 63.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><span style=\"color: black; \">+/&minus;</span></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">&minus;</span></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">+</span></p>\r\n</td>\r\n<td style=\"width: 63.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><span style=\"color: black; \">&minus;</span></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">&minus;</span></p>\r\n</td>\r\n<td style=\"width: 63.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\"><span style=\"color: black; \">+</span></p>\r\n</td>\r\n<td style=\"width: 63.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><span style=\"color: black; \">+</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 127.6pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"170\">\r\n<p class=\"TableText\"><strong>Teratoma</strong></p>\r\n</td>\r\n<td style=\"width: 63.35pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\">&minus;</p>\r\n</td>\r\n<td style=\"width: 63.35pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\">+</p>\r\n</td>\r\n<td style=\"width: 63.4pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\">&minus;</p>\r\n</td>\r\n<td style=\"width: 63.35pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\">+/&minus;<sup>c</sup></p>\r\n</td>\r\n<td style=\"width: 63.35pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\">+</p>\r\n</td>\r\n<td style=\"width: 63.4pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\">&minus;</p>\r\n</td>\r\n<td style=\"width: 63.35pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\">+/&minus;<sup>d</sup></p>\r\n</td>\r\n<td style=\"width: 63.35pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"84\">\r\n<p class=\"TableText\">&minus;</p>\r\n</td>\r\n<td style=\"width: 63.4pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\">+<sup>e</sup></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\"><span style=\"color: white; \">5mC, 5-methylcytosine; LMWCK, </span>low-molecular-weight cytokeratin.</p>\r\n<p class=\"TableText\"><sup>a</sup>&beta;-hCG can be expressed in a proportion of typical germinoma cells and in syncytiotrophic giant cells in otherwise pure germinomas. <sup><span style=\"\">b</span></sup><span style=\"\">Cytokeratin</span> can be expressed in a proportion of typical germinoma cells, often in a dot-like pattern.<span style=\"\"> <sup>c</sup>KIT</span> can be found in mesenchymal or epithelioid components (e.g. melanocytes). <sup><span style=\"\">d</span></sup><span style=\"\">AFP</span> can be expressed by enteric or hepatic components. <sup><span style=\"\">e</span></sup><span style=\"\">Cytokeratin</span> is expressed in the epithelial components of teratoma.</p>",

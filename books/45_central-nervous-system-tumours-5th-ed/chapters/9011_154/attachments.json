    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diagnostic criteria for diffuse meningeal melanocytic neoplasms</p>",
    "legend": "",
    "source": "Pieter Wesseling",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 16.0cm; background: #DAEEF3; border-collapse: collapse; \" border=\"0\" width=\"605\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Diffuse or multifocal primary meningeal melanocytic neoplasm</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt; \"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><em style=\"\"><span style=\"color: black; \">For</span></em><span style=\"color: black; \"> <em style=\"\"><span style=\"\">meningeal melanocytosis:</span></em><span style=\" \"> absence of CNS parenchyma invasion, absence of marked cytological atypia, absence of mitotic activity, and absence of necrosis</span></span></p>\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt; \"><span style=\"font-family: Symbol; \"><span style=\"\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><em style=\"\"><span style=\"color: black; \">For <span style=\"\">meningeal melanomatosis:</span></span></em><span style=\"color: black; \"> invasion of the CNS parenchyma and/or marked cytological atypia and/or mitotic activity and/or necrosis</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><em><span style=\"color: black; \">Desirable:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black; \">In children, meningeal melanocytosis/melanomatosis is often </span><em style=\"\"><span style=\"color: black; \">NRAS</span></em><span style=\"color: black; \">-mutant and rarely </span><em style=\"\"><span style=\"color: black; \">BRAF</span></em><span style=\"color: black; \">-mutant</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

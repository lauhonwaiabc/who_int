    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 15.0cm; border-collapse: collapse; \" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Cellular, infiltrative glioma with mitotic activity</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">H3.3 </span>p.G35R (G34R)<span style=\" \"> or </span>p.G35V (G34V)<span style=\" \"> mutation (<em>H3-3A</em> [<em>H3F3A</em>] c.103G&gt;A, c.103G&gt;C, or c.104G&gt;T)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Hemispheric location</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND (for unresolved lesions)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 36.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \"><span style=\"\">&nbsp;</span></span></p>\r\n</td>\r\n<td style=\"width: 388.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"518\">\r\n<p class=\"TableText\"><span style=\" \">Methylation profile of diffuse hemispheric glioma, H3 G34&ndash;mutant</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">OLIG2 immunonegativity</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Loss of ATRX expression</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Diffuse p53 immunopositivity</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

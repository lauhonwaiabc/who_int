    "bookid": 45,
    "chapterId": 123,
    "fileId": 16379,
    "type": "Figure",
    "diagnosis": "Intracranial mesenchymal tumour, FET::CREB fusion&ndash;positive",
    "title": "",
    "legend": "Architectural patterns in this tumour type include reticular, cord-like, spindled, and sheet-like; this example with an <em>EWSR1</em>::<em>ATF1</em> fusion shows sheet-like architecture.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/123/16379.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/123/thumb_16379.jpg"
  },

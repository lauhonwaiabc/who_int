  },
  {
    "pkattachmentId": 39298,
    "bookid": 45,
    "chapterId": 123,
    "fileId": 16382,
    "type": "Figure",
    "diagnosis": "Intracranial mesenchymal tumour, FET::CREB fusion&ndash;positive",
    "title": "",
    "legend": "Some examples of this tumour may prompt diagnostic consideration of an atypical teratoid/rhabdoid tumour, but in this example, nuclear staining for both SMARCB1 (INI1) and SMARCA4 (BRG1) is retained, which excludes atypical teratoid/rhabdoid tumour. SMARCA4 staining is illustrated here.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/123/16382.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/123/thumb_16382.jpg"
  },
  {
    "pkattachmentId": 39299,
    "bookid": 45,
    "chapterId": 123,
    "fileId": 16383,
    "type": "Figure",
    "diagnosis": "Intracranial mesenchymal tumour, FET::CREB fusion&ndash;positive",
    "title": "",
    "legend": "Although the immunohistochemical profile is varied, CD163 immunostaining is often identified. It is strong and diffuse in this example.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/123/16383.jpg",

    "diagnosis": "Intracranial mesenchymal tumour, FET::CREB fusion&ndash;positive",
    "title": "",
    "legend": "Alcian blue highlights the myxoid background seen in some intracranial examples.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/123/16380.jpg",

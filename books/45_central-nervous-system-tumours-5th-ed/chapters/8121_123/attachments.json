  },
  {
    "pkattachmentId": 39290,
    "bookid": 45,
    "chapterId": 123,
    "fileId": 16374,
    "type": "Figure",
    "diagnosis": "Intracranial mesenchymal tumour, FET::CREB fusion&ndash;positive",
    "title": "",
    "legend": "Desmin immunoreactivity is variable in this tumour type, and it can even be negative. In this example with <em>EWSR1</em>::<em>ATF1</em> fusion, the cytoplasmic immunostaining is strong and diffuse.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/123/16374.jpg",

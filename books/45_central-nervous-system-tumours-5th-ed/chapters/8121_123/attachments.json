  },
  {
    "pkattachmentId": 39289,
    "bookid": 45,
    "chapterId": 123,
    "fileId": 16373,
    "type": "Figure",
    "diagnosis": "Intracranial mesenchymal tumour, FET::CREB fusion&ndash;positive",
    "title": "",
    "legend": "Most examples of this tumour show immunopositivity for CD99. Immunostaining is strong and diffuse in this example, which harboured an <em>EWSR1</em>::<em>ATF1</em> fusion.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/123/16373.jpg",

  },
  {
    "pkattachmentId": 39294,
    "bookid": 45,
    "chapterId": 123,
    "fileId": 16378,
    "type": "Figure",
    "diagnosis": "Intracranial mesenchymal tumour, FET::CREB fusion&ndash;positive",
    "title": "",
    "legend": "These tumours can show a wide range of histological features, making the differential diagnosis broad in some cases. This example with <em>EWSR1</em>::<em>ATF1</em> fusion shows numerous clear cells.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/123/16378.jpg",

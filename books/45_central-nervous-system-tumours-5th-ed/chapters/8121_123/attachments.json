  },
  {
    "pkattachmentId": 39292,
    "bookid": 45,
    "chapterId": 123,
    "fileId": 16376,
    "type": "Figure",
    "diagnosis": "Intracranial mesenchymal tumour, FET::CREB fusion&ndash;positive",
    "title": "",
    "legend": "This example shows very prominent small vessels in an angiomatoid pattern. The tumour harboured an <em>EWSR1</em>::CREB fusion, one of several types of characteristic fusions in this tumour type.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/123/16376.jpg",

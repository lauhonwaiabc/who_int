  {
    "pkattachmentId": 39301,
    "bookid": 45,
    "chapterId": 123,
    "fileId": 16385,
    "type": "Figure",
    "diagnosis": "Intracranial mesenchymal tumour, FET::CREB fusion&ndash;positive",
    "title": "",
    "legend": "Smear preparations from some examples may prompt diagnostic consideration of atypical teratoid/rhabdoid tumour due to the rounded cytoplasmic profiles, prominent nucleoli, mitoses, and somewhat eccentrically located nuclei (at least in some cells), as in this example. Fortunately, atypical teratoid/rhabdoid tumour can be excluded at the time of permanent section if there is retention of nuclear immunoreactivity for SMARCB1 (INI1) and SMARCA4 (BRG1).",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/123/16385.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/123/thumb_16385.jpg"
  },
  {
    "pkattachmentId": 40038,
    "bookid": 45,
    "chapterId": 123,
    "fileId": 20146,
    "type": "Figure",
    "diagnosis": "Intracranial mesenchymal tumour, FET::CREB fusion&ndash;positive",
    "title": "",
    "legend": "This 12-year-old boy presented with hemiparesis and headache and was found on neuroimaging to have a bulky left parietal tumour with heterogeneous signal features. The mass, as seen on T2-weighted axial MRI, is supratentorial, as are most examples of this tumour type. On testing, an <em>EWSR1</em>::<em>ATF1</em> fusion transcript was identified.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/123/20146.jpg",

        "pkcontributionId": 72751,
        "bookId": 45,
        "chapterId": 224,
        "headingId": 508,
        "headingText": "\r\n<p>Insufficient data available</p>\r\n",
        "timestamp": "2021-05-13T12:30:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 530,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 509,
    "contributions": [
      {
        "pkcontributionId": 72752,
        "bookId": 45,
        "chapterId": 224,
        "headingId": 509,
        "headingText": "\r\n<p>Tumours should be assessed for SMARCB1 deficiency {31732806}.</p>\r\n",
        "timestamp": "2021-05-13T12:30:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

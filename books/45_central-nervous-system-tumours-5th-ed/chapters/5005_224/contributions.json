    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 497,
    "contributions": [
      {
        "pkcontributionId": 72739,
        "bookId": 45,
        "chapterId": 224,
        "headingId": 497,
        "headingText": "\r\n<p>Desmoplastic myxoid tumour (DMT) of the pineal region, <em>SMARCB1</em>-mutant, is a tumour showing desmoplasia and myxoid changes but lacking histopathological signs of malignancy, with alterations of the <em>SMARCB1</em> region on chromosome 22q11.</p>\r\n",
        "timestamp": "2021-05-13T12:30:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

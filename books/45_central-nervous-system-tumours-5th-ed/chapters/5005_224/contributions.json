  {
    "pkheadingid": 532,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 511,
    "contributions": [
      {
        "pkcontributionId": 72755,
        "bookId": 45,
        "chapterId": 224,
        "headingId": 511,
        "headingText": "\r\n<p>Gross total resection was achieved in 4 of 7&nbsp;patients, and 3 of 7&nbsp;patients did not show evidence of residual disease on postoperative MRI {31732806}. There was no evidence of metastatic disease in any patient. After a median observation time of 48&nbsp;months, 3&nbsp;patients were alive with stable disease, 1&nbsp;patient had experienced tumour progression, and 3&nbsp;patients had died from the disease {31732806}. Prognostic markers have not yet been reported.</p>",
        "timestamp": "2021-05-13T12:30:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
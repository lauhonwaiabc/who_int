  },
  {
    "pkheadingid": 532,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 511,
    "contributions": [
      {
        "pkcontributionId": 73286,
        "bookId": 45,
        "chapterId": 175,
        "headingId": 511,
        "headingText": "\r\n<p>For resectable lesions, surgery is the first therapeutic option. For non-resectable lesions, steroids, radiotherapy, and MAPK signalling pathway inhibitors may be considered. Although little is known about the long-term natural history of Rosai&ndash;Dorfman disease of the CNS, the overall prognosis appears to be favourable in most cases.</p>",
        "timestamp": "2021-09-30T16:17:56"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
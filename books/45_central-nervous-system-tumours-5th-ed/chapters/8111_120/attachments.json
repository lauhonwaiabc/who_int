    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 16.0cm; background: #DAEEF3; border-collapse: collapse;\" border=\"0\" width=\"605\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Variably cellular tumour composed of spindled to ovoid cells arranged around a branching and hyalinized vasculature</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Variable stromal collagen deposition</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black;\">STAT6 nuclear expression</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><em><span style=\"color: black;\">Desirable (in selected cases):</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Demonstration of </span><em><span style=\"color: black;\">NAB2</span></em><span style=\"color: black;\">::</span><em><span style=\"color: black;\">STAT6</span></em><span style=\"color: black;\"> gene fusion</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

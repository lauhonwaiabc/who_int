    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"background: #DAEEF3; border-collapse: collapse; border: none; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 16.2pt;\">\r\n<td style=\"width: 522.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.2pt;\" colspan=\"2\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 15.8pt;\">\r\n<td style=\"width: 522.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.8pt;\" colspan=\"2\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\">Papillary growth pattern with epithelial-like cells</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 15.8pt;\">\r\n<td style=\"width: 522.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.8pt;\" colspan=\"2\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 15.8pt;\">\r\n<td style=\"width: 522.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.8pt;\" colspan=\"2\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\">Characteristic immunohistochemical staining pattern (e.g. positivity for cytokeratins, SPDEF, CD56)</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 15.8pt;\">\r\n<td style=\"width: 522.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.8pt;\" colspan=\"2\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 15.8pt;\">\r\n<td style=\"width: 522.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.8pt;\" colspan=\"2\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\">Pineal region location</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 15.8pt;\">\r\n<td style=\"width: 522.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.8pt;\" colspan=\"2\" valign=\"top\" width=\"697\">\r\n<p class=\"TableText\"><strong>AND (for unresolved cases)</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style
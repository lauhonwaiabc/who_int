[
  {
    "pkheadingid": 518,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 497,
    "contributions": [
      {
        "pkcontributionId": 73321,
        "bookId": 45,
        "chapterId": 178,
        "headingId": 497,
        "headingText": "\r\n<p>Histiocytic sarcoma is a malignant proliferation of cells showing morphological and immunophenotypic features of tissue histiocytes and exhibiting no other lines of differentiation.</p>\r\n",
        "timestamp": "2021-09-30T16:20:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

  {
    "pkheadingid": 532,
    "bookid": 45,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 511,
    "contributions": [
      {
        "pkcontributionId": 73337,
        "bookId": 45,
        "chapterId": 178,
        "headingId": 511,
        "headingText": "\r\n<p>Survival time has been &lt;&nbsp;12&nbsp;months after initial presentation in most reported patients.</p>",
        "timestamp": "2021-09-30T16:20:37"
      }
    ],

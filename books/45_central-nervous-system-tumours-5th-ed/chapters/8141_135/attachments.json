    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 16.0cm; background: #DAEEF3; border-collapse: collapse;\" border=\"0\" width=\"605\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black;\">A malignant primitive tumour with at least focal immunohistochemical demonstration of skeletal muscle lineage</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Absence of non-rhabdomyosarcomatous components, as detailed in the text</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><em><span style=\"color: black;\">Desirable:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Confirmation of a </span><em><span style=\"color: black;\">FOXO1</span></em><span style=\"color: black;\"> gene fusion in diagnostically difficult cases (other than alveolar rhabdomyosarcoma, in which such confirmation is essential rather than desirable)</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

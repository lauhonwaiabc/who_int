  {
    "pkattachmentId": 40193,
    "bookid": 45,
    "chapterId": 199,
    "fileId": 31336,
    "type": "Figure",
    "diagnosis": "Pathogenesis of von Hippel&ndash;Lindau syndrome",
    "title": "",
    "legend": "The &beta;&nbsp;domain of VHL&nbsp;protein interacts with HIF1&alpha;, whereas the &alpha;&nbsp;domain interacts with other partners of the VHL&nbsp;protein complex. In von Hippel&ndash;Lindau syndrome, alterations in the &alpha;&nbsp;domain prevent the formation of a functional VHL&nbsp;protein complex.",
    "source": "Karl H. Plate",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/199/31336.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/199/thumb_31336.jpg"
  },
  {
    "pkattachmentId": 40194,
    "bookid": 45,
    "chapterId": 199,
    "fileId": 31337,
    "type": "Figure",
    "diagnosis": "Pathogenesis of von Hippel&ndash;Lindau syndrome",
    "title": "",
    "legend": "In normoxia, the VHL complex binds to HIF1&alpha; and promotes ubiquitination and proteasomal degradation in an oxygen-dependent manner. In hypoxia, binding of VHL&nbsp;protein to HIF1&alpha; is impaired, resulting in the accumulation of HIF1&alpha; and increased activation of target genes. In von Hippel&ndash;Lindau syndrome, HIF1&alpha; accumulation results from failed binding of HIF1&alpha; to the dysfunctional VHL&nbsp;protein complex.",
    "source": "Karl H. Plate",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/199/31337.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/199/thumb_31337.jpg"
  },
  {
    "pkattachmentId": 40195,
    "bookid": 45,
    "chapterId": 199,
    "fileId": 31338,
    "type": "Figure",
    "diagnosis": "Pathogenesis of von Hippel&ndash;Lindau syndrome",
    "title": "",
    "legend": "HIF accumulation in haemangioblastoma stromal tumour cells leads to altered gene expression of HIF-responsive genes and results in increased vascularization due to angiogenesis and vasculogenesis; cyst formation due to increased vascular permeability; and metabolic adaptation, growth stimulation, extramedullary haematopoiesis, and lipid deposition (clear cell phenotype).",
    "source": "Karl H. Plate",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/199/31338.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/199/thumb_31338.jpg"
  },

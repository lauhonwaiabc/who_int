  },
  {
    "pkattachmentId": 39610,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 17196,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant",
    "title": "",
    "legend": "CNS WHO grade&nbsp;4 tumour. Postcontrast T1-weighted MRI showing a mass centred in the right frontoparietal region demonstrating rim enhancement surrounding central necrosis with adjacent T1 hypointensity, typical of a grade&nbsp;4 IDH-mutant astrocytoma.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",

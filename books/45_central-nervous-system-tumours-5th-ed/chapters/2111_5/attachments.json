    "pkattachmentId": 39983,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 19849,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;4 with giant cell features",
    "title": "",
    "legend": "This tumour with a mismatch repair defect showed GFAP immunoreactivity.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/19849.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_19849.jpg"
  },
  {
    "pkattachmentId": 39984,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 19850,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;4 with giant cell features",
    "title": "",
    "legend": "MLH1 expression was lost in tumour nuclei but retained in endothelial cells and other non-neoplastic cells in this tumour with a mismatch repair defect.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/19850.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_19850.jpg"
  },
  {
    "pkattachmentId": 39985,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 19851,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;4 with giant cell features",
    "title": "",
    "legend": "In addition to loss of MLH1 in tumour cells, secondary PMS2 loss was detected by immunohistochemistry, as expected, given that these two proteins normally form heterodimers.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/19851.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_19851.jpg"
  },
  {
    "pkattachmentId": 39986,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 19852,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;4 with gliosarcoma features",
    "title": "",
    "legend": "Although most gliosarcomas are IDH-wildtype, this example was IDH-mutant, as evidenced by immunoreactivity for IDH1 p.R132H protein.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",

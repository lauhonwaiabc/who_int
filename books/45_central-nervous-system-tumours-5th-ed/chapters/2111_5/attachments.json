    "bookid": 45,
    "chapterId": 5,
    "fileId": 17215,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;3",
    "title": "",
    "legend": "Immunohistochemistry for IDH1 p.R132H demonstrates strong cytoplasmic reactivity in all neoplastic cells, indicating an <em>IDH1</em> p.R132H mutation.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/17215.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_17215.jpg"
  },
  {
    "pkattachmentId": 39629,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 17216,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;3",
    "title": "",
    "legend": "Immunohistochemistry for ATRX reveals loss of nuclear staining in neoplastic cells, but retention of nuclear staining in non-neoplastic endothelial cells and glia, indicating ATRX loss or mutation in this IDH-mutant astrocytoma.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/17216.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_17216.jpg"
  },
  {
    "pkattachmentId": 39630,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 17217,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;3",
    "title": "",
    "legend": "Immunohistochemistry for p53 shows strong nuclear staining in a large percentage of neoplastic cells, which correlates well with <em>TP53</em> mutation in the setting of IDH-mutant astrocytoma.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/17217.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_17217.jpg"
  },
  {
    "pkattachmentId": 39631,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 17218,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;3",
    "title": "",
    "legend": "Smear preparation shows IDH-mutant astrocytoma cells with enlarged, hyperchromatic, and irregular nuclei within a background of extensive fibrillarity created by the elongated fibrillar processes emanating from tumour cell bodies.",
    "source": "Patrick J. Cimino",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/17218.jpg",

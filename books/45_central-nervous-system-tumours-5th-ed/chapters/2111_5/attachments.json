  },
  {
    "pkattachmentId": 39626,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 17213,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant",
    "title": "",
    "legend": "CNS WHO grade&nbsp;2 tumour. The nuclei of IDH-mutant astrocytomas are elongated, irregular, and hyperchromatic.",
    "source": "Daniel J. Brat",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/17213.jpg",

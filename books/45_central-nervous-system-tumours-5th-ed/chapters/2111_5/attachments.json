    "fileId": 17209,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant",
    "title": "",
    "legend": "CNS WHO grade&nbsp;2 tumour. Microcystic change&nbsp;/ microcyst formation in the tumour stroma is a frequent feature.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/17209.jpg",

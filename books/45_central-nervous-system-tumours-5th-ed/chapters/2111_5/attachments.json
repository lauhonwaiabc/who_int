    "tablehtml": "<table class=\"MsoNormalTable\" style=\"background: #DAEEF3; border-collapse: collapse;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"height: 14.25pt;\">\r\n<td style=\"width: 380.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" colspan=\"3\" valign=\"top\" width=\"507\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 14.25pt;\">\r\n<td style=\"width: 380.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" colspan=\"3\" valign=\"top\" width=\"507\">\r\n<p class=\"TableText\">A diffusely infiltrating glioma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 14.25pt;\">\r\n<td style=\"width: 380.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" colspan=\"3\" valign=\"top\" width=\"507\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 14.25pt;\">\r\n<td style=\"width: 380.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" colspan=\"3\" valign=\"top\" width=\"507\">\r\n<p class=\"TableText\"><em>IDH1</em> codon 132 or <em>IDH2</em> codon 172 missense mutation</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 14.25pt;\">\r\n<td style=\"width: 380.55pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" colspan=\"3\" valign=\"top\" width=\"507\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 13.65pt;\">\r\n<td style=\"width: 36.85pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.65pt;\" colspan=\"2\" valign=\"top\" width=\"49\">&nbsp;</td>\r\n<td style=\"width: 343.7pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.65pt;\" valign=\"top\" width=\"458\">\r\n<p class=\"TableText\">Loss of nuclear ATRX expression or <em>ATRX</em> mutation</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 14.25pt;\">\r\n<td style=\"width: 36.85pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" colspan=\"2\" valign=\"top\" width=\"49\">&nbsp;</td>\r\n<td style=\"width: 343.7pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" valign=\"top\" width=\"458\">\r\n<p class=\"TableText\"><strong>OR</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 14.25pt;\">\r\n<td style=\"width: 36.85pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" colspan=\"2\" valign=\"top\" width=\"49\">&nbsp;</td>\r\n<td style=\"width: 343.7pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" valign=\"top\" width=\"458\">\r\n<p class=\"TableText\">Exclusion of combined whole-arm deletions of 1p and 19q</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 16.1pt;\">\r\n<td style=\"border: none; padding: 0cm 0cm 0cm 0cm;\" width=\"1\">\r\n<p class=\"MsoNormal\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 380.05pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" colspan=\"2\" valign=\"top\" width=\"507\">\r\n<p class=\"TableText\"><strong><em>Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 16.1pt;\">\r\n<td style=\"border: none; padding: 0cm 0cm 0cm 0cm;\" width=\"1\">\r\n<p class=\"MsoNormal\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 380.05pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" colspan=\"2\" valign=\"top\" width=\"507\">\r\n<p class=\"TableText\"><em>TP53</em> mutation or strong nuclear expression of p53 in &gt;&nbsp;10% of tumour cells</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 16.1pt;\">\r\n<td style=\"border: none; padding: 0cm 0cm 0cm 0cm;\" width=\"1\">\r\n<p class=\"MsoNormal\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 380.05pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" colspan=\"2\" valign=\"top\" width=\"507\">\r\n<p class=\"TableText\">Methylation profile of astrocytoma, IDH-mutant</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 16.1pt;\">\r\n<td style=\"border: none; padding: 0cm 0cm 0cm 0cm;\" width=\"1\">\r\n<p class=\"MsoNormal\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 380.05pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" colspan=\"2\" valign=\"top\" width=\"507\">\r\n<p class=\"TableText\">Astrocytic differentiation by morphology</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

    "bookid": 45,
    "chapterId": 5,
    "fileId": 17214,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant",
    "title": "",
    "legend": "CNS WHO grade&nbsp;3 tumour. CNS WHO grade&nbsp;3 IDH-mutant astrocytomas show greater cellularity and nuclear atypia than do CNS WHO grade&nbsp;2 tumours, as well as increased mitotic activity.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/17214.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_17214.jpg"
  },
  {

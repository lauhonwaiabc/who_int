  },
  {
    "pkattachmentId": 39790,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 17936,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant",
    "title": "",
    "legend": "CNS WHO grade&nbsp;3 tumour. Some IDH-mutant astrocytomas have tumour cells with relatively round nuclei, showing histological overlap with oligodendroglioma cells. The case shown here was IDH-mutant and showed loss of ATRX expression and <em>TP53</em> mutation, diagnostic of an IDH-mutant astrocytoma.",
    "source": "Daniel J. Brat",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/17936.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_17936.jpg"
  },
  {
    "pkattachmentId": 39791,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 17937,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant",
    "title": "",
    "legend": "CNS WHO grade&nbsp;4 tumour. Palisading cells around a central focus of necrosis are a histological feature of CNS WHO grade&nbsp;4 in IDH-mutant astrocytoma.",
    "source": "Daniel J. Brat",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/17937.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_17937.jpg"
  },
  {
    "pkattachmentId": 39792,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 17938,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant",
    "title": "",
    "legend": "CNS WHO grade&nbsp;4 tumour. Microvascular proliferation, noted as accumulation of hyperplastic endothelial cells and pericytes in the vessel wall, forming budding projections, is a histological feature of CNS WHO grade&nbsp;4 in IDH-mutant astrocytoma.",
    "source": "Daniel J. Brat",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/17938.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_17938.jpg"
  },
  {
    "pkattachmentId": 39810,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 18200,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant",
    "title": "",
    "legend": "CNS WHO grade&nbsp;3 tumour. Gemistocytic differentiation can be seen focally or extensively in IDH-mutant astrocytomas and consists of tumour cells with enlarged, rounded cell bodies containing abundant eosinophilic cytoplasm and an eccentrically located nucleus.",
    "source": "Patrick J. Cimino",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/18200.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_18200.jpg"
  },
  {
    "pkattachmentId": 39811,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 18201,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;3",
    "title": "",
    "legend": "Cytopathological smear preparations highlight the large round eosinophilic cell bodies and delicate glial processes of astrocytoma cells with gemistocytic differentiation.",
    "source": "Patrick J. Cimino",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/18201.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_18201.jpg"
  },
  {
    "pkattachmentId": 39812,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 18203,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;3",
    "title": "",
    "legend": "Immunohistochemistry for GFAP shows strong and diffuse immunoreactivity in the tumour cell cytoplasm and glial processes in this IDH-mutant astrocytoma with gemistocytic differentiation.",
    "source": "Patrick J. Cimino",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/18203.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_18203.jpg"
  },
  {
    "pkattachmentId": 39818,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 18561,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant",
    "title": "",
    "legend": "CNS WHO grade&nbsp;3 tumour. T2-weighted MRI demonstrating a homogeneously hyperintense mass centred in the left frontal lobe and involving white matter and cortex, with mass effect leading to midline shift. The corresponding FLAIR image (&lt;&lt;#18562&gt;&gt;Fig.&nbsp;#18562) shows heterogeneous signal across the lesion, and this T2&ndash;FLAIR mismatch is characteristic of IDH-mutant astrocytoma.",
    "source": "Patrick J. Cimino",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/18561.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_18561.jpg"
  },
  {
    "pkattachmentId": 39819,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 18562,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant",
    "title": "",
    "legend": "CNS WHO grade&nbsp;3 tumour. FLAIR MRI demonstrating a mass lesion centred in the left frontal lobe involving the white matter and cortex with heterogeneous signal intensity and demonstrating distinct regions of hyperintensity and hypointensity. The corresponding T2-weighted image (&lt;&lt;#18561&gt;&gt;Fig.&nbsp;#18561) shows homogeneous signal intensity, and this T2&ndash;FLAIR mismatch is characteristic of IDH-mutant astrocytoma.",
    "source": "Patrick J. Cimino",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/18562.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_18562.jpg"
  },
  {
    "pkattachmentId": 39979,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 19845,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;4 with giant cell features",
    "title": "",
    "legend": "Giant cell tumours are often IDH-wildtype, but this example was IDH-mutant. Next-generation sequencing revealed biallelic <em>MLH1</em> inactivation, as well as hypermutation, including mutations of the <em>IDH1</em>, <em>TP53</em>, and <em>ATRX</em> genes.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/19845.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_19845.jpg"
  },
  {
    "pkattachmentId": 39980,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 19846,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;4 with giant cell features",
    "title": "",
    "legend": "Although most giant cell glioblastomas are IDH-wildtype, this one was IDH-mutant, as evidenced by the immunoreactivity for IDH1 p.R132H.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/19846.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_19846.jpg"
  },
  {
    "pkattachmentId": 39981,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 19847,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;4 with giant cell features",
    "title": "",
    "legend": "This giant cell tumour with a mismatch repair defect showed diffuse p53 positivity, consistent with <em>TP53</em> mutation.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/19847.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_19847.jpg"
  },
  {
    "pkattachmentId": 39982,
    "bookid": 45,
    "chapterId": 5,
    "fileId": 19848,
    "type": "Figure",
    "diagnosis": "Astrocytoma, IDH-mutant, CNS WHO grade&nbsp;4 with giant cell features",
    "title": "",
    "legend": "This tumour with a mismatch repair defect showed loss of ATRX expression by immunohistochemistry.",
    "source": "Arie Perry",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/45/5/19848.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/45/5/thumb_19848.jpg"
  },

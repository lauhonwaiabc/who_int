    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 7.25pt;\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 7.25pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 15.35pt;\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.35pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Diffuse astrocytoma without histological features of anaplasia</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 3.0pt;\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.0pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 3.0pt;\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.0pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">No mutations in IDH or H3 genes </span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 6.25pt;\">\r\n<td style=\"width: 15.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 6.25pt;\" colspan=\"2\" valign=\"top\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 7.3pt;\">\r\n<td style=\"width: 36.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 7.3pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \"><span style=\"\">&nbsp;</span></span></p>\r\n</td>\r\n<td style=\"width: 388.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 7.3pt;\" valign=\"top\" width=\"518\">\r\n<p class=\"TableText\"><span style=\" \">Structural variant of </span><em style=\"\"><span style=\"\">MYB</span></em><span style=\" \"> or </span><em style=\"\"><span style=\"\">MYBL1</span></em></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 3.0pt;\">\r\n<td style=\"width: 36.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.0pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \"><span style=\"\">&nbsp;</span></span></p>\r\n</td>\r\n<td style=\"width: 388.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.0pt;\" valign=\"top\" width=\"518\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">OR</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 17.75pt;\">\r\n<td style=\"width: 36.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.75pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \"><span style=\"\">&nbsp;</span></span></p>\r\n</td>\r\n<td style=\"width: 388.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.75pt;\" valign=\"top\" width=\"518\">\r\n<p class=\"TableText\"><span style=\" \">DNA methylation profile aligned with diffuse astrocytoma, </span><em style=\"\"><span style=\"\">MYB</span></em><span style=\" \">- or </span><em style=\"\"><span style=\"\">MYBL1</span></em><span style=\" \">-altered</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"567\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 15.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"567\">\r\n<p class=\"TableText\"><span style=\" \">Absence of OLIG2 and MAP2 expression</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

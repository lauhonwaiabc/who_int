    "source": "Dominique Figarella-Branger",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 3.15pt;\">\r\n<td style=\"width: 444.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.15pt;\" colspan=\"2\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.0pt;\">\r\n<td style=\"width: 444.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.0pt;\" colspan=\"2\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><span style=\" \">Cortical glioneuronal tumour</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.0pt;\">\r\n<td style=\"width: 444.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.0pt;\" colspan=\"2\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 15.0pt;\">\r\n<td style=\"width: 444.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.0pt;\" colspan=\"2\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><span style=\" \">Presence of the specific glioneuronal element</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.75pt;\">\r\n<td style=\"width: 444.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.75pt;\" colspan=\"2\" width=\"593\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND (for unresolved lesions)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.75pt;\">\r\n<td style=\"width: 36.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.75pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 408.0pt; background: #DAEEF3; padding: 0cm 0cm 0cm 0cm; height: 12.75pt;\" valign=\"top\" width=\"544\">\r\n<p class=\"TableText\"><em style=\"\"><span style=\"\">FGFR1</span></em><span style=\" \"> gene alteration (</span><em style=\"\"><span style=\"\">FGFR1</span></em><span style=\" \"> internal tandem duplication [ITD], fusion, missense mutation)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.75pt;\">\r\n<td style=\"width: 36.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.75pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 408.0pt; background: #DAEEF3; padding: 0cm 0cm 0cm 0cm; height: 12.75pt;\" valign=\"top\" width=\"544\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">OR</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.75pt;\">\r\n<td style=\"width: 36.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.75pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 408.0pt; background: #DAEEF3; padding: 0cm 0cm 0cm 0cm; height: 12.75pt;\" width=\"544\">\r\n<p class=\"TableText\"><span style=\" \">Methylation profile of dysembryoplastic neuroepithelial tumour</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 444.85pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 444.85pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"593\">\r\n<p class=\"TableText\"><span style=\" \">Early-onset focal epilepsy</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

    "title": "<p>Diagnostic criteria for ganglioglioma</p>",
    "legend": "",
    "source": "Dominique Figarella-Branger",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 432.35pt; border-collapse: collapse; \" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><span style=\" \">Intra-axial low-grade glioneuronal tumour</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><span style=\" \">Combination of neoplastic ganglion and glial cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 432.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND (for unresolved lesions)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 36.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \"><span style=\"\">&nbsp;</span></span></p>\r\n</td>\r\n<td style=\"width: 395.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"527\">\r\n<p class=\"TableText\"><em style=\"\"><span style=\"\">BRAF</span></em><span style=\" \"> p.V600E mutation or other MAPK pathway alteration</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 36.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 395.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"527\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">OR</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 36.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\"><span style=\" \">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 395.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"527\">\r\n<p class=\"TableText\"><span style=\" \">Methylation profile of ganglioglioma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.75pt;\">\r\n<td style=\"width: 432.35pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.75pt;\" colspan=\"2\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.75pt;\">\r\n<td style=\"width: 432.35pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.75pt;\" colspan=\"2\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\"><span style=\" \">Absence of IDH mutation</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },

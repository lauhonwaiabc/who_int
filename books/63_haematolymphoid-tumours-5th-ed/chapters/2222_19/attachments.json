  {
    "pkattachmentId": 59738,
    "bookid": 63,
    "chapterId": 19,
    "fileId": 32086,
    "type": "Figure",
    "diagnosis": "Mastocytoma",
    "title": "",
    "legend": "Sheets of isomorphic round cells with a histiocytoid appearance are seen expanding the dermis (&lt;&lt;32086&gt;&gt;). The neoplastic cells show numerous cytoplasmic metachromatic granules (Giemsa) (&lt;&lt;32087&gt;&gt;). A moderate cytoplasmic expression of tryptase is evident (&lt;&lt;32088&gt;&gt;). In addition, the neoplastic mast cells demonstrate a strong membranous expression of KIT (CD117). Of note, no expression of CD25 and no <em>KIT</em> mutations (neither p.D816V nor mutations in other relevant regions of <em>KIT</em>) were found (&lt;&lt;32089&gt;&gt;).",
    "source": "Isabel Colmenero",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/63/19/32086.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/63/19/thumb_32086.jpg"
  },

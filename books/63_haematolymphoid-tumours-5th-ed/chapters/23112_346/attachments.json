    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" width=\"943\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 231.5pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" colspan=\"2\" width=\"309\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><em><span lang=\"EN-GB\">CEBPA</span></em><span lang=\"EN-GB\"> mutation type</span></strong></p>\r\n</td>\r\n<td style=\"width: 236.25pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" colspan=\"2\" width=\"315\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Percentage of newly diagnosed cases</span></strong></p>\r\n</td>\r\n<td style=\"width: 239.35pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"319\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Prognosis</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 231.5pt; padding: 0cm 5.4pt;\" colspan=\"2\" width=\"309\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Double mutation</span></strong></p>\r\n</td>\r\n<td style=\"width: 236.25pt; padding: 0cm 5.4pt;\" colspan=\"2\" width=\"315\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">2.8% of AML cases</span></p>\r\n</td>\r\n<td style=\"width: 239.35pt; padding: 0cm 5.4pt;\" width=\"319\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 1cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 203.15pt; background: #daeef3; padding: 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"271\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">With bZIP</span></strong></p>\r\n</td>\r\n<td style=\"width: 1cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 207.9pt; background: #daeef3; padding: 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"277\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">91% of <em>CEBPA</em> double-mutation cases</span></p>\r\n</td>\r\n<td style=\"width: 239.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"319\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Favourable</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 1cm; padding: 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 203.15pt; padding: 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"271\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Without bZIP</span></strong></p>\r\n</td>\r\n<td style=\"width: 1cm; padding: 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 207.9pt; padding: 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"277\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">9% of <em>CEBPA</em> double-mutation cases</span></p>\r\n</td>\r\n<td style=\"width: 239.35pt; padding: 0cm 5.4pt;\" width=\"319\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Conflicting evidence</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 231.5pt; background: #daeef3; padding: 0cm 5.4pt;\" colspan=\"2\" width=\"309\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Single mutation</span></strong></p>\r\n</td>\r\n<td style=\"width: 236.25pt; background: #daeef3; padding: 0cm 5.4pt;\" colspan=\"2\" width=\"315\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">2.3% of AML cases</span></p>\r\n</td>\r\n<td style=\"width: 239.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"319\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 1cm; padding: 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 203.15pt; padding: 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"271\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">bZIP</span></strong></p>\r\n</td>\r\n<td style=\"width: 1cm; padding: 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 207.9pt; padding: 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"277\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">32% of <em>CEBPA</em> single-mutation cases</span></p>\r\n</td>\r\n<td style=\"width: 239.35pt; padding: 0cm 5.4pt;\" width=\"319\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Favourable</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 1cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 203.15pt; background: #daeef3; padding: 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"271\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">TAD</span></strong></p>\r\n</td>\r\n<td style=\"width: 1cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 207.9pt; background: #daeef3; padding: 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"277\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">68% of <em>CEBPA</em> single-mutation cases</span></p>\r\n</td>\r\n<td style=\"width: 239.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"319\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Similar to that of AML with wildtype <em>CEBPA</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 231.5pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" colspan=\"2\" width=\"309\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Wild type</span></strong></p>\r\n</td>\r\n<td style=\"width: 236.25pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" colspan=\"2\" width=\"315\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">95% of AML cases</span></p>\r\n</td>\r\n<td style=\"width: 239.35pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"319\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">TAD, transactivation domain.</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Note: Data are from <span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\">{343201
  {
    "pkattachmentId": 58867,
    "bookid": 63,
    "chapterId": 294,
    "fileId": 29966,
    "type": "Figure",
    "diagnosis": "IgM monoclonal gammopathy of undetermined significance",
    "title": "",
    "legend": "Bone marrow core biopsy. Scattered lymphocytes and plasmacytoid cells are found but are difficult to identify without immunohistochemistry.",
    "source": "Santiago Montes-Moreno",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/63/294/29966.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/63/294/thumb_29966.jpg"
  },
  {
    "pkattachmentId": 58868,
    "bookid": 63,
    "chapterId": 294,
    "fileId": 29967,
    "type": "Figure",
    "diagnosis": "Lymphoplasmacytic lymphoma",
    "title": "",
    "legend": "The most common lymph node presentation is characterized by a diffuse infiltrate with architectural sparing; follicular colonization may be present (&lt;&lt;29967&gt;&gt;). The crystal-storing histiocytosis pattern shows a prominent histiocytic reaction, with clusters of macrophages with foreign body&ndash;type reaction and crystalline inclusions in the cytoplasm (&lt;&lt;29970&gt;&gt;). Lymphocytes and plasmacytoid lymphocytes are present; note the presence of immunoglobulin nuclear inclusions (Dutcher bodies) (&lt;&lt;32940&gt;&gt;).",
    "source": "Santiago Montes-Moreno",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/63/294/29967.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/63/294/thumb_29967.jpg"
  },
  {
    "pkattachmentId": 58871,
    "bookid": 63,
    "chapterId": 294,
    "fileId": 29970,
    "type": "Figure",
    "diagnosis": "Lymphoplasmacytic lymphoma",
    "title": "",
    "legend": "The most common lymph node presentation is characterized by a diffuse infiltrate with architectural sparing; follicular colonization may be present (&lt;&lt;29967&gt;&gt;). The crystal-storing histiocytosis pattern shows a prominent histiocytic reaction, with clusters of macrophages with foreign body&ndash;type reaction and crystalline inclusions in the cytoplasm (&lt;&lt;29970&gt;&gt;). Lymphocytes and plasmacytoid lymphocytes are present; note the presence of immunoglobulin nuclear inclusions (Dutcher bodies) (&lt;&lt;32940&gt;&gt;).",
    "source": "Santiago Montes-Moreno",

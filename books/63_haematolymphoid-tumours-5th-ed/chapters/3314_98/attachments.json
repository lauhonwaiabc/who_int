  {
    "pkattachmentId": 60501,
    "bookid": 63,
    "chapterId": 98,
    "fileId": 28822,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Manifestations of Rosai&ndash;Dorfman disease (RDD)</p>",
    "legend": "",
    "source": "Yasodha Natkunam",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 134.75pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"180\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Subtype</span></strong></p>\r\n</td>\r\n<td style=\"width: 332.75pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"444\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Characteristic features</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 134.75pt; padding: 0cm 5.4pt;\" width=\"180\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Classic (nodal) RDD</span></strong></p>\r\n</td>\r\n<td style=\"width: 332.75pt; padding: 0cm 5.4pt;\" width=\"444\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Most commonly involves cervical lymph nodes (87%), followed by inguinal (26%), axillary (24%), and mediastinal (15%) lymph nodes</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 134.75pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"180\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Extranodal RDD</span></strong></p>\r\n</td>\r\n<td style=\"width: 332.75pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"444\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Extranodal sites are involved in 43% of patients: most frequently the nasal cavity, paranasal sinuses, salivary gland, skin, soft tissue, upper respiratory tract, bone, retro-orbital tissue, and CNS, and less commonly single organs</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Splenic involvement is rare</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Cases of disseminated RDD have been rarely reported</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 134.75pt; padding: 0cm 5.4pt;\" width=\"180\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Familial RDD</span></strong></p>\r\n</td>\r\n<td style=\"width: 332.75pt; padding: 0cm 5.4pt;\" width=\"444\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Described in association with germline mutations in </span><em><span lang=\"EN-GB\">SLC29A3</span></em><span lang=\"EN-GB\"> (H&nbsp;syndrome&nbsp;/ Faisalabad histiocytosis; 20%) or </span><em><span lang=\"EN-GB\">FAS</span></em><span lang=\"EN-GB\"> (<em>TNFRSF6</em>)</span><span lang=\"EN-GB\"> (autoimmune lymphoproliferative syndrome; 41%)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 134.75pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"180\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Neoplasia-related RDD</span></strong></p>\r\n</td>\r\n<td style=\"width: 332.75pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"444\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Described in association with lymphoma, leukaemia, and other histiocytoses including Langerhans cell histiocytosis and Erdheim&ndash;Chester disease</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 134.75pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"180\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Immune-related RDD</span></strong></p>\r\n</td>\r\n<td style=\"width: 332.75pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"444\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Described in association with systemic lupus erythematosus, idiopathic juvenile arthritis, autoimmune haemolytic anaemia, and HIV</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">May be associated with increased IgG4+ plasma cells, although other features of IgG4-related disease are absent</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },
  {
    "pkattachmentId": 60598,
    "bookid": 63,
    "chapterId": 98,
    "fileId": 32035,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Clinical, pathological, and molecular findings of Rosai&ndash;Dorfman disease as compared with other histiocytoses</p>",
    "legend": "",
    "source": "Yasodha Natkunam",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 769px; border-collapse: collapse;\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 152px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 136.297px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Rosai&ndash;Dorfman disease</span></strong></p>\r\n</td>\r\n<td style=\"width: 136.422px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Langerhans cell histiocytosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 137.062px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Erdheim&ndash;Chester disease</span></strong></p>\r\n</td>\r\n<td style=\"width: 135.344px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">ALK+ histiocytosis</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 152px; padding: 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Age, sex, and ethnic predilection</span></strong></p>\r\n</td>\r\n<td style=\"width: 136.297px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Older children and adults</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">M:F&nbsp;ratio: 3.2:1</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Individuals of African descent</span></p>\r\n</td>\r\n<td style=\"width: 136.422px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Older children and adults</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">M:F&nbsp;ratio: 3.7:1</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Individuals of northern European descent</span></p>\r\n</td>\r\n<td style=\"width: 137.062px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Adults (55&ndash;60&nbsp;years); rare in children</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">M:F&nbsp;ratio: 3:1</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">No ethnic predilection reported</span></p>\r\n</td>\r\n<td style=\"width: 135.344px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Systemic form occurs in infants; multisystem and single-system forms occur over a wide age range (children and adults)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">F&nbsp;&gt;&nbsp;M</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">No ethnic predilection reported</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 152px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Sites of involvement</span></strong></p>\r\n</td>\r\n<td style=\"width: 136.297px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Lymph nodes (majority) and/or extranodal sites, including skin, CNS, bone, and soft tissue; less frequent in single organs</span></p>\r\n</td>\r\n<td style=\"width: 136.422px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Solitary, multiple, or disseminated</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Bone (skull, femur, vertebrae, pelvic bones, ribs), skin, and soft tissue; less commonly, lymph nodes; gonads and kidney are spared</span></p>\r\n</td>\r\n<td style=\"width: 137.062px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Localized or disseminated</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Any organ or tissue; skeleton &gt;&nbsp;95%; cardiovascular system &gt;&nbsp;50%; CNS and retroperitoneum 20&ndash;30%; skin manifestations may predominate</span></p>\r\n</td>\r\n<td style=\"width: 135.344px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Systemic form involves liver, spleen, bone marrow, and/or additional sites such as skin and CNS</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Multisystem and single-system forms can involve many different sites, most commonly the central and peripheral nervous systems, skin, breast, bone, and lung</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 152px; padding: 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Lesional cells</span></strong></p>\r\n</td>\r\n<td style=\"width: 136.297px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Large histiocytes with round to oval vesicular nuclei with prominent nucleoli, abundant pale cytoplasm with indistinct borders, and emperipolesis; minimal atypia and mitotic activity (Ki-67 index &lt;&nbsp;10%)</span></p>\r\n</td>\r\n<td style=\"width: 136.422px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Oval histiocytes with grooved, folded, or lobed nuclei with fine chromatin and delicate nuclear membranes, inconspicuous nucleoli, and a moderate amount of eosinophilic cytoplasm; minimal atypia, although mitoses may be abundant</span></p>\r\n</td>\r\n<td style=\"width: 137.062px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Histiocytes with single small nuclei and foamy, occasionally eosinophilic cytoplasm; frequent Touton giant cells</span></p>\r\n</td>\r\n<td style=\"width: 135.344px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Large histiocytes with irregularly folded nuclei, fine chromatin, and abundant eosinophilic cytoplasm, sometimes with minor emperipolesis</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Histiocytes can be spindled or foamy, with or without admixed Touton giant cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 152px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Immune microenvironment</span></strong></p>\r\n</td>\r\n<td style=\"width: 136.297px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Plasma cells, lymphocytes; less commonly, neutrophils; eosinophils absent</span></p>\r\n</td>\r\n<td style=\"width: 136.422px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Eosinophils, macrophages, neutrophils, small lymphocytes</span></p>\r\n</td>\r\n<td style=\"width: 137.062px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Small lymphocytes, plasma cells, neutrophils</span></p>\r\n</td>\r\n<td style=\"width: 135.344px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Small lymphocytes, plasma cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 152px; padding: 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Immunohistochemical profile</span></strong></p>\r\n</td>\r\n<td style=\"width: 136.297px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive for S100, OCT2, phosphorylated ERK, cyclin&nbsp;D1; variable CD14, CD68, CD163; lacks CD1a, CD207, BRAF p.V600E</span></p>\r\n</td>\r\n<td style=\"width: 136.422px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive for S100, CD1a, CD207, CD68, CD163, and (commonly) BRAF p.V600E</span></p>\r\n</td>\r\n<td style=\"width: 137.062px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive for CD68, CD163, CD14, factor&nbsp;XIIIa, and (commonly) BRAF p.V600E; lacks S100 (rare positive), CD1a, CD207</span></p>\r\n</td>\r\n<td style=\"width: 135.344px; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive for ALK (cytoplasmic or membranous), CD68, CD163, factor&nbsp;XIIIa, S100 (50%); lacks CD1a, CD207, BRAF p.V600E</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 152px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Genetic profile</span></strong></p>\r\n</td>\r\n<td style=\"width: 136.297px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">MAPK/ERK pathway mutations (40&ndash;50%): <em>KRAS</em>, <em>NRAS</em>, <em>MAP2K1</em>, <em>ARAF</em>, and <em>CSF1R</em>; rarely, <em>BRAF</em> p.V600E mutations</span></p>\r\n</td>\r\n<td style=\"width: 136.422px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">BRAF</span></em><span lang=\"EN-GB\"> p.V600E, <em>MAP2K1</em>, and <em>ARAF</em> mutations; IGH, IGK, and TR (TCR) gene rearrangements may be present</span></p>\r\n</td>\r\n<td style=\"width: 137.062px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">BRAF</span></em><span lang=\"EN-GB\"> p.V600E, <em>MAP2K1</em>, <em>KRAS</em>, <em>NRAS</em>, <em>ARAF</em>, <em>PIK3CA</em> mutations</span></p>\r\n</td>\r\n<td style=\"width: 135.344px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">KIF5B</span></em><span lang=\"EN-GB\">::<em>ALK</em> gene fusion in majority</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

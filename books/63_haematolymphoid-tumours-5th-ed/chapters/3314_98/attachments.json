[
  {
    "pkattachmentId": 58516,
    "bookid": 63,
    "chapterId": 98,
    "fileId": 28861,
    "type": "Figure",
    "diagnosis": "Extranodal Rosai&ndash;Dorfman disease",
    "title": "",
    "legend": "At low magnification, extranodal Rosai&ndash;Dorfman disease shows alternating light and dark areas composed of histiocytic aggregates and lymphocytic infiltrates separated by fibrous bands (&lt;&lt;28864&gt;&gt;). Emperipolesis may be subtle in extranodal cases of Rosai&ndash;Dorfman disease; the presence of perivascular plasma cells may be a helpful diagnostic feature (&lt;&lt;28865&gt;&gt;). Rosai&ndash;Dorfman disease involving the heart: the histiocytes are very large and have abundant pale-staining cytoplasm with poorly defined borders; emperipolesis of lymphocytes and plasma cells is seen (&lt;&lt;29024&gt;&gt;). Extranodal Rosai&ndash;Dorfman disease involving bone, with sheets of histiocytes (&lt;&lt;28861&gt;&gt;).",
    "source": "Elizabeth G. Demicco",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/63/98/28861.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/63/98/thumb_28861.jpg"
  },

[
  {
    "pkattachmentId": 60024,
    "bookid": 63,
    "chapterId": 77,
    "fileId": 35368,
    "type": "Figure",
    "diagnosis": "Mixed-phenotype acute leukaemia, T/myeloid, with biphenotypic expression",
    "title": "",
    "legend": "A single abnormal progenitor population (red) shows expression of myeloperoxidase and cCD3 at levels equivalent to those of normal neutrophils and mature T&nbsp;cells (blue), respectively. The population also expresses cCD79a at a level approaching that of mature B&nbsp;cells (blue) but lacks expression of CD19 and other B-cell antigens, as can be seen in T-lineage acute leukaemia. The leukaemic progenitors also express CD7 at a level higher than that seen on mature T&nbsp;cells.",
    "source": "Brent Lee Wood",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/63/77/35368.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/63/77/thumb_35368.jpg"
  },
  {
    "pkattachmentId": 60025,
    "bookid": 63,
    "chapterId": 77,
    "fileId": 35369,
    "type": "Figure",
    "diagnosis": "Mixed-phenotype acute leukaemia, T/B/myeloid, with both bilineal B/myeloid and discrete T-lineage differentiation",
    "title": "",
    "legend": "Two abnormal, discrete progenitor populations are present. The first population has low side scatter and bright CD45 and shows abnormal T-lineage differentiation (blue), with higher CD7 expression than in normal mature T&nbsp;cells (green), variable CD34, and slightly lower cCD3 than mature T&nbsp;cells without myeloperoxidase. The second population (red) has higher side scatter, lower CD45, and shows bilineal expression of cCD79a and myeloperoxidase arising from a common CD34+ progenitor. The variable expression of myeloperoxidase mimics that in the normal early myeloid lineage and overlaps the level seen on mature neutrophils, indicative of myeloid differentiation. In addition, cCD79a and CD19 are expressed on the same subpopulation at levels overlapping those of the normal mature B&nbsp;cells (green), indicative of B-lineage differentiation.",
    "source": "Brent Lee Wood",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/63/77/35369.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/63/77/thumb_35369.jpg"
  },
  {
    "pkattachmentId": 60362,
    "bookid": 63,
    "chapterId": 77,
    "fileId": 40204,
    "type": "Figure",
    "diagnosis": "Cytomorphological spectrum of mixed-phenotype acute leukaemia",
    "title": "",
    "legend": "Peripheral blood smear at leukaemia diagnosis (Wright&ndash;Giemsa). <strong>Top row:</strong>&nbsp;Many of the circulating blasts show cytomorphological features of lymphoblasts, including relatively small size, scant cytoplasm, and occasional cytoplasmic tags. <strong>Bottom row:</strong>&nbsp;Other circulating blasts in this case show cytomorphological features of abnormal myeloblasts, with large cell size, distinct nucleoli, and occasional cytoplasmic granules.",
    "source": "Source: Other source (Images and captions courtesy of Alexandra E. Kovach MD, Hematopathology, Department of Pathology and Laboratory Medicine, Children&rsquo;s Hospital Los Angeles, Los Angeles, CA)",
    "copyright": "",

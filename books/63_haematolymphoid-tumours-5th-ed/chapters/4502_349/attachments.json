  {
    "pkattachmentId": 60573,
    "bookid": 63,
    "chapterId": 349,
    "fileId": 31362,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diagnostic criteria for cold agglutinin disease {31839434; 24143001; 27913484; 31235526}</p>",
    "legend": "",
    "source": "Sigbjørn Berentsen",
    "copyright": "",
    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 707.1pt; background: #daeef3; border-collapse: collapse; border: none;\" border=\"0\" width=\"943\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"943\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Essential:</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Chronic haemolysis&nbsp;&ndash; as assessed by high indirect bilirubin, low haptoglobin, high LDH, and (often) high absolute reticulocyte count</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Monospecific direct antiglobulin test (DAT) strongly positive for C3d; DAT is usually negative for IgG but occasionally is weakly positive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Cold agglutinin titre &gt;&nbsp;64 at 4&nbsp;&deg;C; the specimen must be kept at 37&ndash;38&nbsp;&deg;C from sampling until plasma/serum has been removed from the cells/clot</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">No overt malignant disease or relevant infection&nbsp;&ndash; clinical assessment for malignancy; radiology as required; exclude recent infection with <em>Mycoplasma</em> or EBV</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Evidence of a clonal B-cell disorder&nbsp;&ndash; as assessed by electrophoresis, flow cytometry, and/or bone marrow biopsy</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"943\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Desirable:</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Monoclonal IgM/kappa in plasma/serum (or, rarely, IgG or lambda phenotype); the specimen must be kept at 37&ndash;38&nbsp;&deg;C from sampling until plasma/serum has been removed from the cells/clot</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">B-cell kappa-to-lambda ratio &gt;&nbsp;3.5 (or, rarely, &lt;&nbsp;0.9)&nbsp;&ndash; as assessed by flow cytometry in bone marrow aspirate</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Cold agglutinin&ndash;associated lymphoproliferative disorder by histopathology (on bone marrow biopsy)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><em><span lang=\"EN-GB\">MYD88</span></em><span lang=\"EN-GB\"> p.L265P mutation not found&nbsp;&ndash; as assessed in bone marrow</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },
  {
    "pkattachmentId": 60613,
    "bookid": 63,
    "chapterId": 349,
    "fileId": 32313,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Differential diagnosis based on bone marrow findings: cold agglutinin disease and lymphoplasmacytic lymphoma</p>",
    "legend": "",
    "source": "Ulla Randen",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 606.9pt; border-collapse: collapse;\" border=\"0\" width=\"809\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 312.1pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Cold agglutinin disease</span></strong></p>\r\n</td>\r\n<td style=\"width: 294.8pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"393\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Lymphoplasmacytic lymphoma</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 312.1pt; padding: 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Small nodules, no diffuse infiltrates or intrasinusoidal growth</span></p>\r\n</td>\r\n<td style=\"width: 294.8pt; padding: 0cm 5.4pt;\" width=\"393\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Nodular and/or diffuse</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 312.1pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Intertrabecular infiltrates</span></p>\r\n</td>\r\n<td style=\"width: 294.8pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"393\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Paratrabecular/intertrabecular infiltrates</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 312.1pt; padding: 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Small B&nbsp;cells and (usually) plasma cells</span></p>\r\n</td>\r\n<td style=\"width: 294.8pt; padding: 0cm 5.4pt;\" width=\"393\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Small B&nbsp;cells, lymphoplasmacytoid cells, plasma cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 312.1pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Plasma cells widely spread in the marrow, outside the aggregates</span></p>\r\n</td>\r\n<td style=\"width: 294.8pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"393\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Plasma cells admixed in the infiltrates</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 312.1pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">No mast cell infiltration</span></p>\r\n</td>\r\n<td style=\"width: 294.8pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"393\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Mast cell infiltration present</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },
  {
    "pkattachmentId": 60723,
    "bookid": 63,
    "chapterId": 349,

[
  {
    "pkattachmentId": 59697,
    "bookid": 63,
    "chapterId": 180,
    "fileId": 31924,
    "type": "Figure",
    "diagnosis": "Lymphomatoid granulomatosis",
    "title": "",
    "legend": "Lymphomatoid granulomatosis, grade&nbsp;3, in the brain exhibits polymorphic angiocentric infiltrates (&lt;&lt;32575&gt;&gt;). CD20 shows clusters of viable CD20+ B&nbsp;cells at the edge of a necrotizing lesion; cellular debris and lymphoid cells within the necrosis exhibit weak immunoreactivity (&lt;&lt;31924&gt;&gt;). In&nbsp;situ hybridization for EBV-encoded small RNA (EBER) highlights the fact that the majority of the large transformed cells are EBV-positive (&lt;&lt;33705&gt;&gt;). In a case in the skin, the angiocentric infiltrate contains numerous large transformed lymphoid cells and is accompanied by fibrinoid necrosis of the affected blood vessels; there are also large necrotic areas (&lt;&lt;32580&gt;&gt;).",
    "source": "Martina Deckert",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/63/180/31924.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/63/180/thumb_31924.jpg"
  },

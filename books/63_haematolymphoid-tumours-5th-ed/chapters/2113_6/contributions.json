        "bookId": 63,
        "chapterId": 6,
        "headingId": 702,
        "headingText": "<p>9980/1 Clonal cytopenia of undetermined significance</p>\r\n&nbsp;",
        "timestamp": "2024-03-18T16:17:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 766,

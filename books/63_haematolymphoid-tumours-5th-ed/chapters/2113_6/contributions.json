        "headingId": 703,
        "headingText": "\r\n\r\n<p>None</p>\r\n\r\n",
        "timestamp": "2024-03-01T11:34:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 767,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 704,
    "contributions": [
      {
        "pkcontributionId": 118144,
        "bookId": 63,
        "chapterId": 6,
        "headingId": 704,
        "headingText": "\r\n\r\n<p><em>Not recommended:</em> clonal idiopathic cytopenia of unknown significance; clonal cytopenia.</p>\r\n\r\n",
        "timestamp": "2024-03-01T11:34:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

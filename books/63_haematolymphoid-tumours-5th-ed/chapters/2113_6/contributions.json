[
  {
    "pkheadingid": 764,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 701,
    "contributions": [
      {
        "pkcontributionId": 118141,
        "bookId": 63,
        "chapterId": 6,
        "headingId": 701,
        "headingText": "\r\n\r\n<p>Clonal cytopenia of undetermined significance (CCUS) refers to clonal haematopoiesis (CH) detected in the presence of one or more persistent cytopenias that are otherwise unexplained by haematological or non-haematological conditions.</p>\r\n\r\n",
        "timestamp": "2024-03-01T11:34:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 765,

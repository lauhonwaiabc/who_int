[
  {
    "pkattachmentId": 60074,
    "bookid": 63,
    "chapterId": 88,
    "fileId": 36216,
    "type": "Figure",
    "diagnosis": "Blastic plasmacytoid dendritic cell neoplasm",
    "title": "",
    "legend": "A very dense mononuclear cell infiltrate is present in the superficial and mid-reticular dermis, sparing the surface epidermis (&lt;&lt;36216&gt;&gt;). Malignant mononuclear cell infiltrate shows marked haemorrhage in the background and spares the surface epidermis (a grenz zone between the infiltrate and the surface is present) (&lt;&lt;36218&gt;&gt;). Blastic plasmacytoid dendritic cell neoplasm involving skin: neoplastic cells show coexpression of CD123 (red) and TCF4 (brown) by dual-colour immunohistochemistry; the dual expression of TCF4 and CD123 is highly sensitive and specific for plasmacytoid dendritic cells {31261288} (&lt;&lt;36225&gt;&gt;).",
    "source": "Alejandro Gru",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/63/88/36216.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/63/88/thumb_36216.jpg"
  },
  {
    "pkattachmentId": 60075,
    "bookid": 63,
    "chapterId": 88,
    "fileId": 36217,
    "type": "Figure",
    "diagnosis": "Blastic plasmacytoid dendritic cell neoplasm",
    "title": "",
    "legend": "Tumour cells have an intermediate-sized mononuclear morphology with fine chromatin, mild irregular nuclear borders, and variable nucleoli (&lt;&lt;36217&gt;&gt;). In other cases, the mononuclear cells are intermediate to large, with abundant, slightly granular cytoplasm and irregular nuclear borders; immature, fine and granular chromatin is present (&lt;&lt;36219&gt;&gt;). Immunoblastoid cytomorphology may be observed, in which the cells resemble immunoblasts with slightly eccentric nuclei and prominent nucleoli (&lt;&lt;36222&gt;&gt;). CD123 is diffusely positive in the tumour cells (&lt;&lt;36223&gt;&gt;).",
    "source": "Alejandro Gru",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/63/88/36217.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/63/88/thumb_36217.jpg"
  },

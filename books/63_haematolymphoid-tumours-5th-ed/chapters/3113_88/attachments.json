  {
    "pkattachmentId": 60225,
    "bookid": 63,
    "chapterId": 88,
    "fileId": 36911,
    "type": "Figure",
    "diagnosis": "Blastic plasmacytoid dendritic cell neoplasm",
    "title": "",
    "legend": "Immunophenotype of a representative case of blastic plasmacytoid dendritic cell neoplasm. Neoplastic plasmacytoid dendritic cells (pDCs) are featured by bright CD123 and HLA-DR expression. CD4 and CD56 are usually positive. CD38 expression is often decreased in neoplastic pDCs {32241840}. CD303 is positive in this case but about half of blastic plasmacytoid dendritic cell neoplasm cases show negative CD303 {32241840}. Positive CD7 is seen in &gt;&nbsp;50% of cases. Of note, the expression of CD56 does not define the neoplastic nature of pDCs, because a small subset of normal/reactive pDCs are positive for CD56 {32241840}.",
    "source": "Wei Wang - credit (from Joe Khoury)",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/63/88/36911.jpg",

        "pkcontributionId": 119203,
        "bookId": 63,
        "chapterId": 82,
        "headingId": 701,
        "headingText": "\r\n\r\n<p>Acute leukaemia of ambiguous lineage (ALAL) NOS expresses combinations of immunophenotypic lineage markers that do not permit definitive lineage assignments.</p>\r\n\r\n",
        "timestamp": "2024-03-01T13:20:25"
      }

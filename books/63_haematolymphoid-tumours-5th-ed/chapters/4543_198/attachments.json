    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 70.35pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Risk model</span></strong></p>\r\n</td>\r\n<td style=\"width: 225.65pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"301\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Low</span></strong></p>\r\n</td>\r\n<td style=\"width: 161.4pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"215\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Standard</span></strong></p>\r\n</td>\r\n<td style=\"width: 251.3pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"335\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">High</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 70.35pt; padding: 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">ISS</span></strong></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\"><span lang=\"EN-GB\">{15809451}</span></span></p>\r\n</td>\r\n<td style=\"width: 225.65pt; padding: 0cm 5.4pt;\" width=\"301\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"PT\">I: Serum B2M &lt;&nbsp;3.5&nbsp;mg/L, serum albumin &ge;&nbsp;3.5&nbsp;g/dL</span></p>\r\n</td>\r\n<td style=\"width: 161.4pt; padding: 0cm 5.4pt;\" width=\"215\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">II: Not stage&nbsp;I or&nbsp;III</span></p>\r\n</td>\r\n<td style=\"width: 251.3pt; padding: 0cm 5.4pt;\" width=\"335\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"PT\">III: Serum B2M &ge;&nbsp;5.5&nbsp;mg/L</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 70.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">IMWG</span></strong></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\"><span lang=\"EN-GB\">{23974982}</span></span></p>\r\n</td>\r\n<td style=\"width: 225.65pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"301\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">ISS&nbsp;I/II, age &lt;&nbsp;55&nbsp;years, and absence of all of t(4;14), del(17p13), and 1q21+</span></p>\r\n</td>\r\n<td style=\"width: 161.4pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"215\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Not low or high risk</span></p>\r\n</td>\r\n<td style=\"width: 251.3pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"335\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">ISS&nbsp;II/III and t(4;14) or del(17p13)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 70.35pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">R-ISS</span></strong></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\"><span lang=\"EN-GB\">{26240224}</span></span></p>\r\n</td>\r\n<td style=\"width: 225.65pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"301\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">I: ISS&nbsp;I and absence of all of del(17p13), t(4;14), and t(14;16)</span></p>\r\n</td>\r\n<td style=\"width: 161.4pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"215\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">II: Not R-ISS&nbsp;I or&nbsp;III</span></p>\r\n</td>\r\n<td style=\"width: 251.3pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"335\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">III: ISS&nbsp;III with either high serum LDH or presence of any of del(17p13), t(4;14), or t(14;16)</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">IMWG, International Myeloma Working Group; ISS, International Staging System; R-ISS, Revised International Staging System.</span></p>",

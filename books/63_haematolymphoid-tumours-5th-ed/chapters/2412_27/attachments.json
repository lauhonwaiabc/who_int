    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 767.297px; border-collapse: collapse;\" border=\"0\" width=\"99%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 89.25pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" rowspan=\"3\" width=\"119\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 617.9pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" colspan=\"4\" width=\"824\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">MN-pCT</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 284.7pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" colspan=\"2\" width=\"380\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">AML-pCT</span></strong></p>\r\n</td>\r\n<td style=\"width: 6cm; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" rowspan=\"2\" width=\"227\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">MDS-pCT</span></strong></p>\r\n</td>\r\n<td style=\"width: 163.1pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" rowspan=\"2\" width=\"217\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">Others</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 142.25pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">Type&nbsp;1</span></strong></p>\r\n</td>\r\n<td style=\"width: 142.45pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">Type&nbsp;2</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 89.25pt; padding: 0cm 5.4pt;\" width=\"119\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Frequency</span></strong></p>\r\n</td>\r\n<td style=\"width: 142.25pt; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">60&ndash;70%</span></p>\r\n</td>\r\n<td style=\"width: 142.45pt; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">20&ndash;30%</span></p>\r\n</td>\r\n<td style=\"width: 6cm; padding: 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Not applicable</span></p>\r\n</td>\r\n<td style=\"width: 163.1pt; padding: 0cm 5.4pt;\" width=\"217\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Not applicable</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 89.25pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"119\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Cytotoxic agents</span></strong></p>\r\n</td>\r\n<td style=\"width: 142.25pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Alkylating agents and/or ionizing radiation</span></p>\r\n</td>\r\n<td style=\"width: 142.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">DNA topoisomerase&nbsp;II inhibitors</span></p>\r\n</td>\r\n<td style=\"width: 6cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Alkylating agents and/or ionizing radiation</span></p>\r\n</td>\r\n<td style=\"width: 163.1pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"217\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Antimetabolites (azathioprine and fludarabine)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">PARP1 inhibitors</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 89.25pt; padding: 0cm 5.4pt;\" width=\"119\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Latency (after exposure)</span></strong></p>\r\n</td>\r\n<td style=\"width: 142.25pt; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">5&ndash;7&nbsp;years</span></p>\r\n</td>\r\n<td style=\"width: 142.45pt; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">1&ndash;3&nbsp;years</span></p>\r\n</td>\r\n<td style=\"width: 6cm; padding: 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Unknown</span></p>\r\n</td>\r\n<td style=\"width: 163.1pt; padding: 0cm 5.4pt;\" width=\"217\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Unknown</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 89.25pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"119\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Presentation and diagnosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 142.25pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">AML, with a pre-MDS phase</span></p>\r\n</td>\r\n<td style=\"width: 142.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Overt AML, no prior MDS phase</span></p>\r\n</td>\r\n<td style=\"width: 6cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">MDS, mostly high risk and very high risk according to IPSS-R</span></p>\r\n</td>\r\n<td style=\"width: 163.1pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"217\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Variable</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 89.25pt; padding: 0cm 5.4pt;\" width=\"119\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Typical genetic alterations<sup>a</sup></span></strong></p>\r\n</td>\r\n<td style=\"width: 142.25pt; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Unbalanced, often complex karyotypes</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Loss of 5q, 7q, 17p</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Loss of 3p, 11q, 12p, 13q, 18q, 21q</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Trisomy&nbsp;8 and&nbsp;11</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Frequently <em>TP53</em> deletions + <em>TP53</em> mutations</span></p>\r\n</td>\r\n<td style=\"width: 142.45pt; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"FR\">Balanced translocations</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><em><span lang=\"FR\">KMT2A</span></em><span lang=\"FR\"> fusions</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"FR\">t(15;17)(q24;q21)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"FR\">inv(16)(p13q22)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"FR\">t(8;21)(q22;q22)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">t(3;21)(q26;q22)</span></p>\r\n</td>\r\n<td style=\"width: 6cm; padding: 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">&gt;&nbsp;70% aberrant karyotype</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Typically unbalanced chromosome aberrations</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Loss of 5q, 7q, 17p</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Loss of 12p, 13q, 18q, 20q</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Gains of 1q, 21q</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Frequently <em>TP53</em> deletions + <em>TP53</em> mutations</span></p>\r\n</td>\r\n<td style=\"width: 163.1pt; padding: 0cm 5.4pt;\" width=\"217\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Variable</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 89.25pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"119\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Outcome</span></strong></p>\r\n</td>\r\n<td style=\"width: 142.25pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Unfavourable</span></p>\r\n</td>\r\n<td style=\"width: 142.45pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"190\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Favourable; outcomes comparable to de&nbsp;novo AML (if appropriate treatment can be given) </span><span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\"><span lang=\"EN-GB\">{24319183; 28322237; 32249963}</span></span></p>\r\n</td>\r\n<td style=\"width: 6cm; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"227\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Poor prognosis; low- to intermediate-risk IPSS-R<sup>b</sup> subgroups show inferior outcomes compared with de&nbsp;novo MDS</span></p>\r\n</td>\r\n<td style=\"width: 163.1pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"217\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Variable</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">AML, acute myeloid leukaemia; IPSS-R, Revised International Prognostic Scoring System; MDS, myelodysplastic neoplasm; pCT, post cytotoxic therapy.</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><sup><span lang=\"EN-GB\">a</span></sup><span lang=\"EN-GB\">The</span><span lang=\"EN-GB\"> typical genetic alterations of MN-pCT include mutations in <em>TP53</em> and <em>PPM1D</em>. The biology of cases with de&nbsp;novo&ndash;type genetic alterations (e.g. core-binding factor [CBF] gene rearrangements and <em>NPM1</em> mutations) may be different, although the prognosis is still worse than for de&nbsp;novo cases. Hence, these cases should still be categorized under MN-pCT. <sup>b</sup>IPSS-R applicable to MDS-pCT to predict transformation to AML and overall survival.</span></p>",

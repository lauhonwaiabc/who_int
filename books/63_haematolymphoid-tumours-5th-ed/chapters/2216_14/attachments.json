  {
    "pkattachmentId": 60611,
    "bookid": 63,
    "chapterId": 14,
    "fileId": 32271,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diagnostic criteria for post&ndash;essential thrombocythaemia myelofibrosis (post-ET MF)</p>",
    "legend": "",
    "source": "&nbsp;{17728787}",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 707.1pt; background: #daeef3; border-collapse: collapse;\" border=\"0\" width=\"943\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 10.2pt;\" width=\"943\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Required criteria:</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Documentation of a previous diagnosis of WHO-defined essential thrombocythaemia</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Bone marrow fibrosis of grade&nbsp;2&ndash;3 on a scale of&nbsp;0&ndash;3</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 10.2pt;\" width=\"943\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Additional criteria:</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Anaemia (below the reference range, given age, sex, and altitude considerations) and a &gt;&nbsp;2&nbsp;g/dL decrease from baseline haemoglobin concentration</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Leukoerythroblastosis</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Increasing splenomegaly, defined as either an increase in palpable splenomegaly of &gt;&nbsp;50&nbsp;mm from baseline (distance from the left costal margin, or on imaging) or the development of newly palpable splenomegaly</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Elevated LDH level (above the reference range)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Development of any two (or all three) of the following constitutional symptoms: &gt;&nbsp;10% weight loss in 6&nbsp;months, night sweats, unexplained fever (&gt;&nbsp;37.5 &deg;C)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">The diagnosis of post-ET MF requires either both of the required criteria or at least two additional criteria.</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },
  {
    "pkattachmentId": 60634,
    "bookid": 63,
    "chapterId": 14,
    "fileId": 33624,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diagnostic criteria for essential thrombocythaemia</p>",
    "legend": "",
    "source": "Prepared by the sectoin authors",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 707.1pt; background: #daeef3; border-collapse: collapse;\" border=\"0\" width=\"943\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 10.2pt;\" width=\"943\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Major criteria:</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Platelet count &ge;&nbsp;450&nbsp;&times;&nbsp;10<sup>9</sup>/L</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Bone marrow biopsy showing proliferation mainly of the megakaryocytic lineage, with increased numbers of enlarged, mature megakaryocytes with hyperlobulated nuclei; no significant increase or left shift in neutrophil granulopoiesis or erythropoiesis; very rarely a minor (grade&nbsp;1) increase in reticulin fibres</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">WHO criteria for <em>BCR</em>::<em>ABL1</em>-positive chronic myeloid leukaemia, polycythaemia vera, primary myelofibrosis, and other myeloid neoplasms are not met</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><em><span lang=\"EN-GB\">JAK2</span></em><span lang=\"EN-GB\">, <em>CALR</em>, or <em>MPL</em> mutation</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 10.2pt;\" width=\"943\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Minor criteria:</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Presence of a clonal marker</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm 3pt 28.4pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">OR</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 28.05pt; text-indent: -11.9pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Exclusion of reactive thrombocytosis</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 707.1pt; padding: 0cm 5.4pt; height: 17.2pt;\" width=\"943\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">The diagnosis of essential thrombocythaemia requires either all the major criteria or the first three major criteria plus a minor criterion to be met.</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

  },
  {
    "pkheadingid": 778,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 715,
    "contributions": [
      {
        "pkcontributionId": 121590,
        "bookId": 63,
        "chapterId": 369,
        "headingId": 715,
        "headingText": "\r\n\r\n<p>Splenectomy or partial splenectomy is usually performed for diagnosis and/or symptomatic relief. No recurrence or metastasis has been reported {22858789; 30626827}.</p>",
        "timestamp": "2024-02-28T17:00:14"
      }
    ],

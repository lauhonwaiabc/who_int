  {
    "pkheadingid": 779,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 716,
    "contributions": [
      {
        "pkcontributionId": 121588,
        "bookId": 63,
        "chapterId": 369,
        "headingId": 716,
        "headingText": "\r\n\r\n<p><em>Essential:</em> a circumscribed lesion in the spleen; multiple angiomatoid nodules comprising three types of blood vessels, with interspersed fibrosclerotic stroma.</p>\r\n\r\n",
        "timestamp": "2024-02-28T17:00:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

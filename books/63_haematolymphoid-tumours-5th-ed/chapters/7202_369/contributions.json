[
  {
    "pkheadingid": 764,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 701,
    "contributions": [
      {
        "pkcontributionId": 121574,
        "bookId": 63,
        "chapterId": 369,
        "headingId": 701,
        "headingText": "\r\n\r\n<p>Sclerosing angiomatoid nodular transformation (SANT) is a benign circumscribed lesion of the spleen composed of multiple angiomatoid nodules with intervening fibrosclerotic stroma.</p>\r\n\r\n",
        "timestamp": "2024-02-28T17:00:14"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

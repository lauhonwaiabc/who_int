        "chapterId": 267,
        "headingId": 713,
        "headingText": "\r\n\r\n<p>Not relevant</p>\r\n\r\n",
        "timestamp": "2024-02-28T16:55:39"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 779,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 716,
    "contributions": [
      {
        "pkcontributionId": 121520,
        "bookId": 63,
        "chapterId": 267,
        "headingId": 716,
        "headingText": "\r\n\r\n<p><em>Essential:</em> spindle to ovoid cells in whorls, fascicles, or sheets; interspersed small lymphocytes; positive immunostaining for one or more of the markers cytokeratin, actin, and desmin, with delicate cell processes being highlighted; negative staining for markers of follicular dendritic cells (CD21, CD23, CD35, CXCL13) and interdigitating dendritic cells (S100).</p>\r\n\r\n",
        "timestamp": "2024-02-28T16:55:39"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 777,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 714,
    "contributions": [
      {
        "pkcontributionId": 121521,
        "bookId": 63,
        "chapterId": 267,
        "headingId": 714,
        "headingText": "\r\n\r\n<p>Not applicable</p>\r\n\r\n",
        "timestamp": "2024-02-28T16:55:39"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 778,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 715,
    "contributions": [
      {
        "pkcontributionId": 121522,
        "bookId": 63,
        "chapterId": 267,
        "headingId": 715,
        "headingText": "\r\n\r\n<p>Most patients present with localized disease, which is associated with better survival than advanced disease {23755890}. Among 21&nbsp;reported patients with follow-up, 6&nbsp;have died from disseminated disease {32979929}.</p>",
        "timestamp": "2024-02-28T16:55:39"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
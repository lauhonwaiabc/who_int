      {
        "pkcontributionId": 118796,
        "bookId": 63,
        "chapterId": 52,
        "headingId": 705,
        "headingText": "\r\n\r\n<p>None</p>\r\n\r\n",
        "timestamp": "2024-03-01T12:42:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 769,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 706,
    "contributions": [
      {
        "pkcontributionId": 118797,
        "bookId": 63,
        "chapterId": 52,
        "headingId": 706,
        "headingText": "\r\n\r\n<p>The blood and bone marrow are always involved.</p>\r\n\r\n",
        "timestamp": "2024-03-01T12:42:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 770,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 707,
    "contributions": [
      {
        "pkcontributionId": 118798,
        "bookId": 63,
        "chapterId": 52,
        "headingId": 707,
        "headingText": "\r\n\r\n<p>Patients generally present with weakness, easy fatigability, and other symptoms related to complications of bone marrow failure, such as anaemia, thrombocytopenia, and neutropenia. There may be leukocytosis with markedly increased blasts.</p>\r\n\r\n",
        "timestamp": "2024-03-01T12:42:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 771,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 708,
    "contributions": [
      {
        "pkcontributionId": 118799,
        "bookId": 63,
        "chapterId": 52,
        "headingId": 708,
        "headingText": "\r\n\r\n<p>There are limited data using the current definition criteria.</p>\r\n\r\n",
        "timestamp": "2024-03-01T12:42:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 772,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Etiology",

        "bookId": 63,
        "chapterId": 52,
        "headingId": 704,
        "headingText": "\r\n\r\n<p><em>Not recommended:</em> acute myeloid leukaemia, M1.</p>\r\n\r\n",
        "timestamp": "2024-03-01T12:42:19"
      }
    ],
    "booknotes": [],

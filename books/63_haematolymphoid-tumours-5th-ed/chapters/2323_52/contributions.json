[
  {
    "pkheadingid": 764,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 701,
    "contributions": [
      {
        "pkcontributionId": 118792,
        "bookId": 63,
        "chapterId": 52,
        "headingId": 701,
        "headingText": "\r\n\r\n<p>Acute myeloid leukaemia (AML) without maturation is an AML with myeloid differentiation and maturation arrest that lacks defining genetic abnormalities.</p>\r\n\r\n",
        "timestamp": "2024-03-01T12:42:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

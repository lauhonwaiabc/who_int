[
  {
    "pkheadingid": 764,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 701,
    "contributions": [
      {
        "pkcontributionId": 118843,
        "bookId": 63,
        "chapterId": 55,
        "headingId": 701,
        "headingText": "\r\n\r\n<p>Acute myelomonocytic leukaemia is an acute myeloid leukaemia (AML) with evidence of granulocytic and monocytic maturation that lacks defining genetic abnormalities.</p>\r\n\r\n",
        "timestamp": "2024-03-01T12:46:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 765,
    "bookid": 63,

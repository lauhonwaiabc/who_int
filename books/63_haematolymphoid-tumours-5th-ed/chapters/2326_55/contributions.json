        "timestamp": "2024-03-01T12:46:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 766,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,

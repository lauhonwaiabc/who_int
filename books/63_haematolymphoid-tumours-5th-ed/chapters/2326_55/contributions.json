        "bookId": 63,
        "chapterId": 55,
        "headingId": 704,
        "headingText": "\r\n\r\n<p><em>Not recommended:</em> acute myeloid leukaemia, M4.</p>\r\n\r\n",
        "timestamp": "2024-03-01T12:46:19"
      }
    ],
    "booknotes": [],

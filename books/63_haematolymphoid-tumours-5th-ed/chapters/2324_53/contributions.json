      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 778,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 715,
    "contributions": [
      {
        "pkcontributionId": 118825,
        "bookId": 63,
        "chapterId": 53,
        "headingId": 715,
        "headingText": "\r\n\r\n<p>There are limited data specifically on prognosis and prediction in patients classified as having AML with maturation using the current definition criteria.</p>",
        "timestamp": "2024-03-01T12:43:37"
      }
    ],

[
  {
    "pkheadingid": 764,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 701,
    "contributions": [
      {
        "pkcontributionId": 118809,
        "bookId": 63,
        "chapterId": 53,
        "headingId": 701,
        "headingText": "\r\n\r\n<p>Acute myeloid leukaemia (AML) with maturation is an AML with morphological features of granulocytic maturation that lacks defining genetic abnormalities.</p>\r\n\r\n",
        "timestamp": "2024-03-01T12:43:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

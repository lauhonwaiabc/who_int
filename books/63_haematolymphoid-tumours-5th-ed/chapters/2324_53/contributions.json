        "bookId": 63,
        "chapterId": 53,
        "headingId": 704,
        "headingText": "\r\n\r\n<p><em>Not recommended:</em> acute myeloid leukaemia, M2.</p>\r\n\r\n",
        "timestamp": "2024-03-01T12:43:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 768,
    "bookid": 63,

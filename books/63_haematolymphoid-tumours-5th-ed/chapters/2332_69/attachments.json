    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 25cm; border-collapse: collapse;\" border=\"0\" width=\"945\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Markers</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Target population</span></strong></p>\r\n</td>\r\n<td style=\"width: 12cm; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Remarks</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD34</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Blasts</span></p>\r\n</td>\r\n<td style=\"width: 12cm; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive in &lt;&nbsp;50% of cases of myeloid sarcoma; typically negative in monocytic-lineage and more mature granulocytic cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">KIT (CD117)</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Broad expression, including immature myeloid precursors</span></p>\r\n</td>\r\n<td style=\"width: 12cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive in most myeloid sarcomas, but not specific</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Myeloperoxidase</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Granulocytes (lineage-specific marker)</span></p>\r\n</td>\r\n<td style=\"width: 12cm; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive in most myeloid sarcomas</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD45</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Any haematolymphoid cells</span></p>\r\n</td>\r\n<td style=\"width: 12cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Variably positive and often dimmer expression in blasts relative to mature elements</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD43</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Myeloid, T&nbsp;cells, and various other haematolymphoid populations</span></p>\r\n</td>\r\n<td style=\"width: 12cm; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Variably positive; sensitive but not a specific marker for myeloid sarcoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD3, CD5, CD7</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">T&nbsp;cells</span></p>\r\n</td>\r\n<td style=\"width: 12cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Usually negative, but may occasionally be aberrantly expressed in myeloid neoplasms or in T/myeloid mixed-phenotype acute leukaemia</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD4</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">T&nbsp;helper lymphocytes and monocytes</span></p>\r\n</td>\r\n<td style=\"width: 12cm; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">May be aberrantly expressed in myeloid neoplasms, particularly those with monocytic differentiation</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD13, CD33</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Broad myeloid expression</span></p>\r\n</td>\r\n<td style=\"width: 12cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Variably positive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD11c, CD14, CD64, CD68, CD163, lysozyme</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Monocytes</span></p>\r\n</td>\r\n<td style=\"width: 12cm; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Variably positive, CD68 (KP1) more sensitive than CD68 (PGM1) for monocytic differentiation</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">CD14, CD68 (PGM1), and CD163 often negative in monoblasts</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD15</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Broad myeloid expression</span></p>\r\n</td>\r\n<td style=\"width: 12cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive in monocytes and maturing granulocytes</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD19, CD20, CD22, CD79a</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">B&nbsp;cells</span></p>\r\n</td>\r\n<td style=\"width: 12cm; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Usually negative, but may (rarely) be aberrantly expressed in myeloid neoplasms (especially CD19 in t(8;21)/<em>RUNX1</em>::<em>RUNX1T1</em> AML) or in B/myeloid mixed-phenotype acute leukaemia</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD56</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Aberrant monocytes</span></p>\r\n</td>\r\n<td style=\"width: 12cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive in BPDCN and some cases of AML (particularly those with monocytic differentiation)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD61</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Megakaryocytes</span></p>\r\n</td>\r\n<td style=\"width: 12cm; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Variably positive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD71, glycophorin&nbsp;A</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Erythroid cells</span></p>\r\n</td>\r\n<td style=\"width: 12cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Variably positive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD123, TCF4</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Broad expression, including plasmacytoid dendritic cells and immature myeloid precursors</span></p>\r\n</td>\r\n<td style=\"width: 12cm; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">CD123-positive cases must be distinguished from BPDCN; TCL1 is positive in BPDCN and largely negative in AML; CD123 and TCF4 are uniformly positive in BPDCN and negative in other myeloid processes</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">NPM1</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Aberrant cytoplasmic staining in <em>NPM1</em>-mutated myeloid cells</span></p>\r\n</td>\r\n<td style=\"width: 12cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive in ~20&ndash;30% of cases of myeloid sarcoma, particularly those with monocytic differentiation</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">p53</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Not lineage-specific</span></p>\r\n</td>\r\n<td style=\"width: 12cm; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">If positive in myeloid cells, indicative of neoplastic process rather than reactive extramedullary haematopoiesis</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 166.35pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"222\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">IDH1 p.R132H</span></strong></p>\r\n</td>\r\n<td style=\"width: 202.2pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"270\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Aberrant staining in <em>IDH1</em> p.R132H&ndash;mutated myeloid cells</span></p>\r\n</td>\r\n<td style=\"width: 12cm; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"454\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive in only a small subset of cases of myeloid sarcoma</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">AML, acute myeloid leukaemia; BPDCN, blastic plasmacytoid dendritic cell neoplasm.</span></p>",

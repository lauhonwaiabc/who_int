    "title": "<p>Characteristics of acute myeloid leukaemia (AML) with other defined genetic alterations</p>",
    "legend": "",
    "source": "Wenbin Xiao",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 122.703px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Genetic alteration</span></strong></p>\r\n</td>\r\n<td style=\"width: 96.5938px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Chromosomal alteration</span></strong></p>\r\n</td>\r\n<td style=\"width: 75.2188px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Percentage of newly diagnosed AML cases</span></strong></p>\r\n</td>\r\n<td style=\"width: 132.422px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Salient pathological features</span></strong></p>\r\n</td>\r\n<td style=\"width: 129.812px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Immunophenotype</span></strong></p>\r\n</td>\r\n<td style=\"width: 80.9062px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Common genetic associations</span></strong></p>\r\n</td>\r\n<td style=\"width: 66.2344px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"13%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Salient clinical features</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 122.703px; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><a name=\"_Hlk152243769\"></a><strong><em><span lang=\"EN-GB\">CBFA2T3</span></em><span lang=\"EN-GB\">::</span><em><span lang=\"EN-GB\">GLIS2</span></em></strong></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\"><span lang=\"EN-GB\">{31294507; 23045605; 23153540; 28112737; 27133823; 30592296}</span></span></p>\r\n</td>\r\n<td style=\"width: 96.5938px; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">inv(16)(p13q24)</span></p>\r\n</td>\r\n<td style=\"width: 75.2188px; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">3% in children, mostly infants</span></p>\r\n</td>\r\n<td style=\"width: 132.422px; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Usually megakaryoblastic</span></p>\r\n</td>\r\n<td style=\"width: 129.812px; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&gt;&nbsp;50% show the RAM phenotype</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Strong CD56 expression, lack of HLA-DR, and underexpression of CD45 and CD38</span></p>\r\n</td>\r\n<td style=\"width: 80.9062px; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">None</span></p>\r\n</td>\r\n<td style=\"width: 66.2344px; padding: 0cm 5.4pt;\" width=\"13%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Poor prognosis</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 122.703px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><em><span lang=\"EN-GB\">KAT6A</span></em><span lang=\"EN-GB\">::<em>CREBBP</em></span></strong></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\"><span lang=\"EN-GB\">{23974201}</span></span></p>\r\n</td>\r\n<td style=\"width: 96.5938px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">t(8;16)(p11.2;p13.3)</span></p>\r\n</td>\r\n<td style=\"width: 75.2188px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">0.5% in children, peak in neonates, 0.2% in adults</span></p>\r\n</td>\r\n<td style=\"width: 132.422px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Myelomonocytic or monocytic</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Erythrophagocytosis</span></p>\r\n</td>\r\n<td style=\"width: 129.812px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive: HLA-DR, CD15, myeloperoxidase, CD13, CD33, sometimes CD56, CD14</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Negative: CD34, KIT (CD117)</span></p>\r\n</td>\r\n<td style=\"width: 80.9062px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">ASXL1</span></em><span lang=\"EN-GB\">, <em>FLT3</em>, <em>TP53</em>, <em>RUNX1</em>, <em>TET2</em>, complex karyotype</span></p>\r\n</td>\r\n<td style=\"width: 66.2344px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"13%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Similar to paediatric AML in general</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 122.703px; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><em><span lang=\"EN-GB\">FUS</span></em><span lang=\"EN-GB\">::<em>ERG</em></span></strong></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\"><span lang=\"EN-GB\">{24068373; 30150206}</span></span></p>\r\n</td>\r\n<td style=\"width: 96.5938px; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">t(16;21)(p11.2;q22)</span></p>\r\n</td>\r\n<td style=\"width: 75.2188px; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Very rare</span></p>\r\n</td>\r\n<td style=\"width: 132.422px; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Any, except erythroid differentiation</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Auer rods</span></p>\r\n</td>\r\n<td style=\"width: 129.812px; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Unknown</span></p>\r\n</td>\r\n<td style=\"width: 80.9062px; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">+8, +10, complex karyotype</span></p>\r\n</td>\r\n<td style=\"width: 66.2344px; padding: 0cm 5.4pt;\" width=\"13%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Poor prognosis</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 122.703px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><em><span lang=\"EN-GB\">MNX1</span></em><span lang=\"EN-GB\">::<em>ETV6</em></span></strong></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\"><span lang=\"EN-GB\">{29569294; 29227476}</span></span></p>\r\n</td>\r\n<td style=\"width: 96.5938px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">t(7;12)(q36;p13)</span></p>\r\n</td>\r\n<td style=\"width: 75.2188px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&lt;&nbsp;1% in children, almost only infants</span></p>\r\n</td>\r\n<td style=\"width: 132.422px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Usually minimal differentiation or without maturation</span></p>\r\n</td>\r\n<td style=\"width: 129.812px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Positive: CD34, HLA-DR, often KIT (CD117), T-cell markers CD7 and CD4</span></p>\r\n</td>\r\n<td style=\"width: 80.9062px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Often +19, sometimes +8</span></p>\r\n</td>\r\n<td style=\"width: 66.2344px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"13%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Poor prognosis, but may be protocol-dependent</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 122.703px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><em><span lang=\"EN-GB\">NPM1</span></em><span lang=\"EN-GB\">::<em>MLF1</em></span></strong></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\"><span lang=\"EN-GB\">{20471513; 14506644}</span></span></p>\r\n</td>\r\n<td style=\"width: 96.5938px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">t(3;5)(q25;q35)</span></p>\r\n</td>\r\n<td style=\"width: 75.2188px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Very rare</span></p>\r\n</td>\r\n<td style=\"width: 132.422px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"16%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Any</span></p>\r\n</td>\r\n<td style=\"width: 129.812px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"15%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Unknown</span></p>\r\n</td>\r\n<td style=\"width: 80.9062px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"11%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">+8, complex karyotype</span></p>\r\n</td>\r\n<td style=\"width: 66.2344px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; padding: 0cm 5.4pt;\" width=\"13%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Poor prognosis</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">AMKL, acute megakaryoblastic leukaemia.</span></p>",

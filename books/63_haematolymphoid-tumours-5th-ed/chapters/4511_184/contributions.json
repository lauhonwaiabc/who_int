[
  {
    "pkheadingid": 764,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 701,
    "contributions": [
      {
        "pkcontributionId": 120612,
        "bookId": 63,
        "chapterId": 184,
        "headingId": 701,
        "headingText": "\r\n\r\n<p>IgM monoclonal gammopathy of undetermined significance (MGUS) is defined by the presence of a serum monoclonal (M)&nbsp;protein of &lt;&nbsp;3&nbsp;g/dL, &lt;&nbsp;10% bone marrow lymphoplasmacytic infiltration (clonal B&nbsp;cells and plasma cells together), and no evidence of anaemia, constitutional symptoms, hyperviscosity, lymphadenopathy, or hepatosplenomegaly that can be attributed to the underlying lymphoproliferative disorder.</p>\r\n\r\n",
        "timestamp": "2024-03-12T11:56:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 765,
    "bookid": 63,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 702,
    "contributions": [
      {
        "pkcontributionId": 120613,
        "bookId": 63,
        "chapterId": 184,
        "headingId": 702,
        "headingText": "\r\n\r\n<p>9761/1 IgM monoclonal gammopathy of undetermined significance</p>\r\n\r\n",
        "timestamp": "2024-03-12T11:56:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 766,

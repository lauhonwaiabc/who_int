  {
    "pkattachmentId": 60518,
    "bookid": 63,
    "chapterId": 220,
    "fileId": 29994,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diagnostic features of aggressive epidermotropic CD8+ cutaneous T-cell lymphoma</p>",
    "legend": "",
    "source": "Rein Willemze",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 784px; border-collapse: collapse;\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 247px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Clinical features</span></strong></p>\r\n</td>\r\n<td style=\"width: 247px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Histological features</span></strong></p>\r\n</td>\r\n<td style=\"width: 246.875px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid black; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Immunophenotype</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 247px; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Generalized ulcerated papules, nodules, plaques, and/or tumours</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">+/&minus; Mucosal involvement</span></p>\r\n</td>\r\n<td style=\"width: 247px; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Pagetoid reticulosis pattern; epidermotropism and necrotic keratinocytes; cytological atypia</span></p>\r\n</td>\r\n<td style=\"width: 246.875px; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&beta;F1+, TCR&gamma;&delta;&minus;, TCR&delta;&minus;, CD8+ or CD8&minus;/CD4&minus;, TIA1+, granzyme&nbsp;B+, perforin+, CCR4+, CD2&minus; and/or CD5&minus;, CD45RA+, pSTAT3+, pSTAT5+, Ki-67+</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 247px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Solitary tumorous lesions</span></p>\r\n</td>\r\n<td style=\"width: 247px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Diffuse or nodular dermal infiltrates</span></p>\r\n</td>\r\n<td style=\"width: 246.875px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid black; background: #daeef3; padding: 0cm 5.4pt;\" width=\"33%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">As above</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },
  {

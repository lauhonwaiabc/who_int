    "title": "<p>Cytopathological features of neuroendocrine tumours (NETs)</p>",
    "legend": "",
    "source": "Claire W. Michael",
    "copyright": "",
    "tablehtml": "<table class=\"MsoTableGrid\" style=\"width: 697.5pt; border-collapse: collapse; border: none; \" border=\"0\" width=\"930\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 169.75pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"226\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 131.6pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">NET&nbsp;/ typical carcinoid</span></strong></p>\r\n</td>\r\n<td style=\"width: 132.45pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">NET&nbsp;/ atypical carcinoid</span></strong></p>\r\n</td>\r\n<td style=\"width: 132.45pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">LCNEC</span></strong></p>\r\n</td>\r\n<td style=\"width: 131.25pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">SCNEC</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 169.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"226\">\r\n<p class=\"TableText\"><strong><span style=\" \">Pattern at low magnification</span></strong></p>\r\n</td>\r\n<td style=\"width: 264.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"352\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" \">Trabeculae; branching fibrovascular strands with attached tumour sheets, cords, and loosely cohesive sheets; and plentiful dispersed single cells and stripped nuclei</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" \">Irregular tissue fragments and sheets, with some dispersed cells in a necrotic background</span></p>\r\n</td>\r\n<td style=\"width: 131.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" \">Irregular tissue fragments and sheets, with chromatinic smearing and apoptotic debris</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 169.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"226\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">Necrosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 131.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Absent</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Rare single cell</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Extensive</span></p>\r\n</td>\r\n<td style=\"width: 131.25pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Extensive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 169.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"226\">\r\n<p class=\"TableText\"><strong><span style=\" \">Complex branching fibrovascular strands</span></strong></p>\r\n</td>\r\n<td style=\"width: 131.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" \">Present in ~50%</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" \">Present in ~50%</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" \">May be present</span></p>\r\n</td>\r\n<td style=\"width: 131.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" \">Absent</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 169.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"226\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">Cellular features</span></strong></p>\r\n</td>\r\n<td style=\"width: 131.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">&nbsp;</td>\r\n<td style=\"width: 132.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">&nbsp;</td>\r\n<td style=\"width: 132.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">&nbsp;</td>\r\n<td style=\"width: 131.25pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">&nbsp;</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 28.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"37\">\r\n<p class=\"TableText\"><strong><span style=\" \">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 141.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong><span style=\" \">Disorganization</span></strong></p>\r\n</td>\r\n<td style=\"width: 131.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" \">Absent</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" \">May be focal</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" \">Present</span></p>\r\n</td>\r\n<td style=\"width: 131.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" \">Present</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 28.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"37\">\r\n<p class=\"TableText\"><strong><span style=\" \">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 141.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">Pleomorphism</span></strong></p>\r\n</td>\r\n<td style=\"width: 131.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Minimal</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Mild and focal</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Marked</span></p>\r\n</td>\r\n<td style=\"width: 131.25pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Moderate</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 28.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"37\">\r\n<p class=\"TableText\"><strong><span style=\" \">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 141.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong><span style=\" \">Size</span></strong></p>\r\n</td>\r\n<td style=\"width: 131.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" \">Small to medium</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" \">Small to medium</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" \">Large, at least focally</span></p>\r\n</td>\r\n<td style=\"width: 131.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" \">Intermediate</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 28.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"37\">\r\n<p class=\"TableText\"><strong><span style=\" \">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 141.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">Plasmacytoid cells</span></strong></p>\r\n</td>\r\n<td style=\"width: 131.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Present</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Present</span></p>\r\n</td>\r\n<td style=\"width: 132.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"177\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Absent</span></p>\r\n</td>\r\n<td style=\"width: 131.25pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Absent</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 28.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"37\">\r\n<p class=\"TableText\"><strong><span style=\" \">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 141.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong><span style=\" \">Spindle cells</span></strong></p>\r\n</td>\r\n<td style=\"width: 131.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"175\">\r\n<p class=\"TableText\"><span style=\" \">Present, may dominate</span></p>\r\n</td>\r\
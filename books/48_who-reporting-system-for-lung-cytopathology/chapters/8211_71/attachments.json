    "type": "Table",
    "diagnosis": "",
    "title": "<p>Differential diagnosis of spindle cell carcinoid</p>",
    "legend": "",
    "source": "Claire W. Michael",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 697.4pt; border-collapse: collapse;\" border=\"0\" width=\"930\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 137.0pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"183\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Differential diagnosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 290.65pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"388\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Cytopathological features</span></strong></p>\r\n</td>\r\n<td style=\"width: 269.75pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"360\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Immunostains</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 137.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"183\">\r\n<p class=\"TableText\"><strong>Spindle cell carcinoid</strong></p>\r\n</td>\r\n<td style=\"width: 290.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"388\">\r\n<p class=\"TableText\">Loosely cohesive or single spindle cells with slender, elongated cytoplasm</p>\r\n<p class=\"TableText\">Haphazardly arranged cells</p>\r\n<p class=\"TableText\">Frequently curved or form arches</p>\r\n<p class=\"TableText\">Plexiform vessels present in 50% of cases</p>\r\n<p class=\"TableText\">No cytopathological atypia, mitoses, or necrosis in typical carcinoid</p>\r\n<p class=\"TableText\">Mild atypia, focal necrosis, or mitoses in atypical carcinoid</p>\r\n</td>\r\n<td style=\"width: 269.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"360\">\r\n<p class=\"TableText\">Positive for NE markers (CD56, chromogranin, synaptophysin, and INSM1)</p>\r\n<p class=\"TableText\">Positive for pancytokeratin</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 137.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"183\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Bronchial cells</span></strong></p>\r\n</td>\r\n<td style=\"width: 290.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"388\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Ciliated columnar cells</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Mostly single cells</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Lack of cellular curves and arches</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Nucleus slightly smaller</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Plexiform vessels absent</span></p>\r\n</td>\r\n<td style=\"width: 269.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"360\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Negative for NE markers</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 137.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"183\">\r\n<p class=\"TableText\"><strong>Melanoma</strong></p>\r\n</td>\r\n<td style=\"width: 290.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"388\">\r\n<p class=\"TableText\">Loosely cohesive or single cells</p>\r\n<p class=\"TableText\">Larger nuclei with more atypia</p>\r\n<p class=\"TableText\">Lack of cellular curves and arches</p>\r\n<p class=\"TableText\">Plexiform vessels absent</p>\r\n</td>\r\n<td style=\"width: 269.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"360\">\r\n<p class=\"TableText\">Negative for NE markers and cytokeratins</p>\r\n<p class=\"TableText\">Positive for S100, HMB45, melan-A (MART1), and SOX10</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 137.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"183\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Solitary fibrous tumour</span></strong></p>\r\n</td>\r\n<td style=\"width: 290.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"388\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Poorly cellular smears</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Thick fragments of spindle cells</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Occasional collagen fragments</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Plexiform vessels absent</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Primarily pleural-based</span></p>\r\n</td>\r\n<td style=\"width: 269.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"360\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Negative for NE markers</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Positive for STAT6, BCL2, CD34, CD99, EMA, and actin</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 137.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"183\">\r\n<p class=\"TableText\"><strong>Metastatic sarcomas</strong></p>\r\n</td>\r\n<td style=\"width: 290.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"388\">\r\n<p class=\"TableText\">Aggregates of spindle cells with various atypia</p>\r\n<p class=\"TableText\">Plexiform vessels absent</p>\r\n</td>\r\n<td style=\"width: 269.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"360\">\r\n<p class=\"TableText\">Negative for NE markers</p>\r\n<p class=\"TableText\">Positive for vimentin and other stains, depending on original sarcoma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 137.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"183\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Sarcomatoid carcinoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 290.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"388\">\r\n<p class=\"TableText\"><span style=\"color: black;\">More prominent atypia, mitoses, and necrosis</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Plexiform vessels absent</span></p>\r\n</td>\r\n<td style=\"width: 269.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"360\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Negative for NE markers</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Positive for cytokeratins; TTF1 or p40 may be positive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 137.0pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"183\">\r\n<p class=\"TableText\"><strong>Sarcomatoid mesothelioma</strong></p>\r\n</td>\r\n<td style=\"width: 290.65pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"388\">\r\n<p class=\"TableText\">Less cellular smears with few cohesive groups of atypical spindle cells</p>\r\n<p class=\"TableText\">Collagenous stroma +/&minus;</p>\r\n<p class=\"TableText\">Primarily pleural-based</p>\r\n</td>\r\n<td style=\"width: 269.75pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"360\">\r\n<p class=\"TableText\">Negative for NE markers</p>\r\n<p class=\"TableText\">Positive for cytokeratins and mesothelial markers</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">NE, neuroendocrine; TTF1, thyroid transcription factor&nbsp;1.</p>",
    "imageUrl": null,
    "thumbnail": null
  }

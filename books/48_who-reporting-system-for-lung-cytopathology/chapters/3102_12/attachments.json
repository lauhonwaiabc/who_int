    "title": "<p>Indications, advantages, and limitations of bronchial wash and bronchial brush</p>",
    "legend": "",
    "source": "Ralf Heine",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 697.4pt; border-collapse: collapse; \" border=\"0\" width=\"930\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 13.7pt;\">\r\n<td style=\"width: 106.0pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.7pt;\" width=\"141\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Type of examination</span></strong></p>\r\n</td>\r\n<td style=\"width: 197.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.7pt;\" width=\"263\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Indications</span></strong></p>\r\n</td>\r\n<td style=\"width: 189.25pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.7pt;\" width=\"252\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Advantages </span></strong></p>\r\n</td>\r\n<td style=\"width: 205.0pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.7pt;\" width=\"273\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Limitations </span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 71.2pt;\">\r\n<td style=\"width: 106.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 71.2pt;\" width=\"141\">\r\n<p class=\"TableText\"><strong>Bronchial wash</strong></p>\r\n</td>\r\n<td style=\"width: 197.15pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 71.2pt;\" width=\"263\">\r\n<p class=\"TableText\">Visible central lesions in combination with FNAB or forceps biopsy</p>\r\n<p class=\"TableText\">Bronchial infections</p>\r\n</td>\r\n<td style=\"width: 189.25pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 71.2pt;\" width=\"252\">\r\n<p class=\"TableText\">Easy and inexpensive</p>\r\n<p class=\"TableText\">No risk for the patient</p>\r\n</td>\r\n<td style=\"width: 205.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 71.2pt;\" width=\"273\">\r\n<p class=\"TableText\">Low sensitivity (47.6%) and specificity (71.4%) <span class=\"Ref-PMID\">{22627632}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 55.95pt;\">\r\n<td style=\"width: 106.0pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 55.95pt;\" width=\"141\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Bronchial brush</span></strong></p>\r\n</td>\r\n<td style=\"width: 197.15pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 55.95pt;\" width=\"263\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Peripheral tumours and peripheral infiltrates, visible on X-ray or CT</span></p>\r\n<p class=\"TableText\"><span style=\"color: black; \">Central lesions in combination with FNAB and forceps biopsy</span></p>\r\n</td>\r\n<td style=\"width: 189.25pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 55.95pt;\" width=\"252\">\r\n<p class=\"TableText\"><span style=\"color: black; \">High diagnostic yield </span><span class=\"Ref-PMID\">{29228529}</span></p>\r\n<p class=\"TableText\"><span style=\"color: black; \">Low rate of complications</span></p>\r\n<p class=\"TableText\"><span style=\"color: black; \">Avoidance of more-invasive diagnostic procedures </span></p>\r\n</td>\r\n<td style=\"width: 205.0pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 55.95pt;\" width=\"273\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Need for fluoroscopy and examination table suitable for fluoroscopy in the endoscopy suite</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

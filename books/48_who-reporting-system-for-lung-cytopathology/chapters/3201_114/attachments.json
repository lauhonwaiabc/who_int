  {
    "pkattachmentId": 46146,
    "bookid": 48,
    "chapterId": 114,
    "fileId": 22886,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Different cytology preparations</p>",
    "legend": "",
    "source": "Claire W. Michael",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 697.35pt; border-collapse: collapse;\" border=\"0\" width=\"930\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 5.0cm; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Direct smears</span></strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Cytospin</span></strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Liquid-based preparation</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 5.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong>Ease of technique</strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Easiest, minimal labour</p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Easy, requires some labour</p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Automated, requires some training</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 5.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Cost</span></strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Minimal expense</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Some expense</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Greater expense</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 5.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong>Air-dried slides</strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Yes</p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Yes</p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">No</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 5.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Fixed slides</span></strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Yes</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Yes</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Yes</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 5.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong>Fixative used</strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Any fixative</p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Any fixative</p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Methanol (Hologic)</p>\r\n<p class=\"TableText\">Ethanol (SurePath)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 5.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"189\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Need for pretreatment</span></strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Haemolytic and mucolytic agents recommended</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Haemolytic or mucolytic agents recommended</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Not required</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Peroxidase block for inflammatory smears</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Peroxidase block for inflammatory smears</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Not required</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 5.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong>Reagents</strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Large amount to cover slide</p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Minimal amount</p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Intermediate amount</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 5.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Disposables</span></strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">None</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Minimal</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">More</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 5.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong>Background staining</strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Can be high</p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Can be high</p>\r\n</td>\r\n<td style=\"width: 185.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Clean</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 5.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Stain interpretation</span></strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Easier for nuclear than cytoplasmic stains</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Easier for nuclear than cytoplasmic stains</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Difficulty with 3D tissue fragments</span></p>\r\n</td>\r\n<td style=\"width: 185.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Reduced or false negative results reported for nuclear stains</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 5.0cm; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong>Storage</strong></p>\r\n</td>\r\n<td style=\"width: 185.2pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Prior coverslipping and fixation required to preserve antigenicity</p>\r\n</td>\r\n<td style=\"width: 185.2pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Prior coverslipping and fixation required to preserve antigenicity</p>\r\n</td>\r\n<td style=\"width: 185.2pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"247\">\r\n<p class=\"TableText\">Best to store as cell suspension</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },
  {
    "pkattachmentId": 46156,
    "bookid": 48,
    "chapterId": 114,
    "fileId": 23711,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Contributions of immunostains in the workup of lung cytopathology</p>",
    "legend": "",
    "source": "Lukas Bubendorf",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"background: #DAEEF3; border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 545.75pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"728\">\r\n<p class=\"TableText\" style=\"margin-left: 23.1pt; text-indent: -23.1pt; \"><span style=\" \"><span style=\"\">1.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; \">Identifying cell lineage (e.g. epithelial, mesenchymal, or haematopoietic)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 545.75pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"728\">\r\n<p class=\"TableText\" style=\"margin-left: 23.1pt; text-indent: -23.1pt; \"><span style=\"\"><span style=\"\">2.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; \">Confirming cell origin (i.e. lung primary vs metastasis)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 545.75pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"728\">\r\n<p class=\"TableText\" style=\"margin-left: 23.1pt; text-indent: -23.1pt; \"><span style=\"\"><span style=\"\">3.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; \">Identifying cell type (e.g. adenocarcinoma, squamous carcinoma, etc.)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 545.75pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"728\">\r\n<p class=\"TableText\" style=\"margin-left: 23.1pt; text-indent: -23.1pt; \"><span style=\"\"><span style=\"\">4.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; \">Identifying infectious organisms (e.g. fungus, virus, etc.)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 545.75pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"728\">\r\n<p class=\"TableText\" style=\"margin-left: 23.1pt; text-indent: -23.1pt; \"><span style=\"\"><span style=\"\">5.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; \">Tumour grading (e.g. using Ki-67 to separate low-grade and high-grade neuroendocrine tumours [NETs])</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 545.75pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"728\">\r\n<p class=\"TableText\" style=\"margin-left: 23.1pt; text-indent: -23.1pt; \"><span style=\"\"><span style=\"\">6.<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; \">Serving as prognostic and predictive biomarkers for targeted therapy</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

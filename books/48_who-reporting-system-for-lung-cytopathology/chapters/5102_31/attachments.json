  {
    "pkattachmentId": 46170,
    "bookid": 48,
    "chapterId": 31,
    "fileId": 32160,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diseases with histiocytic, lymphocytic, and eosinophilic patterns: clinical presentation and imaging {27134484; 9869825; 22550210; 26876879}</p>",
    "legend": "",
    "source": "Marianne Engels",
    "copyright": "",
    "tablehtml": "<table class=\"MsoTableGrid\" style=\"width: 701.7pt; border-collapse: collapse; border: none;\" border=\"0\" width=\"936\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 205.55pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Specific disease</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Clinical presentation</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.1pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Imaging (high-resolution CT)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Silicosis</strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Cough and dyspnoea with gradual onset; exposure history</p>\r\n</td>\r\n<td style=\"width: 248.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Dense, well-circumscribed nodules</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Organizing pneumonia</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Cough, dyspnoea</span></p>\r\n</td>\r\n<td style=\"width: 248.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Ground-glass opacities, consolidation, reticulation, parenchymal distortion</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Atypical mycobacterial infection</strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Cough, sputum, haemoptysis, fatigue, malaise and weight loss</p>\r\n</td>\r\n<td style=\"width: 248.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Bronchiectasis, small and large nodules, consolidation, centrilobular nodules, and cavitary lesions</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Lipoid pneumonia</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Cough, dyspnoea, haemoptysis; history of use of mineral, vegetable, or animal oil</span></p>\r\n</td>\r\n<td style=\"width: 248.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Extensive ground-glass opacities or consolidation</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>EVALI</strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Shortness of breath, cough, haemoptysis; use of e-cigarettes or vaping products</p>\r\n</td>\r\n<td style=\"width: 248.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Bilateral, diffuse, ground-glass infiltrates</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Amiodarone-induced lung toxicity</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Variable insidious or acute presentation; various inflammatory reactions including eosinophilic pneumonia, chronic obstructive pulmonary disease, NSIP-like ARDS; history of medication with amiodarone (antiarrhythmic drug)</span></p>\r\n</td>\r\n<td style=\"width: 248.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">New chest infiltrates</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Pulmonary alveolar proteinosis</strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Dyspnoea with subacute onset</p>\r\n</td>\r\n<td style=\"width: 248.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Alveolar-filling pattern</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Diffuse alveolar haemorrhage</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Acute dyspnoea, hypoxaemia; history of collagen vascular disease, especially systemic lupus erythematosus</span></p>\r\n</td>\r\n<td style=\"width: 248.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Patchy or diffuse areas of ground-glass attenuation</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Lymphocytic interstitial pneumonia</strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Cough, fever, dyspnoea; often associated with underlying immunological disease</p>\r\n</td>\r\n<td style=\"width: 248.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Bilateral ground-glass attenuation, scattered cysts</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Hypersensitivity pneumonitis</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Acute or chronic presentation; exposure history to specific compounds</span></p>\r\n</td>\r\n<td style=\"width: 248.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Acute: bilateral ground-glass opacities and poorly defined nodules</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Chronic: reticular fibrotic pattern, honeycomb change, traction bronchiectasis, ground-glass opacities</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Sarcoidosis</strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Bilateral hilar lymphadenopathy; uveitis or erythema nodosum often present</p>\r\n</td>\r\n<td style=\"width: 248.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Hilar/mediastinal lymphadenopathy, nodules along bronchovascular bundles</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><a name=\"_Hlk118975368\"></a><strong><span style=\"color: black;\">Beh&ccedil;et </span><span style=\"color: black;\">disease</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Haemoptysis, history of uveitis, ulcers in mouth and genitals</span></p>\r\n</td>\r\n<td style=\"width: 248.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Poorly defined areas of increased opacity, thrombosis of pulmonary vessels, focal atelectasis</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Malignant lymphoma, low-grade</strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Cough, dyspnoea</p>\r\n</td>\r\n<td style=\"width: 248.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Lymphadenopathy, ground-glass opacities</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Eosinophilic pneumonia</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Cough, fever, dyspnoea; acute or chronic presentation; rapid response to corticosteroids</span></p>\r\n</td>\r\n<td style=\"width: 248.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Bilateral peripheral subpleural airspace consolidation</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Bronchial asthma</strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Periodic wheezing and dyspnoea</p>\r\n</td>\r\n<td style=\"width: 248.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">No specific changes</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Allergic bronchopulmonary aspergillosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Episodic asthmatic attacks, expectoration of mucus plugs</span></p>\r\n</td>\r\n<td style=\"width: 248.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Transient infiltrates</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Eosinophilic granulomatosis with polyangiitis (Churg&ndash;Strauss disease)</strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Asthma, rash, peripheral neuropathy</p>\r\n</td>\r\n<td style=\"width: 248.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\">Bilateral areas of ground-glass opacity, or consolidation with a bilateral symmetrical distribution</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 205.55pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Parasitic and fungal infections</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Fever, cough, dyspnoea</span></p>\r\n</td>\r\n<td style=\"width: 248.1pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Variable, depending on infectious agent and immune status of host</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">ARDS, acute respiratory distress syndrome; EVALI, e-cigarette or vaping product use&ndash;associated lung injury; NSIP, nonspecific interstitial pneumonia.</p>",

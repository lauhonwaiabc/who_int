    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 658.8pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"878\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 88.15pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"118\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Method</span></strong></p>\r\n</td>\r\n<td style=\"width: 87.25pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"116\">\r\n<p class=\"TableText\" style=\"text-align: center; page-break-after: avoid;\" align=\"center\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Clonal amplification</span></strong></p>\r\n</td>\r\n<td style=\"width: 77.85pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"104\">\r\n<p class=\"TableText\" style=\"text-align: center; page-break-after: avoid;\" align=\"center\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Detection</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.1pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"text-align: center; page-break-after: avoid;\" align=\"center\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Read length</span></strong></p>\r\n</td>\r\n<td style=\"width: 167.2pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"223\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Pros</span></strong></p>\r\n</td>\r\n<td style=\"width: 167.25pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"223\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Cons</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 88.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"118\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\">Reversible terminator chemistry&nbsp;&ndash; sequencing by synthesis (capture hybridization&ndash;based)</strong></p>\r\n</td>\r\n<td style=\"width: 87.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"116\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Flow cell</p>\r\n</td>\r\n<td style=\"width: 77.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"104\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Optical&nbsp;&ndash; fluorescent</p>\r\n</td>\r\n<td style=\"width: 71.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">100&ndash;300&nbsp;bp</p>\r\n</td>\r\n<td style=\"width: 167.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"223\">\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span>Better performance in homopolymer regions</p>\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span>More tolerant to highly fragmented DNA</p>\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span>Higher sensitivity</p>\r\n</td>\r\n<td style=\"width: 167.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"223\">\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span>Higher input requirement (100&ndash;250&nbsp;ng)</p>\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span>Errors in GC-rich regions</p>\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span>Higher number of substitution errors</p>\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span>Lower sequencing quality towards the end of the reads</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 88.15pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"118\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Semiconductor sequencing (amplicon-based)</span></strong></p>\r\n</td>\r\n<td style=\"width: 87.25pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"116\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">Bead surface&nbsp;&ndash; emulsion</span></p>\r\n</td>\r\n<td style=\"width: 77.85pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"104\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">Non-optical&nbsp;&ndash; ion&nbsp;(pH)</span></p>\r\n</td>\r\n<td style=\"width: 71.1pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">100&ndash;400&nbsp;bp</span></p>\r\n</td>\r\n<td style=\"width: 167.2pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"223\">\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; mso-color-alt: windowtext;\">Low input requirement (10&ndash;20&nbsp;ng)</span></p>\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; mso-color-alt: windowtext;\">Fewer substitution errors</span></p>\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; mso-color-alt: windowtext;\">Low instrument and operational costs</span></p>\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; mso-color-alt: windowtext;\">Short instrument execution time</span></p>\r\n</td>\r\n<td style=\"width: 167.25pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"223\">\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; mso-color-alt: windowtext;\">Homopolymer errors</span></p>\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; mso-color-alt: windowtext;\">Truncation errors</span></p>\r\n<p class=\"TableBullet\" style=\"mso-list: l0 level1 lfo1; tab-stops: 36.0pt;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><span style=\"color: black; mso-color-alt: windowtext;\">Less tolerant of samples with low tumour content (&lt;&nbsp;20%)</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

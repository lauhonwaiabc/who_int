    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 338.6pt; border-collapse: collapse;\" border=\"0\" width=\"451\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 267.1pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Marker</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center; break-after: avoid;\" align=\"center\"><strong><span lang=\"EN-GB\">Frequency</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD30</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">100%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD2</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~55%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD3</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~33%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD4</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~80%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD5</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~25%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD7</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~10%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD8</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~10%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD15</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~40%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD43</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~80%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">CD45</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~67%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">EMA</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~67%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Cytotoxic markers (perforin, TIA1, granzyme&nbsp;B)</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~70%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">T-cell receptors (alpha/beta, gamma/delta)</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">~10%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">ALK</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">0%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 267.1pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"356\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">EBV-encoded small RNA (EBER)</span></strong></p>\r\n</td>\r\n<td style=\"width: 71.5pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"95\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">0%</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

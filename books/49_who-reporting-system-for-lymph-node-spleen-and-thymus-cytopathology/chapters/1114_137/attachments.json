    "bookid": 49,
    "chapterId": 137,
    "fileId": 34422,
    "type": "Figure",
    "diagnosis": "Smears of small round cell tumours",
    "title": "",
    "legend": "Ewing sarcoma showing high N:C&nbsp;ratio, minimal cytoplasm with fine glycogen vacuoles, irregular nuclei with few nucleoli, and frequent stripped nuclei (Giemsa).",
    "source": "Helena Barroca",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/49/137/34422.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/49/137/thumb_34422.jpg"

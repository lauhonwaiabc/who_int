    "bookid": 49,
    "chapterId": 137,
    "fileId": 34421,
    "type": "Figure",
    "diagnosis": "Smears of small round cell tumours",
    "title": "",
    "legend": "Burkitt lymphoma showing monotonous intermediate to occasionally large lymphoid cells with limited concentric basophilic cytoplasm containing occasional punctate lipid vacuoles and mildly pleomorphic nuclei (Giemsa).",
    "source": "Helena Barroca",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/49/137/34421.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/49/137/thumb_34421.jpg"
  },
  {

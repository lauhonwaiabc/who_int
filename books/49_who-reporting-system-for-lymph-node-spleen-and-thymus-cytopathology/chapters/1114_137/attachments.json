    "source": "Helena Barroca",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 658.8pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"878\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 91.5pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"122\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Category</span></strong></p>\r\n</td>\r\n<td style=\"width: 567.3pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; mso-background-themecolor: text2; mso-background-themetint: 102; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"756\">\r\n<p class=\"TableText\" style=\"page-break-after: avoid;\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Specific causes</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 91.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"122\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\">Viruses</strong></p>\r\n</td>\r\n<td style=\"width: 567.3pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"756\">\r\n<p class=\"TableText\">Rhinovirus, parainfluenza viruses, influenza viruses, respiratory syncytial virus, common coronaviruses, adenoviruses, CMV, EBV, HIV</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 91.5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"122\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Bacteria</span></strong></p>\r\n</td>\r\n<td style=\"width: 567.3pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"756\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">Staphylococcus aureus</span></em><span style=\"color: black; mso-color-alt: windowtext;\">, <em>Streptococcus pyogenes</em>, <em>Bartonella henselae</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 91.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"122\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\">Mycobacteria</strong></p>\r\n</td>\r\n<td style=\"width: 567.3pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"756\">\r\n<p class=\"TableText\"><em>Mycobacterium tuberculosis</em>, <em>M.&nbsp;avium</em> complex</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 91.5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"122\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Parasites</span></strong></p>\r\n</td>\r\n<td style=\"width: 567.3pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"756\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">Toxoplasma gondii</span></em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 91.5pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"122\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\">Non-infectious</strong></p>\r\n</td>\r\n<td style=\"width: 567.3pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"756\">\r\n<p class=\"TableText\">Kawasaki disease, Rosai&ndash;Dorfman disease, sarcoidosis</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 430.1pt; background: #daeef3; border-collapse: collapse;\" border=\"0\" width=\"573\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 430.1pt; padding: 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"573\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Lymphomas also occurring in immunocompetent patients</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 21.05pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"28\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 409.05pt; padding: 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"545\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Diffuse large B-cell lymphoma: immunoblastic or centroblastic</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 21.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"28\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 409.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"545\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Burkitt lymphoma: classic or with plasmacytoid differentiation</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 21.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"28\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 409.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"545\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Classic Hodgkin lymphoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 21.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"28\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 409.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"545\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Extranodal marginal zone B-cell lymphoma (MALT lymphoma)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 21.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"28\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 409.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"545\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Peripheral T/NK-cell lymphoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 430.1pt; padding: 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"573\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Lymphomas occurring more specifically in HIV+ patients</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 21.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"28\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 409.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"545\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Primary effusion lymphoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 21.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"28\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 409.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"545\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">HHV8+ extracavitary lymphoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 21.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"28\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;</span></p>\r\n</td>\r\n<td style=\"width: 409.05pt; padding: 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"545\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Lymphoma in HHV8-associated multicentric Castleman disease</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 21.
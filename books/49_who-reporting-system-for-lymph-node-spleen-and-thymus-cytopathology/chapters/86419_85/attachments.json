    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 658.8pt; border-collapse: collapse;\" border=\"0\" width=\"878\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 80.15pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"107\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 192.85pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Endemic</span></strong></p>\r\n</td>\r\n<td style=\"width: 192.9pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Sporadic</span></strong></p>\r\n</td>\r\n<td style=\"width: 192.9pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Immunodeficiency-associated</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 80.15pt; padding: 0cm 5.4pt;\" width=\"107\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Geographical location</span></strong></p>\r\n</td>\r\n<td style=\"width: 192.85pt; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Equatorial Africa, Papua New Guinea</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Worldwide</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Worldwide</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 80.15pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"107\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Incidence</span></strong></p>\r\n</td>\r\n<td style=\"width: 192.85pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">30&ndash;60&nbsp;cases per 1&nbsp;million person-years</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">1&ndash;3&nbsp;cases per 1&nbsp;million person-years</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">200&ndash;300&nbsp;cases per 1&nbsp;million person-years</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 80.15pt; padding: 0cm 5.4pt;\" width=\"107\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Median age</span></strong></p>\r\n</td>\r\n<td style=\"width: 192.85pt; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">4&ndash;7&nbsp;years</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">25&ndash;35&nbsp;years</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">40&ndash;50&nbsp;years</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 80.15pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"107\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">M:F&nbsp;ratio</span></strong></p>\r\n</td>\r\n<td style=\"width: 192.85pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">2&ndash;3:1</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">3&ndash;4:1</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">5:1</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 80.15pt; padding: 0cm 5.4pt;\" width=\"107\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">EBV frequency</span></strong></p>\r\n</td>\r\n<td style=\"width: 192.85pt; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">95%</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">20&ndash;30%</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">25&ndash;40%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 80.15pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"107\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Other associated infections</span></strong></p>\r\n</td>\r\n<td style=\"width: 192.85pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">Plasmodium falciparum</span></em><span lang=\"EN-GB\"> (malaria)</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">&nbsp;Not applicable</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">HIV</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 80.15pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"107\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Presentation</span></strong></p>\r\n</td>\r\n<td style=\"width: 192.85pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Jaw bones, gastrointestinal tract, other viscera</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Gastrointestinal tract, bone marrow, other viscera</span></p>\r\n</td>\r\n<td style=\"width: 192.9pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Gastrointestinal tract, bone marrow, lymph nodes</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

    "title": "<p>Diagnostic features of lymph node ultrasound (these features serve as a guide, but exceptions often occur)</p>",
    "legend": "",
    "source": "All authors",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 658.8pt; border-collapse: collapse;\" border=\"0\" width=\"878\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 125.9pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"168\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Criteria</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.2pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Normal</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.25pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Inflammation/infection</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.2pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Metastases</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.25pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Lymphoma</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 125.9pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"168\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Size</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.2pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Variable (usually&nbsp;&lt;&nbsp;10&nbsp;mm)</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Variable</span></p>\r\n</td>\r\n<td style=\"width: 133.2pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Large</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Large</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 125.9pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"168\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Shape</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Oval</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Oval/round</span></p>\r\n</td>\r\n<td style=\"width: 133.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Round/oval</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Round/oval</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 125.9pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"168\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Border</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.2pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Regular</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Regular/sharp</span></p>\r\n</td>\r\n<td style=\"width: 133.2pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Irregular, blurred, capsule infiltration</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Regular/sharp</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 125.9pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"168\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Bulky masses</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">No</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">No</span></p>\r\n</td>\r\n<td style=\"width: 133.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">May be present</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Present</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 125.9pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"168\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Architecture and soft tissue oedema</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.2pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Preserved architecture, homogeneous, cortex thickness variable, hyperechoic hilum; oedema absent</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Preserved, homogeneous; thin or variably thickened cortex; oedema may be present</span></p>\r\n</td>\r\n<td style=\"width: 133.2pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Subverted, eccentric hypoechoic cortical infiltration and thickening; inhomogeneous structure, echogenic hilum absent; oedema absent</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Focal or global hypoechoic cortical thickening, echogenic hilum usually absent; &ldquo;pseudocystic&rdquo; appearance; perinodal oedema may be present</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 125.9pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"168\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Structural changes: focal cortical nodules, necrosis (coagulative, cystic, or liquefaction necrosis), reticulation, calcification, matting</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Absent</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Generally absent (necrosis, calcification, and matting may occur in bacterial, fungal, or tuberculosis lymphadenopathy)</span></p>\r\n</td>\r\n<td style=\"width: 133.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">May be present</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">May be present</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 125.9pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"168\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Echogenicity/​echotexture</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.2pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Normal</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Hypoechoic, heterogeneous</span></p>\r\n</td>\r\n<td style=\"width: 133.2pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Hypoechoic, variable</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Hypoechoic, homogeneous</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 125.9pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"168\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Colour Doppler ultrasound</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Normal vessel density; normal hilar vessels with or without tree-like branching;</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Low density without neoangiogenesis; normal vascular pattern; hilar vessels with or without tree-like branching;</span></p>\r\n</td>\r\n<td style=\"width: 133.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">High-density, non-homogeneous vessels; peripheral, mixed vascular pattern; immature, split, and tortuous arteries; non-vascular areas;</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">High density; high vascular pattern, often without preserved hilar and peripheral vessel architecture;</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 125.9pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"168\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 133.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">RI&nbsp;&lt;&nbsp;0.75</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">PI&nbsp;&lt;&nbsp;0.75</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">RI&nbsp;&lt;&nbsp;0.80</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">PI&nbsp;&lt; 1.60</span></p>\r\n</td>\r\n<td style=\"width: 133.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">RI&nbsp;&gt;&nbsp;0.80</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">PI&nbsp;&gt;&nbsp;1.60</span></p>\r\n</td>\r\n<td style=\"width: 133.25pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"178\">\r\n<p class=\"TableText\" style=\"margin: 3p
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 658.8pt; border-collapse: collapse;\" border=\"0\" width=\"878\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 168.45pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"225\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Mastocytosis subtype</span></strong></p>\r\n</td>\r\n<td style=\"width: 281.25pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"375\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Diagnostic criteria</span></strong></p>\r\n</td>\r\n<td style=\"width: 209.1pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" width=\"279\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Diagnostic criteria for subtypes of SM</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 168.45pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"225\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Cutaneous mastocytosis (CM)</span></strong></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Urticaria pigmentosa</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Diffuse cutaneous mastocytosis</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Mastocytoma</span></p>\r\n</td>\r\n<td style=\"width: 281.25pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"375\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Multifocal or diffuse pattern of infiltration on skin biopsy</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Major and minor criteria for SM absent</span></p>\r\n</td>\r\n<td style=\"width: 209.1pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"279\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Not applicable</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 168.45pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"225\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Systemic mastocytosis (SM)</span></strong></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Indolent SM (ISM)</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Smouldering SM (SSM)</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">SM with an associated haematological neoplasm (SM-AHN)</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Aggressive SM (ASM)</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Mast cell leukaemia (MCL)</span></p>\r\n</td>\r\n<td style=\"width: 281.25pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"375\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><em><span lang=\"EN-GB\">Major criteria:</span></em></strong></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Multifocal dense infiltrates of MCs in BM and/or extracutaneous organs (&ge;&nbsp;15&nbsp;MCs per aggregate)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><em><span lang=\"EN-GB\">Minor criteria:</span></em></strong></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 15.55pt; text-indent: -14.2pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">1.<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Biopsy of BM or extracutaneous organs: &gt;&nbsp;25% of MCs in the infiltrate are spindle-shaped/atypical morphology or &gt;&nbsp;25% of MCs are immature or atypical in BM aspirate smears</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 15.55pt; text-indent: -14.2pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">2.<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><em><span lang=\"EN-GB\">KIT</span></em><span lang=\"EN-GB\"> point mutation at codon 816a</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 15.55pt; text-indent: -14.2pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">3.<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">MCs express CD25 and/or CD2</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 15.55pt; text-indent: -14.2pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">4.<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Serum total tryptase persistently &gt;&nbsp;20&nbsp;ng/mL, without associated myeloid neoplasm</span></p>\r\n</td>\r\n<td style=\"width: 209.1pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"279\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><em><span lang=\"EN-GB\">Negative for AHN:</span></em></strong></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></s
  {
    "pkattachmentId": 61010,
    "bookid": 49,
    "chapterId": 32,
    "fileId": 35460,
    "type": "Figure",
    "diagnosis": "Flow cytometry of follicular hyperplasia (FH)",
    "title": "",
    "legend": "<strong>A</strong>&nbsp;The FNAB contains a large lymphocyte population and few other cells. <strong>B</strong>&nbsp;The lymphocytes consist of CD3-positive T&nbsp;cells (red) and CD19-positive B&nbsp;cells (blue and purple). <strong>C</strong>&nbsp;The FH cells (purple) are brighter for CD20 than the other B&nbsp;cells (blue); CD19 intensity is similar in the two populations. <strong>D</strong>&nbsp;The FH cells are CD10-positive, whereas the other B&nbsp;cells are CD10-negative. <strong>E,F</strong>&nbsp;The FH cells express dim kappa or lambda light chains, or are light chain&ndash;negative, whereas the other B&nbsp;cells express moderately bright kappa or lambda light chains. There is no light chain restriction in either the FH cells or the other B&nbsp;cells, indicating that both populations are polyclonal.",
    "source": "William Arthur Sewell",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/49/32/35460.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/49/32/thumb_35460.jpg"
  },

    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 658.8pt; border-collapse: collapse;\" border=\"0\" width=\"878\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 103.5pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" valign=\"top\" width=\"138\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Disease</span></strong></p>\r\n</td>\r\n<td style=\"width: 138.8pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" valign=\"top\" width=\"185\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Clinical features</span></strong></p>\r\n</td>\r\n<td style=\"width: 138.85pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" valign=\"top\" width=\"185\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Histopathology</span></strong></p>\r\n</td>\r\n<td style=\"width: 138.8pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" valign=\"top\" width=\"185\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Cytopathology</span></strong></p>\r\n</td>\r\n<td style=\"width: 138.85pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" valign=\"top\" width=\"185\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Ancillary techniques</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 103.5pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"138\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Rosai&ndash;Dorfman disease</span></strong></p>\r\n</td>\r\n<td style=\"width: 138.8pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"185\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Rare</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Systemic symptoms/fevers</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Nodal and extranodal disease</span></p>\r\n</td>\r\n<td style=\"width: 138.85pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"185\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Architecture partially effaced</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Numerous large histiocytes lacking atypia and nuclear grooves, with emperipolesis</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Scant eosinophils</span></p>\r\n</td>\r\n<td style=\"width: 138.8pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"185\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Moderate/high cellularity</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Dispersed heterogeneous pattern</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Small lymphocytes and some medium lymphoid cells, plasma cells, and numerous large histiocytes with emperipolesis</span></p>\r\n</td>\r\n<td style=\"width: 138.85pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"185\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Microorganism stains: negative</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Immunocytochemistry: S100+, CD68+, CD1a&minus;, langerin&minus;, CD21&minus;, CD23&minus;, CK&minus;, HMB45&minus;, melan-A&minus;</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 103.5pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"138\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Dermatopathic lymphadenopathy</span></strong></p>\r\n</td>\r\n<td style=\"width: 138.8pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"185\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Common</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-
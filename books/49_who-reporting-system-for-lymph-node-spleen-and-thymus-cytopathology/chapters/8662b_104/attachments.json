t 0cm 5.4pt;\" width=\"111\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">CK7+/CK20+</span></strong></p>\r\n</td>\r\n<td style=\"width: 575.4pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"767\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Urinary bladder, upper gastrointestinal, pancreatobiliary, mucinous ovarian, occasional colorectal, occasional lung</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 83.4pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"111\">\r\n<p class=\"TableText\"><strong>CK7&minus;/CK20+</strong></p>\r\n</td>\r\n<td style=\"width: 575.4pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"767\">\r\n<p class=\"TableText\">Colorectal, Merkel cell, occasional upper gastrointestinal</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 83.4pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"111\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">CK7&minus;/CK20&minus;</span></strong></p>\r\n</td>\r\n<td style=\"width: 575.4pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"767\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Prostate, hepatocellular carcinoma, renal cell carcinoma, squamous cell carcinoma, well-differentiated neuroendocrine tumour, non-cutaneous neuroendocrine carcinoma, germ cell tumour</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

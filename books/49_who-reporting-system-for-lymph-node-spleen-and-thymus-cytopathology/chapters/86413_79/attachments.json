  {
    "pkattachmentId": 61009,
    "bookid": 49,
    "chapterId": 79,
    "fileId": 35353,
    "type": "Figure",
    "diagnosis": "Flow cytometry of T&nbsp;cells in thymoma",
    "title": "",
    "legend": "<strong>A</strong>&nbsp;The cells are low to moderate side scatter and CD45-positive. <strong>B</strong>&nbsp;The cells are intracellular (IC) CD3-positive, and they exhibit a spectrum of surface CD3 (sCD3) expression. They are divided into sCD3-negative (purple) and sCD3-positive (red). <strong>C</strong>&nbsp;The sCD3-negative cells are largely double positive for CD4 and CD8, whereas the sCD3-positive cells, while mostly double positive for CD4 and CD8, also include cells positive for only CD4 or only CD8. <strong>D</strong>&nbsp;The cells are positive for CD5 and CD7. <strong>E</strong>&nbsp;The cells are positive for CD2, and most are positive for the thymocyte marker CD1a. <strong>F</strong>&nbsp;A subset of cells are CD10-positive.",
    "source": "William Arthur Sewell",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/49/79/35353.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/49/79/thumb_35353.jpg"

  {
    "pkattachmentId": 61150,
    "bookid": 49,
    "chapterId": 74,
    "fileId": 34773,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Clinical and laboratory features of marginal zone lymphoma (MZL)</p>",
    "legend": "",
    "source": "Pamela Michelow",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" width=\"878\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 108.2pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" valign=\"top\" width=\"144\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 183.5pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Extranodal MZL</span></strong></p>\r\n</td>\r\n<td style=\"width: 183.55pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Splenic MZL</span></strong></p>\r\n</td>\r\n<td style=\"width: 183.55pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt; height: 3.5pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; break-after: avoid;\"><strong><span lang=\"EN-GB\">Nodal MZL</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 108.2pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"144\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Clinical presentation</span></strong></p>\r\n</td>\r\n<td style=\"width: 183.5pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Depends on site of disease, e.g. dyspepsia and epigastric pain in gastric extranodal MZL</span></p>\r\n</td>\r\n<td style=\"width: 183.55pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Anaemia, thrombocytopenia, splenomegaly</span></p>\r\n</td>\r\n<td style=\"width: 183.55pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Lymphadenopathy, especially of head and neck: non-bulky, disease often disseminated at presentation</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 108.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"144\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Associations</span></strong></p>\r\n</td>\r\n<td style=\"width: 183.5pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Infections (e.g. gastric <em>Helicobacter pylori</em>, ocular <em>Chlamydia psittaci</em> infection) or autoimmune disease (e.g. Sj&ouml;gren syndrome, Hashimoto thyroiditis)</span></p>\r\n</td>\r\n<td style=\"width: 183.55pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Hepatitis&nbsp;C virus infection, although most cases have unknown etiology</span></p>\r\n</td>\r\n<td style=\"width: 183.55pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Hepatitis&nbsp;C virus infection and autoimmune disease, although most cases have unknown etiology</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 108.2pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"144\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Histopathology</span></strong></p>\r\n</td>\r\n<td style=\"width: 183.5pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Neoplastic lymphocytes infiltrate adjacent B-cell follicles in a marginal zone distribution and then coalesce to replace most follicles; overlying epithelium may be involved</span></p>\r\n</td>\r\n<td style=\"width: 183.55pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Neoplastic infiltrate in which predominantly small to medium cells surround and efface splenic white pulp and coalesce with a peripheral zone of larger cells</span></p>\r\n</td>\r\n<td style=\"width: 183.55pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Neoplastic infiltrate, which can be diffuse, nodular, interfollicular, and perifollicular, that surrounds variably preserved germinal centres</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 108.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"144\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Cytopathology</span></strong></p>\r\n</td>\r\n<td style=\"width: 550.6pt; background: #daeef3; padding: 0cm 5.4pt;\" colspan=\"3\" valign=\"top\" width=\"734\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 24.3pt 3pt 40.85pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Moderately to highly cellular</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 24.3pt 3pt 40.85pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Mixed cellular population</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 24.3pt 3pt 40.85pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Small to intermediate-sized cells predominate; these cells have moderate amounts of pale cytoplasm, mild nuclear contour irregularities, and inconspicuous nucleoli</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 24.3pt 3pt 40.85pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Interspersed small lymphocytes, larger transformed cells, plasma and plasmacytoid cells, monocytoid cells, dendritic cells, multinucleated giant cells, lymphohistiocytic aggregates, eosinophils, and tingible-body macrophages</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 24.3pt 3pt 40.85pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Transformed cells resemble centroblasts and immunoblasts; nuclear enlargement 2&ndash;3&nbsp;times the size of a small lymphocyte, open chromatin and abundant cytoplasm</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 108.2pt; padding: 0cm 5.4pt;\" valign=\"top\" width=\"144\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Differential diagnosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 550.6pt; padding: 0cm 5.4pt;\" colspan=\"3\" valign=\"top\" width=\"734\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 24.3pt 3pt 40.85pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Reactive conditions such as reactive lymphoid hyperplasia in nodal MZL and gastritis, Hashimoto thyroiditis, Sj&ouml;gren syndrome, lymphocytic pneumonia, and others in extranodal MZL</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 24.3pt 3pt 40.85pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Low-grade lymphomas such as follicular, mantle, CLL/SLL, lymphoplasmacytic lymphoma</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 24.3pt 3pt 40.85pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">T-cell lymphoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 108.2pt; background: #daeef3; padding: 0cm 5.4pt;\" valign=\"top\" width=\"144\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Immunophenotype</span></strong></p>\r\n</td>\r\n<td style=\"width: 550.6pt; background: #daeef3; padding: 0cm 5.4pt;\" colspan=\"3\" valign=\"top\" width=\"734\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 24.3pt 3pt 40.85pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Positive for CD20, CD79a, PAX5, BCL2, IgM, occasionally other Ig classes</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 24.3pt 3pt 40.85pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Negative for CD5, CD10, CD23, cyclin&nbsp;D1, and SOX11</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 108.2pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" valign=\"top\" width=\"144\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Molecular studies</span></strong></p>\r\n</td>\r\n<td style=\"width: 183.5pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" valign=\"top\" width=\"245\">\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-va
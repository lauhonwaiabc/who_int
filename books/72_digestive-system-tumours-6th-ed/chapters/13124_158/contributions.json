  },
  {
    "pkheadingid": 1001,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 966,
    "contributions": [
      {
        "pkcontributionId": 149895,
        "bookId": 72,
        "chapterId": 158,
        "headingId": 966,
        "headingText": "\r\n\r\n<p><em>Essential:</em> mature uniform adipocytes without cytological atypia.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 999,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Staging",

        "headingId": 952,
        "headingText": "\r\n\r\n<p>88500/0 Lipoma, NOS</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 988,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 953,
    "contributions": [
      {
        "pkcontributionId": 149883,
        "bookId": 72,
        "chapterId": 158,
        "headingId": 953,
        "headingText": "\r\n\r\n<p>2E80.02 &amp; XA1B13 Deep internal or visceral lipoma of large intestine</p>\r\n<p>2E80.02 &amp; XA6452 Deep internal or visceral lipoma of small intestine</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 989,

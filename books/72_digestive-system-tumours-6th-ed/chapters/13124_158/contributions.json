[
  {
    "pkheadingid": 986,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 951,
    "contributions": [
      {
        "pkcontributionId": 149881,
        "bookId": 72,
        "chapterId": 158,
        "headingId": 951,
        "headingText": "\r\n\r\n<p>Lipoma is a benign tumour composed of mature adipocytes and may include other mesenchymal elements in subtypes.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

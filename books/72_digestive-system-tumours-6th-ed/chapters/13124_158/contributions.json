        "chapterId": 158,
        "headingId": 964,
        "headingText": "\r\n\r\n<p>Not applicable</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1000,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 965,
    "contributions": [
      {
        "pkcontributionId": 149897,
        "bookId": 72,
        "chapterId": 158,
        "headingId": 965,
        "headingText": "\r\n\r\n<p>Gastrointestinal lipomas are benign. Resection, either endoscopic or surgical, is reserved for symptomatic/complicated cases {22298986;25368224}.</p>\r\n<p>&nbsp;</p>",
        "timestamp": "2026-06-09T11:31:03"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

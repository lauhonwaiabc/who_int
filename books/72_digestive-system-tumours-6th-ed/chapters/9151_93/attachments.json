  {
    "pkattachmentId": 76237,
    "bookid": 72,
    "chapterId": 93,
    "fileId": 49618,
    "type": "Figure",
    "diagnosis": "Intermediate cell carcinoma",
    "title": "",
    "legend": "<strong>A</strong>&nbsp;Strands of monotonous tumour cells with scant cytoplasm showing intermediate morphological features between hepatocytes and cholangiocytes in an abundant fibrous stroma. <strong>B&ndash;D</strong>&nbsp;Immunohistochemistry demonstrates the biphenotypic nature of the tumour at the cellular level: the same cell expresses both hepatocytic markers, such as arginase-1 (ARG1)&nbsp;(<strong>B</strong>) and AFP&nbsp;(<strong>C</strong>), as well as cholangiocytic markers (CK19,&nbsp;<strong>D</strong>).",
    "source": "",

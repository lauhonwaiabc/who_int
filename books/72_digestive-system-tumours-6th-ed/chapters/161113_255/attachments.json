    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 574.1pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"765\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 95.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Affected gene(s)</span></strong></p>\r\n</td>\r\n<td style=\"width: 95.7pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Inherited syndrome</span></strong></p>\r\n</td>\r\n<td style=\"width: 95.7pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Prevalence in familial PDAC</span></strong></p>\r\n</td>\r\n<td style=\"width: 95.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Estimated lifetime risk of PDAC</span></strong></p>\r\n</td>\r\n<td style=\"width: 95.7pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Relative risk</span></strong></p>\r\n</td>\r\n<td style=\"width: 95.7pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Main extrapancreatic malignancies</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 95.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><strong><em>BRCA2</em></strong></p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Hereditary breast and ovarian cancer syndrome</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">6&ndash;12%</p>\r\n</td>\r\n<td style=\"width: 95.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">3&ndash;10%</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">3.5&ndash;10</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Breast, ovarian, prostate</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 95.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><strong><em><span style=\"color: black; mso-color-alt: windowtext;\">BRCA1</span></em><sup><span style=\"color: black; mso-color-alt: windowtext;\">a</span></sup></strong></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Hereditary breast and ovarian cancer syndrome</span></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">0.7&ndash;1.2%</span></p>\r\n</td>\r\n<td style=\"width: 95.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">~2&ndash;5%</span></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">Uncertain</span></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">Breast, ovarian</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 95.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><strong><em>PALB2</em></strong></p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Hereditary breast and ovarian cancer syndrome</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">2&ndash;3%</p>\r\n</td>\r\n<td style=\"width: 95.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">7.5%</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">15</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Breast, ovarian</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 95.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><strong><em><span style=\"color: black; mso-color-alt: windowtext;\">ATM</span></em></strong></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">None</span></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">2.6&ndash;3.2%</span></p>\r\n</td>\r\n<td style=\"width: 95.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">4%</span></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">9</span></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">None</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 95.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><strong>MMR genes</strong></p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Lynch syndrome</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0.7%</p>\r\n</td>\r\n<td style=\"width: 95.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">6% (<em>MSH2</em>)</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">5&ndash;9</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Colorectal, endometrial, etc.<sup>b</sup></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 95.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><strong><em><span style=\"color: black; mso-color-alt: windowtext;\">CDKN2A</span></em></strong></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Familial atypical multiple mole melanoma</span></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">0.7&ndash;2.5%</span></p>\r\n</td>\r\n<td style=\"width: 95.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">15&ndash;25%</span></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">13&ndash;22</span></p>\r\n</td>\r\n<td style=\"width: 95.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black; mso-color-alt: windowtext;\">Melanoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 95.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><strong><em>STK11</em></strong></p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\">Peutz&ndash;Jeghers syndrome</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&lt;&nbsp;1%</p>\r\n</td>\r\n<td style=\"width: 95.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">30&ndash;60%</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">132</p>\r\n</td>\r\n<td style=\"width: 95.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Many<sup>c</sup></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 95.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\"><strong><em><span style=\"color: black; mso-color-alt: windowtext;\">PRSS1</span></em></strong></p>\r\n</td>\r\n<td style=\"width: 9
 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Lower than for <em>PRSS1</em></p>\r\n</td>\r\n<td style=\"width: 95.65pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Lower than for <em>PRSS1</em></p>\r\n</td>\r\n<td style=\"width: 95.7pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Lower than for <em>PRSS1</em></p>\r\n</td>\r\n<td style=\"width: 95.7pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"128\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">None</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">MMR, mismatch repair; PDAC, pancreatic ductal adenocarcinoma.</p>\r\n<p class=\"TableText\"><sup>a</sup>The degree of raised risk of pancreatic cancer with <em>BRCA1</em> is uncertain. <sup>b</sup>See <span class=\"ID-Section\">&lt;&lt;16.1.1.1&gt;&gt;</span><em>Lynch syndrome (MLH1, PMS2, MSH2, MSH6)</em>. <sup>c</sup>See <span class=\"ID-Section\">&lt;&lt;16.1.1.9&gt;&gt;</span><em>Peutz&ndash;Jeghers syndrome (STK11)</em>.</p>\r\n<p class=\"TableText\">Note: Up-to-date estimates are available at https://plsd.eu/.</p>",

  {
    "pkattachmentId": 76314,
    "bookid": 72,
    "chapterId": 252,
    "fileId": 49771,
    "type": "Figure",
    "diagnosis": "Hamartomatous gastric polyp",
    "title": "",
    "legend": "<strong>A&ndash;C&nbsp;</strong>Polyps associated with <em>PTEN</em> hamartoma tumour syndrome (PHTS) are typically nonspecific, and early lesions may be challenging to distinguish from reactive changes. Fully developed polyps, as observed in these examples in the stomach, duodenum, and colon, often exhibit juvenile characteristics, including expanded stromal components and irregular, hyperplastic glands. In the stomach, these hamartomatous polyps cannot be reliably differentiated from hyperplastic polyps based on histological features alone.",
    "source": "Marnix Jansen",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/72/252/49771.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/72/252/thumb_49771.jpg"
  },

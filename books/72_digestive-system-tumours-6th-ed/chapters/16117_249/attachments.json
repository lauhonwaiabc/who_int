    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 446.55pt; background: #DAEEF3; mso-background-themecolor: accent5; mso-background-themetint: 51; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"595\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 120.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"161\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Criterion&nbsp;1:</span></strong></p>\r\n</td>\r\n<td style=\"width: 326.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" width=\"435\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210050250;\"><span style=\"color: black; mso-color-alt: windowtext;\">&ge;&nbsp;5&nbsp;serrated lesions/polyps proximal to the rectum, all being &ge;&nbsp;5&nbsp;mm in size, with &ge;&nbsp;2 being &ge;&nbsp;10&nbsp;mm in size</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 120.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"161\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210050250;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Criterion&nbsp;2:</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 326.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"435\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210050250;\"><span style=\"color: black; mso-color-alt: windowtext;\">&gt;&nbsp;20&nbsp;serrated lesions/polyps of any size distributed throughout the large bowel, with &ge;&nbsp;5 being proximal to the rectum</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; mso-yfti-lastrow: yes; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 446.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" colspan=\"2\" valign=\"top\" width=\"595\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210050250;\"><span style=\"color: black; mso-color-alt: windowtext;\">Any histological subtype of serrated lesion/polyp (hyperplastic polyp, sessile serrated lesion without or with dysplasia, traditional serrated adenoma, and unclassified serrated adenoma) is included in the final polyp count. The polyp count is cumulative over multiple colonoscopies.</span></span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

    "copyright": "WHO Classification of Tumours Editorial Board. Endocrine and neuroendocrine tumours. Lyon (France): International Agency for Research on Cancer; 2025. (WHO classification of tumours series, 5th ed.; vol. 10). https://publications.iarc.who.int/645.",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 637.9pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"851\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Usual GIST</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">SDH-deficient GIST</span></strong></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong>Age group</strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Older adults</span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Children &gt;&gt; young adults &gt;&gt; older adults</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Sex distribution</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Equal</span></span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Female predominance</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong>Associated syndromes</strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Rarely</span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Neurofibromatosis</span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Germline <em>KIT</em> mutation</span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Germline <em>PDGFRA</em> mutation</span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Almost always</span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">30% germline <em>SDHA</em> mutation</span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">50% <em>SDHC</em> epimutation (Carney triad)</span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">20% <em>SDHB</em>, <em>SDHC</em>, <em>SDHD</em> mutation</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Location</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Throughout GI tract</span></span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Stomach only<sup>a</sup></span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong>Predominant cell type</strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Spindled</span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Epithelioid</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Multifocality</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Rare</span></span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Common</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong>Multinodularity/lobulation</strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Rare</span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Usual</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">SDHB immunohistochemistry</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Retained</span></span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Lost/deficient (definitional)</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong>KIT or DOG1 immunohistochemistry</strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Usually positive for KIT and/or DOG1</span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Always positive for both KIT and DOG1</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Somatic <em>KIT</em> or <em>PDGFRA</em> mutation</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Usually</span></span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Never</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 11; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong>Lymph node metastasis</strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Very rare</span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Common</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 12; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Behaviour of metastasis</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Aggressive</span></span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Commonly indolent</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 13; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong>Response to imatinib</strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Usual</span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\">Primary resistance</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 14; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 212.65pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Prognosis predicted by size and mitotic count algorithm</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 205.55pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"274\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">Yes</span></span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210071142;\"><span style=\"color: black; mso-color-alt: windowtext;\">No</span></span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\"><sup>a</sup>To date, a single SDH-deficient GIST arising in the duodenum has been reported <span class=\"Ref-ID\">{28324028}</span>.</p>",

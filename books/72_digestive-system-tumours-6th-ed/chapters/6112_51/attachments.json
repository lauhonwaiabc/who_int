    "type": "WSI",
    "diagnosis": "Serrated lesion with dysplasia",
    "title": "",
    "legend": "The neoplasm circumferentially involves the appendiceal mucosa. The epithelium has a serrated architecture with dilated, branched crypts in the deep mucosa. Neoplastic cells show overt dysplasia with enlarged, hyperchromatic nuclei and increased mitotic figures present in the superficial epithelium.",
    "source": "Rhonda K. Yantiss",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/50152.dzi",
    "thumbnail": null
  },

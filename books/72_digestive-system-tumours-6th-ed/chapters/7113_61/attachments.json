    "fileId": 48885,
    "type": "Figure",
    "diagnosis": "Traditional serrated adenoma",
    "title": "",
    "legend": "Most traditional serrated adenomas are composed of non-mucinous epithelial cells with abundant eosinophilic cytoplasm and basally located nuclei. The nuclei are enlarged with smooth contours and small nucleoli, and they generally display less mitotic activity and apoptosis than conventional adenomas.",
    "source": "Rhonda K. Yantiss",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/72/61/48885.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/72/61/thumb_48885.jpg"
  },

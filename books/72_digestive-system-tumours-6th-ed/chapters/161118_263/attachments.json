    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 219.75pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"293\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 9.0cm; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"340\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Syndrome characteristics</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 219.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><strong>Syndrome MIM number(s)</strong></p>\r\n</td>\r\n<td style=\"width: 9.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"340\">\r\n<p class=\"TableText\">619290</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 219.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 9.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"340\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">PanNETs with glucagon production and secretion</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 219.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><strong>Associated benign tumours</strong></p>\r\n</td>\r\n<td style=\"width: 9.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"340\">\r\n<p class=\"TableText\">n/a</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 219.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cancer-related inheritance</span></strong></p>\r\n</td>\r\n<td style=\"width: 9.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"340\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Autosomal recessive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 219.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><strong>Chromosome location</strong></p>\r\n</td>\r\n<td style=\"width: 9.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"340\">\r\n<p class=\"TableText\">17q25.3 (<em>GCGR</em>)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 219.75pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Protein product&ndash;associated pathway</span></strong></p>\r\n</td>\r\n<td style=\"width: 9.0cm; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"340\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">GCGR </span><span style=\"color: black; mso-color-alt: windowtext;\">activation suppresses glycolysis, increases gluconeogenesis and glycogenolysis in hepatocytes. In addition, glucagon increases hepatic amino acid metabolism and release of very-low-density lipoprotein</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">n/a, not applicable; PanNET, pancreatic neuroendocrine tumour.</p>",

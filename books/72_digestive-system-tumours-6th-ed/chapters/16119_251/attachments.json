  {
    "pkattachmentId": 74773,
    "bookid": 72,
    "chapterId": 251,
    "fileId": 59818,
    "type": "Table",
    "diagnosis": "",
    "title": "<p class=\"TableTitle\"><strong>Table&nbsp;16.17</strong> Summary of the main features of Peutz&ndash;Jeghers syndrome</p>",
    "legend": "",
    "source": "Marnix Jansen",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 694.5pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"926\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Syndrome characteristics</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong>Syndrome MIM number(s)</strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">175200</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Colorectal adenocarcinoma, gastric adenocarcinoma, pancreatic adenocarcinoma, breast cancer (see <span class=\"ID-File\">&lt;&lt;#38786&gt;&gt;</span>Table&nbsp;2.29)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong>Associated benign tumours</strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">Gastrointestinal hamartomatous polyps, ovarian sex cord tumour with annular tubules, Sertoli cell tumours of the testis</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cancer-related inheritance</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Autosomal dominant</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong>Chromosome location</strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\"><em>STK11</em> (19p13)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Protein product&ndash;associated pathway</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">The STK11 (LKB1) pathway has multiple downstream targets including the WNT/TGF-</span><span style=\"mso-ascii-font-family: 'Times New Roman'; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: 'Times New Roman'; mso-hansi-theme-font: minor-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-theme-font: minor-latin; color: black; mso-color-alt: windowtext;\">&beta;</span><span style=\"color: black; mso-color-alt: windowtext;\"> and MAPK pathways</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },

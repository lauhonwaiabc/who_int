  {
    "pkattachmentId": 75272,
    "bookid": 72,
    "chapterId": 54,
    "fileId": 44418,
    "type": "Figure",
    "diagnosis": "Goblet cell carcinoma, grade 1",
    "title": "",
    "legend": "Low-power view; the tumour infiltrates the muscularis propria of the appendix without eliciting a desmoplastic stromal response. The tumour is composed of clusters of cuboidal cells and goblet-like mucinous cells in discrete, clustered units. No high-grade growth is seen in this example.",
    "source": "<p> Imported from 5th edition </p><p>Misdraji Joseph</p>",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/72/54/969.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/72/54/thumb_969.jpg"
  },
  {
    "pkattachmentId": 75275,
    "bookid": 72,
    "chapterId": 54,
    "fileId": 44421,
    "type": "Figure",
    "diagnosis": "Goblet cell carcinoma, grade 1",
    "title": "",
    "legend": "High-power view of classic low-grade goblet cell adenocarcinoma shows cohesive clusters of tumour cells with goblet-like mucinous cells resembling intestinal crypts.",
    "source": "<p> Imported from 5th edition </p><p>Misdraji Joseph</p>",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/72/54/972.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/72/54/thumb_972.jpg"
  },
  {
    "pkattachmentId": 75276,
    "bookid": 72,
    "chapterId": 54,
    "fileId": 44423,
    "type": "Figure",
    "diagnosis": "Goblet cell carcinoma, high-grade pattern",
    "title": "",
    "legend": "Medium-power view; in this example, the tumour is highly cellular, with streaming of tumour cells and loss of the discrete clustered units of low-grade goblet cell carcinoma. The grade of the tumour is determined by the percentage of tumour with high-grade growth.",
    "source": "<p> Imported from 5th edition </p><p>Misdraji Joseph</p>",
    "copyright": "",

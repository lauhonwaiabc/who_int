  },
  {
    "pkattachmentId": 75316,
    "bookid": 72,
    "chapterId": 54,
    "fileId": 44527,
    "type": "Figure",
    "diagnosis": "Goblet cell carcinoma, high-grade pattern",
    "title": "",
    "legend": "In this high-grade area, the tumour is growing as linear arrays of single, highly atypical cells, with no attempt to form tubular or clustered groups. The overall grade of the tumour is determined by the tumour percentage that shows high-grade features.",
    "source": "<p> Imported from 5th edition </p><p>Misdraji Joseph</p>",

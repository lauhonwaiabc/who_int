    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 503.25pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"671\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 190.9pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"255\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 312.35pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Syndrome characteristics</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 190.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"255\">\r\n<p class=\"TableText\"><strong>Syndrome (MIM number)</strong></p>\r\n</td>\r\n<td style=\"width: 312.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\">Polyposis syndrome, hereditary mixed&nbsp;1 (601288)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 190.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"255\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 312.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Colorectal adenocarcinoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 190.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"255\">\r\n<p class=\"TableText\"><strong>Associated benign tumours</strong></p>\r\n</td>\r\n<td style=\"width: 312.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\">Mixed colorectal polyps</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 190.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"255\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Associated malformations</span></strong></p>\r\n</td>\r\n<td style=\"width: 312.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Not relevant</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 190.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"255\">\r\n<p class=\"TableText\"><strong>Cancer-related inheritance</strong></p>\r\n</td>\r\n<td style=\"width: 312.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\">Autosomal dominant, caused by duplications upstream of <em>GREM1</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 190.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"255\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Chromosome location</span></strong></p>\r\n</td>\r\n<td style=\"width: 312.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">15q13.3</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 190.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"255\">\r\n<p class=\"TableText\"><strong>Genomic coordinates (genome build)</strong></p>\r\n</td>\r\n<td style=\"width: 312.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\">GRCh37 chr15:32964939_33004759dupins30 (39,850&nbsp;bp);</p>\r\n<p class=\"TableText\">GRCh37 chr15:g.32987207_33011059dupinsTG (23,854&nbsp;bp)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 190.9pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"255\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Protein product&ndash;associated pathway</span></strong></p>\r\n</td>\r\n<td style=\"width: 312.35pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Tandem head-to-tail duplications affecting <em>GREM1</em> lead to increased and ectopic expression of GREM1, a BMP antagonist</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

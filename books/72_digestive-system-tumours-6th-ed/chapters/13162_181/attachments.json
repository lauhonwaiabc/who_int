    "bookid": 72,
    "chapterId": 181,
    "fileId": 49796,
    "type": "WSI",
    "diagnosis": "Solid mesenchymal hamartoma",
    "title": "",
    "legend": "Solid mesenchymal hamartoma diagnosed in a 9-month old boy with a right liver mass. Multiple discrete nodules of variable size, composed of proliferating, anastomosing bile ducts embedded in a myxomatous stroma, resembling a ductal plate malformation. The intervening hepatic parenchyma shows unremarkable hepatocytes, congested sinusoids and dilated hepatic vein branches.",
    "source": "Dolores H. López-Terrada",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/49796.dzi",

        "chapterId": 175,
        "headingId": 963,
        "headingText": "\r\n\r\n<p>Not clinically relevant</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1001,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 966,
    "contributions": [
      {
        "pkcontributionId": 150133,
        "bookId": 72,
        "chapterId": 175,
        "headingId": 966,
        "headingText": "\r\n\r\n<p><em>Essential:</em> spindled or epithelioid cells showing Schwannian differentiation; diffuse S100/SOX10 expression.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 999,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 964,
    "contributions": [
      {
        "pkcontributionId": 150134,
        "bookId": 72,
        "chapterId": 175,
        "headingId": 964,
        "headingText": "\r\n\r\n<p>Not applicable</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1000,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 965,
    "contributions": [
      {
        "pkcontributionId": 150135,
        "bookId": 72,
        "chapterId": 175,
        "headingId": 965,
        "headingText": "\r\n\r\n<p>Schwann cell hamartoma and mucosal benign epithelioid nerve sheath tumour are benign lesions. Excision is curative.</p>\r\n<p>&nbsp;</p>",
        "timestamp": "2026-06-09T11:31:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
    "type": "WSI",
    "diagnosis": "<p>GAPPS: Hyperproliferative aberrant pits (HPAPs)</p>",
    "title": "",
    "legend": "<p>The entire mucosa is occupied by multiple hyperproliferative aberrant pits (HPAPs), large hyperplastic polyps with inverted foveolar hyperplasia and fundic gland like polyps characteristic of GAPPs syndrome.</p>",
    "source": "<p> Imported from 5th edition </p><p>Kumarasinghe M Priyanthi</p>",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44726.dzi",
    "thumbnail": null
  },

  {
    "pkattachmentId": 74864,
    "bookid": 72,
    "chapterId": 64,
    "fileId": 48713,
    "type": "WSI",
    "diagnosis": "Adenocarcinoma&nbsp;arising in a conventional colorectal adenoma",
    "title": "",
    "legend": "Adenocarcinoma&nbsp;arising in a conventional colorectal adenoma. This sigmoid&nbsp;colon&nbsp;adenoma shows a focus of epithelial misplacement and a separate focus of&nbsp;adenocarcinoma. The adenocarcinoma&nbsp;focus shows marked crowding of small, angulated, infiltrative glands in comparison to the rounded lobules of larger misplaced glands showing prominent cystic dilatation.",
    "source": "Maurice B. Loughrey",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/48713.dzi",
    "thumbnail": null
  },
  {

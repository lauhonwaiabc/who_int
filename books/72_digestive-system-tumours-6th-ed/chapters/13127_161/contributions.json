[
  {
    "pkheadingid": 986,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 951,
    "contributions": [
      {
        "pkcontributionId": 149932,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 951,
        "headingText": "\r\n\r\n<p>Plexiform fibromyxoma is a benign mesenchymal neoplasm that typically arises in the gastric antrum and pyloric region.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 987,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 952,
    "contributions": [
      {
        "pkcontributionId": 149933,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 952,
        "headingText": "\r\n\r\n<p>88111/0 Plexiform fibromyxoma</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 988,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 953,
    "contributions": [
      {
        "pkcontributionId": 149934,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 953,
        "headingText": "\r\n\r\n<p>2E92.1 &amp; XH2WT6 Plexiform fibromyxoma of stomach</p>\r\n<p>2E92.2 &amp; XH2WT6 Plexiform fibromyxoma of duodenum</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 989,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 954,
    "contributions": [
      {
        "pkcontributionId": 149935,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 954,
        "headingText": "\r\n\r\n<p><em>Acceptable:</em> plexiform angiomyxoid myofibroblastic tumour of the stomach.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 990,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 955,
    "contributions": [
      {
        "pkcontributionId": 149936,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 955,
        "headingText": "\r\n\r\n<p>None</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 991,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 956,
    "contributions": [
      {
        "pkcontributionId": 149937,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 956,
        "headingText": "\r\n\r\n<p>Plexiform fibromyxoma is primarily gastric, but the duodenum can be involved.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 992,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 957,
    "contributions": [
      {
        "pkcontributionId": 149938,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 957,
        "headingText": "\r\n\r\n<p>Presenting symptoms include gastrointestinal bleeding, ulcer, weight loss, and pyloric obstruction.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 993,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 958,
    "contributions": [
      {
        "pkcontributionId": 149939,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 958,
        "headingText": "\r\n\r\n<p>Plexiform fibromyxoma is an exceedingly rare tumour, with published cases describing a frequency relative to gastrointestinal stromal tumour of 1.7%. There is an equal sex distribution, and tumours have been reported over a wide patient age range, including in childhood {34040702;32717659}.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 994,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 959,
    "contributions": [
      {
        "pkcontributionId": 149940,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 959,
        "headingText": "\r\n\r\n<p>Unknown</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 995,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 960,
    "contributions": [
      {
        "pkcontributionId": 149941,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 960,
        "headingText": "\r\n\r\n<p><em>MALAT1</em>::<em>GLI1</em> fusions or <em>PTCH1</em> inactivation are recurrent changes. Both alterations lead to GLI1 overexpression {27101025;31362756}.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1002,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 967,
    "contributions": [
      {
        "pkcontributionId": 149942,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 967,
        "headingText": "\r\n\r\n<p>The tumours form gelatinous or haemorrhagic multinodular masses of 30&ndash;150&nbsp;mm (median: 55&nbsp;mm), sometimes protruding from the serosa {20556828;19675452} but centred in the muscularis propria. Extension into the mucosa with associated ulceration is noted in a subset of cases.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 996,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 961,
    "contributions": [
      {
        "pkcontributionId": 149943,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 961,
        "headingText": "\r\n\r\n<p>The nodules are composed of bland spindle cells, probably myofibroblasts, set in a myxoid, fibromyxoid, or collagenous matrix with a prominent arborizing thin-walled capillary network. Increased cellularity may be seen in tumours in the duodenal bulb or with extramural extension. Tumour nodules may extend into veins, which is of no clinical significance {19675452}. Substantial cytological atypia is absent, and the mitotic count is low (median: 1&nbsp;mitosis/10&nbsp;mm<sup>2</sup>) {19675452}. The spindle cells are positive for SMA and occasionally for desmin, whereas ALK, CD34, keratins, KIT, and DOG1 are negative {19675452;20556828}.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 997,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 962,
    "contributions": [
      {
        "pkcontributionId": 149944,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 962,
        "headingText": "\r\n\r\n<p>Not clinically relevant</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 998,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 963,
    "contributions": [
      {
        "pkcontributionId": 149945,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 963,
        "headingText": "\r\n\r\n<p>Not clinically relevant</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1001,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 966,
    "contributions": [
      {
        "pkcontributionId": 149946,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 966,
        "headingText": "\r\n\r\n<p><em>Essential:</em> multinodular and plexiform low-power architecture; uniform spindle cells in a myxoid, fibromyxoid, or collagenous stroma; delicate arborizing vasculature.</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 999,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 964,
    "contributions": [
      {
        "pkcontributionId": 149947,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 964,
        "headingText": "\r\n\r\n<p>Not applicable</p>\r\n\r\n",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 1000,
    "bookid": 72,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 965,
    "contributions": [
      {
        "pkcontributionId": 149948,
        "bookId": 72,
        "chapterId": 161,
        "headingId": 965,
        "headingText": "\r\n\r\n<p>Plexiform fibromyxoma is benign, with no reports of recurrence or metastasis {17460456;20556828;19675452}.</p>\r\n<p>&nbsp;</p>",
        "timestamp": "2026-06-09T11:31:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
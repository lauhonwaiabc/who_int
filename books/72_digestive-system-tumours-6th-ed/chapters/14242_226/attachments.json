    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 112.45pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Factor</span></strong></p>\r\n</td>\r\n<td style=\"width: 156.9pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"209\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Method of assessment</span></strong></p>\r\n</td>\r\n<td style=\"width: 70.85pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">In routine use?</span></strong></p>\r\n</td>\r\n<td style=\"width: 5.0cm; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">References</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 112.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\"><strong>Tumour size</strong></p>\r\n</td>\r\n<td style=\"width: 156.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"209\">\r\n<p class=\"TableText\">Gross evaluation</p>\r\n</td>\r\n<td style=\"width: 70.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\">Yes</p>\r\n</td>\r\n<td style=\"width: 5.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><span class=\"Ref-ID\">{20664472;12210027;18059224}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 112.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Invasiveness (vascular invasion, extrapancreatic invasion)</span></strong></p>\r\n</td>\r\n<td style=\"width: 156.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"209\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Microscopic evaluation</span></p>\r\n</td>\r\n<td style=\"width: 70.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Yes</span></p>\r\n</td>\r\n<td style=\"width: 5.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><span class=\"Ref-ID\"><span style=\"color: black; mso-color-alt: windowtext;\">{20664472;18059224}</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 112.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\"><strong>Necrosis</strong></p>\r\n</td>\r\n<td style=\"width: 156.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"209\">\r\n<p class=\"TableText\">Microscopic evaluation</p>\r\n</td>\r\n<td style=\"width: 70.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\">No</p>\r\n</td>\r\n<td style=\"width: 5.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><span class=\"Ref-ID\">{12039924}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 112.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Stage</span></strong></p>\r\n</td>\r\n<td style=\"width: 156.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"209\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Microscopic evaluation; clinical/radiographical evaluation</span></p>\r\n</td>\r\n<td style=\"width: 70.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Yes</span></p>\r\n</td>\r\n<td style=\"width: 5.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><span class=\"Ref-ID\"><span style=\"color: black; mso-color-alt: windowtext;\">{22525418;30300897}</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 112.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\"><strong>Grade</strong></p>\r\n</td>\r\n<td style=\"width: 156.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"209\">\r\n<p class=\"TableText\">Microscopic evaluation and immunohistochemistry</p>\r\n</td>\r\n<td style=\"width: 70.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\">Yes</p>\r\n</td>\r\n<td style=\"width: 5.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><span class=\"Ref-ID\">{18059224;18065733;20305616;22525418;30300897}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 112.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Mitotic count</span></strong></p>\r\n</td>\r\n<td style=\"width: 156.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"209\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Microscopic evaluation</span></p>\r\n</td>\r\n<td style=\"width: 70.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Yes</span></p>\r\n</td>\r\n<td style=\"width: 5.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><span class=\"Ref-ID\"><span style=\"color: black; mso-color-alt: windowtext;\">{18059224;18065733;20305616;22525418;30300897}</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 112.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\"><strong>Ki-67 proliferation index</strong></p>\r\n</td>\r\n<td style=\"width: 156.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"209\">\r\n<p class=\"TableText\">Immunohistochemistry</p>\r\n</td>\r\n<td style=\"width: 70.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\">Yes</p>\r\n</td>\r\n<td style=\"width: 5.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><span class=\"Ref-ID\">{18059224;18065733;20305616;21566513;22525418;29134440;30300897}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 112.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">PTEN loss</span></strong></p>\r\n</td>\r\n<td style=\"width: 156.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"209\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Immunohistochemistry</span></p>\r\n</td>\r\n<td style=\"width: 70.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">No</span></p>\r\n</td>\r\n<td style=\"width: 5.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><span class=\"Ref-ID\"><span style=\"color: black; mso-color-alt: windowtext;\">{25076292}</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"width: 112.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\"><strong>PR loss</strong></p>\r\n</td>\r\n<td style=\"width: 156.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"209\">\r\n<p class=\"TableText\">Immunohistochemistry</p>\r\n</td>\r\n<td style=\"width: 70.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\">No</p>\r\n</td>\r\n<td style=\"width: 5.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><span class=\"Ref-ID\">{25076292}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid;\">\r\n<td style=\"width: 112.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Aneuploidy</span></strong></p>\r\n</td>\r\n<td style=\"width: 156.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"209\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Flow cytometry</span></p>\r\n</td>\r\n<td style=\"width: 70.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"94\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">No</span></p>\r\n</td>\r\n<td style=\"width: 5.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"189\">\r\n<p class=\"TableText\"><span class=\"Ref-ID\"><span style=\"color: black; mso-color-alt: windowtext;\">
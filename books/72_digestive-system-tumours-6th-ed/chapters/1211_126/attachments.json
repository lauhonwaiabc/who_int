    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 83.28%; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"83%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 348.95pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"465\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Neoplasm</span></strong></p>\r\n</td>\r\n<td style=\"width: 232.25pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"310\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Most common sites of involvement in the digestive system</span></strong></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 581.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"775\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\"><strong>B-cell lymphomas</strong></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 348.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"465\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\"><span style=\"color: black; mso-color-alt: windowtext;\">Extranodal marginal zone lymphoma of mucosa-associated lymphoid tissue</span></span></p>\r\n</td>\r\n<td style=\"width: 232.25pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"310\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\"><span style=\"color: black; mso-color-alt: windowtext;\">Stomach, small intestine</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 348.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"465\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\">Duodenal-type follicular lymphoma</span></p>\r\n</td>\r\n<td style=\"width: 232.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"310\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\">Duodenum</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 348.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"465\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\"><span style=\"color: black; mso-color-alt: windowtext;\">Follicular lymphoma</span></span></p>\r\n</td>\r\n<td style=\"width: 232.25pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"310\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\"><span style=\"color: black; mso-color-alt: windowtext;\">Small intestine, large intestine</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 348.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"465\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\">Mantle cell lymphoma</span></p>\r\n</td>\r\n<td style=\"width: 232.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"310\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\">Any site in the GI tract</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 348.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"465\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\"><span lang=\"FR\" style=\"color: black; mso-color-alt: windowtext; mso-ansi-language: FR;\">Diffuse large B-cell lymphoma</span></span></p>\r\n</td>\r\n<td style=\"width: 232.25pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"310\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\"><span style=\"color: black; mso-color-alt: windowtext;\">Stomach, ileocaecal region</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 348.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"465\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\">Burkitt lymphoma</span></p>\r\n</td>\r\n<td style=\"width: 232.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"310\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\">Ileocaecal region, stomach, small intestine</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 581.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"775\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">T-cell and NK-cell lymphomas/lymphoproliferative disorders</span></strong></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"width: 348.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"465\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\">Indolent NK-cell lymphoproliferative disorder of the GI tract</span></p>\r\n</td>\r\n<td style=\"width: 232.25pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"310\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\">Small intestine, large intestine</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid;\">\r\n<td style=\"width: 348.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"465\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210062377;\"><span style=\"color: black; mso-color-alt: windowtext;\">Indolent T-cell lymphoproliferative disorder of the GI 
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 694.5pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"926\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk204590287;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Syndrome characteristics</span></strong></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong>Syndrome MIM number(s)</strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">137215</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Diffuse gastric cancer, lobular breast cancer</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong>Associated benign tumours</strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\">Not applicable</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cancer-related inheritance</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Autosomal dominant</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong>Chromosome location</strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\"><em>CDH1</em> (16q22.1)</p>\r\n<p class=\"TableText\"><em>CTNNA1</em> (5q31.2) (rare cases)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Protein product&ndash;associated pathway</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">E-cadherin, localized in adherens junctions, involved in cell&ndash;cell adhesion, tension sensing, mitotic spindle orientation, and signal transduction</span></p>\r\n<p class=\"TableText\"><span style=\"mso-ascii-font-family: 'Times New Roman'; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: 'Times New Roman'; mso-hansi-theme-font: minor-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-theme-font: minor-latin; color: black; mso-color-alt: windowtext;\">&alpha;</span><span style=\"color: black; mso-color-alt: windowtext;\">-Catenin, localized in adherens junctions, involved in WNT/</span><span style=\"mso-ascii-font-family: 'Times New Roman'; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: 'Times New Roman'; mso-hansi-theme-font: minor-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-theme-font: minor-latin; color: black; mso-color-alt: windowtext;\">&beta;</span><span style=\"color: black; mso-color-alt: windowtext;\">-catenin signalling</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

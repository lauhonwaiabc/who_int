  {
    "pkattachmentId": 75843,
    "bookid": 72,
    "chapterId": 129,
    "fileId": 48939,
    "type": "Figure",
    "diagnosis": "EBV-positive mucocutaneous ulcer, colon",
    "title": "",
    "legend": "<strong>A</strong>&nbsp;An ulcerated lesion expands the lamina propria and submucosa (left, H&amp;E).<strong> B</strong>&nbsp;Note that numerous nuclei are hybridized using EBV-encoded small RNA (EBER) in&nbsp;situ hybridization.<strong> C</strong>&nbsp;The marked cytological atypia is concerning for lymphoma, but careful inspection shows that there are plentiful background mature lymphocytes. On follow-up, this lesion vanished with immune reconstitution.<strong> D</strong>&nbsp;Although many nuclei are positive using EBER in&nbsp;situ hybridization, many are not. Were this an EBV-driven lymphoma, nearly every cell would likely show a reaction.",
    "source": "Elizabeth A. Montgomery",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/72/129/48939.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/72/129/thumb_48939.jpg"

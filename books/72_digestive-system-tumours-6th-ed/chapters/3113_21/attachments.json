    "diagnosis": "",
    "title": "<p class=\"TableTitle\"><strong>Table&nbsp;3.02</strong> Characterization of subtypes of dysplasia</p>",
    "legend": "",
    "source": "Gregory Y. Lauwers",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 91.9pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Subtype of dysplasia</span></strong></p>\r\n</td>\r\n<td style=\"width: 93.0pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"124\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Architecture</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 76.0pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"101\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cytology</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 85.7pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"114\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Immunophenotype</span></strong></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 91.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><strong>Intestinal-type dysplasia</strong></span></p>\r\n</td>\r\n<td style=\"width: 93.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"124\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\">Tubular, villous, tubulovillous</span></p>\r\n</td>\r\n<td style=\"width: 76.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"101\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\">Tall columnar cells; penicillate, overlapping, hyperchromatic nuclei</span></p>\r\n</td>\r\n<td style=\"width: 85.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"114\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\">MUC2+</span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\">CD10+</span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\">CDX2+</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 91.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Gastric (foveolar)-type dysplasia</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 93.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"124\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span style=\"color: black; mso-color-alt: windowtext;\">Elongated foveolae&nbsp;/ serrated</span></span></p>\r\n</td>\r\n<td style=\"width: 76.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"101\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span style=\"color: black; mso-color-alt: windowtext;\">Cuboidal&nbsp;/ low columnar cells; apical mucin cap; round to oval hyperchromatic nuclei; prominent nucleoli</span></span></p>\r\n</td>\r\n<td style=\"width: 85.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"114\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span style=\"color: black; mso-color-alt: windowtext;\">MUC5AC+</span></span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span style=\"color: black; mso-color-alt: windowtext;\">MUC6+/&minus; (bottom of the glands)</span></span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span style=\"color: black; mso-color-alt: windowtext;\">MUC2+/&minus; (rare cells)</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 91.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><strong>Serrated-type dysplasia</strong></span></p>\r\n</td>\r\n<td style=\"width: 93.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"124\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\">Elongated epithelial fronds, prominent Christmas-tree-like serrated configuration, scalloped epithelial indentations</span></p>\r\n</td>\r\n<td style=\"width: 76.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"101\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\">Elongated, stratified, hyperchromatic/vesicular nuclei; prominent nucleoli</span></p>\r\n</td>\r\n<td style=\"width: 85.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"114\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\">MUC5AC+</span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\">MUC6+/&minus;</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 91.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Gastric pit/crypt dysplasia</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 169.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"225\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span style=\"color: black; mso-color-alt: windowtext;\">Similar to conventional dysplasia but limited at the basal portion of the gastric pit/crypt</span></span></p>\r\n</td>\r\n<td style=\"width: 85.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"114\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span style=\"color: black; mso-color-alt: windowtext;\">MUC2+</span></span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span style=\"color: black; mso-color-alt: windowtext;\">CDX2+</span></span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span style=\"color: black; mso-color-alt: windowtext;\">MUC5AC+/&minus;</span></span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span style=\"color: black; mso-color-alt: windowtext;\">MUC6+/&minus;</span></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 91.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><strong>Dysplasia of pyloric glands</strong></span></p>\r\n</td>\r\n<td style=\"width: 169.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"225\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\">See <span class=\"ID-Section\">&lt;&lt;3.1.1.6&gt;&gt;</span><em>Gastric pyloric gland adenoma</em></span></p>\r\n</td>\r\n<td style=\"width: 85.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"114\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\">MUC6+</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 91.9pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Dysplasia of oxyntic glands</span></strong></span></p>\r\n</td>\r\n<td style=\"width: 169.0pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"225\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span style=\"color: black; mso-color-alt: windowtext;\">See <span class=\"ID-Section\"><span style=\"color: black; mso-color-alt: windowtext;\">&lt;&lt;3.1.1.7&gt;&gt;</span></span><em>Oxyntic gland adenoma</em></span></span></p>\r\n</td>\r\n<td style=\"width: 85.7pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"114\">\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span lang=\"SV\" style=\"color: black; mso-color-alt: windowtext; mso-ansi-language: SV;\">MUC6+</span></span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span lang=\"SV\" style=\"color: black; mso-color-alt: windowtext; mso-ansi-language: SV;\">Pepsinogen&nbsp;I+</span></span></p>\r\n<p class=\"TableText\"><span style=\"mso-bookmark: _Hlk210032966;\"><span lang=\"SV\" style=\"color: black; mso-color-alt: windowtext; mso-ansi-language: SV;\">H<sup>+</sup>/K<sup>+</sup>&nbsp;ATPase+/&minus;</span></span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

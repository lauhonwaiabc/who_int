        "chapterId": 159,
        "headingId": 469,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-03-15T12:28:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 707,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 470,

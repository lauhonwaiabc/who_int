[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 105748,
        "bookId": 44,
        "chapterId": 159,
        "headingId": 466,
        "headingText": "\r\n<p>Plexiform fibrohistiocytic tumour (PFHT) is a rare dermal and subcutaneous neoplasm composed of biphasic nodules of histiocytoid cells and spindled myofibroblasts arranged in a plexiform architecture.</p>\r\n",
        "timestamp": "2023-03-15T12:28:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 704,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 467,
    "contributions": [
      {
        "pkcontributionId": 105749,
        "bookId": 44,
        "chapterId": 159,
        "headingId": 467,
        "headingText": "\r\n<p>8835/1 Plexiform fibrohistiocytic tumour</p>\r\n",
        "timestamp": "2023-03-15T12:28:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 705,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 468,
    "contributions": [
      {
        "pkcontributionId": 105750,
        "bookId": 44,
        "chapterId": 159,
        "headingId": 468,
        "headingText": "\r\n<p>2F7C &amp; XH4GL1 Neoplasms of uncertain behaviour of connective or other soft tissue &amp; Plexiform fibrohistiocytic tumour</p>\r\n",
        "timestamp": "2023-03-15T12:28:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 706,

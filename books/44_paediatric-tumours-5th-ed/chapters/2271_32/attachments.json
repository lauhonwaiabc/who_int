    "bookid": 44,
    "chapterId": 32,
    "fileId": 21840,
    "type": "Figure",
    "diagnosis": "Maculopapular cutaneous mastocytosis&nbsp;/ urticaria pigmentosa",
    "title": "",
    "legend": "Yellow patches were noted on the left forearm of a 1-year-old boy. Nests of mast cells aggregate around small vessels beneath the epidermis, with the typical bland appearance of mast cells.",
    "source": "Tracy I. George",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/32/21840.jpg",

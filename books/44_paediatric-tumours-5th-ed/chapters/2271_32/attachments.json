    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 700.2pt; background: #DAEEF3; border-collapse: collapse; \" border=\"0\" width=\"934\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 7.95pt;\">\r\n<td style=\"width: 700.2pt; border-top: solid black 1.0pt; border-left: none; border-bottom: solid black 1.0pt; border-right: none; background: transparent; padding: 0cm 5.4pt 0cm 5.4pt; height: 7.95pt;\" colspan=\"2\" width=\"934\">\r\n<p class=\"TableText\"><strong>Cutaneous mastocytosis</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 2.25pt;\">\r\n<td style=\"width: 700.2pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 2.25pt;\" colspan=\"2\" width=\"934\">\r\n<p class=\"TableText\"><strong style=\"\"><em><span style=\"color: black; \">Major criterion:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 2.25pt;\">\r\n<td style=\"width: 30.05pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 2.25pt;\" width=\"40\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 670.15pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 2.25pt;\" width=\"894\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Typical eruption</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 11.25pt;\">\r\n<td style=\"width: 700.2pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 11.25pt;\" colspan=\"2\" width=\"934\">\r\n<p class=\"TableText\"><strong style=\"\"><em><span style=\"color: black; \">Minor criteria:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.4pt;\">\r\n<td style=\"width: 30.05pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.4pt;\" width=\"40\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 670.15pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.4pt;\" width=\"894\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Monomorphic large mast cell aggregates (i.e. &gt;&nbsp;15&nbsp;mast cells per cluster)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 3.5pt;\">\r\n<td style=\"width: 30.05pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"40\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 670.15pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"894\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Mutation involving codon&nbsp;816 of <em>KIT</em> in lesional skin</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 9.55pt;\">\r\n<td style=\"width: 700.2pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 9.55pt;\" colspan=\"2\" width=\"934\">\r\n<p class=\"TableText\"><span style=\"color: black; \">The major criterion and at least one of the minor criteria are required.</span></p>\r\n<p class=\"TableText\"><span style=\"color: black; \">In children with tryptase &lt;&nbsp;20&nbsp;&mu;g/L and no signs of systemic disease, the diagnosis of cutaneous mastocytosis can be established in the absence of a bone marrow study.</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 3.5pt;\">\r\n<td style=\"width: 700.2pt; border: none; border-bottom: solid black 1.0pt; background: transparent; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" colspan=\"2\" width=\"934\">\r\n<p class=\"TableText\"><strong>Systemic mastocytosis</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 3.5pt;\">\r\n<td style=\"width: 700.2pt; border: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" colspan=\"2\" width=\"934\">\r\n<p class=\"TableText\"><strong style=\"\"><em><span style=\"color: black; \">Major criterion:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 30.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"40\">\r\n<p class=\"TableText\"><strong style=\"\">&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 670.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"894\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Multifocal compact aggregates of &gt;&nbsp;15&nbsp;mast cells in bone marrow sections (or other extracutaneous tissues)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 16.35pt;\">\r\n<td style=\"width: 700.2pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.35pt;\" colspan=\"2\" width=\"934\">\r\n<p class=\"TableText\"><strong style=\"\"><em><span style=\"color: black; \">Minor criteria:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 16.35pt;\">\r\n<td style=\"width: 30.05pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.35pt;\" width=\"40\">\r\n<p class=\"TableText\"><strong style=\"\">&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 670.15pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.35pt;\" valign=\"top\" width=\"894\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Abnormal morphology in &gt;&nbsp;25% of mast cells in bone marrow smears</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 16.35pt;\">\r\n<td style=\"width: 30.05pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.35pt;\" width=\"40\">\r\n<p class=\"TableText\"><strong style=\"\">&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 670.15pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.35pt;\" valign=\"top\" width=\"894\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Aberrant expression of CD25 and/or CD2 by bone marrow mast cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 16.35pt;\">\r\n<td style=\"width: 30.05pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.35pt;\" width=\"40\">\r\n<p class=\"TableText\"><strong style=\"\">&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 670.15pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.35pt;\" valign=\"top\" width=\"894\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Serum tryptase &gt;&nbsp;20&nbsp;&mu;g/L</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 16.35pt;\">\r\n<td style=\"width: 30.05pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.35pt;\" width=\"40\">\r\n<p class=\"TableText\"><strong style=\"\">&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 670.15pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.35pt;\" valign=\"top\" width=\"894\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Mutation at codon&nbsp;816 of <em>KIT</em></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 22.35pt;\">\r\n<td style=\"width: 700.2pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.35pt;\" colspan=\"2\" width=\"934\">\r\n<p class=\"TableText\"><span style=\"color: black; \">The major criterion and at least one of the minor criteria, or at least three minor criteria in the absence of the major criterion, are required.</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

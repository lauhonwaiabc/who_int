  },
  {
    "pkattachmentId": 50574,
    "bookid": 44,
    "chapterId": 32,
    "fileId": 21843,
    "type": "Figure",
    "diagnosis": "Indolent systemic mastocytosis",
    "title": "",
    "legend": "A 3-year-old girl presented with cutaneous mastocytosis, absolute lymphopenia, elevated serum tryptase (60&nbsp;&micro;g/L), and <em>KIT</em> p.D816V mutation in peripheral blood using a high sensitivity PCR assay. A bone marrow aspirate shows rare (&lt;&nbsp;1%) spindle-shaped mast cells, which by flow cytometry (data not shown) demonstrated aberrant expression of CD2 and CD25. Normal granulopoiesis, erythropoiesis, haematogones, and an eosinophil are also present (Wright&ndash;Giemsa stain).",
    "source": "Tracy I. George",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/32/21843.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/32/thumb_21843.jpg"
  },
  {
    "pkattachmentId": 50575,
    "bookid": 44,
    "chapterId": 32,
    "fileId": 21844,
    "type": "Figure",
    "diagnosis": "Indolent systemic mastocytosis",
    "title": "",
    "legend": "A 3-year-old girl presented with cutaneous mastocytosis, absolute lymphopenia, elevated serum tryptase (60&nbsp;&micro;g/L), and <em>KIT</em> p.D816V mutation in peripheral blood using a high sensitivity PCR assay. Bone marrow biopsy showed a normocellular marrow with rare multifocal mast cell aggregates and increased interstitial mast cells, occupying 10% of cellular marrow, best demonstrated by immunohistochemical staining for KIT (CD117) (shown here), CD25, and tryptase.",
    "source": "Tracy I. George",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/32/21844.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/32/thumb_21844.jpg"
  },

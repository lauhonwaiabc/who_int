  {
    "pkattachmentId": 51207,
    "bookid": 44,
    "chapterId": 32,
    "fileId": 32191,
    "type": "Figure",
    "diagnosis": "Mastocytosis",
    "title": "",
    "legend": "Algorithm for using allele-specific quantitative PCR (ASqPCR) for diagnosis and management. Children diagnosed with cutaneous manifestations of mastocytosis without other clinical parameters such as organomegaly rarely are diagnosed with indolent systemic mastocytosis (SM). Peripheral blood (PB) ASqPCR is helpful for identifying those patients for whom a bone marrow (BM) procedure should be considered. A positive value correlates with systemic disease. A negative value in patients with organomegaly and an elevated serum tryptase may indicate a low allelic burden. These patients may be followed up annually to monitor their disease burden. MC, mast cell.",
    "source": "",
    "copyright": "Reprinted, with permission, from Carter MC, Bai Y, Ruiz-Esteves KN, et al. Detection of KIT D816V in peripheral blood of children with manifestations of cutaneous mastocytosis suggests systemic disease. Br J Haematol. 2018 Dec;183(5):775-82. PMID: 30488427",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/32/32191.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/32/thumb_32191.jpg"
  },

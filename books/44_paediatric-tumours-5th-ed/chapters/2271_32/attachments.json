  },
  {
    "pkattachmentId": 50572,
    "bookid": 44,
    "chapterId": 32,
    "fileId": 21841,
    "type": "Figure",
    "diagnosis": "Maculopapular cutaneous mastocytosis&nbsp;/ urticaria pigmentosa",
    "title": "",
    "legend": "Yellow patches were noted on the left forearm of a 1-year-old boy. Pink-orange papules were present on the boy&rsquo;s midback, and a subtle perivascular and interstitial infiltrate of mast cells and eosinophils was found on punch biopsy. The overlying epidermis shows basal keratinocytic hyperpigmentation.",
    "source": "Tracy I. George",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/32/21841.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/32/thumb_21841.jpg"
  },
  {
    "pkattachmentId": 50573,
    "bookid": 44,
    "chapterId": 32,
    "fileId": 21842,
    "type": "Figure",
    "diagnosis": "Maculopapular cutaneous mastocytosis&nbsp;/ urticaria pigmentosa",
    "title": "",
    "legend": "Yellow patches were noted on the left forearm of a 1-year-old boy. Immunohistochemical staining for KIT (CD117) highlights the abundant dermal mast cells.",
    "source": "Tracy I. George",
    "copyright": "",
    "tablehtml": "",

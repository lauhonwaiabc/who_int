        "headingId": 478,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-10T14:07:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 108304,
        "bookId": 44,
        "chapterId": 348,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> a radiographically well-demarcated lesion; a benign fibro-osseous lesion with variable maturation; a hypercellular stroma of spindle cells.</p>\r\n",
        "timestamp": "2023-03-10T14:07:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 479,
    "contributions": [
      {
        "pkcontributionId": 108305,
        "bookId": 44,
        "chapterId": 348,
        "headingId": 479,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-10T14:07:11"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 108306,
        "bookId": 44,
        "chapterId": 348,
        "headingId": 480,
        "headingText": "<p>PsOF and JTOF often recur after simple curettage but respond to repeated curettage or conservative excision {1843064; 22736440}, with long-term follow-up to exclude recurrence {20026707; 31062892}. Malignant transformation is not seen.</p>",
        "timestamp": "2023-05-04T17:50:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
    "legend": "",
    "source": "",
    "copyright": "Not necessary",
    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 411.1pt; background: #DAEEF3; border-collapse: collapse; border: none; \" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><em style=\"\"><span style=\"\">Essential:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><span style=\" \">A CNS embryonal tumour with a polyimmunophenotype</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" colspan=\"2\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 36.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><span style=\"\">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 374.3pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"499\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><span style=\"\">Loss of nuclear SMARCB1 or SMARCA4 expression in tumour cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 36.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><span style=\"\">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 374.3pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"499\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><span style=\"\">OR (for unresolved lesions)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 36.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"49\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><span style=\"\">&nbsp;</span></strong></p>\r\n</td>\r\n<td style=\"width: 374.3pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"499\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><span style=\"\">A DNA methylation profile aligned with atypical teratoid/rhabdoid tumour</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 411.1pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><em style=\"\"><span style=\"\">Desirable:</span></em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 411.1pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><span style=\"\">Rhabdoid cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 411.1pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><em><span style=\"\">SMARCB1</span></em><span style=\"\"> or <em>SMARCA4</em> alteration</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

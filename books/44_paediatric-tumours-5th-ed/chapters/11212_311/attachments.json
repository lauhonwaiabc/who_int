    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 581.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 581.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">Rathke pouch epithelial glands, primitive blastomatous cells, and secretory and folliculostellate anterior pituitary cells</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 581.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 581.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><em>DICER1</em> alterations</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.15pt;\">\r\n<td style=\"width: 581.2pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.15pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong><em>Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 13.45pt;\">\r\n<td style=\"width: 581.2pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 13.45pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">Diagnosed in children aged &lt;&nbsp;2&nbsp;years</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.8pt;\">\r\n<td style=\"width: 581.2pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.8pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">Cushing syndrome</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 12.8pt;\">\r\n<td style=\"width: 581.2pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.8pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">Personal or family history of <em>DICER1</em> syndrome</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

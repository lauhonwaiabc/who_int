[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 106343,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 466,
        "headingText": "\r\n<p>Superficial angiomyxoma is a bland-looking myxoid dermal tumour with a lobular/multinodular configuration.</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 704,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 467,
    "contributions": [
      {
        "pkcontributionId": 106344,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 467,
        "headingText": "\r\n<p>8841/0 Superficial angiomyxoma</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 705,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 468,
    "contributions": [
      {
        "pkcontributionId": 106345,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 468,
        "headingText": "\r\n<p>2F7C &amp; XH58A9 Neoplasms of uncertain behaviour of connective or other soft tissue &amp; Superficial angiomyxoma</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 706,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 469,
    "contributions": [
      {
        "pkcontributionId": 106346,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 469,
        "headingText": "\r\n<p><em>Acceptable:</em> cutaneous myxoma.</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 707,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 470,
    "contributions": [
      {
        "pkcontributionId": 106347,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 470,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 708,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 471,
    "contributions": [
      {
        "pkcontributionId": 106348,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 471,
        "headingText": "\r\n<p>Superficial angiomyxomas have been reported at different sites, including the genital and head/neck regions {21504453; 32739529; 28272665; 23783153}. Congenital cases are rare, and multiple lesions are usually associated with Carney complex {12532046}.</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 709,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 472,
    "contributions": [
      {
        "pkcontributionId": 106349,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 472,
        "headingText": "\r\n<p>Superficial angiomyxomas produce a painless cutaneous or subcutaneous papule or nodule.</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 710,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 473,
    "contributions": [
      {
        "pkcontributionId": 106350,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 473,
        "headingText": "\r\n<p>Superficial angiomyxoma is rare in children {21504453; 32739529; 28272665; 23783153; 9536546}.</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 711,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 474,
    "contributions": [
      {
        "pkcontributionId": 106351,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 474,
        "headingText": "\r\n<p>The etiology of single lesions is unknown. Multiple lesions may be associated with Carney complex.</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 712,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 475,
    "contributions": [
      {
        "pkcontributionId": 106352,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 475,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 719,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 482,
    "contributions": [
      {
        "pkcontributionId": 106353,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 482,
        "headingText": "\r\n<p>Most tumours appear as circumscribed myxoid dermal nodules.</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 713,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 476,
    "contributions": [
      {
        "pkcontributionId": 106354,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 476,
        "headingText": "\r\n<p>Superficial angiomyxoma is composed of bland-looking spindled to stellate cells set in an abundant myxoid stroma with capillary-like vessels that exhibit, at least focally, an arborizing/plexiform configuration. A lobular/multinodular appearance, due to the presence of fibrous septa, is a typical feature. Entrapped cystic epithelial structures may be seen. CD34 is diffusely expressed.</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 714,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 477,
    "contributions": [
      {
        "pkcontributionId": 106355,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 477,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 715,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 478,
    "contributions": [
      {
        "pkcontributionId": 106356,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 478,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 106357,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> dermal myxoid tumour with a lobular/multinodular configuration.</p>\r\n<p><em>Desirable:</em> arborizing/plexiform capillary-like vessels.</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 479,
    "contributions": [
      {
        "pkcontributionId": 106358,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 479,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 106359,
        "bookId": 44,
        "chapterId": 508,
        "headingId": 480,
        "headingText": "\r\n<p>No local recurrence has been reported in children.</p>",
        "timestamp": "2023-03-15T14:43:35"
      }
    ],

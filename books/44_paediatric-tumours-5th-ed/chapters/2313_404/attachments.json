    "title": "<p>Diagnostic criteria for multinodular and vacuolating neuronal tumour</p>",
    "legend": "",
    "source": "",
    "copyright": "Not necessary",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 645.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 645.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><span style=\" \">Multinodularity</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 645.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 645.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><span style=\" \">Neuronal cytological features or tumour cell immunoreactivity for synaptophysin, HuC/HuD, or non-phosphorylated 200-kDa NFP</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 645.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 645.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><span style=\" \">Absence of mitotic activity</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 645.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 645.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><span style=\" \">Tumour cell&nbsp;/ matrix vacuolation (but may be minimal)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 10.65pt;\">\r\n<td style=\"width: 645.0pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.65pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 22.5pt;\">\r\n<td style=\"width: 645.0pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.5pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><span style=\" \">Immunoreactivity for OLIG2 and internexin&nbsp;A</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 22.5pt;\">\r\n<td style=\"width: 645.0pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.5pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><span style=\" \">Absence of NeuN or chromogranin expression</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 22.5pt;\">\r\n<td style=\"width: 645.0pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.5pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><span style=\" \">MAPK pathway&ndash;activating abnormalities</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

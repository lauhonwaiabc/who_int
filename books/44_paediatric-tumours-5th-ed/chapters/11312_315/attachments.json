  {
    "pkattachmentId": 51410,
    "bookid": 44,
    "chapterId": 315,
    "fileId": 19268,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Thyroid oncogene, risk of invasive disease, and anticipated surgical approach in paediatric papillary thyroid carcinoma (modified from Bauer 2019 {31361657})</p>",
    "legend": "",
    "source": "Andrew J. Bauer",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 609.55pt; border-collapse: collapse;\" border=\"0\" width=\"813\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 7.0cm; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"265\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Point mutation or oncogene fusion</span></strong></p>\r\n</td>\r\n<td style=\"width: 191.4pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"255\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Increased risk of DTC with invasive disease?</span></strong></p>\r\n</td>\r\n<td style=\"width: 219.7pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Surgical approach</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 14.45pt;\">\r\n<td style=\"width: 7.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.45pt;\" width=\"265\">\r\n<p class=\"TableText\"><em>BRAF</em> p.V600E</p>\r\n</td>\r\n<td style=\"width: 191.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.45pt;\" width=\"255\">\r\n<p class=\"TableText\">Yes</p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.45pt;\" rowspan=\"6\" width=\"293\">\r\n<p class=\"TableText\">Total thyroidectomy with central neck lymph node dissection; lateral neck lymph node dissection based on clinical findings and FNAB confirmation of metastasis</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 14.3pt;\">\r\n<td style=\"width: 7.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.3pt;\" width=\"265\">\r\n<p class=\"TableText\"><em>RET</em>/PTC</p>\r\n</td>\r\n<td style=\"width: 191.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.3pt;\" width=\"255\">\r\n<p class=\"TableText\">Yes</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 14.3pt;\">\r\n<td style=\"width: 7.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.3pt;\" width=\"265\">\r\n<p class=\"TableText\">NTRK fusion</p>\r\n</td>\r\n<td style=\"width: 191.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.3pt;\" width=\"255\">\r\n<p class=\"TableText\">Yes</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 14.3pt;\">\r\n<td style=\"width: 7.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.3pt;\" width=\"265\">\r\n<p class=\"TableText\"><em>BRAF</em> fusion</p>\r\n</td>\r\n<td style=\"width: 191.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.3pt;\" width=\"255\">\r\n<p class=\"TableText\">Yes (limited data)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 14.3pt;\">\r\n<td style=\"width: 7.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.3pt;\" width=\"265\">\r\n<p class=\"TableText\"><em>ALK</em> fusion</p>\r\n</td>\r\n<td style=\"width: 191.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.3pt;\" width=\"255\">\r\n<p class=\"TableText\">Yes (limited data)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 14.3pt;\">\r\n<td style=\"width: 7.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.3pt;\" width=\"265\">\r\n<p class=\"TableText\"><em>TERT</em>&nbsp;+ additional mutation</p>\r\n</td>\r\n<td style=\"width: 191.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.3pt;\" width=\"255\">\r\n<p class=\"TableText\">No data in paediatrics</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 7.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"265\">\r\n<p class=\"TableText\"><em><span style=\"color: black;\">RAS</span></em><span style=\"color: black;\">, <em>PTEN</em>, <em>DICER1</em>, <em>PAX8</em>::<em>PPARG</em></span></p>\r\n</td>\r\n<td style=\"width: 191.4pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"255\">\r\n<p class=\"TableText\"><span style=\"color: black;\">No (lower risk of invasive disease)</span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Lobectomy</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">Consider completion thyroidectomy if invasive features on histology</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 7.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" width=\"265\">\r\n<p class=\"TableText\"><em>TSHR</em></p>\r\n</td>\r\n<td style=\"width: 191.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" width=\"255\">\r\n<p class=\"TableText\">No/minimal</p>\r\n</td>\r\n<td style=\"width: 219.7pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" rowspan=\"3\" width=\"293\">\r\n<p class=\"TableText\">Surveillance or definitive treatment if associated with autonomous function and no evidence of invasive behaviour</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 17.1pt;\">\r\n<td style=\"width: 7.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.1pt;\" width=\"265\">\r\n<p class=\"TableText\"><em>THADA</em></p>\r\n</td>\r\n<td style=\"width: 191.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.1pt;\" width=\"255\">\r\n<p class=\"TableText\">No</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 17.1pt;\">\r\n<td style=\"width: 7.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.1pt;\" width=\"265\">\r\n<p class=\"TableText\"><em>GNAS</em></p>\r\n</td>\r\n<td style=\"width: 191.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.1pt;\" width=\"255\">\r\n<p class=\"TableText\">No</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 11.2pt;\">\r\n<td style=\"width: 7.0cm; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 11.2pt;\" width=\"265\">\r\n<p class=\"TableText\"><em><span style=\"color: black;\">AKT1</span></em><span style=\"color: black;\">, <em>CTNNB1</em>, <em>EIF1AX</em>, and others</span></p>\r\n</td>\r\n<td style=\"width: 191.4pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 11.2pt;\" width=\"255\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Unknown </span></p>\r\n</td>\r\n<td style=\"width: 219.7pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 11.2pt;\" width=\"293\">\r\n<p class=\"TableText\"><span style=\"color: black;\">No specific recommendation</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\"><span class=\"TableTextChar\">DTC, differentiated thyroid cancer.</span></p>",

  },
  {
    "pkattachmentId": 49731,
    "bookid": 44,
    "chapterId": 138,
    "fileId": 18617,
    "type": "Figure",
    "diagnosis": "Grossing of an eye with retinoblastoma",
    "title": "",
    "legend": "After obtaining the superior calotte (seen to the left) through an anterior&ndash;posterior cut in this right eye, the remainder of the eye shows the optic nerve intact just under the plane of the section.",
    "source": "Patricia Chevez-Barrios",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/138/18617.jpg",

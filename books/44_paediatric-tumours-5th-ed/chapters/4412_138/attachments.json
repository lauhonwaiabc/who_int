  {
    "pkattachmentId": 49729,
    "bookid": 44,
    "chapterId": 138,
    "fileId": 18615,
    "type": "Figure",
    "diagnosis": "Retinoblastoma",
    "title": "",
    "legend": "Vitreous seeds in endophytic retinoblastoma. Sphere-type retinoblastoma tumour seeds show central bright white cores with a translucent solid periphery. In between the spheres there are areas of dust-type seeds. These seeds are in the anterior vitreous in front of the ciliary body pars plicata.",
    "source": "Patricia Chevez-Barrios",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/138/18615.jpg",

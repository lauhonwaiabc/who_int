  },
  {
    "pkattachmentId": 49730,
    "bookid": 44,
    "chapterId": 138,
    "fileId": 18616,
    "type": "Figure",
    "diagnosis": "Retinoblastoma",
    "title": "",
    "legend": "Extensively necrotic retinoblastoma. The intraocular tissues and tumour show extensive necrosis with remote haemorrhage and condensation bands of vitreous with tumour. The retina and tumour vessels are engorged. Necrotic debris is present in the anterior chamber.",
    "source": "Patricia Chevez-Barrios",
    "copyright": "",

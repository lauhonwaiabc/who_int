  },
  {
    "pkattachmentId": 49732,
    "bookid": 44,
    "chapterId": 138,
    "fileId": 18618,
    "type": "Figure",
    "diagnosis": "Grossing of an eye with retinoblastoma",
    "title": "",
    "legend": "Each calotte (cap) obtained is further sectioned in an anterior&ndash;posterior direction to be submitted on edge for histological sectioning.",
    "source": "Patricia Chevez-Barrios",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/138/18618.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/138/thumb_18618.jpg"
  },
  {
    "pkattachmentId": 49733,
    "bookid": 44,
    "chapterId": 138,
    "fileId": 18619,
    "type": "Figure",
    "diagnosis": "Grossing of an eye with retinoblastoma",
    "title": "",
    "legend": "The entire eye with the tumour is submitted in three tall cassettes. The pupil&ndash;optic nerve section and the two calottes (on edge to allow the examination of most of the choroidal surface) are seen in these cassettes. The cross-section of the optic nerve margin should be submitted in a separate cassette.",
    "source": "Patricia Chevez-Barrios",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/138/18619.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/138/thumb_18619.jpg"
  },
  {
    "pkattachmentId": 49734,
    "bookid": 44,
    "chapterId": 138,
    "fileId": 18621,
    "type": "Figure",
    "diagnosis": "Retinoblastoma",
    "title": "",
    "legend": "Indeterminate growth pattern and massive choroidal invasion. This retinoblastoma is mostly exophytic but there is diffuse central obliteration of the vitreous cavity showing areas of haemorrhage (inferior left) and central calcification. There is massive replacement of the inferior choroid around the optic nerve (15&nbsp;mm at the base) by the tumour.",
    "source": "Patricia Chevez-Barrios",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/138/18621.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/138/thumb_18621.jpg"
  },
  {
    "pkattachmentId": 49735,
    "bookid": 44,
    "chapterId": 138,
    "fileId": 18622,
    "type": "Figure",
    "diagnosis": "Retinoblastoma ",
    "title": "",
    "legend": "Postlaminar optic nerve invasion. This retinoblastoma with an indeterminate growth pattern shows basophilic viable tumour surrounding vessels and the geographical eosinophilic necrosis with darkly basophilic dystrophic calcifications characteristic of retinoblastoma. The optic nerve shows post&ndash;lamina cribrosa (eosinophilic collagenous layer) invasion with bulbous expansion of the orbital portion of the nerve.",
    "source": "Patricia Chevez-Barrios",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/138/18622.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/138/thumb_18622.jpg"
  },
  {
    "pkattachmentId": 49736,
    "bookid": 44,
    "chapterId": 138,
    "fileId": 18623,
    "type": "Figure",
    "diagnosis": "Retinoblastoma ",
    "title": "",
    "legend": "Exophytic retinoblastoma with perivascular tumour sleeves and DNA globules. Subretinal proteinaceous PAS-positive exudate is associated with the exophytic retinoblastoma. The viable tumour surrounds the vessels with adjacent areas of necrosis. There are dark basophilic DNA globules seen at the rim of the tumour and in the PAS-positive exudate.",
    "source": "Patricia Chevez-Barrios",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/138/18623.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/138/thumb_18623.jpg"
  },

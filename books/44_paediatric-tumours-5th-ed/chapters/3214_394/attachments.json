    "title": "<p>Diagnostic criteria for infant-type hemispheric glioma</p>",
    "legend": "",
    "source": "",
    "copyright": "Not necessary",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"background: #DAEEF3; border-collapse: collapse;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 645.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 645.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">Cellular astrocytoma</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 645.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 645.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">Presentation in early childhood</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 645.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 645.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">Cerebral hemispheric location</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 645.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 36.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"42\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 608.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"666\">\r\n<p class=\"TableText\">Presence of a typical receptor tyrosine kinase abnormality (e.g. fusion in an NTRK family gene or in <em>ROS1</em>, <em>MET1</em>, or <em>ALK</em>)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 36.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"42\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 608.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"666\">\r\n<p class=\"TableText\"><strong>OR</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 36.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"42\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 608.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"666\">\r\n<p class=\"TableText\">Methylation profile aligned with infant-type hemispheric glioma</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

  {
    "pkattachmentId": 51454,
    "bookid": 44,
    "chapterId": 80,
    "fileId": 22332,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Molecular alterations and their prevalence in pilocytic astrocytomas</p>",
    "legend": "",
    "source": "",
    "copyright": "Published in: Louis DN, Ohgaki H, Wiestler OD, et al., editors. WHO classification of tumours of the central nervous system. Lyon (France): International Agency for Research on Cancer; 2016. (WHO classification of tumours series, 4th rev. ed.; vol. 1). https://publications.iarc.fr/543. and Adapted from: Collins VP, Jones DT, Giannini C. Pilocytic astrocytoma: pathology, molecular mechanisms and markers. Acta Neuropathol. 2015 Jun;129(6):775&ndash;88. PMID:25792358",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 697.9pt; border-collapse: collapse; \" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 1.0pt;\">\r\n<td style=\"width: 144.0pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong>Genetic alteration</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>% of tumours</strong></p>\r\n</td>\r\n<td style=\"width: 354.95pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"473\">\r\n<p class=\"TableText\"><strong>Prevalence</strong></p>\r\n</td>\r\n<td style=\"width: 116.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"155\">\r\n<p class=\"TableText\"><strong>References</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 34.25pt;\">\r\n<td style=\"width: 144.0pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 34.25pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong><em>KIAA1549</em>::<em>BRAF</em> fusion</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 34.25pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&gt;&nbsp;60%</p>\r\n</td>\r\n<td style=\"width: 354.95pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 34.25pt;\" width=\"473\">\r\n<p class=\"TableText\">Common, particularly cerebellar; rare in other tumour forms except diffuse leptomeningeal glioneuronal tumour</p>\r\n</td>\r\n<td style=\"width: 116.15pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 34.25pt;\" width=\"155\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{18974108; 19016743}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 1.0pt;\">\r\n<td style=\"width: 144.0pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong>Other <em>BRAF</em> fusions</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&lt;&nbsp;5%</p>\r\n</td>\r\n<td style=\"width: 354.95pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"473\">\r\n<p class=\"TableText\">Occasional; very rare in other entities</p>\r\n</td>\r\n<td style=\"width: 116.15pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"155\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{29141672}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 1.0pt;\">\r\n<td style=\"width: 144.0pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong><em>BRAF</em> mutations (especially p.V600E)</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">~5&ndash;10%</p>\r\n</td>\r\n<td style=\"width: 354.95pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"473\">\r\n<p class=\"TableText\">Occasional, mainly supratentorial; also in many other glial and glioneuronal tumours</p>\r\n</td>\r\n<td style=\"width: 116.15pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"155\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{21274720; 19363522}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 1.0pt;\">\r\n<td style=\"width: 144.0pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong><em>NF1</em> mutation</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">~10&ndash;15%</p>\r\n</td>\r\n<td style=\"width: 354.95pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"473\">\r\n<p class=\"TableText\">Typically germline; common with optic pathway tumours</p>\r\n</td>\r\n<td style=\"width: 116.15pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"155\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{10931370; 23222849}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 1.0pt;\">\r\n<td style=\"width: 144.0pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong><em>FGFR1</em> mutation</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&lt;&nbsp;5%</p>\r\n</td>\r\n<td style=\"width: 354.95pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"473\">\r\n<p class=\"TableText\">Found mainly in midline tumours; also observed in other low-grade gliomas</p>\r\n</td>\r\n<td style=\"width: 116.15pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"155\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{23817572; 31673897; 31729570}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 1.0pt;\">\r\n<td style=\"width: 144.0pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong><em>FGFR1</em> fusions (especially <em>FGFR1</em>::<em>TACC1</em>)</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&lt;&nbsp;5%</p>\r\n</td>\r\n<td style=\"width: 354.95pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"473\">\r\n<p class=\"TableText\"><em>FGFR1</em>::<em>TACC1</em> fusion more common; also observed in other low-grade gliomas</p>\r\n</td>\r\n<td style=\"width: 116.15pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"155\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{23817572; 31729570}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 1.0pt;\">\r\n<td style=\"width: 144.0pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong>NTRK family fusions</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">~2%</p>\r\n</td>\r\n<td style=\"width: 354.95pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"473\">\r\n<p class=\"TableText\">Rare; also observed in other glial/glioneuronal tumours</p>\r\n</td>\r\n<td style=\"width: 116.15pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"155\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{23817572; 32082673}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 1.0pt;\">\r\n<td style=\"width: 144.0pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong><em>KRAS</em> mutation</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Single cases</p>\r\n</td>\r\n<td style=\"width: 354.95pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"473\">\r\n<p class=\"TableText\">Very rare in pilocytic astrocytoma; extremely rare in other entities</p>\r\n</td>\r\n<td style=\"width: 116.15pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"155\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{16247081; 17712732}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 1.0pt;\">\r\n<td style=\"width: 144.0pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong><em>RAF1</em> fusion</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Single cases</p>\r\n</td>\r\n<td style=\"width: 354.95pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"473\">\r\n<p class=\"TableText\">Very rare in pilocytic astrocytoma; extremely rare in other entities (with the possible exception of pleomorphic xanthoastrocytoma)</p>\r\n</td>\r\n<td style=\"width: 116.15pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"155\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{19363522; 19373855; 27810072}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 1.0pt;\">\r\n<td style=\"width: 144.0pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong><em>ROS1</em> fusions</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Single cases</p>\r\n</td>\r\n<td style=\"width: 354.95pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"473\">\r\n<p class=\"TableText\">Very rare in pilocytic astrocytoma; more common in infantile hemispheric glioma; extremely rare in other entities</p>\r\n</td>\r\n<td style=\"width: 116.15pt; background: #DAEEF3; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"155\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{31626289; 32289278}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 1.0pt;\">\r\n<td style=\"width: 144.0pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"192\">\r\n<p class=\"TableText\"><strong>Other alterations (of <em>MET</em>, <em>RET</em>, etc.)</strong></p>\r\n</td>\r\n<td style=\"width: 82.8pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"110\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Single cases</p>\r\n</td>\r\n<td style=\"width: 354.95pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"473\">\r\n<p class=\"TableText\">Very rare in pilocytic astrocytoma; frequency in other entities not determined (probably extremely rare)</p>\r\n</td>\r\n<td style=\"width: 116.15pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 4.0pt 4.0pt 4.0pt 4.0pt; height: 1.0pt;\" width=\"155\">\r\n<p class=\"TableText\"><span class=\"Ref-PMID\">{32289278}</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

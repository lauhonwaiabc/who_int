[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 107538,
        "bookId": 44,
        "chapterId": 265,
        "headingId": 466,
        "headingText": "\r\n<p>Juvenile granulosa cell tumour (JGCT) is a sex cord tumour composed of primitive-appearing granulosa cells arranged in intermixed solid and follicular patterns.</p>\r\n",
        "timestamp": "2023-03-09T11:53:57"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

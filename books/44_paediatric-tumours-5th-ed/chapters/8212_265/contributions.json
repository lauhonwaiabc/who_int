        "headingId": 479,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-09T11:53:57"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 107554,
        "bookId": 44,
        "chapterId": 265,
        "headingId": 480,
        "headingText": "\r\n<p>Patients with tumours confined to the ovary have an excellent prognosis with simple oophorectomy. Rupture, positive cytology, and extraovarian spread increase the risk of recurrence (most often within the first 3&nbsp;years) {6465418}.</p>",
        "timestamp": "2023-03-09T11:53:57"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
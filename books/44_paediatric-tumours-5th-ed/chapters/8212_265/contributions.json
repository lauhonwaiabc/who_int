  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 107552,
        "bookId": 44,
        "chapterId": 265,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> primitive granulosa cells with diffuse or nodular growth punctuated by irregularly shaped follicles.</p>\r\n<p><em>Desirable:</em> positive staining for sex cord markers.</p>\r\n",
        "timestamp": "2023-03-09T11:53:57"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,

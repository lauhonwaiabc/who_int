    "contributions": [
      {
        "pkcontributionId": 107556,
        "bookId": 44,
        "chapterId": 266,
        "headingId": 467,
        "headingText": "\r\n<p>8623/1 Sex cord tumour with annular tubules</p>\r\n",
        "timestamp": "2023-03-09T11:54:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 705,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 468,
    "contributions": [
      {
        "pkcontributionId": 107557,
        "bookId": 44,
        "chapterId": 266,
        "headingId": 468,
        "headingText": "\r\n<p>2F76 &amp; XH5BV8 Neoplasms of uncertain behaviour of female genital organs &amp; Sex cord tumour with annular tubules</p>\r\n",
        "timestamp": "2023-03-09T11:54:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 706,
    "bookid": 44,

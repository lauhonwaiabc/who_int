[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 107555,
        "bookId": 44,
        "chapterId": 266,
        "headingId": 466,
        "headingText": "\r\n<p>Sex cord tumour with annular tubules (SCTAT) is a sex cord tumour with sharply circumscribed nests composed of ring-like tubules that encircle basement membrane&ndash;like material.</p>\r\n",
        "timestamp": "2023-03-09T11:54:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 704,
    "bookid": 44,
    "headingType": 2,

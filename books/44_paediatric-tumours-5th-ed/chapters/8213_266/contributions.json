      {
        "pkcontributionId": 107568,
        "bookId": 44,
        "chapterId": 266,
        "headingId": 478,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-03-09T11:54:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 107569,
        "bookId": 44,
        "chapterId": 266,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> simple or complex tubules that encircle basement membrane&ndash;like material; tall cells with pale cytoplasm and round nuclei with an antipodal distribution.</p>\r\n<p><em>Desirable:</em> sex cord marker positivity.</p>\r\n",
        "timestamp": "2023-03-09T11:54:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 479,
    "contributions": [
      {
        "pkcontributionId": 107570,
        "bookId": 44,
        "chapterId": 266,
        "headingId": 479,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-09T11:54:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 107571,
        "bookId": 44,
        "chapterId": 266,
        "headingId": 480,
        "headingText": "\r\n<p>Syndrome-associated tumours are typically benign, whereas as many as 20% of non-syndromic cases exhibit extraovarian spread {5429475; 7104978}.</p>",
        "timestamp": "2023-03-09T11:54:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
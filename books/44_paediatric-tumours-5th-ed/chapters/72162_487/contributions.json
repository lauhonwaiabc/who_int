[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 107349,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 466,
        "headingText": "\r\n<p>Metanephric adenofibroma is a rare biphasic neoplasm that combines a spindle cell component that is morphologically identical to metanephric stromal tumour with an epithelial component that is morphologically identical to metanephric adenoma.</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 704,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 467,
    "contributions": [
      {
        "pkcontributionId": 107350,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 467,
        "headingText": "\r\n<p>9013/0 Metanephric adenofibroma</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 705,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 468,
    "contributions": [
      {
        "pkcontributionId": 107351,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 468,
        "headingText": "\r\n<p>2F35 &amp; XH7ZU2 Benign neoplasm of urinary organs &amp; Metanephric adenofibroma</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 706,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 469,
    "contributions": [
      {
        "pkcontributionId": 107352,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 469,
        "headingText": "\r\n<p><em>Not recommended:</em> nephrogenic adenofibroma.</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 707,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 470,
    "contributions": [
      {
        "pkcontributionId": 107353,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 470,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 708,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 471,
    "contributions": [
      {
        "pkcontributionId": 107354,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 471,
        "headingText": "\r\n<p>Kidney</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 709,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 472,
    "contributions": [
      {
        "pkcontributionId": 107355,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 472,
        "headingText": "\r\n<p>Patients with metanephric adenofibroma presented with polycythaemia in 4&nbsp;of 14&nbsp;cases and with haematuria in 3&nbsp;of 14&nbsp;cases {11257617; 1373578; 23587517; 20735912}.</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 710,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 473,
    "contributions": [
      {
        "pkcontributionId": 107356,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 473,
        "headingText": "\r\n<p>Fewer than 30&nbsp;cases have been reported. Patients with metanephric adenofibroma have ranged in age from 13&nbsp;months to 36&nbsp;years (median: 81&nbsp;months) {11257617; 1373578}.</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 711,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 474,
    "contributions": [
      {
        "pkcontributionId": 107357,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 474,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 712,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 475,
    "contributions": [
      {
        "pkcontributionId": 107358,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 475,
        "headingText": "\r\n<p>All tumours have so far contained <em>BRAF</em> p.V600E mutations.</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 719,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 482,
    "contributions": [
      {
        "pkcontributionId": 107359,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 482,
        "headingText": "\r\n<p>Metanephric adenofibromas are typically solitary, tan, partially cystic masses with indistinct borders. The mean diameter is 40&nbsp;mm. Many of these lesions have been centred on the renal pelvis, accounting for the presentation with haematuria.</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 713,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 476,
    "contributions": [
      {
        "pkcontributionId": 107360,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 476,
        "headingText": "\r\n<p>The relative amounts of the spindle cell and epithelial components vary. The border of the tumour with the kidney is typically irregular and the spindle cell component entraps tubules and glomeruli. Like that of metanephric stromal tumour, the stroma of metanephric adenofibroma frequently labels for CD34. The epithelial elements label similarly to metanephric adenoma.</p>\r\n<p>Composite cases in which epithelial mitotic activity, nephroblastoma, or papillary renal cell carcinoma are associated with metanephric adenofibroma have been reported {11257617; 21711207}.</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 714,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 477,
    "contributions": [
      {
        "pkcontributionId": 107361,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 477,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 715,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 478,
    "contributions": [
      {
        "pkcontributionId": 107362,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 478,
        "headingText": "\r\n<p>All metanephric adenofibromas tested to date have harboured the <em>BRAF</em> p.V600E mutations that are characteristic of the other metanephric neoplasms, metanephric stromal tumour and metanephric adenoma {26796506; 26274032}. One composite metanephric adenofibroma&ndash;papillary renal cell carcinoma had the same <em>BRAF</em> p.V600E mutation in both the adenoma and carcinoma components {26014474}.</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 107363,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> a biphasic stromal-epithelial renal neoplasm with areas identical to metanephric stromal tumour and metanephric adenoma.</p>\r\n<p><em>Desirable:</em> <em>BRAF</em> p.V600E mutations.</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 479,
    "contributions": [
      {
        "pkcontributionId": 107364,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 479,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 107365,
        "bookId": 44,
        "chapterId": 487,
        "headingId": 480,
        "headingText": "\r\n<p>All reported metanephric adenofibromas have had a benign course, with no reports of metastases. One local recurrence has been reported {21683990}. Excision is adequate therapy. Rare patients have experienced morbidity or died from the manifestations of extrarenal angiodysplasia, apparently induced by metanephric stromal tumour.</p>",
        "timestamp": "2023-03-09T11:01:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
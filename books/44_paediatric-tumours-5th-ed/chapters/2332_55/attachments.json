ing: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 38.85pt; padding: 0cm 0cm 0cm 0cm;\" valign=\"top\" width=\"52\">\r\n<p class=\"TableText\" style=\"margin-left: 5.5pt;\"><strong style=\"\">IIIB</strong></p>\r\n</td>\r\n<td style=\"width: 472.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"630\">\r\n<p class=\"TableText\" style=\"margin-left: -.4pt;\">T4<span style=\"\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>N0&ndash;2<span style=\"\">&nbsp;&nbsp; </span>M0<span style=\"\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>B1</p>\r\n</td>\r\n<td style=\"width: 37.2pt; padding: 0cm 0cm 0cm 0cm;\" valign=\"top\" width=\"50\">\r\n<p class=\"TableText\" style=\"margin-left: 5.2pt;\"><strong style=\"\">&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 85.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"115\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 63.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 38.85pt; padding: 0cm 0cm 0cm 0cm;\" valign=\"top\" width=\"52\">\r\n<p class=\"TableText\" style=\"margin-left: 5.5pt;\"><strong style=\"\">IVA1</strong></p>\r\n</td>\r\n<td style=\"width: 472.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"630\">\r\n<p class=\"TableText\" style=\"margin-left: -.4pt;\">T1&ndash;4<span style=\"\">&nbsp;&nbsp;&nbsp; </span>N0&ndash;2<span style=\"\">&nbsp;&nbsp; </span>M0<span style=\"\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>B0</p>\r\n</td>\r\n<td style=\"width: 37.2pt; padding: 0cm 0cm 0cm 0cm;\" valign=\"top\" width=\"50\">\r\n<p class=\"TableText\" style=\"margin-left: 5.2pt;\"><strong style=\"\">&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 85.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"115\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 63.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 38.85pt; padding: 0cm 0cm 0cm 0cm;\" valign=\"top\" width=\"52\">\r\n<p class=\"TableText\" style=\"margin-left: 5.5pt;\"><strong style=\"\">IVA2</strong></p>\r\n</td>\r\n<td style=\"width: 472.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"630\">\r\n<p class=\"TableText\" style=\"margin-left: -.4pt;\">T1&ndash;4<span style=\"\">&nbsp;&nbsp;&nbsp; </span>N3<span style=\"\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>M0<span style=\"\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>B0&ndash;2</p>\r\n</td>\r\n<td style=\"width: 37.2pt; padding: 0cm 0cm 0cm 0cm;\" valign=\"top\" width=\"50\">\r\n<p class=\"TableText\" style=\"margin-left: 5.2pt;\"><strong style=\"\">&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 85.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"115\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 63.8pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"85\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 38.85pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 0cm 0cm 0cm;\" valign=\"top\" width=\"52\">\r\n<p class=\"TableText\" style=\"margin-left: 5.5pt;\"><strong style=\"\">IVB</strong></p>\r\n</td>\r\n<td style=\"width: 472.15pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"630\">\r\n<p class=\"TableText\">T1&ndash;4<span style=\"\">&nbsp;&nbsp;&nbsp; </span>N0&ndash;3<span style=\"\">&nbsp;&nbsp; </span>M1<span style=\"\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>B0&ndash;3</p>\r\n</td>\r\n<td style=\"width: 37.2pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 0cm 0cm 0cm;\" valign=\"top\" width=\"50\">\r\n<p class=\"TableText\" style=\"margin-left: 5.2pt;\"><strong style=\"\">&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 85.9pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"115\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">Notes:</p>\r\n<p class=\"TableText\">&bull; For skin, &ldquo;patch&rdquo; means a skin lesion of any size with no significant elevation or induration; the presence or absence of hypopigmentation, hyperpigmentation, scale, crusting, and/or poikiloderma should be noted.</p>\r\n<p class=\"TableText\">&bull; For skin, &ldquo;plaque&rdquo; means a skin lesion of any size with elevation or induration; the presence or absence of ulceration, scale, crusting, and/or poikiloderma should be noted; histological features such as folliculotropism, large-cell transformation, and CD30 expression should be noted.</p>\r\n<p class=\"TableText\">&bull; For skin, &ldquo;tumour&rdquo; means a solid or nodular lesion &ge;&nbsp;10&nbsp;mm in diameter with evidence of depth and/or vertical growth; the total number and volume of lesions, largest lesion size, and body region involved should be noted; also note whether there is histological evidence of large-cell transformation; phenotyping for CD30 is encouraged.</p>\r\n<p class=\"TableText\">&bull; For node, &ldquo;abnormal peripheral lymph node&rdquo; means a palpable lymph node that is firm, irregular, clustered, fixed, and/or &ge;&nbsp;15&nbsp;mm in diameter.</p>\r\n<p class=\"TableText\">&bull; Node groups examined: cervical, supraclavicular, epitrochlear, axillary, and inguinal; central nodes are not assessed unless used to establish N3 histopathologically.</p>\r\n<p class=\"TableText\">&bull; Visceral involvement of spleen and liver can be assessed by radiological imaging.</p>\r\n<p class=\"TableText\">&bull; For blood, S&eacute;zary cells are defined as lymphocytes with hyperconvoluted/cerebriform nuclei; if S&eacute;zary cells cannot be used to determine tumour burden for B2, then a positive monoclonal rearrangement of the TR gene can be used instead: (1)&nbsp;expanded CD4+ or CD3+ cells with a CD4:CD8 ratio of &ge;&nbsp;10, or (2) expanded CD4+ cells with abnormal immunophenotype including loss of CD7 or CD26.</p>\r\n<p class=\"TableText\">&bull; T-cell clones are identified by PCR or Southern blot analysis of the TR gene.</p>",

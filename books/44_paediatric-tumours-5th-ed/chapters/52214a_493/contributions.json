[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 105425,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 466,
        "headingText": "\r\n<p>Fibroma of tendon sheath (FOTS) is a benign fibroblastic/myofibroblastic, nodular, bland proliferation that attaches to tendon.</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 704,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 467,
    "contributions": [
      {
        "pkcontributionId": 105426,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 467,
        "headingText": "\r\n<p>8813/0 Fibroma of tendon sheath</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 705,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 468,
    "contributions": [
      {
        "pkcontributionId": 105427,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 468,
        "headingText": "\r\n<p>EE6Y &amp; XH0WB3 Other specified fibromatous disorders of skin and soft tissue &amp; Fibroma of tendon sheath</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 706,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 469,
    "contributions": [
      {
        "pkcontributionId": 105428,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 469,
        "headingText": "\r\n<p><em>Not recommended:</em> tenosynovial fibroma.</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 707,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 470,
    "contributions": [
      {
        "pkcontributionId": 105429,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 470,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 708,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 471,
    "contributions": [
      {
        "pkcontributionId": 105430,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 471,
        "headingText": "\r\n<p>FOTS usually occurs on the finger tendons (most commonly in the thumb, index finger, and middle finger) and rarely in the knee, elbow, or wrist {2299175; 32349463; 24366807; 30783711}.</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 709,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 472,
    "contributions": [
      {
        "pkcontributionId": 105431,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 472,
        "headingText": "\r\n<p>FOTS is a slow-growing, painless nodule, measuring &lt;&nbsp;30&nbsp;mm. FOTS may occasionally be multiple {22028571}.</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 710,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 473,
    "contributions": [
      {
        "pkcontributionId": 105432,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 473,
        "headingText": "\r\n<p>FOTS usually occurs in young or middle-aged adults, but cases in infants and children have been reported {2299175; 32349463; 24366807; 30783711; 91424; 1946077; 2729499}.</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 711,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 474,
    "contributions": [
      {
        "pkcontributionId": 105433,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 474,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 712,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 475,
    "contributions": [
      {
        "pkcontributionId": 105434,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 475,
        "headingText": "\r\n<p>Chromosome&nbsp;11q rearrangements have been identified in 2&nbsp;cases of FOTS {9639118; 25202108}. There are increasing reports of FOTS-like tumours that harbour genetic alterations of <em>USP6</em>, and these are probably better classified as nodular fasciitis {27125357; 32583473; 16434899}.</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 719,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 482,
    "contributions": [
      {
        "pkcontributionId": 105435,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 482,
        "headingText": "\r\n<p>FOTS has a lobular, tan-white cut surface.</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 713,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 476,
    "contributions": [
      {
        "pkcontributionId": 105436,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 476,
        "headingText": "\r\n<p>Histological examination of FOTS reveals a circumscribed arrangement of bland fibroblasts and myofibroblasts in a densely collagenous or hyalinized stroma. The cellularity is typically low. Characteristic slit-like blood vessels are often prominent at the periphery of the tumour {91424; 2729499}.</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 714,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 477,
    "contributions": [
      {
        "pkcontributionId": 105437,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 477,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 715,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 478,
    "contributions": [
      {
        "pkcontributionId": 105438,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 478,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 105439,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> a firm nodule consisting of a paucicellular proliferation of fibroblasts/myofibroblasts in a collagenous background with slit-like blood vessels, attached to tendon.</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 479,
    "contributions": [
      {
        "pkcontributionId": 105440,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 479,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 105441,
        "bookId": 44,
        "chapterId": 493,
        "headingId": 480,
        "headingText": "\r\n<p>FOTS is benign, but recurrences may occur in as many as 24% of patients {91424}.</p>",
        "timestamp": "2023-03-15T11:23:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
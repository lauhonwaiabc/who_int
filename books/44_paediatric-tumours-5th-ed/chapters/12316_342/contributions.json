        "chapterId": 342,
        "headingId": 478,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-10T14:08:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 108338,
        "bookId": 44,
        "chapterId": 342,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> a cyst and/or sinus lined by keratinizing stratified squamous epithelium with normal-appearing dermal appendages.</p>\r\n<p><em>Desirable:</em> a nasal pit with protruding hair; paediatric presentation.</p>\r\n",
        "timestamp": "2023-03-10T14:08:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 479,
    "contributions": [
      {
        "pkcontributionId": 108339,
        "bookId": 44,
        "chapterId": 342,
        "headingId": 479,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-10T14:08:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 108340,
        "bookId": 44,
        "chapterId": 342,
        "headingId": 480,
        "headingText": "\r\n<p>Recurrences are seen in about 10% of patients, more often in intracranial cases {12707196; 26891409}. Complications (wound infection, meningitis, cavernous sinus thrombosis) are uncommon {26891409}.</p>",
        "timestamp": "2023-03-10T14:08:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
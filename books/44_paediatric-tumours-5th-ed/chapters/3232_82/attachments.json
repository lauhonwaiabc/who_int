    "chapterId": 82,
    "fileId": 22368,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diagnostic criteria for pleomorphic xanthoastrocytoma</p>",
    "legend": "",
    "source": "",
    "copyright": "Not necessary",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"height: 14.25pt;\">\r\n<td style=\"width: 616.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 14.25pt;\">\r\n<td style=\"width: 616.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.25pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">An astrocytoma with pleomorphic tumour cells, including large multinucleated cells, spindle cells, xanthomatous (lipidized) cells, and eosinophilic granular bodies</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 16.1pt;\">\r\n<td style=\"width: 616.65pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong><em>Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 16.1pt;\">\r\n<td style=\"width: 616.65pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">Reticulin deposition</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 16.1pt;\">\r\n<td style=\"width: 616.65pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><em>BRAF</em> mutation or other MAPK pathway gene alterations, combined with homozygous deletion of <em>CDKN2A</em> and/or <em>CDKN2B</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 16.1pt;\">\r\n<td style=\"width: 616.65pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.1pt;\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">A DNA methylome profile of pleomorphic xanthoastrocytoma</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  }
]
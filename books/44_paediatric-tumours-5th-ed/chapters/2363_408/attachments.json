    "title": "<p>The most frequent HIV-associated lymphomas in children</p>",
    "legend": "",
    "source": "Konnie M. Hebeda",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 16.0pt;\">\r\n<td style=\"width: 205.8pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 4.5pt 0cm 4.5pt; height: 16.0pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Lymphoma type</strong></p>\r\n</td>\r\n<td style=\"width: 109.55pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 4.5pt 0cm 4.5pt; height: 16.0pt;\" width=\"146\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Relative <span style=\"\">frequency<sup>a</sup></span></strong></p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span class=\"Ref-PMID\"><span style=\"\">{24552745; 12746363; 22935659}</span></span></p>\r\n</td>\r\n<td style=\"width: 234.1pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.0pt;\" width=\"312\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Site</strong></p>\r\n</td>\r\n<td style=\"width: 153.85pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.0pt;\" width=\"205\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>References</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 16.0pt;\">\r\n<td style=\"width: 205.8pt; padding: 0cm 4.5pt 0cm 4.5pt; height: 16.0pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Burkitt lymphoma</strong></p>\r\n</td>\r\n<td style=\"width: 109.55pt; padding: 0cm 4.5pt 0cm 4.5pt; height: 16.0pt;\" width=\"146\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">38&ndash;67%</p>\r\n</td>\r\n<td style=\"width: 234.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.0pt;\" width=\"312\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Mainly extranodal (oral cavity, jaw, nasal sinus, gastrointestinal tract, liver, lung, testis, heart, CNS, subcutis, bone marrow)</p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Rarely: blood, body fluids, lymph node</p>\r\n</td>\r\n<td style=\"width: 153.85pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.0pt;\" width=\"205\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span class=\"Ref-PMID\">{32302884; 31516626; 18802952; 11587630; 23426001}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 205.8pt; background: #DAEEF3; padding: 0cm 4.5pt 0cm 4.5pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Diffuse large B-cell lymphoma</strong></p>\r\n</td>\r\n<td style=\"width: 109.55pt; background: #DAEEF3; padding: 0cm 4.5pt 0cm 4.5pt;\" width=\"146\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">22&ndash;38%</p>\r\n</td>\r\n<td style=\"width: 234.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"312\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Lymph node, liver, spleen, kidney, CNS, testis, bone</p>\r\n</td>\r\n<td style=\"width: 153.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"205\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span class=\"Ref-PMID\">{10889594}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 31.15pt;\">\r\n<td style=\"width: 205.8pt; padding: 0cm 4.5pt 0cm 4.5pt; height: 31.15pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Classic Hodgkin lymphoma</strong></p>\r\n</td>\r\n<td style=\"width: 109.55pt; padding: 0cm 4.5pt 0cm 4.5pt; height: 31.15pt;\" width=\"146\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">3&ndash;10%</p>\r\n</td>\r\n<td style=\"width: 234.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 31.15pt;\" width=\"312\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Lymph node</p>\r\n</td>\r\n<td style=\"width: 153.85pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 31.15pt;\" width=\"205\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span class=\"Ref-PMID\">{25252101}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 15.1pt;\">\r\n<td style=\"width: 205.8pt; background: #DAEEF3; padding: 0cm 4.5pt 0cm 4.5pt; height: 15.1pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>Polymorphic lymphoid proliferation </strong></p>\r\n</td>\r\n<td style=\"width: 109.55pt; background: #DAEEF3; padding: 0cm 4.5pt 0cm 4.5pt; height: 15.1pt;\" width=\"146\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&lt;&nbsp;5%</p>\r\n</td>\r\n<td style=\"width: 234.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.1pt;\" width=\"312\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Lymph node, extranodal (lung, CNS)</p>\r\n</td>\r\n<td style=\"width: 153.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.1pt;\" width=\"205\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span class=\"Ref-PMID\">{9923843; 10328088; 12604885}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 15.1pt;\">\r\n<td style=\"width: 205.8pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 4.5pt 0cm 4.5pt; height: 15.1pt;\" width=\"274\">\r\n<p class=\"TableText\"><strong>MALT lymphoma</strong></p>\r\n</td>\r\n<td style=\"width: 109.55pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 4.5pt 0cm 4.5pt; height: 15.1pt;\" width=\"146\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">7%</p>\r\n</td>\r\n<td style=\"width: 234.1pt; border: none; border-bottom: solid black 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 15.1pt;\" width=\"312\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Lung, parotid gland</p>\r\n</td>\r\n<td style=\"width: 153.85pt; border: 
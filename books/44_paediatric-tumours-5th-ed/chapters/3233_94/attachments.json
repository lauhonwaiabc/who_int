    "copyright": "Blümcke I",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 222.5pt; border-collapse: collapse; \" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" height: 14.5pt;\">\r\n<td style=\"width: 89.85pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"120\">\r\n<p class=\"TableText\"><strong>Localization</strong></p>\r\n</td>\r\n<td style=\"width: 70.5pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"94\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\"><strong>Total cases</strong></p>\r\n</td>\r\n<td style=\"width: 62.15pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"83\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\"><strong>Relative frequency</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.5pt;\">\r\n<td style=\"width: 89.85pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"120\">\r\n<p class=\"TableText\"><strong style=\"\">Temporal</strong></p>\r\n</td>\r\n<td style=\"width: 70.5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"94\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">604</p>\r\n</td>\r\n<td style=\"width: 62.15pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"83\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">77%</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.5pt;\">\r\n<td style=\"width: 89.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"120\">\r\n<p class=\"TableText\"><strong style=\"\">Frontal</strong></p>\r\n</td>\r\n<td style=\"width: 70.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"94\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">58</p>\r\n</td>\r\n<td style=\"width: 62.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"83\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">7%</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.5pt;\">\r\n<td style=\"width: 89.85pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"120\">\r\n<p class=\"TableText\"><strong style=\"\">Parietal</strong></p>\r\n</td>\r\n<td style=\"width: 70.5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"94\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">24</p>\r\n</td>\r\n<td style=\"width: 62.15pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"83\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">3%</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.5pt;\">\r\n<td style=\"width: 89.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"120\">\r\n<p class=\"TableText\"><strong style=\"\">Occipital</strong></p>\r\n</td>\r\n<td style=\"width: 70.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"94\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">22</p>\r\n</td>\r\n<td style=\"width: 62.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"83\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">3%</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.5pt;\">\r\n<td style=\"width: 89.85pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"120\">\r\n<p class=\"TableText\"><strong style=\"\">Multiple lobes</strong></p>\r\n</td>\r\n<td style=\"width: 70.5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"94\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">63</p>\r\n</td>\r\n<td style=\"width: 62.15pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"83\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">8%</p>\r\n</td>\r\n</tr>\r\n<tr style=\" height: 14.5pt;\">\r\n<td style=\"width: 89.85pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"120\">\r\n<p class=\"TableText\"><strong style=\"\">Other sites</strong></p>\r\n</td>\r\n<td style=\"width: 70.5pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"94\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">15</p>\r\n</td>\r\n<td style=\"width: 62.15pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 14.5pt;\" width=\"83\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">2%</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">Data from 786&nbsp;surgical specimens submitted to the German Neuropathology Reference <span style=\"\">Center</span> for Epilepsy Surgery.</p>",

  },
  {
    "pkattachmentId": 49366,
    "bookid": 44,
    "chapterId": 122,
    "fileId": 17849,
    "type": "Figure",
    "diagnosis": "Adamantinomatous craniopharyngioma",
    "title": "",
    "legend": "The cytologically bland epithelium is associated with wet keratin, also known as ghost cells&nbsp;&ndash; a term that underscores the fact that the faint outline of nuclei may still be visible on H&amp;E in the exfoliated cells from the tumour epithelium.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/122/17849.jpg",

  },
  {
    "pkattachmentId": 49370,
    "bookid": 44,
    "chapterId": 122,
    "fileId": 17854,
    "type": "Figure",
    "diagnosis": "Adamantinomatous craniopharyngioma",
    "title": "",
    "legend": "This 6-year-old girl presented with headache and vomiting, concern for hydrocephalus. Her neuroimaging studies showed a sellar/suprasellar mass, and biopsy proved adamantinomatous craniopharyngioma. Note the extensive calcification, which is typical in paediatric examples.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/122/17854.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/122/thumb_17854.jpg"
  },
  {
    "pkattachmentId": 49371,
    "bookid": 44,
    "chapterId": 122,
    "fileId": 17855,
    "type": "Figure",
    "diagnosis": "Adamantinomatous craniopharyngioma",
    "title": "",
    "legend": "The tumour in this 6-year-old girl was surrounded by intense piloid gliosis containing profuse numbers of eosinophilic sausage-shaped Rosenthal fibres. This should not be mistaken for coexistent pilocytic astrocytoma.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/122/17855.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/122/thumb_17855.jpg"
  },
  {
    "pkattachmentId": 49372,
    "bookid": 44,
    "chapterId": 122,
    "fileId": 17856,
    "type": "Figure",
    "diagnosis": "Adamantinomatous craniopharyngioma",
    "title": "",
    "legend": "This tumour from a 6-year-old girl shows all classic features of adamantinomatous craniopharyngioma: wet keratin, dystrophic calcification, cytologically bland epithelium, and adjacent piloid gliosis.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/122/17856.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/122/thumb_17856.jpg"
  },
  {
    "pkattachmentId": 49373,
    "bookid": 44,
    "chapterId": 122,
    "fileId": 17857,
    "type": "Figure",
    "diagnosis": "Adamantinomatous craniopharyngioma",
    "title": "",
    "legend": "Immunostaining for &beta;-catenin (here with light haematoxylin counterstain) shows that most of the epithelial cells composing the tumour manifest only cytoplasmic immunoreactivity in a largely membranous pattern; however, focally near the wet keratin and in whorls of cells, translocation of &beta;-catenin to the nucleus is paralleled by strong nuclear immunoreactivity. This irregular distribution of the nuclear &beta;-catenin immunostaining should be anticipated, especially in small samples, to avoid misdiagnosis of the adamantinomatous craniopharyngioma as either papillary craniopharyngioma or epidermoid cyst (neither of which shows nuclear &beta;-catenin).",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/122/17857.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/122/thumb_17857.jpg"
  },

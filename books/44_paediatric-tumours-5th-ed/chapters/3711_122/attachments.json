    "copyright": "Not necessary",
    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 16.0cm; background: #DAEEF3; border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><em>Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\">Tumour in the sellar region</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 16.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\">Squamous non-keratinizing epithelium, benign</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 16.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong>AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\">Stellate reticulum and/or wet keratin</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\"><strong><em>Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\">Nuclear immunoreactivity for &beta;-catenin</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\">Mutation in <em>CTNNB1</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 16.0cm; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"605\">\r\n<p class=\"TableText\">Absence of <em>BRAF</em> p.V600E mutation</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

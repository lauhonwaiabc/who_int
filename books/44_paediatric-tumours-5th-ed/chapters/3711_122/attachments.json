  },
  {
    "pkattachmentId": 49246,
    "bookid": 44,
    "chapterId": 122,
    "fileId": 17519,
    "type": "Figure",
    "diagnosis": "Adamantinomatous craniopharyngioma",
    "title": "",
    "legend": "Even though mutations in exon&nbsp;3 of <em>CTNNB1</em>, which encodes &beta;-catenin, are clonal and present across the neoplastic epithelium, &beta;-catenin protein accumulates in the nucleus of only a subset of cells, such as those present in epithelial whorls or surrounding wet keratin.",
    "source": "Bette K. Kleinschmidt-DeMasters",
    "copyright": "",

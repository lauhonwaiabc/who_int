    "fileId": 17528,
    "type": "Figure",
    "diagnosis": "Adamantinomatous craniopharyngioma",
    "title": "",
    "legend": "Solid and cystic mass with calcification, first diagnosed 4&nbsp;years earlier.",
    "source": "Sandro Santagata",
    "copyright": "",

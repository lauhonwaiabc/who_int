    "bookid": 44,
    "chapterId": 149,
    "fileId": 19593,
    "type": "Figure",
    "diagnosis": "Myositis ossificans",
    "title": "",
    "legend": "Primitive-appearing trabeculae of bone associated with osteoblasts and fascicles of spindle cells in a myxoid stroma.",
    "source": "Andrew E. Rosenberg",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/149/19593.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/149/thumb_19593.jpg"
  },
  {
    "pkattachmentId": 50196,
    "bookid": 44,
    "chapterId": 149,
    "fileId": 19594,
    "type": "Figure",
    "diagnosis": "Myositis ossificans",
    "title": "",
    "legend": "The central portion is composed of fascicles of spindle cells that have elongate nuclei, fine chromatin, conspicuous nucleoli, and eosinophilic cytoplasm. Typical mitoses are present and the stroma is myxoid.",
    "source": "Andrew E. Rosenberg",
    "copyright": "",

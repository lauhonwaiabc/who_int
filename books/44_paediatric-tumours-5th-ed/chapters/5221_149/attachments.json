  {
    "pkattachmentId": 50194,
    "bookid": 44,
    "chapterId": 149,
    "fileId": 19592,
    "type": "Figure",
    "diagnosis": "Myositis ossificans",
    "title": "",
    "legend": "The peripheral portion of the lesion is delineated by well-formed mineralized trabeculae of bone. Centrally the bone merges with unmineralized, broad, poorly formed interconnecting trabeculae that are rimmed by osteoblasts. The intertrabecular space is filled with spindle cells enmeshed in a myxoid stroma.",
    "source": "Andrew E. Rosenberg",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/149/19592.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/149/thumb_19592.jpg"
  },
  {

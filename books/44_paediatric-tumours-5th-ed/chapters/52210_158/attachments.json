    "title": "<p>Histological patterns of inflammatory myofibroblastic tumour</p>",
    "legend": "",
    "source": "Lea F. Surrey",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; \" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" page-break-inside: avoid; height: 34.5pt;\">\r\n<td style=\"width: 11.78%; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: .75pt 5.4pt .75pt 5.4pt; height: 34.5pt;\" width=\"11%\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">Pattern </span></strong><span class=\"Ref-PMID\">{7611533}</span></p>\r\n</td>\r\n<td style=\"width: 16.72%; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: .75pt 5.4pt .75pt 5.4pt; height: 34.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">Neoplastic cells</span></strong></p>\r\n</td>\r\n<td style=\"width: 16.72%; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: .75pt 5.4pt .75pt 5.4pt; height: 34.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">Stroma</span></strong></p>\r\n</td>\r\n<td style=\"width: 16.72%; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: .75pt 5.4pt .75pt 5.4pt; height: 34.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">Inflammatory infiltrate</span></strong></p>\r\n</td>\r\n<td style=\"width: 38.04%; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: .75pt 5.4pt .75pt 5.4pt; height: 34.5pt;\" width=\"38%\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">Differential diagnosis</span></strong> <span class=\"Ref-PMID\">{22372507; 22420727; 21297584}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 13.5pt;\">\r\n<td style=\"width: 11.78%; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"11%\">\r\n<p class=\"TableText\"><strong style=\"\">Hypercellular</strong></p>\r\n</td>\r\n<td style=\"width: 16.72%; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><span style=\"\">Compact fascicles of spindle cells</span></p>\r\n</td>\r\n<td style=\"width: 16.72%; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><span style=\"\">Collagenous and/or myxoid</span></p>\r\n</td>\r\n<td style=\"width: 16.72%; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><span style=\"\">Lymphocytes, plasma cells</span></p>\r\n</td>\r\n<td style=\"width: 38.04%; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"38%\">\r\n<p class=\"TableText\">Infections (e.g. atypical mycobacteria)</p>\r\n<p class=\"TableText\">Reactive myofibroblastic proliferations</p>\r\n<p class=\"TableText\">Follicular dendritic cell tumour</p>\r\n<p class=\"TableText\">Spindle cell sarcomas with inflammatory component</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 13.5pt;\">\r\n<td style=\"width: 11.78%; background: #DAEEF3; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"11%\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"color: black; \">Myxoid</span></strong></p>\r\n</td>\r\n<td style=\"width: 16.72%; background: #DAEEF3; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Plump or spindled, vesicular nuclei</span></p>\r\n</td>\r\n<td style=\"width: 16.72%; background: #DAEEF3; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Myxoid and oedematous, abundant vessels</span></p>\r\n</td>\r\n<td style=\"width: 16.72%; background: #DAEEF3; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><span style=\" color: black; \">Lymphocytes, plasma cells, macrophages</span></p>\r\n</td>\r\n<td style=\"width: 38.04%; background: #DAEEF3; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"38%\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Nodular fasciitis</span></p>\r\n<p class=\"TableText\"><span style=\"color: black; \">Myxoinflammatory fibroblastic sarcoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 13.5pt;\">\r\n<td style=\"width: 11.78%; border: none; border-bottom: solid black 1.0pt; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"11%\">\r\n<p class=\"TableText\"><strong style=\"\">Hypocellular</strong></p>\r\n</td>\r\n<td style=\"width: 16.72%; border: none; border-bottom: solid black 1.0pt; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><span style=\"\">Few spindle cells</span></p>\r\n</td>\r\n<td style=\"width: 16.72%; border: none; border-bottom: solid black 1.0pt; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><span style=\"\">Hyalinized and collagenous</span></p>\r\n</td>\r\n<td style=\"width: 16.72%; border: none; border-bottom: solid black 1.0pt; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"16%\">\r\n<p class=\"TableText\"><span style=\"\">Sparse lymphocytes, plasma cells</span></p>\r\n</td>\r\n<td style=\"width: 38.04%; border: none; border-bottom: solid black 1.0pt; padding: .75pt 5.4pt .75pt 5.4pt; height: 13.5pt;\" width=\"38%\">\r\n<p class=\"TableText\">IgG4-related sclerosing disease</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

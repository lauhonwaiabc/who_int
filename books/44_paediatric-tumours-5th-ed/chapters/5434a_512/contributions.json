[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 106921,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 466,
        "headingText": "\r\n<p>Simple bone cyst (SBC) is an intramedullary, usually unilocular, cystic bone lesion filled with serous or serosanguineous fluid.</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 704,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 467,
    "contributions": [
      {
        "pkcontributionId": 106922,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 467,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 705,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 468,
    "contributions": [
      {
        "pkcontributionId": 106923,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 468,
        "headingText": "\r\n<p>FB80.5 Solitary bone cyst</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 706,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 469,
    "contributions": [
      {
        "pkcontributionId": 106924,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 469,
        "headingText": "\r\n<p><em>Acceptable:</em> solitary bone cyst.</p>\r\n<p><em>Not recommended:</em> unicameral bone cyst.</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 707,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 470,
    "contributions": [
      {
        "pkcontributionId": 106925,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 470,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 708,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 471,
    "contributions": [
      {
        "pkcontributionId": 106926,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 471,
        "headingText": "\r\n<p>SBCs generally arise in the appendicular skeleton (proximal humerus: 50%, proximal femur: 25%) and rarely in the pelvis, calcaneus, or acral bones.</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 709,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 472,
    "contributions": [
      {
        "pkcontributionId": 106927,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 472,
        "headingText": "\r\n<p>Symptoms associated with SBC are pain, swelling, limitation of motion, and pathological fracture.</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 710,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 473,
    "contributions": [
      {
        "pkcontributionId": 106928,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 473,
        "headingText": "\r\n<p>SBCs affect patients during the first two decades of life. The M:F&nbsp;ratio is 2:1.</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 711,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 474,
    "contributions": [
      {
        "pkcontributionId": 106929,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 474,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 712,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 475,
    "contributions": [
      {
        "pkcontributionId": 106930,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 475,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 719,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 482,
    "contributions": [
      {
        "pkcontributionId": 106931,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 482,
        "headingText": "\r\n<p>Curetted samples of SBC consist of tan membranous fibrous tissue admixed with cancellous bone and blood.</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 713,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 476,
    "contributions": [
      {
        "pkcontributionId": 106932,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 476,
        "headingText": "\r\n<p>SBC is composed of a thin wall of fibrous tissue. Fibrin-like collagenous deposits can be seen on the cyst surface and within the wall, often mineralized and organized in cementum-like structures; chronic inflammation, multinucleated giant cells, haemosiderin, cholesterol clefts, and reactive woven bone can also be present, especially if there has been a pathological fracture {22034879}.</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 714,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 477,
    "contributions": [
      {
        "pkcontributionId": 106933,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 477,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 715,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 478,
    "contributions": [
      {
        "pkcontributionId": 106934,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 478,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 106935,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> a simple, usually unilocular, fibrous-walled cyst.</p>\r\n<p><em>Desirable:</em> fibrin-like deposits that may organize and mineralize, resulting in cementum-like structures.</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 479,
    "contributions": [
      {
        "pkcontributionId": 106936,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 479,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 106937,
        "bookId": 44,
        "chapterId": 512,
        "headingId": 480,
        "headingText": "\r\n<p>SBC can recur locally (10&ndash;20% of cases) {16205152}. Spontaneous resolution after pathological fracture has also been reported {30702640}.</p>",
        "timestamp": "2023-03-15T15:55:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
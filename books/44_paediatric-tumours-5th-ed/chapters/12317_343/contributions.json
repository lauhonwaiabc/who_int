    "headingid": 468,
    "contributions": [
      {
        "pkcontributionId": 108343,
        "bookId": 44,
        "chapterId": 343,
        "headingId": 468,
        "headingText": "\r\n<p>DA05.Y &amp; XH9F67 Other specified cysts of oral or facial-neck region &amp; Dermoid cyst, NOS</p>\r\n",
        "timestamp": "2023-03-10T14:10:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 706,

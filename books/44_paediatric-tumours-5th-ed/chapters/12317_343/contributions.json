[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 108341,
        "bookId": 44,
        "chapterId": 343,
        "headingId": 466,
        "headingText": "\r\n<p>Nasopharyngeal dermoid is a congenital benign developmental nasopharyngeal anomaly containing ectoderm- and mesoderm-derived tissues.</p>\r\n",
        "timestamp": "2023-03-10T14:10:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 704,

        "headingId": 479,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-03-10T14:10:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 108357,
        "bookId": 44,
        "chapterId": 343,
        "headingId": 480,
        "headingText": "\r\n<p>Recurrences are rare after excision {10841951; 30396417}.</p>",
        "timestamp": "2023-03-10T14:10:04"
      }
    ],

        "timestamp": "2023-03-10T15:30:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 108510,
        "bookId": 44,
        "chapterId": 432,
        "headingId": 480,
        "headingText": "\r\n<p>With the caveat that FLIT is rare and follow-up is limited, there have been no reports of local recurrence or metastatic disease.</p>",
        "timestamp": "2023-03-10T15:30:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

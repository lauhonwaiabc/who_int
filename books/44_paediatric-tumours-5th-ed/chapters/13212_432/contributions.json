        "pkcontributionId": 108494,
        "bookId": 44,
        "chapterId": 432,
        "headingId": 466,
        "headingText": "\r\n<p>Fetal lung interstitial tumour (FLIT) is a benign tumour of lung interstitial mesenchymal cells, manifesting as a solid or spongy lung mass in neonates.</p>\r\n",
        "timestamp": "2023-03-10T15:30:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 105166,
        "bookId": 44,
        "chapterId": 127,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> conjunctival/corneal localization; dermal-type collagen bundles and various components of mature epidermal tissue (adipose tissue for dermolipoma; additional components for complex choristoma); absence of malignant changes.</p>\r\n",
        "timestamp": "2022-07-13T16:22:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 479,
    "contributions": [
      {
        "pkcontributionId": 105167,
        "bookId": 44,
        "chapterId": 127,
        "headingId": 479,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2022-07-13T16:22:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 105168,
        "bookId": 44,
        "chapterId": 127,
        "headingId": 480,
        "headingText": "\r\n<p>Malignant transformation has not been described. Debulking or excision is sometimes necessary to mitigate the risk of amblyopia associated with corneal lesions, inadequate lid closure, or dellen, or for cosmetic reasons {19512907; 7933633}.</p>",
        "timestamp": "2022-07-13T16:22:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
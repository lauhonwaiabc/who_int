  },
  {
    "pkattachmentId": 49957,
    "bookid": 44,
    "chapterId": 156,
    "fileId": 19075,
    "type": "Figure",
    "diagnosis": "Low-grade fibromyxoid sarcoma",
    "title": "",
    "legend": "In this example of paediatric low-grade fibromyxoid sarcoma, uniform spindle and stellate cells are distributed within a myxoid/myxocollagenous and collagenous stroma. The demarcation between stromal components is typically abrupt. Vascularity is quite prominent, with variably sized (frequently arteriole-sized) vessels and focal perivascular sclerosis.",
    "source": "Dr Steven D Billings, Cleveland Clinic, OH",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/156/19075.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/156/thumb_19075.jpg"
  },
  {
    "pkattachmentId": 49958,
    "bookid": 44,
    "chapterId": 156,
    "fileId": 19076,
    "type": "Figure",
    "diagnosis": "Low-grade fibromyxoid sarcoma",
    "title": "",
    "legend": "There is demarcation between the more hypercellular areas of tumour and those with moderate cellularity. The tumour is disposed in short fascicles and whorls, and vascularity is prominent.",
    "source": "Dr Steven D Billings, Cleveland Clinic, OH",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/156/19076.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/156/thumb_19076.jpg"
  },
  {

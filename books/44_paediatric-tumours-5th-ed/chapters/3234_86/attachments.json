  {
    "pkattachmentId": 51414,
    "bookid": 44,
    "chapterId": 86,
    "fileId": 19321,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Essential and desirable diagnostic criteria for desmoplastic infantile astrocytoma (DIA) and desmoplastic infantile ganglioglioma (DIG)</p>",
    "legend": "",
    "source": "Dominique Figarella-Branger",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 602.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong><em>Essential: </em></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 602.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">Biphasic morphology with a dominant desmoplastic leptomeningeal component admixed with a neuroepithelial component containing astrocytic cells only (DIA) or containing astrocytes and neuronal cells (DIG)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 602.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong>AND (for unresolved lesions)</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 36.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"44\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 565.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"664\">\r\n<p class=\"TableText\">Methylation profile of DIG/DIA</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 36.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"44\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 565.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"664\">\r\n<p class=\"TableText\"><strong>OR</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 36.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"44\">&nbsp;</td>\r\n<td style=\"width: 565.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"664\">\r\n<p class=\"TableText\"><em>BRAF</em> or <em>RAF1</em> mutation or fusion, occurring in the absence of homozygous deletion of <em>CDKN2A</em> and/or <em>CDKN2B</em></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 602.45pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\"><strong><em>Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 602.45pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"708\">\r\n<p class=\"TableText\">Tumour with a cystic component and a solid portion, with leptomeningeal involvement, usually attached to the dura</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 602.45pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"708\">\r\n<p class=\"TableText\">Infantile onset (typically at &lt;&nbsp;24 months)</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  }
]
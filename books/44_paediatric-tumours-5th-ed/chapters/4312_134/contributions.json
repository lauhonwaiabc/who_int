[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 105254,
        "bookId": 44,
        "chapterId": 134,
        "headingId": 466,
        "headingText": "\r\n<p>A Lisch nodule is a melanocytic hamartoma of the iris, comprising benign, predominantly spindled melanocytes and occurring in neurofibromatosis type&nbsp;1 (NF1).</p>\r\n",
        "timestamp": "2022-07-13T16:32:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 704,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

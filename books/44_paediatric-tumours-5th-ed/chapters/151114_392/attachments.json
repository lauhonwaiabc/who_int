    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" width=\"612\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid; height: 16.9pt;\">\r\n<td style=\"width: 75.75pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.9pt;\" rowspan=\"2\" width=\"101\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black;\">Age (years)</span></strong></p>\r\n</td>\r\n<td style=\"width: 234.45pt; border-top: solid black 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.9pt;\" colspan=\"3\" width=\"313\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black;\">Proportion of colon cancers caused by MSI</span></strong></p>\r\n</td>\r\n<td style=\"width: 148.8pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.9pt;\" rowspan=\"2\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black;\">Probability that MSI in a colon cancer is due to LS<sup>a</sup></span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 16.85pt;\">\r\n<td style=\"width: 78.15pt; border: none; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.85pt;\" width=\"104\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black;\">Overall</span></strong></p>\r\n</td>\r\n<td style=\"width: 78.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.85pt;\" width=\"104\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black;\">Due to LS</span></strong></p>\r\n</td>\r\n<td style=\"width: 78.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 16.85pt;\" width=\"104\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black;\">Sporadic</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 75.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"101\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">35</p>\r\n</td>\r\n<td style=\"width: 78.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"104\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">23%</p>\r\n</td>\r\n<td style=\"width: 78.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"104\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">22%</p>\r\n</td>\r\n<td style=\"width: 78.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"104\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">2%</p>\r\n</td>\r\n<td style=\"width: 148.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\">92%</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 75.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"101\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black;\">40</span></p>\r\n</td>\r\n<td style=\"width: 78.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"104\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\"><span style=\"color: black;\">16%</span></p>\r\n</td>\r\n<td style=\"width: 78.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"104\">\r\n<p class=\"TableText\" style=\"text-align: right;\" align=\"right\"
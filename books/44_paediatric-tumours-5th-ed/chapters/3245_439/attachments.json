    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 467.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"624\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 467.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"624\">\r\n<p class=\"TableText\"><span style=\" \">Supratentorial tumour with morphological and immunohistochemical features of ependymoma</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 467.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"624\">\r\n<p class=\"TableText\"><strong style=\"\"><span style=\"\">AND</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 467.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"624\">\r\n<p class=\"TableText\"><span style=\" \">Gene fusion involving </span><em style=\"\"><span style=\"\">YAP1</span></em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 467.8pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"624\">\r\n<p class=\"TableText\"><strong style=\"\"><em style=\"\">Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 467.8pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"624\">\r\n<p class=\"TableText\"><span style=\" \">DNA methylation profile aligned with supratentorial ependymoma, </span><em style=\"\"><span style=\"\">YAP1</span></em><span style=\" \"> fusion&ndash;positive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 467.8pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"624\">\r\n<p class=\"TableText\"><span style=\" \">No immunoreactivity
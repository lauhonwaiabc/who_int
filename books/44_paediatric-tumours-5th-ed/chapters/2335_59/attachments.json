  {
    "pkattachmentId": 51427,
    "bookid": 44,
    "chapterId": 59,
    "fileId": 19837,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Differential diagnosis of lymphomatoid papulosis (LyP)</p>",
    "legend": "",
    "source": "Rita Alaggio",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; \" border=\"0\" width=\"902\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" page-break-inside: avoid;\">\r\n<td style=\"width: 56.75pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"76\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">LyP</span></strong></p>\r\n</td>\r\n<td style=\"width: 206.6pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"275\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Differential diagnosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 206.65pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Overlapping clinical features</span></strong></p>\r\n</td>\r\n<td style=\"width: 206.65pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Key histological and immunohistochemical features of the differential diagnosis (vs LyP)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid;\">\r\n<td style=\"width: 56.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"76\">\r\n<p class=\"TableText\"><strong>Type&nbsp;A</strong></p>\r\n</td>\r\n<td style=\"width: 206.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"275\">\r\n<p class=\"TableText\">Insect bites</p>\r\n</td>\r\n<td style=\"width: 206.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\">Single/multiple lesions</p>\r\n<p class=\"TableText\">Itchy</p>\r\n<p class=\"TableText\">Infrequent scarring</p>\r\n</td>\r\n<td style=\"width: 206.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\">Similar wedge-shaped appearance at low power, but less numerous CD30+ cells</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid;\">\r\n<td style=\"width: 56.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"76\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Types&nbsp;A and&nbsp;B</span></strong></p>\r\n</td>\r\n<td style=\"width: 206.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"275\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Pityriasis lichenoides et varioliformis acuta (PLEVA)</span></p>\r\n</td>\r\n<td style=\"width: 206.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Crops of papules evolving to necrotic lesions and resolving into varioliform scars</span></p>\r\n</td>\r\n<td style=\"width: 206.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\"><span style=\"color: black; \">More superficial infiltrate</span></p>\r\n<p class=\"TableText\"><span style=\"color: black; \">Minor extent of lymphoid atypia</span></p>\r\n<p class=\"TableText\"><span style=\"color: black; \">T&nbsp;cells predominantly CD8+</span></p>\r\n<p class=\"TableText\"><span style=\"color: black; \">Few/no large atypical CD30+ cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid;\">\r\n<td style=\"width: 56.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"76\">\r\n<p class=\"TableText\"><strong>Type&nbsp;B</strong></p>\r\n</td>\r\n<td style=\"width: 206.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"275\">\r\n<p class=\"TableText\">Mycosis fungoides, plaque stage <span class=\"Ref-PMID\">{27993440}</span></p>\r\n</td>\r\n<td style=\"width: 206.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\">Patches and plaques</p>\r\n</td>\r\n<td style=\"width: 206.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\">CD30&minus; in 80%, or scattered positive cells</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid;\">\r\n<td style=\"width: 56.75pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"76\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Type&nbsp;C</span></strong></p>\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">(Type&nbsp;E)</span></strong></p>\r\n</td>\r\n<td style=\"width: 206.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"275\">\r\n<p class=\"TableText\"><span style=\"color: black; \">C-ALCL (C-ALCL with angiodestructive growth) </span><span class=\"Ref-PMID\">{24246691}</span></p>\r\n</td>\r\n<td style=\"width: 206.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Single non-regressing lesions (or grouped nodules)</span></p>\r\n<p class=\"TableText\"><span style=\"color: black; \">Frequently &gt;&nbsp;30&nbsp;mm</span></p>\r\n</td>\r\n<td style=\"width: 206.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\"><span style=\"color: black; \">&gt;&nbsp;75% of infiltrate composed of large T&nbsp;cells (CD30+; CD4+ and/or CD8+ or double-negative)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid;\">\r\n<td style=\"width: 56.75pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"76\">\r\n<p class=\"TableText\"><strong>Types&nbsp;B, D, and&nbsp;E</strong></p>\r\n</td>\r\n<td style=\"width: 206.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"275\">\r\n<p class=\"TableText\">Cutaneous &gamma;&delta; T-cell lymphoma <span class=\"Ref-PMID\">{27993440}</span></p>\r\n</td>\r\n<td style=\"width: 206.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\">Multiple plaques</p>\r\n<p class=\"TableText\">Ulcers involving fat</p>\r\n</td>\r\n<td style=\"width: 206.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\">TCR&gamma;+</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid;\">\r\n<td style=\"width: 56.75pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"76\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; \">Types&nbsp;D and&nbsp;E</span></strong></p>\r\n</td>\r\n<td style=\"width: 206.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"275\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Pagetoid reticulosis </span><span class=\"Ref-PMID\">{27993440}</span></p>\r\n</td>\r\n<td style=\"width: 206.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\"><span style=\"color: black; \">A single erythematous, scaling lesion</span></p>\r\n</td>\r\n<td style=\"width: 206.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\"><span style=\"color: black; \">CD30&minus; (or expression in a minority of cells)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid;\">\r\n<td style=\"width: 206.6pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"275\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Primary cutaneous aggressive epidermotropic CD8+ cytotoxic T-cell lymphoma</span></p>\r\n</td>\r\n<td style=\"width: 206.65pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\"><span style=\"color: black; \">Multiple plaques/nodules, with necrosis</span></p>\r\n</td>\r\n<td style=\"width: 206.65pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"276\">\r\n<p class=\"TableText\"><span style=\"color: black; \">CD30&minus;</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

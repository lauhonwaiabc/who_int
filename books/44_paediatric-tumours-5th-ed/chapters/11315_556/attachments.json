  {
    "pkattachmentId": 51383,
    "bookid": 44,
    "chapterId": 556,
    "fileId": 39188,
    "type": "Figure",
    "diagnosis": "Pathogenesis of cribriform morular thyroid carcinoma",
    "title": "",
    "legend": "Under normal conditions, in the absence of WNT binding to frizzled (FZD) receptors, &beta;-catenin interacts with the destruction complex (CK1, GSK3B, APC, and AXIN1), resulting in its phosphorylation by CK1 and GSK3B and its subsequent degradation by the proteasome. In sporadic cribriform morular thyroid carcinoma, somatic mutations in the &lt;em&gt;APC&lt;/em&gt;, &lt;em&gt;CTNNB1&lt;/em&gt;, and/or &lt;em&gt;AXIN1&lt;/em&gt; genes alter the destruction complex, impairing &beta;-catenin phosphorylation and degradation. &beta;-catenin accumulates in the cytoplasm and subsequently translocates to the nucleus, where it acts as an activator of LEF/TCF proteins that lead to constitutive expression of WNT target genes. In cribriform morular thyroid carcinomas associated with familial adenomatous polyposis, there are germline &lt;em&gt;APC&lt;/em&gt; mutations.",
    "source": "&lt;p&gt;Copied from ENDO5&lt;/p&gt;\n&lt;p&gt;Cameselle-Teijeiro Jos&eacute; Manuel&lt;/p&gt;",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/556/39188.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/556/thumb_39188.jpg"
  }

    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 3.0cm; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Subtype</span></strong></p>\r\n</td>\r\n<td style=\"width: 113.5pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Patient age</span></strong></p>\r\n</td>\r\n<td style=\"width: 61.15pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"82\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"color: black;\">M:F&nbsp;ratio</span></strong></p>\r\n</td>\r\n<td style=\"width: 193.9pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"259\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Main sites of involvement</span></strong></p>\r\n</td>\r\n<td style=\"width: 244.3pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"326\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Histopathology</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\"><strong>Fetal (classic)</strong></p>\r\n</td>\r\n<td style=\"width: 113.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\">Infants</p>\r\n</td>\r\n<td style=\"width: 61.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"82\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">3:1</p>\r\n</td>\r\n<td style=\"width: 193.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"259\">\r\n<p class=\"TableText\">Head/neck (70&ndash;90%)</p>\r\n</td>\r\n<td style=\"width: 244.3pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"326\">\r\n<p class=\"TableText\">Primitive spindle cells and myotubes in myxoid stroma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid; height: 4.0pt;\">\r\n<td style=\"width: 3.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"113\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Fetal (intermediate)</span></strong></p>\r\n</td>\r\n<td style=\"width: 113.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"151\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Children and adults</span></p>\r\n</td>\r\n<td style=\"width: 61.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"82\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black;\">3:1</span></p>\r\n</td>\r\n<td style=\"width: 193.9pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"259\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Head/neck</span></p>\r\n</td>\r\n<td style=\"width: 244.3pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.0pt;\" width=\"326\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Strap-shaped muscle cells or ganglion-like cells in solid matrix</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\"><strong>Genital</strong></p>\r\n</td>\r\n<td style=\"width: 113.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\">30&ndash;48&nbsp;years (mean: 42&nbsp;years)</p>\r\n</td>\r\n<td style=\"width: 61.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"82\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">M&lt;&lt;&lt;F</p>\r\n</td>\r\n<td style=\"width: 193.9pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"259\">\r\n<p class=\"TableText\">Primarily vaginal; paratesticular tumours described in children</p>\r\n</td>\r\n<td style=\"width: 244.3pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"326\">\r\n<p class=\"TableText\">Paratesticular tumours have fetal histology</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 3.0cm; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Adult</span></strong></p>\r\n</td>\r\n<td style=\"width: 113.5pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><span style=\"color: black;\">33&ndash;80&nbsp;years (median: 60 years)</span></p>\r\n</td>\r\n<td style=\"width: 61.15pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"82\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"color: black;\">3:1</span></p>\r\n</td>\r\n<td style=\"width: 193.9pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"259\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Head/neck</span></p>\r\n</td>\r\n<td style=\"width: 244.3pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"326\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Polygonal cells and vacuolated cells; paediatric tumours may be hamartomatous</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

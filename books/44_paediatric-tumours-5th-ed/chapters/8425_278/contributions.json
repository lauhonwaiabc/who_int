[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 107640,
        "bookId": 44,
        "chapterId": 278,
        "headingId": 466,
        "headingText": "\r\n<p>Mesonephric remnants are embryonic remnants of mesonephric duct, and mesonephric hyperplasia is their benign proliferation.</p>\r\n",
        "timestamp": "2023-03-09T14:17:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 704,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,

[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 107230,
        "bookId": 44,
        "chapterId": 256,
        "headingId": 466,
        "headingText": "\r\n<p>Paediatric cystic nephroma is a benign, multilocular, cystic neoplasm of the kidney associated with <em>DICER1</em> syndrome.</p>\r\n",
        "timestamp": "2023-03-09T10:28:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 704,
    "bookid": 44,
    "headingType": 2,

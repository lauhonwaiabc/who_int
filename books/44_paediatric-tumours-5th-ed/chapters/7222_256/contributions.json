        "headingId": 467,
        "headingText": "\r\n<p>8959/0 Paediatric cystic nephroma</p>\r\n",
        "timestamp": "2023-03-09T10:28:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 705,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 468,
    "contributions": [
      {
        "pkcontributionId": 107232,
        "bookId": 44,
        "chapterId": 256,
        "headingId": 468,
        "headingText": "\r\n<p>2F35 &amp; XH7TJ0 Benign neoplasm of urinary organs &amp; Paediatric cystic nephroma</p>\r\n",
        "timestamp": "2023-03-09T10:28:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 706,
    "bookid": 44,
    "headingType": 2,

  {
    "pkattachmentId": 51214,
    "bookid": 44,
    "chapterId": 57,
    "fileId": 32298,
    "type": "Figure",
    "diagnosis": "ALK-positive anaplastic large cell lymphoma",
    "title": "",
    "legend": "Subcellular distribution of ALK fusion proteins. Tumours associated with t(2;5) express NPM1::ALK protein and show a characteristic cytoplasmic, nuclear, and nucleolar staining that can be explained by the formation of homodimers and heterodimers: wildtype NPM1 provides nuclear localization signals (NLSs) whereby the NPM1::ALK protein can enter the nucleus. On the other hand, the formation of NPM1::ALK homodimers retained in the cytoplasm mimics ligand binding and is responsible for the oncogenic activation of the ALK catalytic domain. In the variant translocations, ALK partners lack nuclear localization signals but their oligomerization domain located in their amino-terminal portion could induce dimerization of the chimeric proteins and activation of the ALK catalytic domain. Both homodimers and heterodimers are restricted to the cytoplasm.",
    "source": "Laurence Lamant-Rochaix",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/57/32298.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/57/thumb_32298.jpg"
  },

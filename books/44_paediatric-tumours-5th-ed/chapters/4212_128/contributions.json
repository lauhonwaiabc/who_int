  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 105185,
        "bookId": 44,
        "chapterId": 128,
        "headingId": 480,
        "headingText": "\r\n<p>Epibulbar osseous choristomas are benign, and malignant transformation has not been described. It is believed that these lesions do not grow, although slight enlargement has been reported {22496017; 12358295}.</p>",
        "timestamp": "2022-07-13T16:23:19"
      }
    ],

        "headingId": 478,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-10T10:44:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 107843,
        "bookId": 44,
        "chapterId": 293,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> a nested architecture surrounded by cellular myofibroblastic stroma; bland and uniform epithelioid and spindle cells; expression of keratins, WT1, and nuclear &beta;-catenin.</p>\r\n",
        "timestamp": "2023-03-10T10:44:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 479,
    "contributions": [
      {
        "pkcontributionId": 107844,
        "bookId": 44,
        "chapterId": 293,
        "headingId": 479,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-10T10:44:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 107845,
        "bookId": 44,
        "chapterId": 293,
        "headingId": 480,
        "headingText": "\r\n<p>Many patients with CNSET are cured by surgical excision, although several reported patients have developed local recurrence requiring liver transplantation {15613852; 15613851; 19363442; 18338937}. Lymph node or lung metastases are rare; several reported patients have died of the disease {21221846; 29290661}.</p>",
        "timestamp": "2023-03-10T10:44:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
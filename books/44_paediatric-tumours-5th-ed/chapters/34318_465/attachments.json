    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 432.35pt; background: #DAEEF3; border-collapse: collapse; border: none; \" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 432.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><em style=\"\">Essential:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 432.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\">Highly cellular tumour characterized by the presence of cribriform strands and ribbons</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 432.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\">AND</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 432.35pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\">Loss of nuclear SMARCB1 protein expression of tumour cells</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 432.35pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\"><strong style=\"\"><em style=\"\">Desirable:</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 432.35pt; background: #EFF6FC; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" valign=\"top\" width=\"576\">\r\n<p class=\"TableText\" style=\"margin: 2.25pt 0cm 2.25pt 0cm;\">Distinct expression of EMA highlighting cell surfaces</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\"><strong style=\"\">Caveat:</strong> The distinction of CRINET from the AT/RT-TYR subgroup is not fully established.</p>",

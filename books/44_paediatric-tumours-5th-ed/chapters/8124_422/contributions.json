        "headingId": 478,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-03-09T11:52:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 107535,
        "bookId": 44,
        "chapterId": 422,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> pseudolobules composed of epithelioid and spindled cells separated by hypocellular stroma; thin-walled haemangiopericytoma-like vessels.</p>\r\n",
        "timestamp": "2023-03-09T11:52:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 479,
    "contributions": [
      {
        "pkcontributionId": 107536,
        "bookId": 44,
        "chapterId": 422,
        "headingId": 479,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2023-03-09T11:52:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 107537,
        "bookId": 44,
        "chapterId": 422,
        "headingId": 480,
        "headingText": "\r\n<p>One recurrence has been reported. The primary tumour had capsular disruption, necrosis, and marked mitotic activity {27149006}.</p>",
        "timestamp": "2023-03-09T11:52:50"
      }
    ],

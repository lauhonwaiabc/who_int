[
  {
    "pkheadingid": 703,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 466,
    "contributions": [
      {
        "pkcontributionId": 107521,
        "bookId": 44,
        "chapterId": 422,
        "headingId": 466,
        "headingText": "\r\n<p>Sclerosing stromal tumour is a benign stromal neoplasm characterized by a pseudolobular architecture with a prominent vasculature and epithelioid and spindled cells, separated by oedematous or densely collagenous stroma.</p>\r\n",
        "timestamp": "2023-03-09T11:52:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 704,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 467,
    "contributions": [
      {
        "pkcontributionId": 107522,
        "bookId": 44,
        "chapterId": 422,
        "headingId": 467,
        "headingText": "\r\n<p>8602/0 Sclerosing stromal tumour</p>\r\n",
        "timestamp": "2023-03-09T11:52:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 705,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 468,
    "contributions": [
      {
        "pkcontributionId": 107523,
        "bookId": 44,
        "chapterId": 422,
        "headingId": 468,
        "headingText": "\r\n<p>2F32.Y &amp; XH6NZ8 Other specified benign neoplasm of ovary &amp; Sclerosing stromal tumour</p>\r\n",
        "timestamp": "2023-03-09T11:52:50"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 706,

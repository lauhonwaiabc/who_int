  {
    "pkattachmentId": 51424,
    "bookid": 44,
    "chapterId": 334,
    "fileId": 19472,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diagnostic criteria for odontogenic tumours, with radiographic findings indicated in italics</p>",
    "legend": "",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 697.9pt; border-collapse: collapse; \" border=\"0\" width=\"931\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" page-break-inside: avoid;\">\r\n<td style=\"width: 90.8pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"121\">\r\n<p class=\"TableText\"><strong>Category</strong></p>\r\n</td>\r\n<td style=\"width: 362.8pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"484\">\r\n<p class=\"TableText\"><strong>Essential criteria</strong></p>\r\n</td>\r\n<td style=\"width: 244.3pt; border: none; border-top: solid black 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"326\">\r\n<p class=\"TableText\"><strong>Desirable criteria</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 56.25pt;\">\r\n<td style=\"width: 90.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 56.25pt;\" width=\"121\">\r\n<p class=\"TableText\"><strong>Ameloblastoma</strong></p>\r\n</td>\r\n<td style=\"width: 362.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 56.25pt;\" width=\"484\">\r\n<p class=\"TableText\">Elongate palisaded basal cells with reverse polarity</p>\r\n<p class=\"TableText\">Stellate reticulum</p>\r\n<p class=\"TableText\">Stroma of normal or collagenous fibrous tissue</p>\r\n<p class=\"TableText\">No dental hard tissues</p>\r\n<p class=\"TableText\">No abnormal mitoses</p>\r\n<p class=\"TableText\"><em>Cyst-like radiolucency, unilocular or multilocular, with cortication</em></p>\r\n</td>\r\n<td style=\"width: 244.3pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 56.25pt;\" width=\"326\">\r\n<p class=\"TableText\">Basal cell subnuclear vacuolization</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 43.5pt;\">\r\n<td style=\"width: 90.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 43.5pt;\" width=\"121\">\r\n<p class=\"TableText\"><strong>Ameloblastic fibroma</strong></p>\r\n</td>\r\n<td style=\"width: 362.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 43.5pt;\" width=\"484\">\r\n<p class=\"TableText\">Budding strands of cuboidal or low columnar epithelium</p>\r\n<p class=\"TableText\">Hypercellular loose myxoid stroma</p>\r\n<p class=\"TableText\">No dental hard tissues</p>\r\n<p class=\"TableText\"><em>Cyst-like radiolucency, unilocular or multilocular, with cortication</em></p>\r\n</td>\r\n<td style=\"width: 244.3pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 43.5pt;\" nowrap=\"nowrap\" width=\"326\">\r\n<p class=\"TableText\">Minimal stellate reticulum</p>\r\n<p class=\"TableText\">Sparse normal mitoses</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 53.25pt;\">\r\n<td style=\"width: 90.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 53.25pt;\" width=\"121\">\r\n<p class=\"TableText\"><strong>Adenomatoid odontogenic tumour</strong></p>\r\n</td>\r\n<td style=\"width: 362.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 53.25pt;\" width=\"484\">\r\n<p class=\"TableText\">Sheets and nodules of bland epithelium</p>\r\n<p class=\"TableText\">Intraepithelial duct-like structures</p>\r\n<p class=\"TableText\">Encapsulated</p>\r\n<p class=\"TableText\"><em>Cyst-like unilocular radiolucency</em></p>\r\n</td>\r\n<td style=\"width: 244.3pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 53.25pt;\" width=\"326\">\r\n<p class=\"TableText\">Arrays of ameloblasts</p>\r\n<p class=\"TableText\">Enamel matrix</p>\r\n<p class=\"TableText\">Dentinoid mineralization of connective tissue in the wall of a cyst</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 39.75pt;\">\r\n<td style=\"width: 90.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 39.75pt;\" width=\"121\">\r\n<p class=\"TableText\"><strong>Odontoma</strong></p>\r\n</td>\r\n<td style=\"width: 362.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 39.75pt;\" width=\"484\">\r\n<p class=\"TableText\">Odontogenic epithelium and mesenchyme</p>\r\n<p class=\"TableText\">Histologically normal development of hard tissue</p>\r\n<p class=\"TableText\">Enamel matrix and tubular dentin</p>\r\n<p class=\"TableText\"><em>Sharply demarcated, mixed radiolucency with lucent rim and cortication</em></p>\r\n</td>\r\n<td style=\"width: 244.3pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 39.75pt;\" width=\"326\">\r\n<p class=\"TableText\">Variable formation of tooth-like denticles</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 50.25pt;\">\r\n<td style=\"width: 90.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 50.25pt;\" width=\"121\">\r\n<p class=\"TableText\"><strong>Odontogenic myxoma</strong></p>\r\n</td>\r\n<td style=\"width: 362.8pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 50.25pt;\" width=\"484\">\r\n<p class=\"TableText\">Myxoid stroma</p>\r\n<p class=\"TableText\">Low cellularity</p>\r\n<p class=\"TableText\">Variable islands of bland epithelium without ameloblastic differentiation</p>\r\n<p class=\"TableText\">No abnormal mitoses</p>\r\n<p class=\"TableText\"><em>Multilocular radiographic appearance, no mineralization</em></p>\r\n</td>\r\n<td style=\"width: 244.3pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 50.25pt;\" nowrap=\"nowrap\" width=\"326\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\" page-break-inside: avoid; height: 54.0pt;\">\r\n<td style=\"width: 90.8pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 54.0pt;\" width=\"121\">\r\n<p class=\"TableText\"><strong>Odontogenic keratocyst</strong></p>\r\n</td>\r\n<td style=\"width: 362.8pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 54.0pt;\" width=\"484\">\r\n<p class=\"TableText\">Thin-walled cyst without rete ridges</p>\r\n<p class=\"TableText\">Epithelium uniformly 6&ndash;8&nbsp;cells thick</p>\r\n<p class=\"TableText\">Parakeratinized corrugated luminal surface</p>\r\n<p class=\"TableText\">Palisaded basal cells with reverse polarity, at least focally</p>\r\n<p class=\"TableText\"><em>Cyst-like radiolucency, unilocular or multilocular, with cortication</em></p>\r\n</td>\r\n<td style=\"width: 244.3pt; border: none; border-bottom: solid black 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 54.0pt;\" nowrap=\"nowrap\" width=\"326\">\r\n<p class=\"TableText\">No mineralization</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  },

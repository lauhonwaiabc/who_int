  },
  {
    "pkattachmentId": 49653,
    "bookid": 44,
    "chapterId": 334,
    "fileId": 18454,
    "type": "Figure",
    "diagnosis": "Ameloblastoma, follicular pattern",
    "title": "",
    "legend": "Central islands of loose, stellate, reticulum-like epithelium surrounded by a basophilic peripheral palisaded basal layer of columnar ameloblastic cells. There is focal acanthomatous change, and multiple small cysts are seen forming within the epithelium.",
    "source": "Edward W. Odell",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/44/334/18454.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/44/334/thumb_18454.jpg"
  },
  {

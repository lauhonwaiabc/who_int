  },
  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 105983,
        "bookId": 44,
        "chapterId": 165,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> for PILA: poorly defined dissecting lymphatic spaces with intraluminal papillary columnar cell tufting, with no atypia or mitoses; the lymphatic phenotype is evidenced by morphological intraluminal proteinaceous fluid and stromal and intraluminal lymphocytes or by VEGFR3 or D2-40 immunoreactivity; for RHE: retiform arborizing vascular channels lined by hobnail endothelial cells, with no atypia or mitotic activity; variable sclerotic stroma; expression of a lymphatic phenotype marker (PROX1 or D2-40).</p>\r\n",
        "timestamp": "2023-03-15T13:46:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 716,

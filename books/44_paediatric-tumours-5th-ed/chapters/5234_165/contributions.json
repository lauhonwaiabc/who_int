        "headingId": 479,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-15T13:46:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 105985,
        "bookId": 44,
        "chapterId": 165,
        "headingId": 480,
        "headingText": "\r\n<p>Both PILA and RHE may locally recur if incompletely excised {21679834}. PILA and RHE are not reported to metastasize or cause death from disease.</p>",
        "timestamp": "2023-03-15T13:46:22"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
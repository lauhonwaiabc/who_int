  {
    "pkheadingid": 718,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 481,
    "contributions": [
      {
        "pkcontributionId": 105932,
        "bookId": 44,
        "chapterId": 411,
        "headingId": 481,
        "headingText": "\r\n<p><em>Essential:</em> lobules of capillary vessels; oedematous stroma.</p>\r\n",
        "timestamp": "2023-03-15T13:42:32"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2023-03-15T13:42:32"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 717,
    "bookid": 44,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 480,
    "contributions": [
      {
        "pkcontributionId": 105934,
        "bookId": 44,
        "chapterId": 411,
        "headingId": 480,
        "headingText": "\r\n<p>Regression is not seen, but lesions may become smaller. Local recurrence is possible, and in children, recurrence may occur with multiple satellite papules {5647967}.</p>",
        "timestamp": "2023-03-15T13:42:32"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
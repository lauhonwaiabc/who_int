    "contributions": [
      {
        "pkcontributionId": 125603,
        "bookId": 64,
        "chapterId": 110,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-24T17:51:01"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 125604,
        "bookId": 64,
        "chapterId": 110,
        "headingId": 778,
        "headingText": "\r\n<p>Tubular adenoma is a benign neoplasm.</p>",
        "timestamp": "2025-04-24T17:51:01"
      }
    ],

      {
        "pkcontributionId": 127563,
        "bookId": 64,
        "chapterId": 306,
        "headingId": 764,
        "headingText": "\r\n<p>Multinucleate cell angiohistiocytoma is a benign acquired lesion of fibrohistiocytic and vascular lineage.</p>\r\n",
        "timestamp": "2025-04-25T09:59:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

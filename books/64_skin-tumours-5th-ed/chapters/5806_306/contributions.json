        "chapterId": 306,
        "headingId": 777,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2025-04-25T09:59:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127579,
        "bookId": 64,
        "chapterId": 306,
        "headingId": 778,
        "headingText": "\r\n<p>Multinucleate cell angiohistiocytoma is a benign lesion that may recur, or it may spontaneously resolve in rare instances {8113454}.</p>",
        "timestamp": "2025-04-25T09:59:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

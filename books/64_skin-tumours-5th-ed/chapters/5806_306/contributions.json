  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127577,
        "bookId": 64,
        "chapterId": 306,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> solitary or multiple smooth erythematous papules and nodules; multinucleated and angulated stromal cells; dermal fibrosis (often parallel to the epidermis); thickened stromal blood vessels, increased in number and with dilated lumina.</p>\r\n",
        "timestamp": "2025-04-25T09:59:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

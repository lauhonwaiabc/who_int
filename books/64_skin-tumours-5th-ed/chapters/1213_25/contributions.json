[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 124446,
        "bookId": 64,
        "chapterId": 25,
        "headingId": 764,
        "headingText": "\r\n<p>Micronodular basal cell carcinoma (BCC) is an aggressive type of BCC characterized by small nests with an irregular, tentacular, and infiltrative deep or peripheral edge. It typically extends deeply into the dermis or beyond.</p>\r\n",
        "timestamp": "2025-04-24T14:36:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

  {
    "pkheadingid": 826,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 769,
    "contributions": [
      {
        "pkcontributionId": 124451,
        "bookId": 64,
        "chapterId": 25,
        "headingId": 769,
        "headingText": "\r\n<p>Micronodular BCC is most commonly situated on the head and neck.</p>\r\n",
        "timestamp": "2025-04-24T14:36:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 124452,
        "bookId": 64,
        "chapterId": 25,
        "headingId": 770,
        "headingText": "\r\n<p>Patients with micronodular BCC usually present with a pink papule or nodule that is often ulcerated and cannot be distinguished from nodular BCC on naked-eye examination or dermoscopy.</p>\r\n",
        "timestamp": "2025-04-24T14:36:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

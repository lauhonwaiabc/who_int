  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 124460,
        "bookId": 64,
        "chapterId": 25,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> an infiltrative, permeative, and tentacular growth pattern; tumour composed predominantly of rounded small nests.</p>\r\n<p><em>Desirable:</em> extension into the deep dermis or beyond.</p>\r\n",
        "timestamp": "2025-04-24T14:36:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

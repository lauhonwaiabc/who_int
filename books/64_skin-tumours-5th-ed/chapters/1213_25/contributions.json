  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 124462,
        "bookId": 64,
        "chapterId": 25,
        "headingId": 778,
        "headingText": "\r\n<p>Prognostic data for micronodular BCC are limited by inconsistent histological classification and poor interobserver reproducibility. Nevertheless, this tumour type appears to be strongly associated with an increased risk of local recurrence {26050215; 27311865; 34931722}.</p>",
        "timestamp": "2025-04-24T14:36:34"
      }
    ],

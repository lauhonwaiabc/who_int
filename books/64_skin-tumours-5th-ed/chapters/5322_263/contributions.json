  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 128002,
        "bookId": 64,
        "chapterId": 263,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential: </em>small bluish nodule or papule; nodular proliferation of epithelioid endothelial cells; lack of nuclear pleomorphism and atypical mitotic activity; preserved SMA-positive pericytic layer.</p>\r\n",
        "timestamp": "2025-04-25T12:10:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

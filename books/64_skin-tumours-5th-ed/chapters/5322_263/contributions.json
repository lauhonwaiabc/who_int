    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 128004,
        "bookId": 64,
        "chapterId": 263,
        "headingId": 778,
        "headingText": "\r\n<p>Cutaneous epithelioid angiomatous nodule is entirely benign, and no adverse outcome has been documented in the literature {14726818; 18212538}.</p>",
        "timestamp": "2025-04-25T12:10:58"
      }
    ],

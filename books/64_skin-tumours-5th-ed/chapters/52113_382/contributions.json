[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127291,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 764,
        "headingText": "\r\n<p>Sclerotic fibroma is a benign cutaneous fibrous tumour with a prominent storiform pattern and clefting. The tumours can be sporadic or associated with Cowden syndrome.</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 127292,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 765,
        "headingText": "\r\n<p>8823/0 Sclerotic fibroma</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 127293,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 766,
        "headingText": "\r\n<p>2F23.Y &amp; XH5JG7 Other specified benign dermal fibrous or fibrohistiocytic neoplasms &amp; Sclerotic fibroma</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 767,
    "contributions": [
      {
        "pkcontributionId": 127294,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 767,
        "headingText": "\r\n<p><em>Acceptable:</em> storiform collagenoma.</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 825,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 768,
    "contributions": [
      {
        "pkcontributionId": 127295,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 768,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 826,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 769,
    "contributions": [
      {
        "pkcontributionId": 127296,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 769,
        "headingText": "\r\n<p>Sclerotic fibroma is most common in the head and neck region and in the arms {2029087}.</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 127297,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 770,
        "headingText": "\r\n<p>Tumours are solitary or multiple, typically slow-growing, longstanding, painless, white to skin-coloured papules or nodules {2029087; 2464630}.</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 828,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 771,
    "contributions": [
      {
        "pkcontributionId": 127298,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 771,
        "headingText": "\r\n<p>Sclerotic fibroma has a predilection for middle-aged adults. Cases associated with Cowden syndrome occur predominantly in men {2029087}, while sporadic cases occur predominantly in women {2464630}.</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 829,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 772,
    "contributions": [
      {
        "pkcontributionId": 127299,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 772,
        "headingText": "\r\n<p>Sclerotic fibroma (in particular when multiple) has been associated with Cowden syndrome {2029087; 1430474}.</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 830,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 773,
    "contributions": [
      {
        "pkcontributionId": 127300,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 773,
        "headingText": "\r\n<p>Tumours that arise in association with Cowden syndrome have loss of <em>PTEN</em> (10q23.3), resulting in loss of its expression.</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 837,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 780,
    "contributions": [
      {
        "pkcontributionId": 127301,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 780,
        "headingText": "\r\n<p>Sclerotic fibroma typically appears as small, flesh-coloured papules or nodules of 5&ndash;30&nbsp;mm in size.</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 831,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 774,
    "contributions": [
      {
        "pkcontributionId": 127302,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 774,
        "headingText": "\r\n<p>Sclerotic fibromas are polypoid, well-circumscribed, hypocellular lesions with abundant collagen with plywood-like clefting, admixed with banal small spindle cells arranged in a storiform pattern. Myxoid change can be seen {2029087; 2464630}. The tumours express CD34 {10698210}.</p>\r\n<h6>Differential diagnosis</h6>\r\n<p>Dermatofibroma is the main differential diagnosis. Sclerosing dermatofibrosarcoma protuberans may also mimic a sclerotic fibroma, especially on partial biopsies {28134725}.</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 832,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 775,
    "contributions": [
      {
        "pkcontributionId": 127303,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 775,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 833,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 776,
    "contributions": [
      {
        "pkcontributionId": 127304,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 776,
        "headingText": "\r\n<p>Loss of PTEN by immunohistochemistry may suggest Cowden syndrome.</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127305,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> hypocellular banal spindle cells arranged in a storiform pattern; abundant collagen with plywood-like clefting.</p>\r\n<p><em>Desirable:</em> for Cowden syndrome: loss of PTEN expression by immunohistochemistry.</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 127306,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127307,
        "bookId": 64,
        "chapterId": 382,
        "headingId": 778,
        "headingText": "\r\n<p>Sclerotic fibromas are benign.</p>",
        "timestamp": "2025-04-25T09:37:02"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
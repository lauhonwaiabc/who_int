  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127798,
        "bookId": 64,
        "chapterId": 252,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a well-circumscribed dermal/subcutaneous tumour composed of dilated, cavernous-like vascular channels intermixed with solid areas composed of vacuolated epithelioid endothelial cells.</p>\r\n",
        "timestamp": "2025-04-25T12:00:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

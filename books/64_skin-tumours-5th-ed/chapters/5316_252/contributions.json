        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T12:00:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127800,
        "bookId": 64,
        "chapterId": 252,
        "headingId": 778,
        "headingText": "\r\n<p>Spindle cell haemangiomas are benign and do not usually recur, but multiple new lesions may develop over time {2071088}.</p>",
        "timestamp": "2025-04-25T12:00:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

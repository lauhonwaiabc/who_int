[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127784,
        "bookId": 64,
        "chapterId": 252,
        "headingId": 764,
        "headingText": "\r\n<p>Spindle cell haemangioma is a benign neoplasm composed of spindled cells, ectatic vascular spaces, and vacuolated endothelial cells.</p>\r\n",
        "timestamp": "2025-04-25T12:00:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

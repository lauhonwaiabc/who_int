  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 128427,
        "bookId": 64,
        "chapterId": 292,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a multilobulated neoplasm; nests of epithelioid cells with a vesicular nucleus, small nucleolus, and pale eosinophilic cytoplasm, often separated by dense collagenous or myxoid stroma.</p>\r\n",
        "timestamp": "2025-04-25T15:03:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

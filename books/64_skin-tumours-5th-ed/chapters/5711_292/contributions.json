        "bookId": 64,
        "chapterId": 292,
        "headingId": 777,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2025-04-25T15:03:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 128429,
        "bookId": 64,
        "chapterId": 292,
        "headingId": 778,
        "headingText": "\r\n<p>Cellular neurothekeoma is benign, and complete surgical removal is curative.</p>",
        "timestamp": "2025-04-25T15:03:44"
      }
    ],

    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 126318,
        "bookId": 64,
        "chapterId": 350,
        "headingId": 778,
        "headingText": "\r\n<p>This is benign tumour with a low rate of recurrence upon complete excision {20098079}.</p>",
        "timestamp": "2025-04-25T08:21:31"
      }
    ],

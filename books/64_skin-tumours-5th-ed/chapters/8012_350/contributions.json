  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 126316,
        "bookId": 64,
        "chapterId": 350,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a matrical fibroepithelial proliferation, interdigitating with thickened nail plate (when intact).</p>\r\n<p><em>Desirable:</em> submitted nail plate with thickening, loculated serum, and haemorrhage, with attached interdigitating epithelium.</p>\r\n",
        "timestamp": "2025-04-25T08:21:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 125639,
        "bookId": 64,
        "chapterId": 113,
        "headingId": 764,
        "headingText": "\r\n<p>Myoepithelial tumours are neoplasms composed exclusively of myoepithelial cells, similar to their soft tissue and salivary gland counterparts. Syncytial myoepithelioma is a distinctive cutaneous subtype. (Although considered soft tissue tumours, myoepitheliomas are morphologically similar to mixed tumours and are therefore discussed with appendageal tumours.)</p>\r\n",
        "timestamp": "2025-04-24T17:55:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 125640,
        "bookId": 64,
        "chapterId": 113,
        "headingId": 765,
        "headingText": "\r\n<p>8982/0 Myoepithelial tumour</p>\r\n<p>8982/0 Syncytial myoepithelioma</p>\r\n<p>8982/3 Myoepithelial carcinoma</p>\r\n",
        "timestamp": "2025-04-24T17:55:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,

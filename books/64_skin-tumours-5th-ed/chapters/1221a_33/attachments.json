    "fileId": 34983,
    "type": "Figure",
    "diagnosis": "Keratoacanthoma",
    "title": "",
    "legend": "Good cosmetic result 2&nbsp;years after shave removal and watchful waiting (see &lt;&lt;34982&gt;&gt; to see initial appearance).",
    "source": "Richard A. Carr",
    "copyright": "",
    "tablehtml": "",

[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127920,
        "bookId": 64,
        "chapterId": 344,
        "headingId": 764,
        "headingText": "\r\n<p>Acquired elastotic haemangioma (AEH) is a superficial band-like proliferation of small vascular channels arising in sun-exposed skin and associated with solar elastosis.</p>\r\n",
        "timestamp": "2025-04-25T12:04:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

        "bookId": 64,
        "chapterId": 344,
        "headingId": 766,
        "headingText": "\r\n<p>2F2Y Other specified benign cutaneous neoplasms</p>\r\n",
        "timestamp": "2025-04-25T12:04:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "bookId": 64,
        "chapterId": 344,
        "headingId": 765,
        "headingText": "\r\n<p>9120/0 Acquired elastotic haemangioma</p>\r\n",
        "timestamp": "2025-04-25T12:04:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,

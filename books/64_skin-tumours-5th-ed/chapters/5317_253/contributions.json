  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127815,
        "bookId": 64,
        "chapterId": 253,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a lobular proliferation of small vascular channels lined by epithelioid endothelial cells often associated with prominent inflammation (namely, eosinophils and lymphocytes).</p>\r\n",
        "timestamp": "2025-04-25T12:00:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 127816,
        "bookId": 64,
        "chapterId": 253,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T12:00:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127817,
        "bookId": 64,
        "chapterId": 253,
        "headingId": 778,
        "headingText": "\r\n<p>EH is benign, but recurrences are common.</p>",
        "timestamp": "2025-04-25T12:00:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
    "fileId": 34538,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diagnostic features of primary cutaneous CD8-positive aggressive epidermotropic cytotoxic T-cell lymphoma</p>",
    "legend": "",
    "source": "Emilio Berti",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 703.3pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"938\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 120.5pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Clinical</span></strong></p>\r\n</td>\r\n<td style=\"width: 10.0cm; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"378\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Histological</span></strong></p>\r\n</td>\r\n<td style=\"width: 149.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"200\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Positive markers</span></strong></p>\r\n</td>\r\n<td style=\"width: 149.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"200\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Negative markers</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 120.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">Generalized papules, nodules, plaques, and tumours +/&minus;&nbsp;mucosal involvement</span></strong></p>\r\n</td>\r\n<td style=\"width: 10.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"378\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Striking pagetoid epidermotropism and adnexotropism of atypical cytotoxic T&nbsp;cells; spongiosis and blistering; epidermal and dermal necrosis; patchy and diffuse infiltrate; ulceration mimicking pyoderma gangrenosum and involving subcutaneous fat with rimming formation</span></p>\r\n</td>\r\n<td style=\"width: 149.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"200\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">&beta;F1+ (TCR&alpha;&beta;), CD8+/&minus;, Ki-67+, TIA1+, granzyme&nbsp;B&nbsp;+, perforin+, CD45RA+/&minus;</span></p>\r\n</td>\r\n<td style=\"width: 149.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"200\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">CD2&minus;/+, CD4&minus;, CCR4&minus;/+, CD5&minus;/+, CD56&minus;/+, CD45RO&minus;, TCR&gamma;&delta;&minus;</span></p>\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">EBV: EBER1/2&minus;</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 120.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Solitary tumorous lesions</span></strong></p>\r\n</td>\r\n<td style=\"width: 10.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"378\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Ulceration; <a name=\"_Hlk188538486\"></a>tumoural infiltrate involving whole dermis and hypodermis</span></p>\r\n</td>\r\n<td style=\"width: 149.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"200\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">No differences</span></p>\r\n</td>\r\n<td style=\"width: 149.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"200\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">No differences</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 120.5pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">No immunosuppression</span></strong></p>\r\n</td>\r\n<td style=\"width: 10.0cm; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"378\">\r\n<p class=\"TableText\">n/a</p>\r\n</td>\r\n<td style=\"width: 149.65pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"200\">\r\n<p class=\"TableText\">n/a</p>\r\n</td>\r\n<td style=\"width: 149.65pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"200\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">EBV&minus;</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">EBER1/2, EBV-encoded small RNA&nbsp;1/2; n/a, not applicable.</p>",
    "imageUrl": null,
    "thumbnail": null
  },
  {
    "pkattachmentId": 64065,

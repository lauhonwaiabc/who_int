    "type": "Table",
    "diagnosis": "",
    "title": "<p>Histological differential diagnosis of primary cutaneous CD8-positive aggressive epidermotropic cytotoxic T-cell lymphoma</p>",
    "legend": "",
    "source": "",
    "copyright": "Berti E",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-table-layout-alt: fixed; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"938\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 106.35pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"142\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Differential diagnosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 120.45pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"161\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Clinical features</span></strong></p>\r\n</td>\r\n<td style=\"width: 476.5pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"4\" width=\"635\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Immunophenotype</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 119.1pt; border: none; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Positive</span></strong></p>\r\n</td>\r\n<td style=\"width: 119.15pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Negative</span></strong></p>\r\n</td>\r\n<td style=\"width: 119.1pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Variable</span></strong></p>\r\n</td>\r\n<td style=\"width: 119.15pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Ki-67</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 106.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">Lymphomatoid papulosis subtype&nbsp;D</span></strong></p>\r\n</td>\r\n<td style=\"width: 120.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">Recurrent, self-healing, skin-limited papules and nodules</span></p>\r\n</td>\r\n<td style=\"width: 119.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span lang=\"FR\" style=\"mso-fareast-font-family: Aptos; mso-ansi-language: FR;\">CD3, CD5, CD8, CCR4, </span><span style=\"mso-fareast-font-family: Aptos;\">&beta;</span><span lang=\"FR\" style=\"mso-fareast-font-family: Aptos; mso-ansi-language: FR;\">F1, TIA1, TBX21 (T-bet)</span></p>\r\n</td>\r\n<td style=\"width: 119.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">CD4, CD45RA, GATA3</span></p>\r\n</td>\r\n<td style=\"width: 119.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">CD2+/&minus;, CD30+/&minus;, granzyme&nbsp;B+/&minus;, perforin+/&minus;, CD7&minus;/+, CD56&minus;/+, TCR&delta;&minus;/+</span></p>\r\n</td>\r\n<td style=\"width: 119.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">High in atypical cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 106.35pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">CD8+ mycosis fungoides</span></strong></p>\r\n</td>\r\n<td style=\"width: 120.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Chronic indolent patches and plaques or tumours</span></p>\r\n</td>\r\n<td style=\"width: 119.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span lang=\"FR\" style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext; mso-ansi-language: FR;\">CD2, CD3, CD8, TIA1, CCR4, TBX21 (T-bet)</span></p>\r\n</td>\r\n<td style=\"width: 119.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">CD4, CD30, CD45RA, GATA3</span></p>\r\n</td>\r\n<td style=\"width: 119.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">CD5+/&minus;, granzyme&nbsp;B+/&minus;, perforin+/&minus;, CD7&minus;/+, CD56&minus;/+</span></p>\r\n</td>\r\n<td style=\"width: 119.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Low (high in transformed cases)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 106.35pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">TCR&gamma;&delta;+ mycosis fungoides (epidermotropic)</span></strong></p>\r\n</td>\r\n<td style=\"width: 120.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"161\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">Diffuse patches and plaques</span></p>\r\n</td>\r\n<td style=\"width: 119.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"159\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">CD2, CD3, TCR&delta;, TIA1, granzyme&nbsp;B, perforin, 
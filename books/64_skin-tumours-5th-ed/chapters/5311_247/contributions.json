[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127682,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 764,
        "headingText": "\r\n<p>Cherry haemangioma is a common benign superficial dermal capillary proliferation with a lobular architecture, appearing in adulthood.</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 127683,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 765,
        "headingText": "\r\n<p>9120/0 Cherry haemangioma</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 127684,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 766,
        "headingText": "\r\n<p>2F25 &amp; XH9Q71 Cherry angioma &amp; Cherry haemangioma</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 767,
    "contributions": [
      {
        "pkcontributionId": 127685,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 767,
        "headingText": "<p><em>Acceptable:</em> cherry angioma.</p>\r\n<p><em>Not recommended:</em> senile angioma; Campbell de Morgan spot.</p>",
        "timestamp": "2025-06-30T10:32:54"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 825,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 768,
    "contributions": [
      {
        "pkcontributionId": 127686,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 768,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 826,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 769,
    "contributions": [
      {
        "pkcontributionId": 127687,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 769,
        "headingText": "\r\n<p>The most common location is the trunk, followed by the upper limbs and (less commonly) the lower limbs.</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 127688,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 770,
        "headingText": "\r\n<p>The lesions are multiple, tiny, bright red, asymptomatic papules that increase in number with age.</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 828,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 771,
    "contributions": [
      {
        "pkcontributionId": 127689,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 771,
        "headingText": "\r\n<p>This haemangioma affects middle-aged to elderly adults, with no sex predilection.</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 829,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 772,
    "contributions": [
      {
        "pkcontributionId": 127690,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 772,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 830,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 773,
    "contributions": [
      {
        "pkcontributionId": 127691,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 773,
        "headingText": "\r\n<p><em>HRAS</em> and <em>KRAS</em> somatic mutations are found in a small proportion of cases {26802240}, and frequent somatic mutations of <em>GNA14</em>, <em>GNA11</em>, and <em>GNAQ</em> have also been described {34040639; 31189994}.</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 837,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 780,
    "contributions": [
      {
        "pkcontributionId": 127692,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 780,
        "headingText": "\r\n<p>See <em>Clinical features</em>, above.</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 831,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 774,
    "contributions": [
      {
        "pkcontributionId": 127693,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 774,
        "headingText": "\r\n<p>The papillary dermis is expanded by a slightly polypoid lobular proliferation of small congested and dilated capillaries with surrounding loose stroma, often with an epithelial collarette.</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 832,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 775,
    "contributions": [
      {
        "pkcontributionId": 127694,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 775,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 833,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 776,
    "contributions": [
      {
        "pkcontributionId": 127695,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 776,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127696,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a lobular proliferation of capillaries in the papillary dermis associated with an epidermal collarette.</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

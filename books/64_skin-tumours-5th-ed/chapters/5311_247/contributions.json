    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 127697,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127698,
        "bookId": 64,
        "chapterId": 247,
        "headingId": 778,
        "headingText": "\r\n<p>Cherry haemangioma is benign.</p>",
        "timestamp": "2025-04-25T11:54:33"
      }
    ],

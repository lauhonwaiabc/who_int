        "timestamp": "2025-04-24T16:33:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 124838,
        "bookId": 64,
        "chapterId": 49,
        "headingId": 778,
        "headingText": "\r\n<p>Meyerson naevi are benign neoplasms.</p>",
        "timestamp": "2025-04-24T16:33:07"
      }
    ],

      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 124836,
        "bookId": 64,
        "chapterId": 49,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a junctional or compound naevus associated with acanthosis, spongiosis, parakeratosis, lymphocytic inflammation; absence of diagnostic features of melanoma.</p>\r\n",
        "timestamp": "2025-04-24T16:33:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T12:03:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127902,
        "bookId": 64,
        "chapterId": 258,
        "headingId": 778,
        "headingText": "\r\n<p>Complete regression is not typical, and local recurrence occurs in approximately 10% of cases.</p>",
        "timestamp": "2025-04-25T12:03:08"
      }
    ],
    "booknotes": [],

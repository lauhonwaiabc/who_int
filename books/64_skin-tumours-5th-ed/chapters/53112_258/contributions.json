  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127900,
        "bookId": 64,
        "chapterId": 258,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a polypoid tumour with an epithelial collarette and lobules of capillaries associated with an oedematous stroma.</p>\r\n",
        "timestamp": "2025-04-25T12:03:08"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

  {
    "pkattachmentId": 64034,
    "bookid": 64,
    "chapterId": 178,
    "fileId": 36272,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Clinical, pathological, and molecular findings of Rosai&ndash;Dorfman disease in comparison with other histiocytoses</p>",
    "legend": "",
    "source": "Yasodha Natkunam",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 703.3pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"938\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 124.85pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"166\">\r\n<p class=\"TableText\"><strong>Feature</strong></p>\r\n</td>\r\n<td style=\"width: 144.6pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"193\">\r\n<p class=\"TableText\"><strong>Rosai&ndash;Dorfman disease</strong></p>\r\n</td>\r\n<td style=\"width: 144.6pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"193\">\r\n<p class=\"TableText\"><strong>Langerhans cell histiocytosis</strong></p>\r\n</td>\r\n<td style=\"width: 144.6pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"193\">\r\n<p class=\"TableText\"><strong>Erdheim&ndash;Chester disease</strong></p>\r\n</td>\r\n<td style=\"width: 144.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"193\">\r\n<p class=\"TableText\"><strong>ALK+ histiocytosis</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 124.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"166\">\r\n<p class=\"TableText\"><strong>Age, sex, and ethnic predilection</strong></p>\r\n</td>\r\n<td style=\"width: 144.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Older children and adults</p>\r\n<p class=\"TableText\">M:F&nbsp;ratio: 3.2:1</p>\r\n<p class=\"TableText\">African descent</p>\r\n</td>\r\n<td style=\"width: 144.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Older children and adults</p>\r\n<p class=\"TableText\">M:F&nbsp;ratio: 3.7:1</p>\r\n<p class=\"TableText\">Northern European descent</p>\r\n</td>\r\n<td style=\"width: 144.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Adults (55&ndash;60&nbsp;years); rare in children</p>\r\n<p class=\"TableText\">M:F&nbsp;ratio: 3:1</p>\r\n<p class=\"TableText\">No ethnic predilection reported</p>\r\n</td>\r\n<td style=\"width: 144.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Systemic form occurs in infants; multisystem and single-system forms occur over a wide age range (children and adults)</p>\r\n<p class=\"TableText\">F&nbsp;&gt;&nbsp;M</p>\r\n<p class=\"TableText\">No ethnic predilection reported</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 124.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"166\">\r\n<p class=\"TableText\"><strong>Sites of involvement</strong></p>\r\n</td>\r\n<td style=\"width: 144.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Lymph nodes (majority) and/or extranodal sites including skin, CNS, bone and soft tissue; less frequent in single organs</p>\r\n</td>\r\n<td style=\"width: 144.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Solitary, multiple, or disseminated</p>\r\n<p class=\"TableText\">Bone (skull, femur, vertebra, pelvic bones, ribs), skin, and soft tissue; less commonly, lymph nodes; gonads and kidney are spared</p>\r\n</td>\r\n<td style=\"width: 144.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Localized or disseminated</p>\r\n<p class=\"TableText\">Any organ or tissue; skeleton &gt;&nbsp;95%, cardiovascular &gt;&nbsp;50%, CNS and retroperitoneum 20&ndash;30%; skin manifestations may predominate</p>\r\n</td>\r\n<td style=\"width: 144.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Systemic form involving liver, spleen, bone marrow, and/or additional sites such as skin and CNS</p>\r\n<p class=\"TableText\">Multisystem and single-system forms can involve many different sites, most commonly central and peripheral nervous system, skin, breast, bone, and lung</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 124.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"166\">\r\n<p class=\"TableText\"><strong>Lesional cells</strong></p>\r\n</td>\r\n<td style=\"width: 144.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Large histiocytes with round to oval vesicular nuclei with prominent nucleoli, abundant pale cytoplasm with indistinct borders and emperipolesis; minimal atypia and mitotic activity (Ki-67 &lt;&nbsp;10%)</p>\r\n</td>\r\n<td style=\"width: 144.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Oval histiocytes with grooved, folded, or lobed nuclei with fine chromatin and delicate nuclear membranes, inconspicuous nucleoli, and moderate amount of eosinophilic cytoplasm; minimal atypia although mitoses may be abundant</p>\r\n</td>\r\n<td style=\"width: 144.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Histiocytes with single small nuclei and foamy, occasionally eosinophilic cytoplasm; frequent Touton giant cells</p>\r\n</td>\r\n<td style=\"width: 144.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Large histiocytes with irregularly folded nuclei, fine chromatin, and abundant eosinophilic cytoplasm, sometimes with minor emperipolesis</p>\r\n<p class=\"TableText\">Histiocytes can be spindled or foamy, with or without admixed Touton giant cells</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 124.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"166\">\r\n<p class=\"TableText\"><strong>Immune microenvironment</strong></p>\r\n</td>\r\n<td style=\"width: 144.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Plasma cells, lymphocytes; less commonly, neutrophils; eosinophils absent</p>\r\n</td>\r\n<td style=\"width: 144.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Eosinophils, macrophages, neutrophils, small lymphocytes</p>\r\n</td>\r\n<td style=\"width: 144.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Small lymphocytes, plasma cells, neutrophils</p>\r\n</td>\r\n<td style=\"width: 144.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Small lymphocytes, plasma cells</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 124.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"166\">\r\n<p class=\"TableText\"><strong>Immunohistochemical profile</strong></p>\r\n</td>\r\n<td style=\"width: 144.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Positive for S100, OCT2, phosphorylated ERK, cyclin&nbsp;D1</p>\r\n<p class=\"TableText\">Variable CD14, CD68, CD163</p>\r\n<p class=\"TableText\">Lacks CD1a, CD207, BRAF p.V600E</p>\r\n</td>\r\n<td style=\"width: 144.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Positive for S100, CD1a, CD207, CD68, CD163, and (commonly) BRAF p.V600E</p>\r\n</td>\r\n<td style=\"width: 144.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Positive for CD68, CD163, CD14, factor XIIIa, and (commonly) BRAF p.V600E</p>\r\n<p class=\"TableText\">Lacks S100 (rare positive), CD1a, CD207</p>\r\n</td>\r\n<td style=\"width: 144.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">Positive for ALK (cytoplasmic or membranous), CD68, CD163, factor XIIIa, S100 (50%)</p>\r\n<p class=\"TableText\">Lacks CD1a, CD207, BRAF p.V600E</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 124.85pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"166\">\r\n<p class=\"TableText\"><strong>Genetic profile</strong></p>\r\n</td>\r\n<td style=\"width: 144.6pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\">MAPK/ERK pathway mutations (40&ndash;50%): <em>KRAS</em>, <em>NRAS</em>, <em>MAP2K1</em>, <em>ARAF</em>, and <em>CSF1R</em>; rarely <em>BRAF</em> p.V600E mutations</p>\r\n</td>\r\n<td style=\"width: 144.6pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\"><em>BRAF</em> p.V600E, <em>MAP2K1</em>, <em>ARAF</em> mutations; IGH, IGK, TR&nbsp;gene rearrangements may be present</p>\r\n</td>\r\n<td style=\"width: 144.6pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\"><em><span lang=\"PT\">BRAF</span></em><span lang=\"PT\"> p.V600E, <em>MAP2K1</em>, <em>KRAS</em>, <em>NRAS</em>, <em>ARAF</em>, <em>PIK3CA</em> mutations</span></p>\r\n</td>\r\n<td style=\"width: 144.65pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"193\">\r\n<p class=\"TableText\"><em>KIF5B</em>::<em>ALK</em> gene fusion in majority</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p>&nbsp;</p>",

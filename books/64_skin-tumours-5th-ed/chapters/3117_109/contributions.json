[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 125571,
        "bookId": 64,
        "chapterId": 109,
        "headingId": 764,
        "headingText": "\r\n<p>Cylindroma is a benign adnexal neoplasm with a mosaic microscopic pattern. Cylindroma commonly occurs as a hybrid with spiradenoma, a phenomenon that has been referred to as cylindrospiradenoma or spiradenocylindroma.</p>\r\n",
        "timestamp": "2025-04-24T17:48:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 125572,
        "bookId": 64,
        "chapterId": 109,
        "headingId": 765,
        "headingText": "\r\n<p>8200/0 Cylindroma</p>\r\n<p>8200/0 Cylindrospiradenoma/spiradenocylindroma</p>\r\n",
        "timestamp": "2025-04-24T17:48:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 125573,
        "bookId": 64,
        "chapterId": 109,
        "headingId": 766,
        "headingText": "\r\n<p>2F22 &amp; XH6J91 Benign neoplasms of epidermal appendages &amp; Cylindroma of skin</p>\r\n<p>2F22 &amp; XH5GN1 Benign neoplasms of epidermal appendages &amp; Eccrine dermal cylindroma</p>\r\n",
        "timestamp": "2025-04-24T17:48:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 767,

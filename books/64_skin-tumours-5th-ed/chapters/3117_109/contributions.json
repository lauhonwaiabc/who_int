    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 125587,
        "bookId": 64,
        "chapterId": 109,
        "headingId": 778,
        "headingText": "\r\n<p>Cylindroma is a benign neoplasm.</p>",
        "timestamp": "2025-04-24T17:48:20"
      }
    ],

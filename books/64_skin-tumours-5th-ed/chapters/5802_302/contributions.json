    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 769,
    "contributions": [
      {
        "pkcontributionId": 127772,
        "bookId": 64,
        "chapterId": 302,
        "headingId": 769,
        "headingText": "\r\n<p>Papillary haemangioma occurs almost exclusively on the head and neck {17927585; 31592865}.</p>\r\n",
        "timestamp": "2025-04-25T11:59:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 127773,
        "bookId": 64,
        "chapterId": 302,
        "headingId": 770,
        "headingText": "\r\n<p>Papillary haemangioma appears as a solitary, longstanding, bluish-red papule as large as 11&nbsp;mm in diameter.</p>\r\n",
        "timestamp": "2025-04-25T11:59:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 828,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 771,
    "contributions": [
      {
        "pkcontributionId": 127774,
        "bookId": 64,
        "chapterId": 302,
        "headingId": 771,
        "headingText": "\r\n<p>It is most common in adult men.</p>\r\n",
        "timestamp": "2025-04-25T11:59:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

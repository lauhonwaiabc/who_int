      {
        "pkcontributionId": 127767,
        "bookId": 64,
        "chapterId": 302,
        "headingId": 764,
        "headingText": "\r\n<p>Papillary haemangioma is a distinctive vascular proliferation consisting of dilated vascular channels with prominent intraluminal papillary projections lined by endothelial cells, many of which contain intracytoplasmic globules.</p>\r\n",
        "timestamp": "2025-04-25T11:59:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

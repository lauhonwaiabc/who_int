    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 93.44%; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"93%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 17.4%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"17%\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 41.3%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"41%\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Low risk</span></strong></p>\r\n</td>\r\n<td style=\"width: 41.3%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"41%\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">High risk</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 17.4%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"17%\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">Histological type</span></strong></p>\r\n</td>\r\n<td style=\"width: 41.3%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"41%\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Superficial</span></p>\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Nodular, including pigmented and keratotic patterns</span></p>\r\n<p class=\"TableText\"><span styl
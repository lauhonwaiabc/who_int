  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127951,
        "bookId": 64,
        "chapterId": 259,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> plaques with verrucous epidermal hyperplasia overlying dilated vascular channels in the dermis, with an associated subcutaneous component.</p>\r\n",
        "timestamp": "2025-04-25T12:04:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T12:04:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127953,
        "bookId": 64,
        "chapterId": 259,
        "headingId": 778,
        "headingText": "\r\n<p>Verrucous venous malformation shows persistence and slow expansion following incomplete excision.</p>",
        "timestamp": "2025-04-25T12:04:29"
      }
    ],

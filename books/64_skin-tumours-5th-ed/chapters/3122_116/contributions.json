      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 125687,
        "bookId": 64,
        "chapterId": 116,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a sclerotic plaque or (sometimes) a nodule or cystic tumour; an infiltrative neoplasm with a desmoplastic stroma composed of strands and nests of bland cells with variable formation of cysts and ducts and no mitotic activity.</p>\r\n<p><em>Desirable:</em> perineural invasion.</p>\r\n",
        "timestamp": "2025-04-24T17:57:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 125688,
        "bookId": 64,
        "chapterId": 116,
        "headingId": 777,
        "headingText": "\r\n<p>Staging follows the eighth edition of the Union for International Cancer Control (UICC) TNM classification.</p>\r\n",
        "timestamp": "2025-04-24T17:57:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 125689,
        "bookId": 64,
        "chapterId": 116,
        "headingId": 778,
        "headingText": "\r\n<p>The tumours are locally aggressive and capable of involving deep underlying tissue, including bone. When incompletely excised, microcystic adnexal carcinoma is associated with frequent recurrence, but regional lymph node and distant metastases are rare {11074698; 10426893; 16549917; 11298716}.</p>",
        "timestamp": "2025-04-24T17:57:27"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
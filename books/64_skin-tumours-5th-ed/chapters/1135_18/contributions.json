        "bookId": 64,
        "chapterId": 18,
        "headingId": 766,
        "headingText": "\r\n<p>2F21.Y &amp; XH7AQ2 Other specified benign keratinocytic acanthomas &amp; Large cell acanthoma</p>\r\n",
        "timestamp": "2025-04-24T14:18:20"
      }
    ],

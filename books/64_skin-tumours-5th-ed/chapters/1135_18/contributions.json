  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 124358,
        "bookId": 64,
        "chapterId": 18,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a sharply demarcated intraepidermal keratinocytic proliferation showing mild acanthosis and containing enlarged keratinocytes, in the absence of squamous dysplasia.</p>\r\n",
        "timestamp": "2025-04-24T14:18:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

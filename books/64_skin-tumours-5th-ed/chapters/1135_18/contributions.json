    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 124344,
        "bookId": 64,
        "chapterId": 18,
        "headingId": 764,
        "headingText": "\r\n<p>Large cell acanthomas are benign intraepidermal keratinocytic proliferations on a morphological spectrum with solar lentigines and early seborrhoeic keratoses.</p>\r\n",
        "timestamp": "2025-04-24T14:18:20"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

      {
        "pkcontributionId": 127423,
        "bookId": 64,
        "chapterId": 308,
        "headingId": 776,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2025-04-25T09:45:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127424,
        "bookId": 64,
        "chapterId": 308,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> short intersecting fascicles of bland spindled cells in the reticular dermis.</p>\r\n<p><em>Desirable:</em> often associated with adipocytes in the dermis and epidermal papillomatosis; absence of <em>COL1A1</em>::<em>PDGFB</em> fusion (to rule out plaque-stage dermatofibrosarcoma protuberans).</p>\r\n",
        "timestamp": "2025-04-25T09:45:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 127425,
        "bookId": 64,
        "chapterId": 308,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T09:45:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127426,
        "bookId": 64,
        "chapterId": 308,
        "headingId": 778,
        "headingText": "\r\n<p>Neither local recurrence nor distant metastasis have yet been reported. Spontaneous partial regression has been reported {32189366; 28067672}.</p>",
        "timestamp": "2025-04-25T09:45:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

        "bookId": 64,
        "chapterId": 308,
        "headingId": 765,
        "headingText": "\r\n<p>8810/0 Fibroblastic connective tissue naevus</p>\r\n",
        "timestamp": "2025-04-25T09:45:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 127412,
        "bookId": 64,
        "chapterId": 308,
        "headingId": 766,
        "headingText": "\r\n<p>2B53.1 Fibroblastic or myofibroblastic tumour of skin</p>\r\n",
        "timestamp": "2025-04-25T09:45:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,

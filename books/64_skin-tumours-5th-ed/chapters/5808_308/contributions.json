[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127410,
        "bookId": 64,
        "chapterId": 308,
        "headingId": 764,
        "headingText": "\r\n<p>Fibroblastic connective tissue naevus (FCTN) is a benign dermal-based mesenchymal lesion of fibroblastic/myofibroblastic lineage composed of short intersecting fascicles of bland spindled cells.</p>\r\n",
        "timestamp": "2025-04-25T09:45:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

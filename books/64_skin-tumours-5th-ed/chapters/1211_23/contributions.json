        "pkcontributionId": 124429,
        "bookId": 64,
        "chapterId": 23,
        "headingId": 764,
        "headingText": "\r\n<p>Nodular basal cell carcinoma (BCC) is the most common BCC type and is defined by well-circumscribed large dermal tumour islands with peripheral palisading.</p>\r\n",
        "timestamp": "2025-04-24T14:35:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0

  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 124443,
        "bookId": 64,
        "chapterId": 23,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> well-circumscribed, variably sized nodules of basaloid cells with peripheral palisading.</p>\r\n",
        "timestamp": "2025-04-24T14:35:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 124444,
        "bookId": 64,
        "chapterId": 23,
        "headingId": 777,
        "headingText": "\r\n<p>Staging is according to the eighth edition of the Union for International Cancer Control (UICC)&nbsp;/ American Joint Committee on Cancer (AJCC) TNM system.</p>\r\n",
        "timestamp": "2025-04-24T14:35:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 124445,
        "bookId": 64,
        "chapterId": 23,
        "headingId": 778,
        "headingText": "\r\n<p>Prognostic and predictive factors include tumour location, tumour size, and patient immune status. After complete surgical excision, recurrence and metastasis are exceedingly rare.</p>",
        "timestamp": "2025-04-24T14:35:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

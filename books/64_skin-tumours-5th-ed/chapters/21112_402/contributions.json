        "pkcontributionId": 124936,
        "bookId": 64,
        "chapterId": 402,
        "headingId": 775,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2025-04-24T16:44:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 833,

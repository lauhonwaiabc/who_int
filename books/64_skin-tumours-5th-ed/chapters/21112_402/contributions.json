        "bookId": 64,
        "chapterId": 402,
        "headingId": 776,
        "headingText": "\r\n<p>Identification of the ACT::<em>MITF</em> or <em>MITF</em>::<em>CREM</em> rearrangement.</p>\r\n",
        "timestamp": "2025-04-24T16:44:53"
      }
    ],
    "booknotes": [],

  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 124940,
        "bookId": 64,
        "chapterId": 402,
        "headingId": 778,
        "headingText": "\r\n<p>Current evidence suggests an indolent course for tumours with actin fusions, whereas the number of cases with <em>CREM</em> rearrangements is currently too small to assess.</p>",
        "timestamp": "2025-04-24T16:44:53"
      }
    ],

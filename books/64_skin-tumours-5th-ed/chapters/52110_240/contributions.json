        "headingId": 777,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2025-04-25T10:02:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127596,
        "bookId": 64,
        "chapterId": 240,
        "headingId": 778,
        "headingText": "\r\n<p>Plaque-like CD34-positive dermal fibroma is a benign tumour {20061935}. Complete excision is curative {26645569; 28750558}. Recurrences have not been reported.</p>",
        "timestamp": "2025-04-25T10:02:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127594,
        "bookId": 64,
        "chapterId": 240,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a band-like proliferation of uniform fibroblasts in the upper and mid dermis; diffuse CD34 positivity; multiple dilated venules throughout the neoplasm.</p>\r\n",
        "timestamp": "2025-04-25T10:02:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "bookId": 64,
        "chapterId": 24,
        "headingId": 772,
        "headingText": "\r\n<p>See the family description (<a style=\"cursor:pointer\" href=\"/chaptercontent/64/22\" target=\"_blank\">section </a><em>Basal cell carcinomas</em>).</p>\r\n",
        "timestamp": "2025-04-24T14:30:33"

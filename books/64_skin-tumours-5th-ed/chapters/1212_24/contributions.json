  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 124426,
        "bookId": 64,
        "chapterId": 24,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> lobules of basaloid cells with peripheral palisading extend from the base of the epidermis into the papillary dermis.</p>\r\n",

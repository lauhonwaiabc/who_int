[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 124412,
        "bookId": 64,
        "chapterId": 24,
        "headingId": 764,
        "headingText": "\r\n<p>Superficial basal cell carcinoma (BCC) is a type of BCC, often with multifocal epidermal connection, that is confined to the papillary dermis.</p>\r\n",
        "timestamp": "2025-04-24T14:30:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,

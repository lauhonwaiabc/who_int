  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 124428,
        "bookId": 64,
        "chapterId": 24,
        "headingId": 778,
        "headingText": "\r\n<p>Superficial BCC is considered to have a low risk of recurrence and a negligible risk of metastasis (see <a style=\"cursor:pointer\" href=\"/chaptercontent/64/22\" target=\"_blank\">section </a><em>Basal cell carcinomas</em>).</p>",
        "timestamp": "2025-04-24T14:30:33"
      }

      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 125995,
        "bookId": 64,
        "chapterId": 139,
        "headingId": 778,
        "headingText": "\r\n<p>Melanocytic matricoma is benign. A few cases with more-prominent melanocytic and matrical atypia have been reported as malignant melanocytic matricoma {14631189; 21252635; 26730694; 30785652}, but their biological behaviour has not yet been well characterized.</p>",
        "timestamp": "2025-04-24T18:23:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
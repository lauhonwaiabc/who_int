  },
  {
    "pkheadingid": 826,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 769,
    "contributions": [
      {
        "pkcontributionId": 125984,
        "bookId": 64,
        "chapterId": 139,
        "headingId": 769,
        "headingText": "\r\n<p>The head and neck are the most frequent sites for this tumour, followed by the trunk and the limbs.</p>\r\n",
        "timestamp": "2025-04-24T18:23:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 125985,
        "bookId": 64,
        "chapterId": 139,
        "headingId": 770,
        "headingText": "\r\n<p>Melanocytic matricoma appears as a solitary, pigmented, purple or brownish-black papule or nodule. The surface may be ulcerated or crusted, and the lesion may be painful {24641267}.</p>\r\n",
        "timestamp": "2025-04-24T18:23:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 828,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 771,
    "contributions": [
      {
        "pkcontributionId": 125986,
        "bookId": 64,
        "chapterId": 139,
        "headingId": 771,
        "headingText": "\r\n<p>Melanocytic matricoma is rare, with only about 25&nbsp;cases reported {10446775}, predominantly in elderly men.</p>\r\n",
        "timestamp": "2025-04-24T18:23:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

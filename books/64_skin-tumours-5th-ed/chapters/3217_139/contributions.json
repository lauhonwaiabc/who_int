[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 125979,
        "bookId": 64,
        "chapterId": 139,
        "headingId": 764,
        "headingText": "\r\n<p>Melanocytic matricoma is a benign adnexal neoplasm recapitulating the bulb of the anagen hair follicle, composed of neoplastic aggregates of matrical and supramatrical cells and numerous intratumoural pigmented dendritic melanocytes.</p>\r\n",
        "timestamp": "2025-04-24T18:23:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

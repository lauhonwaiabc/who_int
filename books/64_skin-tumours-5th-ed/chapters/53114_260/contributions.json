  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127968,
        "bookId": 64,
        "chapterId": 260,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> superficial or deep vascular proliferation consisting of capillaries, arterioles, and venules associated with larger-calibre arteries and veins.</p>\r\n",
        "timestamp": "2025-04-25T12:04:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 127969,
        "bookId": 64,
        "chapterId": 260,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T12:04:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127970,
        "bookId": 64,
        "chapterId": 260,
        "headingId": 778,
        "headingText": "\r\n<p>Incompletely excised lesions recur, often with recruitment of new collateral flow through the residual AVM nidus.</p>",
        "timestamp": "2025-04-25T12:04:55"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 125074,
        "bookId": 64,
        "chapterId": 67,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a brown to black macule or papule of acral skin; proliferation of benign melanocytes on histology.</p>\r\n",
        "timestamp": "2025-04-24T16:57:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 125075,
        "bookId": 64,
        "chapterId": 67,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-24T16:57:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 125076,
        "bookId": 64,
        "chapterId": 67,
        "headingId": 778,
        "headingText": "\r\n<p>Acral naevi are benign, and progression to melanoma is very rare. NMN in children initially shows a rapid widening and colour variegation and may undergo spontaneous regression by adolescence {8053713; 8632071; 26806608; 31850539}.</p>",
        "timestamp": "2025-04-24T16:57:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
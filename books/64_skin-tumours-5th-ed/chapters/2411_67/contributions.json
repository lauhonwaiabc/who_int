        "chapterId": 67,
        "headingId": 775,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2025-04-24T16:57:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

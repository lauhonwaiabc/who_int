        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2025-04-25T12:03:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127919,
        "bookId": 64,
        "chapterId": 343,
        "headingId": 778,
        "headingText": "\r\n<p>Lesions are indolent and persist despite treatment.</p>",

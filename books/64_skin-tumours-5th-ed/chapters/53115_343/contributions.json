  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127917,
        "bookId": 64,
        "chapterId": 343,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a proliferation of numerous small blood vessels with bland endothelium in the superficial dermis; concomitant loss or attenuation of elastic fibres.</p>\r\n<p><em>Desirable:</em> a lower-extremity, slowly growing erythematous or violaceous plaque.</p>\r\n",
        "timestamp": "2025-04-25T12:03:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

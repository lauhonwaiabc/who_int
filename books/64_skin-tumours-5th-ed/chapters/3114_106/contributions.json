        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-24T17:45:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 125536,
        "bookId": 64,
        "chapterId": 106,
        "headingId": 778,
        "headingText": "\r\n<p>Syringofibroadenoma is a benign condition.</p>",
        "timestamp": "2025-04-24T17:45:17"
      }
    ],

  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 125534,
        "bookId": 64,
        "chapterId": 106,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> ductal epithelial hyperplasia in a fenestrated pattern, embedded in a loose myxoid stroma.</p>\r\n",
        "timestamp": "2025-04-24T17:45:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

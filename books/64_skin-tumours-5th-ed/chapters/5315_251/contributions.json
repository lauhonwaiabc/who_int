[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127750,
        "bookId": 64,
        "chapterId": 251,
        "headingId": 764,
        "headingText": "\r\n<p>Glomeruloid haemangioma is a reactive vascular proliferation associated with multicentric Castleman disease and POEMS syndrome (polyradiculoneuropathy, organomegaly, endocrinopathy, clonal plasma cell disorder, and skin changes).</p>\r\n",
        "timestamp": "2025-04-25T11:56:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 127751,
        "bookId": 64,
        "chapterId": 251,
        "headingId": 765,
        "headingText": "\r\n<p>9120/0 Glomeruloid haemangioma</p>\r\n",
        "timestamp": "2025-04-25T11:56:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 127752,
        "bookId": 64,
        "chapterId": 251,
        "headingId": 766,
        "headingText": "\r\n<p>2F2Y &amp; XH9NB0 Other specified benign cutaneous neoplasms &amp; Glomeruloid haemangioma</p>\r\n",
        "timestamp": "2025-04-25T11:56:49"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 767,
    "contributions": [
      {

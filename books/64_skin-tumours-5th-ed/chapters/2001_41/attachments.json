    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 547.75pt; background: #DAEEF3; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"730\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 547.75pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"730\">\r\n<p class=\"TableText\">Melanomas arising in sun-exposed skin</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 519.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" width=\"693\">\r\n<p class=\"TableText\">Pathway&nbsp;I: Low-CSD melanoma (including superficial spreading melanoma)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 519.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" width=\"693\">\r\n<p class=\"TableText\">Pathway&nbsp;II: High-CSD melanoma (including lentigo maligna melanoma)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 519.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" width=\"693\">\r\n<p class=\"TableText\">Pathway&nbsp;III: Desmoplastic melanoma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 547.75pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"730\">\r\n<p class=\"TableText\">Melanomas arising at sun-shielded sites or without known etiological associations with UV radiation exposure</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 519.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" width=\"693\">\r\n<p class=\"TableText\">Pathway&nbsp;IV: Spitz melanoma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 519.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" width=\"693\">\r\n<p class=\"TableText\">Pathway&nbsp;V: Acral melanoma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 519.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" width=\"693\">\r\n<p class=\"TableText\">Pathway&nbsp;VI: Mucosal melanoma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 519.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" width=\"693\">\r\n<p class=\"TableText\">Pathway&nbsp;VII: Melanoma arising in congenital naevus</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 519.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" width=\"693\">\r\n<p class=\"TableText\">Pathway&nbsp;VIII: Melanoma arising in blue naevus</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 519.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" width=\"693\">\r\n<p class=\"TableText\">Pathway&nbsp;IX: Uveal melanoma</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 11; mso-yfti-lastrow: yes; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 519.4pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" width=\"693\">\r\n<p class=\"TableText\">Pathway X: Melanoma arising in the CNS</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p>&nbsp;</p>\r\n<p class=\"TableText\">Low/high-CSD melanoma, melanoma in skin with a low/high degree of cumulative sun damage; UV, ultraviolet.</p>",

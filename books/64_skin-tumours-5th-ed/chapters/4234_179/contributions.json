[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 126575,
        "bookId": 64,
        "chapterId": 179,
        "headingId": 764,
        "headingText": "\r\n<p>ALK-positive histiocytosis is a histiocytic neoplasm lacking high-grade cytological atypia and characterized by anaplastic lymphoma kinase (ALK) immunoreactivity, usually due to <em>ALK</em> gene rearrangement.</p>\r\n",
        "timestamp": "2025-04-25T08:45:15"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

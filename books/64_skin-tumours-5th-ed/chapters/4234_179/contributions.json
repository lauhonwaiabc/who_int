    "contributions": [
      {
        "pkcontributionId": 126576,
        "bookId": 64,
        "chapterId": 179,
        "headingId": 765,
        "headingText": "\r\n<p>9750/3 ALK-positive histiocytosis</p>\r\n",
        "timestamp": "2025-04-25T08:45:15"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 126577,
        "bookId": 64,
        "chapterId": 179,
        "headingId": 766,
        "headingText": "\r\n<p>EK92 Histiocytoses of uncertain malignant potential</p>\r\n",
        "timestamp": "2025-04-25T08:45:15"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 767,
    "contributions": [
      {
        "pkcontributionId": 126578,
        "bookId": 64,
        "chapterId": 179,
        "headingId": 767,
        "headingText": "\r\n<p><em>Acceptable:</em> ALK-related histiocytosis; <em>ALK</em>-rearranged histiocytosis.</p>\r\n",
        "timestamp": "2025-04-25T08:45:15"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 825,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 768,

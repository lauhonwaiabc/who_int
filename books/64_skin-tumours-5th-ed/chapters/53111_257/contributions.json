    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127885,
        "bookId": 64,
        "chapterId": 257,
        "headingId": 778,
        "headingText": "\r\n<p>Most RICHs involute spontaneously, and NICHs tend to persist. Persistent congenital non-progressive haemangiomas often require surgical or laser intervention.</p>",
        "timestamp": "2025-04-25T12:02:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127883,
        "bookId": 64,
        "chapterId": 257,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a congenital lesion; dermal and/or subcutaneous lobules of capillaries lined by endothelial cells that are negative for GLUT1.</p>\r\n",
        "timestamp": "2025-04-25T12:02:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127818,
        "bookId": 64,
        "chapterId": 254,
        "headingId": 764,
        "headingText": "\r\n<p>Tufted haemangioma is a benign cutaneous vascular tumour sometimes associated with Kasabach&ndash;Merritt syndrome and now widely considered part of the kaposiform haemangioendothelioma spectrum.</p>\r\n",
        "timestamp": "2025-04-25T12:01:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,

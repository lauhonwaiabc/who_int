  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127832,
        "bookId": 64,
        "chapterId": 254,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> tufts of capillaries scattered throughout the dermis, with frequent crescent-like lymphatic vessels around tumour lobules.</p>\r\n",
        "timestamp": "2025-04-25T12:01:19"
      }
    ],

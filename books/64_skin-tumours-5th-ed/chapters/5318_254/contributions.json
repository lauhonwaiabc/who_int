  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127834,
        "bookId": 64,
        "chapterId": 254,
        "headingId": 778,
        "headingText": "\r\n<p>Tufted haemangioma is benign, but patients with large tumours may develop Kasabach&ndash;Merritt syndrome, which may be life-threatening.</p>",
        "timestamp": "2025-04-25T12:01:19"
      }
    ],

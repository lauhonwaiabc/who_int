        "bookId": 64,
        "chapterId": 254,
        "headingId": 766,
        "headingText": "\r\n<p>2F2Y &amp; XH2EX4 Other specified benign cutaneous neoplasms &amp; Acquired tufted haemangioma</p>\r\n",
        "timestamp": "2025-04-25T12:01:19"
      }

    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 126046,
        "bookId": 64,
        "chapterId": 136,
        "headingId": 778,
        "headingText": "\r\n<p>Trichofolliculoma is a benign lesion with recurrence only in exceptional cases {24021443; 27608202}.</p>",
        "timestamp": "2025-04-24T18:27:31"
      }
    ],

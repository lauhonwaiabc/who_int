[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 126030,
        "bookId": 64,
        "chapterId": 136,
        "headingId": 764,
        "headingText": "\r\n<p>Trichofolliculoma is a cystic lesion with panfollicular differentiation, consisting of a central dilated follicular infundibulum from which several smaller secondary hair follicles radiate into the surrounding dermis.</p>\r\n",
        "timestamp": "2025-04-24T18:27:31"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

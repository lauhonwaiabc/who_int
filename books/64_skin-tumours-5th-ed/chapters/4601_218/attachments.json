    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 703.3pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"938\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"151\">&nbsp;</td>\r\n<td style=\"width: 294.95pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"393\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Single-system</span></strong></p>\r\n</td>\r\n<td style=\"width: 147.45pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">MR</span></strong></p>\r\n</td>\r\n<td style=\"width: 147.5pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">RHC-AHN</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 148.85pt; border: none; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Single focal (SCR)</span></strong></p>\r\n</td>\r\n<td style=\"width: 146.1pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"195\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Multifocal (GCR)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">Median age (range)</span></strong></p>\r\n</td>\r\n<td style=\"width: 148.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">35&nbsp;years (2&ndash;74&nbsp;years)</span></p>\r\n</td>\r\n<td style=\"width: 146.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"195\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">46&nbsp;years (8&ndash;68&nbsp;years)</span></p>\r\n</td>\r\n<td style=\"width: 147.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">47&nbsp;years (8&ndash;74&nbsp;years)</span></p>\r\n</td>\r\n<td style=\"width: 147.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">59&nbsp;years (22&ndash;84&nbsp;years)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">M:F&nbsp;ratio</span></strong></p>\r\n</td>\r\n<td style=\"width: 148.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">1.5:1</span></p>\r\n</td>\r\n<td style=\"width: 146.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"195\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">1:2</span></p>\r\n</td>\r\n<td style=\"width: 147.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">1:3</span></p>\r\n</td>\r\n<td style=\"width: 147.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">8:1</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">Possible etiology</span></strong></p>\r\n</td>\r\n<td style=\"width: 148.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">Reactive</span></p>\r\n</td>\r\n<td style=\"width: 146.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"195\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">Reactive</span></p>\r\n</td>\r\n<td style=\"width: 147.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">Systemic inflammatory disorder&nbsp;/ paraneoplastic</span></p>\r\n</td>\r\n<td style=\"width: 147.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">Myeloid neoplasm</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Prognosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 148.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Very good</span></p>\r\n</td>\r\n<td style=\"width: 146.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"195\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Good</span></p>\r\n</td>\r\n<td style=\"width: 147.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Depending on joint involvement</span></p>\r\n</td>\r\n<td style=\"width: 147.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Depending on the AHN</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">Skin involvement</span></strong></p>\r\n</td>\r\n<td style=\"width: 148.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">Single papules or nodules</span></p>\r\n</td>\r\n<td style=\"width: 146.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"195\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">Diffuse papular-nodular eruption</span></p>\r\n</td>\r\n<td style=\"width: 147.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">Juxta-articular&nbsp;/ head and neck papules</span></p>\r\n</td>\r\n<td style=\"width: 147.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">Generally diffuse papular-nodular eruption</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Joint involvement</span></strong></p>\r\n</td>\r\n<td style=\"width: 148.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">No</span></p>\r\n</td>\r\n<td style=\"width: 146.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"195\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">No</span></p>\r\n</td>\r\n<td style=\"width: 147.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Yes</span></p>\r\n</td>\r\n<td style=\"width: 147.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">No</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">Organomegaly</span></strong></p>\r\n</td>\r\n<td style=\"width: 148.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">No</span></p>\r\n</td>\r\n<td style=\"width: 146.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"195\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">No</span></p>\r\n</td>\r\n<td style=\"width: 147.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">No</span></p>\r\n</td>\r\n<td style=\"width: 147.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">Present in half of cases</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Associated cancers</span></strong></p>\r\n</td>\r\n<td style=\"width: 148.85pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">No</span></p>\r\n</td>\r\n<td style=\"width: 146.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"195\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">No</span></p>\r\n</td>\r\n<td style=\"width: 147.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Epithelial cancers in 30% of cases</span></p>\r\n</td>\r\n<td style=\"width: 147.5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Always associated with haematological neoplasms (characteristically of myeloid origin)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">Genetic alterations</span></strong></p>\r\n</td>\r\n<td style=\"width: 148.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">n.d.</span></p>\r\n</td>\r\n<td style=\"width: 146.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"195\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">n.d.</span></p>\r\n</td>\r\n<td style=\"width: 147.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><em><span style=\"mso-fareast-font-family: Aptos;\">MAP2K1</span></em><span style=\"mso-fareast-font-family: Aptos;\"> and <em>TET2</em> mutations</span></p>\r\n</td>\r\n<td style=\"width: 147.5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos;\">t(1;9)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 11; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 4.0cm; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Clinical differential diagnosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 148.85pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"198\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Xanthogranuloma</span></p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Cutaneous Rosai&ndash;Dorfman disease</span></p>\r\n</td>\r\n<td style=\"width: 146.1pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"195\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Xanthogranuloma</span></p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Cutaneous Rosai&ndash;Dorfman disease</span></p>\r\n</td>\r\n<td style=\"width: 147.45pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Clinically unmistakable</span></p>\r\n</td>\r\n<td style=\"width: 147.5pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"197\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">LCH/ECD AHN</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">AHN, associated haematological neoplasm; ECD, Erdheim&ndash;Chester disease; GCR, generalized cutaneous reticulohistiocytosis; LCH, Langerhans cell histiocytosis; MR, multicentric reticulohistiocytosis; n.d., not determined; RHC-AHN, reticulohistiocytosis with an associated haematological neoplasm; SCR, solitary cutaneous reticulohistiocytosis.</span></p>",

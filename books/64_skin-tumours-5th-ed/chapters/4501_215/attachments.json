  {
    "pkattachmentId": 64068,
    "bookid": 64,
    "chapterId": 215,
    "fileId": 38447,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Differential diagnosis of lymphomas with cutaneous presentation</p>",
    "legend": "",
    "source": "",
    "copyright": "Chan JKC, Ng SB and Kempf W",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 703.3pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"938\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 200.1pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"267\">\r\n<p class=\"TableText\"><strong>Disease entity</strong></p>\r\n</td>\r\n<td style=\"width: 503.2pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"671\">\r\n<p class=\"TableText\"><strong>Major distinguishing features versus ENKTL</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 200.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"267\">\r\n<p class=\"TableText\"><strong>Subcutaneous panniculitis-like T-cell lymphoma</strong></p>\r\n</td>\r\n<td style=\"width: 503.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"671\">\r\n<p class=\"TableText\">In the skin, preferential infiltration of subcutaneous tissue with sparing of the dermis</p>\r\n<p class=\"TableText\">Often CD8+, CD56&minus;, TCR&alpha;&beta;+</p>\r\n<p class=\"TableText\">EBV negative</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 200.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"267\">\r\n<p class=\"TableText\"><strong>Primary cutaneous gamma-delta T-cell lymphoma</strong></p>\r\n</td>\r\n<td style=\"width: 503.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"671\">\r\n<p class=\"TableText\">Expression of TCR&gamma;&delta; by definition, contrasting with its extreme rarity in ENKTL</p>\r\n<p class=\"TableText\">EBV usually negative</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 200.1pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"267\">\r\n<p class=\"TableText\"><strong>Lymphomatoid granulomatosis</strong></p>\r\n</td>\r\n<td style=\"width: 503.2pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"671\">\r\n<p class=\"TableText\">Predilection sites are lung, brain, kidney, and skin (all uncommonly involved in ENKTL, except skin)</p>\r\n<p class=\"TableText\">Atypical cells are of B&nbsp;lineage</p>\r\n<p class=\"TableText\">EBV positive in B&nbsp;cells</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">ENKTL, extranodal NK/T-cell lymphoma.</p>",
    "imageUrl": null,
    "thumbnail": null
  },
  {
    "pkattachmentId": 64069,
    "bookid": 64,
    "chapterId": 215,
    "fileId": 38448,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Differential diagnosis of other EBV-positive NK/T-cell lymphoproliferative diseases with cutaneous involvement</p>",
    "legend": "",
    "source": "",
    "copyright": "Chan JKC, Ng SB, and Kempf W",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 23.0cm; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"869\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 127.6pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\"><strong>Disease entities</strong></p>\r\n</td>\r\n<td style=\"width: 524.45pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"699\">\r\n<p class=\"TableText\"><strong>Major distinguishing features versus extranodal NK/T-cell lymphoma</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 127.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"4\" width=\"170\">\r\n<p class=\"TableText\"><strong>Aggressive NK-cell leukaemia</strong></p>\r\n</td>\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"699\">\r\n<p class=\"TableText\">Young adults</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">Presentation with systemic disease, including hepatosplenomegaly, haemophagocytic lymphohistiocytosis</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">No nasal involvement</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">NK-cell lineage by definition</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 127.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"4\" width=\"170\">\r\n<p class=\"TableText\"><strong>Systemic EBV-positive T-cell lymphoma of childhood</strong></p>\r\n</td>\r\n<td style=\"width: 524.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"699\">\r\n<p class=\"TableText\">Paediatric and adolescent age group</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">Presentation with systemic disease, including hepatosplenomegaly, haemophagocytic lymphohistiocytosis</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">No nasal involvement</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">T-cell lineage</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"width: 127.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"4\" width=\"170\">\r\n<p class=\"TableText\"><strong>Systemic chronic active EBV disease</strong></p>\r\n</td>\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"699\">\r\n<p class=\"TableText\">Paediatric and adolescent age group</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">Presentation with systemic disease, including hepatosplenomegaly, haemophagocytic lymphohistiocytosis</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 11; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">No nasal involvement</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 12; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">T-cell or NK-cell lineage</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 13; page-break-inside: avoid;\">\r\n<td style=\"width: 127.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"4\" width=\"170\">\r\n<p class=\"TableText\"><strong>Severe mosquito bite allergy </strong></p>\r\n</td>\r\n<td style=\"width: 524.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"699\">\r\n<p class=\"TableText\">Paediatric and adolescent age group</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 14; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">High fever and severe skin manifestations after mosquito bites</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 15; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">No nasal involvement</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 16; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">Most commonly NK-cell lineage, but some cases with a T-cell phenotype</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 17; page-break-inside: avoid;\">\r\n<td style=\"width: 127.6pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"5\" width=\"170\">\r\n<p class=\"TableText\"><strong>Hydroa vacciniforme lymphoproliferative disorder (HV-LPD)</strong></p>\r\n</td>\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"699\">\r\n<p class=\"TableText\">Paediatric and adolescent age group</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 18; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">Classic HV-LPD: recurring papulovesicular eruptions on sun-exposed skin that usually evolve to blisters and ulcers, leaving varioliform scars</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 19; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">Systemic HV-LPD: cutaneous eruption with fever, hepatosplenomegaly, and lymphadenopathy</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 20; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">No nasal involvement</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 21; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 524.45pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"699\">\r\n<p class=\"TableText\">Most commonly CD8+ T-cell immunophenotype, but some cases with a CD56+ NK-cell phenotype</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
    "imageUrl": null,
    "thumbnail": null
  }
]
        "timestamp": "2025-04-25T14:36:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 128157,
        "bookId": 64,
        "chapterId": 273,
        "headingId": 778,
        "headingText": "\r\n<p>Myopericytoma is benign and non-recurring, even after marginal excision.</p>",
        "timestamp": "2025-04-25T14:36:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

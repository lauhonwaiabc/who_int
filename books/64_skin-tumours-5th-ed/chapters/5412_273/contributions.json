  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 128155,
        "bookId": 64,
        "chapterId": 273,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a dermal or subcutaneous nodule with concentric perivascular growth of bland myoid cells.</p>\r\n",
        "timestamp": "2025-04-25T14:36:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 128141,
        "bookId": 64,
        "chapterId": 273,
        "headingId": 764,
        "headingText": "\r\n<p>Myopericytoma is a benign neoplasm with perivascular myoid cell differentiation.</p>\r\n",
        "timestamp": "2025-04-25T14:36:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 128142,
        "bookId": 64,
        "chapterId": 273,
        "headingId": 765,
        "headingText": "\r\n<p>8824/0 Myopericytoma</p>\r\n<p>8824/1 Multicentric myopericytomatosis</p>\r\n<p>8824/1 Intravascular myopericytoma</p>\r\n",
        "timestamp": "2025-04-25T14:36:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 128143,
        "bookId": 64,
        "chapterId": 273,
        "headingId": 766,
        "headingText": "\r\n<p>2E84.Y &amp; XH2HE9 Benign fibrogenic or myofibrogenic tumour of other specified sites &amp; Myopericytoma</p>\r\n",
        "timestamp": "2025-04-25T14:36:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,

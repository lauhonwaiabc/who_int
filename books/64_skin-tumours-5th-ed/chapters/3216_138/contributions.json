        "pkcontributionId": 126064,
        "bookId": 64,
        "chapterId": 138,
        "headingId": 764,
        "headingText": "\r\n<p>Tumour of the follicular infundibulum is a rare benign adnexal neoplasm showing differentiation towards the epithelium of the follicular isthmus.</p>\r\n",
        "timestamp": "2025-04-24T18:29:54"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

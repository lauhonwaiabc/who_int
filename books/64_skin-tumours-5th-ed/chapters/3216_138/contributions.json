  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 126078,
        "bookId": 64,
        "chapterId": 138,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> anastomosing epithelial cords, similar to the epithelium of the follicular isthmus, connected to the epidermis and involving the superficial dermis with a reticulated and fenestrated pattern.</p>\r\n",
        "timestamp": "2025-04-24T18:29:54"

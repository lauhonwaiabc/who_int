        "timestamp": "2025-04-24T17:52:25"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 125621,
        "bookId": 64,
        "chapterId": 111,
        "headingId": 778,
        "headingText": "\r\n<p>SCAP is a benign neoplasm.</p>",
        "timestamp": "2025-04-24T17:52:25"
      }
    ],

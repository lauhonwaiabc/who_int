        "headingId": 765,
        "headingText": "\r\n<p>8406/0 Syringocystadenoma papilliferum</p>\r\n",
        "timestamp": "2025-04-24T17:52:25"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 125607,
        "bookId": 64,
        "chapterId": 111,
        "headingId": 766,
        "headingText": "\r\n<p>2F22 &amp; XH1PY0 Benign neoplasms of epidermal appendages &amp; Syringocystadenoma papilliferum</p>\r\n",
        "timestamp": "2025-04-24T17:52:25"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 125605,
        "bookId": 64,
        "chapterId": 111,
        "headingId": 764,
        "headingText": "\r\n<p>Syringocystadenoma papilliferum (SCAP) is a benign apocrine neoplasm that arises either as an isolated lesion or in association with naevus sebaceus of Jadassohn.</p>\r\n",
        "timestamp": "2025-04-24T17:52:25"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "timestamp": "2025-04-24T14:15:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 124309,
        "bookId": 64,
        "chapterId": 15,
        "headingId": 778,
        "headingText": "\r\n<p>Solar lentigines are benign.</p>",
        "timestamp": "2025-04-24T14:15:05"
      }
    ],

    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 124307,
        "bookId": 64,
        "chapterId": 15,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a well-circumscribed intraepidermal keratinocyte proliferation with elongated rete ridges and a lack of cytological atypia or squamous dysplasia.</p>\r\n",
        "timestamp": "2025-04-24T14:15:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

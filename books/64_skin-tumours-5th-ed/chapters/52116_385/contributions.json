        "bookId": 64,
        "chapterId": 385,
        "headingId": 765,
        "headingText": "\r\n<p>8832/0 Pleomorphic fibroma</p>\r\n",
        "timestamp": "2025-04-25T09:39:25"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 127344,
        "bookId": 64,
        "chapterId": 385,
        "headingId": 766,
        "headingText": "\r\n<p>2F23 &amp; XH1BV2 Benign dermal fibrous or fibrohistiocytic neoplasms &amp; Pleomorphic fibroma</p>\r\n<p>2F23.Y &amp; XH1BV2 Other specified benign dermal fibrous or fibrohistiocytic neoplasms &amp; Pleomorphic fibroma</p>\r\n",
        "timestamp": "2025-04-25T09:39:25"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",

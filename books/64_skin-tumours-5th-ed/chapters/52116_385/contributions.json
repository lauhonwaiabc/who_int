[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127342,
        "bookId": 64,
        "chapterId": 385,
        "headingId": 764,
        "headingText": "\r\n<p>Pleomorphic fibroma is a benign, often polypoid, fibroblastic dermal neoplasm characterized by bizarre pleomorphic cells.</p>\r\n",
        "timestamp": "2025-04-25T09:39:25"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

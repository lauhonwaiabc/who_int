        "pkcontributionId": 126356,
        "bookId": 64,
        "chapterId": 373,
        "headingId": 767,
        "headingText": "\r\n<p><em>Acceptable:</em> longitudinal subungual acanthoma.</p>\r\n",
        "timestamp": "2025-04-25T08:24:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 825,
    "bookid": 64,
    "headingType": 2,

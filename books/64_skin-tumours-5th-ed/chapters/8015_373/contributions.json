      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 126367,
        "bookId": 64,
        "chapterId": 373,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> the nail plate should be thickened in some area of the tumour; hyperplasia (in some form) of the matrix epithelium and no dermal component of the lesion.</p>\r\n<p><em>Desirable:</em> whorls of epithelium differentiating into onychocytes, papillomatous projections of the epithelium, or an expanded keratogenous zone, depending on subtype.</p>\r\n",
        "timestamp": "2025-04-25T08:24:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,

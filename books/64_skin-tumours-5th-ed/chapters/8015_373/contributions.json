    "contributions": [
      {
        "pkcontributionId": 126368,
        "bookId": 64,
        "chapterId": 373,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T08:24:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 126369,
        "bookId": 64,
        "chapterId": 373,
        "headingId": 778,
        "headingText": "\r\n<p>Onychocytic matricoma is a benign lesion, and the prognosis is excellent {31090828}.</p>",
        "timestamp": "2025-04-25T08:24:16"
      }
    ],

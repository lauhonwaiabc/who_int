[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127614,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 764,
        "headingText": "\r\n<p><em>EWSR1</em>::<em>SMAD3</em>-rearranged fibroblastic tumour is a distinctive benign fibroblastic neoplasm with strong predilection for the hands and feet.</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 127615,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 765,
        "headingText": "\r\n<p>8810/0 <em>EWSR1</em>::<em>SMAD3</em>-rearranged fibroblastic tumour</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 127616,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 766,
        "headingText": "\r\n<p>2B53.Y Other specified fibroblastic or myofibroblastic tumour, primary site</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 767,
    "contributions": [
      {
        "pkcontributionId": 127617,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 767,
        "headingText": "\r\n<p><em>Acceptable:</em> <em>EWSR1</em>::<em>SMAD3</em>-positive fibroblastic tumour.</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 825,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 768,
    "contributions": [
      {
        "pkcontributionId": 127618,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 768,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 826,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 769,
    "contributions": [
      {
        "pkcontributionId": 127619,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 769,
        "headingText": "\r\n<p>The tumours are superficially located within the dermis and/or subcutaneous fat. Dermal involvement may abut the epidermis. The large majority occur in the hands and feet {29957732; 29309308}, while the lower extremity represents the most common non-acral site {32901982}.</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 127620,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 770,
        "headingText": "\r\n<p>Patients usually present with a small, painless, superficial tumour in an acral site.</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 828,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 771,
    "contributions": [
      {
        "pkcontributionId": 127621,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 771,
        "headingText": "\r\n<p><em>EWSR1</em>::<em>SMAD3</em>-rearranged fibroblastic tumours are rare, with &lt;&nbsp;20&nbsp;cases reported to date. Patients have a wide age range (1&ndash;68&nbsp;years, median: 39&nbsp;years), and most are female (M:F&nbsp;ratio: 1:4) {32901982}.</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 829,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 772,
    "contributions": [
      {
        "pkcontributionId": 127622,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 772,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 830,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 773,
    "contributions": [
      {
        "pkcontributionId": 127623,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 773,
        "headingText": "\r\n<p>SMAD3 is an important signal transducer in the TGF-&beta;/SMAD signalling pathway, which is involved in extracellular matrix synthesis by fibroblasts.</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 837,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 780,
    "contributions": [
      {
        "pkcontributionId": 127624,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 780,
        "headingText": "\r\n<p>The tumours are relatively small, measuring 10&ndash;20&nbsp;mm in largest dimension, with a nodular appearance.</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 831,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 774,
    "contributions": [
      {
        "pkcontributionId": 127625,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 774,
        "headingText": "\r\n<p>These tumours are typically well demarcated, but they can infiltrate subcutaneous fat. In particular, in adults, the acellular centre of the tumour appears hyalinized, which can resemble collagen rosettes. The peripheral zones consist of intersecting cellular fascicles of fibroblastic spindle cells within collagenous to more myxoid stroma. However, about half lack this zonation pattern. Lesional cells lack nuclear pleomorphism, hyperchromasia, prominent nucleoli, and mitotic activity. Myopericytomatous growth is rare. There may be focal stippled dystrophic calcification {29309308; 29957732; 32901982}.</p>\r\n<p>By immunohistochemistry, the fibroblastic tumour cells consistently show strong diffuse nuclear ERG expression, whereas SMA and CD34 are negative. When <em>EWSR1</em> rearrangement is detected by FISH, a myoepithelial tumour may be considered in the differential diagnosis. However, immunohistochemistry for cytokeratins, EMA, S100, and SOX10 is negative.</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 832,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 775,
    "contributions": [
      {
        "pkcontributionId": 127626,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 775,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 833,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 776,
    "contributions": [
      {
        "pkcontributionId": 127627,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 776,
        "headingText": "\r\n<p>The tumour type is defined by a fusion of exon&nbsp;7 of <em>EWSR1</em> with exon&nbsp;5 or exon&nbsp;6 of <em>SMAD3</em>, which may be confirmed by next-generation sequencing or validated by break-apart FISH assays {29309308; 32901982}.</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127628,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> clinical presentation as a small dermal and subcutaneous acral nodule; intersecting hypercellular fascicles comprising bland monomorphic spindle cells lacking mitotic activity, admixed with centrally located acellular hyalinized areas; diffuse strong ERG immunopositivity; molecular studies by FISH or next-generation sequencing confirming <em>EWSR1</em>::<em>SMAD3</em> fusion.</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 127629,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 777,
        "headingText": "\r\n<p>Not established</p>\r\n",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127630,
        "bookId": 64,
        "chapterId": 301,
        "headingId": 778,
        "headingText": "\r\n<p>The tumour is benign, but local recurrence may occur after incomplete excision {29957732}.</p>",
        "timestamp": "2025-04-25T10:03:23"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
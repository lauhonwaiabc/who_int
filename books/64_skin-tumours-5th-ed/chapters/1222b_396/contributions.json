      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 124664,
        "bookId": 64,
        "chapterId": 396,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> SCC with clear cell differentiation in &ge;&nbsp;25% of the neoplastic cells.</p>\r\n<p><em>Desirable:</em> PAS positivity.</p>\r\n",
        "timestamp": "2025-04-24T14:57:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 124665,
        "bookId": 64,
        "chapterId": 396,
        "headingId": 777,
        "headingText": "\r\n<p>Tumours should be staged according to the eighth edition of the Union for International Cancer Control (UICC) TNM system.</p>\r\n",
        "timestamp": "2025-04-24T14:57:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 124666,
        "bookId": 64,
        "chapterId": 396,
        "headingId": 778,
        "headingText": "\r\n<p>The prognosis of clear cell SCC is comparable to that of other SCC types {16630176} (see <a style=\"cursor:pointer\" href=\"/chaptercontent/64/35\" target=\"_blank\">section </a><em>Squamous cell carcinomas</em>).</p>",
        "timestamp": "2025-04-24T14:57:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
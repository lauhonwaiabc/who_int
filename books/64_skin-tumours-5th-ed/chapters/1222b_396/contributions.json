        "bookId": 64,
        "chapterId": 396,
        "headingId": 765,
        "headingText": "\r\n<p>8084/3 Clear cell squamous cell carcinoma</p>\r\n",
        "timestamp": "2025-04-24T14:57:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 124652,
        "bookId": 64,
        "chapterId": 396,
        "headingId": 766,
        "headingText": "\r\n<p>2C31.Z &amp; XH9DC1 Cutaneous squamous cell carcinoma &amp; Squamous cell carcinoma, clear cell type</p>\r\n",
        "timestamp": "2025-04-24T14:57:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,

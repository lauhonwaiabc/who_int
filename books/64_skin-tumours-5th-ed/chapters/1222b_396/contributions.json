[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 124650,
        "bookId": 64,
        "chapterId": 396,
        "headingId": 764,
        "headingText": "\r\n<p>Clear cell squamous cell carcinoma (SCC) is a histologically defined type of SCC that microscopically shows abundant clear cytoplasm.</p>\r\n",
        "timestamp": "2025-04-24T14:57:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

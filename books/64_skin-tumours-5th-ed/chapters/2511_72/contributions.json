        "timestamp": "2025-04-24T17:02:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 125127,
        "bookId": 64,
        "chapterId": 72,
        "headingId": 778,
        "headingText": "\r\n<p>These are benign lesions. Melanomas associated with genital naevi are very rare {25239415}.</p>",
        "timestamp": "2025-04-24T17:02:37"
      }
    ],

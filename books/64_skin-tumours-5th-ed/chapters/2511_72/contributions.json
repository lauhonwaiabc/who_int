  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 125125,
        "bookId": 64,
        "chapterId": 72,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a pigmented genital lesion; benign melanocytic proliferation.</p>\r\n",
        "timestamp": "2025-04-24T17:02:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127393,
        "bookId": 64,
        "chapterId": 310,
        "headingId": 764,
        "headingText": "\r\n<p>Fibrous papule is a benign lesion, presumably of fibroblastic origin, that most commonly occurs on the nose or central face.</p>\r\n",
        "timestamp": "2025-04-25T09:45:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

    "contributions": [
      {
        "pkcontributionId": 127408,
        "bookId": 64,
        "chapterId": 310,
        "headingId": 777,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2025-04-25T09:45:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",

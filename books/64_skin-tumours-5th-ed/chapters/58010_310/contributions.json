  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127407,
        "bookId": 64,
        "chapterId": 310,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> small papular lesions, usually occurring on the centrofacial skin; dilated dermal blood vessels within a collagenous stroma with prominent stellate or spindle-shaped fibroblasts.</p>\r\n",
        "timestamp": "2025-04-25T09:45:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,

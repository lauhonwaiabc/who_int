    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127409,
        "bookId": 64,
        "chapterId": 310,
        "headingId": 778,
        "headingText": "\r\n<p>Fibrous papule is a benign lesion {30028760; 15953376}.</p>",

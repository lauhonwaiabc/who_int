        "pkcontributionId": 127716,
        "bookId": 64,
        "chapterId": 249,
        "headingId": 764,
        "headingText": "\r\n<p>Microvenular haemangioma is a mitotically quiescent vascular lesion, likely to be a type of venous malformation.</p>\r\n",
        "timestamp": "2025-04-25T11:56:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

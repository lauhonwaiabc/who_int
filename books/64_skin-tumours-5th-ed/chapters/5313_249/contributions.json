  },
  {
    "pkheadingid": 826,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 769,
    "contributions": [
      {
        "pkcontributionId": 127721,
        "bookId": 64,
        "chapterId": 249,
        "headingId": 769,
        "headingText": "\r\n<p>This lesion affects the trunk and extremities, with a predilection for the forearms.</p>\r\n",
        "timestamp": "2025-04-25T11:56:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 127722,
        "bookId": 64,
        "chapterId": 249,
        "headingId": 770,
        "headingText": "\r\n<p>The lesion is a single, small (or occasionally larger), red, asymptomatic papule or plaque. Exceptional eruptive or multiple lesions have been reported {22722465; 25263662; 20881833}.</p>\r\n",
        "timestamp": "2025-04-25T11:56:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 828,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 771,
    "contributions": [
      {
        "pkcontributionId": 127723,
        "bookId": 64,
        "chapterId": 249,
        "headingId": 771,
        "headingText": "\r\n<p>This rare haemangioma arises mainly in young adults, with no sex predilection.</p>\r\n",
        "timestamp": "2025-04-25T11:56:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

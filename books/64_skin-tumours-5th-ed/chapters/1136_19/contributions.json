  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 124375,
        "bookId": 64,
        "chapterId": 19,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a solitary papule or small nodule; well-circumscribed cup-shaped epidermal invagination; proliferating keratinocytes with prominent acantholysis and no atypia.</p>\r\n<p><em>Desirable:</em> an umbilicated lesion; epidermal collarette.</p>\r\n",
        "timestamp": "2025-04-24T14:19:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

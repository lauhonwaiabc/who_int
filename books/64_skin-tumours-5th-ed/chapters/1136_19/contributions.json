        "chapterId": 19,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-24T14:19:48"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 124377,
        "bookId": 64,
        "chapterId": 19,
        "headingId": 778,
        "headingText": "\r\n<p>Warty dyskeratoma is benign.</p>",
        "timestamp": "2025-04-24T14:19:48"
      }
    ],

  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127849,
        "bookId": 64,
        "chapterId": 255,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a papillary dermal proliferation of dilated thin-walled vascular channels with variable overlying epidermal changes and lacking a deep component.</p>\r\n",
        "timestamp": "2025-04-25T12:01:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

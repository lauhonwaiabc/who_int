    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127851,
        "bookId": 64,
        "chapterId": 255,
        "headingId": 778,
        "headingText": "\r\n<p>In ACD, lesions continue to develop throughout life.</p>",

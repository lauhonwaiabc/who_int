        "chapterId": 255,
        "headingId": 775,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T12:01:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

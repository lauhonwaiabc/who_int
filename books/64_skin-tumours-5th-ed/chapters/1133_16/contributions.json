  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 124324,
        "bookId": 64,
        "chapterId": 16,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a well-circumscribed intraepidermal keratinocyte proliferation with seborrhoeic keratosis&ndash;like features and a superficial dermal chronic inflammatory infiltrate with interface change.</p>\r\n",
        "timestamp": "2025-04-24T14:16:07"
      }
    ],

  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 124326,
        "bookId": 64,
        "chapterId": 16,
        "headingId": 778,
        "headingText": "\r\n<p>Lichen planus&ndash;like keratoses are benign.</p>",

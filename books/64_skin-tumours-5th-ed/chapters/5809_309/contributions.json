        "chapterId": 309,
        "headingId": 765,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2025-04-25T14:38:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 128194,
        "bookId": 64,
        "chapterId": 309,
        "headingId": 766,
        "headingText": "\r\n<p>LC02 Complex epidermal hamartoma</p>\r\n",
        "timestamp": "2025-04-25T14:38:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 767,

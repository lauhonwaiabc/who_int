  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 128206,
        "bookId": 64,
        "chapterId": 309,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> haphazardly arranged muscle bundles within the dermis; absent atypia.</p>\r\n",
        "timestamp": "2025-04-25T14:38:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 128192,
        "bookId": 64,
        "chapterId": 309,
        "headingId": 764,
        "headingText": "\r\n<p>Smooth muscle hamartoma (SMH) represents an anomalous proliferation of haphazardly arranged smooth muscle bundles in the dermis.</p>\r\n",
        "timestamp": "2025-04-25T14:38:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,

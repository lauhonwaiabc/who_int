        "bookId": 64,
        "chapterId": 309,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T14:38:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 128208,
        "bookId": 64,
        "chapterId": 309,
        "headingId": 778,
        "headingText": "\r\n<p>SMH is benign. Treatment may not be necessary, and excision is typically curative. Rare cases of recurrence/persistence following incomplete excision have been reported {32804407}.</p>",
        "timestamp": "2025-04-25T14:38:29"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
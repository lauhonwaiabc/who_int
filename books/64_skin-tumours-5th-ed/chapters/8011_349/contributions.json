        "pkcontributionId": 126322,
        "bookId": 64,
        "chapterId": 349,
        "headingId": 767,
        "headingText": "\r\n<p><em>Not recommended:</em> localized multinucleate distal subungual keratosis.</p>\r\n",
        "timestamp": "2025-04-25T08:22:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 825,

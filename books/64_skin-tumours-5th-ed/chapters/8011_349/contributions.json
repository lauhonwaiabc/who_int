        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T08:22:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 126335,
        "bookId": 64,
        "chapterId": 349,
        "headingId": 778,
        "headingText": "\r\n<p>This is in general a benign entity, which does not tend to recur upon complete longitudinal excision {29729116}. A single malignant case has been described {33067854}.</p>",
        "timestamp": "2025-04-25T08:22:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

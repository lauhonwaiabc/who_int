        "headingId": 765,
        "headingText": "\r\n<p>8052/0 Onychopapilloma</p>\r\n",
        "timestamp": "2025-04-25T08:22:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

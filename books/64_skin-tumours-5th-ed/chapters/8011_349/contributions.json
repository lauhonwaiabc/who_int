  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 126333,
        "bookId": 64,
        "chapterId": 349,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> nail bed hyperplasia and matrical metaplasia, with clinicopathological correlation.</p>\r\n<p><em>Desirable:</em> subungual haemorrhage and distal hyperkeratosis; multinucleate nail bed keratinocytes.</p>\r\n",
        "timestamp": "2025-04-25T08:22:26"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

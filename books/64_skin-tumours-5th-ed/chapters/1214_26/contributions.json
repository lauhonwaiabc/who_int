    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 124463,
        "bookId": 64,
        "chapterId": 26,
        "headingId": 764,
        "headingText": "\r\n<p>Infiltrating basal cell carcinoma (BCC) is characterized by elongated islands and strands of basaloid cells that are poorly circumscribed with spiking projections.</p>\r\n",
        "timestamp": "2025-04-24T14:38:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

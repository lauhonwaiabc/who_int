        "pkcontributionId": 124466,
        "bookId": 64,
        "chapterId": 26,
        "headingId": 767,
        "headingText": "\r\n<p><em>Acceptable:</em> infiltrative basal cell carcinoma.</p>\r\n<p><em>Not recommended:</em> basal cell carcinoma with aggressive growth pattern.</p>\r\n",
        "timestamp": "2025-04-24T14:38:47"
      }
    ],

  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 124477,
        "bookId": 64,
        "chapterId": 26,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> variably sized, sometimes jagged nests of basaloid tumour cells infiltrating normal dermal collagen; an irregular permeating pattern of invasion at the deep tumour edge.</p>\r\n<p><em>Desirable:</em> perineural invasion may be present.</p>\r\n",
        "timestamp": "2025-04-24T14:38:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 124478,
        "bookId": 64,
        "chapterId": 26,
        "headingId": 777,
        "headingText": "\r\n<p>Staging is according to the eighth edition of the Union for International Cancer Control (UICC)&nbsp;/ American Joint Committee on Cancer (AJCC) TNM system.</p>\r\n",
        "timestamp": "2025-04-24T14:38:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 124479,
        "bookId": 64,
        "chapterId": 26,
        "headingId": 778,
        "headingText": "\r\n<p>This type of BCC has a high risk of recurrence, requiring surgery with strict margin control.</p>",
        "timestamp": "2025-04-24T14:38:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0

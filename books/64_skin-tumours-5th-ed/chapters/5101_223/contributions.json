[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127155,
        "bookId": 64,
        "chapterId": 223,
        "headingId": 764,
        "headingText": "\r\n<p>Naevus lipomatosus superficialis (NLS) is a rare cutaneous hamartoma characterized by dermal ectopic adipose tissue.</p>\r\n",
        "timestamp": "2025-04-24T16:39:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,

    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127171,
        "bookId": 64,
        "chapterId": 223,
        "headingId": 778,
        "headingText": "\r\n<p>NLS is benign. Recurrence is exceptional {13858911}.</p>",
        "timestamp": "2025-04-24T16:39:16"
      }
    ],

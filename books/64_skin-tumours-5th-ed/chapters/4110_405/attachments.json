  {
    "pkattachmentId": 63852,
    "bookid": 64,
    "chapterId": 405,
    "fileId": 38203,
    "type": "Figure",
    "diagnosis": "Mastocytoma",
    "title": "",
    "legend": "Sheets of isomorphic round cells with histiocytoid appearance are seen expanding the dermis (shown here). The neoplastic cells show numerous cytoplasmic metachromatic granules (Giemsa) (&lt;&lt;38204&gt;&gt;). A moderate cytoplasmic expression of tryptase is evident (&lt;&lt;38205&gt;&gt;). In addition, the neoplastic mast cells demonstrate a strong membranous expression of KIT (CD117) (&lt;&lt;38206&gt;&gt;). Of note, no expression of CD25 and no <em>KIT</em> mutations were found (neither p.D816V nor mutations in other relevant regions of the <em>KIT</em> gene).",
    "source": "",
    "copyright": "Colmenero&nbsp;I",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/405/38203.jpg",

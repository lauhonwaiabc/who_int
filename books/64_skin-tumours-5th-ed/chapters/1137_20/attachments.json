    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 571.2pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"762\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid; height: 3.5pt;\">\r\n<td style=\"width: 208.15pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"278\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Benign keratosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 363.05pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"484\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Essential and desirable features</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 208.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"278\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">Acantholytic acanthoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 363.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"484\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Suprabasal or full-thickness acantholysis in a papillomatous epidermis</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 208.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"278\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Acantholytic dyskeratotic acanthoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 363.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"484\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Dyskeratotic corps ronds and grains in association with acantholysis</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 208.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"278\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">Epidermolytic acanthoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 363.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"484\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Epidermolysis with clumped keratohyalin granules</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 208.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"278\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Granular parakeratotic acanthoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 363.05pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"484\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Retained keratohyalin granules in stratum corneum</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 208.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"278\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos;\">Psoriasiform keratosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 363.05pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"484\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Verrucous hyperplasia with parakeratosis and intracorneal neutrophils</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 208.15pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"278\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Melanoacanthoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 363.05pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"484\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Dendritic benign melanocytes within a seborrhoeic keratosis background</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

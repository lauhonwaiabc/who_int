    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-table-layout-alt: fixed; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"938\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Characteristic </span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Not atypical, or mild dysplasia</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Low-grade dysplasia (formerly moderate)</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">High-grade dysplasia (formerly severe)</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.7pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Melanoma</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos;\">Size</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Any size, usually &lt;&nbsp;4&nbsp;mm</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">&gt;&nbsp;4&nbsp;mm</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">&gt;&nbsp;4&nbsp;mm</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Any size</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Lateral circumscription</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Sharp or slightly diminished</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Moderate</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Moderate</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Often poor</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos;\">Symmetry</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Good</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Good</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Often broken</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Rare</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Junctional extension</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">May be slight</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Usual</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Usual</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Extensive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos;\">Rete ridge distortion</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Occasional</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Usual</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Always</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Occasional</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Fibrosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">None or slight</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Usual&nbsp;&ndash; concentric and lamellar</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Usual&nbsp;&ndash; concentric and lamellar</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Usual&nbsp;&ndash; diffuse</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos;\">Nest distribution</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Nests evenly dispersed</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Nests bridging</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Nests bridging, some confluent</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Confluent nests</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Upward migration (pagetoid pattern)</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Occasionally centrally</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Occasionally centrally</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Occasional, usually centrally</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Often extensive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos;\">Suprapapillary plates (lentiginous pattern)</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Spared</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Usually spared</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Often involved with single cells</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Involved (continuous proliferation of single cells and/or nests)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Cytoplasm</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Scant</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Dusty melanized</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">More variable, e.g. pigmented or pale eosinophilic</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Markedly variable, e.g. pigmented or pale eosinophilic</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 11; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos;\">Nuclear size</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Small</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Medium</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Larger</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Usually large</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 12; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Nucleoli</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Small</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Medium</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Larger</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Often large</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 13; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos;\">Chromatin</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Uniform </span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Partially expanded </span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Expanded, coarse in some cells</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos;\">Expanded, hyperchromatic and coarse</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 14; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 140.65pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Junctional and/or dermal mitoses</span></strong></p>\r\n</td>\r\n<td style=\"width: 140.65pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">None or very rare</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">None or very rare</span></p>\r\n</td>\r\n<td style=\"width: 140.65pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">Rare and concerning when present in atypical cells</span></p>\r\n</td>\r\n<td style=\"width: 140.7pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"188\">\r\n<p class=\"TableText\"><span style=\"mso-fareast-font-family: Aptos; color: black; mso-color-alt: windowtext;\">May be numerous</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

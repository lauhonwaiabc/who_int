[
  {
    "pkattachmentId": 63453,
    "bookid": 64,
    "chapterId": 45,
    "fileId": 35636,
    "type": "Figure",
    "diagnosis": "Dysplastic naevus, low grade",
    "title": "",
    "legend": "Cytological atypia. Lesional melanocytes have nuclei that are enlarged but in general less than 1.5 times the size of the nucleus of a resting basal keratinocyte. There is also relatively abundant cytoplasm, as well as &ldquo;dusty&rdquo; melanin pigment.",
    "source": "Lyn M. Duncan",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/45/35636.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/45/thumb_35636.jpg"
  },
  {
    "pkattachmentId": 63454,
    "bookid": 64,
    "chapterId": 45,
    "fileId": 35637,
    "type": "Figure",
    "diagnosis": "Dysplastic naevus, high grade",
    "title": "",
    "legend": "Cytological atypia. There are several cells in this field that have nuclei larger than 1.5&nbsp;times that of a resting basal keratinocyte. In addition, they have variably abundant cytoplasm and &ldquo;dusty&rdquo; melanin pigment.",
    "source": "Lyn M. Duncan",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/45/35637.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/45/thumb_35637.jpg"
  },
  {
    "pkattachmentId": 63648,
    "bookid": 64,
    "chapterId": 45,
    "fileId": 36939,
    "type": "Figure",
    "diagnosis": "Dysplastic naevus",
    "title": "",
    "legend": "This lesion is broad, somewhat irregular, raised in the centre, and flat at the periphery. It has variegated shades of tan and dark brown, and an indefinite border.",
    "source": "",
    "copyright": "Elder D.",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/45/36939.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/45/thumb_36939.jpg"
  },
  {
    "pkattachmentId": 63649,
    "bookid": 64,
    "chapterId": 45,
    "fileId": 36940,
    "type": "Figure",
    "diagnosis": "Compound dysplastic naevus, low grade",
    "title": "",
    "legend": "A broad lesion characterized by relative symmetry and uniformly elongated rete ridges. In the centre, a dermal component partly fills the expanded papillary dermis; at the periphery, there are junctional shoulders. There is a patchy perivascular lymphocytic infiltrate.",
    "source": "",
    "copyright": "Elder D.",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/45/36940.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/45/thumb_36940.jpg"
  },
  {
    "pkattachmentId": 63650,
    "bookid": 64,
    "chapterId": 45,
    "fileId": 36941,
    "type": "Figure",
    "diagnosis": "Compound dysplastic naevus, low grade",
    "title": "",
    "legend": "High-power view of the edge of the dermal component and the beginning of the adjacent shoulder. The junctional component is moderately cellular and is composed of naevoid to epithelioid melanocytes; the nuclear size of these cells is less than 1.5&nbsp;times that of resting (i.e. with the smallest nuclei) basal keratinocytes, constituting moderate random cytological atypia.",
    "source": "",
    "copyright": "Elder D.",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/45/36941.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/45/thumb_36941.jpg"
  },
  {
    "pkattachmentId": 63651,
    "bookid": 64,
    "chapterId": 45,
    "fileId": 36942,
    "type": "Figure",
    "diagnosis": "Compound dysplastic naevus, high grade",
    "title": "",
    "legend": "A broad lesion, slightly &gt;&nbsp;4&nbsp;mm in diameter on the slide, with changes present at the left specimen edge. The rete ridges are somewhat irregularly thickened, although relatively uniformly elongated. There is a patchy to focally more dense lymphocytic infiltrate in the dermis, mostly perivascular and partly interstitial. Nests of melanocytes can be seen near the tips and sides of rete ridges, with some bridging nests.",
    "source": "",
    "copyright": "Elder D.",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/45/36942.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/45/thumb_36942.jpg"
  },
  {
    "pkattachmentId": 63652,
    "bookid": 64,
    "chapterId": 45,
    "fileId": 36943,
    "type": "Figure",
    "diagnosis": "Compound dysplastic naevus, high grade",
    "title": "",
    "legend": "Some of the lesional melanocytes have a nuclear size more than 1.5&nbsp;times that of resting basal keratinocytes, as well as irregular hyperchromatic nuclei, constituting severe random cytological atypia. There is a focal tendency to confluence of lesional cell nests in the epidermis, with only minimal evidence of upward scatter in this field. In the dermis, there are perivascular lymphocytes and melanophages, with subtle concentric fibroplasia at the tip of some rete.",
    "source": "",
    "copyright": "Elder D.",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/45/36943.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/45/thumb_36943.jpg"
  },
  {
    "pkattachmentId": 63653,
    "bookid": 64,
    "chapterId": 45,
    "fileId": 36944,
    "type": "Figure",
    "diagnosis": "Compound dysplastic naevus, high grade",
    "title": "",
    "legend": "In this focal area of the lesion, there are changes that raise concern for evolving melanoma (at least in situ); there are large cells, and there is a focal tendency to upward pagetoid scatter near the middle of the lesion, not beyond the mid-spinous layer. A few cells in the dermis (left of centre) resemble those in the epidermis, with an associated focus of diffuse fibroplasia. The lymphocytic infiltrate is focally band-like; there is well-developed eosinophilic fibroplasia around rete ridges on the right.",
    "source": "",
    "copyright": "Elder D.",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/45/36944.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/45/thumb_36944.jpg"
  },

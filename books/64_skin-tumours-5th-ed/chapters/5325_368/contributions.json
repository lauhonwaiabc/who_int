[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 128039,
        "bookId": 64,
        "chapterId": 368,
        "headingId": 764,
        "headingText": "\r\n<p>Epithelioid haemangioendothelioma (EHE) is a malignant endothelial neoplasm composed of epithelioid cells within a myxohyaline stroma; almost all have a <em>WWTR1</em>::<em>CAMTA1</em> fusion. A distinctive subtype composed of epithelioid cells with abundant cytoplasm and solid, nested, and/or vasoformative growth has a <em>YAP1</em>::<em>TFE3</em> fusion.</p>\r\n",
        "timestamp": "2025-04-25T12:13:21"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 128040,
        "bookId": 64,
        "chapterId": 368,
        "headingId": 765,
        "headingText": "\r\n<p>9133/3 Epithelioid haemangioendothelioma</p>\r\n<p>9133/3 Epithelioid haemangioendothelioma with <em>WWTR1</em>::<em>CAMTA1</em> fusion</p>\r\n<p>9133/3 Epithelioid haemangioendothelioma with <em>YAP1</em>::<em>TFE3</em> fusion</p>\r\n",
        "timestamp": "2025-04-25T12:13:21"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 128041,
        "bookId": 64,
        "chapterId": 368,
        "headingId": 766,
        "headingText": "\r\n<p>2B5Y &amp; XH9GF8 Other specified malignant mesenchymal neoplasms &amp; Epithelioid haemangioendothelioma</p>\r\n",
        "timestamp": "2025-04-25T12:13:21"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,

        "pkcontributionId": 126047,
        "bookId": 64,
        "chapterId": 137,
        "headingId": 764,
        "headingText": "\r\n<p>Pilar sheath acanthoma is a benign follicular adnexal neoplasm with infundibular and isthmic differentiation.</p>\r\n",
        "timestamp": "2025-04-24T18:28:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

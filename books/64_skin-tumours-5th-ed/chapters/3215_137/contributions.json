        "chapterId": 137,
        "headingId": 768,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2025-04-24T18:28:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 826,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 769,
    "contributions": [
      {
        "pkcontributionId": 126052,
        "bookId": 64,
        "chapterId": 137,
        "headingId": 769,
        "headingText": "\r\n<p>The most common location is the face, with a predilection for the upper lip {521535; 2697113; 718186; 6662259; 3557980}.</p>\r\n",
        "timestamp": "2025-04-24T18:28:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 126053,
        "bookId": 64,
        "chapterId": 137,
        "headingId": 770,
        "headingText": "\r\n<p>Pilar sheath acanthoma arises as a single papule or nodule with a central depression filled with keratin. Clinical diagnosis is usually as a giant comedo.</p>\r\n",
        "timestamp": "2025-04-24T18:28:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 828,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 771,
    "contributions": [
      {
        "pkcontributionId": 126054,
        "bookId": 64,
        "chapterId": 137,
        "headingId": 771,
        "headingText": "\r\n<p>Pilar sheath acanthoma is rare. It usually develops in middle-aged and elderly patients (age range: 30&ndash;76&nbsp;years), with no sex predilection.</p>\r\n",
        "timestamp": "2025-04-24T18:28:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 829,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 772,
    "contributions": [
      {
        "pkcontributionId": 126055,
        "bookId": 64,
        "chapterId": 137,
        "headingId": 772,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2025-04-24T18:28:40"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 830,

[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127189,
        "bookId": 64,
        "chapterId": 225,
        "headingId": 764,
        "headingText": "\r\n<p>Angiolipoma is a subcutaneous tumour composed of mature fat cells and clusters of thin-walled capillaries, often with fibrin thrombi.</p>\r\n",
        "timestamp": "2025-04-24T16:45:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 127190,
        "bookId": 64,
        "chapterId": 225,
        "headingId": 765,
        "headingText": "\r\n<p>8861/0 Angiolipoma</p>\r\n<p>8861/0 Cellular angiolipoma</p>\r\n",
        "timestamp": "2025-04-24T16:45:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 127191,
        "bookId": 64,
        "chapterId": 225,
        "headingId": 766,
        "headingText": "\r\n<p>2E80.0YZ &amp; XH3C77 Lipoma, unspecified site &amp; Angiolipoma, NOS</p>\r\n",
        "timestamp": "2025-04-24T16:45:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,

        "timestamp": "2025-04-25T11:55:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127715,
        "bookId": 64,
        "chapterId": 248,
        "headingId": 778,
        "headingText": "\r\n<p>Sinusoidal haemangioma is benign.</p>",
        "timestamp": "2025-04-25T11:55:34"
      }
    ],

      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127713,
        "bookId": 64,
        "chapterId": 248,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a lobular proliferation of dilated vascular channels with a sinusoidal or sieve-like pattern.</p>\r\n",
        "timestamp": "2025-04-25T11:55:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

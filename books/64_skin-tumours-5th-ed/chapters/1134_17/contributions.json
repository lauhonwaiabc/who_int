      {
        "pkcontributionId": 124341,
        "bookId": 64,
        "chapterId": 17,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a sharply demarcated intraepidermal keratinocytic proliferation with clear cell change, lacking squamous dysplasia.</p>\r\n",
        "timestamp": "2025-04-24T14:17:16"
      }

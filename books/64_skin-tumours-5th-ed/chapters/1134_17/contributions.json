      {
        "pkcontributionId": 124330,
        "bookId": 64,
        "chapterId": 17,
        "headingId": 767,
        "headingText": "\r\n<p><em>Not recommended:</em> pale cell acanthoma; Degos acanthoma.</p>\r\n",
        "timestamp": "2025-04-24T14:17:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 825,

        "chapterId": 17,
        "headingId": 765,
        "headingText": "\r\n<p>8084/0 Clear cell acanthoma</p>\r\n",
        "timestamp": "2025-04-24T14:17:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 124329,
        "bookId": 64,
        "chapterId": 17,
        "headingId": 766,
        "headingText": "\r\n<p>2F21.Y &amp; XH13L5 Other specified benign keratinocytic acanthomas &amp; Clear cell acanthoma</p>\r\n",
        "timestamp": "2025-04-24T14:17:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

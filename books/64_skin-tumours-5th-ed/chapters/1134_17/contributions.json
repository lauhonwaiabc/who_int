[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 124327,
        "bookId": 64,
        "chapterId": 17,
        "headingId": 764,
        "headingText": "\r\n<p>Clear cell acanthoma is a sharply demarcated intraepidermal keratinocytic proliferation with pale- to clear-staining cytoplasm.</p>\r\n",
        "timestamp": "2025-04-24T14:17:16"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

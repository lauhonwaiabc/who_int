  },
  {
    "pkattachmentId": 63692,
    "bookid": 64,
    "chapterId": 44,
    "fileId": 37399,
    "type": "Figure",
    "diagnosis": "Compound melanocytic naevus",
    "title": "",
    "legend": "Higher magnification shows that there are a few nests of epithelioid type&nbsp;A naevus cells in the epidermis and superficial dermis. These blend with small lymphocyte-like type&nbsp;B naevus cells, which disperse into the reticular dermis at the base of the lesion. The lesional cell nuclei are small, without atypia, and there are no mitoses.",
    "source": "",
    "copyright": "Elder D",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/44/37399.jpg",

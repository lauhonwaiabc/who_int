[
  {
    "pkattachmentId": 62654,
    "bookid": 64,
    "chapterId": 44,
    "fileId": 33196,
    "type": "Figure",
    "diagnosis": "Compound naevus",
    "title": "",
    "legend": "The naevus is slightly raised, well-defined, and symmetrical, with regular borders and uniform colour. However, a slightly darker peripheral rim suggests designation as a &ldquo;cockade&rdquo; naevus.",
    "source": "Iris Zalaudek",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/44/33196.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/44/thumb_33196.jpg"
  },
  {
    "pkattachmentId": 62656,
    "bookid": 64,
    "chapterId": 44,
    "fileId": 33199,
    "type": "Figure",
    "diagnosis": "Dermal naevus",
    "title": "",
    "legend": "The naevus is raised, well-circumscribed, and symmetrical, with papillomatous surface configuration. Naevus cells are uniformly dispersed and show diminished cellularity and maturation with depth.",
    "source": "Daniela Massi",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/44/33199.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/44/thumb_33199.jpg"
  },
  {
    "pkattachmentId": 62657,
    "bookid": 64,
    "chapterId": 44,
    "fileId": 33200,
    "type": "Figure",
    "diagnosis": "Dermal naevus",
    "title": "",
    "legend": "Type&nbsp;A naevus cells in the superficial dermis. These cells are also termed &ldquo;epithelioid&rdquo; because of the relatively prominent pink cytoplasm and thus resemblance to epithelial cells. The nuclei are small and uniform.",
    "source": "Daniela Massi",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/44/33200.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/44/thumb_33200.jpg"
  },
  {
    "pkattachmentId": 62658,
    "bookid": 64,
    "chapterId": 44,
    "fileId": 33201,
    "type": "Figure",
    "diagnosis": "Dermal naevus",
    "title": "",
    "legend": "Type&nbsp;B naevus cells in the middle portion of the naevus. These cells are also termed &ldquo;lymphocytoid&rdquo; because of scant cytoplasm and hence resemblance to lymphocytes.",
    "source": "Daniela Massi",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/44/33201.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/44/thumb_33201.jpg"
  },
  {
    "pkattachmentId": 62659,
    "bookid": 64,
    "chapterId": 44,
    "fileId": 33202,
    "type": "Figure",
    "diagnosis": "Dermal naevus",
    "title": "",
    "legend": "Type&nbsp;C naevus cells seen in the deepest portion of the naevus and the final stage of maturation (or senescence) with depth in a naevus. These cells are variably spindled with slight Schwannian differentiation and dispersed in a delicate matrix. These changes are often termed &ldquo;neurotization&rdquo;.",
    "source": "Daniela Massi",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/44/33202.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/64/44/thumb_33202.jpg"
  },

  {
    "pkattachmentId": 64047,
    "bookid": 64,
    "chapterId": 44,
    "fileId": 37390,
    "type": "Table",
    "diagnosis": "",
    "title": "<p>Diagnostic criteria for junctional, compound, and dermal naevi</p>",
    "legend": "",
    "source": "Raymond L. Barnhill",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 439.45pt; background: #DAEEF3; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"586\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 439.45pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"586\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Clinical features</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Onset in childhood, adolescence, third decade of life, or later</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">2&ndash;6&nbsp;mm diameter</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Macular, papular, dome-shaped, polypoid, or papillomatous</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Homogeneous colour: tan, light brown, brown, dark brown</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Round, oval</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Symmetrical</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Well-defined, regular borders</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 439.45pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"586\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Histopathological features</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Symmetry</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Sharp circumscription</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 11; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Regular junctional nesting, if present</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 12; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Uniform size, shape, and placement of junctional nests, if present</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 13; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Junctional nests at lowermost poles of epidermal rete, if present</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 14; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Cohesive junctional nests, if present</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 15; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">No or little pagetoid spread</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 16; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Lentiginous melanocytic proliferation can be present</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 17; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Dermal naevus cells often confined to papillary or superficial reticular dermis</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 18; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Compound and dermal naevi: mitotic figures absent or rare in the dermis </span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 19; page-break-inside: avoid; height: 10.2pt;\">\r\n<td style=\"width: 439.45pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 10.2pt;\" colspan=\"2\" valign=\"top\" width=\"586\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cytological features</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 20; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Nucleus in naevus cells smaller than in basal keratinocytes</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 21; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Minimal variation in size and shape of nucleus in naevus cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 22; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Homogeneous chromatin </span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 23; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Nuclear membranes not thickened </span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 24; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Nucleolus not visible or not prominent </span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 25; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Cytoplasm not visible, scant, or abundant in epithelioid cells</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 26; page-break-inside: avoid; height: 17.2pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.2pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Compound and dermal naevi: transition from epithelioid (type&nbsp;A) to lymphocytoid (type&nbsp;B) to spindled (type&nbsp;C, neuroid) cells with depth in the dermis (maturation)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 27; mso-yfti-lastrow: yes; page-break-inside: avoid; height: 17.15pt;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"38\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 411.1pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 17.15pt;\" valign=\"top\" width=\"548\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Compound and dermal naevi: &ldquo;senescent&rdquo; changes and neurotization occur</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

    "fileId": 37398,
    "type": "Figure",
    "diagnosis": "Compound melanocytic naevus",
    "title": "",
    "legend": "A well-circumscribed, symmetrical, moderately cellular proliferation of naevoid melanocytes, with expansion of the papillary dermis. There is no adjacent junctional component (shoulder).",
    "source": "",
    "copyright": "Elder D",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/64/44/37398.jpg",

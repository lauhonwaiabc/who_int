  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 124853,
        "bookId": 64,
        "chapterId": 50,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a benign melanocytic proliferation confined to a scar; history of prior biopsy or trauma.</p>\r\n",
        "timestamp": "2025-04-24T16:37:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

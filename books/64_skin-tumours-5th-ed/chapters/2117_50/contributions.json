  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 124855,
        "bookId": 64,
        "chapterId": 50,
        "headingId": 778,
        "headingText": "\r\n<p>Recurrent naevi are benign lesions.</p>",
        "timestamp": "2025-04-24T16:37:04"
      }
    ],

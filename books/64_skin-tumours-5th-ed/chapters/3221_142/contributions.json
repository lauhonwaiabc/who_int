[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 126115,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 764,
        "headingText": "\r\n<p>Pilomatrical carcinoma is an adnexal carcinoma with matrical differentiation.</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 126116,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 765,
        "headingText": "\r\n<p>8110/3 Pilomatrical carcinoma</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 126117,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 766,
        "headingText": "\r\n<p>2C33 &amp; XH9G49 Adnexal carcinoma of skin &amp; Pilomatrical carcinoma</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 767,
    "contributions": [
      {
        "pkcontributionId": 126118,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 767,
        "headingText": "\r\n<p><em>Acceptable:</em> pilomatrix carcinoma.</p>\r\n<p><em>Not recommended:</em> calcifying epithelial carcinoma of Malherbe; malignant pilomatrixoma; malignant pilomatricoma; matrical carcinoma; matrix carcinoma.</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 825,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 768,
    "contributions": [
      {
        "pkcontributionId": 126119,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 768,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 826,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 769,
    "contributions": [
      {
        "pkcontributionId": 126120,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 769,
        "headingText": "\r\n<p>The site of predilection is the face, with rare cases reported in other locations.</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 126121,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 770,
        "headingText": "\r\n<p>Pilomatrical carcinoma presents as a solitary, often ulcerated nodule.</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 828,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 771,
    "contributions": [
      {
        "pkcontributionId": 126122,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 771,
        "headingText": "\r\n<p>Pilomatrical carcinoma is rare {24739254}. Most cases develop in middle-aged or elderly individuals.</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 829,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 772,
    "contributions": [
      {
        "pkcontributionId": 126123,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 772,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 830,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 773,
    "contributions": [
      {
        "pkcontributionId": 126124,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 773,
        "headingText": "\r\n<p>The WNT signalling pathway has been implicated in the pathogenesis of pilomatrical carcinoma. LEF1 and CDX2 have been postulated to regulate the pathway {29369390}. Cytogenetic analysis in a few cases of pilomatrical carcinoma have demonstrated mutations in exon&nbsp;3 of the gene encoding &beta;-catenin (<em>CTNNB1</em>) {10192393; 19384065; 15606674}.</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 837,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 780,
    "contributions": [
      {
        "pkcontributionId": 126125,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 780,
        "headingText": "\r\n<p>Patients typically present with a poorly circumscribed dermal tumour, often covered by ulcerated skin.</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 831,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 774,
    "contributions": [
      {
        "pkcontributionId": 126126,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 774,
        "headingText": "<p>Pilomatrical carcinoma is poorly circumscribed and infiltrative, and it involves the deep dermis, subcutaneous tissue, and even skeletal muscle and fascia. The lesion is composed of solid aggregates of immature basaloid matrical cells with scant cytoplasm, a vesicular nucleus, a prominent nucleolus, and numerous mitoses. Atypical mitoses may be seen. Shadow cells are less abundant in pilomatrical carcinoma than in pilomatricoma, but they are characteristic and useful in the diagnosis {8453573}. In some cases, inner root sheath differentiation (including trichohyalin granules and nests of bluish-grey cornified material) can be seen. More frequently, necrosis en&nbsp;masse results in cystic spaces containing keratin and cellular debris between the aggregates of matrical cells. Uncommon histopathological findings include desmoplastic stroma, lymphovascular and perineural invasion, and a sarcomatoid component {29624700; 31633597; 32005258}.</p>\r\n<h5>Immunohistochemistry</h5>\r\n<p>Pilomatrical carcinomas show both nuclear and cytoplasmic staining for &beta;-catenin in the basaloid matrical cells, as well as nuclear expression of CDX2 and LEF1 {29369390}; BerEP4 is negative {15030335}.</p>\r\n<h5>Differential diagnosis</h5>\r\n<p>Pilomatrical carcinoma should be distinguished from pilomatricoma and basal cell carcinoma with matrical differentiation. Pilomatricoma is a benign cystic neoplasm that appears as a symmetrical, well-circumscribed lesion with regular and smooth borders; it usually does not show any areas of necrosis en&nbsp;masse or the cytological atypia seen in pilomatrical carcinoma. Basal cell carcinoma with matrical differentiation is a neoplasm with all the architectural and cytological features of a basal cell carcinoma, and focal aggregates of shadow cells; rarely, areas with matrical differentiation predominate and display some degree of cytological atypia {28368926}.</p>",
        "timestamp": "2025-04-24T18:35:21"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 832,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 775,
    "contributions": [
      {
        "pkcontributionId": 126127,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 775,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 833,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 776,
    "contributions": [
      {
        "pkcontributionId": 126128,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 776,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 126129,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a poorly circumscribed neoplasm composed of solid aggregates of matrical cells, with areas of necrosis en&nbsp;masse and focal aggregates of shadow cells.</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 126130,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 777,
        "headingText": "\r\n<p>Staging follows the eighth edition of the Union for International Cancer Control (UICC) TNM classification.</p>\r\n",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 126131,
        "bookId": 64,
        "chapterId": 142,
        "headingId": 778,
        "headingText": "\r\n<p>Pilomatrical carcinomas may develop regional lymph node or visceral metastasis, and patients may die as a consequence of the tumour {10448295; 3755030; 8608508}. Recurrence appears to be a risk factor for metastasis {24739254}.</p>",
        "timestamp": "2025-04-24T18:34:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
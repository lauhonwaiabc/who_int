    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 128394,
        "bookId": 64,
        "chapterId": 315,
        "headingId": 777,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2025-04-25T14:53:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 128395,
        "bookId": 64,
        "chapterId": 315,
        "headingId": 778,
        "headingText": "\r\n<p>The tumours are benign and rarely recur locally {19623031}.</p>",
        "timestamp": "2025-04-25T14:53:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

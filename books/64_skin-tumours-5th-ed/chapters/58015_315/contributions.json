        "timestamp": "2025-04-25T14:53:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 128393,
        "bookId": 64,
        "chapterId": 315,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> intermingled features of two types of benign nerve sheath tumours; appropriate immunohistochemical staining for each component.</p>\r\n",
        "timestamp": "2025-04-25T14:53:07"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,

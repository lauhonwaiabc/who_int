[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 124992,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 764,
        "headingText": "\r\n<p>Pigmented spindle cell naevus (PSCN) is a subtype of Spitz naevus characterized by heavily pigmented, spindle-shaped melanocytes.</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 124993,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 765,
        "headingText": "\r\n<p>8770/0 Pigmented spindle cell naevus (Reed naevus)</p>\r\n<p>8770/0 Atypical pigmented spindle cell tumour</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 124994,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 766,
        "headingText": "\r\n<p>2F20.Y &amp; XH2P88 Other specific types of melanocytic naevus &amp; Pigmented spindle cell naevus of Reed</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 767,
    "contributions": [
      {
        "pkcontributionId": 124995,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 767,
        "headingText": "\r\n<p><em>Acceptable:</em> naevus of Reed; pigmented spindle cell Spitz naevus.</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 825,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 768,
    "contributions": [
      {
        "pkcontributionId": 124996,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 768,
        "headingText": "\r\n<p>Atypical pigmented spindle cell tumour</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 826,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 769,
    "contributions": [
      {
        "pkcontributionId": 124997,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 769,
        "headingText": "\r\n<p>PSCN most commonly involves the extremities (75% of cases), trunk (20% of cases), and head and neck (5% of cases) {6476194; 8463457; 1985078}.</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 124998,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 770,
        "headingText": "\r\n<p>Patients with PSCN typically present with a black, dark-brown, or blue macule or papule that is well circumscribed, symmetrical, and flat-topped, averaging about 3&nbsp;mm in diameter (range: 1.5&ndash;10&nbsp;mm) {6476194; 8463457}. Dermoscopy often shows a starburst appearance or a homogeneous black, blue-black, or dark-brown appearance {16301385; 28118479; 16103350}.</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 828,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 771,
    "contributions": [
      {
        "pkcontributionId": 124999,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 771,
        "headingText": "\r\n<p>PSCN preferentially affects young people (mean age: 25&nbsp;years) and women {6476194; 8463457}. It accounts for &lt;&nbsp;20% of Spitz neoplasms {16301385}.</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 829,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 772,
    "contributions": [
      {
        "pkcontributionId": 125000,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 772,
        "headingText": "\r\n<p>Somatic mutations lead to clonal expansion of melanocytes {35187702}.</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 830,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 773,
    "contributions": [
      {
        "pkcontributionId": 125001,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 773,
        "headingText": "\r\n<p>PSCNs are caused by genomic rearrangements that result in the constitutive activation of protein kinases, involving most commonly <em>NTRK3</em> {29794873} or less frequently <em>MET</em>, <em>ROS1</em>, or <em>RET</em> {29794873}.</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 837,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 780,
    "contributions": [
      {
        "pkcontributionId": 125002,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 780,
        "headingText": "\r\n<p>See <em>Clinical features</em>, above.</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 831,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 774,
    "contributions": [
      {
        "pkcontributionId": 125003,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 774,
        "headingText": "<p>PSCNs are usually small {6476194}, well-circumscribed, symmetrical, nested proliferations of spindled and pigmented melanocytes, with overlying epidermal hyperplasia and clefts surrounding nests. Kamino bodies may be present. Pagetoid spread is relatively common, mostly limited to the lower half of the epidermis and not extending peripherally beyond the last junctional nest. PSCNs may involve the papillary dermis and appendages. Some tumours have small cells with delicate nuclei with open chromatin, inconspicuous nucleoli, and minimal cytoplasm. Others have larger cells with vesicular nuclei, spindle shape, and abundant cytoplasm. There are typically many accompanying melanophages.</p>\r\n<p>Atypical pigmented spindle cell tumours are characterized by any of the following features: diameter &gt;&nbsp;6&nbsp;mm (often); poor circumscription; asymmetry; effacement of the epidermis; ulceration; single melanocytes extending peripherally along the epidermal basal layer; or a high degree of pagetoid spread, mitotic activity, and cytological atypia {1985078}. Features of dysplastic naevus may be seen. The lesions may contain cellular aggregates or nodules of melanocytes in the dermis without maturation. Atypical subtypes may be amelanotic spitzoid epithelioid cells present in a background PSCN.</p>\r\n<h5>Immunohistochemistry</h5>\r\n<p>There is typically strong p16 expression {21997694}.</p>\r\n<h5>Differential diagnosis</h5>\r\n<p>Melanomas are usually larger than PSCNs and often exhibit an effaced and thinned epidermis, prominent basilar single-cell proliferation of atypical spindle cells, and cellular fascicles and nests with diminished cohesion {22892832; 22388759; 21997694}. The identification of <em>BRAF</em> p.V600E mutations suggests a dysplastic naevus with spitzoid features or a melanoma in skin with a low degree of cumulative sun damage (low-CSD melanoma) {32000215}.</p>",
        "timestamp": "2025-04-24T16:51:19"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 832,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 775,
    "contributions": [
      {
        "pkcontributionId": 125004,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 775,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 833,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 776,
    "contributions": [
      {
        "pkcontributionId": 125005,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 776,
        "headingText": "\r\n<p>Molecular analyses are usually unnecessary for the diagnosis.</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 125006,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a junctional or superficial compound proliferation of spindled and pigmented melanocytes with symmetry, lateral circumscription, and epidermal hyperplasia.</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 125007,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 125008,
        "bookId": 64,
        "chapterId": 62,
        "headingId": 778,
        "headingText": "\r\n<p>PSCNs are benign neoplasms.</p>",
        "timestamp": "2025-04-24T16:50:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 127546,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 764,
        "headingText": "\r\n<p>Dermatomyofibroma (DM) is a rare benign cutaneous mesenchymal neoplasm of fibroblastic/myofibroblastic differentiation.</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 765,
    "contributions": [
      {
        "pkcontributionId": 127547,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 765,
        "headingText": "\r\n<p>8824/0 Dermatomyofibroma</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 823,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 766,
    "contributions": [
      {
        "pkcontributionId": 127548,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 766,
        "headingText": "\r\n<p>2F23.Y &amp; XH18K3 Other specified benign dermal fibrous or fibrohistiocytic neoplasms &amp; Dermatomyofibroma</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 824,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 767,
    "contributions": [
      {
        "pkcontributionId": 127549,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 767,
        "headingText": "\r\n<p><em>Not recommended:</em> plaque-like dermal fibromatosis.</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 825,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Subtype(s)",
    "headingPosition": 5,
    "headingid": 768,
    "contributions": [
      {
        "pkcontributionId": 127550,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 768,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 826,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Localization",
    "headingPosition": 6,
    "headingid": 769,
    "contributions": [
      {
        "pkcontributionId": 127551,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 769,
        "headingText": "\r\n<p>Predilection sites are the upper trunk and upper arm, shoulder, axillary folds, and neck, followed by the abdominal wall and thigh {8468425; 1597573; 19155724}.</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 127552,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 770,
        "headingText": "\r\n<p>DM manifests as an asymptomatic, erythematous, reddish-brown or hypopigmented, longstanding or slowly growing, slightly indurated, flat, plaque-like lesion, or (less often) a nodule {33059951; 19155724}. Linear and annular presentations have also been reported. Rarely, the tumour may be congenital, multicentric, or of considerable size {34152037; 18801097}.</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 828,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Epidemiology",
    "headingPosition": 8,
    "headingid": 771,
    "contributions": [
      {
        "pkcontributionId": 127553,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 771,
        "headingText": "\r\n<p>DM most frequently occurs in young females {8468425; 19155724}. DM in young children is rare {21752049; 28318057}.</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 829,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Etiology",
    "headingPosition": 9,
    "headingid": 772,
    "contributions": [
      {
        "pkcontributionId": 127554,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 772,
        "headingText": "\r\n<p>Unknown</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 830,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Pathogenesis",
    "headingPosition": 10,
    "headingid": 773,
    "contributions": [
      {
        "pkcontributionId": 127555,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 773,
        "headingText": "\r\n<p>DM is a myofibroblastic tumour {1597573; 8872155}.</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 837,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Macroscopic appearance",
    "headingPosition": 11,
    "headingid": 780,
    "contributions": [
      {
        "pkcontributionId": 127556,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 780,
        "headingText": "\r\n<p>See <em>Clinical features</em>, above.</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 831,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Histopathology",
    "headingPosition": 12,
    "headingid": 774,
    "contributions": [
      {
        "pkcontributionId": 127557,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 774,
        "headingText": "\r\n<p>Throughout the dermis, there is a horizontally oriented plaque-like arrangement (except in the deep dermis&nbsp;/ subcutis where the arrangement is usually perpendicular to the epidermis) of densely packed slender bundles and long fascicles of cytologically bland fusiform spindle cells showing fibroblastic and myofibroblastic differentiation. The epidermis is generally unaffected. The papillary dermis is typically spared. The adnexal structures are surrounded by the tumour but are usually not disrupted. Elastic fibres are preserved or even slightly increased. DM extension into the superficial subcutis is rare.</p>\r\n<h6>Immunohistochemistry</h6>\r\n<p>DM usually expresses vimentin and calponin, while &alpha;-SMA and CD34 show variable positivity. Desmin, h-caldesmon, and S100 are negative {33059951; 19155724}.</p>\r\n<h6>Differential diagnosis</h6>\r\n<p>The main differential diagnosis includes dermatofibroma and plaque-stage dermatofibrosarcoma protuberans {31908825}. Unlike in dermatofibrosarcoma protuberans, there is no <em>COL1A1</em>::<em>PDGFB</em> rearrangement {31090131}.</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 832,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Cytology",
    "headingPosition": 13,
    "headingid": 775,
    "contributions": [
      {
        "pkcontributionId": 127558,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 775,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 833,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 776,
    "contributions": [
      {
        "pkcontributionId": 127559,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 776,
        "headingText": "\r\n<p>The absence of <em>COL1A1</em>::<em>PDGFB</em> rearrangement may help in challenging cases.</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127560,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a benign myofibroblastic proliferation limited to the reticular dermis; groups of spindle cells arranged in fascicles and parallel to the epidermis.</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 127561,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127562,
        "bookId": 64,
        "chapterId": 238,
        "headingId": 778,
        "headingText": "\r\n<p>DM is a benign tumour. Recurrences are rare even after incomplete excision {19155724}.</p>",
        "timestamp": "2025-04-25T09:59:06"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

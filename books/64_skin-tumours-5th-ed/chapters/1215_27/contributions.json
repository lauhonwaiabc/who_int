  {
    "pkheadingid": 827,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Clinical features",
    "headingPosition": 7,
    "headingid": 770,
    "contributions": [
      {
        "pkcontributionId": 124486,
        "bookId": 64,
        "chapterId": 27,
        "headingId": 770,
        "headingText": "\r\n<p>Patients with this type present with a poorly defined, scar-like plaque that rarely ulcerates or bleeds {16446711}. On dermoscopy it is typified by thin serpentine vessels.</p>\r\n",
        "timestamp": "2025-04-24T14:40:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

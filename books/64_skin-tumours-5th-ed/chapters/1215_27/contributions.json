    "contributions": [
      {
        "pkcontributionId": 124480,
        "bookId": 64,
        "chapterId": 27,
        "headingId": 764,
        "headingText": "\r\n<p>Sclerosing/morphoeic basal cell carcinoma (BCC) is a BCC type characterized by very thin cords of basaloid cells surrounded by abundant collagenous stroma.</p>\r\n",
        "timestamp": "2025-04-24T14:40:24"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

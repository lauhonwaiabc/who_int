    "headingTitle": "Diagnostic molecular pathology",
    "headingPosition": 14,
    "headingid": 776,
    "contributions": [
      {
        "pkcontributionId": 127746,
        "bookId": 64,
        "chapterId": 250,
        "headingId": 776,
        "headingText": "\r\n<p>None</p>\r\n",
        "timestamp": "2025-04-25T11:56:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 127747,
        "bookId": 64,
        "chapterId": 250,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a superficial dermal, wedge-shaped collection of irregular, thin-walled lymphatic vascular channels lined by hobnail endothelial cells.</p>\r\n<p><em>Desirable:</em> perilesional deposits of haemosiderin.</p>\r\n",
        "timestamp": "2025-04-25T11:56:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 127748,
        "bookId": 64,
        "chapterId": 250,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T11:56:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 127749,
        "bookId": 64,
        "chapterId": 250,
        "headingId": 778,
        "headingText": "\r\n<p>Hobnail haemangioma is benign, with no tendency for recurrence.</p>",
        "timestamp": "2025-04-25T11:56:28"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
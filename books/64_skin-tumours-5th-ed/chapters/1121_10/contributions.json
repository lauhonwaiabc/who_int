[
  {
    "pkheadingid": 821,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 764,
    "contributions": [
      {
        "pkcontributionId": 124225,
        "bookId": 64,
        "chapterId": 10,
        "headingId": 764,
        "headingText": "\r\n<p>Verruca vulgaris is a common HPV-induced benign cutaneous squamoproliferative lesion.</p>\r\n",
        "timestamp": "2025-04-24T14:01:30"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 822,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

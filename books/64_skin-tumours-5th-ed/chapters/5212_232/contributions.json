  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 128444,
        "bookId": 64,
        "chapterId": 232,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a well-circumscribed dermal tumour composed of uniform plump epithelioid cells with vesicular nuclei, small nucleoli, and abundant pale eosinophilic or amphophilic cytoplasm.</p>\r\n<p><em>Desirable:</em> usually positive for ALK.</p>\r\n",
        "timestamp": "2025-04-25T15:04:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T15:04:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 128446,
        "bookId": 64,
        "chapterId": 232,
        "headingId": 778,
        "headingText": "\r\n<p>Epithelioid fibrous histiocytoma is benign; rarely, it recurs locally {2466472; 8181804}.</p>",
        "timestamp": "2025-04-25T15:04:05"
      }
    ],

  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 125483,
        "bookId": 64,
        "chapterId": 103,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> a unilocular or multilocular cystic lesion lined by columnar cells with or without decapitation secretion and surrounded by a layer of myoepithelial cells.</p>\r\n",
        "timestamp": "2025-04-24T17:42:15"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

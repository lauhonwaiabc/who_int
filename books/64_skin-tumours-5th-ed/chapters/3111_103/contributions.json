        "timestamp": "2025-04-24T17:42:15"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 125485,
        "bookId": 64,
        "chapterId": 103,
        "headingId": 778,
        "headingText": "\r\n<p>Hidrocystomas are benign lesions.</p>",
        "timestamp": "2025-04-24T17:42:15"
      }

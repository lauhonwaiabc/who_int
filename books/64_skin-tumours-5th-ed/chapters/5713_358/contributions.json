  },
  {
    "pkheadingid": 836,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 779,
    "contributions": [
      {
        "pkcontributionId": 128461,
        "bookId": 64,
        "chapterId": 358,
        "headingId": 779,
        "headingText": "\r\n<p><em>Essential:</em> dermal tumour of granular cells; no expression of lineage-specific markers; nuclear pleomorphism and mitotic activity are acceptable.</p>\r\n<p><em>Desirable:</em> ALK-positive staining or <em>ALK</em> rearrangement in selected cases.</p>\r\n",
        "timestamp": "2025-04-25T15:04:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 834,

    "headingTitle": "Staging",
    "headingPosition": 16,
    "headingid": 777,
    "contributions": [
      {
        "pkcontributionId": 128462,
        "bookId": 64,
        "chapterId": 358,
        "headingId": 777,
        "headingText": "\r\n<p>Not relevant</p>\r\n",
        "timestamp": "2025-04-25T15:04:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 835,
    "bookid": 64,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 778,
    "contributions": [
      {
        "pkcontributionId": 128463,
        "bookId": 64,
        "chapterId": 358,
        "headingId": 778,
        "headingText": "\r\n<p>Most cases are indolent, despite worrisome histopathological features. Few cases with regional lymph node metastasis have been reported, without further dissemination or recurrence {19734486; 15958858}.</p>",
        "timestamp": "2025-04-25T15:04:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

  {
    "pkattachmentId": 80890,
    "bookid": 67,
    "chapterId": 70,
    "fileId": 38829,
    "type": "Figure",
    "diagnosis": "Interactions between E-cadherin and the cytoskeleton",
    "title": "",
    "legend": "E-cadherin is localized to the adherens junction on the basolateral surface of epithelial cells. It forms homophilic interactions with adjacent cells, effectively forming a bridge between the cells&rsquo; actin cytoskeletons. The cytoplasmic side of this bridge is composed primarily of a complex of catenin proteins (p120 catenin, &alpha;-catenin, and &beta;-catenin), but with numerous other proteins such as vinculin forming stable or transient interactions with F-actin. These interactions act to mediate adhesion-related functions, such as changes to a cell&rsquo;s morphology, motility, and responses to force transduction. E-cadherin also interacts with the microtubule network. The plus ends of astral microtubules are directed to the adherens junction through a direct interaction between E-cadherin and the dynein/NuMA/G<sub>i</sub>&alpha;/LGN complex, providing orientation for the mitotic spindle parallel to the epithelial plane. The adherens junction protein p120 also makes contact with the lateral microtubules via interactions with PLEKHA7 and Nezha (not shown).",
    "source": "",
    "copyright": "<p class=\"Listing\">Reprinted, with permission from Elsevier, from: Decourtye-Espiard L, Guilford P. Hereditary diffuse gastric cancer. Gastroenterology. 2023;S0016-5085(23)00110-5. PMID:36740198</p>",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/67/70/38829.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/67/70/thumb_38829.jpg"
  },

    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 417.7pt; border-collapse: collapse;\" border=\"0\" width=\"557\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 205.05pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"273\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.65pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Syndrome characteristics</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 205.05pt; padding: 0cm 5.4pt;\" width=\"273\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Syndrome MIM number(s)</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.65pt; padding: 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">210900</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 205.05pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"273\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Associated gene(s)</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.65pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">RECQL3</span></em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 205.05pt; padding: 0cm 5.4pt;\" width=\"273\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.65pt; padding: 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Haematological malignancies include acute myeloid leukaemia, acute lymphoblastic leukaemia, and lymphoma; solid tumours include Wilms tumour, breast cancer, and colon cancer</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 205.05pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"273\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Associated benign tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.65pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">None reported</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 205.05pt; padding: 0cm 5.4pt;\" width=\"273\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Cancer-related inheritance</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.65pt; padding: 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Autosomal recessive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 205.05pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"273\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Chromosome location</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.65pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">RECQL3</span></em><span lang=\"EN-GB\"> (15q26.1)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 205.05pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"273\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Protein product&ndash;associated pathway</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.65pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"284\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Maintain chromosomal stability and homologous recombination</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

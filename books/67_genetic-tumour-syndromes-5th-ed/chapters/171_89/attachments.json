    "title": "<p class=\"TableTitle\"><strong><span lang=\"EN-GB\">Table&nbsp;2.38</span></strong><span lang=\"EN-GB\"> Summary of the main features of Brooke&ndash;Spiegler syndrome</span></p>\r\n<p>&nbsp;</p>",
    "legend": "",
    "source": "Section authors",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 694.5pt; border-collapse: collapse;\" border=\"0\" width=\"926\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Syndrome characteristics</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Syndrome MIM number(s)</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; padding: 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">605041, 132700, 601606</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Malignant neoplasms ex cylindroma and spiradenoma, basal cell carcinoma (skin, rare), basal cell adenocarcinoma (salivary glands, rare)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Associated benign tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; padding: 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Spiradenoma, cylindroma, spiradenocylindroma, cribriform trichoblastoma (skin), basal cell adenoma, membranous type (salivary gland, rare)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Cancer-related inheritance</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Autosomal dominant</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Chromosome location</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; padding: 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">CYLD</span></em><span lang=\"EN-GB\"> (16q12.1)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; background: #daeef3; padding: 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Protein product&ndash;associated pathway</span></strong></p>\r\n</td>\r\n<td style=\"width: 481.9pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; background: #daeef3; padding: 0cm 5.4pt;\" width=\"643\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Negatively regulates NF-&kappa;B, WNT, NOTCH, and TGF-&beta;</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

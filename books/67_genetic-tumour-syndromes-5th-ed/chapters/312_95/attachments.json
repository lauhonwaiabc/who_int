  },
  {
    "pkattachmentId": 80533,
    "bookid": 67,
    "chapterId": 95,
    "fileId": 37098,
    "type": "Figure",
    "diagnosis": "Adenosarcoma of the uterus arising in HPTJT syndrome",
    "title": "",
    "legend": "Parafibromin immunohistochemistry has not been well validated as a diagnostic marker of adenosarcoma in the setting of HPTJT syndrome. However in this case the stromal component of the adenosarcoma demonstrates loss of nuclear expression which contrast with the preserved expression in the glandular component and the adjacnet non-neoplastic stroma.",
    "source": "Endo5",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/67/95/23870.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/67/95/thumb_23870.jpg"
  },
  {
    "pkattachmentId": 80534,
    "bookid": 67,
    "chapterId": 95,
    "fileId": 37099,
    "type": "Figure",
    "diagnosis": "Parafibromin-deficient parathyroid tumour",
    "title": "",
    "legend": "Immunohistochemistry for parafibromin can be difficult to interpret. It is emphasized that significance is placed on nuclear expression only and non-specific cytoplasmic expression should be disregarded. In this case all the neoplastic cells show loss of expression of parafibromin and there is preserved expression in non-neoplastic cells. Therefore the tumour is considered parafibromin-deficient.",
    "source": "Endo5",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/67/95/23875.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/67/95/thumb_23875.jpg"
  },

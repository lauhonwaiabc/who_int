    "title": "<p class=\"TableTitle\"><strong><span lang=\"EN-GB\">Table&nbsp;4.02</span></strong><span lang=\"EN-GB\"> Summary of the main features of Li&ndash;Fraumeni syndrome</span></p>",
    "legend": "",
    "source": "Sigurd F. Lax",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 564.469px; border-collapse: collapse;\" border=\"0\" width=\"72%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 190.859px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"36%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 344.859px; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"63%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Syndrome characteristics</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 190.859px; padding: 0cm 5.4pt;\" width=\"36%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Syndrome MIM number(s)</span></strong></p>\r\n</td>\r\n<td style=\"width: 344.859px; padding: 0cm 5.4pt;\" width=\"63%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">151623</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 190.859px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"36%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 344.859px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"63%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Breast carcinoma, soft tissue sarcomas, osteosarcoma, choroid plexus carcinoma, diffuse gliomas, medulloblastoma, adrenocortical carcinoma, lung carcinoma, pancreatic carcinoma, prostatic carcinoma, gastrointestinal carcinomas, ovarian and uterine carcinomas</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 190.859px; padding: 0cm 5.4pt;\" width=\"36%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Associated benign tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 344.859px; padding: 0cm 5.4pt;\" width=\"63%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">No evidence</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 190.859px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"36%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Cancer-related inheritance</span></strong></p>\r\n</td>\r\n<td style=\"width: 344.859px; background: #daeef3; padding: 0cm 5.4pt;\" width=\"63%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Autosomal dominant</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 190.859px; padding: 0cm 5.4pt;\" width=\"36%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Chromosome location</span></strong></p>\r\n</td>\r\n<td style=\"width: 344.859px; padding: 0cm 5.4pt;\" width=\"63%\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><spa
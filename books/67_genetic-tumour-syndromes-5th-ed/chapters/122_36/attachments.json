    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 425.2pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"567\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.6pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Syndrome characteristics</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong>Syndrome MIM number(s)</strong></p>\r\n</td>\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\">174800</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Pancreatic intraductal papillary mucinous neoplasms</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong>Associated benign tumours</strong></p>\r\n</td>\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\">Fibrous dysplasia, gastric polyps, intramuscular myxomas</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cancer-related inheritance</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Somatic mosaic activation</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong>Chromosome location</strong></p>\r\n</td>\r\n<td style=\"width: 212.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><em>GNAS</em> (20q13.32)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 212.6pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Protein product&ndash;associated pathway</span></strong></p>\r\n</td>\r\n<td style=\"width: 212.6pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"283\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">G protein&ndash;coupled receptor pathway</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

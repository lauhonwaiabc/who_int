    "title": "<p class=\"TableTitle\"><strong><span lang=\"EN-GB\">Box&nbsp;5.04</span></strong><span lang=\"EN-GB\"> Klinefelter syndrome features </span><span class=\"Ref-ID\"><span lang=\"EN-GB\">{27644703}</span></span></p>",
    "legend": "",

    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 432.35pt; border-collapse: collapse;\" border=\"0\" width=\"576\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Syndrome characteristics</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; padding: 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Syndrome MIM number(s)</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">618625</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Osteosarcoma, skin malignancies, lymphoma, adenocarcinoma of the gastrointestinal system, squamous cell carcinoma of the head-and-neck region</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; padding: 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Associated benign tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Not applicable</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Cancer-related inheritance</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Autosomal recessive</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; padding: 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Chromosome location</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; padding: 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">RECQL4</span></em><span lang=\"EN-GB\"> (8q24.3)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">ANAPC1</span></em><span lang=\"EN-GB\"> (2q13)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 184.3pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; background: #daeef3; padding: 0cm 5.4pt;\" width=\"246\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Protein product&ndash;associated pathway</span></strong></p>\r\n</td>\r\n<td style=\"width: 248.05pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; background: #daeef3; padding: 0cm 5.4pt;\" width=\"331\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Helicases</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

  },
  {
    "pkattachmentId": 32088,
    "bookid": 31,
    "chapterId": 117,
    "fileId": 498,
    "type": "Figure",
    "diagnosis": "<p>Acinar cystic transformation</p>",
    "title": "",
    "legend": "<p>Multilocular acinar cystic transformation is characterized by dilated and interconnecting clusters of acinar epithelium that open into larger cysts lined by epithelium with separate regions of acinar and ductal differentiation.</p>",
    "source": "Aatur D. Singhi",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/31/117/498.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/31/117/thumb_498.jpg"
  },
  {

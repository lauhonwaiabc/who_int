[
  {
    "pkheadingid": 359,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 159,
    "contributions": [
      {
        "pkcontributionId": 55753,
        "bookId": 31,
        "chapterId": 248,
        "headingId": 159,
        "headingText": "\r\n<p>Histiocytic sarcoma is a malignant proliferation of cells showing morphological and immunophenotypic features of tissue histiocytes.</p>\r\n",
        "timestamp": "2019-04-10T11:41:51"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 159,
    "contributions": [
      {
        "pkcontributionId": 55719,
        "bookId": 31,
        "chapterId": 246,
        "headingId": 159,
        "headingText": "\r\n<p>Langerhans cell histiocytosis (LCH) is a clonal proliferation of cells with morphological and immunophenotypic features of Langerhans cells.</p>\r\n",
        "timestamp": "2019-04-10T11:39:34"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 360,

    "fileId": 807,
    "type": "Table",
    "diagnosis": "",
    "title": "<p><strong>Table&nbsp;3.06</strong> Key clinicopathological features of gastric neuroendocrine tumour (NET) types 1, 2, and 3</p>",
    "legend": "",
    "source": "source error",
    "copyright": "",
    "tablehtml": "<table border=\"1\" width=\"102%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>Feature</strong></p>\r\n</td>\r\n<td width=\"21%\">\r\n<p><strong>Type 1&nbsp;ECL-cell NET</strong></p>\r\n</td>\r\n<td width=\"29%\">\r\n<p><strong>Type 2&nbsp;ECL-cell NET</strong></p>\r\n</td>\r\n<td width=\"23%\">\r\n<p><strong>Type 3&nbsp;NET</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>M:F ratio</strong></p>\r\n</td>\r\n<td width=\"21%\">\r\n<p>0.4:1</p>\r\n</td>\r\n<td width=\"29%\">\r\n<p>1:1</p>\r\n</td>\r\n<td width=\"23%\">\r\n<p>2.8:1</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>Relative frequency</strong></p>\r\n</td>\r\n<td width=\"21%\">\r\n<p>80&ndash;90%</p>\r\n</td>\r\n<td width=\"29%\">\r\n<p>5&ndash;7%</p>\r\n</td>\r\n<td width=\"23%\">\r\n<p>10&ndash;15%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>Hypergastrinaemia</strong></p>\r\n</td>\r\n<td width=\"21%\">\r\n<p>Yes</p>\r\n</td>\r\n<td width=\"29%\">\r\n<p>Yes</p>\r\n</td>\r\n<td width=\"23%\">\r\n<p>No</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>Antral G-cell hyperplasia</strong></p>\r\n</td>\r\n<td width=\"21%\">\r\n<p>Yes</p>\r\n</td>\r\n<td width=\"29%\">\r\n<p>No</p>\r\n</td>\r\n<td width=\"23%\">\r\n<p>No</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>Acid secretion</strong></p>\r\n</td>\r\n<td width=\"21%\">\r\n<p>Low or absent</p>\r\n</td>\r\n<td width=\"29%\">\r\n<p>High</p>\r\n</td>\r\n<td width=\"23%\">\r\n<p>Normal</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>Background mucosa</strong></p>\r\n</td>\r\n<td width=\"21%\">\r\n<p>Atrophic gastritis</p>\r\n</td>\r\n<td width=\"29%\">\r\n<p>Parietal cell hypertrophy/hyperplasia</p>\r\n</td>\r\n<td width=\"23%\">\r\n<p>No specific change</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>ECL-cell proliferations</strong></p>\r\n</td>\r\n<td width=\"21%\">\r\n<p>Yes</p>\r\n</td>\r\n<td width=\"29%\">\r\n<p>Yes</p>\r\n</td>\r\n<td width=\"23%\">\r\n<p>No</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>Grading</strong></p>\r\n</td>\r\n<td valign=\"top\" width=\"21%\">\r\n<p>G1</p>\r\n<p>G2 (rare)</p>\r\n<p>G3 (exceptional)</p>\r\n</td>\r\n<td valign=\"top\" width=\"29%\">\r\n<p>G1</p>\r\n<p>G2 (rare)</p>\r\n</td>\r\n<td valign=\"top\" width=\"23%\">\r\n<p>G1 (rare)</p>\r\n<p>G2</p>\r\n<p>G3 (rare)</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>Staging</strong></p>\r\n</td>\r\n<td width=\"21%\">\r\n<p>I&ndash;II: 95%</p>\r\n<p>III: 4%</p>\r\n<p>IV: 1%</p>\r\n</td>\r\n<td width=\"29%\">\r\n<p>I&ndash;II: 70%</p>\r\n<p>III: 20%</p>\r\n<p>IV: 10%</p>\r\n</td>\r\n<td width=\"23%\">\r\n<p>I&ndash;II: 38%</p>\r\n<p>III: 32%</p>\r\n<p>IV: 30%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>Metastasis rate</strong></p>\r\n</td>\r\n<td width=\"21%\">\r\n<p>1&ndash;3%</p>\r\n</td>\r\n<td width=\"29%\">\r\n<p>10&ndash;30%</p>\r\n</td>\r\n<td width=\"23%\">\r\n<p>50%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"26%\">\r\n<p><strong>5-year survival rate</strong></p>\r\n</td>\r\n<td width=\"21%\">\r\n<p>~100%</p>\r\n</td>\r\n<td width=\"29%\">\r\n<p>60&ndash;90%</p>\r\n</td>\r\n<td width=\"23%\">\r\n<p>&lt;50%</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p>&nbsp;</p>",
    "imageUrl": null,
    "thumbnail": null
  },

d>\r\n</tr>\r\n<tr>\r\n<td colspan=\"3\" width=\"509\">\r\n<p><strong>Dysregulation of IGF signalling</strong></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{10789725; 11146233; 17372916}</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"19\">\r\n<p><em>&nbsp;</em></p>\r\n</td>\r\n<td width=\"264\">\r\n<p><em>PLAG1</em></p>\r\n</td>\r\n<td width=\"226\">\r\n<p>Overexpression</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{14695992}</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"19\">\r\n<p>&nbsp;</p>\r\n</td>\r\n<td width=\"264\">\r\n<p>11p15 gene cluster</p>\r\n</td>\r\n<td width=\"226\">\r\n<p>Imprinting errors (found in cases associated with Beckwith&ndash;Wiedemann syndrome)</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{15999116; 19034281}</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td colspan=\"3\" width=\"509\">\r\n<p><strong>Molecular markers with prognostic significance</strong></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"19\">\r\n<p><em>&nbsp;</em></p>\r\n</td>\r\n<td width=\"264\">\r\n<p><em>PLK1</em></p>\r\n</td>\r\n<td width=\"226\">\r\n<p>Expression indicates poor prognosis</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{15221005}</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"19\">\r\n<p><em>&nbsp;</em></p>\r\n</td>\r\n<td width=\"264\">\r\n<p><em>RASSF1</em></p>\r\n</td>\r\n<td width=\"226\">\r\n<p>Methylation indicates poor response to preoperative chemotherapy</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{16937357; 18537155; 20032811; 23989600}</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p>&nbsp;</p>",

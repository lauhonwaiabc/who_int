    "tablehtml": "<table border=\"1\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td colspan=\"2\" width=\"283\">\r\n<p><strong>Gene or genetic pathway</strong></p>\r\n</td>\r\n<td width=\"226\">\r\n<p><strong>Alteration</strong></p>\r\n</td>\r\n<td width=\"94\">\r\n<p><strong>References</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td colspan=\"2\" width=\"283\">\r\n<p>Microsatellite instability</p>\r\n</td>\r\n<td width=\"226\">\r\n<p>&nbsp;</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{17962810}</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td colspan=\"2\" width=\"283\">\r\n<p><em>TGFB1</em> (encoding TGF-&beta;)</p>\r\n</td>\r\n<td width=\"226\">\r\n<p>Upregulation</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{19200578}</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td colspan=\"2\" width=\"283\">\r\n<p><em>PPARA</em></p>\r\n</td>\r\n<td width=\"226\">\r\n<p>Upregulation</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{19200578}</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td colspan=\"2\" width=\"283\">\r\n<p>Adipocytokine signalling</p>\r\n</td>\r\n<td width=\"226\">\r\n<p>Upregulation</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{19200578}</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td colspan=\"2\" width=\"283\">\r\n<p>Extracellular matrix&ndash;receptor interaction</p>\r\n</td>\r\n<td width=\"226\">\r\n<p>Upregulation</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{19200578}</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td colspan=\"2\" width=\"283\">\r\n<p>Apoptotic pathways</p>\r\n</td>\r\n<td width=\"226\">\r\n<p>Downregulation</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{19200578}</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td colspan=\"3\" width=\"509\">\r\n<p><strong>Upregulation of the WNT/&beta;-catenin signalling pathway</strong></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>{19200578}</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"19\">\r\n<p><em>&nbsp;</em></p>\r\n</td>\r\n<td width=\"264\">\r\n<p><em>CTNNB1</em></p>\r\n</td>\r\n<td width=\"226\">\r\n<p>Mutation; deletions in exon&nbsp;3 and exon&nbsp;4</p>\r\n</td>\r\n<td width
        "chapterId": 20,
        "headingId": 172,
        "headingText": "<p>Not clinically relevant</p>",
        "timestamp": "2019-01-29T15:20:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 373,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 173,
    "contributions": [
      {
        "pkcontributionId": 54228,
        "bookId": 31,
        "chapterId": 20,
        "headingId": 173,
        "headingText": "<p>Sporadic FGPs associated with proton-pump inhibitor therapy disappear when the therapy is discontinued. There have been no reliable reports of malignant transformation occurring in the sporadic setting. For information about the hereditary setting, see <a style=\"cursor:pointer\" href=\"/chaptercontent/31/229\" target=\"_blank\">section </a><em>GAPPS and other fundic gland polyposes</em>.</p>",
        "timestamp": "2019-06-04T15:18:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }
]
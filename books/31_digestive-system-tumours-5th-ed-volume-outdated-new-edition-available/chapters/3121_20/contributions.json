  },
  {
    "pkheadingid": 374,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 174,
    "contributions": [
      {
        "pkcontributionId": 54226,
        "bookId": 31,
        "chapterId": 20,
        "headingId": 174,
        "headingText": "<p><em>Essential:</em> hyperplastic expansion of the deeper epithelial compartment of the oxyntic mucosa with dilatation of one or more oxyntic glands; parietal cell hyperplasia; foveolar hypoplasia.</p>",
        "timestamp": "2019-01-29T15:20:25"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 372,
    "bookid": 31,

        "chapterId": 210,
        "headingId": 170,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-04-15T16:35:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

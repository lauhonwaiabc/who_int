  },
  {
    "pkheadingid": 362,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 162,
    "contributions": [
      {
        "pkcontributionId": 56080,
        "bookId": 31,
        "chapterId": 210,
        "headingId": 162,
        "headingText": "\r\n<p><em>Acceptable:</em> benign fibroblastic polyp.</p>\r\n",
        "timestamp": "2019-04-15T16:35:10"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 363,
    "bookid": 31,
    "headingType": 2,

      {
        "pkcontributionId": 54348,
        "bookId": 31,
        "chapterId": 30,
        "headingId": 159,
        "headingText": "<p>Squamous cell carcinoma of the stomach is a malignant gastric epithelial neoplasm showing squamous cell differentiation, characterized by keratinocyte-type cells with intercellular bridges and/or keratinization.</p>",
        "timestamp": "2019-01-29T16:36:04"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

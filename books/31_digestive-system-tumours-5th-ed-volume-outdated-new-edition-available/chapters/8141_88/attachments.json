    "title": "<p><strong>Table&nbsp;8.14</strong> Comparison of mucinous cystic neoplasm of the liver with other hepatobiliary cystic lesions</p>",
    "legend": "",
    "source": "Yasuni Nakanuma",
    "copyright": "",
    "tablehtml": "<table border=\"1\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td width=\"141\">\r\n<p><strong>Lesion</strong></p>\r\n</td>\r\n<td width=\"123\">\r\n<p><strong>Lining epithelium</strong></p>\r\n</td>\r\n<td width=\"158\">\r\n<p><strong>Stroma</strong></p>\r\n</td>\r\n<td width=\"78\">\r\n<p><strong>Papillary lesion</strong></p>\r\n</td>\r\n<td width=\"125\">\r\n<p><strong>Communication with duct lumen</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"141\">\r\n<p>Mucinous cystic neoplasm</p>\r\n</td>\r\n<td valign=\"top\" width=\"123\">\r\n<p>Mostly biliary</p>\r\n</td>\r\n<td valign=\"top\" width=\"158\">\r\n<p>Ovarian-like stroma</p>\r\n<p>PR+, ER+</p>\r\n</td>\r\n<td valign=\"top\" width=\"78\">\r\n<p>&minus;/+++</p>\r\n</td>\r\n<td valign=\"top\" width=\"125\">\r\n<p>Absent</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"141\">\r\n<p>Endometrial cyst</p>\r\n</td>\r\n<td valign=\"top\" width=\"123\">\r\n<p>Endometrial</p>\r\n</td>\r\n<td valign=\"top\" width=\"158\">\r\n<p>Endometrial stroma</p>\r\n<p>CD10+, PR+, ER+</p>\r\n</td>\r\n<td valign=\"top\" width=\"78\">\r\n<p>&minus;</p>\r\n</td>\r\n<td valign=\"top\" width=\"125\">\r\n<p>Absent</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"141\">\r\n<p>Intraductal papillary neoplasm</p>\r\n</td>\r\n<td valign=\"top\" width=\"123\">\r\n<p>Usually biliary, metaplastic</p>\r\n</td>\r\n<td valign=\"top\" width=\"158\">\r\n<p>Fibrous</p>\r\n</td>\r\n<td valign=\"top\" width=\"78\">\r\n<p>+++</p>\r\n</td>\r\n<td valign=\"top\" width=\"125\">\r\n<p>Present</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"141\">\r\n<p>Bile duct cyst</p>\r\n</td>\r\n<td valign=\"top\" width=\"123\">\r\n<p>Biliary</p>\r\n</td>\r\n<td valign=\"top\" width=\"158\">\r\n<p>Fibrous</p>\r\n</td>\r\n<td valign=\"top\" width=\"78\">\r\n<p>&minus;</p>\r\n</td>\r\n<td valign=\"top\" width=\"125\">\r\n<p>Absent</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"141\">\r\n<p>Peribiliary cyst</p>\r\n</td>\r\n<td valign=\"top\" width=\"123\">\r\n<p>Biliary</p>\r\n</td>\r\n<td valign=\"top\" width=\"158\">\r\n<p>Fibrous</p>\r\n</td>\r\n<td valign=\"top\" width=\"78\">\r\n<p>&minus;/+</p>\r\n</td>\r\n<td valign=\"top\" width=\"125\">\r\n<p>Absent</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"141\">\r\n<p>Hepatic microcystic serous cystadenoma</p>\r\n</td>\r\n<td valign=\"top\" width=\"123\">\r\n<p>Glycogen-rich cuboidal cells</p>\r\n</td>\r\n<td valign=\"top\" width=\"158\">\r\n<p>Fibrous</p>\r\n</td>\r\n<td valign=\"top\" width=\"78\">\r\n<p>&minus;</p>\r\n</td>\r\n<td valign=\"top\" width=\"125\">\r\n<p>Absent</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"141\">\r\n<p>Hepatic foregut cyst</p>\r\n</td>\r\n<td valign=\"top\" width=\"123\">\r\n<p>Bronchial</p>\r\n</td>\r\n<td valign=\"top\" width=\"158\">\r\n<p>Smooth muscle layer, fibrous</p>\r\n</td>\r\n<td valign=\"top\" width=\"78\">\r\n<p>&minus;</p>\r\n</td>\r\n<td valign=\"top\" width=\"125\">\r\n<p>Absent</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

    "tablehtml": "<table border=\"1\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td width=\"58\">\r\n<p align=\"center\"><strong>Grade</strong></p>\r\n</td>\r\n<td width=\"275\">\r\n<p align=\"center\"><strong>Tubular or clustered growth<br />(low-grade pattern)</strong></p>\r\n</td>\r\n<td width=\"275\">\r\n<p align=\"center\"><strong>Loss of tubular or clustered growth<br />(any combination of high-grade patterns)</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"58\">\r\n<p align=\"center\"><strong>1</strong></p>\r\n</td>\r\n<td valign=\"top\" width=\"275\">\r\n<p align=\"center\">&gt;&nbsp;75%</p>\r\n</td>\r\n<td valign=\"top\" width=\"275\">\r\n<p align=\"center\">&lt;&nbsp;25%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"58\">\r\n<p align=\"center\"><strong>2</strong></p>\r\n</td>\r\n<td valign=\"top\" width=\"275\">\r\n<p align=\"center\">50&ndash;75%</p>\r\n</td>\r\n<td valign=\"top\" width=\"275\">\r\n<p align=\"center\">25&ndash;50%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"58\">\r\n<p align=\"center\"><strong>3</strong></p>\r\n</td>\r\n<td valign=\"top\" width=\"275\">\r\n<p align=\"center\">&lt;&nbsp;50%</p>\r\n</td>\r\n<td valign=\"top\" width=\"275\">\r\n<p align=\"center\">&gt;&nbsp;50%</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

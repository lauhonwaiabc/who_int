[
  {
    "pkheadingid": 359,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 159,
    "contributions": [
      {
        "pkcontributionId": 56179,
        "bookId": 31,
        "chapterId": 216,
        "headingId": 159,
        "headingText": "\r\n<p>Gastrointestinal clear cell sarcoma (CCS)&nbsp;/ malignant gastrointestinal neuroectodermal tumour (GNET) is a sarcoma involving the GI tract with neuroectodermal differentiation and gene fusion translocations involving <em>EWSR1</em>, usually <em>EWSR1</em>-<em>ATF1</em> or <em>EWSR1</em>-<em>CREB1</em>.</p>\r\n",
        "timestamp": "2019-04-15T16:40:42"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 360,
    "bookid": 31,

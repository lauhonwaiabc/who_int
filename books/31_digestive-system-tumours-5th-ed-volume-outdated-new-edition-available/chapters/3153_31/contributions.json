[
  {
    "pkheadingid": 359,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 159,
    "contributions": [
      {
        "pkcontributionId": 54365,
        "bookId": 31,
        "chapterId": 31,
        "headingId": 159,
        "headingText": "<p></p>\r\n<p>Adenosquamous carcinoma of the stomach is a primary gastric carcinoma composed of both glandular and squamous cell components, with the squamous cell component constituting &ge;&nbsp;25% of the tumour.</p>",
        "timestamp": "2019-02-12T12:06:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

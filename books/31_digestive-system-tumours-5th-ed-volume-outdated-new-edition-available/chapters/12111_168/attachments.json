  {
    "pkattachmentId": 32923,
    "bookid": 31,
    "chapterId": 168,
    "fileId": 886,
    "type": "Table",
    "diagnosis": "",
    "title": "<p><strong>Table&nbsp;11.02</strong> Summary of the main characteristics of extranodal marginal zone lymphoma of mucosa-associated lymphoid tissue (MALT lymphoma) of the digestive tract</p>",
    "legend": "",
    "source": "source error",
    "copyright": "",
    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 703.05pt; border-collapse: collapse; border: none;\" border=\"1\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"height: 3.5pt;\">\r\n<td style=\"width: 74.8pt; border: solid #BFBFBF 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"100\">\r\n<p class=\"TableText\"><strong>Primary site</strong></p>\r\n</td>\r\n<td style=\"width: 46.15pt; border: solid #BFBFBF 1.0pt; border-left: none; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"62\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>% of EMZL</strong></p>\r\n</td>\r\n<td style=\"width: 226.1pt; border: solid #BFBFBF 1.0pt; border-left: none; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"301\">\r\n<p class=\"TableText\"><strong>Infection, autoimmunity, and other characteristics</strong></p>\r\n</td>\r\n<td style=\"width: 356.0pt; border: solid #BFBFBF 1.0pt; border-left: none; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"475\">\r\n<p class=\"TableText\"><strong>Genetic alterations</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 3.5pt;\">\r\n<td style=\"width: 74.8pt; border: solid #BFBFBF 1.0pt; border-top: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"100\">\r\n<p class=\"TableText\"><strong>Oesophagus</strong></p>\r\n</td>\r\n<td style=\"width: 46.15pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; border-right: solid #BFBFBF 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"62\">&nbsp;</td>\r\n<td style=\"width: 226.1pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; border-right: solid #BFBFBF 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"301\">\r\n<p class=\"TableText\">Unknown</p>\r\n</td>\r\n<td style=\"width: 356.0pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; border-right: solid #BFBFBF 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"475\">\r\n<p class=\"TableText\">Not reported</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 34.95pt;\">\r\n<td style=\"width: 74.8pt; border: solid #BFBFBF 1.0pt; border-top: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 34.95pt;\" width=\"100\">\r\n<p class=\"TableText\"><strong>Stomach</strong></p>\r\n</td>\r\n<td style=\"width: 46.15pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; border-right: solid #BFBFBF 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 34.95pt;\" width=\"62\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">70%</p>\r\n</td>\r\n<td style=\"width: 226.1pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; border-right: solid #BFBFBF 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 34.95pt;\" width=\"301\">\r\n<p class=\"TableText\"><em>Helicobacter&nbsp;pylori</em> (85%) and <em>H.&nbsp;heilmannii</em> (&lt;&nbsp;1%)</p>\r\n</td>\r\n<td style=\"width: 356.0pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; border-right: solid #BFBFBF 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 34.95pt;\" width=\"475\">\r\n<p class=\"TableText\">t(11;18)(q21;q21)/<em>BIRC3</em>-<em>MALT1</em> (6&ndash;26%), t(14;18)(q32;q21)/IGH-<em>MALT1</em> (1&ndash;5%), t(3;14)(p14;q32)/IGH-<em>FOXP1</em> (0&ndash;3%), t(1;14)(p22;q32)/IGH-<em>BCL10</em> (0&ndash;2%), trisomy&nbsp;3 (11%), trisomy&nbsp;18 (6%), and <em>TNFAIP3</em> inactivation (5%)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 3.5pt;\">\r\n<td style=\"width: 74.8pt; border: solid #BFBFBF 1.0pt; border-top: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"100\">\r\n<p class=\"TableText\"><strong>Intestinal tract</strong></p>\r\n</td>\r\n<td style=\"width: 46.15pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; border-right: solid #BFBFBF 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"62\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">2%</p>\r\n</td>\r\n<td style=\"width: 226.1pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; border-right: solid #BFBFBF 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"301\">\r\n<p class=\"TableText\"><em>Campylobacter jejuni</em> (50%)</p>\r\n</td>\r\n<td style=\"width: 356.0pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; border-right: solid #BFBFBF 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"475\">\r\n<p class=\"TableText\">t(11;18)(q21;q21)/<em>BIRC3</em>-<em>MALT1</em> (12&ndash;56%), t(1;14)(p22;q32)/IGH-<em>BCL10</em> (0&ndash;13%), trisomy&nbsp;3 (75%), and trisomy&nbsp;18 (25%)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 3.5pt;\">\r\n<td style=\"width: 74.8pt; border: solid #BFBFBF 1.0pt; border-top: none; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"100\">\r\n<p class=\"TableText\"><strong>Liver</strong></p>\r\n</td>\r\n<td style=\"width: 46.15pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; border-right: solid #BFBFBF 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"62\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">10%</p>\r\n</td>\r\n<td style=\"width: 226.1pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; border-right: solid #BFBFBF 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 3.5pt;\" width=\"301\">\r\n<p class=\"TableText\">HCV (23%), HBV (16%), hepatitis of other causes (10%), <em>H.&nbsp;pylori</em> (13%), autoimmune hepatitis&nbsp;/ primary biliary cirrhosis&nbsp;/ Sj&ouml;gren syndrome (12%), ascariasis (4%), and synchronous malignant tumours (11%)</p>\r\n</td>\r\n<td style=\"width: 356.0pt; border
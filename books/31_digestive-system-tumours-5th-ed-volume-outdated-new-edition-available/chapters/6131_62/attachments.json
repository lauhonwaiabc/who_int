    "tablehtml": "<div>\r\n<table border=\"1\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td width=\"273\">\r\n<p><strong>Syndrome</strong></p>\r\n</td>\r\n<td width=\"164\">\r\n<p><strong>Genes involved</strong></p>\r\n</td>\r\n<td width=\"94\">\r\n<p><strong>Inheritance pattern</strong></p>\r\n</td>\r\n<td width=\"78\">\r\n<p><strong>CRC risk</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p>Lynch syndrome</p>\r\n</td>\r\n<td width=\"164\">\r\n<p>Mismatch repair genes (<em>MLH1</em>, <em>MSH2</em>, <em>MSH6</em>, <em>PMS2</em>, others)</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AD</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>10&ndash;50%<sup>a</sup></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p>Familial adenomatous polyposis</p>\r\n</td>\r\n<td width=\"164\">\r\n<p><em>APC</em></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AD</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>100%<sup>b</sup></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p><em>MUTYH</em>-associated polyposis</p>\r\n</td>\r\n<td width=\"164\">\r\n<p><em>MUTYH</em></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AR</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>60&ndash;70%<sup>b</sup></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p><em>NTHL1</em>-associated polyposis</p>\r\n</td>\r\n<td width=\"164\">\r\n<p><em>NTHL1</em></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AR</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>Unknown</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p>Polymerase proofreading&ndash;associated polyposis</p>\r\n</td>\r\n<td width=\"164\">\r\n<p><em>POLD1</em>, <em>POLE</em></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AD</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>30&ndash;70%<sup>c</sup></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p>Constitutional mismatch repair deficiency syndrome</p>\r\n</td>\r\n<td width=\"164\">\r\n<p>Mismatch repair genes (<em>MLH1</em>, <em>MSH2</em>, <em>MSH6</em>, <em>PMS2</em>)</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AR</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>Unknown</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p>Hereditary mixed polyposis syndrome</p>\r\n</td>\r\n<td width=\"164\">\r\n<p><em>GREM1</em></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AD</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>Unknown</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p><em>MSH3</em>-associated polyposis</p>\r\n</td>\r\n<td width=\"164\">\r\n<p><em>MSH3</em></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AR</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>Unknown</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p><em>AXIN2</em>-associated polyposis</p>\r\n</td>\r\n<td width=\"164\">\r\n<p><em>AXIN2</em></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AD</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>Unknown</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p>Immune deficiency&ndash;associated polyposis</p>\r\n</td>\r\n<td width=\"164\">\r\n<p>Various</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>Various</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>Unknown</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p>Serrated polyposis</p>\r\n</td>\r\n<td width=\"164\">\r\n<p>Unknown</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>Unknown</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>Unknown</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p>Juvenile polyposis syndrome</p>\r\n</td>\r\n<td width=\"164\">\r\n<p><em>SMAD4</em> or <em>BMPR1A</em></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AD</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>68%<sup>d</sup></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p>Peutz&ndash;Jeghers syndrome</p>\r\n</td>\r\n<td width=\"164\">\r\n<p><em>STK11</em> (<em>LKB1</em>)</p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AD</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>39%<sup>c</sup></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"273\">\r\n<p>Cowden syndrome</p>\r\n</td>\r\n<td width=\"164\">\r\n<p><em>PTEN</em></p>\r\n</td>\r\n<td width=\"94\">\r\n<p>AD</p>\r\n</td>\r\n<td width=\"78\">\r\n<p>9%<sup>b</sup></p>\r\n</td>
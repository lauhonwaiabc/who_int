  {
    "pkattachmentId": 32641,
    "bookid": 31,
    "chapterId": 232,
    "fileId": 1560,
    "type": "Figure",
    "diagnosis": "<p>Familial adenomatous polyposis (FAP) 1</p>",
    "title": "",
    "legend": "<p>Gastric foveolar-type adenoma. The vast majority of gastric adenomas in FAP are foveolar-type adenomas with low-grade dysplasia, mainly located in the gastric body; distinction between a fundic gland polyp with low-grade dysplasia and a gastric foveolar-type adenoma can be difficult, but this is of little importance because the risk of neoplastic progression is very low for both lesions.&nbsp;</p>",
    "source": "Lodewijk A.A. Brosens",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/31/232/1560.jpg",
    "thumbnail": "https://tumourclassification.iarc.who.int/static/dzi/31/232/thumb_1560.jpg"
  },

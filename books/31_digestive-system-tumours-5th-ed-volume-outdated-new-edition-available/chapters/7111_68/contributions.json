  },
  {
    "pkheadingid": 373,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 173,
    "contributions": [
      {
        "pkcontributionId": 54708,
        "bookId": 31,
        "chapterId": 68,
        "headingId": 173,
        "headingText": "<p>ICP does not recur after removal. Rare cases have been associated with squamous/columnar dysplasia {3500106; 11523931; 10560365}.</p>",
        "timestamp": "2019-03-04T10:25:00"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

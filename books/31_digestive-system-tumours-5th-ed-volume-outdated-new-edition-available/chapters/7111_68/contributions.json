        "headingId": 160,
        "headingText": "<p>None</p>",
        "timestamp": "2019-03-04T10:22:05"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 361,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 161,

  },
  {
    "pkheadingid": 374,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 174,
    "contributions": [
      {
        "pkcontributionId": 54706,
        "bookId": 31,
        "chapterId": 68,
        "headingId": 174,
        "headingText": "<p><em>Essential:</em> epithelial hyperplasia without dysplasia; stromal inflammation; fibromuscular proliferation.</p>",
        "timestamp": "2019-03-04T10:24:37"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 372,

    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 159,
    "contributions": [
      {
        "pkcontributionId": 54692,
        "bookId": 31,
        "chapterId": 68,
        "headingId": 159,
        "headingText": "<p>Inflammatory cloacogenic polyp (ICP) is a non-neoplastic polyp that arises in the anal transitional zone and shows inflammation along with proliferation of glands and smooth muscle.</p>",
        "timestamp": "2019-03-04T10:21:58"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

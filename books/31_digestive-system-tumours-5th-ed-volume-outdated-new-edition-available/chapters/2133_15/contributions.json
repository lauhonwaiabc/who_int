    "contributions": [
      {
        "pkcontributionId": 54176,
        "bookId": 31,
        "chapterId": 15,
        "headingId": 159,
        "headingText": "<p>Undifferentiated carcinoma of the oesophagus is a malignant oesophageal epithelial tumour that lacks definite microscopic features of squamous, glandular, or neuroendocrine differentiation.</p>",
        "timestamp": "2018-12-17T14:14:44"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

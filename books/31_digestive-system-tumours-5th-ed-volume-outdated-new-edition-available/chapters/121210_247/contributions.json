[
  {
    "pkheadingid": 359,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 159,
    "contributions": [
      {
        "pkcontributionId": 55736,
        "bookId": 31,
        "chapterId": 247,
        "headingId": 159,
        "headingText": "\r\n<p>Follicular dendritic cell (FDC) sarcoma is a malignant neoplasm composed of spindled to ovoid cells showing morphological and immunophenotypic features of FDCs.</p>\r\n",
        "timestamp": "2019-04-10T11:40:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 360,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 160,
    "contributions": [
      {

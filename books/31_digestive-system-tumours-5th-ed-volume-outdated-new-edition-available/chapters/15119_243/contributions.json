    "contributions": [
      {
        "pkcontributionId": 56385,
        "bookId": 31,
        "chapterId": 243,
        "headingId": 159,
        "headingText": "<p></p>\r\n<p>Peutz&ndash;Jeghers syndrome (PJS) is an autosomal dominant polyp and cancer predisposition syndrome characterized by mucocutaneous melanin pigmentation and gastrointestinal polyposis.</p>",
        "timestamp": "2019-01-16T16:09:38"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

    "title": "<p><strong>Table&nbsp;14.08</strong> Peutz&ndash;Jeghers syndrome cancer risks for specific anatomical localizations at 65&ndash;70&nbsp;years of age</p>",
    "legend": "",
    "source": "source error",
    "copyright": "",
    "tablehtml": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td valign=\"top\" width=\"118\">\r\n<p><strong>Site</strong></p>\r\n</td>\r\n<td valign=\"top\" width=\"103\">\r\n<p><strong>Cancer risk</strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"118\">\r\n<p>Colorectum</p>\r\n</td>\r\n<td valign=\"top\" width=\"103\">\r\n<p>39%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"118\">\r\n<p>Small intestine</p>\r\n</td>\r\n<td valign=\"top\" width=\"103\">\r\n<p>13%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"118\">\r\n<p>Stomach</p>\r\n</td>\r\n<td valign=\"top\" width=\"103\">\r\n<p>29%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"118\">\r\n<p>Pancreas</p>\r\n</td>\r\n<td valign=\"top\" width=\"103\">\r\n<p>11&ndash;36%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"118\">\r\n<p>Breast</p>\r\n</td>\r\n<td valign=\"top\" width=\"103\">\r\n<p>32&ndash;54%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"118\">\r\n<p>Uterus</p>\r\n</td>\r\n<td valign=\"top\" width=\"103\">\r\n<p>9%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"118\">\r\n<p>Ovary</p>\r\n</td>\r\n<td valign=\"top\" width=\"103\">\r\n<p>21%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"118\">\r\n<p>Cervix</p>\r\n</td>\r\n<td valign=\"top\" width=\"103\">\r\n<p>10%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"118\">\r\n<p>Testis</p>\r\n</td>\r\n<td valign=\"top\" width=\"103\">\r\n<p>9%</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"118\">\r\n<p>Lung</p>\r\n</td>\r\n<td valign=\"top\" width=\"103\">\r\n<p>7&ndash;17%</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p></p>\r\n<p></p>",

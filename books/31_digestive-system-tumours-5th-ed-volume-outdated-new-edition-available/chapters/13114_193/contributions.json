      {
        "pkcontributionId": 55841,
        "bookId": 31,
        "chapterId": 193,
        "headingId": 161,
        "headingText": "\r\n<p>2E80.02 &amp; XH1PL8 Deep internal or visceral lipoma &amp; Lipoma NOS</p>\r\n<p>2E80.02 &amp; XH3C77 Deep internal or visceral lipoma &amp; Angiolipoma</p>\r\n",
        "timestamp": "2019-04-15T16:18:17"

        "timestamp": "2019-04-15T16:18:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 373,
    "bookid": 31,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 173,
    "contributions": [
      {
        "pkcontributionId": 55855,
        "bookId": 31,
        "chapterId": 193,
        "headingId": 173,
        "headingText": "\r\n<p>Gastrointestinal lipomas are benign. Resection, either endoscopic or surgical, is reserved for symptomatic/complicated cases {22298986; 25368224}.</p>",
        "timestamp": "2019-04-15T16:18:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

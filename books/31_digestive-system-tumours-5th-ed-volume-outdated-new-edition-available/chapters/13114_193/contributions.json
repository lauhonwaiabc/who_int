        "bookId": 31,
        "chapterId": 193,
        "headingId": 170,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-04-15T16:18:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

        "pkcontributionId": 55839,
        "bookId": 31,
        "chapterId": 193,
        "headingId": 159,
        "headingText": "\r\n<p>Lipoma is a benign tumour composed of mature adipocytes, and may include other mesenchymal elements in subtypes.</p>\r\n",
        "timestamp": "2019-04-15T16:18:17"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

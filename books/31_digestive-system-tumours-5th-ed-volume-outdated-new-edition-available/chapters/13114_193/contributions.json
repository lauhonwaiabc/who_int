        "bookId": 31,
        "chapterId": 193,
        "headingId": 174,
        "headingText": "\r\n<p><em>Essential:</em> mature uniform adipocytes without cytological atypia.</p>\r\n",
        "timestamp": "2019-04-15T16:18:17"
      }
    ],

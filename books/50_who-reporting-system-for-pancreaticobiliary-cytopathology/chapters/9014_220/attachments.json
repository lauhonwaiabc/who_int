    "title": "<p>Classification and grading of pancreatic neuroendocrine neoplasms (PanNENs)</p>",
    "legend": "",
    "source": "Barbara Ann Centeno",
    "copyright": "",
    "tablehtml": "<table class=\"MsoTableGrid\" style=\"border-collapse: collapse; border: none; \" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\" \">\r\n<td style=\"width: 120.1pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"160\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">Tumour type</span></strong></p>\r\n</td>\r\n<td style=\"width: 113.3pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\" color: black; \">Differentiation</span></strong></p>\r\n</td>\r\n<td style=\"width: 3.0cm; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\" color: black; \">Mitotic count</span></strong></p>\r\n</td>\r\n<td style=\"width: 155.95pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"208\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong><span style=\" color: black; \">Ki-67</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 120.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"160\">\r\n<p class=\"TableText\"><strong><span style=\" \">G1 NET</span></strong></p>\r\n</td>\r\n<td style=\"width: 113.3pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" \">Well differentiated</span></p>\r\n</td>\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" \">&lt;&nbsp;2/mm<sup>2</sup></span></p>\r\n</td>\r\n<td style=\"width: 155.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"208\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" \">&lt;&nbsp;3%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 120.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"160\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">G2 NET</span></strong></p>\r\n</td>\r\n<td style=\"width: 113.3pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" color: black; \">Well differentiated</span></p>\r\n</td>\r\n<td style=\"width: 3.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" color: black; \">2&ndash;20/mm<sup>2</sup></span></p>\r\n</td>\r\n<td style=\"width: 155.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"208\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" color: black; \">3&ndash;20%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 120.1pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"160\">\r\n<p class=\"TableText\"><strong><span style=\" \">G3 NET</span></strong></p>\r\n</td>\r\n<td style=\"width: 113.3pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" \">Well differentiated</span></p>\r\n</td>\r\n<td style=\"width: 3.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" \">&gt;&nbsp;20/mm<sup>2</sup></span></p>\r\n</td>\r\n<td style=\"width: 155.95pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"208\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" \">&gt;&nbsp;20%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"\">\r\n<td style=\"width: 120.1pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"160\">\r\n<p class=\"TableText\"><strong><span style=\" color: black; \">NEC, small cell type</span></strong></p>\r\n</td>\r\n<td style=\"width: 113.3pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" color: black; \">Poorly differentiated</span></p>\r\n</td>\r\n<td style=\"width: 3.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" color: black; \">&gt;&nbsp;20/mm<sup>2</sup></span></p>\r\n</td>\r\n<td style=\"width: 155.95pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"208\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" color: black; \">&gt;&nbsp;20% (usually &gt;&nbsp;50%)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\" \">\r\n<td style=\"width: 120.1pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"160\">\r\n<p class=\"TableText\"><strong><span style=\" \">NEC, large cell type</span></strong></p>\r\n</td>\r\n<td style=\"width: 113.3pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"151\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" \">Poorly differentiated</span></p>\r\n</td>\r\n<td style=\"width: 3.0cm; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" \">&gt;&nbsp;20/mm<sup>2</sup></span></p>\r\n</td>\r\n<td style=\"width: 155.95pt; border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"208\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><span style=\" \">&gt;&nbsp;20% (usually &gt;&nbsp;50%)</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\">NEC, neuroendocrine carcinoma; NET, neuroendocrine tumour.</p>",
    "imageUrl": null,
    "thumbnail": null
  },
  {
    "pkattachmentId": 46492,

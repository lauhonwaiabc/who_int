    "tablehtml": "<table class=\"MsoTableGrid\" style=\"width: 697.4pt; border-collapse: collapse; border: none;\" border=\"0\" width=\"930\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"height: 12.0pt;\">\r\n<td style=\"width: 78.0pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.0pt;\" width=\"104\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Diagnosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.0pt;\" width=\"302\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">ICC for diagnosis</span></strong></p>\r\n</td>\r\n<td style=\"width: 9.0cm; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.0pt;\" width=\"340\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">ICC for molecular markers</span></strong></p>\r\n</td>\r\n<td style=\"width: 137.45pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt; height: 12.0pt;\" width=\"183\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">Genetic mutations</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 36.0pt;\">\r\n<td style=\"width: 78.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 36.0pt;\" width=\"104\">\r\n<p class=\"TableText\"><strong>PanNET, G3</strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 36.0pt;\" width=\"302\">\r\n<p class=\"TableText\">Strong expression of chromogranin&nbsp;A, synaptophysin, and INSM1</p>\r\n</td>\r\n<td style=\"width: 9.0cm; padding: 0cm 5.4pt 0cm 5.4pt; height: 36.0pt;\" width=\"340\">\r\n<p class=\"TableText\">ATRX, DAXX: loss of nuclear expression</p>\r\n<p class=\"TableText\">SSTR2: retained expression</p>\r\n</td>\r\n<td style=\"width: 137.45pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 36.0pt;\" width=\"183\">\r\n<p class=\"TableText\"><em>MEN1</em>, <em>ATRX</em>, and <em>DAXX</em> <span class=\"Ref-PMID\">{24148618}</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 36.0pt;\">\r\n<td style=\"width: 78.0pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 36.0pt;\" width=\"104\">\r\n<p class=\"TableText\"><strong><span style=\"color: black;\">PanNEC</span></strong></p>\r\n</td>\r\n<td style=\"width: 8.0cm; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 36.0pt;\" width=\"302\">\r\n<p class=\"TableText\"><span style=\"color: black;\">Usually strong expression of synaptophysin, focal or absent chromogranin&nbsp;A, variable intensity of INSM1 </span><span class=\"Ref-PMID\">{32128564}</span></p>\r\n</td>\r\n<td style=\"width: 9.0cm; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 36.0pt;\" width=\"340\">\r\n<p class=\"TableText\"><span style=\"color: black;\">p53: mutated pattern</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">SMAD4: loss of nuclear expression</span></p>\r\n<p class=\"TableText\"><span style=\"color: black;\">RB1: loss of nuclear staining</span></p>\r\n</td>\r\n<td style=\"width: 137.45pt; border: none; border-bottom: solid windowtext 1.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 36.0pt;\" width=\"183\">\r\n<p class=\"TableText\"><em><span style=\"color: black;\">RB1</span></em><span style=\"color: black;\">, <em>TP53</em>, <em>SMAD4</em>, and <em>KRAS</em> </span><span class=\"Ref-PMID\">{29596894}</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

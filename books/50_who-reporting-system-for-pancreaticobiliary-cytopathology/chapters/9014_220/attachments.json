    "fileId": 22708,
    "type": "Figure",
    "diagnosis": "Well-differentiated neuroendocrine tumour (NET)",
    "title": "",
    "legend": "The classic plasmacytoid cells of NETs have salt-and-pepper (intermingled coarse and fine) chromatin and eccentric granular cytoplasm (Pap).",
    "source": "Michelle D. Reid",
    "copyright": "",
    "tablehtml": "",

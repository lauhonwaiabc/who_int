    "fileId": 7616,
    "type": "WSI",
    "diagnosis": "",
    "title": "",
    "legend": "<p>Encapsulated papillary carcinoma showing an expansile, circumscribed and mostly encapsulated tumour mass comprising anastomosing papillary fronds covered by a monotonous population of columnar epithelial cells with stratified hyperchromatic nuclei. The papillary fronds project into a cystically dilated space. One area shows closely apposed tubules in the fibrous wall, which may raise concern for invasion, but as it appears confined to the fibrous area without extending into surrounding fat, is regarded as non diagnostic for invasion.</p>",
    "source": "source error",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/7616.dzi",
    "thumbnail": null
  },

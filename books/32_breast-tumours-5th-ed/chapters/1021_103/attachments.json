    "tablehtml": "<table class=\"MsoTableGridLight\" style=\"width: 270.75pt; border-collapse: collapse; border: none;\" border=\"0\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 116.45pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" rowspan=\"2\" width=\"155\">\r\n<p class=\"TableText\"><strong>Cancer</strong></p>\r\n</td>\r\n<td style=\"width: 154.3pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" valign=\"top\" width=\"206\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Risk in mutation carriers</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 77.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"103\">\r\n<p class=\"TableText\"><strong><em>BRCA1</em></strong></p>\r\n</td>\r\n<td style=\"width: 77.15pt; border: none; border-top: solid windowtext 1.0pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"103\">\r\n<p class=\"TableText\"><strong><em>BRCA2</em></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 116.45pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"155\">\r\n<p class=\"TableText\"><strong>Prostate</strong></p>\r\n</td>\r\n<td style=\"width: 77.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"103\">\r\n<p class=\"TableText\">Possible</p>\r\n</td>\r\n<td style=\"width: 77.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"103\">\r\n<p class=\"TableText\">Definite</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 116.45pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"155\">\r\n<p class=\"TableText\"><strong>Pancreas<
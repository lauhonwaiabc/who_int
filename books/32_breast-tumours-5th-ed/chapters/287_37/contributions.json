[
  {
    "pkheadingid": 377,
    "bookid": 32,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 176,
    "contributions": [
      {
        "pkcontributionId": 57047,
        "bookId": 32,
        "chapterId": 37,
        "headingId": 176,
        "headingText": "\r\n<p>Polymorphous adenocarcinoma (PmA) of the breast is an infiltrative malignant epithelial neoplasm with histological features similar to those of PmA of the salivary glands, composed of a proliferation of monotonous neoplastic cells demonstrating architectural diversity, arranged in a variety of patterns including large nests surrounded by cords and single files (single-cell infiltration).</p>\r\n",
        "timestamp": "2019-08-29T17:02:43"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 378,
    "bookid": 32,
    "headingType": 2,
    "headingTitle": "ICD-O coding",

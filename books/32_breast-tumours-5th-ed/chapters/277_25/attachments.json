113\">\r\n<p class=\"TableText\"><strong>Invasive breast carcinoma with oncocytic pattern</strong></p>\r\n</td>\r\n<td style=\"width: 110.65pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"147\">\r\n<p class=\"TableText\">Abundant, brightly eosinophilic, and granular, with well-defined borders</p>\r\n</td>\r\n<td style=\"width: 106.6pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\">Round and centrally located, with prominent nucleoli</p>\r\n</td>\r\n<td style=\"width: 11.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"16\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 72.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"97\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">+</p>\r\n</td>\r\n<td style=\"width: 74.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"99\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&minus;/+</p>\r\n</td>\r\n<td style=\"width: 2.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"76\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Mostly +</p>\r\n</td>\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&minus;/+</p>\r\n</td>\r\n<td style=\"width: 63.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"85\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&minus;</p>\r\n</td>\r\n<td style=\"width: 42.55pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"57\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&minus;</p>\r\n</td>\r\n<td style=\"width: 112.85pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"150\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Mitochondrial stains&nbsp;+</p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">25% ERBB2 (HER2)&nbsp;+</p>\r\n</td>\r\n</tr>\r\n<tr style=\"page-break-inside: avoid;\">\r\n<td style=\"width: 84.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"113\">\r\n<p class=\"TableText\"><strong>Carcinoma with apocrine differentiation</strong></p>\r\n</td>\r\n<td style=\"width: 110.65pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"147\">\r\n<p class=\"TableText\">Abundant, granular, and eosinophilic or vacuolated, with distinct cell borders</p>\r\n</td>\r\n<td style=\"width: 106.6pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\">Enlarged and round to oval, with marked/moderate atypia and prominent nucleoli</p>\r\n</td>\r\n<td style=\"width: 11.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" valign=\"top\" width=\"16\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&nbsp;</p>\r\n</td>\r\n<td style=\"width: 72.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"97\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">+</p>\r\n</td>\r\n<td style=\"width: 74.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"99\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">+</p>\r\n</td>\r\n<td style=\"width: 2.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"76\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&minus;</p>\r\n</td>\r\n<td style=\"width: 1.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">+</p>\r\n</td>\r\n<td style=\"width: 63.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"85\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">&minus;/+</p>\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">focal/weak</p>\r\n</td>\r\n<td style=\"width: 42.55pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"57\">\r\n<p class=\"Table
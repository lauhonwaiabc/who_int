    "chapterId": 137,
    "fileId": 7685,
    "type": "WSI",
    "diagnosis": "<p>Renal cell carcinoma metastatic to the breast</p>",
    "title": "",
    "legend": "<p>Tumour nodule&nbsp;has apparent circumscribed borders, comprising poorly differentiated malignant cells accompanied by a prominent inflammatory infiltrate.</p>",
    "source": "<p>SGH Pathology</p>",
    "copyright": "",

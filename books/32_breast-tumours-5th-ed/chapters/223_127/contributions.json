    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 176,
    "contributions": [
      {
        "pkcontributionId": 56514,
        "bookId": 32,
        "chapterId": 127,
        "headingId": 176,
        "headingText": "\r\n<p>Microglandular adenosis is a haphazard proliferation of small round glands consisting of a single layer of epithelial cells without an accompanying myoepithelial cell layer.</p>\r\n",
        "timestamp": "2019-08-28T11:21:46"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },

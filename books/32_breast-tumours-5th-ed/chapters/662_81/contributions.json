        "pkcontributionId": 57476,
        "bookId": 32,
        "chapterId": 81,
        "headingId": 176,
        "headingText": "\r\n<p>Angiolipoma is a benign neoplasm of mature fat with clusters of small vessels, some of which contain hyaline microthrombi.</p>\r\n",
        "timestamp": "2019-09-03T14:33:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0

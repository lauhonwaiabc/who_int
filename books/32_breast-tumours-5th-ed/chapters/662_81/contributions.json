        "headingId": 189,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-09-03T14:33:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 391,
    "bookid": 32,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 190,
    "contributions": [
      {
        "pkcontributionId": 57492,
        "bookId": 32,
        "chapterId": 81,
        "headingId": 190,
        "headingText": "\r\n<p>Angiolipomas are benign, with no documented potential for local recurrence or malignant transformation. Definitive diagnosis on core biopsy can obviate the need for excision {28644513}.</p>",
        "timestamp": "2019-09-03T14:33:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

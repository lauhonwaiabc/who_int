  },
  {
    "pkheadingid": 392,
    "bookid": 32,
    "headingType": 2,
    "headingTitle": "Essential and desirable diagnostic criteria",
    "headingPosition": 15,
    "headingid": 191,
    "contributions": [
      {
        "pkcontributionId": 57490,
        "bookId": 32,
        "chapterId": 81,
        "headingId": 191,
        "headingText": "\r\n<p><em>Essential:</em> a neoplasm composed of benign adipocytes with prominent vessels; microthrombi in small vessels.</p>\r\n",
        "timestamp": "2019-09-03T14:33:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

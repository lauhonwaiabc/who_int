        "bookId": 32,
        "chapterId": 81,
        "headingId": 187,
        "headingText": "\r\n<p>Not clinically relevant</p>\r\n",
        "timestamp": "2019-09-03T14:33:53"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

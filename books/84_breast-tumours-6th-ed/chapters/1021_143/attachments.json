    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 481.0pt; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"641\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 202.0pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"269\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 279.0pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"372\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Syndrome characteristics</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 202.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"269\">\r\n<p class=\"TableText\"><strong>Syndrome MIM number(s)</strong></p>\r\n</td>\r\n<td style=\"width: 279.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"372\">\r\n<p class=\"TableText\">13705; 600185</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 202.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"269\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 279.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"372\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">See <span class=\"ID-File\">&lt;&lt;#48201&gt;&gt;</span>Table&nbsp;10.02</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 202.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"269\">\r\n<p class=\"TableText\"><strong>Associated benign tumours</strong></p>\r\n</td>\r\n<td style=\"width: 279.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"372\">\r\n<p class=\"TableText\">Not applicable</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 202.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"269\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cancer-related inheritance</span></strong></p>\r\n</td>\r\n<td style=\"width: 279.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"372\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Autosomal dominant; somatic mutation; multifactorial</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 202.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"269\">\r\n<p class=\"TableText\"><strong>Chromosome location</strong></p>\r\n</td>\r\n<td style=\"width: 279.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"372\">\r\n<p class=\"TableText\"><em>BRCA1</em> (17q21.31)</p>\r\n<p class=\"TableText\"><em>BRCA2</em> (13q13.1)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 202.0pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"269\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Protein product&ndash;associated pathway</span></strong></p>\r\n</td>\r\n<td style=\"width: 279.0pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"372\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">BRCA1</span></em><span style=\"color: black; mso-color-alt: windowtext;\"> encodes the 220&nbsp;kDa protein BRCA1, which interacts with a number of proteins with diverse functions, e.g. MSH2, MSH6, MLH1, ATM, BLM, RAD50, RAD51, MRE11, and NBN; BRCA2 has RAD51 binding domains but is otherwise not structurally similar to the BRCA1 protein </span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

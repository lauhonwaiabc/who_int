    "copyright": "Lax SF",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 69.06%; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"69%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 44.12%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"44%\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 55.88%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"55%\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Syndrome characteristic</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 44.12%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"44%\">\r\n<p class=\"TableText\"><strong>Syndrome MIM number(s)</strong></p>\r\n</td>\r\n<td style=\"width: 55.88%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"55%\">\r\n<p class=\"TableText\">151623</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 44.12%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"44%\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 55.88%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"55%\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Breast carcinoma, soft tissue sarcomas, osteosarcoma, choroid plexus carcinoma, diffuse gliomas, medulloblastoma, adrenocortical carcinoma, lung carcinoma, pancreatic carcinoma, prostatic carcinoma, gastrointestinal carcinomas, ovarian and uterine carcinomas</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 44.12%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"44%\">\r\n<p class=\"TableText\"><strong>Associated benign tumours </strong></p>\r\n</td>\r\n<td style=\"width: 55.88%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"55%\">\r\n<p class=\"TableText\">No evidence</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 44.12%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"44%\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cancer-related inheritance </span></strong></p>\r\n</td>\r\n<td style=\"width: 55.88%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"55%\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Autosomal dominant</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 44.12%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"44%\">\r\n<p class=\"TableText\"><strong>Chromosome location</strong></p>\r\n</td>\r\n<td style=\"width: 55.88%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"55%\">\r\n<p class=\"TableText\"><em>TP53</em> (17p13.1)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 44.12%; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"44%\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Protein product&ndash;associated pathway</span></strong></p>\r\n</td>\r\n<td style=\"width: 55.88%; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"55%\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">p53 pathway</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

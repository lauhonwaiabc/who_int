    "fileId": 48516,
    "type": "WSI",
    "diagnosis": "<p>Rhabdomyosarcoma metastatic to the breast</p>",
    "title": "",
    "legend": "<p>Core biopsies of the breast in a patient with past history of nasal rhabdomyosarcoma show malignant tumour nests with hyperchromatic nuclei and high nuclear-cytoplasmic ratios.&nbsp; Immunohistochemical workup confirmed rhabdomyosarcoma.</p>",
    "source": "Imported from 5th edition<br><br><p>SGH Pathology</p>",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/7684.dzi",
    "thumbnail": null

    "title": "<p><strong>Table&nbsp;2.01</strong> Summary of diagnostic criteria of columnar cell change, columnar cell hyperplasia, FEA, and ADH</p>",
    "legend": "",
    "source": "Abeer M. Shaaban",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 18.8%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Criterion</span></strong></p>\r\n</td>\r\n<td style=\"width: 20.3%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Columnar cell change</span></strong></p>\r\n</td>\r\n<td style=\"width: 20.3%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Columnar cell hyperplasia</span></strong></p>\r\n</td>\r\n<td style=\"width: 20.3%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">FEA</span></strong></p>\r\n</td>\r\n<td style=\"width: 20.3%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">ADH</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 18.8%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\"><strong>Internal contour</strong></p>\r\n</td>\r\n<td style=\"width: 20.3%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">Irregular</p>\r\n</td>\r\n<td style=\"width: 20.3%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">Irregular</p>\r\n</td>\r\n<td style=\"width: 20.3%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">Smooth</p>\r\n</td>\r\n<td style=\"width: 20.3%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">Variable</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 18.8%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cell morphology</span></strong></p>\r\n</td>\r\n<td style=\"width: 20.3%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Columnar</span></p>\r\n</td>\r\n<td style=\"width: 20.3%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Columnar</span></p>\r\n</td>\r\n<td style=\"width: 20.3%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Columnar/cuboidal</span></p>\r\n</td>\r\n<td style=\"width: 20.3%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Columnar/cuboidal</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 18.8%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\"><strong>Epithelial cell layers</strong></p>\r\n</td>\r\n<td style=\"width: 20.3%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">&ge;&nbsp;1</p>\r\n</td>\r\n<td style=\"width: 20.3%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">&gt;&nbsp;2</p>\r\n</td>\r\n<td style=\"width: 20.3%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">&ge;&nbsp;1</p>\r\n</td>\r\n<td style=\"width: 20.3%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\">Variable</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 18.8%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"18%\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Nuclear atypia</span></strong></p>\r\n</td>\r\n<td style=\"width: 20.3%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Absent</span></p>\r\n</td>\r\n<td style=\"width: 20.3%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Absent</span></p>\r\n</td>\r\n<td style=\"width: 20.3%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Present (monomorphic)</span></p>\r\n</td>\r\n<td style=\"width: 20.3%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"20%\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Present (monomorphic)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 
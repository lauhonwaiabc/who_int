  {
    "pkattachmentId": 71069,
    "bookid": 84,
    "chapterId": 15,
    "fileId": 49845,
    "type": "WSI",
    "diagnosis": "Microglandular adenosis - S100 stain",
    "title": "",
    "legend": "The cells composing the monostratified glands of microglandular adenosis are strongly S100-positive. S100 also stains weakly the myoepithelial cells around normal breast acini and ductules (S100 immunohistochemical stain).",
    "source": "Edi Brogi",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/49845.dzi",
    "thumbnail": null
  },
  {
    "pkattachmentId": 71070,
    "bookid": 84,
    "chapterId": 15,
    "fileId": 49846,
    "type": "WSI",
    "diagnosis": "Microglandular adenosis",
    "title": "",
    "legend": "Haphazard proliferation of monostratified small glands composed of cuboidal epithelial cells with no nuclear atypia. The glands are devoid of a myoepithelial layer, but surrounded by basement membrane (hematoxylin eosin stain). No stromal desmoplasia is present. ",
    "source": "Edi Brogi",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/49846.dzi",
    "thumbnail": null

    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 193.0pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Feature</span></strong></p>\r\n</td>\r\n<td style=\"width: 274.0pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"365\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Syndrome characteristic</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 193.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\"><strong>Syndrome MIM number(s)</strong></p>\r\n</td>\r\n<td style=\"width: 274.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"365\">\r\n<p class=\"TableText\">162200</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 193.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Associated malignant tumours</span></strong></p>\r\n</td>\r\n<td style=\"width: 274.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"365\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Malignant peripheral nerve sheath tumour, high-grade glioma, juvenile myelomonocytic leukaemia, rhabdomyosarcoma, glomus tumours of the digits, gastrointestinal stromal tumours, phaeochromocytoma, breast cancer in females, duodenal neuroendocrine tumours</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 193.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\"><strong>Associated benign tumours</strong></p>\r\n</td>\r\n<td style=\"width: 274.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"365\">\r\n<p class=\"TableText\">Low-grade glioma (including optic pathway glioma), neurofibroma (including plexiform neurofibroma and atypical neurofibroma&nbsp;/ atypical neurofibromatous neoplasms of uncertain biological potential)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 193.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Cancer-related inheritance</span></strong></p>\r\n</td>\r\n<td style=\"width: 274.0pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"365\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Autosomal dominant</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 193.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\"><strong>Chromosome location</strong></p>\r\n</td>\r\n<td style=\"width: 274.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"365\">\r\n<p class=\"TableText\"><em>NF1 (</em>17q11.2)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 193.0pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"257\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Protein product&ndash;associated pathway</span></strong></p>\r\n</td>\r\n<td style=\"width: 274.0pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"365\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">RAS/MAPK, AKT/mTOR, ROCK/LIMK/CFL, and cAMP/PKA pathways</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",

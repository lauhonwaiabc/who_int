    "source": "Allison Kimberly and Fresia Pareja H.",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 333.15pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"444\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Grade and histological type</span></strong></p>\r\n</td>\r\n<td style=\"width: 288.2pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"384\">\r\n<p class=\"TableText\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"color: black; mso-color-alt: windowtext;\">Described pathognomonic genetic alterations</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 333.15pt; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"444\">\r\n<p class=\"TableText\"><strong>High-grade</strong></p>\r\n</td>\r\n<td style=\"width: 288.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"384\">\r\n<p class=\"TableText\">&nbsp;</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">&nbsp;</td>\r\n<td style=\"width: 304.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"406\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Invasive breast carcinoma of no special type (NST) (including basal-like/medullary pattern)</span></p>\r\n</td>\r\n<td style=\"width: 288.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"384\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Nonspecific</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">&nbsp;</td>\r\n<td style=\"width: 304.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"406\">\r\n<p class=\"TableText\">Solid-basaloid adenoid cystic carcinoma</p>\r\n</td>\r\n<td style=\"width: 288.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"384\">\r\n<p class=\"TableText\"><em>MYB</em> or <em>MYBL1</em> rearrangements (~20% of cases)</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 333.15pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" colspan=\"2\" width=\"444\">\r\n<p class=\"TableText\"><strong><span style=\"color: black; mso-color-alt: windowtext;\">Low-grade</span></strong></p>\r\n</td>\r\n<td style=\"width: 288.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"384\">\r\n<p class=\"TableText\"><em>&nbsp;</em></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">&nbsp;</td>\r\n<td style=\"width: 304.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"406\">\r\n<p class=\"TableText\">Low-grade forms of metaplastic carcinoma</p>\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt; mso-list: l0 level1 lfo1;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span>Low-grade adenosquamous carcinoma</p>\r\n<p class=\"TableText\" style=\"margin-left: 36.0pt; text-indent: -18.0pt; mso-list: l0 level1 lfo1;\"><span style=\"font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol;\"><span style=\"mso-list: Ignore;\">&middot;<span style=\"font: 7.0pt 'Times New Roman';\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span>Low-grade fibromatosis-like carcinoma</p>\r\n</td>\r\n<td style=\"width: 288.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"384\">\r\n<p class=\"TableText\">Nonspecific</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">&nbsp;</td>\r\n<td style=\"width: 304.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"406\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Secretory carcinoma</span></p>\r\n</td>\r\n<td style=\"width: 288.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"384\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">ETV6</span></em><span style=\"color: black; mso-color-alt: windowtext;\">::<em>NTRK3</em> fusion gene</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">&nbsp;</td>\r\n<td style=\"width: 304.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"406\">\r\n<p class=\"TableText\">Adenoid cystic carcinoma (classic)</p>\r\n</td>\r\n<td style=\"width: 288.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"384\">\r\n<p class=\"TableText\"><em>MYB</em>::<em>NFIB</em> fusion gene, other <em>MYB</em> rearrangements or amplification, <em>MYBL1</em> rearrangements</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">&nbsp;</td>\r\n<td style=\"width: 304.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"406\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Other uncommon salivary gland&ndash;like cancers</span></p>\r\n</td>\r\n<td style=\"width: 288.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"384\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Nonspecific</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">&nbsp;</td>\r\n<td style=\"width: 304.8pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"406\">\r\n<p class=\"TableText\">Some low-grade forms of invasive apocrine carcinoma</p>\r\n</td>\r\n<td style=\"width: 288.2pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"384\">\r\n<p class=\"TableText\">Nonspecific</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">&nbsp;</td>\r\n<td style=\"width: 304.8pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"406\">\r\n<p class=\"TableText\"><span style=\"color: black; mso-color-alt: windowtext;\">Tall cell carcinoma with reverse polarity</span></p>\r\n</td>\r\n<td style=\"width: 288.2pt; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"384\">\r\n<p class=\"TableText\"><em><span style=\"color: black; mso-color-alt: windowtext;\">IDH2</span></em><span style=\"color: black; mso-color-alt: windowtext;\"> p.Arg172 hotspot mutations</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 11; mso-yfti-lastrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 1.0cm; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"38\">&nbsp;</td>\r\n<td style=\"width: 304.8pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"406\">\r\n<p class=\"TableText\">Mucinous cystadenocarcinoma</p>\r\n</td>\r\n<td style=\"width: 288.2pt; border: none; border-bottom: solid windowt
    "bookid": 53,
    "chapterId": 44,
    "fileId": 28090,
    "type": "WSI",
    "diagnosis": "Papillary thyroid carcinoma",
    "title": "",
    "legend": "Clear cell subtype. The tumour demonstrates cytoplasmic clearing in many of the neoplastic cells, a finding that does not change the outcome but represents a subtype of papillary thyroid carcinoma.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/28090.dzi",

    "chapterId": 44,
    "fileId": 28097,
    "type": "WSI",
    "diagnosis": "Papillary thyroid carcinoma",
    "title": "",
    "legend": "Oncocytic subtype. Papillary architecture represents &gt;&nbsp;70% of this tumour, which demonstrates papillary nuclear features. The nuclei are luminally oriented, with opacified cytoplasm.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/28097.dzi",
    "thumbnail": null

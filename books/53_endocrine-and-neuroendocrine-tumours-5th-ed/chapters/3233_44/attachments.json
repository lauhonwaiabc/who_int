    "bookid": 53,
    "chapterId": 44,
    "fileId": 28089,
    "type": "WSI",
    "diagnosis": "Papillary thyroid carcinoma",
    "title": "",
    "legend": "Diffuse sclerosing subtype. There are a myriad psammoma bodies in this lobe, with areas of squamous metaplasia, chronic lymphocytic thyroiditis, sclerosis, and isolated tumour islands, the characteristic findings of the diffuse sclerosing subtype of papillary thyroid carcinoma.",
    "source": "Lester D.R. Thompson",
    "copyright": "",
    "tablehtml": "",
    "imageUrl": "https://tumourclassification.iarc.who.int/static/dzi/28089.dzi",
    "thumbnail": null

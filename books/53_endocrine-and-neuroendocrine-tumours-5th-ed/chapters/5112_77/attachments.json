  {
    "pkattachmentId": 61530,
    "bookid": 53,
    "chapterId": 77,
    "fileId": 25271,
    "type": "Figure",
    "diagnosis": "Tumorigenic mechanisms in clinically defined insulinomas",
    "title": "",
    "legend": "<strong>A</strong>&nbsp;Indolent small insulinomas are characterized by recurrent <em>YY1</em> mutations (25%), neutral or amplified chromosomal copy numbers, and endocrine transcription factor expression consistent with normal islet B-cell differentiation (PDX1+/ARX&minus;). <strong>B</strong>&nbsp;Large insulinomas show distinct tumorigenic mechanisms often seen in non-functioning PanNETs, and endocrine transcription factor expression inconsistent with normal islet B-cell differentiation (ARX+). ALT, alternative lengthening of telomeres.",

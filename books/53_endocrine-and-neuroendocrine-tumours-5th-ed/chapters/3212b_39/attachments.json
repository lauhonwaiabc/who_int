    "title": "<p>Differential diagnosis of hyalinizing trabecular tumour (HTT)</p>",
    "legend": "",
    "source": "Marco Volante",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" width=\"982\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 92.15pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Key features</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">HTT</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">Follicular adenoma with trabecular growth</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">Papillary carcinoma with trabecular growth</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">Poorly differentiated carcinoma with trabecular growth</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">Medullary thyroid carcinoma</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">Paraganglioma</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 92.15pt; padding: 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Trabecular growth</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Present</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Present</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Present</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Present</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Present</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Present</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 92.15pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Tumour borders</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Well defined (encapsulation)</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Encapsulated</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Well defined or infiltrative</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Infiltrative</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Well defined or infiltrative</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Well defined (encapsulation)</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 92.15pt; padding: 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Capsular/vascular invasion</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Absent (present in extremely rare malignant cases)</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Absent</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Variable</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Present</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Variable</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Usually absent</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 92.15pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Intertrabecular hyalinization</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Present, variable extent</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">May be present</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">May be present</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">May be present</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">May be present, but to be distinguished from amyloid material (Congo red+) in medullary thyroid carcinoma</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Usually absent</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 92.15pt; padding: 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Intratrabecular stromal hyalinization</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Present, variable extent</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Absent</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Absent</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Absent</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Absent</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Absent</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 92.15pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Nuclear features</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Diffuse membrane irregularities, grooves, intranuclear pseudoinclusions, no peripheral margination of chromatin (clearing)</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Usually dark and small; may show nuclear enlargement and grooves</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">RAS-like carcinomas have enlarged nuclei, irregular nuclear membranes with convolutions, grooves; BRAF-like carcinomas have florid irregularity, clearing, intranuclear pseudoinclusions</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Usually dark and small; irregular nuclear membranes with convolutions in some cases</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Finely granular chromatin; may show membrane irregularities and intranuclear pseudoinclusions</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Hyperchromatic nuclei with small nucleoli; may show membrane irregularities</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 92.15pt; padding: 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">MIB1 staining (in appropriate conditions; see text)</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Membranous (+&nbsp;nuclear in proliferative cells)</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Only nuclear</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Only nuclear</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Only nuclear</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Only nuclear</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Only nuclear</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 92.15pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Follicular cell markers (thyroglobulin, TTF1, PAX8)</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Positive</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Positive</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Positive</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Positive (focal dot-like thyroglobulin pattern)</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Negative (may be focal TTF1)</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Negative</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 92.15pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"123\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">GLIS fusion</span></strong></p>\r\n</td>\r\n<td style=\"width: 107.45pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Present</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Absent</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Absent</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"143\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">Absent</span></p>\r\n</td>\r\n<td style=\"width: 107.45pt; border-top:
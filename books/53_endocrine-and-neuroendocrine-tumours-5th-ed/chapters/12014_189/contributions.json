[
  {
    "pkheadingid": 803,
    "bookid": 53,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 607,
    "contributions": [
      {
        "pkcontributionId": 123876,
        "bookId": 53,
        "chapterId": 189,
        "headingId": 607,
        "headingText": "\r\n<p>Metastases to the adrenal gland are tumours that involve the adrenal gland secondarily by haematogenous spread from primary sites in other organs.</p>\r\n",
        "timestamp": "2024-10-09T16:31:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {

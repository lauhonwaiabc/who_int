        "bookId": 53,
        "chapterId": 189,
        "headingId": 609,
        "headingText": "\r\n<p>2E07 Malignant neoplasm metastasis in adrenal gland</p>\r\n",
        "timestamp": "2024-10-09T16:31:35"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 806,
    "bookid": 53,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 610,

    "source": "William D. Foulkes",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 99.52%; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;\" border=\"0\" width=\"99%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\"><strong>Phenotypes</strong></p>\r\n</td>\r\n<td style=\"width: 23.46%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Age range in years (peak)</strong></p>\r\n</td>\r\n<td style=\"width: 29.58%; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; background: #8DB3E2; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\"><strong>Specificity for <em>DICER1</em> syndrome</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 1; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\"><strong>Most frequent phenotypes</strong></p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 2; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Pleuropulmonary blastoma<sup>a</sup></p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0&ndash;8</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 3; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 35.45pt;\">Type&nbsp;I (cystic)</p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">(0&ndash;2)</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 4; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 35.45pt;\">Type&nbsp;II (cystic and solid)</p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">(1&ndash;5)</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 5; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 35.45pt;\">Type&nbsp;III (solid)</p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">(1.5&ndash;6)</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 6; page-break-inside: avoid; height: 4.35pt;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.35pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 35.45pt;\">Type&nbsp;Ir (cystic)</p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.35pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Any age</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt; height: 4.35pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 7; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Cystic nephroma</p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0&ndash;15 (0&ndash;4)</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 8; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Ovarian Sertoli&ndash;Leydig cell tumour</p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">2&ndash;40 (10&ndash;25)</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 9; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Thyroid follicular nodular disease</p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">2&ndash;40 (10&ndash;25)</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Low, unless familial or age &lt;&nbsp;18&nbsp;years</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 10; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\"><strong>Moderately frequent phenotypes</strong></p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 11; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Embryonal rhabdomyosarcoma of the uterine cervix<sup>a</sup></p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">4&ndash;45 (10&ndash;20)</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 12; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Nasal chondromesenchymal hamartoma</p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">5&ndash;25 (8&ndash;20)</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Moderate</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 13; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Differentiated thyroid carcinoma</p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">5&ndash;45 (10&ndash;30)</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Low, unless age &lt;&nbsp;18&nbsp;years</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 14; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\"><strong>Rare phenotypes</strong></p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 15; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Pituitary blastoma</p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0&ndash;2</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Very high</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 16; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Anaplastic renal sarcoma<sup>a</sup></p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">2&ndash;20</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 17; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Pineoblastoma</p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">2&ndash;25 (2&ndash;10)</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Moderate</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 18; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Ciliary body medulloepithelioma</p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">3&ndash;10</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Moderate</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 19; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Juvenile hamartomatous intestinal polyps</p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0&ndash;20 (0&ndash;4)</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Low</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 20; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Wilms tumour</p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">3&ndash;8</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Low</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 21; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Embryonal rhabdomyosarcoma of the bladder<sup>a</sup></p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0&ndash;12</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Undetermined</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 22; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Cerebral sarcoma<sup>a</sup></p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Undetermined</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Undetermined</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 23; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\"><strong>Very rare phenotypes</strong></p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\"><strong>&nbsp;</strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 24; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Infantile cerebellar embryonal tumour</p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">0&ndash;1</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 25; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Ovarian embryonal rhabdomyosarcoma<sup>a</sup></p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Undetermined</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 26; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Gynandroblastoma</p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Undetermined</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 27; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Presacral malignant teratoid tumour</p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Undetermined</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">High</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 28; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Pleuropulmonary blastoma&ndash;like peritoneal sarcoma<sup>a</sup></p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Undetermined</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Likely high</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 29; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Well-differentiated fetal lung adenocarcinoma</p>\r\n</td>\r\n<td style=\"width: 23.46%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Undetermined</p>\r\n</td>\r\n<td style=\"width: 29.58%; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Low</p>\r\n</td>\r\n</tr>\r\n<tr style=\"mso-yfti-irow: 30; page-break-inside: avoid;\">\r\n<td style=\"width: 46.94%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"46%\">\r\n<p class=\"TableText\" style=\"margin-left: 16.05pt;\">Paratesticular sarcoma<sup>a</sup></p>\r\n</td>\r\n<td style=\"width: 23.46%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"23%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Undetermined</p>\r\n</td>\r\n<td style=\"width: 29.58%; background: #DAEEF3; padding: 0cm 5.4pt 0cm 5.4pt;\" width=\"29%\">\r\n<p class=\"TableText\" style=\"text-align: center;\" align=\"center\">Low</p>\r\n</td>\r
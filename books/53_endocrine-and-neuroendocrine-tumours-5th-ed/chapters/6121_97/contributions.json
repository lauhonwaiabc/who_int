      {
        "pkcontributionId": 122983,
        "bookId": 53,
        "chapterId": 97,
        "headingId": 620,
        "headingText": "\r\n<p>Not applicable</p>\r\n",
        "timestamp": "2024-10-09T12:45:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 817,
    "bookid": 53,
    "headingType": 2,
    "headingTitle": "Prognosis and prediction",
    "headingPosition": 17,
    "headingid": 621,
    "contributions": [
      {
        "pkcontributionId": 122984,
        "bookId": 53,
        "chapterId": 97,
        "headingId": 621,
        "headingText": "\r\n<p>Surgical resection results in hormone normalization, with a good prognosis for the limited cases reported {26126046}.</p>",
        "timestamp": "2024-10-09T12:45:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  }

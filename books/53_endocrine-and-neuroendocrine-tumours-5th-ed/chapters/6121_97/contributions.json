[
  {
    "pkheadingid": 803,
    "bookid": 53,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 607,
    "contributions": [
      {
        "pkcontributionId": 122968,
        "bookId": 53,
        "chapterId": 97,
        "headingId": 607,
        "headingText": "\r\n<p>Adrenal sex cord stromal tumour is a tumour with sex cord stromal differentiation arising in the adrenal cortex.</p>\r\n",
        "timestamp": "2024-10-09T12:45:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 804,
    "bookid": 53,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 608,
    "contributions": [
      {
        "pkcontributionId": 122969,
        "bookId": 53,
        "chapterId": 97,
        "headingId": 608,
        "headingText": "\r\n<p>8590/1 Sex cord stromal tumour</p>\r\n<p>8650/1 Leydig cell tumour</p>\r\n<p>8620/3 Granulosa cell tumour</p>\r\n",
        "timestamp": "2024-10-09T12:45:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 805,
    "bookid": 53,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 609,
    "contributions": [
      {
        "pkcontributionId": 122970,
        "bookId": 53,
        "chapterId": 97,
        "headingId": 609,
        "headingText": "\r\n<p>2F9A &amp; XH0667 Neoplasms of unknown behaviour of endocrine glands &amp; Sex cord-stromal tumour, unclassified</p>\r\n",
        "timestamp": "2024-10-09T12:45:47"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 806,
    "bookid": 53,

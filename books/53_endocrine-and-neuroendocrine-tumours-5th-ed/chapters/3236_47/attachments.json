; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">3%</span></p>\r\n</td>\r\n<td style=\"width: 77.95pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; background: #daeef3; padding: 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"104\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">3%</span></p>\r\n</td>\r\n<td style=\"width: 77.95pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; background: #daeef3; padding: 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"104\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">0%</span></p>\r\n</td>\r\n<td style=\"width: 78pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; background: #daeef3; padding: 0cm 5.4pt;\" nowrap=\"nowrap\" width=\"104\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">3%</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">HGDTC, high-grade differentiated thyroid carcinoma; PDTC, poorly differentiated thyroid carcinoma.</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><sup><span lang=\"PT\">a</span></sup><span lang=\"PT\">PDTC</span><span lang=\"PT\">: <em>NRAS</em>&nbsp;33%, <em>HRAS</em>&nbsp;8%, <em>KRAS</em>&nbsp;4%; HGDTC: <em>NRAS</em>&nbsp;6%.</span></p>",

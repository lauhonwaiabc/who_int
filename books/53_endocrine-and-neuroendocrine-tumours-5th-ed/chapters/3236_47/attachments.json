    "tablehtml": "<table class=\"MsoNormalTable\" style=\"width: 701.7pt; border-collapse: collapse;\" border=\"0\" width=\"936\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 127.6pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"170\">&nbsp;</td>\r\n<td style=\"width: 11cm; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Poorly differentiated thyroid carcinoma (Turin proposal)</span></strong></p>\r\n</td>\r\n<td style=\"width: 262.25pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"350\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">High-grade differentiated thyroid carcinoma</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 127.6pt; padding: 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Architectural pattern</span></strong></p>\r\n</td>\r\n<td style=\"width: 11cm; padding: 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Solid/trabecular/insular growth required</span></p>\r\n</td>\r\n<td style=\"width: 262.25pt; padding: 0cm 5.4pt;\" width=\"350\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Papillary, follicular, solid<sup>a</sup></span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 127.6pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Nuclear features</span></strong></p>\r\n</td>\r\n<td style=\"width: 11cm; background: #daeef3; padding: 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Absence of nuclear features of PTC required</span></p>\r\n</td>\r\n<td style=\"width: 262.25pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"350\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Any</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 127.6pt; padding: 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Necrosis, mitosis, and convoluted nuclei</span></strong></p>\r\n</td>\r\n<td style=\"width: 11cm; padding: 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">At least one of the following three features:</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Mitotic count: &ge;&nbsp;3&nbsp;mitoses/2&nbsp;mm<sup>2</sup></span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Tumour necrosis</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Convoluted nuclei</span></p>\r\n</td>\r\n<td style=\"width: 262.25pt; padding: 0cm 5.4pt;\" width=\"350\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">At least one of the following two features:</span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Mitotic count: &ge;&nbsp;5&nbsp;mitoses/2&nbsp;mm<sup>2</sup></span></p>\r\n<p class=\"TableBullet\" style=\"margin: 3pt 0cm 3pt 12pt; text-indent: -12pt; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\" style=\"font-family: Symbol;\">&middot;<span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\">&nbsp;&nbsp; </span></span><span lang=\"EN-GB\">Tumour necrosis</span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 127.6pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; background: #daeef3; padding: 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Anaplastic features</span></strong></p>\r\n</td>\r\n<td style=\"width: 11cm; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; background: #daeef3; padding: 0cm 5.4pt;\" width=\"416\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">None</span></p>\r\n</td>\r\n<td style=\"width: 262.25pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; background: #daeef3; padding: 0cm 5.4pt;\" width=\"350\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">None</span></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">PTC, papillary thyroid carcinoma.</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><sup><span lang=\"EN-GB\">a</span></sup><span lang=\"EN-GB\">Tumours</span><span lang=\"EN-GB\"> with solid growth and PTC nuclear features are classified as high-grade differentiated thyroid carcinoma.</span></p>",

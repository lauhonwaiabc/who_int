    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 63.35pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Site</span></strong></p>\r\n</td>\r\n<td style=\"width: 454.05pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Clinical presentation</span></strong></p>\r\n</td>\r\n<td style=\"width: 90.25pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"120\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">IgG4+/mm<sup>2</sup></span></strong></p>\r\n</td>\r\n<td style=\"width: 90.25pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"120\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><strong><span lang=\"EN-GB\">IgG4:IgG</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 63.35pt; padding: 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Pancreas</span></strong></p>\r\n</td>\r\n<td style=\"width: 454.05pt; padding: 0cm 5.4pt;\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Parenchymal mass lesion mimicking pancreatic carcinoma (painless obstructive jaundice, pancreatic mass, abdominal pain) and/or pancreatic insufficiency (new-onset diabetes mellitus, steatorrhoea)</span></p>\r\n</td>\r\n<td style=\"width: 90.25pt; padding: 0cm 5.4pt;\" width=\"120\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">&gt;&nbsp;40 (biopsy)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">&gt;&nbsp;200 (excision)</span></p>\r\n</td>\r\n<td style=\"width: 90.25pt; padding: 0cm 5.4pt;\" width=\"120\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">&gt;&nbsp;40%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 63.35pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Pituitary</span></strong></p>\r\n</td>\r\n<td style=\"width: 454.05pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"PT\">Headache, visual field defect, hyperprolactinaemia (galactorrhoea), hypopituitarism (diabetes insipidus, fatigue, amenorrhoea) </span><span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\"><span lang=\"PT\">{31929792}</span></span></p>\r\n</td>\r\n<td style=\"width: 90.25pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"120\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">&gt;&nbsp;40</span></p>\r\n</td>\r\n<td style=\"width: 90.25pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"120\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">&gt;&nbsp;40%</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 63.35pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"84\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Thyroid</span></strong></p>\r\n</td>\r\n<td style=\"width: 454.05pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"605\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Goitre and/or hypothyroidism </span><span class=\"Ref-PMID\" style=\"color: #984806; background: #ccc0d9;\"><span lang=\"EN-GB\">{33311000}</span></span></p>\r\n</td>\r\n<td style=\"width: 90.25pt; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0cm 5.4pt;\" width=\"120\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif; text-align: center;\" align=\"center\"><span lang=\"EN-GB\">&gt;&nbsp;80</span></p>\r\n</td>\r\n<td style=\"width: 90.25pt; border-top: none; border-right: none; border-left: none; b
        "bookId": 53,
        "chapterId": 98,
        "headingId": 608,
        "headingText": "\r\n<p>9054/0 Adenomatoid tumour, NOS</p>\r\n",
        "timestamp": "2024-10-09T12:46:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 805,
    "bookid": 53,
    "headingType": 2,
    "headingTitle": "ICD-11 coding",
    "headingPosition": 3,
    "headingid": 609,
    "contributions": [
      {
        "pkcontributionId": 122987,
        "bookId": 53,
        "chapterId": 98,
        "headingId": 609,
        "headingText": "\r\n<p>2F10 &amp; XH6BY3 Benign neoplasm of mesothelial tissue &amp; Adenomatoid tumour, NOS</p>\r\n",
        "timestamp": "2024-10-09T12:46:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 806,
    "bookid": 53,
    "headingType": 2,
    "headingTitle": "Related terminology",
    "headingPosition": 4,
    "headingid": 610,
    "contributions": [
      {

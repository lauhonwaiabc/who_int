[
  {
    "pkheadingid": 803,
    "bookid": 53,
    "headingType": 2,
    "headingTitle": "Definition",
    "headingPosition": 1,
    "headingid": 607,
    "contributions": [
      {
        "pkcontributionId": 122985,
        "bookId": 53,
        "chapterId": 98,
        "headingId": 607,
        "headingText": "\r\n<p>Adenomatoid tumour is a benign tumour of mesothelial differentiation arising in the adrenal gland.</p>\r\n",
        "timestamp": "2024-10-09T12:46:33"
      }
    ],
    "booknotes": [],
    "numberofBooknote": 0
  },
  {
    "pkheadingid": 804,
    "bookid": 53,
    "headingType": 2,
    "headingTitle": "ICD-O coding",
    "headingPosition": 2,
    "headingid": 608,
    "contributions": [
      {

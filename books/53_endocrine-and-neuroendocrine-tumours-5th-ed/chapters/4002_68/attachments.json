    "title": "<p>Syndromic and non-syndromic inherited forms of primary hyperparathyroidism</p>",
    "legend": "",
    "source": "Aurel Perren",
    "copyright": "",
    "tablehtml": "<table class=\"MsoNormalTable\" style=\"border-collapse: collapse;\" border=\"0\" width=\"726\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 99.25pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"132\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Inherited disease</span></strong></p>\r\n</td>\r\n<td style=\"width: 106.3pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Gene involved</span></strong></p>\r\n</td>\r\n<td style=\"width: 127.6pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Chromosomal location</span></strong></p>\r\n</td>\r\n<td style=\"width: 211.55pt; border-right: none; border-bottom: none; border-left: none; border-image: initial; border-top: 1pt solid windowtext; background: #8db3e2; padding: 0cm 5.4pt;\" width=\"282\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">Pathology (lifetime risk of development)</span></strong></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 99.25pt; padding: 0cm 5.4pt;\" width=\"132\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">MEN1</span></strong></p>\r\n</td>\r\n<td style=\"width: 106.3pt; padding: 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">MEN1</span></em></p>\r\n</td>\r\n<td style=\"width: 127.6pt; padding: 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">11q23</span></p>\r\n</td>\r\n<td style=\"width: 211.55pt; padding: 0cm 5.4pt;\" width=\"282\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Multiglandular parathyroid disease (multiglandular parathyroid adenomas) (95%)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">PanNET (40%)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">PitNET/adenoma (30%)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Duodenal NET, gastric NET (20%)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Meningiomas</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Facial angiofibromas</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 99.25pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"132\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">MEN2/3</span></strong></p>\r\n</td>\r\n<td style=\"width: 106.3pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">RET</span></em></p>\r\n</td>\r\n<td style=\"width: 127.6pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">10q11.2</span></p>\r\n</td>\r\n<td style=\"width: 211.55pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"282\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Medullary thyroid carcinoma (99%)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Phaeochromocytoma (50%)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Multiglandular parathyroid disease (multiglandular parathyroid adenomas) (20%)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Ganglioneuromatosis</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 99.25pt; padding: 0cm 5.4pt;\" width=\"132\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">MEN4</span></strong></p>\r\n</td>\r\n<td style=\"width: 106.3pt; padding: 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">CDKN1B</span></em><span lang=\"EN-GB\"> (<em>P27</em>)</span></p>\r\n</td>\r\n<td style=\"width: 127.6pt; padding: 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">12p13</span></p>\r\n</td>\r\n<td style=\"width: 211.55pt; padding: 0cm 5.4pt;\" width=\"282\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Multiglandular parathyroid disease (multiglandular parathyroid adenomas)</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"PT\">PitNET/adenoma</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"PT\">Adrenocortical tumours</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"PT\">Meningiomas</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 99.25pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"132\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">HPT-JT</span></strong></p>\r\n</td>\r\n<td style=\"width: 106.3pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">CDC73</span></em><span lang=\"EN-GB\"> (<em>PARAFIBROMIN</em>)</span></p>\r\n</td>\r\n<td style=\"width: 127.6pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">1q25</span></p>\r\n</td>\r\n<td style=\"width: 211.55pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"282\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Parathyroid carcinoma</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Atypical parathyroid tumour</span></p>\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Jaw tumours</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 99.25pt; padding: 0cm 5.4pt;\" width=\"132\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">FHH1</span></strong></p>\r\n</td>\r\n<td style=\"width: 106.3pt; padding: 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">CASR</span></em><span lang=\"EN-GB\"> (dominant)</span></p>\r\n</td>\r\n<td style=\"width: 127.6pt; padding: 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">3q21</span></p>\r\n</td>\r\n<td style=\"width: 211.55pt; padding: 0cm 5.4pt;\" width=\"282\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span lang=\"EN-GB\">Normal parathyroids</span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"break-inside: avoid;\">\r\n<td style=\"width: 99.25pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"132\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><strong><span lang=\"EN-GB\">NS-PHPT</span></strong></p>\r\n</td>\r\n<td style=\"width: 106.3pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"142\">\r\n<p class=\"TableText\" style=\"margin: 3pt 0cm; font-size: 12pt; font-family: 'Times New Roman', serif;\"><em><span lang=\"EN-GB\">CASR</span></em><span lang=\"EN-GB\"> (recessive)</span></p>\r\n</td>\r\n<td style=\"width: 127.6pt; background: #daeef3; padding: 0cm 5.4pt;\" width=\"170\">\r\n<p class=\"TableText\" style